diff --git a/research/reader-w57-pilot/assets/reader_w57_activation.js b/research/reader-w57-pilot/assets/reader_w57_activation.js
new file mode 100644
index 0000000..ddcc7e1
--- /dev/null
+++ b/research/reader-w57-pilot/assets/reader_w57_activation.js
@@ -0,0 +1,22 @@
+/* Select the pilot on entry; never move Product controls on a viewport change. */
+(async()=>{'use strict';
+  const entry=document.currentScript;
+  if(!entry||document.documentElement.dataset.w57Layout)return;
+  const desktop=matchMedia('(min-width:1121px)').matches;
+  const layout=desktop?'desktop':'native';
+  document.documentElement.dataset.w57Layout=layout;
+  if(!desktop&&!document.querySelector('#partTocOverlay #gbrMarginalia'))return;
+  const files=type=>(entry.dataset[layout+type]||'').split(' ').filter(Boolean);
+  const url=file=>new URL(file,entry.src).href;
+  function load(kind,file){return new Promise((resolve,reject)=>{
+    const element=document.createElement(kind);
+    element.addEventListener('load',resolve,{once:true});
+    element.addEventListener('error',()=>reject(new Error(file)),{once:true});
+    if(kind==='link'){element.rel='stylesheet';element.href=url(file);document.head.append(element)}
+    else{element.src=url(file);document.body.append(element)}
+  })}
+  try{
+    await Promise.all(files('Css').map(file=>load('link',file)));
+    for(const file of files('Js'))await load('script',file);
+  }catch(error){console.error('W57 pilot assets failed to load',error)}
+})();
