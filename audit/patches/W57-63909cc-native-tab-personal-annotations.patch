--- /dev/null
+++ b/research/reader-w57-pilot/assets/reader_w57_native.js
@@ -0,0 +1,59 @@
+/* W57 native-sheet pilot: no replacements for mobile chrome, TOC or storage. */
+(()=>{'use strict';
+  const sheet=document.querySelector('#partTocOverlay');
+  const container=sheet?.querySelector('.toc-sheet > #gbrMarginalia');
+  const researchTab=sheet?.querySelector('#gbrMarginaliaTab[aria-controls="gbrMarginalia"]');
+  const topTrigger=document.querySelector('.mobile-top-bar [data-reader-mobile-menu-target="mobPartTocBtn"]');
+  const partTrigger=document.getElementById('mobPartTocBtn');
+  if(!container||!researchTab||!topTrigger||!partTrigger||!window.GBReaderContract?.articleRoot(document)?.matches('article'))return;
+  sheet.setAttribute('data-w57-native','');
+  const toast=document.createElement('p');
+  toast.id='npW57NativeStatus';
+  toast.setAttribute('role','status');
+  document.body.append(toast);
+  const shown=()=>sheet.classList.contains('is-open');
+  const onScreen=el=>{
+    const r=el.getBoundingClientRect();
+    return !el.closest('[inert]')&&getComputedStyle(el).visibility==='visible'&&
+      r.width>0&&r.height>0&&r.bottom>0&&r.top<innerHeight&&r.right>0&&r.left<innerWidth;
+  };
+  const mobileTrigger=()=>[topTrigger,partTrigger].find(onScreen);
+  const afterFocus=fn=>requestAnimationFrame(()=>requestAnimationFrame(fn));
+  let toastTimer=0, pendingFocus=null;
+  function revealEditor(focus){
+    if(!shown()||window.OverlayRuntime?.topLayer()?.element!==sheet)return;
+    if(researchTab.getAttribute('aria-selected')!=='true')researchTab.click();
+    if(!container.hidden)focus();
+  }
+  document.addEventListener('gb:overlay-open',event=>{
+    clearTimeout(toastTimer);
+    toast.textContent='';
+    if(event.detail?.ownerId!==sheet.dataset.overlayOwner||!pendingFocus)return;
+    const focus=pendingFocus;
+    pendingFocus=null;
+    afterFocus(()=>revealEditor(focus));
+  });
+  window.__NP_W57_NATIVE__={host:{
+    container,
+    canShowActions:()=>!!mobileTrigger()&&!window.OverlayRuntime?.hasLiveLayers(),
+    openResearchForAnnotation(focus){
+      if(shown()){afterFocus(()=>revealEditor(focus));return}
+      const trigger=mobileTrigger();
+      if(!trigger)return;
+      pendingFocus=focus;
+      trigger.click();
+      setTimeout(()=>{if(pendingFocus===focus)pendingFocus=null},500);
+    },
+    closeResearchForAnnotation(jump){
+      if(!shown())return;
+      if(!window.OverlayRuntime?.requestClose(sheet.dataset.overlayOwner,'w57-go-to-source'))return;
+      // Wait for the native inert/focus handoff; a newly opened dialog wins.
+      afterFocus(()=>{if(!shown()&&!window.OverlayRuntime?.hasLiveLayers())jump()});
+    },
+    announce(text){
+      clearTimeout(toastTimer);
+      toast.textContent=text;
+      toastTimer=setTimeout(()=>{toast.textContent=''},3200);
+    },
+  }};
+})();
