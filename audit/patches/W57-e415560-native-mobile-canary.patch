diff --git a/research/reader-w57-pilot/assets/reader_w57_native.js b/research/reader-w57-pilot/assets/reader_w57_native.js
new file mode 100644
index 0000000..136d563
--- /dev/null
+++ b/research/reader-w57-pilot/assets/reader_w57_native.js
@@ -0,0 +1,53 @@
+/* W57 native-sheet pilot: no replacements for mobile chrome, TOC or storage. */
+(()=>{'use strict';
+  const sheet=document.querySelector('#partTocOverlay');
+  const container=sheet?.querySelector('.toc-sheet > #gbs2PartToc');
+  const topTrigger=document.querySelector('.mobile-top-bar [data-reader-mobile-menu-target="mobPartTocBtn"]');
+  const partTrigger=document.getElementById('mobPartTocBtn');
+  if(!container||!topTrigger||!partTrigger||!window.GBReaderContract?.articleRoot(document)?.matches('article'))return;
+  sheet.setAttribute('data-w57-native','');
+  const toast=document.createElement('p');
+  toast.id='npW57NativeStatus';
+  toast.setAttribute('role','status');
+  document.body.append(toast);
+  const shown=()=>sheet.classList.contains('is-open');
+  const onScreen=el=>{
+    const r=el.getBoundingClientRect();
+    return !el.closest('[inert]')&&getComputedStyle(el).visibility==='visible'&&
+      r.width>0&&r.height>0&&r.bottom>0&&r.top<innerHeight&&r.right>0&&r.left<innerWidth;
+  };
+  const mobileTrigger=()=>[topTrigger,partTrigger].find(onScreen);
+  const afterFocus=fn=>requestAnimationFrame(()=>requestAnimationFrame(fn));
+  let toastTimer=0, pendingFocus=null;
+  document.addEventListener('gb:overlay-open',event=>{
+    clearTimeout(toastTimer);
+    toast.textContent='';
