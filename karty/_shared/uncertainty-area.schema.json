{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gospod-bog.ru/karty/_shared/uncertainty-area.schema.json",
  "title": "GB Historical Map Uncertainty Area",
  "description": "Fail-closed contract for contested historical geography represented as labelled candidate corridors, never as a single authoritative point.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "feature_type",
    "status",
    "single_authoritative_point",
    "reader_label",
    "corridors",
    "palaeowater",
    "credits"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 2
    },
    "feature_type": {
      "const": "uncertainty-area"
    },
    "status": {
      "enum": [
        "UNRESOLVED",
        "CANDIDATE_CORRIDORS_ONLY"
      ]
    },
    "single_authoritative_point": {
      "const": false
    },
    "reader_label": {
      "type": "string",
      "minLength": 24
    },
    "corridors": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "status",
          "confidence",
          "geometry",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 2
          },
          "status": {
            "enum": [
              "CANDIDATE",
              "ALTERNATIVE"
            ]
          },
          "confidence": {
            "enum": [
              "LOW",
              "MODERATE_LOW",
              "MODERATE"
            ]
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "points"
            ],
            "properties": {
              "type": {
                "const": "polygon"
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false
                }
              }
            }
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "palaeowater": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_date",
        "reconstruction_label",
        "source_ids",
        "modern_boundary_distinct"
      ],
      "properties": {
        "dataset_date": {
          "type": "string",
          "format": "date"
        },
        "reconstruction_label": {
          "type": "string",
          "minLength": 2
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modern_boundary_distinct": {
          "const": true
        }
      }
    },
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "source_url",
        "rights"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "rights": {
          "type": "string",
          "minLength": 2
        }
      }
    }
  }
}
