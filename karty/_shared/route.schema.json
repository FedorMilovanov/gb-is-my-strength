{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gospod-bog.ru/karty/_shared/route.schema.json",
  "$comment": "places[].id and stories[].id must be unique within a single route. Validated at runtime by scripts/validate-map-routes.js (findDuplicateIds) and scripts/map-layers-theme-regression-test.js. JSON Schema 2020-12 has no built-in 'unique by property' keyword — schema-level uniqueItems: true checks deep equality, not what we need. Story ids intentionally allow underscore because they are internal filter/deep-link identifiers, not public route slugs.",
  "title": "GB Historical Map Route",
  "type": "object",
  "required": ["meta", "stories", "places", "stages", "archetype", "capabilities", "publication"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "era", "stats", "viewport_init"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "sheet_no": { "type": ["string", "integer"] },
        "title": { "type": "string", "minLength": 2 },
        "title_he": { "type": "string" },
        "subtitle": { "type": "string" },
        "base_geo_url": { "type": "string", "pattern": "^[^?#]+\\.svg(?:[?#].*)?$" },
        "era": { "type": "string" },
        "stats": { "type": "object", "additionalProperties": true },
        "viewport_init": {
          "type": "object",
          "required": ["cx", "cy", "w"],
          "properties": {
            "cx": { "type": "number" },
            "cy": { "type": "number" },
            "w": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": true
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "desc": { "type": "string" },
          "place_ids": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
          "stage_ids": { "anyOf": [{ "type": "array", "items": { "type": "integer", "minimum": 0 } }, { "type": "null" }] },
          "places": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
          "stages": { "anyOf": [{ "type": "array", "items": { "type": "integer", "minimum": 0 } }, { "type": "null" }] }
        }
      }
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "x", "y", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "he": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "type": { "type": "string" },
          "era": { "type": "array", "items": { "type": "string" } },
          "stage": { "type": "integer", "minimum": 0 },
          "story": { "type": "string" },
          "bible": { "type": "string" },
          "arch": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "enum": ["ctx", "region"] } }, "required": ["type"] },
            "else": { "required": ["stage"] }
          }
        ]
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "t", "r"],
        "additionalProperties": true,
        "properties": {
          "n": { "type": "string" },
          "t": { "type": "string", "minLength": 1 },
          "r": { "type": "string" },
          "paths": { "type": "array" }
        }
      }
    },
    "ctx": { "type": "array" },
    "verified_waypoints": { "type": "array" },
    "scientific_variants": { "type": "object" },
    "signature": {
      "type": "object",
      "required": ["type", "label", "description"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "enum": ["water-split", "sea-voyage", "hanukkah-lights", "split-kingdom", "judge-cycles", "tribe-stars", "ministry-light", "gospel-waves", "lampstands"] },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1, "maxLength": 260 },
        "origin": { "type": "string" },
        "origin_id": { "type": "string" },
        "place_ids": { "type": "array", "items": { "type": "string" } },
        "north_ids": { "type": "array", "items": { "type": "string" } },
        "south_ids": { "type": "array", "items": { "type": "string" } },
        "divide": { "type": "string" }
      }
    },
    "archetype": { "type": "string", "enum": ["route", "political", "thematic", "territorial", "overview"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["stages", "stories", "layers", "timeline", "signature", "interpretations", "uncertainty"] }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "indexable", "sitemap", "llms", "pagefind", "hub"],
      "properties": {
        "status": { "type": "string", "enum": ["ready", "temporary-placeholder", "draft"] },
        "indexable": { "type": "boolean" },
        "sitemap": { "type": "boolean" },
        "llms": { "type": "boolean" },
        "pagefind": { "type": "boolean" },
        "hub": { "type": "string", "enum": ["featured", "listed", "withheld"] },
        "hub_order": { "type": "integer", "minimum": 0 },
        "hub_summary": { "type": "string", "minLength": 20, "maxLength": 320 },
        "hub_image": { "type": "string", "pattern": "^/images/[^?#]+\\.(?:avif|webp|png|jpe?g)$" },
        "hub_approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis"],
          "properties": {
            "basis": { "type": "string", "enum": ["legacy-production", "owner-receipt"] },
            "receipt": { "type": "string", "minLength": 3, "maxLength": 320 },
            "note": { "type": "string", "minLength": 3, "maxLength": 320 }
          },
          "allOf": [
            {
              "if": { "properties": { "basis": { "const": "owner-receipt" } }, "required": ["basis"] },
              "then": { "required": ["receipt"] }
            }
          ]
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 320 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
          "then": { "properties": { "indexable": { "const": true }, "sitemap": { "const": true }, "pagefind": { "const": true } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["temporary-placeholder", "draft"] } }, "required": ["status"] },
          "then": { "properties": { "indexable": { "const": false }, "sitemap": { "const": false }, "llms": { "const": false }, "pagefind": { "const": false }, "hub": { "const": "withheld" } } }
        },
        {
          "if": { "properties": { "hub": { "enum": ["featured", "listed"] } }, "required": ["hub"] },
          "then": { "required": ["hub_order", "hub_summary", "hub_image", "hub_approval"], "properties": { "status": { "const": "ready" } } }
        }
      ]
    }
  },
  "allOf": [
    {
      "anyOf": [
        { "properties": { "meta": { "required": ["id"] } } },
        {
          "properties": {
            "publication": { "properties": { "status": { "const": "draft" } }, "required": ["status"] },
            "meta": { "required": ["sheet_no"] }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "publication": {
            "properties": {
              "hub_approval": {
                "properties": { "basis": { "const": "legacy-production" } },
                "required": ["basis"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "meta": {
            "properties": { "id": { "const": "avraam" } },
            "required": ["id"]
          }
        }
      }
    }
  ]
}
