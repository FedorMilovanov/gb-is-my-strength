{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gospod-bog.ru/karty/_shared/route.schema.json",
  "$comment": "places[].id and stories[].id must be unique within a single route. Validated at runtime by scripts/validate-map-routes.js (findDuplicateIds) and scripts/map-layers-theme-regression-test.js. JSON Schema 2020-12 has no built-in 'unique by property' keyword — schema-level uniqueItems: true checks deep equality, not what we need. Story ids intentionally allow underscore because they are internal filter/deep-link identifiers, not public route slugs.",
  "title": "GB Historical Map Route",
  "type": "object",
  "required": ["meta", "stories", "places", "stages"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "era", "stats", "viewport_init"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 2 },
        "title_he": { "type": "string" },
        "subtitle": { "type": "string" },
        "era": { "type": "string" },
        "stats": { "type": "object", "additionalProperties": true },
        "viewport_init": {
          "type": "object",
          "required": ["cx", "cy", "w"],
          "properties": {
            "cx": { "type": "number" },
            "cy": { "type": "number" },
            "w": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": true
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "desc": { "type": "string" },
          "place_ids": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
          "stage_ids": { "anyOf": [{ "type": "array", "items": { "type": "integer", "minimum": 0 } }, { "type": "null" }] },
          "places": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
          "stages": { "anyOf": [{ "type": "array", "items": { "type": "integer", "minimum": 0 } }, { "type": "null" }] }
        }
      }
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "x", "y", "type", "stage"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "he": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "type": { "type": "string" },
          "era": { "type": "array", "items": { "type": "string" } },
          "stage": { "type": "integer", "minimum": 0 },
          "story": { "type": "string" },
          "bible": { "type": "string" },
          "arch": { "type": "string" }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "t", "r"],
        "additionalProperties": true,
        "properties": {
          "n": { "type": "string" },
          "t": { "type": "string", "minLength": 1 },
          "r": { "type": "string" },
          "paths": { "type": "array" }
        }
      }
    },
    "ctx": { "type": "array" },
    "verified_waypoints": { "type": "array" },
    "scientific_variants": { "type": "object" },
    "signature": {
      "type": "object",
      "required": ["type", "label", "description"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "enum": ["water-split", "sea-voyage", "hanukkah-lights", "split-kingdom", "judge-cycles", "tribe-stars", "ministry-light", "gospel-waves", "lampstands"] },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1, "maxLength": 260 },
        "origin": { "type": "string" },
        "origin_id": { "type": "string" },
        "place_ids": { "type": "array", "items": { "type": "string" } },
        "north_ids": { "type": "array", "items": { "type": "string" } },
        "south_ids": { "type": "array", "items": { "type": "string" } },
        "divide": { "type": "string" }
      }
    }
  }
}
