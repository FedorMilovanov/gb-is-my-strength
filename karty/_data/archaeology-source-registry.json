  "claims": [
    {"id":"avraam-chronology-yec","map":"avraam","places":[],"status":"project-interpretation","statement":"The project presents Abraham near 2166 BCE within its classical Ussher/YEC chronology, while preserving conventional archaeological period labels in evidence records.","evidenceSources":[],"interpretationSources":["arj-abraham-chronology","creation-times-abraham","creation-chronogenealogies","icr-biblical-age"],"limitations":"This is the project’s theological-chronological framework, not an independently excavated absolute date for Abraham."},
    {"id":"ur-ancient-city-context","map":"avraam","places":["ur"],"status":"accepted-context","statement":"Tell el-Muqayyar is securely identified as ancient Ur and supplies the urban Mesopotamian context used by the map.","evidenceSources":["penn-ur-overview","bm-ur-1925-26","bm-ur-royal-cemetery","bm-ur-old-babylonian","bm-ur-1923-24"],"interpretationSources":["arj-abraham-chronology"],"limitations":"The excavations do not identify a personal house or artefact belonging to Abraham."},
    {"id":"euphrates-corridor-context","map":"avraam","places":["ur","mari","carchemish","harran"],"status":"accepted-context","statement":"Ur, Mari, Carchemish and Harran form archaeologically documented nodes suitable for the map’s Euphrates corridor context.","evidenceSources":["penn-ur-overview","mari-official-overview","mari-archives","bm-carchemish-ii","unibo-karkemish-overview","unibo-karkemish-2023-report","harran-department","harran-excavations-2025"],"interpretationSources":["arj-abraham-chronology"],"limitations":"The exact itinerary between nodes remains a historical reconstruction rather than a traced Abrahamic road."},
    {"id":"mari-amorite-context","map":"avraam","places":["mari"],"status":"accepted-context","statement":"Mari’s palace, archives and excavation history document early-second-millennium urban, administrative and tribal contexts relevant to comparative patriarchal study.","evidenceSources":["mari-excavation-history","mari-palace","mari-archives","mari-current-research"],"interpretationSources":[],"limitations":"Comparative context is not proof that Abraham visited Mari."},
    {"id":"shechem-tell-balata","map":"avraam","places":["shechem"],"status":"primary-identification","statement":"Tell Balata is the principal archaeological identification of ancient Shechem used by the map.","evidenceSources":["leiden-tell-balata","unesco-canaanite-city-states","oeaw-tell-balata","hup-tell-balata-2023"],"interpretationSources":["bibleplaces-shechem"],"limitations":"The Oak of Moreh and Abraham’s altar are not point-located archaeological finds."},
    {"id":"hebron-tell-rumeida","map":"avraam","places":["hebron"],"status":"primary-identification","statement":"Tell Rumeida preserves the ancient urban mound associated with Hebron; the later monumental enclosure marks the traditional Machpelah location.","evidenceSources":["unesco-hebron","unesco-canaanite-city-states"],"interpretationSources":["wibilex-hebron"],"limitations":"Tradition surrounding Machpelah is not equivalent to excavation of the patriarchal burials."},
    {"id":"beersheba-regional-context","map":"avraam","places":["beersheba"],"status":"accepted-context","statement":"The Beersheba basin preserves long settlement and water-use history, while Tel Be’er Sheva’s principal monumental remains are later than the patriarchal narrative.","evidenceSources":["unesco-biblical-tels","iaa-tel-sheva-2025","iaa-tel-sheva-campus-2025","iaa-beersheba-hadassah-2025","iaa-beersheba-trumpeldor-2024","iaa-tel-sheva-chalcolithic","iaa-nahal-beersheba-2013","iaa-nahal-beersheba-west-2015"],"interpretationSources":["bibleplaces-beersheba","wibilex-beersheba"],"limitations":"The Iron Age tell must not be presented as Abraham’s excavated town or well."},
    {"id":"bethel-beitin-candidate","map":"avraam","places":["bethel"],"status":"candidate","statement":"Beitin remains the map’s principal Bethel candidate, with alternatives retained as explicit scholarly caveats.","evidenceSources":[],"interpretationSources":["bibleplaces-bethel","wibilex-bethel"],"limitations":"This candidate requires a future primary excavation bibliography before promotion to accepted identification."},
    {"id":"sodom-southern-basin-candidate","map":"avraam","places":["sodom"],"status":"candidate","statement":"Bab edh-Dhra and Numeira remain southern-basin candidates considered by the project’s conservative/YEC layer.","evidenceSources":[],"interpretationSources":["bibleplaces-bab-edh-dhra","bibleplaces-numeira","aig-have-we-found-sodom"],"limitations":"A candidate status is not an identification; primary excavation publications must be added before stronger wording."},
    {"id":"tall-el-hammam-airburst-rejected","map":"avraam","places":["hammam"],"status":"rejected","statement":"The retracted Tall el-Hammam cosmic-airburst paper is not admissible as positive support for destruction or identification claims.","evidenceSources":["scientific-reports-tall-retraction","pubmed-tall-retraction"],"interpretationSources":["aig-have-we-found-sodom"],"limitations":"The site may still be discussed archaeologically, but the retracted airburst conclusion cannot be presented as established evidence."},
    {"id":"no-personal-abraham-artefact","map":"avraam","places":["ur","harran","shechem","bethel","hebron","beersheba"],"status":"methodological-guardrail","statement":"No current registry source establishes a personal artefact, house, altar or inscription belonging to Abraham.","evidenceSources":["penn-ur-overview","harran-department","leiden-tell-balata","unesco-hebron","iaa-esi-series"],"interpretationSources":[],"limitations":"The map may present period and landscape context, not invented direct archaeological proof."}
  ]
