    "nagornaya/**",
    "articles/dzhon-gill-*",
    "articles/krajne-li-isporcheno-serdce",
    "articles/rimlyanam-7-veruyushchiy-ili-neveruyushchiy",
    "hard-texts/**"
  ],
  "modes": {
    "native-main-with-legacy-chrome": "Astro page composes from named legacy fragments (body-segment-N.html) + named Astro component shells. Legacy chrome (skip-link, nav, theme, footer, runtime) loaded from fragments. Semantic main promoted to named component. This is the primary mode for landings and catalogs.",
    "full-body-shadow": "Astro page loads entire legacy HTML document via loadLegacyFullDocument(). Semantic block NOT promoted to separate component — full body is shadow-wrapped. Used for article subroutes in series where chrome + body are tightly coupled.",
    "mdx-native-article": "Astro page uses MDX content file + ArticleLayout/SeriesArticleLayout. Body is hand-authored MDX. Chrome from layout. This is the target mode for standalone articles.",
    "legacy-shadow-app": "Astro page wraps a legacy app/island (WebGL, Three.js, interactive SVG) via loadLegacyFullDocument() or iframe. NOT simplified to plain content route. Required: runtime smoke + SVG/interactive checks.",
    "excluded-semantic-lane": "Route is in active semantic refactor exclusion. Do not change as part of non-excluded migration work. Profile must declare this scope. Production consistency checks still run, but migration progress is not required.",
    "strict-native": "Astro route is fully native at runtime: no loadLegacyFullDocument, no headHtml/bodyHtml/bodyAttributes transport, no ?raw/_legacy fragment transport, no set:html legacy body injection. Route closure may still include normal native components, JSON-LD, and inline runtime scripts."
  },
  "forbid": {
    "plain-loadLegacyFullDocument-only": "Route already has named Astro components or MDX. Do NOT replace componentized structure with full-document loadLegacyFullDocument() monolith. This was the regression that broke 19 routes in r260.",
    "astro-native-article-layout": "Route is a legacy-shadow-app (karty, 3D, interactive). Do NOT migrate to mdx-native-article or native-main-with-legacy-chrome without explicit runtime smoke.",
    "blanket-shadow-wrap": "Never blanket-wrap all routes in loadLegacyFullDocument(). Use componentized mode where components already exist."
  },
