{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.mjs",
    "src/**/*.astro",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "build",
    "coverage",
    "js",
    "scripts",
    "audit",
    "_build-tools",
    "karty",
    "konfessii",
    "baptisty-rossii",
    "nagornaya",
    "articles",
    "sw.js"
  ]
}
