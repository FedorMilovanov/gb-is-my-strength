      "decision": "DELETE_DEAD_RUNTIME",
      "publicMarkupAllowed": false
    },
    "legacyOriginalWord": {
      "trigger": ".gbx-ow",
      "content": ".gbx-ow-card",
      "kind": "dormant custom card",
      "runtime": "js/site.js §1.10",
      "dataOwner": "data/original-words.json",
      "decision": "DELETE_DEAD_RUNTIME_KEEP_DATA",
      "publicMarkupAllowed": false
    }
  },
