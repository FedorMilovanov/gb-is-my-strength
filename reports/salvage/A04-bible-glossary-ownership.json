  "mission": "Unify ownership of Bible references, verse previews, glossary terms, footnotes, and original-language data without restoring dormant UI or creating another tooltip runtime.",
  "astro7Boundary": {
    "activeMigrationPullRequest": 549,
    "touchedHere": [],
    "excluded": [
      "astro.config.mjs",
      "package.json",
      "package-lock.json",
      "scripts/astro7-migration-guard.mjs",
      "src/components/**",
      "src/pages/**",
      ".github/workflows/**"
    ],
    "compatibilityRule": "A04 extends the production-like route witness and canonical glossary policy only; it remains dependency/config neutral."
  },
  "sourceContracts": {
    "bibleRegistry": {
      "path": "data/bible/books.json",
      "expectedBooks": 66,
      "expectedTestamentCounts": { "OT": 39, "NT": 27 },
      "defaultTranslationByTestament": { "OT": "synodal", "NT": "kassian" },
      "decision": "KEEP_CURRENT",
      "owner": "canonical registry; scripts/bible-reference-contract.mjs --strict owns parser, resolution and provenance",
      "materializationPolicy": "registry completeness is distinct from corpus materialization; catalogue-only books are reported, not fabricated"
    },
    "glossaryPolicy": {
      "path": "data/glossary-policy.json",
      "decision": "KEEP_AND_HARDEN",
      "owner": "canonical glossary hydration and placement policy",
      "forbiddenInteractiveAncestors": [
        ".quiz-wrapper",
        ".flip-card",
        ".error-flip-card"
      ],
      "reason": "each ancestor owns keyboard/touch activation; nested glossary buttons would create competing controls"
    },
    "originalWords": {
      "path": "data/original-words.json",
      "requiredLexicalFields": ["lang", "original", "transliteration", "gloss", "definition", "source"],
      "metadataKeyPolicy": "keys beginning with _ are metadata and are never counted as lexical entries",
      "allowedLanguages": ["he", "el"],
      "decision": "KEEP_DATA_ONLY",
      "owner": "editorial original-language registry",
      "uiReadiness": "BLOCKED",
      "missingUiContract": ["explicit lemma id", "morphology", "canonical verse linkage"]
    },
    "legacyVerses": {
      "path": "data/verses.json",
      "decision": "DELETE_WITH_LEGACY_RUNTIME",
      "owner": null,
      "reason": "flat mixed dataset is superseded by the canonical book registry"
    }
  },
  "surfaces": {
    "bibleReference": {
      "trigger": ".bref[data-ref]",
      "content": ".btip",
      "kind": "shared floating tooltip; mobile viewport constrained",
      "activation": "desktop focus/click; mobile touch/touch-toggle; Escape close",
      "runtime": "SiteUtils.makeTooltipController",
      "dataOwner": "strict Bible reference contract + canonical registry/corpus",
      "decision": "KEEP_CURRENT"
    },
    "glossaryTerm": {
      "trigger": ".gterm",
      "content": ".gtip",
      "kind": "shared tooltip/mobile sheet",
