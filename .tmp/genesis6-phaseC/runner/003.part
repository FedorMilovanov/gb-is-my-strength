tes(manifest_bytes)
(root / 'evidence' / 'tested-product-manifest.sha256').write_text(hashlib.sha256(manifest_bytes).hexdigest() + '\n')
PY
tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner \
  -czf "$ROOT/tested-product.tgz" -C "$PRODUCT" .
sha256sum "$ROOT/tested-product.tgz" > "$EVIDENCE/tested-product.tgz.sha256"

echo '== Phase C read-only acceptance complete =='
