echo '== Seal exact tested product artifact =='
python <<'PY'
import hashlib, json, os, pathlib, shutil, subprocess
root = pathlib.Path('/tmp/genesis6-phaseC')
source_manifest = json.load(open(root / 'package' / 'manifest.json'))
paths = [entry['path'] for entry in source_manifest['files']]
actual = sorted(subprocess.check_output([
    'git', 'ls-files', '--modified', '--others', '--exclude-standard'
]).decode().splitlines())
if actual != paths:
    raise SystemExit(f'tested product scope mismatch: {actual}')
product = root / 'tested-product'
product.mkdir(parents=True, exist_ok=True)
files = []
for path in paths:
    src = pathlib.Path(path)
    dst = product / path
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(src, dst)
    data = src.read_bytes()
    files.append({
        'path': path,
        'bytes': len(data),
        'sha256': hashlib.sha256(data).hexdigest(),
        'gitBlobSha': subprocess.check_output(['git', 'hash-object', '--stdin'], input=data).decode().strip(),
    })
final_manifest = {
    'schemaVersion': 1,
    'base': source_manifest['base'],
    'sourceCapsule': {
        'base64Sha256': os.environ['CAPSULE_B64_SHA256'],
        'tgzSha256': os.environ['CAPSULE_TGZ_SHA256'],
        'manifestSha256': os.environ['MANIFEST_SHA256'],
    },
    'componentPatch': json.load(open(root / 'evidence' / 'component-patch.json')),
    'files': files,
}
manifest_bytes = (json.dumps(final_manifest, ensure_ascii=False, indent=2) + '\n').encode()
(root / 'evidence' / 'tested-product-manifest.json').write_by