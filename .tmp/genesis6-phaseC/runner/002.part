t files')
paths=[e['path'] for e in files]
if paths!=sorted(paths) or len(paths)!=len(set(paths)): raise SystemExit('manifest order/uniqueness mismatch')
if set(safe)!={'manifest.json',*paths}: raise SystemExit('capsule tree differs from manifest')
for entry in files:
    data=(pkg/entry['path']).read_bytes()
    if len(data)!=entry['bytes']: raise SystemExit(f"bytes mismatch: {entry['path']}")
    if hashlib.sha256(data).hexdigest()!=entry['sha256']: raise SystemExit(f"sha256 mismatch: {entry['path']}")
    git_sha=subprocess.check_output(['git','hash-object','--stdin'],input=data).decode().strip()
    if git_sha!=entry['gitBlobSha']: raise SystemExit(f"git blob mismatch: {entry['path']}")
(root/'evidence'/'capsule.json').write_text(json.dumps({'base':manifest['base'],'fileCount':len(files),'manifestSha256':hashlib.sha256(manifest_bytes).hexdigest(),'capsuleBase64Sha256':os.environ['CAPSULE_B64_SHA256'],'capsuleTgzSha256':os.environ['CAPSULE_TGZ_SHA256']},indent=2)+'\n')
PY_CAPSULE

