arget.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)
PY

echo '== Apply typed frontmatter boundary patch =='
python <<'PY'
import base64, hashlib, json, pathlib, subprocess
path = pathlib.Path('src/components/article-pilots/genesis6/Genesis6ArticlePage.astro')
data = path.read_bytes()
old_git = subprocess.check_output(['git', 'hash-object', '--stdin'], input=data).decode().strip()
if old_git != '330db014bda9668025239d2b0e44cd95ca826370':
    raise SystemExit(f'unexpected pre-patch Genesis6ArticlePage blob: {old_git}')
text = data.decode()
old = base64.b64decode('aW50ZXJmYWNlIFByb3BzIHsKICBwYWdlSWQ6ICdlbm9jaCcgfCAnYW5nZWxzJyB8ICdzcGlyaXRzJyB8ICdkZWFkJzsKICBmcm9udG1hdHRlcjogRnJvbnRtYXR0ZXI7Cn0KCmNvbnN0IHsgcGFnZUlkLCBmcm9udG1hdHRlciB9ID0gQXN0cm8ucHJvcHMgYXMgUHJvcHM7Cg==').decode()
new = base64.b64decode('').decode()
if text.count(old) != 1:
    raise SystemExit('unexpected Genesis6ArticlePage type boundary')
path.write_text(text.replace(old, new))
final = path.read_bytes()
final_sha = hashlib.sha256(final).hexdigest()
final_git = subprocess.check_output(['git', 'hash-object', '--stdin'], input=final).decode().strip()
if len(final) != 10201 or final_sha != 'd97af42dece1a3dd8dbf10eaef2a81c5925c620fcdd524b43f8f04ed20985703' or final_git != '27634c59d99f6c24a1a53e04847702d97bfad80f':
    raise SystemExit(f'patched Genesis6ArticlePage identity mismatch: bytes={len(final)} sha256={final_sha} git={final_git}')
pathlib.Path('/tmp/genesis6-phaseC/evidence/component-patch.json').write_text(json.dumps({
    'path': str(path),
    'fromGitBlob': old_git,
    'toGitBlob': final_git,
    'toSha256': final_sha,
    'bytes': len(final),
}, indent=2) + '\n')
PY

