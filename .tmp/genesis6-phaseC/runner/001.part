ix('./') for m in members]
    safe=[]
    for member,name in zip(members,names):
        path=pathlib.PurePosixPath(name)
        if name in ('','.') or member.isdir(): continue
        if member.name.startswith('/') or '..' in path.parts or not member.isfile():
            raise SystemExit(f'unsafe capsule member: {member.name}')
        safe.append(name)
    if len(safe)!=len(set(safe)): raise SystemExit('duplicate capsule paths')
    archive.extractall(pkg,filter='data')
manifest_bytes=(pkg/'manifest.json').read_bytes()
if hashlib.sha256(manifest_bytes).hexdigest()!=os.environ['MANIFEST_SHA256']: raise SystemExit('manifest digest mismatch')
manifest=json.loads(manifest_bytes)
if manifest.get('schemaVersion')!=2 or manifest.get('base')!=os.environ['BASE_SHA'] or manifest.get('publicationState')!='draft-noindex':
    raise SystemExit('manifest authority mismatch')
files=manifest.get('files')
if not isinstance(files,list) or len(files)!=21: raise SystemExit('expected exactly 21 produc