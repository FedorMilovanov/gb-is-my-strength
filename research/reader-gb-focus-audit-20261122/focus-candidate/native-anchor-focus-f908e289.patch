   });
   /* Якорные ссылки текущей части: закрыть лист, дать браузеру доскроллить. */
   ov.querySelectorAll('a.gbat-sub[href^="#"]').forEach(function (a) {
-    a.addEventListener('click', function () { closeOverlay(); });
+    a.addEventListener('click', function (event) {
+      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      var target = null;
+      try { target = document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1))); } catch (_) {}
+      if (!target) { closeOverlay(); return; }
+      // The existing sheet owner decides dismissal; native hash navigation still
+      // owns scrolling. A cancelled request means the owner closed for navigation.
+      var request = new CustomEvent('gb:gill-navigation-close', { cancelable: true });
+      if (ov.dispatchEvent(request)) closeOverlay();
+      requestAnimationFrame(function () {
+        if (!document.contains(target)) return;
+        var temporaryTabindex = !target.hasAttribute('tabindex');
+        if (temporaryTabindex) target.setAttribute('tabindex', '-1');
+        target.focus({ preventScroll: true });
+        if (temporaryTabindex) target.addEventListener('blur', function () {
+          target.removeAttribute('tabindex');
+        }, { once: true });
+      });
+    });
   });
   /* Книга: шеврон статьи раскрывает её оглавление; в главе одновременно
      раскрыта одна статья (референс GBS 2026-07-15 §2.2, правило 4). */
