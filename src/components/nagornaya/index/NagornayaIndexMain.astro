---
/**
 * NagornayaIndexMain — balanced native <main> for /nagornaya//.
 *
 * V8/V9 hardening: avoid unbalanced tags across Astro component boundaries.
 * The markup is first-class Astro HTML (no raw imports), extracted from the
 * approved legacy main so Playwright/pixelmatch can verify exact parity.
 */
---
<main id="main-content" class="lg:pl-64" data-pagefind-body>
    <div class="max-w-4xl mx-auto px-4 py-8 pt-20 lg:pt-8 space-y-6">

      <!-- Breadcrumbs -->
      <nav class="text-xs flex items-center flex-wrap gap-0.5 mb-2"><a href="../articles/" class="text-stone-500 hover:text-amber-600 transition-colors">Статьи</a><span class="text-stone-400 mx-1.5">/</span><span class="text-stone-700 font-medium">Нагорная проповедь</span></nav>

      <!-- Hero -->
      <section class="nag-study-opening" aria-labelledby="nag-study-title">

        <div class="nag-study-opening__text">
          <div class="nag-study-kicker">
            <span class="nag-study-kicker__label">Авторская серия</span>
          </div>
          <h1 id="nag-study-title" class="nag-study-title">Нагорная проповедь</h1>
          <p class="nag-study-subtitle">Сравнительное исследование Матфея 5–7 и Луки 6:17–49</p>
          <p class="nag-study-description">Пять связанных исследований Матфея 5–7 и Луки 6:17–49: содержание, методология записи, адресат, богодухновенность и практическое применение. TMS · Chou · MacArthur · Chicago Statement · TMSJ</p>
          <nav class="nag-study-actions" aria-label="Начало исследования"><a href="/nagornaya/chast-1/" class="nag-study-start">Начать с первой части <span aria-hidden="true">→</span></a><a href="#пять-частей-серии" class="nag-study-all">Все пять частей <span aria-hidden="true">↓</span></a></nav>
          <div class="nag-study-metrics">
            <div class="nag-study-metric"><div class="nag-study-metric__number">5</div><div class="nag-study-metric__label">частей серии</div></div>
            <div class="nag-study-metric"><div class="nag-study-metric__number">120+</div><div class="nag-study-metric__label">источников</div></div>
            <div class="nag-study-metric"><div class="nag-study-metric__number">21</div><div class="nag-study-metric__label">находка</div></div>
            <div class="nag-study-metric"><div class="nag-study-metric__number">107</div><div class="nag-study-metric__label">стихов Мф</div></div>
            <div class="nag-study-metric"><div class="nag-study-metric__number">30</div><div class="nag-study-metric__label">стихов Лк</div></div>
          </div>
        </div>
        <figure class="nag-study-opening__art"><img src="/images/og-nagornaya-propoved.webp" width="1200" height="630" alt="Иллюстрация к исследованию Нагорной проповеди" loading="eager" decoding="async"><figcaption>Матфей 5–7 · Лука 6:17–49</figcaption></figure>
      </section>

      <!-- Parts grid -->
      <section class="nag-study-route" aria-labelledby="пять-частей-серии">
        <h2 id="пять-частей-серии" class="text-lg font-bold text-stone-800 mb-4">Пять частей серии</h2>
        <ol class="nag-study-parts" role="list">
          <li class="nag-study-part">
            <a class="nag-study-part__link" href="/nagornaya/chast-1/">
              <span class="nag-study-part__roman" aria-hidden="true">I</span>
              <div class="nag-study-part__body">
                <span class="nag-study-part__label">Часть I</span>
                <h3 class="nag-study-part__title">Два текста, один Иисус</h3>
                <p class="nag-study-part__subtitle">Содержание Мф 5–7 и Лк 6:17–49</p>
                <p class="nag-study-part__description">Архитектура проповеди, inclusio, антитезы, блаженства, «горе вам», два строителя. Почему нельзя читать только параллельные места.</p>
                <span class="nag-study-part__action">Читать исследование <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
          <li class="nag-study-part">
            <a class="nag-study-part__link" href="/nagornaya/chast-2/">
              <span class="nag-study-part__roman" aria-hidden="true">II</span>
              <div class="nag-study-part__body">
                <span class="nag-study-part__label">Часть II</span>
                <h3 class="nag-study-part__title">Как это записывалось</h3>
                <p class="nag-study-part__subtitle">Синоптическая проблема и богодухновенность</p>
                <p class="nag-study-part__description">Q-гипотеза, Independence View, ipsissima vox/verba, Chicago Statement, спектр консервативных позиций.</p>
                <span class="nag-study-part__action">Читать исследование <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
          <li class="nag-study-part">
            <a class="nag-study-part__link" href="/nagornaya/chast-3/">
              <span class="nag-study-part__roman" aria-hidden="true">III</span>
              <div class="nag-study-part__body">
                <span class="nag-study-part__label">Часть III</span>
                <h3 class="nag-study-part__title">Кому это сказано?</h3>
                <p class="nag-study-part__subtitle">Адресат и диапазон позиций</p>
                <p class="nag-study-part__description">Четыре уровня, пять позиций, Мф 5:20 как ключ, Мф 28:20 как аргумент, апостольские параллели.</p>
                <span class="nag-study-part__action">Читать исследование <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
          <li class="nag-study-part">
            <a class="nag-study-part__link" href="/nagornaya/chast-4/">
              <span class="nag-study-part__roman" aria-hidden="true">IV</span>
              <div class="nag-study-part__body">
                <span class="nag-study-part__label">Часть IV</span>
                <h3 class="nag-study-part__title">Богодухновенность</h3>
                <p class="nag-study-part__subtitle">Различия и доверие к Евангелиям</p>
                <p class="nag-study-part__description">Theopneustos, concursus (Warfield), Chicago Statement, Ин 14:26, современные опасности, тесты.</p>
                <span class="nag-study-part__action">Читать исследование <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
          <li class="nag-study-part">
            <a class="nag-study-part__link" href="/nagornaya/chast-5/">
              <span class="nag-study-part__roman" aria-hidden="true">V</span>
              <div class="nag-study-part__body">
                <span class="nag-study-part__label">Часть V</span>
                <h3 class="nag-study-part__title">Закон, Евангелие, Нагорная проповедь</h3>
                <p class="nag-study-part__subtitle">Спасение с признанием Господства и три usus Закона</p>
                <p class="nag-study-part__description">Блаженства как портрет спасённого, три использования Закона, пасторский баланс, зеркало / карта / дар.</p>
                <span class="nag-study-part__action">Читать исследование <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        </ol>
      </section>

      <section class="nag-study-resources" aria-labelledby="nag-study-resources-title">
        <h2 id="nag-study-resources-title">Исследовательский аппарат</h2>
        <div class="nag-study-resources__grid">
          <a href="/nagornaya/istochniki/" class="nag-study-resource">
            <span class="nag-study-resource__kicker">120+ источников</span>
            <h3>Источники серии</h3>
            <p>Полная библиография: TMSJ, книги, GTY-проповеди, исповедания, Чикагское заявление.</p>
            <span class="nag-study-part__action">Открыть библиографию <span aria-hidden="true">→</span></span>
          </a>
          <a href="/nagornaya/nakhodki/" class="nag-study-resource">
            <span class="nag-study-resource__kicker">21 позиция</span>
            <h3>Исследовательские находки</h3>
            <span class="nag-study-part__action">Открыть находки <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </section>

      <!-- Key quotes -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
          <div class="text-xs font-bold text-amber-700 mb-1.5 uppercase tracking-wide">Тематический центр</div>
          <blockquote class="text-stone-800 font-medium text-sm leading-relaxed">«Если праведность ваша не превзойдёт праведности книжников и фарисеев, то вы не войдёте в Царство Небесное»</blockquote>
          <div class="mt-2 text-xs text-stone-500">Мф 5:20 — ключ ко всей проповеди (MacArthur GTY #2222, 1979)</div>
        </div>
        <div class="bg-stone-50 border border-stone-200 rounded-xl p-4">
          <div class="text-xs font-bold text-stone-600 mb-1.5 uppercase tracking-wide">Итоговая формула</div>
          <blockquote class="text-stone-800 font-medium text-sm leading-relaxed">«Нагорная проповедь не является путём оправдания делами, законом Тысячелетия или недостижимым идеалом. Она — богодухновенное учение Царя о жизни тех, кто принадлежит Его Царству»</blockquote>
          <div class="mt-2 text-xs text-stone-500">Серия целиком · Ред.: Фёдор Милованов</div>
        </div>
      </div>

      <!-- Key verified sources -->
      <div class="bg-white border border-stone-200 rounded-xl p-5 shadow-sm">
        <h3 class="font-bold text-stone-800 mb-4 flex items-center gap-2"><span>🔑</span> Ключевые источники серии</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs"><div class="bg-stone-50 border border-stone-100 rounded-lg p-2.5"><div class="font-semibold text-stone-800 text-xs">MacArthur GTY #2222 (5 Aug 1979)</div><div class="text-stone-500 text-xs mt-0.5">Мф 5:20 как ключ; антитезы восстанавливают стандарт</div></div><div class="bg-stone-50 border border-stone-100 rounded-lg p-2.5"><div class="font-semibold text-stone-800 text-xs">Warfield, The Inspiration and Authority (P&R, 1948)</div><div class="text-stone-500 text-xs mt-0.5">Theopneustos = «выдохнуто Богом»; concursus</div></div><div class="bg-stone-50 border border-stone-100 rounded-lg p-2.5"><div class="font-semibold text-stone-800 text-xs">Chicago Statement on Biblical Inerrancy (1978), Art. XIII</div><div class="text-stone-500 text-xs mt-0.5">Различный отбор материала в параллельных текстах совместим с непогрешимостью</div></div><div class="bg-stone-50 border border-stone-100 rounded-lg p-2.5"><div class="font-semibold text-stone-800 text-xs">Calvin, Commentary Matthew 5:1 (CCEL/BibleHub)</div><div class="text-stone-500 text-xs mt-0.5">Прямо отвергает идею двух разных проповедей</div></div><div class="bg-stone-50 border border-stone-100 rounded-lg p-2.5"><div class="font-semibold text-stone-800 text-xs">Spurgeon, The Beatitudes (1873, SpurgeonGems)</div><div class="text-stone-500 text-xs mt-0.5">Блаженства = кто спасён, не как спастись</div></div><div class="bg-stone-50 border border-stone-100 rounded-lg p-2.5"><div class="font-semibold text-stone-800 text-xs">Feinberg, Inerrancy (Zondervan, 1980), p. 301</div><div class="text-stone-500 text-xs mt-0.5">Ipsissima vox — атрибуция термина, не MacArthur/Drawing Near</div></div><div class="bg-stone-50 border border-stone-100 rounded-lg p-2.5"><div class="font-semibold text-stone-800 text-xs">Turner, JETS 53/4 (2010)</div><div class="text-stone-500 text-xs mt-0.5">Scofield допускал «нравственное применение» — нельзя карикатурировать</div></div><div class="bg-stone-50 border border-stone-100 rounded-lg p-2.5"><div class="font-semibold text-stone-800 text-xs">Ligonier Study Guide (learn.ligonier.org)</div><div class="text-stone-500 text-xs mt-0.5">«полностью точное резюме под вдохновением Святого Духа»</div></div></div>
      </div>

    </div>
  <section class="gb-accuracy-block" aria-label="Обратная связь">
  <div class="gb-accuracy-inner">
    <h2 id="нашли-неточность" class="gb-accuracy-title">Нашли неточность?</h2>
    <p class="gb-accuracy-desc">
      Богословскую или техническую — напишите, исправим.
    </p>
    <div class="gb-accuracy-actions">
      <a href="mailto:viktorcoy2012@gmail.com?subject=Неточность%20в%20статье&body=Здравствуйте%2C%0A%0AЯ%20нашёл%20неточность%20в%20материале.%0A%0AОписание%3A%20"
         class="gb-accuracy-btn gb-accuracy-btn--email"
         aria-label="Написать на Email">
        <svg class="gb-accuracy-btn__icon"
             width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
          <rect x="2" y="4" width="20" height="16" rx="3"/>
          <path d="m2 7 10 7 10-7"/>
        </svg>
        <span class="gb-accuracy-btn__label">Email</span>
      </a>
      <a href="https://t.me/fedormilovanov"
         class="gb-accuracy-btn gb-accuracy-btn--tg"
         target="_blank" rel="noopener noreferrer"
         aria-label="Написать в Telegram (откроется в новой вкладке)">
        <svg class="gb-accuracy-btn__icon"
             width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
          <path d="M21.5 2.5 2.5 10l7.5 2 2 7.5 9.5-17Z"/>
          <path d="m10 12 10-9.5"/>
        </svg>
        <span class="gb-accuracy-btn__label">Telegram</span>
      </a>
    </div>
  </div>
</section><div class="article-end-block article-end-sdg-wrap"><div class="article-end-sdg" itemscope="" itemtype="https://schema.org/CreativeWork"><meta itemprop="about" content="Soli Deo Gloria"><span class="sdg" itemprop="name">Soli Deo Gloria</span><svg width="52" height="70" viewBox="0 0 52 70" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><line x1="26" y1="3" x2="26" y2="67" stroke="currentColor" stroke-width="5" stroke-linecap="round"></line><line x1="6" y1="19" x2="46" y2="19" stroke="currentColor" stroke-width="5" stroke-linecap="round"></line></svg></div></div>
</main>

<style>
.nag-study-opening{display:grid;grid-template-columns:minmax(0,1fr);gap:1.2rem;padding:clamp(1.15rem,3vw,2.4rem);border-radius:1rem;background:#25201c;color:#f7f0e3;overflow:hidden}
.nag-study-opening__text{min-width:0}.nag-study-title{font-size:clamp(1.8rem,3.3vw,2.8rem);line-height:1.14;font-weight:700;margin:0 0 .8rem;letter-spacing:-.025em}.nag-study-opening__art{margin:0;min-width:0;align-self:center}.nag-study-opening__art img{display:block;width:100%;height:auto;border-radius:.5rem}.nag-study-opening__art figcaption{color:#e1d3bd;font-size:.8rem;margin-top:.6rem;line-height:1.5}.nag-study-actions{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem 1rem;margin:1.15rem 0}.nag-study-actions a{display:inline-flex;align-items:center;gap:.6rem;min-height:44px;font-weight:600;font-size:.9rem;text-decoration:none}.nag-study-start{background:#edc780;color:#271c11;padding:.65rem .9rem;border-radius:.4rem}.nag-study-all{color:#f1d8a7;text-decoration:underline;text-underline-offset:.25rem}.nag-study-actions a:focus-visible{outline:2px solid #fff;outline-offset:4px}.nag-study-metrics{display:flex;flex-wrap:wrap;gap:.4rem .8rem;border-top:1px solid #ffffff30;padding-top:.9rem}.nag-study-metrics>div{min-width:0;background:transparent;border:none;border-radius:0;padding:.15rem .5rem .15rem 0;text-align:start}.nag-study-metrics>div>div:last-child{color:#e1d3bd}.nag-study-route h2{font-size:clamp(1.45rem,3vw,2rem);margin:0 0 1rem;scroll-margin-top:6rem}.nag-study-parts {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  list-style:none;
  padding:0;
  margin:0;
  gap:0 1.5rem;
}
.nag-study-part { min-width:0; margin:0; border-top:1px solid var(--color-border); }
.nag-study-part:first-child { grid-column:1/-1; }
.nag-study-part__link {
  display:grid;
  grid-template-columns:3.2rem minmax(0,1fr);
  align-items:start;
  gap:.8rem;
  padding:1.3rem 0;
  height:100%;
  color:var(--color-text);
  text-decoration:none;
}
.nag-study-part__roman {
  font-family:Georgia,serif;
  font-size:1.9rem;
  line-height:1;
  color:var(--color-accent-strong,var(--color-accent));
  border-inline-end:1px solid var(--color-border);
  padding:.25rem .6rem .6rem 0;
  text-align:center;
}
.nag-study-part__body { min-width:0; }
.nag-study-part__label,.nag-study-resource__kicker {
  display:block;
  color:var(--color-text-muted);
  font-size:.75rem;
  letter-spacing:.07em;
  line-height:1.5;
  text-transform:uppercase;
  margin-bottom:.3rem;
}
.nag-study-part__body .nag-study-part__title,.nag-study-resource h3 {
  margin:0 0 .4rem;
  font-size:clamp(1.17rem,1.8vw,1.45rem);
  font-weight:700;
  line-height:1.3;
  color:var(--color-text);
  text-wrap:pretty;
}
.nag-study-part:first-child .nag-study-part__title {font-size:clamp(1.4rem,2.5vw,1.85rem)}
.nag-study-part__body .nag-study-part__subtitle {margin:0 0 .65rem;color:var(--color-text-muted);font-size:.85rem;line-height:1.5}
.nag-study-part__body .nag-study-part__description,.nag-study-resource p {margin:0 0 .7rem;color:var(--color-text);font-size:.95rem;line-height:1.65}
.nag-study-part__action {display:inline-flex;align-items:center;gap:.45rem;color:var(--color-accent-strong,var(--color-accent));font-size:.85rem;font-weight:600;line-height:1.5}
.nag-study-part__link:hover .nag-study-part__title,.nag-study-resource:hover h3 {text-decoration:underline;text-underline-offset:.16em}
.nag-study-part__link:focus-visible,.nag-study-resource:focus-visible {outline:2px solid var(--color-accent);outline-offset:3px}
.nag-study-resources {border-top:2px solid var(--color-border);padding-top:1.2rem}
.nag-study-resources h2 {margin:0 0 .9rem;font-size:clamp(1.3rem,2.5vw,1.8rem);line-height:1.25;color:var(--color-text)}
.nag-study-resources__grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem}
.nag-study-resource {display:block;min-width:0;padding:1rem;border:1px solid var(--color-border);border-radius:.5rem;background:var(--color-surface-2,var(--color-surface));color:var(--color-text);text-decoration:none}
@media(max-width:580px){.nag-study-parts,.nag-study-resources__grid{grid-template-columns:minmax(0,1fr)}.nag-study-part__link{grid-template-columns:2.4rem minmax(0,1fr);gap:.7rem;padding:1rem 0}.nag-study-part__roman{font-size:1.55rem;padding-inline-end:.3rem}}
@media(min-width:700px){.nag-study-opening{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);align-items:center}}
@media(max-width:580px){.nag-study-parts{grid-template-columns:1fr}.nag-study-opening__art img{max-height:9rem;object-fit:cover;object-position:50% 45%}.nag-study-metrics{gap:.4rem .75rem}.nag-study-opening__art figcaption{font-size:.75rem}}


.nag-study-kicker{margin:0 0 .8rem}
.nag-study-kicker__label{color:#edc780;font-size:.8rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase}
.nag-study-opening .nag-study-subtitle{color:#f2e4d1;font-size:clamp(1rem,1.5vw,1.15rem);line-height:1.5;margin:0 0 .45rem}
.nag-study-opening .nag-study-description{color:#d9cbbb;font-size:.9rem;line-height:1.55;margin:0}
.nag-study-metric__number{font-size:1.25rem;line-height:1.35;font-weight:700;color:#edc780}
.nag-study-metrics .nag-study-metric__label{font-size:.76rem;line-height:1.4;color:#e1d3bd}
.nag-study-opening .nag-study-metrics{margin:0}
@media(max-width:699px){.nag-study-opening{gap:.9rem;padding:1.05rem}.nag-study-actions{margin:.85rem 0}.nag-study-opening__art img{max-height:9rem;object-fit:cover}.nag-study-metrics{padding-top:.6rem}}
</style>
