---
import { assetUrl } from '@/lib/asset-version';
/**
 * NagornayaSeriyaPageFooter — native body tail after </main> for /nagornaya/seriya//.
 * Extracted as Astro markup from approved legacy HTML; no raw imports.
 */
---
<!-- FOOTER -->
    <footer class="h-footer" role="contentinfo">
      <span class="h-footer-copy">© 2026 Господь Бог — <span>Сила Моя</span></span>
      <a href="../../about/">Об авторе</a>
    </footer>

  </div>
</div>

<button class="h-scroll-top" id="hScrollTop" type="button" aria-label="Наверх">
  <svg class="h-progress-ring" width="50" height="50" viewBox="0 0 50 50" aria-hidden="true">
    <circle class="h-progress-ring-circle" id="hProgressCircle" cx="25" cy="25" r="22" style="stroke-dasharray: 138.23; stroke-dashoffset: 138.23;"/>
  </svg>
  <span class="h-scroll-top-arrow" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="18 15 12 9 6 15"/></svg>
  </span>
</button>



<script defer src={assetUrl('js/site-utils.js')} is:inline></script>
    <script defer src={assetUrl('js/scroll-perf.js')} is:inline></script>
    <script src={assetUrl('js/site.js')} defer is:inline></script>
<!-- home infrastructure handled by js/site.js module 35 -->

<script src={assetUrl('js/sw-register.js')} defer is:inline></script>

<script src={assetUrl('js/highlights.js')} defer is:inline></script>
<script src={assetUrl('js/enhancements.js')} defer is:inline></script>
<script src={assetUrl('js/bookmark-engine.js')} defer is:inline></script>
