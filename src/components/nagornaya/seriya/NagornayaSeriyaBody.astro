                     alt="Нагорная проповедь, часть III: Кому это сказано?"
                     decoding="async" loading="lazy" width="160" height="108">
              </div>
              <div class="h-article-body">
                <div class="h-article-kicker">Часть III</div>
                <h3 class="h-article-title">Кому это сказано?</h3>
                <div class="h-article-meta">
                  <span class="h-meta-author">Редактор: Фёдор Милованов</span>
                  <span class="h-meta-sep" aria-hidden="true">·</span>
                  <span class="h-meta-tag">Адресат</span>
                </div>
                <p class="h-article-abstract">Четыре уровня аудитории, пять позиций в богословской традиции, Мф 5:20 как ключ ко всей проповеди, Мф 28:20 как аргумент, биографический перелом МакАртура.</p>
              </div>
            </a>
          </li>

          <!-- Часть IV -->
          <li>
            <a href="/nagornaya/chast-4/" class="h-article-card">
              <div class="h-article-thumb">
                <img src="../../images/og-nagornaya-propoved-chast-4.webp"
                     alt="Нагорная проповедь, часть IV: Богодухновенность"
