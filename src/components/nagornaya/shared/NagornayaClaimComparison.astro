---
import {
  getNagornayaClaimProjection,
  nagornayaConfidenceLabels,
  nagornayaLayerLabels,
  type NagornayaClaimLayer,
  type NagornayaClaimProjection,
} from '../../../lib/nagornaya-claim-projection';

interface Props {
  claimId?: string;
  projection?: NagornayaClaimProjection;
  title?: string;
}

const { claimId, projection, title = 'Карта аргумента и альтернатив' } = Astro.props;

if (!claimId && !projection) {
  throw new Error('NagornayaClaimComparison requires claimId or projection');
}

const claim = projection ?? getNagornayaClaimProjection(claimId as string);
const headingId = `nagornaya-claim-${claim.id}`;
const layerOrder: NagornayaClaimLayer[] = [
  'textual-observation',
  'historical-reconstruction',
  'literary-model',
  'doctrinal-synthesis',
  'pastoral-application',
];
---

<section
  class="nagornaya-claim-comparison"
  aria-labelledby={headingId}
  data-nagornaya-claim-comparison
  data-claim-id={claim.id}
  data-claim-layer={claim.layer}
>
  <header class="nagornaya-claim-comparison__header">
    <div>
      <p class="nagornaya-claim-comparison__eyebrow">Аргумент · альтернатива · предел</p>
      <h3 id={headingId}>{title}</h3>
    </div>
    <p class="nagornaya-claim-comparison__confidence">
      <span>Уверенность</span>
      <strong>{nagornayaConfidenceLabels[claim.confidence]}</strong>
    </p>
  </header>

  <ol class="nagornaya-claim-comparison__layers" aria-label="Уровни аргументации">
    {layerOrder.map((layer, index) => (
      <li class:list={{ 'is-active': layer === claim.layer }} aria-current={layer === claim.layer ? 'step' : undefined}>
        <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        {nagornayaLayerLabels[layer]}
      </li>
    ))}
  </ol>

  <div class="nagornaya-claim-comparison__claim">
    <p class="nagornaya-claim-comparison__label">Тезис или модель</p>
    <p>{claim.claim}</p>
  </div>

  <div class="nagornaya-claim-comparison__grid">
    <section class="nagornaya-claim-comparison__cell">
      <h4>Первичные основания</h4>
      {claim.primaryEvidence.length > 0 ? (
        <ul class="nagornaya-claim-comparison__evidence">
          {claim.primaryEvidence.map((source) => (
            <li>
              <strong>{source.author ? `${source.author}. ` : ''}{source.title}</strong>
              {(source.publication || source.exactObject || source.pages) && (
                <span>
                  {[source.publication, source.exactObject, source.pages ? `с. ${source.pages}` : '']
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              )}
              {source.note && <small>{source.note}</small>}
            </li>
          ))}
        </ul>
      ) : (
        <p>Для этой проекции основание формулируется в тексте раздела; отдельный bibliographic claim не создаётся.</p>
      )}
    </section>

    <section class="nagornaya-claim-comparison__cell nagornaya-claim-comparison__cell--alternative">
      <h4>Альтернатива, которую нужно услышать</h4>
      <p>{claim.alternative}</p>
    </section>

    <section class="nagornaya-claim-comparison__cell">
      <h4>Предел аргумента</h4>
      <p>{claim.limits}</p>
    </section>

    <section class="nagornaya-claim-comparison__cell nagornaya-claim-comparison__cell--position">
      <h4>Позиция серии</h4>
      <p>{claim.seriesPosition}</p>
    </section>
  </div>

  <footer class="nagornaya-claim-comparison__footer">
    <strong>Что изменит вывод</strong>
    <p>{claim.changeCondition}</p>
  </footer>
</section>

<style>
  .nagornaya-claim-comparison {
    --comparison-border: var(--color-border, #d6d3d1);
    --comparison-border-strong: var(--color-border-strong, #a8a29e);
    --comparison-surface: var(--color-surface, #ffffff);
    --comparison-muted-surface: var(--color-surface-muted, #f5f5f4);
    --comparison-text: var(--color-text, #292524);
    --comparison-muted: var(--color-text-muted, #78716c);
    --comparison-accent: var(--color-accent, #a16207);
    margin: 1.5rem 0;
    overflow: hidden;
    border: 1px solid var(--comparison-border);
    border-radius: 1rem;
    background: var(--comparison-surface);
    color: var(--comparison-text);
    box-shadow: 0 10px 30px rgb(41 37 36 / 0.07);
  }

  .nagornaya-claim-comparison__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    border-bottom: 1px solid var(--comparison-border);
  }

  .nagornaya-claim-comparison__eyebrow,
  .nagornaya-claim-comparison__label {
    margin: 0 0 0.35rem;
    color: var(--comparison-muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nagornaya-claim-comparison h3,
  .nagornaya-claim-comparison h4,
  .nagornaya-claim-comparison p {
    margin-top: 0;
  }

  .nagornaya-claim-comparison h3 {
    margin-bottom: 0;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.25;
  }

  .nagornaya-claim-comparison__confidence {
    flex: 0 0 auto;
    margin-bottom: 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--comparison-border);
    border-radius: 0.7rem;
    background: var(--comparison-muted-surface);
    font-size: 0.72rem;
    line-height: 1.25;
    text-align: right;
  }

  .nagornaya-claim-comparison__confidence span,
  .nagornaya-claim-comparison__confidence strong {
    display: block;
  }

  .nagornaya-claim-comparison__confidence span {
    color: var(--comparison-muted);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nagornaya-claim-comparison__layers {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--comparison-border);
    list-style: none;
  }

  .nagornaya-claim-comparison__layers li {
    min-width: 0;
    padding: 0.7rem 0.55rem;
    border-right: 1px solid var(--comparison-border);
    color: var(--comparison-muted);
    font-size: 0.66rem;
    font-weight: 650;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .nagornaya-claim-comparison__layers li:last-child {
    border-right: 0;
  }

  .nagornaya-claim-comparison__layers li span {
    display: block;
    margin-bottom: 0.2rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.65;
  }

  .nagornaya-claim-comparison__layers .is-active {
    box-shadow: inset 0 -3px 0 var(--comparison-accent);
    background: var(--comparison-muted-surface);
    color: var(--comparison-text);
  }

  .nagornaya-claim-comparison__claim {
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid var(--comparison-border);
  }

  .nagornaya-claim-comparison__claim > p:last-child {
    margin-bottom: 0;
    font-size: 0.96rem;
    font-weight: 650;
    line-height: 1.6;
  }

  .nagornaya-claim-comparison__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .nagornaya-claim-comparison__cell {
    min-width: 0;
    padding: 1.1rem 1.25rem;
    border-right: 1px solid var(--comparison-border);
    border-bottom: 1px solid var(--comparison-border);
  }

  .nagornaya-claim-comparison__cell:nth-child(2n) {
    border-right: 0;
  }

  .nagornaya-claim-comparison__cell:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  .nagornaya-claim-comparison__cell--alternative,
  .nagornaya-claim-comparison__cell--position {
    background: color-mix(in srgb, var(--comparison-muted-surface) 70%, transparent);
  }

  .nagornaya-claim-comparison__cell h4 {
    margin-bottom: 0.5rem;
    color: var(--comparison-muted);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nagornaya-claim-comparison__cell p,
  .nagornaya-claim-comparison__evidence {
    margin-bottom: 0;
    font-size: 0.82rem;
    line-height: 1.58;
  }

  .nagornaya-claim-comparison__evidence {
    display: grid;
    gap: 0.65rem;
    padding-left: 1rem;
  }

  .nagornaya-claim-comparison__evidence strong,
  .nagornaya-claim-comparison__evidence span,
  .nagornaya-claim-comparison__evidence small {
    display: block;
  }

  .nagornaya-claim-comparison__evidence span,
  .nagornaya-claim-comparison__evidence small {
    margin-top: 0.15rem;
    color: var(--comparison-muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .nagornaya-claim-comparison__footer {
    display: grid;
    grid-template-columns: minmax(8rem, 0.32fr) minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    border-top: 1px solid var(--comparison-border);
    background: var(--comparison-muted-surface);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .nagornaya-claim-comparison__footer p {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .nagornaya-claim-comparison__header {
      display: grid;
    }

    .nagornaya-claim-comparison__confidence {
      justify-self: start;
      text-align: left;
    }

    .nagornaya-claim-comparison__layers {
      grid-template-columns: 1fr;
      padding: 0.55rem 0;
    }

    .nagornaya-claim-comparison__layers li {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      align-items: center;
      padding: 0.38rem 0.9rem;
      border-right: 0;
    }

    .nagornaya-claim-comparison__layers li span {
      margin-bottom: 0;
    }

    .nagornaya-claim-comparison__layers .is-active {
      box-shadow: inset 3px 0 0 var(--comparison-accent);
    }

    .nagornaya-claim-comparison__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .nagornaya-claim-comparison__cell,
    .nagornaya-claim-comparison__cell:nth-child(2n),
    .nagornaya-claim-comparison__cell:nth-last-child(-n + 2) {
      border-right: 0;
      border-bottom: 1px solid var(--comparison-border);
    }

    .nagornaya-claim-comparison__cell:last-child {
      border-bottom: 0;
    }

    .nagornaya-claim-comparison__footer {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nagornaya-claim-comparison *,
    .nagornaya-claim-comparison *::before,
    .nagornaya-claim-comparison *::after {
      scroll-behavior: auto !important;
      transition: none !important;
    }
  }

  @media print {
    .nagornaya-claim-comparison {
      break-inside: avoid;
      box-shadow: none;
    }
  }
</style>
