---
/**
 * NagornayaPageMain.astro — shared semantic block component for all Nagornaya
 * pages. Each Nagornaya page (landing + chast-1..5 + seriya + istochniki +
 * nakhodki) has its own _legacy/main.html fragment. We use Vite import.meta.glob
 * to load all of them at build time, then resolve by slug prop.
 *
 * РЕФАКТОРИНГ 5.0 Phase 6 wave 7 (AGENTS-r255).
 */

export interface Props {
  slug: 'index' | 'chast-1' | 'chast-2' | 'chast-3' | 'chast-4' | 'chast-5' | 'seriya' | 'istochniki' | 'nakhodki';
}

const { slug } = Astro.props;

// Vite import.meta.glob: relative to THIS component file.
// Files are at src/components/nagornaya/<slug>/_legacy/*.html
// glob pattern resolves at build time.
const mainModules = import.meta.glob<{ default: string }>('./*/_legacy/main.html', { query: '?raw', import: 'default', eager: true });
const seg0Modules = import.meta.glob<{ default: string }>('./*/_legacy/body-segment-0.html', { query: '?raw', import: 'default', eager: true });
const seg1Modules = import.meta.glob<{ default: string }>('./*/_legacy/body-segment-1.html', { query: '?raw', import: 'default', eager: true });

const mainHtml = mainModules[`./${slug}/_legacy/main.html`];
const segBeforeHtml = seg0Modules[`./${slug}/_legacy/body-segment-0.html`];
const segAfterHtml = seg1Modules[`./${slug}/_legacy/body-segment-1.html`];
---

<Fragment set:html={segBeforeHtml} />
<Fragment set:html={mainHtml} />
<Fragment set:html={segAfterHtml} />
