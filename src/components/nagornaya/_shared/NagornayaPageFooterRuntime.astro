---
import { assetUrl } from '@/lib/asset-version';
import ReaderFloatingControlsRuntime from '@/components/reader-platform/ReaderFloatingControlsRuntime.astro';
/**
 * Canonical native runtime tail for every published part of the Nagornaya
 * series. Each feature has one explicit owner; the legacy site.js monolith is
 * intentionally absent.
 */
import ReaderActionsRuntime from '@/components/reader-platform/ReaderActionsRuntime.astro';
---
<script defer src={assetUrl('js/site-utils.js')} is:inline></script>
<script defer src={assetUrl('js/scroll-perf.js')} is:inline></script>
<script src={assetUrl('js/glossary.js')} defer is:inline></script>
<script src={assetUrl('js/sw-register.js')} defer is:inline></script>

<script src={assetUrl('js/highlights.js')} defer is:inline></script>
<script src={assetUrl('js/nagornaya-mobile-toc.js')} defer is:inline></script>
<script src={assetUrl('js/nagornaya-bar-extras.js')} defer is:inline></script>
<script src={assetUrl('js/enhancements.js')} defer is:inline></script>
<script src={assetUrl('js/bookmark-engine.js')} defer is:inline></script>
<div role="region" aria-label="Прогресс чтения">
  <div id="read-progress" role="progressbar" aria-label="Прогресс чтения" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
</div>
<ReaderFloatingControlsRuntime />
<ReaderActionsRuntime />
