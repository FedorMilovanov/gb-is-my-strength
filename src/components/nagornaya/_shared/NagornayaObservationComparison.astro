---
interface ObservationRow { observation:string; possibleExplanation:string; competingExplanation:string; confidence:string }
interface Props { blockId:string; title:string; rows:ObservationRow[] }
const {blockId,title,rows}=Astro.props;if(!/^[a-z][a-z0-9-]*$/.test(blockId)) throw new Error(`Invalid Nagornaya observation blockId: ${blockId}`);const headingId=`${blockId}-title`;
---
<section class="ng-observation-matrix" id={blockId} data-nagornaya-epistemic-ui="observation-matrix" aria-labelledby={headingId}>
<header><p>Наблюдение ≠ объяснение</p><h3 id={headingId}>{title}</h3><div>Первая колонка фиксирует видимый текст. Остальные колонки показывают реконструкции, которые требуют отдельного аргумента.</div></header>
<div class="ng-observation-matrix__scroll" tabindex="0" role="region" aria-label="Прокручиваемая таблица наблюдений и объяснений"><table><thead><tr><th>Наблюдение</th><th>Возможное объяснение</th><th>Конкурирующее объяснение</th><th>Уверенность</th></tr></thead><tbody>{rows.map(row=><tr><td>{row.observation}</td><td>{row.possibleExplanation}</td><td>{row.competingExplanation}</td><td>{row.confidence}</td></tr>)}</tbody></table></div>
</section>
<style>
.ng-observation-matrix{margin:1.25rem 0 2rem;border:1px solid #d6d3d1;border-radius:1rem;overflow:hidden;background:#fff}.ng-observation-matrix header{padding:1rem 1.15rem;background:#fafaf9;border-bottom:1px solid #d6d3d1}.ng-observation-matrix header p{margin:0 0 .35rem;color:#78716c;font-size:.7rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.ng-observation-matrix h3{margin:0;color:#292524;font-size:1.15rem}.ng-observation-matrix header div{margin-top:.45rem;color:#57534e;font-size:.85rem;line-height:1.5}.ng-observation-matrix__scroll{overflow-x:auto;overscroll-behavior-inline:contain}.ng-observation-matrix table{width:100%;min-width:48rem;border-collapse:collapse}.ng-observation-matrix th,.ng-observation-matrix td{padding:.75rem .85rem;border-bottom:1px solid #e7e5e4;text-align:left;vertical-align:top}.ng-observation-matrix th{background:#292524;color:#fafaf9;font-size:.72rem;letter-spacing:.035em}.ng-observation-matrix td{color:#57534e;font-size:.8rem;line-height:1.5}.ng-observation-matrix td:first-child{font-weight:750;color:#292524}.ng-observation-matrix tbody tr:last-child td{border-bottom:0}.ng-observation-matrix__scroll:focus-visible{outline:3px solid #f59e0b;outline-offset:-3px}@media(max-width:640px){.ng-observation-matrix header{padding:.9rem}}:global(html.dark) .ng-observation-matrix,:global(html[data-theme='dark']) .ng-observation-matrix{border-color:#57534e;background:#1c1917}:global(html.dark) .ng-observation-matrix header,:global(html[data-theme='dark']) .ng-observation-matrix header{border-color:#57534e;background:#292524}:global(html.dark) .ng-observation-matrix h3,:global(html.dark) .ng-observation-matrix td:first-child,:global(html[data-theme='dark']) .ng-observation-matrix h3,:global(html[data-theme='dark']) .ng-observation-matrix td:first-child{color:#fafaf9}:global(html.dark) .ng-observation-matrix header div,:global(html.dark) .ng-observation-matrix td,:global(html[data-theme='dark']) .ng-observation-matrix header div,:global(html[data-theme='dark']) .ng-observation-matrix td{color:#d6d3d1}:global(html.dark) .ng-observation-matrix th,:global(html[data-theme='dark']) .ng-observation-matrix th{background:#0c0a09}:global(html.dark) .ng-observation-matrix th,:global(html.dark) .ng-observation-matrix td,:global(html[data-theme='dark']) .ng-observation-matrix th,:global(html[data-theme='dark']) .ng-observation-matrix td{border-color:#44403c}
</style>
