---
interface LibraryLinkItem {
  href: string;
  meta: string;
  title: string;
  description: string;
}

interface Props {
  items: LibraryLinkItem[];
  headingId?: string;
}

const {
  items,
  headingId = 'nagornaya-library-links-title',
} = Astro.props;

if (!/^[a-z][a-z0-9-]*$/.test(headingId)) {
  throw new Error(`Invalid Nagornaya library headingId: ${headingId}`);
}
---
<section class="nag-library-links" aria-labelledby={headingId}>
  <div class="nag-library-links__heading">
    <span class="nag-library-links__accent" aria-hidden="true"></span>
    <h2 id={headingId}>Из библиотеки</h2>
    <span class="nag-library-links__rule" aria-hidden="true"></span>
  </div>

  <div class="nag-library-links__grid">
    {items.map((item) => (
      <a class="gb-series-link nag-library-link" href={item.href}>
        <div class="nag-library-link__topline">
          <span class="nag-library-link__meta">{item.meta}</span>
          <svg class="nag-library-link__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </div>
        <div>
          <p class="nag-library-link__title">{item.title}</p>
          <p class="nag-library-link__description">{item.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .nag-library-links {
    margin-top: 3rem;
  }

  .nag-library-links__heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.25rem;
  }

  .nag-library-links__accent {
    width: 3px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--color-accent), var(--color-accent-strong));
  }

  .nag-library-links__heading h2 {
    margin: 0;
    color: var(--color-text-muted);
    font-family: monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .nag-library-links__rule {
    height: 1px;
    flex: 1;
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  .nag-library-links__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }

  .nag-library-link {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 1.1rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
    border-radius: 10px;
    background: var(--color-surface-2);
    box-shadow: var(--shadow-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color .2s ease, background-color .2s ease, transform .2s ease;
  }

  .nag-library-link__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
  }

  .nag-library-link__meta {
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: monospace;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .nag-library-link__arrow {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .nag-library-link__title {
    margin: 0 0 4px;
    color: var(--color-text);
    font-size: .93rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .nag-library-link__description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .76rem;
    line-height: 1.5;
  }

  @media (hover: hover) and (pointer: fine) {
    .nag-library-link:hover {
      border-color: color-mix(in srgb, var(--color-accent) 52%, var(--color-border));
      background: var(--color-surface);
      transform: translateY(-1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nag-library-link {
      transition: none;
    }

    .nag-library-link:hover {
      transform: none;
    }
  }
</style>
