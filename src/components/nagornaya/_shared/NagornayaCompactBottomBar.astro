---
/**
 * Shared narrow-viewport contract for the native Nagornaya chapter bar,
 * glossary cards, long section headings and WebKit intrinsic-width isolation.
 *
 * Closed glossary cards must not contribute intrinsic width. The canonical
 * tooltip controller moves a card to <body> and adds .gb-floating-tip before
 * it becomes visible.
 *
 * At <=359px every overflow wrapper owns its width locally. Two-column
 * comparison tables that carry the legacy min-w-96 utility no longer demand a
 * 384px canvas: they use the available inline size, fixed column geometry and
 * wrapped cells. Other genuinely wide tables may still use the wrapper as a
 * local horizontal scrollport. Page-root clipping is never used.
 *
 * Decorative section-subtitle indentation is removed at the same breakpoint.
 * On an iPhone 320 the subtitle receives the full content width, including when
 * glossary markup is injected, instead of enlarging the document.
 *
 * Part III has two additional route-owned narrow layouts: the opening
 * three-column audience matrix and the final summary rows. At iPhone 320 the
 * matrix body becomes a vertical record list while its compact header remains
 * three equal shrinkable columns; final summary labels stack over their text.
 *
 * The mobile TOC keeps progress and sharing available, so at <=359px the
 * persistent bar may drop those duplicate controls (plus the redundant Up
 * action) instead of forcing Play/Save and Share outside the viewport.
 */
---
<style is:global>
  body.nagornaya-page .gtip:not(.gb-floating-tip) {
    display: none !important;
  }

  @media (max-width: 359px) {
    body.nagornaya-page #main-content .overflow-x-auto {
      display: block;
      inline-size: 100%;
      max-inline-size: 100%;
      min-inline-size: 0;
      overflow-x: auto !important;
      overflow-y: hidden;
      contain: inline-size layout paint;
      isolation: isolate;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
    }

    body.nagornaya-page #main-content .overflow-x-auto > table.min-w-96 {
      inline-size: 100%;
      min-inline-size: 100% !important;
      table-layout: fixed;
    }

    body.nagornaya-page #main-content .overflow-x-auto > table.min-w-96 th,
    body.nagornaya-page #main-content .overflow-x-auto > table.min-w-96 td {
      min-inline-size: 0;
      overflow-wrap: anywhere;
      word-break: normal;
    }

    body.nagornaya-chast-3-page #main-content .grid.grid-cols-3.bg-stone-900 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    body.nagornaya-chast-3-page #main-content .grid.grid-cols-3.bg-stone-900 > * {
      min-inline-size: 0;
      padding-inline: 8px;
      text-align: center;
      overflow-wrap: anywhere;
    }

    body.nagornaya-chast-3-page #main-content .grid.grid-cols-3:not(.bg-stone-900) {
      grid-template-columns: minmax(0, 1fr);
    }

    body.nagornaya-chast-3-page #main-content .grid.grid-cols-3:not(.bg-stone-900) > * {
      min-inline-size: 0;
      padding-inline: 16px;
      overflow-wrap: anywhere;
    }

    body.nagornaya-chast-3-page #main-content .bg-purple-800 .space-y-4 > .flex {
      flex-direction: column;
      gap: 4px;
    }

    body.nagornaya-chast-3-page #main-content .bg-purple-800 .space-y-4 > .flex > span {
      min-inline-size: 0;
      max-inline-size: 100%;
      overflow-wrap: anywhere;
    }

    body.nagornaya-chast-3-page #main-content .bg-purple-800 .space-y-4 > .flex > .w-32 {
      inline-size: auto;
    }

    body.nagornaya-page #main-content .group,
    body.nagornaya-page #main-content .group > .flex,
    body.nagornaya-page #main-content .group > .flex > h2 {
      min-width: 0;
      max-width: 100%;
    }

    body.nagornaya-page #main-content .group > .flex > h2 {
      overflow-wrap: anywhere;
    }

    body.nagornaya-page #main-content .group > p.ml-14 {
      margin-left: 0 !important;
      inline-size: 100%;
      max-inline-size: 100%;
      min-inline-size: 0;
      box-sizing: border-box;
      overflow-wrap: anywhere;
    }

    body.nagornaya-page #bottomBar .bar-progress,
    body.nagornaya-page #bottomBar .bar-divider,
    body.nagornaya-page #bottomBar #barUpBtn,
    body.nagornaya-page #bottomBar #barShareBtn {
      display: none !important;
    }

    body.nagornaya-page #bottomBar .bottom-bar-inner {
      gap: 5px;
      min-width: 0;
    }

    body.nagornaya-page #bottomBar .bar-section-btn {
      min-width: 0;
      padding-inline: 8px;
    }

    body.nagornaya-page #bottomBar .nag-bar-controls {
      flex: 0 0 auto;
      width: auto;
      min-width: 0;
      gap: 4px;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
    }

    body.nagornaya-page #bottomBar .nag-bar-controls .gb-ember-expand {
      position: fixed !important;
      left: max(10px, env(safe-area-inset-left, 10px)) !important;
      right: max(10px, env(safe-area-inset-right, 10px)) !important;
      bottom: calc(68px + env(safe-area-inset-bottom, 0px)) !important;
      width: auto !important;
      max-width: none !important;
      transform: none !important;
      box-sizing: border-box;
      z-index: calc(var(--z-bottom-bar, 2000) + 1);
    }
  }
</style>
