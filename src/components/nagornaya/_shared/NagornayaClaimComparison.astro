---
import registry from '../../../../data/nagornaya/source-registry.json';

interface Props {
  claimIds: string[];
  title?: string;
  description?: string;
}

const {
  claimIds,
  title = 'Как различать данные, реконструкцию и богословский вывод',
  description = 'Сначала представлены проверяемые свидетельства и альтернативная модель; затем — позиция серии, степень уверенности и условие пересмотра.',
} = Astro.props;

const layerLabels: Record<string, string> = {
  'textual-observation': 'Наблюдение над текстом',
  'historical-reconstruction': 'Историческая реконструкция',
  'literary-model': 'Литературная модель',
  'doctrinal-synthesis': 'Богословский синтез',
  application: 'Применение',
};

const confidenceLabels: Record<string, string> = {
  high: 'Высокая',
  medium: 'Средняя',
  low: 'Низкая',
  unsupported: 'Не подтверждено',
};

const claims = claimIds.map((id) => {
  const claim = registry.claims.find((entry) => entry.id === id);
  if (!claim) throw new Error(`Unknown Nagornaya claim id: ${id}`);

  const sources = claim.primaryEvidence.map((sourceId) => {
    const source = registry.sources.find((entry) => entry.id === sourceId);
    if (!source) throw new Error(`Unknown Nagornaya source id: ${sourceId}`);
    return source;
  });

  return { claim, sources };
});
---

<section class="ng-claim-comparison" aria-labelledby="ng-claim-comparison-title">
  <header class="ng-claim-comparison__header">
    <p class="ng-claim-comparison__eyebrow">Слои аргументации</p>
    <h2 id="ng-claim-comparison-title">{title}</h2>
    <p>{description}</p>
  </header>

  <div class="ng-claim-comparison__list">
    {claims.map(({ claim, sources }, index) => (
      <article class="ng-claim-card" aria-labelledby={`ng-claim-${claim.id}`}>
        <div class="ng-claim-card__topline">
          <span class="ng-claim-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="ng-claim-card__layer">{layerLabels[claim.layer] ?? claim.layer}</span>
          <span class="ng-claim-card__confidence">
            Уверенность: {confidenceLabels[claim.confidence] ?? claim.confidence}
          </span>
        </div>

        <h3 id={`ng-claim-${claim.id}`}>{claim.claim}</h3>

        <dl class="ng-claim-card__grid">
          <div>
            <dt>Первичные свидетельства</dt>
            <dd>
              {sources.length ? (
                <ul>
                  {sources.map((source) => (
                    <li>
                      <a href={source.resolvedUrl} rel="noopener noreferrer">
                        {source.author}. {source.title}
                      </a>
                      <span>{source.volumeIssueYear}, с. {source.pages}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <span>В реестре нет первичного источника для этого уровня атрибуции.</span>
              )}
            </dd>
          </div>

          <div>
            <dt>Альтернативная модель</dt>
            <dd>{claim.alternative}</dd>
          </div>

          <div class="ng-claim-card__position">
            <dt>Позиция серии</dt>
            <dd>{claim.seriesPosition}</dd>
          </div>

          <div>
            <dt>Границы вывода</dt>
            <dd>
              Уровень атрибуции: <strong>{claim.attributionLevel}</strong>. Публикация автора не повышается автоматически до официальной позиции учреждения.
            </dd>
          </div>

          <div class="ng-claim-card__change">
            <dt>Что может изменить вывод</dt>
            <dd>{claim.changeCondition}</dd>
          </div>
        </dl>
      </article>
    ))}
  </div>
</section>

<style>
  .ng-claim-comparison {
    margin: 3rem 0;
    border: 1px solid rgb(214 211 209);
    border-radius: 1.25rem;
    background: rgb(250 250 249);
    overflow: clip;
  }

  .ng-claim-comparison__header {
    padding: 1.5rem;
    border-bottom: 1px solid rgb(214 211 209);
    background: linear-gradient(135deg, rgb(255 251 235), rgb(250 250 249));
  }

  .ng-claim-comparison__eyebrow {
    margin: 0 0 .5rem;
    color: rgb(180 83 9);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .ng-claim-comparison h2 {
    margin: 0;
    color: rgb(41 37 36);
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    line-height: 1.2;
  }

  .ng-claim-comparison__header > p:last-child {
    max-width: 68ch;
    margin: .75rem 0 0;
    color: rgb(87 83 78);
    line-height: 1.65;
  }

  .ng-claim-comparison__list {
    display: grid;
    gap: 1px;
    background: rgb(214 211 209);
  }

  .ng-claim-card {
    padding: 1.5rem;
    background: rgb(255 255 255);
  }

  .ng-claim-card__topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem .75rem;
    margin-bottom: .9rem;
  }

  .ng-claim-card__number {
    color: rgb(168 162 158);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .75rem;
  }

  .ng-claim-card__layer,
  .ng-claim-card__confidence {
    border-radius: 999px;
    padding: .32rem .65rem;
    font-size: .72rem;
    font-weight: 750;
  }

  .ng-claim-card__layer {
    background: rgb(245 245 244);
    color: rgb(68 64 60);
  }

  .ng-claim-card__confidence {
    margin-left: auto;
    background: rgb(236 253 245);
    color: rgb(6 95 70);
  }

  .ng-claim-card h3 {
    margin: 0;
    color: rgb(41 37 36);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .ng-claim-card__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 0;
  }

  .ng-claim-card__grid > div {
    min-width: 0;
    border: 1px solid rgb(231 229 228);
    border-radius: .9rem;
    padding: 1rem;
    background: rgb(250 250 249);
  }

  .ng-claim-card__grid dt {
    margin-bottom: .45rem;
    color: rgb(120 113 108);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .ng-claim-card__grid dd {
    margin: 0;
    color: rgb(68 64 60);
    font-size: .9rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .ng-claim-card__grid ul {
    margin: 0;
    padding-left: 1.15rem;
  }

  .ng-claim-card__grid li + li {
    margin-top: .6rem;
  }

  .ng-claim-card__grid a {
    color: rgb(146 64 14);
    font-weight: 700;
    text-decoration-thickness: .08em;
    text-underline-offset: .18em;
  }

  .ng-claim-card__grid li span {
    display: block;
    margin-top: .2rem;
    color: rgb(120 113 108);
    font-size: .8rem;
  }

  .ng-claim-card__position {
    border-color: rgb(253 230 138) !important;
    background: rgb(255 251 235) !important;
  }

  .ng-claim-card__change {
    grid-column: 1 / -1;
  }

  @media (max-width: 640px) {
    .ng-claim-comparison {
      margin-inline: 0;
      border-radius: 1rem;
    }

    .ng-claim-comparison__header,
    .ng-claim-card {
      padding: 1rem;
    }

    .ng-claim-card__confidence {
      margin-left: 0;
    }

    .ng-claim-card__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .ng-claim-card__change {
      grid-column: auto;
    }
  }

  :global(html.dark) .ng-claim-comparison,
  :global(html[data-theme='dark']) .ng-claim-comparison {
    border-color: rgb(68 64 60);
    background: rgb(28 25 23);
  }

  :global(html.dark) .ng-claim-comparison__header,
  :global(html[data-theme='dark']) .ng-claim-comparison__header {
    border-color: rgb(68 64 60);
    background: linear-gradient(135deg, rgb(69 26 3), rgb(28 25 23));
  }

  :global(html.dark) .ng-claim-card,
  :global(html[data-theme='dark']) .ng-claim-card {
    background: rgb(28 25 23);
  }

  :global(html.dark) .ng-claim-comparison h2,
  :global(html.dark) .ng-claim-card h3,
  :global(html[data-theme='dark']) .ng-claim-comparison h2,
  :global(html[data-theme='dark']) .ng-claim-card h3 {
    color: rgb(250 250 249);
  }

  :global(html.dark) .ng-claim-comparison__header > p:last-child,
  :global(html.dark) .ng-claim-card__grid dd,
  :global(html[data-theme='dark']) .ng-claim-comparison__header > p:last-child,
  :global(html[data-theme='dark']) .ng-claim-card__grid dd {
    color: rgb(214 211 209);
  }

  :global(html.dark) .ng-claim-card__grid > div,
  :global(html[data-theme='dark']) .ng-claim-card__grid > div {
    border-color: rgb(68 64 60);
    background: rgb(41 37 36);
  }

  :global(html.dark) .ng-claim-card__position,
  :global(html[data-theme='dark']) .ng-claim-card__position {
    border-color: rgb(146 64 14) !important;
    background: rgb(69 26 3) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .ng-claim-comparison *,
    .ng-claim-comparison *::before,
    .ng-claim-comparison *::after {
      scroll-behavior: auto !important;
      transition-duration: .001ms !important;
      animation-duration: .001ms !important;
    }
  }
</style>
