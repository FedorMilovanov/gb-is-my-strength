---
import JsonLd from './JsonLd.astro';
import { SITE } from '@/data/site';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogImage?: string;
  ogImageType?: string;
  ogImageAlt?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article' | 'profile';
  profileFirstName?: string;
  profileLastName?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  jsonLd?: unknown;
}

function detectImageType(url: string) {
  const clean = String(url || '').split('?')[0].toLowerCase();
  if (clean.endsWith('.webp')) return 'image/webp';
  if (clean.endsWith('.png')) return 'image/png';
  if (clean.endsWith('.jpg') || clean.endsWith('.jpeg')) return 'image/jpeg';
  if (clean.endsWith('.svg')) return 'image/svg+xml';
  if (clean.endsWith('.gif')) return 'image/gif';
  return 'image/webp';
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  ogImage = `${SITE.url}/images/og-preview-1200x630.webp`,
  ogImageType,
  ogImageAlt,
  ogImageWidth = '1200',
  ogImageHeight = '630',
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  profileFirstName,
  profileLastName,
  jsonLd,
} = Astro.props;

const effectiveOgImageType = ogImageType || detectImageType(ogImage);
const effectiveOgImageAlt = ogImageAlt || ogTitle || title;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={ogTitle} />
<meta property="og:type" content={ogType} />
{ogType === 'profile' && profileFirstName && <meta property="profile:first_name" content={profileFirstName} />}
{ogType === 'profile' && profileLastName && <meta property="profile:last_name" content={profileLastName} />}
<meta property="og:site_name" content={SITE.name} />
{ogType === 'article' && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
{ogType === 'article' && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
{ogType === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="ru_RU" />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={ogImageWidth} />
<meta property="og:image:height" content={ogImageHeight} />
<meta property="og:image:type" content={effectiveOgImageType} />
<meta property="og:image:alt" content={effectiveOgImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@FedorMilovanov" />
<meta name="twitter:creator" content="@FedorMilovanov" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={effectiveOgImageAlt} />
<meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#fdfcf9" media="(prefers-color-scheme: light)" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} — RSS`} href={`${SITE.url}/feed.xml`} />
{jsonLd && <JsonLd data={jsonLd} />}
