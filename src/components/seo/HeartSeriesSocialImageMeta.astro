---
/**
 * Shared social preview image for the «Тайны человеческого сердца» book surface.
 *
 * The published series currently has one canonical wide visual source. Keeping
 * the metadata here prevents 22 Astro-only PageHead implementations from
 * drifting independently while preserving their route-specific title/copy.
 */
const image = 'https://gospod-bog.ru/images/og-chto-bibliya-nazyvaet-serdcem-600w.webp';
const alt = 'Серия «Тайны человеческого сердца» — библейский портрет внутреннего человека перед Богом';
---

<meta property="og:image" content={image} />
<meta property="og:image:width" content="600" />
<meta property="og:image:height" content="315" />
<meta property="og:image:type" content="image/webp" />
<meta property="og:image:alt" content={alt} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={alt} />
