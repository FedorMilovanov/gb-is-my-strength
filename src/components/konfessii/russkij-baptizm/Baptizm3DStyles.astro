<style is:inline>
:root{--gold:#e8c879;--gold-soft:rgba(232,200,121,.55);--bg:#08080e;--panel:#12121b;--txt:#e9e4d6;--muted:#8a857f;}
*{margin:0;padding:0;box-sizing:border-box}
html{height:100%;background:var(--bg)}
body{height:100%;min-width:0;min-height:0;background:var(--bg);color:var(--txt);font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;overflow:hidden;display:flex;flex-direction:column}
