.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);clip-path:inset(50%);white-space:nowrap;border:0}
.skip{position:absolute;left:-9999px;top:0;background:var(--gold);color:#1a1208;padding:10px 16px;border-radius:0 0 10px 0;z-index:50;font-weight:700}
.skip:focus{left:0}
.bar{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:calc(10px + env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) 10px max(16px,env(safe-area-inset-left,0px));background:rgba(8,8,14,.9);border-bottom:1px solid rgba(255,255,255,.06);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);z-index:10}
.back{min-width:0;color:var(--muted);text-decoration:none;font-size:13px;letter-spacing:.04em;display:flex;align-items:center;gap:7px;transition:color .2s;white-space:nowrap}
.back:hover{color:var(--gold)}
.back:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:6px}
.back svg{flex:0 0 auto;width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.crumb{font-size:10.5px;color:#5e5a54;letter-spacing:.13em;text-transform:uppercase;text-align:right}
