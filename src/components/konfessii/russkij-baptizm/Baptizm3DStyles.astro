.noscript-fallback{position:absolute;inset:0;display:block;overflow:auto;padding:clamp(24px,5vw,48px);color:var(--txt);background:var(--bg);font-size:14px;line-height:1.7;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
