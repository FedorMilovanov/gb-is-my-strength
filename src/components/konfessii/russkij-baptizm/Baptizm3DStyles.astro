<style is:inline>
:root{--gold:#e8c879;--gold-soft:rgba(232,200,121,.55);--bg:#08080e;--panel:#12121b;--txt:#e9e4d6;--muted:#8a857f;}
*{margin:0;padding:0;box-sizing:border-box}
html{height:100%;background:var(--bg)}
body{height:100%;min-width:0;min-height:0;background:var(--bg);color:var(--txt);font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;overflow:hidden;display:flex;flex-direction:column}
@supports (height:100dvh){html,body{height:100dvh}}
.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);clip-path:inset(50%);white-space:nowrap;border:0}
.skip{position:absolute;left:-9999px;top:0;background:var(--gold);color:#1a1208;padding:10px 16px;border-radius:0 0 10px 0;z-index:50;font-weight:700}
.skip:focus{left:0}
.bar{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:calc(10px + env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) 10px max(16px,env(safe-area-inset-left,0px));background:rgba(8,8,14,.9);border-bottom:1px solid rgba(255,255,255,.06);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);z-index:10}
.back{min-width:0;color:var(--muted);text-decoration:none;font-size:13px;letter-spacing:.04em;display:flex;align-items:center;gap:7px;transition:color .2s;white-space:nowrap}
.back:hover{color:var(--gold)}
.back:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:6px}
.back svg{flex:0 0 auto;width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.crumb{font-size:10.5px;color:#a8a29a;letter-spacing:.13em;text-transform:uppercase;text-align:right}
.crumb a{color:#c3bdb4;text-decoration:none;display:inline-flex;align-items:center;min-height:44px;padding:0 2px}.crumb a:hover{color:var(--gold)}
.stage{flex:1 1 0;position:relative;width:100%;min-width:0;min-height:0;overflow:hidden}
#appframe{position:absolute;inset:0;width:100%;height:100%;min-width:0;max-width:100%;border:0;display:block;background:var(--bg)}
#loader{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;background:var(--bg);z-index:5;transition:opacity .5s;pointer-events:none}
#loader.hidden{opacity:0}
.lring{width:64px;height:64px;border-radius:50%;border:2px solid rgba(232,200,121,.18);border-top-color:var(--gold);animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
#loader .lt{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-soft)}
.noscript-fallback{position:absolute;inset:0;display:block;overflow:auto;padding:clamp(24px,5vw,48px);color:var(--txt);background:var(--bg);font-size:14px;line-height:1.7;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
.nowebgl-fallback{position:absolute;inset:0;overflow:auto;padding:clamp(24px,5vw,48px);color:var(--txt);background:var(--bg);font-size:14px;line-height:1.7;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;z-index:6}
.nowebgl-fallback[hidden]{display:none}
html.nowebgl #appframe{display:none}
.nowebgl-notice{max-width:900px;margin:0 auto 24px;padding:16px 18px;background:var(--panel);border:1px solid rgba(232,200,121,.35);border-radius:10px}
.nowebgl-notice h2{font-size:clamp(1.1rem,3.5vw,1.4rem);color:var(--gold);margin-bottom:8px}
.nowebgl-notice p{color:#b8b1a3;line-height:1.7}
.nowebgl-notice a{color:var(--gold);text-underline-offset:3px}
.seo-fallback{max-width:900px;margin:0 auto 40px}
.seo-fallback h2{font-size:clamp(1.25rem,4vw,1.65rem);font-weight:700;color:var(--txt);margin-bottom:12px}
.seo-fallback p{color:#b8b1a3;line-height:1.75;margin-bottom:14px}
.seo-fallback__grid{display:grid;gap:12px;margin-bottom:20px}
.seo-fallback__card{padding:14px;background:var(--panel);border:1px solid rgba(232,200,121,.2);border-radius:10px;color:var(--txt)}
.seo-fallback__card strong{color:var(--gold)}
.seo-fallback .seo-fallback__source{color:var(--muted);font-size:.9rem;line-height:1.65}
.seo-fallback a{color:var(--gold);text-underline-offset:3px}
@media (prefers-reduced-motion:reduce){.lring{animation:none}}
@media(max-width:600px){.crumb{display:none}.bar .back:nth-of-type(2){display:none}.bar{justify-content:flex-start}.back{max-width:calc(100vw - 32px);overflow:hidden;text-overflow:ellipsis}.noscript-fallback{padding:24px 18px}}
.baptizm-print-projection{display:none}
@media print{
  /* Печать 3D-карты: контент живёт в <iframe>, а Chromium не пагинирует
     содержимое фреймов, поэтому без проекции на бумагу уходил только hero
     (1 стр./486 симв. вместо 17 разделов истории). Снимаем фиксированную
     высоту оболочки и печатаем текстовый фолбэк обычным потоком документа.
     Проекция раскрывается только у живой страницы (html.app-live): без JS
     тот же текст печатает noscript-фолбэк, дублирования нет. */
  html,body{height:auto!important;min-height:0!important;overflow:visible!important;display:block!important}
  .skip,.bar,#appframe,#loader{display:none!important}
  .stage{position:static!important;height:auto!important;min-height:0!important;overflow:visible!important;flex:none!important}
  .baptizm-print-projection,.noscript-fallback{position:static!important;inset:auto!important;overflow:visible!important;height:auto!important;padding:0!important;background:#fff!important;color:#111!important;font-size:11pt!important;line-height:1.55!important}
  /* Без WebGL печатаем nowebgl-проекцию и гасим app-live-проекцию, чтобы текст не задвоился */
  html.nowebgl .baptizm-print-projection{display:none!important}
  html.nowebgl .nowebgl-fallback{position:static!important;inset:auto!important;overflow:visible!important;height:auto!important;display:block!important;background:#fff!important;color:#111!important;z-index:auto!important}
  html.nowebgl .nowebgl-fallback .nowebgl-notice{background:#fff!important;border-color:#7a7a7a!important}
  html.nowebgl .nowebgl-fallback h2{color:#111!important}
  html.nowebgl .nowebgl-fallback p,html.nowebgl .nowebgl-fallback strong{color:#111!important}
  html.nowebgl .nowebgl-fallback a{color:#111!important;text-decoration:underline}
  html.app-live .baptizm-print-projection{display:block!important}
  .baptizm-print-projection .seo-fallback,.noscript-fallback .seo-fallback{max-width:none;margin:0}
  .baptizm-print-projection h2,.noscript-fallback h2{font-size:15pt!important;color:#111!important}
  .baptizm-print-projection p,.noscript-fallback p,
  .baptizm-print-projection strong,.noscript-fallback strong{color:#111!important}
  .baptizm-print-projection .seo-fallback__card,.noscript-fallback .seo-fallback__card{background:#fff!important;border:1px solid #7a7a7a!important;color:#111!important;break-inside:avoid-page}
  .baptizm-print-projection .seo-fallback__source,.noscript-fallback .seo-fallback__source{color:#333!important}
  .baptizm-print-projection a,.noscript-fallback a{color:#111!important;text-decoration:underline}
}
</style>
