<style is:inline>
:root{--gold:#e8c879;--gold-soft:rgba(232,200,121,.55);--bg:#08080e;--txt:#e9e4d6;--muted:#8a857f;}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{background:var(--bg);color:var(--txt);font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;overflow:hidden;display:flex;flex-direction:column}
.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.skip{position:absolute;left:-9999px;top:0;background:var(--gold);color:#1a1208;padding:10px 16px;border-radius:0 0 10px 0;z-index:50;font-weight:700}
.skip:focus{left:0}
.bar{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;background:rgba(8,8,14,.9);border-bottom:1px solid rgba(255,255,255,.06);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);z-index:10}
.back{color:var(--muted);text-decoration:none;font-size:13px;letter-spacing:.04em;display:flex;align-items:center;gap:7px;transition:color .2s;white-space:nowrap}
.back:hover{color:var(--gold)}
.back:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:6px}
.back svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.crumb{font-size:10.5px;color:#5e5a54;letter-spacing:.13em;text-transform:uppercase;text-align:right}
.crumb a{color:#7a756e;text-decoration:none;display:inline-flex;align-items:center;min-height:44px;padding:0 2px}.crumb a:hover{color:var(--gold)}
.stage{flex:1 1 auto;position:relative;min-height:0}
#appframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block;background:#08080e}
#loader{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;background:#08080e;z-index:5;transition:opacity .5s;pointer-events:none}
#loader.hidden{opacity:0}
.lring{width:64px;height:64px;border-radius:50%;border:2px solid rgba(232,200,121,.18);border-top-color:var(--gold);animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
#loader .lt{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-soft)}
.noscript-fallback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:32px;text-align:center;color:var(--muted);font-size:14px;line-height:1.7}
@media (prefers-reduced-motion:reduce){.lring{animation:none}}
@media(max-width:600px){.crumb{display:none}.bar .back:nth-of-type(2){display:none}.bar{justify-content:flex-start}.back{max-width:calc(100vw - 32px);overflow:hidden;text-overflow:ellipsis}}
</style>
