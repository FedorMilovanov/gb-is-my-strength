---

<a class="skip" href="#appframe">Перейти к интерактивной карте</a>

<header class="bar">
  <a class="back" href="/konfessii/"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Конфессии и Деноминации</a>
  <a class="back" href="/baptisty-rossii/">Серия «Баптисты России»</a>
  <div class="crumb"><a href="/">Главная</a> · <a href="/konfessii/">Конфессии</a> · <a href="/baptisty-rossii/">Серия</a> · Карта Русского Баптизма</div>
  <AppSearchSurface mode="baptizm" />
</header>
<main id="main-content" class="stage">
  <h1 class="sr-only">Карта Русского Баптизма — интерактивная 3D-история движения от истоков к современности</h1>
  <div id="loader"><div class="lring" aria-hidden="true"></div><div class="lt">Загрузка интерактивной 3D-карты…</div></div>
  <iframe id="appframe" src="./_app/index.html" title="Интерактивная 3D-карта истории русского баптизма: узлы-планеты с орбитами над картой Российской империи, режимы «граф» и «карта», маршруты, инспектор узлов" allow="fullscreen" loading="eager" referrerpolicy="no-referrer"></iframe>
  <div id="nowebgl-fallback" class="nowebgl-fallback" hidden data-pagefind-ignore>
    <div class="nowebgl-notice">
      <h2>WebGL недоступен — показана текстовая версия карты</h2>
      <p>Интерактивная 3D-карта требует WebGL; этот браузер его не поддерживает (или аппаратное ускорение отключено). Ниже — полная текстовая проекция экспозиции. Можно также <a href="./_app/index.html" rel="noopener">попробовать открыть 3D-версию в новой вкладке</a>.</p>
    </div>
    <Baptizm3DStaticProjection />
  </div>
  <div class="baptizm-print-projection" data-print-static-projection data-pagefind-ignore aria-hidden="true">
    <Baptizm3DStaticProjection />
  </div>
  <noscript>
    <div class="noscript-fallback" data-pagefind-body>
      <Baptizm3DStaticProjection />
    </div>
  </noscript>
</main>
<script is:inline>
(function(){
  var f=document.getElementById('appframe'),l=document.getElementById('loader');
  /* Печатная проекция существует только у живой страницы: без JS контент
     печатает noscript-фолбэк, и один и тот же текст не должен попасть в PDF дважды. */
  document.documentElement.classList.add('app-live');
  function hide(){if(l){l.classList.add('hidden');setTimeout(function(){l.style.display='none';},600);}}

  /* GBS-3D-NO-WEBGL-FALLBACK: без WebGL бандл Three.js внутри iframe падал
     неперехваченным «Error creating WebGL context» на пустом экране.
     Проверяем поддержку ДО загрузки приложения: без неё iframe уходит на
     about:blank (бандл не исполняется, ошибки нет), а читатель получает
     видимую текстовую проекцию с честным объяснением и ссылкой на 3D. */
  function hasWebGL(){
    try{
      var c=document.createElement('canvas');
      return !!(window.WebGLRenderingContext&&(c.getContext('webgl2')||c.getContext('webgl')||c.getContext('experimental-webgl')));
    }catch(e){return false;}
  }
  if(!hasWebGL()){
    document.documentElement.classList.add('nowebgl');
    if(f){f.src='about:blank';}
    var nw=document.getElementById('nowebgl-fallback');
    if(nw){nw.hidden=false;}
    hide();
    return;
  }

  if(f){f.addEventListener('load',hide);}
  setTimeout(hide,6000);
})();

/* FIX: wheel/zoom глитч в Three.js OrbitControls внутри iframe.
   Проблема: браузер регистрирует wheel на документе как passive, не давая
   OrbitControls вызвать preventDefault(). Решение: форвардим wheel events
   в iframe с non-passive listener, предотвращая scroll страницы. */
(function(){
  var stage = document.querySelector('.stage');
  if(!stage) return;
  
  // Блокируем scroll страницы пока курсор над 3D-сценой
  var isOver = false;
  stage.addEventListener('mouseenter', function(){ isOver = true; }, {passive:true});
  stage.addEventListener('mouseleave', function(){ isOver = false; }, {passive:true});
  stage.addEventListener('touchstart', function(){ isOver = true; }, {passive:true});
  stage.addEventListener('touchend', function(){ isOver = false; }, {passive:true});
  
  // Non-passive wheel handler — позволяет preventDefault()
  // Three.js OrbitControls сам обрабатывает зум внутри iframe
  // Нам нужно только предотвратить скролл страницы
  document.addEventListener('wheel', function(e){
    if(isOver && e.target && e.target.closest && e.target.closest('.stage')){
      e.preventDefault();
    }
  }, {passive: false});
  
  // Touch-pinch passthrough: предотвращаем bounce/zoom страницы
  stage.addEventListener('touchmove', function(e){
    if(e.touches.length >= 2){
      e.preventDefault(); // Предотвращаем page zoom, Three.js обрабатывает pinch
    }
  }, {passive: false});
  
})();
</script>
