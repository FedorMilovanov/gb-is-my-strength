<style is:inline>
:root{
  --gold:#e8c879;--gold-soft:rgba(232,200,121,.72);--gold-dim:rgba(232,200,121,.22);
  --bg:#070a10;--panel:rgba(13,17,26,.86);--line:rgba(232,200,121,.28);
  --txt:#e9e4d6;--muted:#9aa2ae;
  --serif:Georgia,"Times New Roman",serif;
  --sans:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{min-height:100%}
body{background:var(--bg);color:var(--txt);font-family:var(--sans);display:flex;flex-direction:column;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
   radial-gradient(ellipse 80% 55% at 50% -10%,rgba(232,200,121,.07),transparent 60%),
   radial-gradient(ellipse at center,transparent 55%,rgba(3,5,9,.55) 100%);}
.wrap{position:relative;z-index:1;width:min(1080px,92vw);margin:0 auto;flex:1;display:flex;flex-direction:column}
main.konfessii-main{display:flex;flex-direction:column}
header.k{padding:26px 0 0;display:flex;align-items:center;justify-content:space-between;gap:14px}
.back{color:var(--muted);text-decoration:none;font-size:13px;letter-spacing:.06em;display:flex;align-items:center;gap:7px;transition:color .2s}
.back:hover{color:var(--gold)}
.back svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.crumb{font-size:11px;color:#98a1ad;letter-spacing:.14em}
.hero{text-align:left;padding:42px 0 24px}
.hero .he{font-size:12px;color:var(--gold);letter-spacing:.18em;margin-bottom:12px;text-transform:uppercase}
.hero h1{font-family:var(--serif);font-weight:600;font-size:clamp(32px,5.2vw,50px);letter-spacing:.02em;color:#f6f0df}
.hero h1 b{color:var(--gold);font-weight:600}
.hero p{margin:14px 0 0;max-width:60ch;color:var(--muted);font-size:16px;line-height:1.65}
.rule{width:90px;height:1px;margin:22px 0 0;background:var(--gold-dim)}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;padding:10px 0 24px}
.card{
  position:relative;display:flex;flex-direction:column;border:1px solid var(--line);
  border-radius:18px;overflow:hidden;text-decoration:none;color:var(--txt);
  background:linear-gradient(160deg,rgba(20,24,33,.9),rgba(10,13,20,.95));
  transition:transform .62s cubic-bezier(.22,1,.36,1), box-shadow .62s cubic-bezier(.22,1,.36,1), border-color .28s;
  min-height:286px;
  will-change:transform;
  transform-style:preserve-3d;
  perspective:1000px;
  box-shadow:0 12px 38px rgba(0,0,0,.42), inset 0 0 0 1px rgba(232,200,121,.035);
  cursor:pointer;
}
a.card:hover{border-color:var(--gold);box-shadow:0 38px 95px rgba(0,0,0,.72),0 0 0 1px var(--gold),0 0 18px rgba(232,200,121,.18);animation:goldShimmer 2.6s cubic-bezier(.22,1,.36,1) infinite}
.card .art{height:152px;position:relative;overflow:hidden;background:#0a0e15}
.card .art svg{width:100%;height:100%;display:block;transition:transform .82s cubic-bezier(.22,1,.36,1)}
a.card:hover .art svg{transform:scale(1.068) translateZ(15px) rotate(0.65deg)}
.card .body{padding:18px 20px 20px;flex:1;display:flex;flex-direction:column}
.card .kick{font-size:12px;letter-spacing:.12em;color:var(--gold-soft);text-transform:uppercase}
.card h2{font-family:var(--serif);font-weight:600;font-size:clamp(22px,2.7vw,32px);line-height:1.2;color:#f4eedd;margin:8px 0 8px}
.card .sub{font-size:15px;line-height:1.5;color:var(--gold-soft);margin-bottom:10px}
.card p{font-size:15px;line-height:1.65;color:var(--muted);flex:1;overflow-wrap:anywhere}
.card .cta{margin-top:18px;font-size:13px;letter-spacing:.11em;color:var(--gold);display:flex;align-items:center;gap:8px;font-weight:600;position:relative;min-height:44px}
.card .cta::after{content:"→";transition:transform .3s cubic-bezier(.22,1,.36,1);display:inline-block}
a.card:hover .cta::after{transform:translateX(9px)}
.card .cta::before{content:"";position:absolute;left:-2px;right:-2px;top:50%;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:opacity .28s cubic-bezier(.22,1,.36,1);transform:translateY(-50%)}
a.card:hover .cta::before{opacity:.42}
.card.soon{min-height:0;cursor:default;opacity:1;box-shadow:none;will-change:auto;transform-style:flat;border-radius:8px;background:var(--panel)}
.card.soon .badge{align-self:flex-start;margin:18px 20px 0;font-size:11px;letter-spacing:.09em;color:var(--gold-soft)}
.card .live{position:absolute;top:14px;right:14px;z-index:2;background:rgba(33,28,16,.92);border:1px solid var(--gold);border-radius:999px;font-size:9.5px;letter-spacing:.2em;color:var(--gold);padding:6px 12px;display:flex;align-items:center;gap:6px}
.card .live i{width:6px;height:6px;border-radius:50%;background:var(--gold);animation:liv 2s ease-out infinite}
@keyframes liv{0%{box-shadow:0 0 0 0 rgba(232,200,121,.5)}70%{box-shadow:0 0 0 7px transparent}100%{box-shadow:0 0 0 0 transparent}}
@keyframes goldShimmer{0%{box-shadow:0 38px 95px rgba(0,0,0,.72),0 0 0 1px var(--gold),0 0 18px rgba(232,200,121,.18),inset 0 0 0 1px rgba(232,200,121,.035)}50%{box-shadow:0 38px 95px rgba(0,0,0,.72),0 0 0 1px var(--gold-soft),0 0 28px rgba(232,200,121,.3),inset 0 0 0 1px rgba(232,200,121,.06)}100%{box-shadow:0 38px 95px rgba(0,0,0,.72),0 0 0 1px var(--gold),0 0 18px rgba(232,200,121,.18),inset 0 0 0 1px rgba(232,200,121,.035)}}
.card.live{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,4fr) minmax(0,6fr);animation:liveShimmer 4.2s cubic-bezier(.22,1,.36,1) infinite}
.card.live .art{height:100%;min-height:260px;display:flex;align-items:center}
.card.live .body{padding:28px;min-width:0}
.card.live .stats{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.card.live .stats span{font-size:12px;line-height:1.5;color:var(--gold-soft);border:1px solid var(--line);border-radius:4px;padding:5px 8px}
.card.live:focus-visible,.back:focus-visible{outline:2px solid var(--gold);outline-offset:5px}
.planned-heading{grid-column:1/-1;font:600 23px/1.3 var(--serif);color:var(--txt);margin:16px 0 0;padding-top:18px;border-top:1px solid var(--line)}
.card.soon .body{padding-top:10px}
.card.soon h2{font-size:22px}
.method{border-top:1px solid var(--line);margin-top:26px;padding-top:22px}
.method h2{font:600 24px/1.3 var(--serif);color:var(--txt);margin:0 0 14px}
@media(max-width:700px){.card.live .body{padding:20px 16px}.card.live .art{height:140px;min-height:0}}
@keyframes liveShimmer{0%,100%{box-shadow:0 12px 38px rgba(0,0,0,.42),inset 0 0 0 1px rgba(232,200,121,.035),0 0 0 1px var(--gold)}50%{box-shadow:0 12px 38px rgba(0,0,0,.42),inset 0 0 0 1px rgba(232,200,121,.06),0 0 14px rgba(232,200,121,.28)}}
.intro{max-width:76ch;margin:0;padding:0 0 14px;color:var(--muted);font-size:15px;line-height:1.8;text-align:left}
.intro b{color:var(--txt);font-weight:600}
footer.k{padding:30px 0 30px;text-align:center;font-size:11px;color:#98a1ad;letter-spacing:.08em}
footer.k a{color:var(--muted);text-decoration:underline;text-underline-offset:2px}
footer.k a:hover{color:var(--gold)}
@media(max-width:700px){.hero{padding:28px 0 18px}.grid{grid-template-columns:minmax(0,1fr);gap:12px}.grid .card.live{display:flex;flex-direction:column}.card .body{padding:18px 16px}.card.soon .badge{margin-left:16px}.crumb{font-size:10px;letter-spacing:.07em}header.k{padding-top:18px;gap:10px}.back{flex-shrink:0}}
@media(prefers-reduced-motion:reduce){
  .card,.card:hover,.card .art svg,.card:hover .art svg,.card .cta::before,.card .cta::after,.back{transition:none!important}
  .card,.card:hover,.card.live,.card .live i{animation:none!important}
  .card:hover,.card:hover .art svg{transform:none!important}
}
</style>
