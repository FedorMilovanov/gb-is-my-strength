<style is:inline>
:root{
  --gold:#e8c879;--gold-soft:rgba(232,200,121,.55);--gold-dim:rgba(232,200,121,.22);
  --bg:#070a10;--panel:rgba(13,17,26,.86);--line:rgba(232,200,121,.28);
  --txt:#e9e4d6;--muted:#9aa2ae;
  --serif:Georgia,"Times New Roman",serif;
  --sans:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{min-height:100%}
body{background:var(--bg);color:var(--txt);font-family:var(--sans);display:flex;flex-direction:column;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
   radial-gradient(ellipse 80% 55% at 50% -10%,rgba(232,200,121,.07),transparent 60%),
   radial-gradient(ellipse at center,transparent 55%,rgba(3,5,9,.55) 100%);}
.wrap{position:relative;z-index:1;width:min(1080px,92vw);margin:0 auto;flex:1;display:flex;flex-direction:column}
header.k{padding:26px 0 0;display:flex;align-items:center;justify-content:space-between;gap:14px}
.back{color:var(--muted);text-decoration:none;font-size:13px;letter-spacing:.06em;display:flex;align-items:center;gap:7px;transition:color .2s}
.back:hover{color:var(--gold)}
.back svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.crumb{font-size:11px;color:#6c737e;letter-spacing:.14em}
.hero{text-align:center;padding:64px 0 44px}
.hero .he{font-size:13px;color:var(--gold-soft);letter-spacing:.3em;margin-bottom:14px;text-transform:uppercase}
.hero h1{font-family:var(--serif);font-weight:600;font-size:clamp(32px,5.2vw,50px);letter-spacing:.02em;color:#f6f0df}
.hero h1 b{color:var(--gold);font-weight:600}
.hero p{margin:16px auto 0;max-width:600px;color:var(--muted);font-size:14.5px;line-height:1.7}
.rule{width:90px;height:1px;margin:30px auto 0;background:linear-gradient(90deg,transparent,var(--gold),transparent)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;padding:36px 0 36px}
.card{
  position:relative;display:flex;flex-direction:column;border:1px solid var(--line);
  border-radius:18px;overflow:hidden;text-decoration:none;color:var(--txt);
  background:linear-gradient(160deg,rgba(20,24,33,.9),rgba(10,13,20,.95));
  transition:transform .62s cubic-bezier(.22,1,.36,1), box-shadow .62s cubic-bezier(.22,1,.36,1), border-color .28s;
  min-height:286px;
  will-change:transform;
  transform-style:preserve-3d;
  perspective:1000px;
  box-shadow:0 12px 38px rgba(0,0,0,.42), inset 0 0 0 1px rgba(232,200,121,.035);
  cursor:pointer;
}
.card:hover{border-color:var(--gold);box-shadow:0 38px 95px rgba(0,0,0,.72),0 0 0 1px var(--gold),0 0 18px rgba(232,200,121,.18);animation:goldShimmer 2.6s cubic-bezier(.22,1,.36,1) infinite}
.card .art{height:152px;position:relative;overflow:hidden;background:#0a0e15}
.card .art svg{width:100%;height:100%;display:block;transition:transform .82s cubic-bezier(.22,1,.36,1)}
.card:hover .art svg{transform:scale(1.068) translateZ(15px) rotate(0.65deg)}
.card .body{padding:18px 20px 20px;flex:1;display:flex;flex-direction:column}
.card .kick{font-size:10px;letter-spacing:.26em;color:var(--gold-soft);text-transform:uppercase}
.card h2{font-family:var(--serif);font-weight:600;font-size:21px;color:#f4eedd;margin:7px 0 4px}
.card .sub{font-size:12.5px;color:var(--gold-soft);margin-bottom:8px}
.card p{font-size:12.5px;line-height:1.6;color:var(--muted);flex:1}
.card .cta{margin-top:14px;font-size:11px;letter-spacing:.2em;color:var(--gold);display:flex;align-items:center;gap:8px;font-weight:600;position:relative}
.card .cta::after{content:"→";transition:transform .3s cubic-bezier(.22,1,.36,1);display:inline-block}
.card:hover .cta::after{transform:translateX(9px)}
.card .cta::before{content:"";position:absolute;left:-2px;right:-2px;top:50%;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:opacity .28s cubic-bezier(.22,1,.36,1);transform:translateY(-50%)}
.card:hover .cta::before{opacity:.42}
.card.soon{pointer-events:none;opacity:.55}
.card.soon .badge{position:absolute;top:14px;right:14px;z-index:2;background:rgba(13,17,26,.9);border:1px solid rgba(255,255,255,.18);border-radius:999px;font-size:9.5px;letter-spacing:.2em;color:var(--muted);padding:6px 12px}
.card .live{position:absolute;top:14px;right:14px;z-index:2;background:rgba(33,28,16,.92);border:1px solid var(--gold);border-radius:999px;font-size:9.5px;letter-spacing:.2em;color:var(--gold);padding:6px 12px;display:flex;align-items:center;gap:6px}
.card .live i{width:6px;height:6px;border-radius:50%;background:var(--gold);animation:liv 2s ease-out infinite}
@keyframes liv{0%{box-shadow:0 0 0 0 rgba(232,200,121,.5)}70%{box-shadow:0 0 0 7px transparent}100%{box-shadow:0 0 0 0 transparent}}
@keyframes goldShimmer{0%{box-shadow:0 38px 95px rgba(0,0,0,.72),0 0 0 1px var(--gold),0 0 18px rgba(232,200,121,.18),inset 0 0 0 1px rgba(232,200,121,.035)}50%{box-shadow:0 38px 95px rgba(0,0,0,.72),0 0 0 1px var(--gold-soft),0 0 28px rgba(232,200,121,.3),inset 0 0 0 1px rgba(232,200,121,.06)}100%{box-shadow:0 38px 95px rgba(0,0,0,.72),0 0 0 1px var(--gold),0 0 18px rgba(232,200,121,.18),inset 0 0 0 1px rgba(232,200,121,.035)}}
.card.live{animation:liveShimmer 4.2s cubic-bezier(.22,1,.36,1) infinite}
@keyframes liveShimmer{0%,100%{box-shadow:0 12px 38px rgba(0,0,0,.42),inset 0 0 0 1px rgba(232,200,121,.035),0 0 0 1px var(--gold)}50%{box-shadow:0 12px 38px rgba(0,0,0,.42),inset 0 0 0 1px rgba(232,200,121,.06),0 0 14px rgba(232,200,121,.28)}}
.intro{max-width:760px;margin:0 auto;padding:6px 0 18px;color:var(--muted);font-size:14px;line-height:1.85;text-align:center}
.intro b{color:var(--txt);font-weight:600}
footer.k{padding:30px 0 30px;text-align:center;font-size:11px;color:#5e6570;letter-spacing:.08em}
footer.k a{color:var(--muted);text-decoration:none}
footer.k a:hover{color:var(--gold)}
@media(max-width:560px){.hero{padding:44px 0 30px}.grid{grid-template-columns:1fr}}
</style>
