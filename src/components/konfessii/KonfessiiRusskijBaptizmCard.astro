---
/**
 * KonfessiiRusskijBaptizmCard.astro — live premium card for /konfessii/.
 *
 * Refactoring 6.0 parallel pilot: hand-authored Astro replacement for the
 * first visible card inside the legacy main grid. Preserve classes, copy,
 * URLs, SVG structure and inline styles exactly.
 */
---
<a class="card live" href="/konfessii/russkij-baptizm/" aria-label="Открыть 3D-карту Русского Баптизма">
  <span class="live"><i></i>ДОСТУПНА</span>
  <div class="art" aria-hidden="true">
    <svg viewBox="0 0 360 152" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="bGlow" cx="50%" cy="42%" r="62%">
          <stop offset="0" stop-color="#1a1b14"></stop><stop offset="1" stop-color="#0a0d14"></stop>
        </radialGradient>
        <linearGradient id="bThread" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#caa84f"></stop><stop offset="1" stop-color="#f0d896"></stop>
        </linearGradient>
      </defs>
      <rect width="360" height="152" fill="url(#bGlow)"></rect>
      <g stroke="url(#bThread)" stroke-width="1.1" fill="none" opacity=".7">
        <path d="M180,80 C140,60 96,52 70,44"></path>
        <path d="M180,80 C150,108 120,120 92,118"></path>
        <path d="M180,80 C230,64 270,50 296,40"></path>
        <path d="M180,80 C236,104 276,116 300,116"></path>
        <path d="M180,80 L180,28"></path>
        <path d="M180,80 L180,132"></path>
        <path d="M70,44 C108,40 150,40 180,28"></path>
        <path d="M296,40 C260,38 216,36 180,28"></path>
      </g>
      <circle cx="70" cy="44" r="5.5" fill="#0d1117" stroke="#f0d896" stroke-width="1.8"></circle>
      <circle cx="70" cy="44" r="11" fill="none" stroke="#e8c879" stroke-opacity=".35"></circle>
      <circle cx="296" cy="40" r="5.5" fill="#0d1117" stroke="#f0d896" stroke-width="1.8"></circle>
      <circle cx="296" cy="40" r="11" fill="none" stroke="#e8c879" stroke-opacity=".35"></circle>
      <circle cx="180" cy="28" r="5.5" fill="#0d1117" stroke="#f0d896" stroke-width="1.8"></circle>
      <circle cx="180" cy="28" r="11" fill="none" stroke="#e8c879" stroke-opacity=".35"></circle>
      <circle cx="180" cy="80" r="7" fill="#1a130a" stroke="#f0d896" stroke-width="2"></circle>
      <circle cx="92" cy="118" r="4" fill="#0d1117" stroke="#e8c879" stroke-width="1.5"></circle>
      <circle cx="300" cy="116" r="4" fill="#0d1117" stroke="#e8c879" stroke-width="1.5"></circle>
      <circle cx="180" cy="132" r="4" fill="#0d1117" stroke="#e8c879" stroke-width="1.5"></circle>
    </svg>
  </div>
  <div class="body">
    <div class="kick">Россия · 1867 — наши дни</div>
    <h2>Карта Русского Баптизма</h2>
    <div class="sub">От истоков к современности — настоящая интерактивная 3D-история</div>
    <p>Полная история евангельско-баптистского движения: три независимых истока (Тифлис 1867, Южная Украина 1864/69, Петербург 1874), 23 узла, 27 связей, 5 маршрутов, хронология от Амстердама 1609 до наших дней, съезды, гонения, ключевые фигуры, глоссарий и викторина.</p>
    <div class="stats" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:11px">
      <span style="font-size:9.5px;letter-spacing:.09em;color:var(--gold-soft);border:1px solid rgba(232,200,121,.24);border-radius:999px;padding:2px 9px;white-space:nowrap;font-weight:500">23 узла</span>
      <span style="font-size:9.5px;letter-spacing:.09em;color:var(--gold-soft);border:1px solid rgba(232,200,121,.24);border-radius:999px;padding:2px 9px;white-space:nowrap;font-weight:500">27 связей</span>
      <span style="font-size:9.5px;letter-spacing:.09em;color:var(--gold-soft);border:1px solid rgba(232,200,121,.24);border-radius:999px;padding:2px 9px;white-space:nowrap;font-weight:500">Настоящая 3D-сцена</span>
    </div>
    <div class="cta">ОТКРЫТЬ 3D-КАРТУ</div>
  </div>
</a>
