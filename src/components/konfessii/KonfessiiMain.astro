---
/**
 * KonfessiiMain.astro — <div class="grid h-reveal"> of /konfessii/.
 *
 * Единственный <main id="main-content"> страницы принадлежит KonfessiiPageChrome:
 * он владеет hero/intro/сеткой/SDG-блоком. Здесь остаётся сам grid.
 *
 * Refactoring 6.0 parallel pilot: the route no longer proxies one monolithic
 * legacy main block. Instead, the standalone grid is composed from
 * named Astro leaf components while preserving legacy DOM/classes/text.
 *
 * Pixel-parity contract remains guarded via
 *   npm run visual:parity:screenshots -- --routes /konfessii/
 * and source-contract audit in scripts/konfessii-visual-parity-audit.js.
 */
import KonfessiiRusskijBaptizmCard from './KonfessiiRusskijBaptizmCard.astro';
import KonfessiiPentecostalCard from './KonfessiiPentecostalCard.astro';
import KonfessiiOverviewCard from './KonfessiiOverviewCard.astro';
---
<nav aria-label="Библейские инструменты">
  <a class="back" href="/app/">🚀 Приложение</a>
</nav>
<div class="grid h-reveal">
  <KonfessiiRusskijBaptizmCard />
  <KonfessiiPentecostalCard />
  <KonfessiiOverviewCard />
</div>
