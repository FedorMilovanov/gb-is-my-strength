---
/**
 * Explicit native owner for reader-level actions that were historically
 * bundled into site.js. Astro/Vite owns hashing, module delivery and cache
 * invalidation; the legacy root asset registry is intentionally not involved.
 *
 * ReaderProjection is the semantic owner for the article representations used
 * by TTS, speakable metadata, search boundaries, print order and current-section
 * labels. It loads before every reader consumer, marks explicit policy on the
 * rendered subtree and never owns speech engines, controls or visual state.
 *
 * ScriptureDataProjection exposes only the current route's centrally governed
 * Scripture records to the existing article tooltip runtime. It does not own
 * tooltip interaction/geometry and does not read retained route-local payloads.
 *
 * Print pagination has two owners with a strict lifecycle boundary:
 * semantic classification is prepared by GBPrintPagination v1; physical A4
 * geometry runs only after the document enters print media / beforeprint.
 *
 * Reader TTS is also claimed here after the legacy floating controller loads.
 * Its capture-phase owner prevents double handling while keeping the existing
 * non-TTS cluster actions intact. The narrow click guard is evaluated first so
 * a browser-generated click after a confirmed long-press stop cannot re-enter
 * the canonical TTS owner. Media Session is composed as a separate lifecycle
 * owner so lock-screen controls and background playback remain testable without
 * coupling them to either speech engine. Heavy Vosk work is owned by the
 * same-origin persistent worker loaded by vosk-tts-engine.js.
 *
 * Reader control accessibility is a separate additive owner: it does not open
 * or close visual surfaces and never owns speech. It synchronizes truthful
 * exposure, roving keyboard state, focus return and popup semantics across the
 * existing Hermenevtika and Gill mobile controls.
 */
import ScriptureDataProjection from './ScriptureDataProjection.astro';
import { assetUrl } from '../../lib/asset-version';
import '../../runtime/article-interactions.css';
import '../../runtime/reader-tts.css';

const voskEngineSrc = assetUrl('js/vosk-tts-engine.js');
---
<ScriptureDataProjection />
<script is:inline defer src={voskEngineSrc}></script>
<script>
  import '../../runtime/favorite-store.js';
  import '../../runtime/reader-projection.js';
  import '../../runtime/print-pagination-geometry.js';
  import '../../runtime/reader-actions.js';
  import '../../runtime/reader-controls-a11y.js';
  import '../../runtime/reader-tts-defaults.js';
  import '../../runtime/reader-tts-click-guard.js';
  import '../../runtime/reader-tts.js';
  import '../../runtime/reader-tts-media-session.js';
  import '../../runtime/article-interactions.js';
</script>
