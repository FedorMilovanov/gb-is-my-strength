---
/**
 * Explicit native owner for reader-level actions that were historically
 * bundled into site.js. Astro/Vite owns hashing, module delivery and cache
 * invalidation; the legacy root asset registry is intentionally not involved.
 *
 * Print pagination has two owners with a strict lifecycle boundary:
 * semantic classification is prepared by GBPrintPagination v1; physical A4
 * geometry runs only after the document enters print media / beforeprint.
 *
 * Reader TTS is also claimed here after the legacy floating controller loads.
 * Its capture-phase owner prevents double handling while keeping the existing
 * non-TTS cluster actions intact. Media Session is composed as a separate
 * lifecycle owner so lock-screen controls and background playback remain
 * testable without coupling them to either speech engine. Heavy Vosk work is
 * owned by the same-origin persistent worker loaded by vosk-tts-engine.js.
 */
import { assetUrl } from '../../lib/asset-version';
import '../../runtime/article-interactions.css';
import '../../runtime/reader-tts.css';

const voskEngineSrc = assetUrl('js/vosk-tts-engine.js');
---
<script is:inline defer src={voskEngineSrc}></script>
<script>
  import '../../runtime/print-pagination-geometry.js';
  import '../../runtime/reader-actions.js';
  import '../../runtime/reader-tts-defaults.js';
  import '../../runtime/reader-tts.js';
  import '../../runtime/reader-tts-media-session.js';
  import '../../runtime/article-interactions.js';
</script>
