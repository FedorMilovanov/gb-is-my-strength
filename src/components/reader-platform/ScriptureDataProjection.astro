---
import scriptureIndex from '../../../data/scripture-search-index.json';
import publicSynodal from '../../../data/bible/public-domain-russyn.json';
import bibleRegistry from '../../../data/bible/books.json';
import { isBibleRecordPublicationEligible } from '../../lib/bible-reference-core.mjs';
import { createPublicSynodalResolver } from '../../lib/public-synodal-reference.mjs';

type ScriptureOccurrence = {
  url?: string | null;
  raw?: string | null;
};

type CanonicalSource = {
  translation?: string | null;
  source?: string | null;
  sourceUrl?: string | null;
  rights?: string | null;
  rightsState?: string | null;
  publicationState?: string | null;
  holds?: string[] | null;
};

type ScriptureReference = {
  label?: string | null;
  canonicalText?: string | null;
  canonicalSource?: CanonicalSource | null;
  occurrences?: ScriptureOccurrence[];
};

const normalizeRoute = (value: string) => {
  let route = String(value || '/').split('#', 1)[0] || '/';
  if (!route.startsWith('/')) route = `/${route}`;
  if (!route.includes('.') && !route.endsWith('/')) route += '/';
  return route;
};

const route = normalizeRoute(Astro.url.pathname);
const scriptureData: Record<string, string> = {};
const scriptureSources: Record<string, string> = {};
const publicResolver = createPublicSynodalResolver(bibleRegistry, publicSynodal);
const publicLabel = 'Синодальный перевод (1876) · eBible.org';

for (const reference of (scriptureIndex.references || []) as ScriptureReference[]) {
  const routeOccurrences = (reference.occurrences || []).filter(
    (occurrence) => normalizeRoute(String(occurrence.url || '')) === route,
  );
  if (routeOccurrences.length === 0) continue;
  // The earlier Kassian/mixed-rights corpus is never promoted by implication.
  // RUSSYN is a distinct, verified public-domain edition bundled in this repo.
  const approved = isBibleRecordPublicationEligible(reference.canonicalSource || {})
    ? String(reference.canonicalText || '').trim() : '';
  const referenceText = publicResolver.resolve(String(reference.label || ''))?.text || approved;
  const provenance = referenceText === approved && approved
    ? String(reference.canonicalSource?.translation || 'Проверенный перевод')
    : publicLabel;
  for (const occurrence of routeOccurrences) {
    const raw = String(occurrence.raw || '').trim();
    if (!raw) continue;
    const text = referenceText || publicResolver.resolve(raw)?.text || '';
    if (!text) continue;
    scriptureData[raw] = text;
    scriptureSources[raw] = provenance;
  }
  const label = String(reference.label || '').trim();
  if (label && referenceText) {
    scriptureData[label] = referenceText;
    scriptureSources[label] = provenance;
  }
}
---

<script is:inline define:vars={{ scriptureData, scriptureSources }}>
  (() => {
    // This component is the canonical reader-facing Scripture data projection.
    // Never merge an earlier global payload back across the rights boundary:
    // ungoverned/held text must be replaced by the current eligible projection.
    window.SCRIPTURE_DATA = Object.freeze({ ...scriptureData });
    window.SCRIPTURE_SOURCE_BY_REF = Object.freeze({ ...scriptureSources });
  })();
</script>
