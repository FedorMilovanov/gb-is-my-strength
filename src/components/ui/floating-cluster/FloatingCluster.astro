---
import SingleArticleCluster from './SingleArticleCluster.astro';
import SeriesLiteCluster from './SeriesLiteCluster.astro';
import type { SeriesKey } from '@/data/floating-cluster-ui';

interface Props {
 mode: 'single' | 'series-lite';
 variant: string;
 audioState?: 'none' | 'available' | 'loading' | 'playing' | 'paused';
 seriesKey?: SeriesKey;
 currentSlug?: string;
 hubHref?: string;
 /** Показать ⚙ «Настройки чтения» (mode="single") — см. SingleArticleCluster. */
 settings?: boolean;
}

const {
  mode,
  variant,
  audioState = 'none',
  seriesKey,
  currentSlug,
  hubHref,
  settings = false,
} = Astro.props;
---
{mode === 'single' ? (
  <SingleArticleCluster variant={variant as 'hermeneutics' | 'article'} audioState={audioState} settings={settings} />
) : mode === 'series-lite' && seriesKey && currentSlug ? (
  <SeriesLiteCluster
    variant={variant as 'pastor' | 'heart'}
    seriesKey={seriesKey}
    currentSlug={currentSlug}
    hubHref={hubHref}
    audioState={audioState}
  />
) : null}
