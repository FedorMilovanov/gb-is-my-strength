---
/**
 * SaveButton — точная реализация gb-save из референса.
 *
 * КЛЮЧЕВОЕ ОТЛИЧИЕ от gb-icon:
 * - НЕТ ::before halo ring (это намеренно! save — особый класс)
 * - При is-saved: только gold fill + bounce анимация, никакого кружка
 * - Иконка: bookmark SVG (path d="M19 21l-7-5-7 5V5...")
 */

interface Props {
  saved?: boolean;
  class?: string;
  tip?: string;
}

const {
  saved = false,
  class: className = '',
  tip,
} = Astro.props;

const classes = ['gb-save', saved ? 'is-saved' : '', className].filter(Boolean).join(' ');
---
<button
  type="button"
  class={classes}
  data-fc-action="save"
  aria-label={saved ? 'Убрать из Избранного' : 'Добавить в Избранное'}
  aria-pressed={saved ? 'true' : 'false'}
  data-tip={tip}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
  </svg>
</button>
