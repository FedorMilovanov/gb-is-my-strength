---
/**
 * GillRailControls — v16 controls для gbs2-rail footer Гилла.
 * Точная реализация .gbs-rail-foot из референса.
 *
 * Встраивается ВНУТРЬ существующего gbs2-rail, не заменяет его.
 * Сохраняет gbs2-* классы для owner:ui-guard.
 *
 * Состав: Theme | Search | A− | A+ | PlayEmber | Save
 * Все кнопки .gbs-rail-foot__btn (32×32px), кроме ember (--ember-size:32px) и save
 */

import PlayEmber from './PlayEmber.astro';
import SaveButton from './SaveButton.astro';

interface Props {
  audioState?: 'none' | 'available' | 'loading' | 'playing' | 'paused';
  progress?: number;
  showFontSize?: boolean;
  /** context: 'rail' = desktop aside, 'mobile' = mobile head strip */
  context?: 'rail' | 'mobile';
  /** Ссылка "назад" в rail (arrow button) */
  homeHref?: string;
  /** Устаревший prop для совместимости */
  includeStyles?: boolean;
}

const {
  audioState = 'none',
  progress = 0,
  showFontSize = true,
  context = 'rail',
  homeHref,
  includeStyles: _unused,
} = Astro.props;
---
{/* PremiumControls canonical CSS */}
<link rel="stylesheet" href="/css/premium-controls.css?v=pc-v21" />

<div class="gbs-rail-foot gb-rail-foot" data-fc-controls="gill-rail">

  <!-- Theme toggle -->
  <button
    type="button"
    class="gbs-rail-foot__btn gb-theme-toggle"
    data-fc-action="theme"
    aria-label="Тема"
    aria-pressed="false"
    data-tip="Тема"
  >
    <span class="theme-icon-sun" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4.5"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
    </span>
    <span class="theme-icon-moon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
      </svg>
    </span>
  </button>

  <!-- Search -->
  <button
    type="button"
    class="gbs-rail-foot__btn"
    data-fc-action="search"
    aria-label="Поиск"
    data-tip="Поиск"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/>
      <path d="M21 21l-4.3-4.3"/>
    </svg>
  </button>

  {showFontSize && (
    <>
      <!-- Font size decrease -->
      <button
        type="button"
        class="gbs-rail-foot__btn gbs-rail-foot__btn--text"
        data-fc-action="font-down"
        aria-label="Уменьшить шрифт"
        data-tip="Меньше"
      >A−</button>
      <!-- Font size increase -->
      <button
        type="button"
        class="gbs-rail-foot__btn gbs-rail-foot__btn--text"
        data-fc-action="font-up"
        aria-label="Увеличить шрифт"
        data-tip="Больше"
      >A+</button>
    </>
  )}

  <!-- Play Ember (32px в rail, ring-color = accent-gold) -->
  <PlayEmber
    audioState={audioState}
    progress={progress}
    class="gbs-rail-ember"
    tip="Озвучка"
  />

  <!-- Save — без halo, gold fill при is-saved -->
  <SaveButton class="gbs-rail-foot__btn" tip="Сохранить" />

</div>

