---
/**
 * GillRailControls — v16 controls для gbs2-rail footer Гилла.
 * Точная реализация .gbs-rail-foot из референса.
 *
 * Встраивается ВНУТРЬ существующего gbs2-rail, не заменяет его.
 * Сохраняет gbs2-* классы для owner:ui-guard.
 *
 * Состав: Theme | Search | A− | A+ | PlayEmber | Save
 * Все кнопки .gbs-rail-foot__btn (32×32px), кроме ember (--ember-size:32px) и save
 */

import PlayEmber from './PlayEmber.astro';
import SaveButton from './SaveButton.astro';

interface Props {
  audioState?: 'none' | 'available' | 'loading' | 'playing' | 'paused';
  progress?: number;
  showFontSize?: boolean;
  /** context: 'rail' = desktop aside, 'mobile' = mobile head strip */
  context?: 'rail' | 'mobile';
  /** Ссылка "назад" в rail (arrow button) */
  homeHref?: string;
  /** Устаревший prop для совместимости */
  includeStyles?: boolean;
}

const {
  audioState = 'none',
  progress = 0,
  showFontSize = true,
  context = 'rail',
  homeHref,
  includeStyles: _unused,
} = Astro.props;
---
<div class="gbs-rail-foot gb-rail-foot" data-fc-controls="gill-rail">

  <!-- Theme toggle -->
  <button
    type="button"
    class="gbs-rail-foot__btn gb-theme-toggle"
    data-fc-action="theme"
    aria-label="Тема"
    aria-pressed="false"
    data-tip="Тема"
  >
    <span class="theme-icon-sun" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4.5"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
    </span>
    <span class="theme-icon-moon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
      </svg>
    </span>
  </button>

  <!-- Search -->
  <button
    type="button"
    class="gbs-rail-foot__btn"
    data-fc-action="search"
    aria-label="Поиск"
    data-tip="Поиск"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/>
      <path d="M21 21l-4.3-4.3"/>
    </svg>
  </button>

  {showFontSize && (
    <>
      <!-- Font size decrease -->
      <button
        type="button"
        class="gbs-rail-foot__btn gbs-rail-foot__btn--text"
        data-fc-action="font-down"
        aria-label="Уменьшить шрифт"
        data-tip="Меньше"
      >A−</button>
      <!-- Font size increase -->
      <button
        type="button"
        class="gbs-rail-foot__btn gbs-rail-foot__btn--text"
        data-fc-action="font-up"
        aria-label="Увеличить шрифт"
        data-tip="Больше"
      >A+</button>
    </>
  )}

  <!-- Play Ember (32px в rail, ring-color = accent-gold) -->
  <PlayEmber
    audioState={audioState}
    progress={progress}
    class="gbs-rail-ember"
    tip="Озвучка"
  />

  <!-- Save — без halo, gold fill при is-saved -->
  <SaveButton class="gbs-rail-foot__btn" tip="Сохранить" />

</div>

<style is:global>
@layer gbs2 {
  /* =========================================================
     gbs-rail-foot — footer controls strip
     Точная реализация из референса (6 кнопок в строку)
     ========================================================= */
  .gbs-rail-foot.gb-rail-foot {
    margin-top: auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 0;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, .08);
    width: 100%;
  }

  .gbs-rail-foot__btn {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: #a8957f;
    background: transparent;
    border: 0;
    border-radius: 50%;
    transition:
      color .28s var(--gb-ease-out, cubic-bezier(.2,.7,.2,1)),
      transform .32s var(--gb-ease-spring, cubic-bezier(.34,1.56,.64,1));
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    transform-origin: center;
  }

  @media (hover: hover) and (pointer: fine) {
    .gbs-rail-foot__btn:hover {
      color: #f4e8d9;
      transform: scale(1.18);
    }
  }
  .gbs-rail-foot__btn:active { transform: scale(.88); transition: transform .12s; }
  .gbs-rail-foot__btn:focus-visible { outline: 2px solid var(--color-accent, #7a2e2e); outline-offset: 3px; border-radius: 50%; }

  .gbs-rail-foot__btn svg {
    width: 17px;
    height: 17px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform .32s var(--gb-ease-spring, cubic-bezier(.34,1.56,.64,1));
  }
  @media (hover: hover) and (pointer: fine) {
    .gbs-rail-foot__btn:hover svg { transform: scale(1.10); }
  }

  /* Текстовые кнопки (A+ A−) */
  .gbs-rail-foot__btn--text {
    font-family: var(--f-body, Georgia, serif);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.02em;
  }

  /* Theme toggle в rail (те же классы что и в standalone) */
  .gbs-rail-foot__btn.gb-theme-toggle {
    overflow: hidden;
  }
  .gbs-rail-foot__btn.gb-theme-toggle .theme-icon-sun,
  .gbs-rail-foot__btn.gb-theme-toggle .theme-icon-moon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition:
      opacity .32s var(--gb-ease-out, cubic-bezier(.2,.7,.2,1)),
      transform .42s var(--gb-ease-spring, cubic-bezier(.34,1.56,.64,1));
  }
  .gbs-rail-foot__btn.gb-theme-toggle .theme-icon-sun  { opacity: 1; transform: rotate(0) scale(1); }
  .gbs-rail-foot__btn.gb-theme-toggle .theme-icon-moon { opacity: 0; transform: rotate(-90deg) scale(.5); }
  html.dark .gbs-rail-foot__btn.gb-theme-toggle .theme-icon-sun  { opacity: 0; transform: rotate(90deg) scale(.5); }
  html.dark .gbs-rail-foot__btn.gb-theme-toggle .theme-icon-moon { opacity: 1; transform: rotate(0) scale(1); }

  /* Ember в rail — 32px и gold ring */
  .gb-rail-foot .gb-ember,
  .gb-rail-foot .gbs-rail-ember {
    --ember-size: 32px;
    --ring-color: var(--color-accent-gold-bright, #d8aa6d);
  }
  .gb-rail-foot .gb-ember__ring-track {
    stroke: rgba(232, 184, 120, .22);
  }
  .gb-rail-foot .gb-ember__ring-progress {
    stroke-width: 1.5;
  }

  /* Save в rail — те же классы gb-save, без halo */
  .gb-rail-foot .gb-save {
    width: 32px;
    height: 32px;
  }
  .gb-rail-foot .gb-save svg {
    width: 17px;
    height: 17px;
  }

  /* Tooltips для rail foot (появляются вверх, не вниз) */
  .gbs-rail-foot__btn[data-tip]::after,
  .gb-rail-foot .gb-ember[data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(6px) scale(.94);
    padding: 5px 10px;
    border-radius: 6px;
    background: #1a1a1a;
    color: #fff;
    font-family: var(--f-ui, 'Source Sans 3', system-ui, sans-serif);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity .22s var(--gb-ease-out, cubic-bezier(.2,.7,.2,1)),
      transform .28s var(--gb-ease-spring, cubic-bezier(.34,1.56,.64,1));
    z-index: 10;
    /* В production отключаем тултипы (фикс из v16) */
    display: none;
  }
}
</style>
