---
/**
 * SingleArticleCluster — одиночный вертикальный кластер для standalone статей.
 * Точная реализация gb-floater из референса gb-floating-cluster-probe-v16.html.
 *
 * Структура (сверху вниз):
 *   1. Theme toggle (gb-icon gb-theme-toggle)
 *   2. Search (gb-icon)
 *   3. PlayEmber (gb-ember)
 *   4. Save (gb-save)
 *
 * Positioning:
 *   - default: position:fixed, top:max(20px,...), right:max(20px,...)
 *   - variant="hermeneutics": same fixed, but top/right override
 *     copies old .theme-toggle geometry (top:clamp(24,3.5vw,44)-4; right:8.5vw)
 *     so day/night SVG sits exactly on the breadcrumb visual level
 *     (owner spec: replace old control, preserve its anchor).
 *
 * На мобильных (≤899px): нижняя центрированная горизонтальная пилюля
 */

import PlayEmber from './PlayEmber.astro';
import SaveButton from './SaveButton.astro';
import GooPlayMini from '@/components/ui/speed-bloom/GooPlayMini.astro';

interface Props {
  /**
   * Визуальный вариант.
   *  - 'article' (default): generic standalone article.
   *  - 'hermeneutics': day/night anchored на breadcrumb-level (overrides top/right,
   *    не position) — per PDF-plan Phase 1 acceptance: "top delta ≤ 8px
   *    relative to breadcrumb-level, right-edge matches old article slot".
   */
  variant?: 'hermeneutics' | 'article';
  audioState?: 'none' | 'available' | 'loading' | 'playing' | 'paused';
  progress?: number;
}

const {
  variant = 'article',
  audioState = 'none',
  progress = 0,
} = Astro.props;
---
{/* PremiumControls canonical CSS */}

<div
  id="gbFloatingControls"
  class={`gb-floater gb-floater--${variant}`}
  data-fc-root
  data-fc-variant={variant}
  data-fc-mode="single"
  role="group"
  aria-label="Быстрые действия"
>
  <!-- 1. Theme toggle -->
  <button
    type="button"
    class="gb-icon gb-theme-toggle"
    id="gbFcTheme"
    data-fc-action="theme"
    aria-label="Тема"
    aria-pressed="false"
  >
    <span class="theme-icon-sun" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4.5" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
    </span>
    <span class="theme-icon-moon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </span>
  </button>

  <!-- 2. Search -->
  <button
    type="button"
    class="gb-icon"
    id="gbFcSearch"
    data-fc-action="search"
    aria-label="Поиск"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path d="M21 21l-4.3-4.3" />
    </svg>
  </button>

  <!-- 3. Play — Hermeneutics gets the goo Play (closed disc, gold contour, in-circle
       speed label); other single articles keep the classic ember until rollout.
       standalone={false}: this control lives inside the cluster root, so the
       cluster's own click delegation drives play (no nested [data-fc-root]). The
       goo mini owns the shared goo defs on single-article pages. -->
  {variant === 'hermeneutics'
    ? <GooPlayMini defs={true} standalone={false} direction="left" class="gb-floater-ember" tip="Озвучка" />
    : <PlayEmber audioState={audioState} progress={progress} />}

  <!-- 4. Save — NO halo (gb-save, not gb-icon) -->
  <SaveButton />
</div>

