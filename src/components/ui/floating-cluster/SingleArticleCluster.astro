---
/**
 * SingleArticleCluster — одиночный вертикальный кластер для standalone статей.
 * Точная реализация gb-floater из референса gb-floating-cluster-probe-v16.html.
 *
 * Структура (сверху вниз), одинаковая для ОБОИХ вариантов (owner: "должно
 * быть как в Гилле, справа сверху PLAY, а не в левом меню... стандарт Гилла
 * с адаптацией цветовой только, SVG значки и расположение Гилла" —
 * MOBILE_CHROME_ENGINE_UNIFICATION_2026-07-12, часть PR-5):
 *   1. Theme toggle (gb-icon gb-theme-toggle)
 *   2. Search (gb-icon)
 *   3. PlayEmber (gb-ember) + постоянный бейдж скорости (.gbs-rail-spdbadge —
 *      тот же класс и тот же generic-хук в initPlayExpand(), что у Gill
 *      desktop; CSS здесь НЕ gill-scoped, красится в цвет страницы, не в
 *      кожу/золото Gill — единственная адаптация)
 *   4. Save (gb-save)
 *
 * Раньше variant="hermeneutics" исключал 2-4 и держал их в
 * HermenevtikaRail's собственном верхнем баре — эта развилка отменена
 * owner'ом явно: Play должен быть в углу, как у Гилла, не в левом рейле.
 * Оглавление статьи (Hermenevtika TOC) остаётся СВОИМ — это трогает только
 * кластер, не TOC-колонку HermenevtikaRail.
 *
 * Positioning:
 *   - default: position:fixed, top:max(20px,...), right:max(20px,...)
 *   - variant="hermeneutics": same fixed, but top/right override copies the
 *     historical .theme-toggle geometry — СОВПАДАЕТ с формулой, которую уже
 *     использует Gill's .gbs-theme-corner (floating-cluster.css: "те же
 *     точные top/right, что канон уже использует для breadcrumb-level
 *     themetoggle... DO NOT invent calc formulas"), так что позиционирование
 *     менять не нужно — уже "как у Гилла".
 *
 * На мобильных (≤899px): нижняя центрированная горизонтальная пилюля
 */

import PlayEmber from './PlayEmber.astro';
import SaveButton from './SaveButton.astro';

interface Props {
  /**
   * Визуальный вариант.
   *  - 'article' (default): generic standalone article.
   *  - 'hermeneutics': day/night anchored на breadcrumb-level (overrides top/right,
   *    не position) — per PDF-plan Phase 1 acceptance: "top delta ≤ 8px
   *    relative to breadcrumb-level, right-edge matches old article slot".
   */
  variant?: 'hermeneutics' | 'article';
  audioState?: 'none' | 'available' | 'loading' | 'playing' | 'paused';
  progress?: number;
  /** Показать ⚙ «Настройки чтения» (тема/сепия/размер/интервал). Требует, чтобы
   *  страница рендерила GillReaderSettingsSheet и несла [data-reader-root] на
   *  своём <main>. По умолчанию выкл — не задевает существующие одиночные. */
  settings?: boolean;
}

const {
  variant = 'article',
  audioState = 'none',
  settings = false,
  progress = 0,
} = Astro.props;
---
{/* PremiumControls canonical CSS */}

<div
  id="gbFloatingControls"
  class={`gb-floater gb-floater--${variant}`}
  data-fc-root
  data-fc-variant={variant}
  data-fc-mode="single"
  role="group"
  aria-label="Быстрые действия"
>
  <!-- 1. Theme toggle -->
  <button
    type="button"
    class="gb-icon gb-theme-toggle"
    id="gbFcTheme"
    data-fc-action="theme"
    aria-label="Тема"
    aria-pressed="false"
  >
    <span class="theme-icon-sun" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4.5" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
    </span>
    <span class="theme-icon-moon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </span>
  </button>

  {settings && (
    <!-- ⚙ Настройки чтения (одиночная статья). Нейтральная кнопка: страница
         сама привязывает её к своему листу настроек (ReaderSettings шлёт
         событие 'hm:open-settings'). НЕ связана с Gill-листом серий. -->
    <button
      type="button"
      class="gb-icon"
      id="gbFcSettings"
      aria-label="Настройки чтения"
      aria-haspopup="dialog"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 7h10M18 7h2M4 17h2M10 17h10" /><circle cx="16" cy="7" r="2" /><circle cx="8" cy="17" r="2" />
      </svg>
    </button>
  )}

  <!-- 2. Search -->
  <button
    type="button"
    class="gb-icon"
    id="gbFcSearch"
    data-fc-action="search"
    aria-label="Поиск"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path d="M21 21l-4.3-4.3" />
    </svg>
  </button>

  <!-- 3. Play — canonical bloom-pill panel (initPlayExpand), same as Gill
       desktop corner. Wrapped span + .gbs-rail-spdbadge give a persistent
       speed indicator via the SAME generic hook Gill's badge uses
       (ember.parentNode.querySelector('.gbs-rail-spdbadge') in
       floating-cluster-controller.js) — CSS for it here is unscoped, so it
       inherits the page's own day/night tokens instead of Gill's palette. -->
  <span class="gb-ember-playwrap">
    <PlayEmber audioState={audioState} progress={progress} />
    <span class="gbs-rail-spdbadge" aria-hidden="true">1×</span>
  </span>

  <!-- 4. Save — NO halo (gb-save, not gb-icon) -->
  <SaveButton />
  <!-- Hermeneutics: Search/Play/Save moved into HermenevtikaRail's own top
       bar (search pill → Play → Save, blooms UP not over the article) — this
       floater is theme-toggle only there now, at its unchanged breadcrumb-level
       anchor. -->
</div>

