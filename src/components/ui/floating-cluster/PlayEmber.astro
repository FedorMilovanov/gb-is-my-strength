---
/**
 * PlayEmber — точная реализация gb-ember из референса gb-floating-cluster-probe-v16.html
 *
 * Классы: gb-ember (как в референсе, НЕ fc-play-ember)
 * Состояния через data-state: idle | playing | paused | complete
 * Прогресс через CSS --p переменную (0–100)
 * SVG ring-track + ring-progress с stroke-dashoffset
 * Иконки: glyph (play▶), pause, check (✓)
 * Loading: класс is-loading, пульсация только через ::before
 */

interface Props {
  /** Текущее состояние аудио */
  audioState?: 'none' | 'available' | 'loading' | 'playing' | 'paused';
  /** Прогресс 0–100 */
  progress?: number;
  /** Дополнительные классы */
  class?: string;
  /** data-tip для тултипа (desktop-only, отключён в production) */
  tip?: string;
}

const {
  audioState = 'none',
  progress = 0,
  class: className = '',
  tip,
} = Astro.props;

// Маппинг audioState → data-state референса
const dataState = audioState === 'none' || audioState === 'available'
  ? 'idle'
  : audioState === 'loading'
    ? 'idle'  // will get is-loading class
    : audioState; // playing | paused → as-is

const isLoading = audioState === 'loading';

const ariaLabel = audioState === 'playing'
  ? 'Пауза'
  : audioState === 'paused'
    ? 'Продолжить озвучку'
    : audioState === 'loading'
      ? 'Подключение озвучки'
      : 'Озвучка';

const classes = ['gb-ember', isLoading ? 'is-loading' : '', className].filter(Boolean).join(' ');
---
<button
  type="button"
  class={classes}
  data-state={dataState}
  data-fc-action="play"
  style={`--p:${progress}`}
  aria-label={ariaLabel}
  aria-haspopup="true"
  aria-expanded="false"
  data-tip={tip}
>
  <!-- SVG progress ring (injected by controller, but also here for SSR/no-JS) -->
  <svg class="gb-ember__ring-svg" viewBox="0 0 100 100" aria-hidden="true">
    <circle class="gb-ember__ring-track" cx="50" cy="50" r="45" />
    <circle class="gb-ember__ring-progress" cx="50" cy="50" r="45" />
  </svg>
  <!-- Play glyph -->
  <svg class="gb-ember__glyph" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M7 4.8v14.4L18.5 12 7 4.8z" />
  </svg>
  <!-- Pause -->
  <svg class="gb-ember__pause" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M9 6v12M15 6v12" />
  </svg>
  <!-- Complete check -->
  <svg class="gb-ember__check" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M5 12.5l4.2 4.1L19 7" />
  </svg>
</button>

<script>
  /**
   * The floating-cluster controller owns the actual 600 ms stop gesture.
   * Once that owner has moved an active ember to idle, mark the browser's
   * immediate post-long-press click for one-shot suppression by the reader
   * runtime guard. This component never toggles or stops TTS itself.
   */
  function bindLongPressClickMarker() {
    document.querySelectorAll<HTMLButtonElement>('.gb-ember').forEach((ember) => {
      if (ember.dataset.gbLongPressMarkerBound === 'true') return;
      ember.dataset.gbLongPressMarkerBound = 'true';

      let startedAt = 0;
      let activeAtDown = false;

      ember.addEventListener('pointerdown', (event) => {
        if (event.pointerType && event.pointerType !== 'touch' && event.pointerType !== 'pen') return;
        startedAt = performance.now();
        activeAtDown = ember.dataset.state === 'playing' || ember.dataset.state === 'paused';
      }, { passive: true });

      ember.addEventListener('pointerup', (event) => {
        const stoppedByLongPress = activeAtDown
          && performance.now() - startedAt >= 580
          && ember.dataset.state === 'idle';
        if (stoppedByLongPress) {
          ember.dataset.gbSuppressTtsClickUntil = String(Date.now() + 1000);
          event.preventDefault();
        }
        startedAt = 0;
        activeAtDown = false;
      }, { passive: false });

      const reset = () => {
        startedAt = 0;
        activeAtDown = false;
      };
      ember.addEventListener('pointercancel', reset, { passive: true });
      ember.addEventListener('pointerleave', reset, { passive: true });
    });
  }

  bindLongPressClickMarker();
  document.addEventListener('astro:page-load', bindLongPressClickMarker);
</script>
