---
/**
 * SeriesLiteCluster — compact серийный кластер для коротких серий.
 * Используется для: pastor-series, hard-texts (heart).
 *
 * Структура (desktop, fixed top-right):
 *   [Chip: название серии + номер части]  ←link к hub
 *   [gb-icon theme] [gb-icon search] [gb-ember] [gb-save]
 *
 * Мобайл: горизонтально внизу — chip + controls row
 * Классы: gb-icon, gb-ember, gb-save (как в референсе)
 */

import PlayEmber from './PlayEmber.astro';
import SaveButton from './SaveButton.astro';
import { getSeriesLiteMeta, type SeriesKey } from '@/data/floating-cluster-ui';

interface Props {
  variant: 'pastor' | 'heart' | string;
  seriesKey: SeriesKey;
  currentSlug: string;
  hubHref?: string;
  audioState?: 'none' | 'available' | 'loading' | 'playing' | 'paused';
}

const {
  variant,
  seriesKey,
  currentSlug,
  hubHref,
  audioState = 'none',
} = Astro.props;

const meta = getSeriesLiteMeta(seriesKey, currentSlug);
const currentNum = meta.currentNumber ? String(meta.currentNumber) : 'I';
const resolvedHubHref = hubHref || meta.baseUrl || '/';
const seriesTitle = meta.title || 'Серия';
---
{/* PremiumControls canonical CSS */}
<link rel="stylesheet" href="/css/premium-controls.css?v=pc-v21" />

<div
  id="gbFloatingControls"
  class={`gb-floater gb-floater--series-lite gb-floater--${variant}`}
  data-fc-root
  data-fc-mode="series-lite"
  data-fc-variant={variant}
  data-fc-series={seriesKey}
  role="group"
  aria-label={`Действия серии «${seriesTitle}»`}
>
  <!-- Series chip — ссылка к hub -->
  <a
    class="gb-series-chip"
    href={resolvedHubHref}
    aria-label={`Открыть серию «${seriesTitle}»`}
  >
    <span class="gb-series-chip__eyebrow">Серия</span>
    <span class="gb-series-chip__title">{seriesTitle}</span>
  </a>

  <!-- Controls pill -->
  <div class="gb-series-controls">
    <!-- Roman numeral index -->
    <span class="gb-series-index" aria-label={`Часть ${currentNum}`}>{currentNum}</span>

    <!-- Theme toggle -->
    <button
      type="button"
      class="gb-icon gb-theme-toggle"
      id="gbFcTheme"
      data-fc-action="theme"
      aria-label="Тема"
      aria-pressed="false"
    >
      <span class="theme-icon-sun" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4.5"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
      </span>
      <span class="theme-icon-moon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
      </span>
    </button>

    <!-- Search -->
    <button
      type="button"
      class="gb-icon"
      id="gbFcSearch"
      data-fc-action="search"
      aria-label="Поиск"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/>
        <path d="M21 21l-4.3-4.3"/>
      </svg>
    </button>

    <!-- Play Ember -->
    <PlayEmber audioState={audioState} />

    <!-- Save -->
    <SaveButton />
  </div>
</div>

