---
/**
 * ClusterButton — gb-icon из референса.
 * С ::before halo на hover (в отличие от gb-save который без halo).
 * Используется для theme-toggle, search, и прочих иконок.
 */

interface Props {
  label: string;
  class?: string;
  title?: string;
  action?: string;
  tip?: string;
  pressed?: 'true' | 'false';
}

const {
  label,
  class: className = '',
  title = label,
  action,
  tip,
  pressed,
} = Astro.props;

const classes = ['gb-icon', className].filter(Boolean).join(' ');
---
<button
  type="button"
  class={classes}
  aria-label={label}
  title={title}
  aria-pressed={pressed}
  data-fc-action={action}
  data-tip={tip}
>
  <slot />
</button>
