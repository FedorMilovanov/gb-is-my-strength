---
// PremiumControlAnchor — layout/geometry layer for PremiumControls
// See: FedorMilovanov/AuditRepo → projects/gb-is-my-strength/PremiumControls/README.md §1
export interface Props {
  variant?: 'breadcrumb' | 'rail' | 'floating';
  class?: string;
}
const { variant = 'breadcrumb', class: className = '' } = Astro.props;
const cls = [
  'premium-control-anchor',
  `premium-control-anchor--${variant}`,
  className
].filter(Boolean).join(' ');
---
<div class={cls} data-pc-anchor data-pc-variant={variant}>
  <slot />
</div>

<style>
  .premium-control-anchor {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 44px;
  }
  .premium-control-anchor--breadcrumb {
    margin-left: auto;
  }
  .premium-control-anchor--rail {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .premium-control-anchor--floating {
    position: fixed;
    right: 24px;
    top: 96px;
    z-index: 40;
  }
</style>
