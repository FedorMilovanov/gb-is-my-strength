---
import { SITE } from '@/data/site';

interface Props {
  badge?: string;
  ariaLabel?: string;
}
const { badge, ariaLabel = 'Шапка сайта' } = Astro.props;
---
<header class="astro-header h-navbar" aria-label={ariaLabel}>
  <a class="astro-header__brand h-brand" href="/">{SITE.name}</a>
  {badge && <span class="astro-header__badge">{badge}</span>}
  <nav class="astro-header__nav" aria-label="Основная навигация">
    <ul class="h-nav-links">
      <li><a href="/articles/">Все статьи</a></li>
      <li><a href="/app/">Приложение</a></li>
      <li><a href="/biografii/">Биографии</a></li>
      <li><a href="/hard-texts/">Разбор заблуждений</a></li>
      <li><a href="/karty/">Карты</a></li>
      <li><a href="/about/">О проекте</a></li>
    </ul>
  </nav>
  <div class="astro-header__controls mobile-controls" aria-label="Быстрые действия">
    <a href="/izbrannoe/" class="gb-nav-fav-icon" aria-label="Избранное" title="Избранное">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
    </a>
    <button id="hCpBtnNav" class="gb-nav-search-icon" type="button" aria-label="Поиск (Ctrl+K)" title="Поиск Ctrl+K">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
    </button>
    <button id="themeToggle" class="theme-toggle" type="button" aria-label="Переключить тему" title="Тема">
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2.5M12 19.5V22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M2 12h2.5M19.5 12H22M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path></svg>
    </button>
  </div>
</header>

<style>
    .gb-nav-fav-icon { display:inline-flex; align-items:center; justify-content:center; width:38px; height:38px; color: var(--color-text-muted, #6b7280); border:1px solid var(--color-border, rgba(0,0,0,.10)); border-radius:10px; background: var(--color-surface, #fffdf8); text-decoration:none; transition: color .15s, border-color .15s; }
    .gb-nav-fav-icon:hover { color: var(--color-accent, #8a5a2b); border-color: var(--color-accent, #8a5a2b); }
</style>
