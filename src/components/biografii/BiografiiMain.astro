---
/**
 * BiografiiMain.astro — <main id="main-content"> of /biografii/.
 *
 * Refactoring 6.0 parallel pilot: the route no longer proxies one monolithic
 * `_legacy/main.html?raw` block. Instead, the landing main shell is assembled
 * from named legacy-faithful fragments while preserving exact DOM/copy.
 *
 * Pixel-parity contract remains guarded via
 *   npm run visual:parity:screenshots -- --routes /biografii/
 * and source-contract audit in scripts/biografii-visual-parity-audit.js.
 */
import recent from './_legacy/recent.html?raw';
import focus from './_legacy/focus.html?raw';
import ancient from './_legacy/ancient.html?raw';
import medieval from './_legacy/medieval.html?raw';
import reformation from './_legacy/reformation.html?raw';
import awakening from './_legacy/awakening.html?raw';
import modern from './_legacy/modern.html?raw';
import contemporary from './_legacy/contemporary.html?raw';
import epigraph from './_legacy/epigraph.html?raw';
import postArticle from './_legacy/post-article.html?raw';
---
<main id="main-content"><Fragment set:html={recent} /><Fragment set:html={focus} /><Fragment set:html={ancient} /><Fragment set:html={medieval} /><Fragment set:html={reformation} /><Fragment set:html={awakening} /><Fragment set:html={modern} /><Fragment set:html={contemporary} /><Fragment set:html={epigraph} /><Fragment set:html={postArticle} /></main>
