---
/**
 * BiografiiMain.astro — <main id="main-content"> of /biografii/.
 *
 * Refactoring 6.0 parallel pilot: the route no longer depends on raw legacy
 * fragment imports for the landing sections. The premium biography landing is
 * now assembled from hand-authored Astro components that preserve the legacy
 * DOM, copy, links and utility classes.
 *
 * Pixel-parity contract remains guarded via
 *   npm run visual:parity:screenshots -- --routes /biografii/
 * and source-contract audit in scripts/biografii-visual-parity-audit.js.
 */
import BiografiiRecentSection from './BiografiiRecentSection.astro';
import BiografiiFocusSection from './BiografiiFocusSection.astro';
import BiografiiEraStubSection from './BiografiiEraStubSection.astro';
import BiografiiAwakeningSection from './BiografiiAwakeningSection.astro';
import BiografiiEpigraphSection from './BiografiiEpigraphSection.astro';
import BiografiiArticleEndBlock from './BiografiiArticleEndBlock.astro';
---
<main id="main-content" data-pagefind-body>
  <BiografiiRecentSection />
  <BiografiiFocusSection />
  <BiografiiEraStubSection badge="I–V вв." id="era-ancient" title="Ранняя Церковь" desc="Апостолы, мученики и Отцы Церкви, заложившие основы веры." />
  <BiografiiEraStubSection badge="VI–XIV вв." id="era-medieval" title="Средние века" desc="Монастырское движение, схоластика и борьба за чистоту Евангелия." />
  <BiografiiEraStubSection badge="XV–XVII вв." id="era-reformation" title="Реформация" desc="Великий перелом: возвращение к Писанию и рождение протестантизма." />
  <BiografiiAwakeningSection />
  <BiografiiEraStubSection badge="XIX в." id="era-modern" title="XIX век" desc="Расцвет миссий и великие кафедры." />
  <BiografiiEraStubSection badge="XX–XXI вв." id="era-contemporary" title="XX–XXI вв." desc="Служители, формирующие облик живой Церкви." />
  <BiografiiEpigraphSection />
  <BiografiiArticleEndBlock />
</main>