---
/** Compact server-rendered entry for a historical era awaiting publications. */
export interface Props {
  badge: string;
  id: string;
  title: string;
  desc: string;
}
const { badge, id, title, desc } = Astro.props;
---
<section class="bio-era-entry" aria-labelledby={id}>
  <div class="bio-era-entry__period">{badge}</div>
  <div class="bio-era-entry__body">
    <h2 id={id}>{title}</h2>
    <p class="bio-era-entry__desc">{desc}</p>
    <p class="bio-era-entry__status" data-pagefind-ignore>Материалы в подготовке</p>
  </div>
</section>
<style>
  .bio-era-entry {
    display:grid;
    grid-template-columns:minmax(5rem,8rem) minmax(0,1fr);
    align-items:start;
    gap:1.25rem;
    padding:1.25rem 0;
    border-top:1px solid var(--color-border);
    color:var(--color-text);
  }
  .bio-era-entry__period {
    font:600 1rem/1.5 Lora,Georgia,serif;
    color:var(--color-accent-strong);
    padding-top:.15rem;
  }
  .bio-era-entry__body{min-width:0}
  .bio-era-entry h2{
    font:600 clamp(1.2rem,2.3vw,1.55rem)/1.3 Lora,Georgia,serif;
    margin:0 0 .4rem;
    scroll-margin-top:7rem;
    color:var(--color-text);
  }
  .bio-era-entry__desc{margin:0 0 .45rem;font-size:.95rem;line-height:1.65;color:var(--color-text)}
  .bio-era-entry__status{margin:0;font-size:.8rem;line-height:1.5;color:var(--color-text-muted)}
  @media(max-width:580px){
    .bio-era-entry{grid-template-columns:4.25rem minmax(0,1fr);gap:.75rem}
    .bio-era-entry__period{font-size:.85rem}
  }
  @media print{.bio-era-entry{break-inside:avoid}}
</style>
