---
/**
 * BiografiiEraStubSection.astro — reusable placeholder era block for /biografii/.
 * The native route renders every era in SSR without observer-owned visibility.
 */
export interface Props {
  badge: string;
  id: string;
  title: string;
  desc: string;
}
const { badge, id, title, desc } = Astro.props;
---
<section class="h-section bio-era" style="padding-top:0;" aria-labelledby={id}>
  <div class="bio-era__head">
    <span class="bio-era__badge">{badge}</span>
    <span class="bio-era__rule" aria-hidden="true"></span>
  </div>
  <h2 class="bio-era__title" id={id}>{title}</h2>
  <p class="bio-era__desc">{desc}</p>

  <div class="bio-stub" data-pagefind-ignore>
    <span class="bio-stub__corner bio-stub__corner--tl" aria-hidden="true"></span>
    <span class="bio-stub__corner bio-stub__corner--tr" aria-hidden="true"></span>
    <span class="bio-stub__corner bio-stub__corner--bl" aria-hidden="true"></span>
    <span class="bio-stub__corner bio-stub__corner--br" aria-hidden="true"></span>
    <div class="bio-stub__row">
      <span class="bio-stub__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"></path></svg></span>
      <div>
        <p class="bio-stub__kicker">Архив эпохи</p>
        <h3 class="bio-stub__name">Материалы в подготовке</h3>
      </div>
    </div>
    <p class="bio-stub__text">Исследование жизни служителей, городов их деятельности, ключевых богословских дебатов и миссионерских путей этого периода.</p>
    <span class="bio-stub__status"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> Материал в разработке</span>
    <div class="bio-stub__facets">
      <span class="bio-stub__facet"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path></svg> Личность</span>
      <span class="bio-stub__facet"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path></svg> Контекст</span>
      <span class="bio-stub__facet"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path></svg> Наследие</span>
    </div>
  </div>
</section>
