5.21" r="3.5"></circle><circle cx="157.32" cy="241.41" r="3.5"></circle><circle cx="145.51" cy="182.6" r="3.5"></circle></g><g class="g3g-atlas-marker"><circle cx="472" cy="192" r="13"></circle><circle cx="235" cy="270" r="13"></circle><circle cx="87" cy="264" r="13"></circle><circle cx="85" cy="151" r="13"></circle></g><g class="g3g-atlas-number"><text x="472" y="192">1</text><text x="235" y="270">2</text><text x="87" y="264">3</text><text x="85" y="151">4</text></g><g fill="var(--ink)" transform="translate(540 44)"><path d="M0 -15L-5 3L0 0L5 3Z"></path><text font-size="12" text-anchor="middle" x="0" y="17">С</text></g></svg><figcaption>Natural Earth, 1:110 млн; обзорный контур, примерные центры городов. Линии ведут к номерам, а не обозначают маршруты.</figcaption></figure><div><p class="g3g-kicker">Географический атлас · 01</p><h4 id="g3g-history-atlas-heading">От Джорджии к региональным встречам</h4><ol class="g3g-atlas-list"><li><b aria-hidden="true">1</b><div><h5>Дугласвилл · 2013</h5><p>Первая конференция при Pray’s Mill, по свидетельству участника.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('challies')} id="cite-g3g-history-1">Воспоминания Чаллиса · карта</a></div></li><li><b aria-hidden="true">2</b><div><h5>Даллас · 2018</h5><p>Встреча по подготовке заявления, по рассказу Тома Аскола.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('ascol-2018')} id="cite-g3g-history-2">Рассказ Аскола о Далласе · карта</a></div></li><li><b aria-hidden="true">3</b><div><h5>Саутлейк · 2024</h5><p>Заявленная майская площадка конференции о Реформации.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('reformation-2024')} id="cite-g3g-history-3">Майская регистрация 2024 · карта</a></div></li><li><b aria-hidden="true">4</b><div><h5>Мустанг · 2024</h5><p>Заявленная октябрьская площадка; Джастин Питерс описал своё участие.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('cessationist-2024')} id="cite-g3g-history-4">Октябрьская регистрация 2024 · карта</a> · <a class="g3g-source" data-journal-citation="" href={historyCitation('peters-2024')} id="cite-g3g-history-5">Отчёт Питерса за 2024 год · карта</a></div></li></ol></div></section>
<section aria-labelledby="g3g-history-chron"><div class="g3g-sectionhead"><h4 id="g3g-history-chron">Четырнадцать лет в документах</h4><span class="g3g-ordinal">2011—2024</span></div><div class="g3g-legend"><span class="g3g-key"><i aria-hidden="true" class="g3g-dot g3g-square"></i> Анонс / планы</span><span class="g3g-key"><i aria-hidden="true" class="g3g-dot g3g-full"></i> Свидетельство</span><span class="g3g-key"><i aria-hidden="true" class="g3g-dot g3g-catalog"></i> Каталог записей</span><span class="g3g-key"><i aria-hidden="true" class="g3g-dot g3g-document"></i> Документ</span></div><ol class="g3g-timeline"><li><div class="g3g-year">2011</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot g3g-square"></span> Анонс / планы</div><h5>Публичное приглашение</h5><p>Подготовка первой встречи на январь 2013 года.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('invitation-2011')} id="cite-g3g-history-6">Приглашение 2011 года · хронология</a></li><li><div class="g3g-year">2013</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot g3g-full"></span> Свидетельство участника</div><h5>Евангелие и миссия</h5><p>Первая конференция при Pray’s Mill.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('challies')} id="cite-g3g-history-7">Воспоминания Чаллиса · хронология</a></li><li><div class="g3g-year">2014</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot"></span> Каталог записей</div><h5>Учение о Церкви</h5><p>Проповедь, поклонение и ученичество.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('gnl-2014')} id="cite-g3g-history-8">Каталог записей 2014 · хронология</a></li><li><div class="g3g-year">2015</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot"></span> Каталог записей</div><h5>Божье Слово</h5><p>Авторитет Писания.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('gnl-2015')} id="cite-g3g-history-9">Каталог записей 2015 · хронология</a></li><li><div class="g3g-year">2016</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot"></span> Каталог записей</div><h5>Троица</h5><p>Исповедание, поклонение и спасение.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('gnl-2016')} id="cite-g3g-history-10">Каталог записей 2016 · хронология</a></li><li><div class="g3g-year">2017</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot"></span> Каталог записей</div><h5>Реформация</h5><p>Юбилейная тема Reformation 500.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('gnl-2017')} id="cite-g3g-history-11">Каталог записей 2017 · хронология</a></li><li><div class="g3g-year">2018</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot g3g-document"></span> Документ</div><h5>Заявление и дискуссия</h5><p>Публикация документа о социальной справедливости и Евангелии.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('statement-2018')} id="cite-g3g-history-12">Текст заявления 2018 · хронология</a></li><li><div class="g3g-year">2019</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot"></span> Каталог записей</div><h5>Миссия Бога</h5><p>Тема объявленной программы и каталога.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('gnl-2019')} id="cite-g3g-history-13">Каталог записей 2019 · хронология</a></li><li><div class="g3g-year">2020</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot"></span> Каталог записей</div><h5>Поклонение</h5><p>Тематическая подборка записей.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('gnl-2020')} id="cite-g3g-history-14">Каталог записей 2020 · хронология</a></li><li><div class="g3g-year">2021</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot g3g-square"></span> Анонс / планы</div><h5>Расширение служения</h5><p>Скотт Аниол объявляет о новой роли и планах.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('aniol-2021')} id="cite-g3g-history-15">Объявление Аниола 2021 · хронология</a></li><li><div class="g3g-year">2023</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot g3g-square"></span> Анонс / планы</div><h5>Божий суверенитет</h5><p>Анонс национальной конференции.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('announcement-2023')} id="cite-g3g-history-16">Анонс конференции 2023 · хронология</a></li><li><div class="g3g-year">2024</div><div class="g3g-event-kind"><span aria-hidden="true" class="g3g-dot g3g-square"></span> Анонс / планы</div><h5>Региональные встречи</h5><p>Объявленные мероприятия в Техасе и Оклахоме.</p><a class="g3g-source" data-journal-citation="" href={historyCitation('reformation-2024')} id="cite-g3g-history-17">Майская регистрация 2024 · хронология</a> <a class="g3g-source" data-journal-citation="" href={historyCitation('cessationist-2024')} id="cite-g3g-history-18">Октябрьская регистрация 2024 · хронология</a></li></ol><p class="g3g-note">Избранные события, не ежегодный реестр: пропущенные годы не означают отсутствия конференций. Каталог не равен стенограмме выступления.</p></section>
