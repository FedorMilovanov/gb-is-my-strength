---
interface Props {
  active?: 'journal' | 'dossier';
}
const { active = 'journal' } = Astro.props;
---
<header class="je-masthead" aria-label="Редакционная навигация">
  <div class="je-masthead__top">
    <a class="je-masthead__identity" href="/journal/">
      <svg class="je-masthead__mark" viewBox="0 0 64 48" aria-hidden="true" focusable="false">
        <path d="M4 10C15 6 26 10 32 17C38 10 49 6 60 10V39C49 35 38 38 32 44C26 38 15 35 4 39Z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
        <path d="M32 17V43M9 14C17 12 24 15 28 19M55 14C47 12 40 15 36 19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span class="je-masthead__name">
        <span class="je-masthead__publication">Господь Бог — Сила Моя</span>
        <span class="je-masthead__series">ЖУРНАЛ <span aria-hidden="true">/</span> ИССЛЕДОВАНИЯ</span>
      </span>
    </a>
    <span class="je-masthead__descriptor">Документы · контекст · ответственный разбор</span>

    <div class="je-masthead__actions">
      <button
        type="button"
        class="je-masthead__search-btn"
        id="gbSearchBtn"
        aria-label="Поиск по сайту (Ctrl+K)"
        data-search-shortcut
        data-search-shortcut-label="Поиск по сайту"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="je-masthead__search-text">Поиск</span>
        <kbd class="je-masthead__kbd" aria-hidden="true">Ctrl K</kbd>
      </button>

      <button
        type="button"
        id="themeToggle"
        class="je-masthead__theme-btn theme-toggle"
        aria-label="Переключить тему (клавиша D)"
        title="Переключить тему (D)"
      >
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z"/>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>

      <a class="je-masthead__home" href="/">На основной сайт <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <nav class="je-masthead__nav" aria-label="Разделы издания">
    <a href="/journal/" aria-current={active === 'journal' ? 'page' : undefined}>Журнал</a>
    <a href="/journal/#lead-dossier" aria-current={active === 'dossier' ? 'true' : undefined}>Досье и исследования</a>
    <a href="/articles/">Богословские статьи</a>
    <a href="/about/">Об издании</a>
  </nav>
</header>
<style>
  .je-masthead {
    --je-masthead-gutter: 32px;
    background: #0a1928;
    color: #f9f2e4;
    border-bottom: 1px solid #c6a66c;
    font-family: 'Source Sans 3', system-ui, sans-serif;
  }
  .je-masthead__top {
    max-width: 1260px;
    margin: 0 auto;
    padding: 16px max(var(--je-masthead-gutter), env(safe-area-inset-right, 0px)) 14px max(var(--je-masthead-gutter), env(safe-area-inset-left, 0px));
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .je-masthead__identity {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .je-masthead__mark {
    flex: none;
    width: 48px;
    height: 38px;
    color: #e5bb73;
  }
  .je-masthead__name {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .je-masthead__publication {
    font: 600 clamp(18px, 2vw, 25px)/1.15 'Playfair Display', Georgia, serif;
    letter-spacing: .005em;
  }
  .je-masthead__series {
    color: #d9c39f;
    font: 600 10.5px/1.4 'Source Sans 3', sans-serif;
    letter-spacing: .18em;
  }
  .je-masthead__series span {
    color: #c6a66c;
    padding: 0 4px;
  }
  .je-masthead__descriptor {
    margin-left: auto;
    padding-left: 24px;
    border-left: 1px solid #2e4458;
    max-width: 250px;
    color: #d5c9b8;
    font: italic 14.5px/1.4 Lora, Georgia, serif;
  }
  .je-masthead__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
    margin-left: auto;
  }
  .je-masthead__search-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    min-height: 38px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(229, 187, 115, 0.35);
    border-radius: 20px;
    color: #e8dccb;
    font: 600 12.5px/1 'Source Sans 3', sans-serif;
    cursor: pointer;
    transition: background .18s, border-color .18s, color .18s;
  }
  .je-masthead__search-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #e5bb73;
    color: #fff;
  }
  .je-masthead__search-btn svg {
    color: #e5bb73;
  }
  .je-masthead__kbd {
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    font-size: 10px;
    color: #dfc89d;
  }
  .je-masthead__theme-btn {
    position: relative;
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(229, 187, 115, 0.35);
    border-radius: 50%;
    color: #e5bb73;
    cursor: pointer;
    padding: 0;
    transition: background .18s, border-color .18s, transform .15s;
  }
  .je-masthead__theme-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #e5bb73;
    transform: scale(1.05);
  }
  .je-masthead__theme-btn svg {
    position: absolute;
    width: 18px;
    height: 18px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: opacity .2s, color .2s;
  }
  .je-masthead__home {
    color: #f0d9a8;
    font-size: 12.5px;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
    padding: 6px 4px;
  }
  .je-masthead__home:hover {
    color: #fff;
  }
  .je-masthead__nav {
    max-width: 1260px;
    margin: 0 auto;
    display: flex;
    gap: clamp(16px, 3vw, 42px);
    align-items: center;
    padding: 0 max(var(--je-masthead-gutter), env(safe-area-inset-right, 0px)) 0 max(var(--je-masthead-gutter), env(safe-area-inset-left, 0px));
    border-top: 1px solid #1c2e40;
  }
  .je-masthead__nav a {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    border-bottom: 3px solid transparent;
    color: #efe6d7;
    text-decoration: none;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 3px 0 0;
    transition: color .18s, border-color .18s;
  }
  .je-masthead__nav a[aria-current="page"],
  .je-masthead__nav a[aria-current="true"] {
    border-color: #d6ad5d;
    color: #fff;
  }
  .je-masthead a:focus-visible,
  .je-masthead button:focus-visible {
    outline: 2px solid #eacb85;
    outline-offset: 3px;
  }
  .je-masthead__nav a:hover {
    color: #f9d997;
  }

  @media (max-width: 980px) {
    .je-masthead__descriptor {
      display: none;
    }
  }

  @media (max-width: 770px) {
    .je-masthead {
      --je-masthead-gutter: 20px;
    }
    .je-masthead__top {
      padding-top: 12px;
      padding-bottom: 10px;
      gap: 12px;
    }
    .je-masthead__mark {
      width: 36px;
      height: 28px;
    }
    .je-masthead__publication {
      font-size: 18px;
    }
    .je-masthead__series {
      font-size: 9.5px;
    }
    .je-masthead__home {
      display: none;
    }
    .je-masthead__search-btn {
      padding: 6px 10px;
    }
    .je-masthead__kbd {
      display: none;
    }
    .je-masthead__nav {
      padding: 0 20px;
      overflow-x: auto;
      gap: 24px;
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
    }
    .je-masthead__nav a {
      min-height: 44px;
      font-size: 11.5px;
    }
  }

  @media (max-width: 440px) {
    .je-masthead__search-text {
      display: none;
    }
    .je-masthead__search-btn {
      width: 38px;
      height: 38px;
      min-width: 38px;
      border-radius: 50%;
      padding: 0;
      justify-content: center;
    }
    .je-masthead__theme-btn {
      width: 38px;
      height: 38px;
      min-width: 38px;
      min-height: 38px;
    }
  }
</style>
