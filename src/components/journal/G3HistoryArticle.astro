---
import JournalEditorialShell from './JournalEditorialShell.astro';
import JournalEditorialRail from './JournalEditorialRail.astro';
import JournalArticleHeader from './JournalArticleHeader.astro';
import JournalContents from './JournalContents.astro';
import G3HistoryFeature from './G3HistoryFeature.astro';
import { G3_EDITORIAL_MEDIA } from '@/data/journal/g3EditorialMedia';
import { G3_HISTORY_DRAFT_METADATA as draft } from '@/data/journal/g3HistoryDraftMetadata';
import { G3_HISTORY_DRAFT_SOURCES as sources, historyCitation as cite } from '@/data/journal/g3HistoryDraftSources';
import './g3History.css';

/**
 * Fail-closed production guard. This file is a source-only manuscript:
 * a public Astro route must NOT import it without new signed Research handoff.
 * Remove this guard only as part of explicit publication authorization.
 */
if (import.meta.env.PROD) {
  throw new Error('G3 history PUBLICATION_HOLD: signed Research→Product handoff required before production routing');
}

const contents = [
  { href: '#g3-history', label: 'Истоки: поместная церковь' },
  { href: '#g3-speakers', label: 'Темы и докладчики · 2013–2017' },
  { href: '#g3-year-2018', label: 'Заявление и дискуссия · 2018' },
  { href: '#g3-later-conferences', label: 'Следующие встречи · 2019–2024' },
  { href: '#g3-growth', label: 'За пределами конференции' },
  { href: '#g3-meaning', label: 'Значение богословских тем' },
  { href: '#g3-evidence', label: 'Что позволяют установить источники' },
  { href: '#history-bibliography', label: 'Библиография' },
  { href: '#g3-epilogue', label: 'Отдельная история кризисов' },
];
---
<JournalEditorialShell kind="dossier" backHref="/journal/">
<main class="dossier journal-dossier-shell je-history-article" id="main-content" tabindex="-1"
      data-g3-article="history" data-research-publication-status={draft.publicationStatus}>
  <aside class="je-review-note" aria-label="Статус локального просмотра">
    <strong>Не опубликовано · рукопись.</strong> Историческая статья проходит самостоятельную
    исследовательскую приёмку. Публикационный допуск не выдан; даты публикации не назначены.
  </aside>
  <JournalArticleHeader title={draft.title} label="История служения"
    series="G3 Ministries" period="2013–2024" cover={G3_EDITORIAL_MEDIA}
    readingTime={draft.readingTimeMinutesEstimate}>
    <p>Как конференция баптистской общины в Джорджии выросла в издательское
      и образовательное служение. Люди, темы выступлений и богословские дискуссии —
      история G3 до кризисов руководства.</p>
  </JournalArticleHeader>
  <div class="journal-feature-grid">
    <JournalEditorialRail label="Содержание истории G3">
      <JournalContents entries={contents} />
      <p class="je-rail-note">2013–2024 — период этой истории, не годы её публикации.{' '}
        <a href="#history-bibliography">{sources.length} источников</a>: каталоги записей,
        анонсы, письменные свидетельства и их ограничения.</p>
    </JournalEditorialRail>
    <div class="journal-story-column">
      <p class="reader-framing">Приглашение, запись выступления и содержание проповеди —
        разные предметы проверки. Участие в конференции не означает согласия со всеми
        последующими решениями её руководства. Воспоминание участника не заменяет
        независимые документы.</p>
      <G3HistoryFeature />
      <section id="g3-meaning" class="module" tabindex="-1" aria-labelledby="g3-meaning-title">
        <p class="module-label">06 · Значение</p>
        <div class="prose">
          <h2 id="g3-meaning-title">История богословских разговоров, а не только известных фамилий</h2>
          <p>Последовательность тем показывает направление программы. Церковь, авторитет
            Писания, учение о Троице, наследие Реформации, миссия и поклонение —
            эти вопросы связывали доктринальное исповедание с жизнью поместной общины.
            Конкретные выступления важнее общего списка приглашённых: именно они
            позволяют изучать содержание разговора, а не только масштаб афиши.</p>
          <p>Заявление 2018 года относится к другой стороне этой истории — дискуссии
            внутри более широкого евангельского движения. Это не программа очередной
            конференции. Присутствие на обсуждении не равно подписи под итоговым текстом,
            а участие в ранних собраниях не устанавливает позицию человека
            по всем позднейшим спорам G3.</p>
          <p>Последующие кризисы не делают прежние записи несуществующими и не объясняют
            их содержание задним числом. Но и известное имя докладчика само по себе
            не подтверждает правоту каждого решения организации. Для такой оценки
            нужны слова конкретного человека, определённая дата и отдельное доказательство.</p>
          <p class="source-note-paragraph"><a href={cite('gnl-2017')}>Записи конференций</a> · <a href={cite('statement-2018')}>Текст заявления 2018 года</a> · <a href={cite('challies')}>Взгляд участника</a></p>
        </div>
      </section>
      <section id="g3-evidence" class="module" tabindex="-1" aria-labelledby="g3-evidence-title">
        <p class="module-label">07 · Методика</p>
        <div class="prose">
          <h2 id="g3-evidence-title">Что позволяют установить источники</h2>
          <p>Каталоги GNL помогают сверить имена и названия записей по годам.
            Современные анонсы восстанавливают намерения организаторов.
            Письменные сообщения участников добавляют личную перспективу:
            Чаллис вспоминает первые годы, Аниол объявляет о своей должности и планах,
            Питерс рассказывает о собственном участии в октябре 2024-го.
            Эти источники дополняют, но не подменяют друг друга.</p>
          <p>Программа не доказывает, что заявленное выступление состоялось.
            Название записи не заменяет её просмотра, а личная оценка — независимого
            подтверждения. По выбранным каталогам нельзя построить полный ежегодный
            состав участников или точный ряд посещаемости. Поэтому здесь нет
            ни таких подсчётов, ни реконструкции чужих мотивов.</p>
          <p>Для точного содержания спорной проповеди нужен оригинальный звук или видео,
            а не автоматически полученная расшифровка. <a href={cite('buice-transcript-2025')}>Интервью Бьюса 2025 года</a>{' '}
            в этой редакционной волне не прослушано: текстовая копия не использована
            для точной датировки переезда или пересказа слов основателя.
            Иллюстрация в начале статьи — не фотография события.</p>
        </div>
      </section>
      <section id="history-bibliography" class="module" tabindex="-1" aria-labelledby="history-bibliography-title">
        <p class="module-label">08 · Библиография</p>
        <div class="prose">
          <h2 id="history-bibliography-title">Источники истории</h2>
          <p>У каждого документа — своя задача и предел доказательности.
            Прямые ссылки ведут к материалам их авторов и каталогам, а не к перепечаткам.
            Это библиография исторической рукописи; она не заменяет отдельный
            набор источников досье о кризисах.</p>
        </div>
        <ol class="bibliography-list">
          {sources.map((source) => <li id={`history-source-${source.id}`} class="bibliography-item" tabindex="-1"
            data-research-locator={source.researchLocator}>
            <p class="biblio-meta">{source.period} · {source.role}</p>
            <h3><a href={source.url} rel="noopener">{source.title}</a></h3>
            <p>{source.boundary}</p>
            <a class="je-source-return" href={source.returnHref}>Вернуться к месту в статье ↑</a>
          </li>)}
        </ol>
        <details class="research-disclosure">
          <summary>Статус исследовательской приёмки этой рукописи</summary>
          <p>Основание редакционного проекта — <a href={draft.researchPr} rel="noopener">Research #582</a>,
            снимок <code>93d6f08a40c7</code>. Это кандидат, не подписанный публикационный handoff.
            Все девять исторических проекций сохраняют <strong>PUBLICATION_HOLD</strong>.
            Внешние страницы и аудио в этой локальной волне заново не верифицированы;
            редактура опирается на записи Research и не повышает их статус.</p>
        </details>
      </section>
      <section id="g3-epilogue" class="module" tabindex="-1" aria-labelledby="g3-epilogue-title">
        <p class="module-label">09 · Продолжение</p>
        <div class="prose">
          <h2 id="g3-epilogue-title">Кризисы руководства — отдельная история</h2>
          <p>Конференции, книгоиздание и сотрудничество церквей предшествовали событиям
            2025–2026 годов. Поздние конфликты требуют собственной хронологии решений
            и документов конкретных участников. Их не следует объяснять только
            знакомыми фамилиями из программ прежних лет.</p>
        </div>
        <div class="je-next-story">
          <p>Документальное досье · 2025–2026</p>
          <a href="/journal/dossiers/g3/">G3 Ministries: два кризиса и завершение работы <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </div>
  </div>
  <footer class="dossier-footer author-card">
    <p><strong>Автор-редактор:</strong> Фёдор Милованов</p>
    <p>Локальная историческая рукопись. Публикация — только после нового подписанного Research-handoff.</p>
    <p><a href="/journal/">← Вернуться в Журнал</a></p>
  </footer>
</main>
</JournalEditorialShell>
