---
import JournalEditorialShell from './JournalEditorialShell.astro';
import JournalEditorialRail from './JournalEditorialRail.astro';
import JournalArticleOpening from './JournalArticleOpening.astro';
import JournalContents, { type ContentsEntry } from './JournalContents.astro';
import JournalBibliography from './JournalBibliography.astro';
import JournalSeriesNav from './JournalSeriesNav.astro';
import { G3_EDITORIAL_COVER, G3_EDITORIAL_SERIES } from '@/data/journal/g3EditorialPresentation';
import G3HistoryFeature from './G3HistoryFeature.astro';
import './g3History.css';
import { G3_HISTORY_DRAFT_METADATA as draft } from '@/data/journal/g3HistoryDraftMetadata';
import { G3_HISTORY_BIBLIOGRAPHY } from '@/data/journal/g3HistoryBibliography';

/**
 * Fail-closed production guard. This file is a source-only manuscript:
 * a public Astro route must NOT import it without new signed Research handoff.
 * Remove this guard only as part of explicit publication authorization.
 */
if (import.meta.env.PROD) {
  throw new Error('G3 history PUBLICATION_HOLD: signed Research→Product handoff required before production routing');
}

const contents = [
  { href: '#g3-history', label: 'Истоки и поместная церковь' },
  { href: '#g3-speakers', label: 'Люди, темы и конференции' },
  { href: '#g3-growth', label: 'От встречи к служению' },
  { href: '#g3-meaning', label: 'Богословский разговор' },
  { href: '#g3-evidence', label: 'Источники и их границы' },
  { href: '#g3-epilogue', label: 'Продолжение истории' },
] satisfies readonly ContentsEntry[];
---
<JournalEditorialShell kind="dossier" backHref="/journal/">
<main class="dossier journal-dossier-shell je-history-article" id="main-content" tabindex="-1"
      data-g3-article="history" data-research-publication-status={draft.publicationStatus}>
  <p class="je-draft-notice" role="note">Редакционная рукопись · публикационный допуск не выдан. Этот макет не является опубликованной статьёй.</p>
  <JournalArticleOpening
    subject="G3 Ministries"
    cover={G3_EDITORIAL_COVER}
    title={draft.title}
    label="Исторический очерк"
    scope="2013–2024"
    readingMinutes={draft.readingTimeMinutesEstimate}
    noteTitle="От одной встречи к нескольким проектам"
    textAnchor="#g3-history"
    sourcesAnchor="#g3-evidence"
    sourceCount={G3_HISTORY_BIBLIOGRAPHY.length}
  >
    <p slot="lead">
      Сначала — баптистская церковь в Джорджии и конференция о Евангелии.
      Затем — собрания о Писании, Троице, Реформации, миссии и поклонении,
      известные проповедники и новые издательские проекты.
      Как развивалось G3 и что сохранили программы, записи и воспоминания участников?
    </p>
    <span slot="dates">Исторический период · 2013–2024</span>
    <p slot="framing">
      История складывается из разных свидетельств. Анонс показывает замысел,
      каталог — запись с определённым названием, воспоминание — взгляд участника.
      Ни один из этих источников не заменяет все остальные.
    </p>
  </JournalArticleOpening>
  <JournalContents id="g3-history-contents" entries={contents} />
  <div class="journal-feature-grid">
    <div class="journal-story-column">
      <G3HistoryFeature />
      <section id="g3-meaning" class="module je-history-essay" aria-labelledby="g3-meaning-title">
        <div class="module-label">04 · Богословский разговор</div>
        <div class="prose">
          <h2 id="g3-meaning-title">Больше, чем список известных имён</h2>
          <p>Известность приглашённых легко заслоняет предмет самой встречи. Между тем последовательность тем — Евангелие, Церковь, Писание, Троица, Реформация, миссия, поклонение — показывает, какие вопросы организаторы выносили в центр программы. Это позволяет описать богословскую направленность конференций, не приписывая каждому выступавшему согласие со всеми взглядами G3.</p>
          <p>В этой истории у разных людей разные роли. Джош Бьюс выступает как инициатор и руководитель, община Pray’s Mill — как принимающая церковь ранних встреч, приглашённые проповедники — как участники определённых программ. Известное имя в архиве не является ни подписью под каждым последующим решением, ни свидетельством членства в руководстве.</p>
          <p>Дискуссия 2018 года расширила круг вопросов: теперь спорили не только о темах докладов, но и о том, как связаны Евангелие, общественная справедливость и сотрудничество между христианами. Составители заявления объясняли его необходимостью защитить библейское вероучение. Чаллис, присутствовавший при обсуждении и отказавшийся подписать текст, иначе оценивал его роль в отношениях внутри движения. Его воспоминание важно сохранить именно как свидетельство участника, а не превратить в универсальное объяснение всех перемен.</p>
          <p>Увидеть ранние конференции только через последующие конфликты — значит потерять их собственную историю. Но и каталог богословских тем не отвечает на вопросы о том, как впоследствии принимались управленческие решения. Для этого нужны другие документы и другая хронология.</p>
          <p class="source-note-paragraph"><a class="source-note" href="#hist-src-challies">Свидетельство Чаллиса и границы его ретроспективной оценки</a></p>
        </div>
      </section>
      <section id="g3-evidence" class="module je-history-essay" aria-labelledby="g3-evidence-title">
        <div class="module-label">05 · Источники и сверка</div>
        <div class="prose">
          <h2 id="g3-evidence-title">Как читать сохранившиеся свидетельства</h2>
          <p>Не все упоминания конференции доказывают одно и то же. Ниже различены рекламная программа, каталог записи, слова выступавшего и воспоминания участников. Точные цитаты из аудио здесь не приводятся: прочитанные названия сессий не означают, что сами записи были прослушаны.</p>
          <dl class="je-evidence-key">
            <div><dt>Анонс</dt><dd>Кого и какую тему объявили. Не удостоверяет прибытие всех приглашённых.</dd></div>
            <div><dt>Каталог записи</dt><dd>Как платформа обозначает сессию и докладчика. Не заменяет проверку звука.</dd></div>
            <div><dt>Содержание выступления</dt><dd>Требует самой записи, проверенного контекста и точного таймкода.</dd></div>
            <div><dt>Воспоминание</dt><dd>Позволяет услышать участника; его оценка не становится протоколом организации.</dd></div>
            <div><dt>Независимая сверка</dt><dd>Другой источник проверяет конкретный факт, а не просто повторяет ту же публикацию.</dd></div>
          </dl>
          <p>Старые адреса программ G3 не следует считать действующим архивом только потому, что они открываются: содержание сайта может измениться. Поэтому у исторического очерка собственная библиография с указанием того, какую именно часть рассказа поддерживает каждый источник.</p>
          <details class="bibliography-details" open>
            <summary>Источники исторического очерка · {G3_HISTORY_BIBLIOGRAPHY.length}</summary>
            <JournalBibliography entries={G3_HISTORY_BIBLIOGRAPHY} />
          </details>
        </div>
      </section>
      <section id="g3-epilogue" class="module je-history-essay" aria-labelledby="g3-epilogue-title">
        <div class="module-label">06 · Что было дальше</div>
        <div class="prose">
          <h2 id="g3-epilogue-title">История движения и история его кризисов</h2>
          <p>К 2024 году за названием G3 стояла уже не только память о первой церковной конференции, но и несколько форм работы: собрания, книги, цифровые материалы, сотрудничество общин. У каждого направления были собственные задачи; их нельзя свести ни к популярности одного проповедника, ни к одной дате завершения работы.</p>
          <p>Следующий материал серии посвящён событиям 2025–2026 годов: отставкам, заявлениям руководства, финансовым декларациям и вопросам о дальнейшей судьбе проектов. Он не заменяет историю конференций и не выводит кризисы из неё как неизбежный итог.</p>
          <p><a class="source-note" href="/journal/dossiers/g3/">Читать документальное досье о кризисах G3 →</a></p>
        </div>
      </section>
    </div>
    <JournalEditorialRail label="Повторные указатели к этапам истории G3">
      <section class="je-rail-group" aria-labelledby="g3-history-rail">
        <p class="je-rail-kicker">Вехи истории</p>
        <h2 id="g3-history-rail">Люди и события</h2>
        <ol class="je-rail-timeline">
          <li><a href="#g3-history"><time datetime="2013">2013</time><span>Первая встреча при Pray’s Mill</span></a></li>
          <li><a href="#g3-year-2017"><time datetime="2017">2017</time><span>Пятисотлетие Реформации</span></a></li>
          <li><a href="#g3-year-2018"><time datetime="2018">2018</time><span>Богословское заявление и дискуссия</span></a></li>
          <li><a href="#g3-growth"><span>После конференций</span><span>Издательские и церковные проекты</span></a></li>
          <li><a href="#g3-year-2024"><time datetime="2024">2024</time><span>Региональные и тематические встречи</span></a></li>
        </ol>
      </section>
      <section class="je-rail-group" aria-labelledby="g3-history-rail-sources">
        <p class="je-rail-kicker">Проверка</p>
        <h2 id="g3-history-rail-sources">Свидетельства</h2>
        <ul class="je-rail-links">
          <li><a href="#g3-evidence">Библиография и границы источников</a></li>
          <li><a href="/journal/dossiers/g3/">Продолжение: кризисы G3</a></li>
        </ul>
      </section>
    </JournalEditorialRail>
  </div>
  <JournalSeriesNav {...G3_EDITORIAL_SERIES} currentId="history" />
  <footer class="author-card dossier-footer">
    <p><strong>Автор-редактор:</strong> Фёдор Милованов</p>
    <p><strong>Статус:</strong> рукопись. Нужен новый Research-handoff перед публикацией.</p>
    <p><a href="/journal/">← Вернуться в Журнал</a> <span aria-hidden="true">·</span> <a href="#main-content">К началу рукописи ↑</a></p>
  </footer>
</main>
</JournalEditorialShell>
