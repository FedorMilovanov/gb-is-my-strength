---
/** Resource hints only; existing fonts/fonts.css remains the font-definition owner. */
interface Props { catalogUi?: boolean }
// Only the catalog needs the semibold UI face before the first paint; do not
// change the other editions' existing four hints or request priorities.
const { catalogUi = false } = Astro.props;
---
<link rel="preload" as="font" type="font/woff2" href="/fonts/PlayfairDisplay/playfairdisplay-cyrillic-600.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/Lora/lora-cyrillic-400.woff2" crossorigin />
<!-- Metadata mixes Cyrillic words with Latin-range dates/digits; preload both. -->
<link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3/sourcesans3-cyrillic-400.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3/sourcesans3-latin-400.woff2" crossorigin />
{catalogUi && <link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3/sourcesans3-cyrillic-600.woff2" crossorigin />}
