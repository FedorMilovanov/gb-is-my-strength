---
import JournalEditorialShell from './JournalEditorialShell.astro';
import JournalEditorialRail from './JournalEditorialRail.astro';
import JournalArticleHeader from './JournalArticleHeader.astro';
import JournalContents from './JournalContents.astro';
import G3ExpenseWaterfall from './g3-graphics/G3ExpenseWaterfall.astro';
import G3EcosystemSpread from './g3-graphics/G3EcosystemSpread.astro';
import G3AnnualFinance from './g3-visual/G3AnnualFinance.astro';
import { adoptedAnnualFinance } from './g3-visual/adopted-visual-inputs';
import JournalSourceReturn from './JournalSourceReturn.astro';
import { G3_EDITORIAL_MEDIA as cover } from '@/data/journal/g3EditorialMedia';
import { G3_PRODUCT_METADATA } from '@/data/journal/g3ProductMetadata';
import {
  G3_PUBLICATION_HANDOFF,
  assertG3PublicationProjection,
  type G3PublicationClaimId,
} from '@/data/journal/g3PublicationHandoff';
import { G3_SOURCE_BIBLIOGRAPHY, type G3SourceBibliographyEntry } from '@/data/journal/g3SourceBibliography';

const coverSizes = '(min-width: 1024px) 600px, (min-width: 768px) 700px, calc(100vw - 40px)';

const projectedClaims: G3PublicationClaimId[] = [
  'G3-PUB-001', 'G3-PUB-002', 'G3-PUB-003', 'G3-PUB-004',
  'G3-PUB-005', 'G3-PUB-006', 'G3-PUB-007', 'G3-PUB-008',
  'G3-PUB-009', 'G3-PUB-010', 'G3-PUB-011', 'G3-PUB-012',
  'G3-PUB-013', 'G3-PUB-014', 'G3-PUB-016',
];
projectedClaims.forEach(assertG3PublicationProjection);

const corrections: Array<{
  correctedAt: string;
  scope: string;
  previousMeaning: string;
  newMeaning: string;
  reason: string;
  researchSnapshot: string;
}> = [{
  // Actual dated editorial withdrawal, independent of build and publication timestamps.
  correctedAt: '2026-11-21T00:00:00+03:00',
  scope: '§07 · Пример из издательской истории',
  previousMeaning: 'Отдельный книжный пример мог восприниматься как подтверждение нового издания после возврата прав.',
  newMeaning: 'Из §07 отозван пример с книгой Дэйва Дженкинса «The Word Matters». Его прежняя формулировка могла восприниматься как подтверждение нового издания после возврата прав. Наличие книжной карточки не доказывает ни такого переиздания, ни юридического перехода прав; новый вывод взамен отозванного не сделан.',
  reason: 'Прежняя формулировка допускала более сильный вывод, чем позволяют доступные свидетельства.',
  researchSnapshot: G3_PUBLICATION_HANDOFF.researchSealCommit,
}];

const contents = [
  { href: '#overview', label: 'Как G3 пришла к двум кризисам' },
  { href: '#timeline', label: 'Хронология решений' },
  { href: '#finance', label: 'Что показывают финансы' },
  { href: '#governance', label: 'Совет и руководство' },
  { href: '#buice', label: 'Джош Бьюс · 2025' },
  { href: '#buck', label: 'Том Бак · 2026' },
  { href: '#wind-down', label: 'Что именно завершилось' },
  { href: '#unknowns', label: 'Открытые вопросы' },
  { href: '#documents', label: 'Как проверены документы' },
  { href: '#bibliography', label: 'Источники и сверка' },
  { href: '#corrections', label: 'Исправления' },
];
// Same pinned G3-PUB-002 numbers feed both prose and the visual comparison.
const financeDeltas = [
  { label: 'Общее увеличение расходов', value: 1061800 },
  { label: 'Конференции и встречи', value: 817283 },
  { label: 'Реклама', value: 246511 },
];
const formatNumber = (value: number) => new Intl.NumberFormat('ru-RU').format(value);
// Reader-facing genres, not a second evidence scale or a tier → verdict map.
// Exact Research classes/eligibility stay on the pinned bibliography objects.
const sourceRoles: Record<string, string> = {
  'G3-S001': 'Государственный реестр', 'G3-S002': 'Налоговые декларации',
  'G3-S008': 'Заявление организации', 'G3-S009': 'Сообщение организации',
  'G3-S010': 'Объявление о назначении', 'G3-S011': 'Регистрация мероприятия',
  'G3-S012': 'Авторский разбор', 'G3-S015': 'Заявление участников',
  'G3-S017': 'Журналистское сообщение', 'G3-S023': 'Кадровое сообщение',
  'G3-S024': 'Программная страница', 'G3-S028': 'Архив налоговых документов',
  'G3-S033': 'Листинг магазина приложений', 'G3-S035': 'Вторичный разбор',
  'G3-S042': 'Перепечатки одного письма', 'G3-S046': 'Страница мероприятия',
  'G3-S047': 'Страницы участников', 'G3-S050': 'Метаданные приложения',
  'G3-S053': 'Снимок книжной витрины', 'G3-S054': 'Издательские страницы',
  'G3-S096': 'Архивная страница организации',
};
// Honest native fallback for a fresh source visit. The shared adapter can
// still replace it with the exact citation actually activated in this tab.
const sourceSection: Record<string, `#${string}`> = {
  'G3-S001': '#timeline',
  'G3-S002': '#finance',
  'G3-S028': '#finance',
  'G3-S008': '#buice',
  'G3-S009': '#buice',
  'G3-S010': '#buice',
  'G3-S023': '#buice',
  'G3-S024': '#buice',
  'G3-S012': '#buck',
  'G3-S015': '#buck',
  'G3-S035': '#buck',
  'G3-S042': '#buck',
  'G3-S011': '#wind-down',
  'G3-S017': '#wind-down',
  'G3-S033': '#wind-down',
  'G3-S050': '#wind-down',
  'G3-S053': '#wind-down',
  'G3-S046': '#governance',
  'G3-S047': '#governance',
  'G3-S096': '#governance',
  'G3-S054': '#documents',
};
const sourcePortalLabels: Record<string, string> = {
  'G3-S001': 'Реестр штата Джорджия: поиск организаций',
  'G3-S002': 'IRS: архив электронных деклараций Form 990',
  'G3-S028': 'IRS: архив электронных деклараций Form 990',
};
// Reader navigation projection only; these links do not change evidence eligibility.
// S015 and S042 are renderings of one statement, not independent witnesses.
// The original blog and archived statement were acquired in Research; their
// current transport was unavailable in the 24 November link recheck.
const readerSourceLinks: Record<string, { href: string; label: string }> = {
  'G3-S002': { href: 'https://projects.propublica.org/nonprofits/organizations/842403597', label: 'Декларации этой организации · ProPublica (данные IRS)' },
  'G3-S008': { href: 'https://web.archive.org/web/20250512232856id_/https://g3min.org/statement-regarding-josh-buice/', label: 'Архив заявления от 12 мая 2025 года (доступ может быть ограничен)' },
  'G3-S012': { href: 'https://teampyro.blogspot.com/2026/08/hamans-gallows.html', label: 'Авторская статья Фила Джонсона (доступ может быть ограничен)' },
  'G3-S015': { href: 'https://www.christianpost.com/news/g3-church-network-shuts-down-after-leaders-apologize-report.html', label: 'Сообщение Christian Post с фрагментами заявления от 25 августа' },
  'G3-S017': { href: 'https://ministrywatch.com/g3-ministries-closes-amid-anonymous-smear-campaign/', label: 'MinistryWatch · публикация от 27 августа 2026 года' },
  'G3-S035': { href: 'https://protestia.com/2026/08/17/g3-promised-cooperative-not-competitive-the-anonymous-targeting-continued/4/', label: 'Protestia · раздел о проверке проповедей и ответе церкви' },
  'G3-S042': { href: 'https://www.christianpost.com/news/g3-church-network-shuts-down-after-leaders-apologize-report.html', label: 'Christian Post · публикация от 26 августа 2026 года' },
};
// Reader display only: pinned source objects, provenance and evidence stay intact.
// Keep document identifiers; omit internal acquisition/storage workflow prose.
const sourceReaderView = (entry: G3SourceBibliographyEntry) => {
  let { title, locator } = entry;
  let period: string | null = entry.period;
  switch (entry.id) {
    case 'G3-S002':
      locator = locator.replace('; raw SHA зафиксированы в ledger.', '.');
      break;
    case 'G3-S008':
      locator = locator.replace('; объект и формулировки зафиксированы в Research-досье.', '.');
      break;
    case 'G3-S011':
      title = title.replace(' / event backend', '');
      locator = 'Снимок страницы отмены конференции на официальном сайте, 2026 год.';
      break;
    case 'G3-S015':
      title = 'Заявление четырёх пасторов Pray’s Mill: Скотт Аниол, Джон Нортон, Дилан Джойнер и Мэтт Сайкс';
      locator = 'Заявление от 25 августа 2026 года известно по опубликованным воспроизведениям. Здесь приведён его пересказ.';
      break;
    case 'G3-S017':
      period = '2026-08-27';
      locator = 'Дата публикации материала Джессики Этюрралд в MinistryWatch, а не установленная дата первого объявления G3.';
      break;
    case 'G3-S028':
      title = title.replace(' + exact-head acquisition', '');
      period = null; // An acquisition route is not a document date.
      locator = 'Официальный архив электронных деклараций IRS Form 990; FY2025.';
      break;
    case 'G3-S096':
      locator = locator
        .replace('Raw archived payload SHA ', 'Префиксы SHA: архивное содержимое до декодирования — ')
        .replace(', decoded HTML SHA ', '; декодированный HTML — ')
        .replace('; roster из шести имён датирован снимком.', '. Список из шести имён датирован снимком.');
      break;
  }
  return { title, period, locator };
};
---
<JournalEditorialShell kind="dossier" backHref="/journal/">
<main class="dossier journal-dossier-shell" id="main-content" tabindex="-1" data-journal-source-navigation data-journal-dossier="g3" data-reader-range data-research-seal={G3_PUBLICATION_HANDOFF.researchSealCommit}>
  <JournalArticleHeader
    title={G3_PRODUCT_METADATA.title}
    label="Документальное досье" series="G3 Ministries" period="2025–2026"
    readingTime={G3_PRODUCT_METADATA.readingTimeMinutes} narration
    publishedAt={G3_PRODUCT_METADATA.publishedAt} modifiedAt={G3_PRODUCT_METADATA.modifiedAt}
  >
    <p>Отставка основателя, попытка обновления и новый конфликт.
      Что документы говорят о руководстве, финансах и завершении работы служения —
      и где заканчиваются доказательства.</p>
  </JournalArticleHeader>
  <div class="journal-feature-grid journal-feature-grid--text-first">
    <div class="journal-opening-column">
  <section id="overview" class="module intro-module" tabindex="-1">
    <div class="module-label je-opening-label">
      <span>01 · Предыстория</span>
      <a class="je-contents-jump" href="#journal-g3-toc" data-pagefind-ignore>Содержание · {contents.length} разделов</a>
    </div>
    <div class="prose wide">
      <h2>Как G3 пришла к двум кризисам</h2>
      <p class="standfirst">
        История G3 не сводится к одной дате закрытия. Организация, известная конференциями
        и издательскими проектами, сначала столкнулась с уходом своего основателя,
        затем попыталась продолжить работу с новым руководством — и вскоре оказалась
        перед следующим конфликтом.
      </p>
      <figure class="je-article-cover je-article-cover--intro">
        <picture>
          <source type="image/avif" srcset={cover.avifSrcset} sizes={coverSizes} />
          <img src={cover.src} srcset={cover.webpSrcset} sizes={coverSizes}
               width={cover.width} height={cover.height} alt={cover.alt}
               decoding="async" loading="eager" fetchpriority="high" />
        </picture>
        <figcaption><span>G3 Ministries</span> {cover.caption}</figcaption>
      </figure>
      <p>
        В 2019 году G3 Ministries была оформлена в штате Джорджия как некоммерческая корпорация.
        Позднее деятельность включала конференции, цифровую платформу G3+, издательское направление G3 Press
        и сеть церквей. Для читателя важно различать эти части: завершение конференций
        не обязательно означает, что все книги, цифровые продукты и юридические права
        прекратили существование в один день.
      </p>
      <p>
        В мае 2025 года G3 сама сообщила об анонимной деятельности её руководителя Джоша Бьюса
        и принятии его отставки. Организация объявила о кадровых и программных изменениях,
        пытаясь продолжить служение. В августе–сентябре 2026 года последовал новый кризис,
        после которого было объявлено о завершении ряда направлений и операций.
      </p>
      <p>
        Проверка документов позволяет восстановить последовательность решений, но не позволяет
        автоматически установить чужие мотивы, юридическую судьбу всех активов
        или виновность участников каждого конфликта.
      </p>
      <p class="source-note-paragraph" data-publication-claims="G3-PUB-001 G3-PUB-005 G3-PUB-006 G3-PUB-007 G3-PUB-012 G3-PUB-013 G3-PUB-014 G3-PUB-016"><a class="source-note" href="#documents">Документы, на которых основан рассказ</a></p>
    </div>
  </section>

      <p class="reader-framing">Здесь мы восстанавливаем события, а не выносим приговор людям.
        Заявление стороны, финансовая форма и юридическое решение — разные свидетельства.
        Документальная база ограничена срезом 9 сентября 2026 года; позднейшие изменения
        требуют отдельной проверки.</p>
    </div>
    <JournalEditorialRail label="Содержание документального досье G3">
      <JournalContents entries={contents} summaryId="journal-g3-toc" initialCompactClosed returnHref="#overview" />
      <p class="je-rail-note">Фактический срез — 9 сентября 2026 года.{' '}
        <a href="#bibliography" tabindex="0">{G3_SOURCE_BIBLIOGRAPHY.length} источник</a>.{' '}
        <a href="#corrections" tabindex="0">Журнал исправлений</a>.</p>
    </JournalEditorialRail>
    <div class="journal-story-column">
  <section id="timeline" class="module" tabindex="-1">
    <div class="module-label">02 · Хронология</div>
    <div class="prose">
      <h2>Главные события по годам</h2>
      <p>После предыстории легче увидеть, как кризис руководства 2025 года связан с событиями 2026-го. Здесь перечислены только даты, подтверждённые доступными документами; вопросы, остающиеся спорными, обсуждаются отдельно.</p>
    </div>
    <ol class="timeline">
      <li>
        <time datetime="2019-06-06">6 июня 2019</time>
        <div><h3>Юридическое оформление</h3><p>G3 Ministries for the Church, Inc. зарегистрирована в штате Джорджия как некоммерческая корпорация.</p><a id="cite-timeline-G3-S001" data-journal-citation class="claim-ref" href="#src-G3-S001" data-publication-claims="G3-PUB-001">Реестр штата Джорджия</a></div>
      </li>
      <li>
        <time datetime="2025-05-08">8–12 мая 2025</time>
        <div><h3>Кризис Джоша Бьюса</h3><p>По заявлению G3, отставка Buice с поста президента была принята 8 мая; 12 мая организация публично рассказала об анонимных интернет-аккаунтах руководителя, разговоре с ним, признании и отставке. Конференция 2025 года была отменена.</p><a id="cite-timeline-G3-S008" data-journal-citation class="claim-ref" href="#src-G3-S008" data-publication-claims="G3-PUB-005 G3-PUB-006">Заявление G3, 12 мая 2025 года</a></div>
      </li>
      <li>
        <time datetime="2025-07-09">9 июля 2025</time>
        <div><h3>Скотт Аниол становится президентом</h3><p>Согласно официальному объявлению G3, Скотт Аниол вступил в должность 9 июля 2025 года.</p><a id="cite-timeline-G3-S010" data-journal-citation class="claim-ref" href="#src-G3-S010" data-publication-claims="G3-PUB-006">Объявление о назначении</a></div>
      </li>
      <li>
        <time datetime="2026-07-21">21 июля 2026</time>
        <div><h3>Подтверждённый архивом состав совета</h3><p>Архивный снимок официальной страницы «Who We Are» перечисляет Buck Braswell, Matt Broome, Jon Norton, Matt Sikes, Dylan Joyner и Ron Mooney как членов совета директоров.</p><a id="cite-timeline-G3-S096" data-journal-citation class="claim-ref" href="#src-G3-S096" data-publication-claims="G3-PUB-008">Архив официальной страницы</a></div>
      </li>
      <li>
        <time datetime="2026-08">август 2026</time>
        <div><h3>Новый конфликт и признание процессуальных ошибок</h3><p>В сохранившемся заявлении четыре пастора признали ошибки: вмешательство во внутреннее дисциплинарное дело другой церкви, суждения без полного понимания обстоятельств и анонимную рассылку материалов третьим лицам.</p><a id="cite-timeline-G3-S015" data-journal-citation class="claim-ref" href="#src-G3-S015" data-publication-claims="G3-PUB-011">Сохранившееся заявление пасторов</a></div>
      </li>
      <li>
        <time datetime="2026-08">конец августа 2026</time>
        <div><h3>Объявление о завершении работы</h3><p>G3 объявила о завершении церковной сети и более широкой деятельности. Регистрация на конференцию 27–29 мая 2027 года сообщала об отмене мероприятия и возврате взносов.</p><a id="cite-timeline-G3-S017" data-journal-citation class="claim-ref" href="#src-G3-S017" data-publication-claims="G3-PUB-012">MinistryWatch · сообщение от 27 августа</a><a id="cite-timeline-G3-S011" data-journal-citation class="claim-ref" href="#src-G3-S011" data-publication-claims="G3-PUB-012">Отмена конференции 2027 года</a></div>
      </li>
    </ol>
  </section>

  <section id="finance" class="module" tabindex="-1">
    <div class="module-label">03 · Финансы</div>
    <div class="prose">
      <h2>Что изменилось в расходах G3</h2>
      <p>
        Финансовая история началась ещё до громких конфликтов 2025–2026 годов.
        По сведениям из налоговых деклараций американской некоммерческой организации
        общие расходы G3 за 2023 финансовый год оказались на <strong>{formatNumber(financeDeltas[0].value)} долларов</strong>{' '}
        выше, чем за предыдущий год. Наибольший вклад в этот рост внесли
        затраты на конференции и встречи — плюс <strong>{formatNumber(financeDeltas[1].value)} доллара</strong> —
        и рекламу — плюс <strong>{formatNumber(financeDeltas[2].value)} долларов</strong>.
      </p>
      <p>
        В той же форме расходы 2023 года были полностью отнесены к программной деятельности:
        на административные нужды и сбор пожертвований организация отразила нулевые суммы.
        Это то, <strong>как G3 классифицировала затраты в поданной декларации</strong>,
        а не заключение внешнего аудитора об их разумности или отсутствии нарушений.
      </p>
      <p>
        За 2024 год организация сообщила в декларации об отсутствии существенного
        отвлечения активов и наличии политики урегулирования конфликтов интересов;
        отдельные политики защиты информаторов и хранения документов в форме не были заявлены.
        Такие ответы показывают раскрытые самой организацией управленческие процедуры,
        но не доказывают, что проблемы отсутствовали или, наоборот, существовали.
      </p>
      <p>
        Декларации за 2024 и 2025 годы также раскрывают выплаты Карис Бьюс —{' '}
        <strong>30 409</strong> и <strong>31 880 долларов</strong> соответственно.
        Форма обозначает её дочерью члена совета. Эта запись требует прозрачного
        упоминания, но сама по себе не позволяет сделать вывод о незаконной выплате
        или определить личность родителя только по фамилии.
      </p>
      <p class="source-note-paragraph" data-publication-claims="G3-PUB-002 G3-PUB-003 G3-PUB-004"><a id="cite-finance-G3-S002" data-journal-citation class="source-note" href="#src-G3-S002">Налоговые формы IRS, финансовые годы 2022–2025</a></p>
    </div>
    <G3AnnualFinance projection={adoptedAnnualFinance()} />
    <G3ExpenseWaterfall total={financeDeltas[0].value} conferences={financeDeltas[1].value} advertising={financeDeltas[2].value} />
  </section>

  <section id="governance" class="module" tabindex="-1">
    <div class="module-label">04 · Управление</div>
    <div class="prose">
      <h2>Почему важны люди, входившие в руководство</h2>
      <p>
        Перед событиями 2026 года G3 и баптистская церковь Pray’s Mill были тесно
        связаны через конкретных служителей: некоторые пасторы одновременно преподавали
        в проектах G3, участвовали в её церковной сети или входили в совет организации.
        Это объясняет, почему кризис одного служения затронул и другое.
      </p>
      <p>
        Однако пересечение обязанностей не устанавливает ни юридического подчинения одной
        организации другой, ни общего намерения участников. Для вопроса о полномочиях
        нужны устав, состав совета на конкретную дату и решения самого совета.
      </p>
      <p>
        Последний подтверждённый архивный список совета относится к <strong>21 июля 2026 года</strong>.
        Мы не переносим автоматически этот состав на конец августа, когда происходили
        события кризиса: необходимые документы за этот промежуток пока не получены.
      </p>
      <p class="source-note-paragraph" data-publication-claims="G3-PUB-008 G3-PUB-009 G3-PUB-016"><a id="cite-governance-G3-S096" data-journal-citation class="source-note" href="#src-G3-S096">Архивная страница совета, 21 июля 2026 года</a></p>
    </div>
  </section>

  <section id="buice" class="module" tabindex="-1">
    <div class="module-label">05 · Кризис 2025</div>
    <div class="prose">
      <h2>Уход Джоша Бьюса и попытка продолжить работу</h2>
      <p data-publication-claims="G3-PUB-018">Согласно заявлению совета G3 от 12 мая 2025 года, 4 мая пресвитеры Pray’s Mill предъявили Джошу Бьюсу доказательства связи с анонимными аккаунтами. После первоначального отрицания он признал своё участие. 8 мая совет единогласно принял его отставку с должности президента. В опубликованном 12 мая заявлении G3 объявила об отмене ближайшей национальной конференции и всех практикумов 2025 года и пообещала полностью вернуть регистрационные взносы.</p>
      <p>
        Важно сохранить источник утверждения: сведения о признании и обстоятельствах
        отставки в этой части исходят из заявления самой G3. Нельзя выдавать его
        за независимое расследование, которое проверило каждую деталь.
      </p>
      <p>
        Новый этап руководство связывало с изменением приоритетов и обновлением работы
        организации. Президентом G3 с <strong>9 июля 2025 года</strong> стал Скотт Аниол.
        Следовательно, корректнее говорить о <strong>попытке продолжить и перестроить служение</strong>,
        а не утверждать, что реформа обязательно оказалась успешной.
      </p>
      <p class="source-note-paragraph" data-publication-claims="G3-PUB-005 G3-PUB-006 G3-PUB-007"><a id="cite-buice-G3-S008" data-journal-citation class="source-note" href="#src-G3-S008">Официальные заявления G3 и даты назначений</a></p>
    </div>
  </section>

  <section id="buck" class="module sensitive-module" tabindex="-1">
    <div class="module-label">06 · Кризис 2026</div>
    <div class="prose">
      <h2>Спор о проповедях Тома Бака и последствия анонимной рассылки</h2>
      <p>
        Новый конфликт связан с проповедями пастора Тома Бака и тем, каким образом
        отдельные фрагменты его проповедей соотносились с уже опубликованными
        богословскими комментариями. Для оценки этого вопроса нужно различать
        недостаточную ссылку на использованный источник и гораздо более серьёзное
        обвинение в проповеди чужих готовых текстов целиком.
      </p>
      <p>
        Доступная проверка обнаружила случаи недостаточно ясного указания на
        формулировки из комментариев. Но опубликованные материалы <strong>не дают
        оснований утверждать</strong>, что Бак систематически произносил
        полностью написанные другими авторами проповеди. Его церковь в Линдейле
        проводила рассмотрение и предпринимала исправительные действия;
        это не означает, что все отдельные эпизоды уже получили окончательную оценку.
      </p>
      <p>
        Вторая сторона истории — способ распространения обвинительных материалов.
        В сохранившемся заявлении четыре служителя, связанные с Pray’s Mill и G3,
        признали ошибки: вмешательство во внутрицерковную процедуру другой общины,
        оценку ситуации без всех необходимых сведений и анонимную отправку материалов
        третьим лицам. Мы передаём это как содержание их заявления, а не как
        независимое установление мотивов каждого участника.
      </p>
      <p>
        Из доступных сведений невозможно уверенно заключить, все ли последующие
        отставки были добровольными. Также нельзя назвать проверенное количество
        случаев плагиата: для каждого спорного места необходимо прослушать
        оригинальную запись проповеди, установить издание использованного комментария
        и проверить контекст ссылки на автора.
      </p>
      <p class="source-note-paragraph" data-publication-claims="G3-PUB-010 G3-PUB-011 G3-PUB-016"><a id="cite-buck-G3-S012" data-journal-citation class="source-note" href="#src-G3-S012">Разбор Фила Джонсона</a><a id="cite-buck-G3-S035" data-journal-citation class="source-note" href="#src-G3-S035">Проверка Protestia и сведения о рассмотрении в Линдейле</a><a id="cite-buck-G3-S015" data-journal-citation class="source-note" href="#src-G3-S015">Сохранившееся заявление четырёх пасторов</a></p>
    </div>
  </section>

  <section id="wind-down" class="module" tabindex="-1">
    <div class="module-label">07 · Что завершилось</div>
    <div class="prose">
      <h2>Что означает объявление о завершении деятельности G3</h2>
      <p>
        После кризиса 2026 года было объявлено о завершении церковной сети G3 Church Network
        и сворачивании более широкой деятельности организации. Отдельно на сайте
        регистрации будущей конференции появилось сообщение об отмене мероприятия,
        намеченного на <strong>27–29 мая 2027 года</strong>, и возврате регистрационных взносов.
      </p>
      <p>
        Но для истории организации это не одна дата с единственным смыслом.{' '}
        <strong>Прекратить мероприятия</strong> — не то же самое, что{' '}
        <strong>юридически ликвидировать корпорацию</strong>.
        В доступной записи штата Джорджия на <strong>8 сентября 2026 года</strong>{' '}
        юридическое лицо всё ещё числилось действующим. Это снимок реестра
        на указанную дату, а не обещание, что статус сохранился навсегда.
      </p>
      <p>
        После объявленного завершения работы цифровые витрины G3+ и G3 Press
        всё ещё были доступны под брендом организации. Такая доступность
        показывает лишь состояние сайтов и магазинов: она не позволяет
        определить нового владельца, условия сделки или юридический
        переход прав на книги и сервисы.
      </p>
      <p class="source-note-paragraph" data-publication-claims="G3-PUB-001 G3-PUB-012 G3-PUB-013 G3-PUB-014 G3-PUB-016"><a class="source-note" href="#bibliography">Решения организаций, реестры и цифровые записи</a></p>
    </div>
    <G3EcosystemSpread />
  </section>

  <section id="unknowns" class="module unknown-module" tabindex="-1">
    <div class="module-label">08 · Открытые вопросы</div>
    <div class="prose">
      <h2>Какие вопросы пока остаются без ответа</h2>
      <p>
        Исследование не смогло восстановить по публичным документам все обстоятельства
        передачи активов и изменения руководства. Это не досадные пустоты,
        которые можно заполнить догадкой, а граница доступных доказательств.
      </p>
      <p>
        В частности, неизвестны точный состав совета G3 в самые поздние дни кризиса,
        юридические подробности передачи G3+ и издательских прав, а также полный
        документальный путь отдельной операции с недвижимостью и связанными
        с ней суммами. Не установлена окончательная процедура отставок пасторов.
      </p>
      <p>
        Отдельной человеческой проверки требуют спорные эпизоды проповедей Бака,
        происхождение анонимных отправлений и предполагаемые мотивы.
        Нет достаточных данных для точной статистики политико-богословского
        содержания организации или сопоставимого ряда посещаемости.
      </p>
      <p>
        Если появится новый первичный документ, существенное изменение будет
        отражено открытым датированным исправлением, а не скрытой заменой выводов.
      </p>
      <p class="source-note-paragraph" data-publication-claims="G3-PUB-016"><a class="source-note" href="#documents">Границы доступных документов и методика</a></p>
    </div>
  </section>

  <section id="documents" class="module" tabindex="-1">
    <div class="module-label">09 · Документы</div>
    <div class="prose">
      <h2>На чём основан этот рассказ</h2>
      <p>
        Для финансовых выводов использованы налоговые формы американской
        некоммерческой организации, а для юридического статуса —
        запись реестра штата Джорджия на конкретную дату. Это позволяют
        проверять числа и формальный статус, но не являются самостоятельными
        выводами о преступлении или чьих-либо мотивах.
      </p>
      <p>
        Даты смены руководства и отмены конференций сверены с официальными
        сообщениями G3. Сведения о составе совета получены из архивной
        версии его официальной страницы. Там, где речь идёт о споре между
        людьми, необходимо отличать их собственные заявления от независимых
        документов и журналистских пересказов.
      </p>
      <p>
        Полная библиография приведена ниже с датировками, ссылками и
        оговорками по доступу. Не каждый источник разрешено воспроизводить
        целиком; ссылка на документ не превращает каждую изложенную в нём
        претензию в установленный факт.
      </p>
    </div>
  </section>

