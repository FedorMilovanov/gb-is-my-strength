---
import MobileChromePage from '@/components/article-pilots/_shared/MobileChromePage.astro';
import {
  G3_PUBLICATION_HANDOFF,
  assertG3PublicationProjection,
  type G3PublicationClaimId,
} from '@/data/journal/g3PublicationHandoff';
import { G3_SOURCE_BIBLIOGRAPHY } from '@/data/journal/g3SourceBibliography';

const projectedClaims: G3PublicationClaimId[] = [
  'G3-PUB-001', 'G3-PUB-002', 'G3-PUB-003', 'G3-PUB-004',
  'G3-PUB-005', 'G3-PUB-006', 'G3-PUB-007', 'G3-PUB-008',
  'G3-PUB-009', 'G3-PUB-010', 'G3-PUB-011', 'G3-PUB-012',
  'G3-PUB-013', 'G3-PUB-014', 'G3-PUB-015', 'G3-PUB-016',
];
projectedClaims.forEach(assertG3PublicationProjection);

const corrections: Array<{
  correctedAt: string;
  scope: string;
  previousMeaning: string;
  newMeaning: string;
  reason: string;
}> = [];
---
<!-- Bypass-ссылка: первый узел body, поэтому первая Tab-остановка на любой ширине.
     Класс .skip-link и цель #main-content — общесайтовый идиом (About/Articles/Home/
     HardTexts, css/site.css), вне фокуса ссылка увезена за верхний край. -->
<a href="#main-content" class="skip-link">Перейти к содержимому</a>

<MobileChromePage backHref="/journal/" homeHref="/" searchLabel="Поиск по сайту…" />

<header class="journal-topbar" aria-label="Навигация журнала">
  <a class="journal-brand" href="/journal/">Журнал</a>
  <nav aria-label="Хлебные крошки">
    <a href="/">Главная</a>
    <span>·</span>
    <a href="/journal/">Журнал</a>
    <span>·</span>
    <span aria-current="page">G3</span>
  </nav>
</header>

<main class="dossier" id="main-content" tabindex="-1" data-journal-dossier="g3" data-research-seal={G3_PUBLICATION_HANDOFF.researchSealCommit}>
  <header class="dossier-hero">
    <p class="kicker">Документальное досье · <span lang="en">G3 Ministries</span> · 2019–2026</p>
    <h1>G3: рост, кризис и завершение операций</h1>
    <p class="dek">
      Что можно установить по официальным заявлениям, государственному реестру корпораций, налоговым декларациям,
      архивным страницам и независимым свидетельствам — и где документы требуют остановиться.
    </p>
    <div class="evidence-strip" aria-label="Статус доказательств">
      <div><span>Жанр</span><strong>Документальное досье</strong></div>
      <div><span>Статус</span><strong>По проверенным источникам</strong></div>
      <div><span>Опубликовано</span><strong>09.09.2026</strong></div>
      <div><span>Проверенные тезисы</span><strong>16</strong></div>
      <div><span>Источники в досье</span><strong>21</strong></div>
      <div><span>Дата сверки реестров</span><strong>08–09.09.2026</strong></div>
    </div>
    <p class="authority-note">
      В досье включены только сведения, подтверждённые государственными реестрами, налоговой отчётностью,
      сохранёнными заявлениями и атрибутированными свидетельствами. Спорные версии и непроверенные предположения
      не повышаются до установленного факта. <a href="#bibliography">Перейти к списку источников (21)</a>.
    </p>
  </header>

  <nav class="dossier-nav" aria-label="Модули досье">
    <a href="#overview">Обзор</a>
    <a href="#timeline">Хронология</a>
    <a href="#finance">Финансы</a>
    <a href="#governance">Управление</a>
    <a href="#buice">Джош Бьюис</a>
    <a href="#buck">Том Бак</a>
    <a href="#wind-down">Завершение</a>
    <a href="#unknowns">Неизвестное</a>
    <a href="#bibliography">Библиография</a>
    <a href="#corrections">Исправления</a>
  </nav>

  <section id="overview" class="module intro-module">
    <div class="module-label">01 · Обзор</div>
    <div class="prose wide">
      <section class="summary-card dossier-summary" aria-labelledby="dossier-korotko" data-speakable data-glossary-skip>
        <h2 id="dossier-korotko">Коротко</h2>
        <ol class="dossier-summary-list">
          <li>Публичная история <span lang="en">G3 Ministries</span> в 2025–2026 годах распадается на несколько отдельных процессов: кризис вокруг президента Джоша Бьюиса (май 2025), попытку обновления руководства при Скотте Эниоле (июль 2025), конфликт вокруг проповедей Тома Бака и действий четырёх пасторов (август 2026) и объявление о прекращении текущей деятельности (сентябрь 2026).</li>
          <li>По декларациям <span lang="en">IRS Form 990</span> резкий рост расходов пришёлся на 2023 финансовый год (+$1 061 800 к 2022 году), при этом сама налоговая классификация расходов не доказывает ни злоупотреблений, ни внешнего аудиторского вердикта.</li>
          <li>В споре вокруг проповедей Тома Бака документы требуют разделять два разных вопроса: наличие недостаточно атрибутированных заимствований из комментариев и недолжную анонимную рассылку материалов с вмешательством в дела другой поместной церкви.</li>
          <li>Объявление о прекращении текущей работы G3 и отмене конференции 2027 года не тождественно ликвидации юридического лица: на 8 сентября 2026 года корпорация в реестре штата Джорджия сохраняла действующий статус.</li>
          <li>Судьба цифровой платформы G3+ и книжного каталога <span lang="en">G3 Press</span>, а также точный состав совета директоров в конце августа 2026 года остаются открытыми вопросами до появления первичных юридических документов.</li>
        </ol>
      </section>

      <h2>Главный вывод</h2>
      <p class="standfirst">
        Публичная история G3 не сводится к одной точке «закрытия». Документы показывают несколько
        разных процессов: кризис руководства в 2025 году, попытку институционального перезапуска,
        новый конфликт в 2026-м, прекращение текущей деятельности, отмену будущей конференции и при этом —
        отдельный юридический статус корпорации и не до конца раскрытую судьбу цифровых и издательских активов.
      </p>
      <aside class="boundary-box" role="note">
        <strong>Ключевая граница.</strong>
        «Операции прекращаются» не означает автоматически «юридическое лицо ликвидировано».
        По официальной записи секретаря штата Джорджия на 8 сентября 2026 года корпорация оставалась в статусе
        <em lang="en">Active/Compliance</em> («действующая, отчётность соблюдена»). Это датированное состояние реестра, которое может измениться позднее.
        <a class="claim-ref" href="#src-G3-S001">Источник № 01 (Реестр штата Джорджия)</a>
      </aside>
    </div>
  </section>

  <section id="timeline" class="module">
    <div class="module-label">02 · Хронология</div>
    <div class="prose">
      <h2>Контрольные точки, подтверждённые документами</h2>
    </div>
    <ol class="timeline">
      <li>
        <time datetime="2019-06-06">6 июня 2019</time>
        <div><h3>Юридическое оформление</h3><p><span lang="en">G3 Ministries for the Church, Inc.</span> зарегистрирована в штате Джорджия как внутренняя некоммерческая корпорация.</p><span class="claim-ref"><a href="#src-G3-S001">Источник № 01</a></span></div>
      </li>
      <li>
        <time datetime="2025-05-08">8–12 мая 2025</time>
        <div><h3>Кризис вокруг Джоша Бьюиса</h3><p>По официальному заявлению G3, отставка Джоша Бьюиса с поста президента была принята 8 мая; 12 мая совет директоров публично сообщил об обличении, признании вины, уходе с должности и ведении им анонимных учётных записей и каналов. Национальная конференция 2025 года была отменена.</p><span class="claim-ref"><a href="#src-G3-S008">Источник № 03</a></span></div>
      </li>
      <li>
        <time datetime="2025-07-09">9 июля 2025</time>
        <div><h3>Скотт Эниол вступает в должность президента</h3><p>Официальное объявление совета G3 устанавливает дату вступления Скотта Эниола в должность президента с 9 июля 2025 года.</p><a class="claim-ref" href="#src-G3-S010">Источник № 05</a></div>
      </li>
      <li>
        <time datetime="2026-07-21">21 июля 2026</time>
        <div><h3>Последний подтверждённый в веб-архиве состав совета директоров</h3><p>Архивная копия официальной страницы <span lang="en">«Who We Are»</span> перечисляет шестерых членов совета директоров: Бака Брасуэлла, Мэтта Брума, Джона Нортона, Мэтта Сайкса, Дилана Джойнера и Рона Муни.</p><span class="claim-ref"><a href="#src-G3-S096">Источник № 21</a></span></div>
      </li>
      <li>
        <time datetime="2026-08">август 2026</time>
        <div><h3>Новый конфликт и признание процессуальных ошибок</h3><p>Сохранённое совместное заявление четырёх пасторов признаёт недолжное вмешательство в самостоятельный дисциплинарный процесс другой поместной церкви, недостаточно осведомлённую оценку этого процесса и анонимную рассылку материалов третьим лицам.</p><span class="claim-ref"><a href="#src-G3-S015">Источник № 08</a> · <a href="#src-G3-S042">Источник № 15</a></span></div>
      </li>
      <li>
        <time datetime="2026-09">сентябрь 2026</time>
        <div><h3>Прекращение текущей деятельности — но не мгновенная ликвидация</h3><p>Публично объявлено о завершении работы церковной сети <span lang="en">Church Network</span> и основных программ G3; на официальной странице будущей конференции сообщалось об отмене мероприятия 27–29 мая 2027 года и возврате регистрационных взносов.</p><span class="claim-ref"><a href="#src-G3-S011">Источник № 06</a> · <a href="#src-G3-S017">Источник № 09</a></span></div>
      </li>
    </ol>
  </section>

  <section id="finance" class="module">
    <div class="module-label">03 · Финансы</div>
    <div class="prose">
      <h2>Что показывают декларации <span lang="en">IRS Form 990</span> — и чего они не показывают</h2>
      <p>
        Наиболее резкий подтверждённый сдвиг приходится на 2023 финансовый год. По данным раздела IX налоговой декларации
        <span lang="en">IRS Form 990</span> общие расходы выросли на <strong>$1 061 800</strong> по сравнению с 2022 финансовым годом:
        затраты на конференции и собрания увеличились на <strong>$817 283</strong>, а расходы на рекламу и продвижение — на
        <strong>$246 511</strong>. В отчёте за 2023 год все функциональные расходы были отнесены организацией к программной деятельности (100 %)
        при нулевых показателях административных расходов и сбора пожертвований.
        <a class="claim-ref" href="#src-G3-S002">Источник № 02 (IRS Form 990)</a>
      </p>
      <p>
        Эти строки отражают учётную классификацию самой организации в налоговой форме. Сами по себе они не доказывают
        хищений, вывода средств, нерыночного характера договоров с подрядчиками или выводов независимого аудита.
      </p>
      <div class="fact-grid">
        <article>
          <p class="fact-label">Декларация за 2024 ф. г.</p>
          <strong>Отсутствие существенного нецелевого отвлечения средств (по самоотчёту)</strong>
          <p>В форме 990 организация также указала наличие положения о конфликте интересов при отсутствии утверждённых правил защиты заявителей о нарушениях и регламента хранения документов.</p>
          <a class="claim-ref" href="#src-G3-S002">Источник № 02</a>
        </article>
        <article>
          <p class="fact-label">Приложение <span lang="en">Schedule L</span></p>
          <strong>$30 409 → $31 880</strong>
          <p>Вознаграждение Карис Л. Бьюис, указанной в декларации как дочь члена совета директоров (<span lang="en">«Daughter of Board Member»</span>), в 2024 и 2025 финансовых годах соответственно.</p>
          <span class="claim-ref"><a href="#src-G3-S002">Источник № 02</a> · <a href="#src-G3-S028">Источник № 12</a></span>
        </article>
      </div>
      <aside class="boundary-box" role="note">
        Совпадение фамилии и строка раскрытия в приложении <span lang="en">Schedule L</span> сами по себе не дают права
        устанавливать конкретное родство за пределами формулировки документа или заявлять о незаконном обогащении без отдельных доказательств.
      </aside>
    </div>
  </section>

  <section id="governance" class="module">
    <div class="module-label">04 · Управление</div>
    <div class="prose">
      <h2>Зафиксированный снимок — не непрерывная линия</h2>
      <p>
        Между <span lang="en">G3 Ministries</span> и поместной церковью <span lang="en">Pray’s Mill Baptist Church</span> (PMBC)
        накануне кризиса 2026 года прослеживается заметное кадровое пересечение: пасторы PMBC одновременно выступали в проектах G3
        преподавателями, ведущими сетевых встреч и — в ряде случаев — членами совета директоров. Это подтверждает совмещение ролей,
        но не доказывает ни деноминационного подчинения церкви, ни полного корпоративного поглощения, ни единого сговора.
        <span class="claim-ref"><a href="#src-G3-S046">Источник № 16</a> · <a href="#src-G3-S047">Источник № 17</a></span>
      </p>
      <p>
        Последний документально зафиксированный список совета директоров — архивная копия официальной страницы от 21 июля 2026 года.
        Мы не переносим этот состав автоматически на конец августа: точная преемственность полномочий в дни августовского кризиса остаётся открытым вопросом.
        <a class="claim-ref" href="#src-G3-S096">Источник № 21</a>
      </p>
    </div>
  </section>

  <section id="buice" class="module">
    <div class="module-label">05 · Джош Бьюис, 2025</div>
    <div class="prose">
      <h2>Кризис, признание и попытка перезапуска</h2>
      <p>
        В мае 2025 года совет G3 сообщил, что Джош Бьюис вёл несколько анонимных учётных записей,
        почтовых адресов и рассылок на платформе <span lang="en">Substack</span>, после чего был обличён, признал содеянное
        и подал в отставку. Эти сведения намеренно передаются со ссылкой на заявление самой организации:
        редакция не выдаёт внутреннее заявление совета за заключение независимой технической экспертизы.
        <a class="claim-ref" href="#src-G3-S008">Источник № 03</a>
      </p>
      <p>
        После майского кризиса G3 публично объявила об обновлении концепции, кадровых перестановках и запуске программы
        «Пастор-богослов» с упором на служение поместным общинам. Это позволяет говорить о <strong>попытке институционального перезапуска</strong>,
        но само по себе не доказывает ни её фактической результативности, ни внутренних мотивов участников.
        <span class="claim-ref"><a href="#src-G3-S009">Источник № 04</a> · <a href="#src-G3-S023">Источник № 10</a> · <a href="#src-G3-S024">Источник № 11</a></span>
      </p>
    </div>
  </section>

  <section id="buck" class="module sensitive-module">
    <div class="module-label">06 · Том Бак, 2026</div>
    <div class="prose">
      <h2>Два разных вопроса, которые нельзя смешивать</h2>
      <p>
        В конфликте вокруг проповедей Тома Бака проверенные материалы требуют строго различать две линии:
        <strong>вопрос о заимствованиях и полноте ссылок на комментарии</strong> и <strong>анонимную рассылку подборки обвинений вкупе с процессуальными нарушениями</strong>.
        Неправота или превышение границ в одной линии не отменяют фактов другой.
      </p>
      <div class="claim-matrix">
        <div class="matrix-row confirmed">
          <span class="matrix-state">Подтверждено</span>
          <p>Независимые разборы и заявления участников зафиксировали реальные фрагменты заимствованных формулировок из богословских комментариев без достаточной устной атрибуции.</p>
          <span class="claim-ref"><a href="#src-G3-S012">Источник № 07</a> · <a href="#src-G3-S035">Источник № 14</a></span>
        </div>
        <div class="matrix-row refuted">
          <span class="matrix-state">Не поддержано имеющимися данными</span>
          <p>Расширительное утверждение, будто Том Бак систематически произносил с кафедры чужие проповеди целиком, не подтверждается проверенными материалами.</p>
          <span class="claim-ref"><a href="#src-G3-S012">Источник № 07</a> · <a href="#src-G3-S035">Источник № 14</a></span>
        </div>
        <div class="matrix-row confirmed">
          <span class="matrix-state">Подтверждено с оговоркой</span>
          <p>Пресвитеры Первой баптистской церкви Линдейла (<span lang="en">FBC Lindale</span>) провели внутреннее рассмотрение и душепопечительскую коррекцию; сам этот факт не означает автоматической безошибочности оценки каждого отдельного случая.</p>
          <a class="claim-ref" href="#src-G3-S035">Источник № 14</a>
        </div>
        <div class="matrix-row disputed">
          <span class="matrix-state">Открыто (нужна сверка записей)</span>
          <p>Поэпизодное итоговое суждение требует очного прослушивания оригинальных аудиозаписей, сверки конкретного издания комментария и проверки устного контекста ссылки.</p>
          <a class="claim-ref" href="#unknowns">См. раздел 08</a>
        </div>
      </div>
      <aside class="warning-box" role="note">
        <strong>Чего здесь нет:</strong> числового счётчика подтверждённых эпизодов, утверждения о доказанном плагиате конкретного числа проповедей
        или прямых цитат из машинных расшифровок. Поэпизодная статистика намеренно не приводится до очной проверки оригинальных аудиозаписей,
        печатных изданий комментариев и полного устного контекста каждой проповеди.
      </aside>
      <p>
        Отдельно сохранённое заявление Скотта Эниола, Джона Нортона, Дилана Джойнера и Мэтта Сайкса позволяет
        с прямой атрибуцией пересказать признанные ими самими ошибки: вмешательство в самостоятельное разбирательство другой поместной церкви,
        публичную оценку этого разбирательства без полноты сведений и анонимную отправку материалов людям из круга Тома Бака.
        При этом документ не отвечает на вопрос, были ли все четыре последующие пасторские отставки полностью добровольными или вынужденными.
        <span class="claim-ref"><a href="#src-G3-S015">Источник № 08</a> · <a href="#src-G3-S042">Источник № 15</a></span>
      </p>
    </div>
  </section>

  <section id="wind-down" class="module">
    <div class="module-label">07 · Завершение G3</div>
    <div class="prose">
      <h2>Пять юридических и практических состояний вместо одного слова «закрылось»</h2>
      <div class="state-stack">
        <article><span>Церковная сеть (<span lang="en">Church Network</span>)</span><strong>Объявлена завершённой</strong><p>Отдельное мезобщинное направление служения.</p><a class="claim-ref" href="#src-G3-S017">Источник № 09</a></article>
        <article><span>Национальная конференция 2027</span><strong>Отменена, взносы возвращаются</strong><p>Подтверждено официальной страницей регистрации мероприятия.</p><a class="claim-ref" href="#src-G3-S011">Источник № 06</a></article>
        <article><span>Текущая деятельность</span><strong>Объявлено о прекращении</strong><p>Свёртывание текущей работы не тождественно юридической ликвидации корпорации.</p><a class="claim-ref" href="#src-G3-S017">Источник № 09</a></article>
        <article><span>Корпорация в Джорджии</span><strong>Действующая на 08.09.2026</strong><p>Датированная запись государственного реестра (<span lang="en">Active/Compliance</span>); статус может измениться позднее.</p><a class="claim-ref" href="#src-G3-S001">Источник № 01</a></article>
        <article><span>Платформа G3+ и <span lang="en">G3 Press</span></span><strong>Судьба активов открыта</strong><p>Витрины оставались доступными, однако приобретатель, закрытие сделки, условия передачи прав и складских остатков из метаданных не устанавливаются.</p><span class="claim-ref"><a href="#src-G3-S033">Источник № 13</a> · <a href="#src-G3-S053">Источник № 19</a></span></article>
      </div>
      <p>
        После объявления о свёртывании работы карточки приложения G3+ в магазинах <span lang="en">Apple App Store</span> и <span lang="en">Google Play</span>
        по-прежнему указывали прежнего разработчика, продавца и службу поддержки, связанную с G3, а книжная витрина <span lang="en">G3 Press</span>
        оставалась открытой. Это фиксирует лишь состояние цифровых витрин на дату наблюдения, но не доказывает ни конечного бенефициарного владения,
        ни юридического завершения передачи прав.
        <span class="claim-ref"><a href="#src-G3-S033">Источник № 13</a> · <a href="#src-G3-S050">Источник № 18</a> · <a href="#src-G3-S053">Источник № 19</a></span>
      </p>
      <p>
        Отдельно на 7 сентября 2026 года фиксируется присутствие книги Дейва Дженкинса <em lang="en">The Word Matters</em> на площадках его собственного
        служения <span lang="en">Servants of Grace / Theology for Life</span>. Сам по себе факт по одному наименованию не позволяет делать общий вывод о порядке
        возврата издательских прав авторам всего каталога <span lang="en">G3 Press</span>.
        <a class="claim-ref" href="#src-G3-S054">Источник № 20</a>
      </p>
    </div>
  </section>

