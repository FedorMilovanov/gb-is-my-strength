---
import MobileChromePage from '@/components/article-pilots/_shared/MobileChromePage.astro';
import {
  G3_PUBLICATION_HANDOFF,
  assertG3PublicationProjection,
  researchSnapshotShort,
  type G3PublicationClaimId,
} from '@/data/journal/g3PublicationHandoff';
import { G3_SOURCE_BIBLIOGRAPHY, G3_SOURCE_LEDGER_URL } from '@/data/journal/g3SourceBibliography';

const projectedClaims: G3PublicationClaimId[] = [
  'G3-PUB-001', 'G3-PUB-002', 'G3-PUB-003', 'G3-PUB-004',
  'G3-PUB-005', 'G3-PUB-006', 'G3-PUB-007', 'G3-PUB-008',
  'G3-PUB-009', 'G3-PUB-010', 'G3-PUB-011', 'G3-PUB-012',
  'G3-PUB-013', 'G3-PUB-014', 'G3-PUB-015', 'G3-PUB-016',
];
projectedClaims.forEach(assertG3PublicationProjection);

const corrections: Array<{
  correctedAt: string;
  scope: string;
  previousMeaning: string;
  newMeaning: string;
  reason: string;
  researchSnapshot: string;
}> = [];

const handoffUrl = `https://github.com/${G3_PUBLICATION_HANDOFF.researchRepo}/blob/${G3_PUBLICATION_HANDOFF.researchSealCommit}/${G3_PUBLICATION_HANDOFF.handoffPath}`;
const snapshot = researchSnapshotShort();
---
<!-- Bypass-ссылка: первый узел body, поэтому первая Tab-остановка на любой ширине.
     Класс .skip-link и цель #main-content — общесайтовый идиом (About/Articles/Home/
     HardTexts, css/site.css), вне фокуса ссылка увезена за верхний край. -->
<a href="#main-content" class="skip-link">Перейти к содержимому</a>

<MobileChromePage backHref="/journal/" homeHref="/" searchLabel="Поиск по сайту…" />

<header class="journal-topbar" aria-label="Навигация журнала">
  <a class="journal-brand" href="/journal/">Журнал</a>
  <nav aria-label="Хлебные крошки">
    <a href="/">Главная</a>
    <span>·</span>
    <a href="/journal/">Журнал</a>
    <span>·</span>
    <span aria-current="page">G3</span>
  </nav>
</header>

<main class="dossier" id="main-content" tabindex="-1" data-journal-dossier="g3" data-research-seal={G3_PUBLICATION_HANDOFF.researchSealCommit}>
  <header class="dossier-hero">
    <p class="kicker">Документальное досье · G3 Ministries · 2019–2026</p>
    <h1>G3: рост, кризис и завершение операций</h1>
    <p class="dek">
      Что можно установить по официальным заявлениям, корпоративным записям, налоговым формам,
      архивным страницам и независимым свидетельствам — и где доказательства требуют остановиться.
    </p>
    <div class="evidence-strip" aria-label="Статус доказательств">
      <div><span>Тип</span><strong>Досье</strong></div>
      <div><span>Статус</span><strong>Проверено в пределах handoff</strong></div>
      <div><span>Опубликовано</span><strong>09.09.2026</strong></div>
      <div><span>Публикационные проекции</span><strong>16</strong></div>
      <div><span>Pinned sources</span><strong>21</strong></div>
      <div><span>Research snapshot</span><strong>{snapshot}</strong></div>
    </div>
    <p class="authority-note">
      Публикация ограничена immutable Research handoff. Непроверенные, спорные и исключённые утверждения
      не повышаются до факта. <a href={handoffUrl}>Посмотреть pinned handoff</a>.
    </p>
  </header>

  <nav class="dossier-nav" aria-label="Модули досье">
    <a href="#overview">Обзор</a>
    <a href="#timeline">Хронология</a>
    <a href="#finance">Финансы</a>
    <a href="#governance">Управление</a>
    <a href="#buice">Josh Buice</a>
    <a href="#buck">Tom Buck</a>
    <a href="#wind-down">Завершение</a>
    <a href="#unknowns">Неизвестное</a>
    <a href="#bibliography">Библиография</a>
    <a href="#corrections">Исправления</a>
  </nav>

  <section id="overview" class="module intro-module">
    <div class="module-label">01 · Обзор</div>
    <div class="prose wide">
      <h2>Главный вывод</h2>
      <p class="standfirst">
        Публичная история G3 не сводится к одной точке «закрытия». Документы показывают несколько
        разных процессов: кризис руководства в 2025 году, попытку институционального перезапуска,
        новый конфликт в 2026-м, прекращение операций, отмену будущей конференции и при этом —
        отдельный юридический статус корпорации и не до конца раскрытую судьбу цифровых и издательских активов.
      </p>
      <aside class="boundary-box" role="note">
        <strong>Ключевая граница.</strong>
        «Операции прекращаются» не означает автоматически «юридическое лицо ликвидировано».
        По официальной записи Georgia Secretary of State на 8 сентября 2026 года корпорация оставалась
        <em>Active/Compliance</em>. Это датированное состояние, которое может измениться позднее.
        <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-001</a>
      </aside>
    </div>
  </section>

  <section id="timeline" class="module">
    <div class="module-label">02 · Хронология</div>
    <div class="prose">
      <h2>Контрольные точки, которые выдерживают публикационный порог</h2>
    </div>
    <ol class="timeline">
      <li>
        <time datetime="2019-06-06">6 июня 2019</time>
        <div><h3>Юридическое оформление</h3><p>G3 Ministries for the Church, Inc. оформлена как domestic nonprofit corporation в Georgia.</p><span class="claim-ref"><a href={handoffUrl} rel="noopener">G3-PUB-001</a> · <a href="#src-G3-S001">G3-S001</a></span></div>
      </li>
      <li>
        <time datetime="2025-05-08">8–12 мая 2025</time>
        <div><h3>Кризис Josh Buice</h3><p>По заявлению G3, отставка Buice с поста президента была принята 8 мая; 12 мая организация публично сообщила о confrontation, confession, resignation и анонимных аккаунтах/каналах. Конференция 2025 года была отменена.</p><span class="claim-ref"><a href={handoffUrl} rel="noopener">G3-PUB-005</a> · <a href={handoffUrl} rel="noopener">G3-PUB-006</a></span></div>
      </li>
      <li>
        <time datetime="2025-07-09">9 июля 2025</time>
        <div><h3>Scott Aniol становится президентом</h3><p>Официальное объявление G3 устанавливает effective date назначения Aniol на 9 июля 2025 года.</p><a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-006</a></div>
      </li>
      <li>
        <time datetime="2026-07-21">21 июля 2026</time>
        <div><h3>Последний primary-verified состав совета в публичном архиве</h3><p>Архивный снимок официальной страницы «Who We Are» перечисляет Buck Braswell, Matt Broome, Jon Norton, Matt Sikes, Dylan Joyner и Ron Mooney как Board of Directors.</p><span class="claim-ref"><a href={handoffUrl} rel="noopener">G3-PUB-008</a> · <a href="#src-G3-S096">G3-S096</a></span></div>
      </li>
      <li>
        <time datetime="2026-08">август 2026</time>
        <div><h3>Новый конфликт и признание процессуальных ошибок</h3><p>Сохранённый текст заявления четырёх пасторов признаёт неправильное вмешательство в автономный дисциплинарный процесс другой церкви, недостаточно информированную характеристику этого процесса и анонимную рассылку материалов третьим лицам.</p><a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-011</a></div>
      </li>
      <li>
        <time datetime="2026-09">сентябрь 2026</time>
        <div><h3>Прекращение операций — но не один юридический «рубильник»</h3><p>Публично сообщалось о завершении Church Network и broader G3 operations; G3-контролируемый регистрационный маршрут будущей конференции указывал, что мероприятие 27–29 мая 2027 года отменено, регистрации отменяются/возвращаются.</p><a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-012</a></div>
      </li>
    </ol>
  </section>

  <section id="finance" class="module">
    <div class="module-label">03 · Финансы</div>
    <div class="prose">
      <h2>Что показывают IRS Form 990 — и чего они не показывают</h2>
      <p>
        Наиболее резкий подтверждённый сдвиг виден в FY2023. По raw IRS Part IX общие расходы выросли
        на <strong>$1,061,800</strong> относительно FY2022; расходы на conferences/meetings выросли на
        <strong>$817,283</strong>, advertising — на <strong>$246,511</strong>. В FY2023 функциональные
        расходы были отражены как 100% program services, при $0 management/general и $0 fundraising.
        <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-002</a>
      </p>
      <p>
        Эти строки — классификации самой налоговой формы. Они не доказывают мошенничество, вывод средств,
        справедливость конкретных vendor contracts или вывод внешнего аудитора.
      </p>
      <div class="fact-grid">
        <article>
          <p class="fact-label">FY2024 filing</p>
          <strong>«No material diversion» — self-reported</strong>
          <p>Form 990 также сообщала о conflict-of-interest policy и отсутствии whistleblower/document-retention policy.</p>
          <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-003</a>
        </article>
        <article>
          <p class="fact-label">Schedule L</p>
          <strong>$30,409 → $31,880</strong>
          <p>Компенсация Karis L Buice, описанной формой как «Daughter of Board Member», в FY2024 и FY2025 соответственно.</p>
          <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-004</a>
        </article>
      </div>
      <aside class="boundary-box" role="note">
        Сама фамилия и Schedule L disclosure не дают права устанавливать личность родителя или объявлять
        fraud/excess benefit без отдельного доказательства.
      </aside>
    </div>
  </section>

  <section id="governance" class="module">
    <div class="module-label">04 · Управление</div>
    <div class="prose">
      <h2>Известный снимок — не непрерывная линия</h2>
      <p>
        Между G3 и Pray’s Mill перед кризисом 2026 года документируется заметное пересечение персонала:
        пасторы PMBC одновременно фигурируют в G3 как преподаватели, участники network-активности и,
        для части лиц, члены совета. Это подтверждает организационное пересечение ролей, но не доказывает
        denominational jurisdiction, полный корпоративный контроль или общий заговор.
        <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-009</a>
      </p>
      <p>
        Последний доступный primary-verified roster — архивный официальный снимок 21 июля 2026 года.
        Мы не интерполируем его автоматически на поздний август: точная continuity в момент кризиса остаётся открытым вопросом.
        <span class="claim-ref"><a href={handoffUrl} rel="noopener">G3-PUB-008</a> · <a href={handoffUrl} rel="noopener">G3-PUB-016</a></span>
      </p>
    </div>
  </section>

  <section id="buice" class="module">
    <div class="module-label">05 · Josh Buice, 2025</div>
    <div class="prose">
      <h2>Кризис, признание и попытка перезапуска</h2>
      <p>
        В мае 2025 года G3 сообщила, что Josh Buice управлял несколькими анонимными аккаунтами,
        email-адресами и Substack-каналами, был confronted, confessed и resigned. Формулировка здесь
        намеренно атрибутирована организации: публичный материал не превращает институциональное заявление
        в независимый внешний forensic finding.
        <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-005</a>
      </p>
      <p>
        После кризиса G3 публично продвигала renewed vision, кадровый переход и Pastor-Theologian/local-church emphasis.
        Это позволяет говорить о <strong>попытке институционального перезапуска</strong>, но не доказывает её эффективность
        или внутреннюю искренность.
        <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-007</a>
      </p>
    </div>
  </section>

  <section id="buck" class="module sensitive-module">
    <div class="module-label">06 · Tom Buck, 2026</div>
    <div class="prose">
      <h2>Два разных вопроса, которые нельзя склеивать</h2>
      <p>
        В споре вокруг проповедей Tom Buck доказательный набор требует разделять два трека:
        <strong>атрибуцию/зависимость от комментариев</strong> и <strong>анонимное распространение dossier / процессуальное поведение</strong>.
        Ошибки или чрезмерность в одном треке не стирают данные другого.
      </p>
      <div class="claim-matrix">
        <div class="matrix-row confirmed">
          <span class="matrix-state">Подтверждено</span>
          <p>Независимый/участнический review обнаруживал реальные фрагменты недостаточно атрибутированного commentary wording.</p>
          <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-010</a>
        </div>
        <div class="matrix-row refuted">
          <span class="matrix-state">Не поддержано имеющимися данными</span>
          <p>Более сильная формула, будто Buck систематически проповедовал целые готовые sermons других авторов, не выдерживает приобретённого evidence set.</p>
          <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-010</a>
        </div>
        <div class="matrix-row confirmed">
          <span class="matrix-state">Подтверждено с оговоркой</span>
          <p>FBC Lindale проводила процесс рассмотрения и коррекции; это не равнозначно утверждению, что каждый спорный эпизод был правильно решён.</p>
          <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-010</a>
        </div>
        <div class="matrix-row disputed">
          <span class="matrix-state">HOLD</span>
          <p>Поэпизодный финальный verdict требует человеческого прослушивания original audio, exact source edition и attribution context.</p>
          <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-016</a>
        </div>
      </div>
      <aside class="warning-box" role="note">
        <strong>Чего здесь нет:</strong> числового счётчика подтверждённых эпизодов, утверждения о доказанном плагиате конкретного числа проповедей
        или прямых цитат из machine transcripts. Поэпизодный verified-instance count намеренно не публикуется:
        immutable handoff оставляет item-level Buck adjudication на HOLD до человеческой проверки audio, source edition и attribution context.
      </aside>
      <p>
        Отдельно сохранённое заявление Scott Aniol, Jon Norton, Dylan Joyner и Matt Sikes позволяет
        атрибутированно пересказать признанные ими процессуальные ошибки: вмешательство в автономный процесс другой церкви,
        характеристику этого процесса без всех деталей и анонимную отправку материалов людям из окружения Buck.
        Оно не решает спор о том, были ли все четыре последующие отставки добровольными или требуемыми.
        <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-011</a>
      </p>
    </div>
  </section>

  <section id="wind-down" class="module">
    <div class="module-label">07 · Завершение G3</div>
    <div class="prose">
      <h2>Пять состояний вместо одного слова «закрылось»</h2>
      <div class="state-stack">
        <article><span>Church Network</span><strong>Объявлен завершённым</strong><p>Отдельный институциональный слой.</p><a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-012</a></article>
        <article><span>National Conference 2027</span><strong>Отменена, регистрации отменяются/возвращаются</strong><p>Подтверждено G3-контролируемым registration route.</p><a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-012</a></article>
        <article><span>Operations</span><strong>Объявлено о завершении</strong><p>Операционное состояние не тождественно corporate dissolution.</p><a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-012</a></article>
        <article><span>Georgia corporation</span><strong>Active/Compliance на 08.09.2026</strong><p>Датированный primary registry state; может измениться после публикации.</p><a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-001</a></article>
        <article><span>G3+ / G3 Press</span><strong>Aftermath частично открыт</strong><p>App/storefront state виден, но transferee, closing, terms, rights и inventory не выводятся из метаданных платформ.</p><span class="claim-ref"><a href={handoffUrl} rel="noopener">G3-PUB-013</a> · <a href={handoffUrl} rel="noopener">G3-PUB-014</a></span></article>
      </div>
      <p>
        После wind-down app-store surfaces всё ещё показывали G3-linked developer/seller/support identity для G3+,
        а G3 Press storefront оставался видимым. Это доказывает только датированное состояние платформы/витрины,
        но не beneficial ownership или юридическое завершение передачи.
        <span class="claim-ref"><a href={handoffUrl} rel="noopener">G3-PUB-013</a> · <a href={handoffUrl} rel="noopener">G3-PUB-014</a></span>
      </p>
      <p>
        Отдельно наблюдается post-G3 presence книги Dave Jenkins <em>The Word Matters</em> в его нынешней
        Servants of Grace / Theology for Life ecosystem. Один title-level факт не позволяет вывести общий контрактный
        механизм возврата прав для всего каталога G3 Press.
        <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-015</a>
      </p>
    </div>
  </section>

  <section id="unknowns" class="module unknown-module">
    <div class="module-label">08 · Что ещё не известно</div>
    <div class="prose">
      <h2>Открытые узлы — это часть результата</h2>
      <p>
        Публичный evidence route по этим вопросам исчерпан до появления нового первичного объекта,
        авторизованного доступа или человеческой проверки original media. Они не считаются «недоделанной статьёй»
        и не заполняются предположением.
        <a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-016</a>
      </p>
      <ul class="unknown-list">
        {G3_PUBLICATION_HANDOFF.knownOpenQuestions.map((question) => <li>{question}</li>)}
      </ul>
      <aside class="boundary-box" role="note">
        Отсутствие публичного документа не является доказательством того, что событие не происходило.
        Если появляется новый primary object, Research создаёт новый snapshot, а материал получает датированное обновление/исправление.
      </aside>
    </div>
  </section>

  <section id="documents" class="module">
    <div class="module-label">Документы · provenance</div>
    <div class="prose">
      <h2>Ключевые классы источников</h2>
      <div class="document-grid">
        <article><span class="source-badge primary">Первичный документ</span><h3>Georgia Secretary of State</h3><p>Корпоративное образование и датированный legal status.</p><p class="claim-ref"><a href="#src-G3-S001">G3-S001</a></p></article>
        <article><span class="source-badge primary">Первичный документ</span><h3>IRS Form 990 / TEOS raw XML</h3><p>Финансы, governance disclosures, Schedule L, FY2025 program history.</p><p class="claim-ref"><a href="#src-G3-S002">G3-S002</a> · <a href="#src-G3-S028">G3-S028</a></p></article>
        <article><span class="source-badge official">Официальное заявление</span><h3>G3 statements and event routes</h3><p>Buice crisis, Aniol appointment, reform attempt, conference cancellation.</p><p class="claim-ref"><a href="#src-G3-S008">G3-S008</a> · <a href="#src-G3-S009">G3-S009</a> · <a href="#src-G3-S010">G3-S010</a> · <a href="#src-G3-S011">G3-S011</a> · <a href="#src-G3-S023">G3-S023</a> · <a href="#src-G3-S024">G3-S024</a></p></article>
        <article><span class="source-badge archive">Архивный источник</span><h3>Official G3 “Who We Are” capture</h3><p>Датированный Board of Directors roster на 21 июля 2026.</p><p class="claim-ref"><a href="#src-G3-S096">G3-S096</a></p></article>
