---
import JournalEditorialShell from './JournalEditorialShell.astro';
import JournalEditorialRail from './JournalEditorialRail.astro';
import { G3_PRODUCT_METADATA } from '@/data/journal/g3ProductMetadata';
import {
  G3_PUBLICATION_HANDOFF,
  assertG3PublicationProjection,
  researchSnapshotShort,
  type G3PublicationClaimId,
} from '@/data/journal/g3PublicationHandoff';
import { G3_SOURCE_BIBLIOGRAPHY, G3_SOURCE_LEDGER_URL } from '@/data/journal/g3SourceBibliography';

const projectedClaims: G3PublicationClaimId[] = [
  'G3-PUB-001', 'G3-PUB-002', 'G3-PUB-003', 'G3-PUB-004',
  'G3-PUB-005', 'G3-PUB-006', 'G3-PUB-007', 'G3-PUB-008',
  'G3-PUB-009', 'G3-PUB-010', 'G3-PUB-011', 'G3-PUB-012',
  'G3-PUB-013', 'G3-PUB-014', 'G3-PUB-015', 'G3-PUB-016',
];
projectedClaims.forEach(assertG3PublicationProjection);

const corrections: Array<{
  correctedAt: string;
  scope: string;
  previousMeaning: string;
  newMeaning: string;
  reason: string;
  researchSnapshot: string;
}> = [];

const handoffUrl = `https://github.com/${G3_PUBLICATION_HANDOFF.researchRepo}/blob/${G3_PUBLICATION_HANDOFF.researchSealCommit}/${G3_PUBLICATION_HANDOFF.handoffPath}`;
const snapshot = researchSnapshotShort();
---
<JournalEditorialShell kind="dossier" backHref="/journal/">
<main class="dossier journal-dossier-shell" id="main-content" tabindex="-1" data-journal-dossier="g3" data-research-seal={G3_PUBLICATION_HANDOFF.researchSealCommit}>
  <div class="journal-feature-grid">
    <div class="journal-story-column">
  <header class="dossier-hero">
    <div class="journal-story-topline">
      <span class="journal-story-tag">Досье</span>
      <p class="kicker">G3 Ministries · документальное досье · 2019–2026</p>
    </div>
    <h1>{G3_PRODUCT_METADATA.title}</h1>
    <p class="dek">
      В 2025 году G3 столкнулась с отставкой основателя и попыталась перестроить работу.
      Новый конфликт в 2026-м привёл к объявлениям о сворачивании служения и отмене конференции.
      Что подтверждают документы, что утверждали участники и какие вопросы о финансах,
      руководстве и судьбе проектов остаются открытыми?
    </p>
    <div class="editorial-meta" role="group" aria-label="Сведения о материале">
      <span>Документальное досье</span>
      <span><time datetime="2026-09-09">9 сентября 2026 года</time></span>
      <span>Обновлено <time datetime="2026-11-18">18 ноября 2026</time></span>
    </div>
  </header>

  <figure class="journal-feature-media">
    <img src="/images/journal/g3-ministries-cover-1200.webp"
         srcset="/images/journal/g3-ministries-cover-640.webp 640w, /images/journal/g3-ministries-cover-1200.webp 1200w"
         sizes="(max-width: 980px) calc(100vw - 48px), 810px"
         width="1200" height="675" alt="Иллюстративная обложка G3 Ministries: открытая книга, логотип G3 и девиз Gospel, Grace, Glory."
         decoding="async" loading="eager" fetchpriority="high" />
    <figcaption>Иллюстративная обложка G3 Ministries. Не является архивным фотоснимком события.</figcaption>
  </figure>
    <p class="reader-framing">
      Здесь мы рассказываем историю событий, а не выносим приговор отдельным людям.
      Документы позволяют установить даты, финансовые показатели и официальные заявления;
      мотивы, нераскрытые сделки и часть обвинений остаются за пределами доказанного.
    </p>

  <nav class="dossier-nav" aria-label="Модули досье">
    <a href="#overview">Контекст</a>
    <a href="#timeline">События</a>
    <a href="#finance">Финансы</a>
    <a href="#buice">Кризис 2025</a>
    <a href="#buck">Кризис 2026</a>
    <a href="#wind-down">Завершение</a>
    <a href="#unknowns">Неизвестное</a>
    <a href="#bibliography">Источники</a>
  </nav>

  <section id="overview" class="module intro-module">
    <div class="module-label">01 · Предыстория</div>
    <div class="prose wide">
      <h2>Как G3 пришла к двум кризисам</h2>
      <p class="standfirst">
        История G3 не сводится к одной дате закрытия. Организация, известная конференциями
        и издательскими проектами, сначала столкнулась с уходом своего основателя,
        затем попыталась продолжить работу с новым руководством — и вскоре оказалась
        перед следующим конфликтом.
      </p>
      <p>
        В 2019 году G3 Ministries была оформлена в штате Джорджия как некоммерческая корпорация.
        Позднее деятельность включала конференции, цифровую платформу G3+, издательское направление G3 Press
        и сеть церквей. Для читателя важно различать эти части: завершение конференций
        не обязательно означает, что все книги, цифровые продукты и юридические права
        прекратили существование в один день.
      </p>
      <p>
        В мае 2025 года G3 сама сообщила об анонимной деятельности её руководителя Джоша Бьюса
        и принятии его отставки. Организация объявила о кадровых и программных изменениях,
        пытаясь продолжить служение. В августе–сентябре 2026 года последовал новый кризис,
        после которого было объявлено о завершении ряда направлений и операций.
      </p>
      <p>
        Проверка документов позволяет восстановить последовательность решений, но не позволяет
        автоматически установить чужие мотивы, юридическую судьбу всех активов
        или виновность участников каждого конфликта.
      </p>
      <p class="source-note-paragraph"><a class="source-note" href={handoffUrl} rel="noopener">Исследовательские основания: G3-PUB-001, 005–007, 012–016</a></p>
    </div>
  </section>

  <section id="timeline" class="module">
    <div class="module-label">02 · Хронология</div>
    <div class="prose">
      <h2>Главные события по годам</h2>
      <p>После предыстории легче увидеть, как кризис руководства 2025 года связан с событиями 2026-го. Здесь перечислены только даты, подтверждённые доступными документами; вопросы, остающиеся спорными, обсуждаются отдельно.</p>
    </div>
    <ol class="timeline">
      <li>
        <time datetime="2019-06-06">6 июня 2019</time>
        <div><h3>Юридическое оформление</h3><p>G3 Ministries for the Church, Inc. зарегистрирована в штате Джорджия как некоммерческая корпорация.</p><span class="claim-ref"><a href={handoffUrl} rel="noopener">G3-PUB-001</a> · <a href="#src-G3-S001">G3-S001</a></span></div>
      </li>
      <li>
        <time datetime="2025-05-08">8–12 мая 2025</time>
        <div><h3>Кризис Josh Buice</h3><p>По заявлению G3, отставка Buice с поста президента была принята 8 мая; 12 мая организация публично рассказала об анонимных интернет-аккаунтах руководителя, разговоре с ним, признании и отставке. Конференция 2025 года была отменена.</p><span class="claim-ref"><a href={handoffUrl} rel="noopener">G3-PUB-005</a> · <a href={handoffUrl} rel="noopener">G3-PUB-006</a></span></div>
      </li>
      <li>
        <time datetime="2025-07-09">9 июля 2025</time>
        <div><h3>Scott Aniol становится президентом</h3><p>Согласно официальному объявлению G3, Скотт Аниол вступил в должность 9 июля 2025 года.</p><a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-006</a></div>
      </li>
      <li>
        <time datetime="2026-07-21">21 июля 2026</time>
        <div><h3>Подтверждённый архивом состав совета</h3><p>Архивный снимок официальной страницы «Who We Are» перечисляет Buck Braswell, Matt Broome, Jon Norton, Matt Sikes, Dylan Joyner и Ron Mooney как членов совета директоров.</p><span class="claim-ref"><a href={handoffUrl} rel="noopener">G3-PUB-008</a> · <a href="#src-G3-S096">G3-S096</a></span></div>
      </li>
      <li>
        <time datetime="2026-08">август 2026</time>
        <div><h3>Новый конфликт и признание процессуальных ошибок</h3><p>В сохранившемся заявлении четыре пастора признали ошибки: вмешательство во внутреннее дисциплинарное дело другой церкви, суждения без полного понимания обстоятельств и анонимную рассылку материалов третьим лицам.</p><a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-011</a></div>
      </li>
      <li>
        <time datetime="2026-09">сентябрь 2026</time>
        <div><h3>Объявление о завершении работы</h3><p>G3 объявила о завершении церковной сети и более широкой деятельности. Регистрация на конференцию 27–29 мая 2027 года сообщала об отмене мероприятия и возврате взносов.</p><a class="claim-ref" href={handoffUrl} rel="noopener">G3-PUB-012</a></div>
      </li>
    </ol>
  </section>

  <section id="finance" class="module">
    <div class="module-label">03 · Финансы</div>
    <div class="prose">
      <h2>Что изменилось в расходах G3</h2>
      <p>
        Финансовая история началась ещё до громких конфликтов 2025–2026 годов.
        По сведениям из налоговых деклараций американской некоммерческой организации
        общие расходы G3 за 2023 финансовый год оказались на <strong>1 061 800 долларов</strong>
        выше, чем за предыдущий год. Наибольший вклад в этот рост внесли
        затраты на конференции и встречи — плюс <strong>817 283 доллара</strong> —
        и рекламу — плюс <strong>246 511 долларов</strong>.
      </p>
      <p>
        В той же форме расходы 2023 года были полностью отнесены к программной деятельности:
        на административные нужды и сбор пожертвований организация отразила нулевые суммы.
        Это то, <strong>как G3 классифицировала затраты в поданной декларации</strong>,
        а не заключение внешнего аудитора об их разумности или отсутствии нарушений.
      </p>
      <p>
        За 2024 год организация сообщила в декларации об отсутствии существенного
        отвлечения активов и наличии политики урегулирования конфликтов интересов;
        отдельные политики защиты информаторов и хранения документов в форме не были заявлены.
        Такие ответы показывают раскрытые самой организацией управленческие процедуры,
        но не доказывают, что проблемы отсутствовали или, наоборот, существовали.
      </p>
      <p>
        Декларации за 2024 и 2025 годы также раскрывают выплаты Карис Бьюс —
        <strong>30 409</strong> и <strong>31 880 долларов</strong> соответственно.
        Форма обозначает её дочерью члена совета. Эта запись требует прозрачного
        упоминания, но сама по себе не позволяет сделать вывод о незаконной выплате
        или определить личность родителя только по фамилии.
      </p>
      <p class="source-note-paragraph"><a class="source-note" href={handoffUrl} rel="noopener">Налоговые данные и ограничения: G3-PUB-002–004</a></p>
    </div>
  </section>

  <section id="governance" class="module">
    <div class="module-label">04 · Управление</div>
    <div class="prose">
      <h2>Почему важны люди, входившие в руководство</h2>
      <p>
        Перед событиями 2026 года G3 и баптистская церковь Pray’s Mill были тесно
        связаны через конкретных служителей: некоторые пасторы одновременно преподавали
        в проектах G3, участвовали в её церковной сети или входили в совет организации.
        Это объясняет, почему кризис одного служения затронул и другое.
      </p>
      <p>
        Однако пересечение обязанностей не устанавливает ни юридического подчинения одной
        организации другой, ни общего намерения участников. Для вопроса о полномочиях
        нужны устав, состав совета на конкретную дату и решения самого совета.
      </p>
      <p>
        Последний подтверждённый архивный список совета относится к <strong>21 июля 2026 года</strong>.
        Мы не переносим автоматически этот состав на конец августа, когда происходили
        события кризиса: необходимые документы за этот промежуток пока не получены.
      </p>
      <p class="source-note-paragraph"><a class="source-note" href={handoffUrl} rel="noopener">Состав совета и ограничения: G3-PUB-008–009, 016</a></p>
    </div>
  </section>

  <section id="buice" class="module">
    <div class="module-label">05 · Кризис 2025</div>
    <div class="prose">
      <h2>Уход Джоша Бьюса и попытка продолжить работу</h2>
      <p>
        В мае 2025 года G3 опубликовала заявление о деятельности своего президента
        Джоша Бьюса под анонимными именами в интернете. По версии организации,
        после разговора с ним последовало признание, и совет принял его отставку
        с должности президента <strong>8 мая 2025 года</strong>.
        Об этом публично сообщили 12 мая. Тогда же была отменена конференция 2025 года.
      </p>
      <p>
        Важно сохранить источник утверждения: сведения о признании и обстоятельствах
        отставки в этой части исходят из заявления самой G3. Нельзя выдавать его
        за независимое расследование, которое проверило каждую деталь.
      </p>
      <p>
        Новый этап руководство связывало с изменением приоритетов и обновлением работы
        организации. Президентом G3 с <strong>9 июля 2025 года</strong> стал Скотт Аниол.
        Следовательно, корректнее говорить о <strong>попытке продолжить и перестроить служение</strong>,
        а не утверждать, что реформа обязательно оказалась успешной.
      </p>
      <p class="source-note-paragraph"><a class="source-note" href={handoffUrl} rel="noopener">Заявления организации и даты: G3-PUB-005–007</a></p>
    </div>
  </section>

  <section id="buck" class="module sensitive-module">
    <div class="module-label">06 · Кризис 2026</div>
    <div class="prose">
      <h2>Спор о проповедях Тома Бака и последствия анонимной рассылки</h2>
      <p>
        Новый конфликт связан с проповедями пастора Тома Бака и тем, каким образом
        отдельные фрагменты его проповедей соотносились с уже опубликованными
        богословскими комментариями. Для оценки этого вопроса нужно различать
        недостаточную ссылку на использованный источник и гораздо более серьёзное
        обвинение в проповеди чужих готовых текстов целиком.
      </p>
      <p>
        Доступная проверка обнаружила случаи недостаточно ясного указания на
        формулировки из комментариев. Но опубликованные материалы <strong>не дают
        оснований утверждать</strong>, что Бак систематически произносил
        полностью написанные другими авторами проповеди. Его церковь в Линдейле
        проводила рассмотрение и предпринимала исправительные действия;
        это не означает, что все отдельные эпизоды уже получили окончательную оценку.
      </p>
      <p>
        Вторая сторона истории — способ распространения обвинительных материалов.
        В сохранившемся заявлении четыре служителя, связанные с Pray’s Mill и G3,
        признали ошибки: вмешательство во внутрицерковную процедуру другой общины,
        оценку ситуации без всех необходимых сведений и анонимную отправку материалов
        третьим лицам. Мы передаём это как содержание их заявления, а не как
        независимое установление мотивов каждого участника.
      </p>
      <p>
        Из доступных сведений невозможно уверенно заключить, все ли последующие
        отставки были добровольными. Также нельзя назвать проверенное количество
        случаев плагиата: для каждого спорного места необходимо прослушать
        оригинальную запись проповеди, установить издание использованного комментария
        и проверить контекст ссылки на автора.
      </p>
      <p class="source-note-paragraph"><a class="source-note" href={handoffUrl} rel="noopener">Проверка двух разных вопросов: G3-PUB-010–011, 016</a></p>
    </div>
  </section>

  <section id="wind-down" class="module">
    <div class="module-label">07 · Что завершилось</div>
    <div class="prose">
      <h2>Что означает объявление о завершении деятельности G3</h2>
      <p>
        После кризиса 2026 года было объявлено о завершении церковной сети G3 Church Network
        и сворачивании более широкой деятельности организации. Отдельно на сайте
        регистрации будущей конференции появилось сообщение об отмене мероприятия,
        намеченного на <strong>27–29 мая 2027 года</strong>, и возврате регистрационных взносов.
      </p>
      <p>
        Но для истории организации это не одна дата с единственным смыслом.
        <strong>Прекратить мероприятия</strong> — не то же самое, что
        <strong>юридически ликвидировать корпорацию</strong>.
        В доступной записи штата Джорджия на <strong>8 сентября 2026 года</strong>
        юридическое лицо всё ещё числилось действующим. Это снимок реестра
        на указанную дату, а не обещание, что статус сохранился навсегда.
      </p>
      <p>
        После объявленного завершения работы цифровые витрины G3+ и G3 Press
        всё ещё были доступны под брендом организации. Такая доступность
        показывает лишь состояние сайтов и магазинов: она не позволяет
        определить нового владельца, условия сделки или юридический
        переход прав на книги и сервисы.
      </p>
      <p>
        Известен отдельный пример: книга Дэйва Дженкинса <em>The Word Matters</em>
        появлялась в его нынешней издательско-образовательной среде.
        Однако даже этот случай не раскрывает условия передачи прав
        на весь каталог G3 Press.
      </p>
      <p class="source-note-paragraph"><a class="source-note" href={handoffUrl} rel="noopener">Решения, реестры и открытые вопросы: G3-PUB-001, 012–016</a></p>
    </div>
  </section>

  <section id="unknowns" class="module unknown-module">
    <div class="module-label">08 · Открытые вопросы</div>
    <div class="prose">
      <h2>Какие вопросы пока остаются без ответа</h2>
      <p>
        Исследование не смогло восстановить по публичным документам все обстоятельства
        передачи активов и изменения руководства. Это не досадные пустоты,
        которые можно заполнить догадкой, а граница доступных доказательств.
      </p>
      <p>
        В частности, неизвестны точный состав совета G3 в самые поздние дни кризиса,
        юридические подробности передачи G3+ и издательских прав, а также полный
        документальный путь отдельной операции с недвижимостью и связанными
        с ней суммами. Не установлена окончательная процедура отставок пасторов.
      </p>
      <p>
        Отдельной человеческой проверки требуют спорные эпизоды проповедей Бака,
        происхождение анонимных отправлений и предполагаемые мотивы.
        Нет достаточных данных для точной статистики политико-богословского
        содержания организации или сопоставимого ряда посещаемости.
      </p>
      <p>
        Если появится новый первичный документ, существенное изменение будет
        отражено открытым датированным исправлением, а не скрытой заменой выводов.
      </p>
      <p class="source-note-paragraph"><a class="source-note" href={handoffUrl} rel="noopener">Полный перечень и границы: G3-PUB-016</a></p>
    </div>
  </section>

  <section id="documents" class="module">
    <div class="module-label">09 · Документы</div>
    <div class="prose">
      <h2>На чём основан этот рассказ</h2>
      <p>
        Для финансовых выводов использованы налоговые формы американской
        некоммерческой организации, а для юридического статуса —
        запись реестра штата Джорджия на конкретную дату. Это позволяют
        проверять числа и формальный статус, но не являются самостоятельными
        выводами о преступлении или чьих-либо мотивах.
      </p>
      <p>
        Даты смены руководства и отмены конференций сверены с официальными
        сообщениями G3. Сведения о составе совета получены из архивной
        версии его официальной страницы. Там, где речь идёт о споре между
        людьми, необходимо отличать их собственные заявления от независимых
        документов и журналистских пересказов.
      </p>
      <p>
        Полная библиография приведена ниже с датировками, ссылками и
        оговорками по доступу. Не каждый источник разрешено воспроизводить
        целиком; ссылка на документ не превращает каждую изложенную в нём
        претензию в установленный факт.
      </p>
    </div>
  </section>

