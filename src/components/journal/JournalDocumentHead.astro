---
import ReaderPreferencesHead from '@/components/reader-platform/ReaderPreferencesHead.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  kind?: 'CollectionPage' | 'Article';
  publishedAt?: string;
  modifiedAt?: string;
  readingTime?: number;
}

const {
  title,
  description,
  canonical,
  kind = 'Article',
  publishedAt = '2026-09-09T00:00:00+03:00',
  modifiedAt = publishedAt,
  readingTime,
} = Astro.props as Props;

const siteTitle = `${title} | Господь Бог — Сила Моя`;
const icon = 'https://gospod-bog.ru/icons/icon-512.png';
const schemaType = kind;
const hasReadingTime = kind === 'Article' && Number.isInteger(readingTime) && Number(readingTime) > 0;
---
<meta charset="utf-8">
<link rel="preconnect" href="https://mc.yandex.ru" crossorigin>
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com; img-src 'self' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com wss://mc.yandex.ru wss://*.yandex.ru wss://mc.yandex.com wss://*.yandex.com; frame-src 'self' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self';">
<ReaderPreferencesHead />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content">
<meta name="theme-color" content="#fdfcf9" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#171411" media="(prefers-color-scheme: dark)">
<meta name="color-scheme" content="light dark">
<title>{siteTitle}</title>
<meta name="description" content={description}>
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
<meta name="author" content="Фёдор Милованов">
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.ico" type="image/x-icon">
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
<link rel="manifest" href="/manifest.json">
<meta property="og:type" content={kind === 'Article' ? 'article' : 'website'}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="Господь Бог — Сила Моя">
<meta property="og:locale" content="ru_RU">
<meta property="og:image" content={icon}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={icon}>
{kind === 'Article' && <meta property="article:published_time" content={publishedAt} />}
{kind === 'Article' && <meta property="article:modified_time" content={modifiedAt} />}
{hasReadingTime && <meta name="readingTime" content={`readingTime: ${readingTime}`} />}
<link rel="preload" as="style" href="/fonts/fonts.css?v=864cc57a">
<link rel="stylesheet" href="/fonts/fonts.css?v=864cc57a">
<link rel="stylesheet" href="/css/site.css?v=d1015157">
<link rel="stylesheet" href="/css/command-palette.css?v=3b88813f">
<link rel="stylesheet" href="/css/mobile-hotfix.css?v=a6a3187a">
<script is:inline type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://gospod-bog.ru/#organization',
      name: 'Господь Бог — Сила Моя',
      url: 'https://gospod-bog.ru/',
      logo: { '@type': 'ImageObject', url: icon, width: 512, height: 512 },
    },
    {
      '@type': schemaType,
      '@id': `${canonical}#journal`,
      name: title,
      headline: title,
      description,
      url: canonical,
      inLanguage: 'ru',
      datePublished: kind === 'Article' ? publishedAt : undefined,
      dateModified: modifiedAt,
      timeRequired: hasReadingTime ? `PT${readingTime}M` : undefined,
      author: kind === 'Article' ? { '@type': 'Person', name: 'Фёдор Милованов', url: 'https://gospod-bog.ru/about/' } : undefined,
      publisher: { '@id': 'https://gospod-bog.ru/#organization' },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: canonical.endsWith('/journal/')
        ? [
            { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://gospod-bog.ru/' },
            { '@type': 'ListItem', position: 2, name: 'Журнал', item: canonical },
          ]
        : [
            { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://gospod-bog.ru/' },
            { '@type': 'ListItem', position: 2, name: 'Журнал', item: 'https://gospod-bog.ru/journal/' },
            { '@type': 'ListItem', position: 3, name: 'Досье G3', item: canonical },
          ],
    },
  ],
})} />
