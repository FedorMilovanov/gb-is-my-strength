---
import graphData from '../../../data/links-graph.json';
import seriesData from '../../../data/series.json';

type Item = { title: string; url: string; readingTime?: number };
type SeriesEntry = { title: string; baseUrl: string; parts: Array<{ slug: string; title: string; status?: string; readingTime?: number }> };

function normalizeUrl(value: string) {
  const path = String(value || '/').replace(/\/{2,}/g, '/');
  return path.length > 1 && !path.endsWith('/') ? `${path}/` : path;
}

const byUrl = new Map<string, Item>();
for (const node of Array.isArray(graphData.nodes) ? graphData.nodes : []) {
  const url = normalizeUrl(String(node.url || ''));
  if (!url) continue;
  byUrl.set(url, { title: String(node.title || url), url, readingTime: Number(node.readingTime || 0) || undefined });
}
for (const series of Object.values(seriesData as Record<string, SeriesEntry>)) {
  for (const part of Array.isArray(series.parts) ? series.parts : []) {
    if (part.status && part.status !== 'published') continue;
    const url = normalizeUrl(`${series.baseUrl}${part.slug}/`);
    if (!byUrl.has(url)) byUrl.set(url, { title: part.title, url, readingTime: part.readingTime });
  }
}
const items = Array.from(byUrl.values()).sort((a, b) => a.title.localeCompare(b.title, 'ru'));
---

<noscript>
  <style>
    .atlas-app{display:none!important}
    body{overflow:auto!important;background:#080d15!important}
    .atlas-noscript{display:block;min-height:100vh;padding:32px 18px 70px;color:#ece5d8;font-family:system-ui,sans-serif}
    .atlas-noscript__inner{max-width:920px;margin:0 auto}
    .atlas-noscript a{color:inherit;text-decoration:none}
    .atlas-noscript__back{display:inline-flex;min-height:44px;align-items:center;color:#cdb57f!important;font-weight:700}
    .atlas-noscript h1{margin:30px 0 10px;font-family:Georgia,serif;font-size:clamp(34px,7vw,60px);line-height:1.05}
    .atlas-noscript__lead{max-width:700px;margin:0 0 30px;color:#9fa6b0;font-family:Georgia,serif;font-size:17px;line-height:1.65}
    .atlas-noscript ul{display:grid;gap:9px;margin:0;padding:0;list-style:none}
    .atlas-noscript li a{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:18px;min-height:58px;padding:12px 15px;border:1px solid rgba(255,255,255,.09);border-radius:12px;background:rgba(255,255,255,.025)}
    .atlas-noscript li strong{font-family:Georgia,serif;font-size:15px;line-height:1.35}
    .atlas-noscript li span{color:#747d89;font-size:11px;font-weight:700;white-space:nowrap}
    @media(max-width:520px){.atlas-noscript{padding-inline:12px}.atlas-noscript li a{min-height:64px;padding:12px}.atlas-noscript li strong{font-size:14px}}
  </style>
  <main class="atlas-noscript" id="atlasNoScriptList">
    <div class="atlas-noscript__inner">
      <a class="atlas-noscript__back" href="/">← На главную</a>
      <h1>Атлас исследований</h1>
      <p class="atlas-noscript__lead">
        Интерактивная карта требует JavaScript, но вся исследовательская библиотека остаётся доступна ниже обычным списком ссылок.
      </p>
      <ul>
        {items.map((item) => (
          <li data-list-node={item.url}>
            <a href={item.url}>
              <strong>{item.title}</strong>
              <span>{item.readingTime ? `${item.readingTime} мин.` : 'Открыть'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</noscript>
