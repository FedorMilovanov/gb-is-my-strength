---
import compiledRelations from '../../lib/relations/compiled';

const items = compiledRelations.nodes;
---

<noscript>
  <style>
    body{overflow:auto!important;background:#080d15!important}
    .atlas-app{min-height:0!important;height:auto!important;overflow:visible!important}
    .atlas-app::before,.atlas-app::after{display:none!important}
    .atlas-app .atlas-workspace,.atlas-app .atlas-search,.atlas-app .atlas-topbar__actions{display:none!important}
    .atlas-topbar{grid-template-columns:minmax(0,1fr)!important;height:auto!important;min-height:84px}
    .atlas-noscript{display:block;min-height:calc(100vh - 84px);padding:32px 18px 70px;color:#ece5d8;font-family:system-ui,sans-serif}
    .atlas-noscript__inner{max-width:920px;margin:0 auto}
    .atlas-noscript a{color:inherit;text-decoration:none}
    .atlas-noscript__lead{max-width:700px;margin:0 0 30px;color:#9fa6b0;font-family:Georgia,serif;font-size:17px;line-height:1.65}
    .atlas-noscript ul{display:grid;gap:9px;margin:0;padding:0;list-style:none}
    .atlas-noscript li a{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:18px;min-height:58px;padding:12px 15px;border:1px solid rgba(255,255,255,.09);border-radius:12px;background:rgba(255,255,255,.025)}
    .atlas-noscript li strong{font-family:Georgia,serif;font-size:15px;line-height:1.35}
    .atlas-noscript li span{color:#747d89;font-size:11px;font-weight:700;white-space:nowrap}
    @media(max-width:520px){.atlas-topbar{padding-inline:12px!important}.atlas-brand__mark{display:none!important}.atlas-noscript{padding-inline:12px}.atlas-noscript li a{min-height:64px;padding:12px}.atlas-noscript li strong{font-size:14px}}
  </style>
  <main class="atlas-noscript" id="atlasNoScriptList" aria-labelledby="atlasPageTitle">
    <div class="atlas-noscript__inner">
      <p class="atlas-noscript__lead">
        Интерактивная карта требует JavaScript, но вся исследовательская библиотека остаётся доступна ниже обычным списком ссылок.
      </p>
      <ul>
        {items.map((item) => (
          <li data-list-node={item.id}>
            <a href={item.url}>
              <strong>{item.title}</strong>
              <span>{item.readingTime ? `${item.readingTime} мин.` : 'Открыть'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</noscript>
