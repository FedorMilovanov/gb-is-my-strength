<section class="sr-only" data-pagefind-body>
  <h2>Карта связей сайта</h2>
  <p>Карта связей показывает, как основные разделы проекта «Господь Бог — Сила Моя» соединены между собой. В центре находится главная страница, от которой расходятся тематические кластеры: библейские карты, серия о баптистах России, Нагорная проповедь, материалы о Джоне Гилле, трудные тексты Писания, биографические и справочные страницы.</p>
  <p>Этот раздел нужен не как обычный список ссылок, а как обзорная навигация по смысловым связям. Узлы карты помогают увидеть, какие статьи относятся к историческому исследованию, какие — к экзегетике, какие — к интерактивным картам и какие материалы лучше читать рядом. Интерактивная карта дополняет каталоги и поиск: она показывает не только отдельные страницы, но и отношения между сериями, темами и маршрутами чтения.</p>
  <p>Визуальный слой страницы остаётся интерактивным SVG-созвездием, а этот текстовый слой обеспечивает доступность, индексируемость и понятное описание раздела для поиска и вспомогательных технологий.</p>
</section>

<script is:inline>
// Полноценная премиум-версия карты связей (упрощённая, но визуально и функционально на уровне karty)
const W=1920,H=1200;
const svg=document.getElementById('cnv');
svg.setAttribute('viewBox',`0 0 ${W} ${H}`);

const nodes=[
  {id:'root',label:'Главная',x:960,y:300,type:'landing',r:22},
  {id:'karty',label:'Библейские карты',x:620,y:420,type:'karty',r:18},
  {id:'avraam',label:'Путь Авраама',x:480,y:520,type:'karty',r:14},
  {id:'ishod',label:'Исход из Египта',x:560,y:580,type:'karty',r:14},
  {id:'pavel',label:'Путешествия Павла',x:700,y:540,type:'karty',r:14},
  {id:'baptisty',label:'Баптисты России',x:1240,y:380,type:'stand',r:18},
  {id:'nagornaya',label:'Нагорная проповедь',x:820,y:680,type:'nag',r:18},
  {id:'gill',label:'Джон Гилл',x:380,y:680,type:'gill',r:18},
  {id:'hard',label:'Трудные тексты',x:1100,y:720,type:'hard',r:16},
  {id:'about',label:'Об авторе',x:960,y:180,type:'landing',r:14},
];

const edges=[
  ['root','karty'],['root','baptisty'],['root','nagornaya'],['root','gill'],['root','hard'],['root','about'],
  ['karty','avraam'],['karty','ishod'],['karty','pavel'],
  ['baptisty','nagornaya'],['nagornaya','hard'],['gill','hard']
];

let currentFilter=null;

function draw(){
  svg.innerHTML='';
  const defs=document.createElementNS('http://www.w3.org/2000/svg','defs');
  svg.appendChild(defs);
  
  // edges
  edges.forEach(([a,b])=>{
    const na=nodes.find(n=>n.id===a),nb=nodes.find(n=>n.id===b);
    const line=document.createElementNS('http://www.w3.org/2000/svg','line');
    line.setAttribute('x1',na.x);line.setAttribute('y1',na.y);
    line.setAttribute('x2',nb.x);line.setAttribute('y2',nb.y);
    line.setAttribute('class','edge');
    line.setAttribute('data-a',a);line.setAttribute('data-b',b);
    svg.appendChild(line);
  });
  
  // nodes
  nodes.forEach(n=>{
    const g=document.createElementNS('http://www.w3.org/2000/svg','g');
    g.setAttribute('class','node');
    g.setAttribute('data-id',n.id);
    g.setAttribute('data-type',n.type);
    
    const halo=document.createElementNS('http://www.w3.org/2000/svg','circle');
    halo.setAttribute('cx',n.x);halo.setAttribute('cy',n.y);halo.setAttribute('r',n.r+14);
    halo.setAttribute('class','halo');halo.setAttribute('fill','none');halo.setAttribute('stroke',getColor(n.type));halo.setAttribute('stroke-width','1.5');
    
    const core=document.createElementNS('http://www.w3.org/2000/svg','circle');
    core.setAttribute('cx',n.x);core.setAttribute('cy',n.y);core.setAttribute('r',n.r);
    core.setAttribute('class','core');core.setAttribute('fill',getColor(n.type));
    
    const label=document.createElementNS('http://www.w3.org/2000/svg','text');
    label.setAttribute('x',n.x);label.setAttribute('y',n.y+28);
    label.setAttribute('text-anchor','middle');label.setAttribute('class','lbl');
    label.textContent=n.label;
    
    g.appendChild(halo);g.appendChild(core);g.appendChild(label);
    svg.appendChild(g);
    
    g.addEventListener('click',()=>showCard(n));
    g.addEventListener('mouseenter',()=>highlight(n.id));
    g.addEventListener('mouseleave',unlight);
  });
}

function getColor(type){
  if(type==='gill')return'#d4a574';
  if(type==='hard')return'#7da2e8';
  if(type==='nag')return'#5fc9a8';
  if(type==='stand')return'#c9b186';
  if(type==='karty')return'#a78bfa';
  return'#f4a261';
}

function highlight(id){
  document.querySelectorAll('.edge').forEach(e=>{
    if(e.dataset.a===id||e.dataset.b===id)e.classList.add('lit');
    else e.classList.add('dim');
  });
  document.querySelectorAll('.node').forEach(g=>{
    if(g.dataset.id===id)g.classList.add('lit');
    else g.classList.add('dim');
  });
}

function unlight(){
  document.querySelectorAll('.edge,.node').forEach(el=>el.classList.remove('lit','dim'));
}

function showCard(n){
  const card=document.getElementById('card');
  document.getElementById('card-title').textContent=n.label;
  document.getElementById('card-type').textContent=n.type.toUpperCase();
  document.getElementById('card-desc').textContent=getDesc(n);
  
  const links=document.getElementById('card-links');
  links.innerHTML='';
  const related=edges.filter(e=>e[0]===n.id||e[1]===n.id).map(e=>e[0]===n.id?e[1]:e[0]);
  related.forEach(rid=>{
    const rn=nodes.find(x=>x.id===rid);
    if(rn){
      const a=document.createElement('a');
      a.href=`/${rid==='root'?'':rid+'/'}`;
      a.textContent=rn.label;
      links.appendChild(a);
    }
  });
  
  card.classList.add('open');
  card.onclick=e=>{if(e.target===card)card.classList.remove('open');};
}

function getDesc(n){
  if(n.id==='karty')return'Интерактивные библейские карты: Путь Авраама, Исход, Путешествия Павла.';
  if(n.id==='baptisty')return'11 статей о русском баптизме — от истоков до советского периода.';
  if(n.id==='nagornaya')return'8 частей Нагорной проповеди + источники и находки.';
  if(n.id==='gill')return'Серия из 7 статей о жизни и богословии Джона Гилла.';
  if(n.id==='hard')return'Три глубоких разбора трудных библейских текстов.';
  return'Связанный материал на сайте.';
}

function setupFilters(){
  document.querySelectorAll('.lg').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const type=btn.dataset.filter;
      if(currentFilter===type){
        currentFilter=null;
        document.querySelectorAll('.node').forEach(g=>g.style.opacity='1');
        btn.classList.remove('solo');
      }else{
        currentFilter=type;
        document.querySelectorAll('.lg').forEach(b=>b.classList.remove('solo'));
        btn.classList.add('solo');
        document.querySelectorAll('.node').forEach(g=>{
          g.style.opacity=g.dataset.type===type?'1':'0.15';
        });
      }
    });
  });
}

draw();
setupFilters();

// Keyboard
document.addEventListener('keydown',e=>{
  if(e.key==='Escape')document.getElementById('card').classList.remove('open');
});
</script>

