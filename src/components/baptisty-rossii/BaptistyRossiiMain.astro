---
/**
 * BaptistyRossiiMain.astro — <main id="main-content">...</main> of /baptisty-rossii/.
 *
 * Refactoring 6.0 parallel pilot: the route no longer proxies one monolithic
 * `_legacy/main.html?raw` block. Instead, the GBS2 landing main shell is
 * assembled from named legacy-faithful fragments while preserving exact DOM,
 * copy and premium series layout.
 *
 * Pixel-parity contract remains guarded via
 *   npm run visual:parity:screenshots -- --routes /baptisty-rossii/ --threshold 0.5
 * and source-contract audit in scripts/baptisty-rossii-visual-parity-audit.js.
 */
import headerHero from './_legacy/header-hero.html?raw';
import articleBody from './_legacy/article-body.html?raw';
import postArticle from './_legacy/post-article.html?raw';
---

<main id="main-content"><Fragment set:html={headerHero} /><Fragment set:html={articleBody} /><Fragment set:html={postArticle} /></main>
