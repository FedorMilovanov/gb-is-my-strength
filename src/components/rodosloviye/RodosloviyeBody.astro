      margin-top: clamp(50px, 7vw, 82px);
    }
    .genealogy-section-heading {
      max-width: 760px;
    }
    .genealogy-section-heading h2 {
      margin: 0;
      font-size: clamp(28px, 4vw, 44px);
      line-height: 1.1;
      letter-spacing: -.025em;
    }
    .genealogy-entry__grid,
    .genealogy-methodology__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin-top: 24px;
    }
    .genealogy-entry-card,
    .genealogy-methodology__grid article {
      min-width: 0;
      padding: 22px;
      border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
      border-radius: 18px;
      background: color-mix(in srgb, var(--color-bg) 97%, var(--color-text) 3%);
    }
    .genealogy-entry-card__index {
      display: block;
      margin-bottom: 32px;
      color: var(--color-text-muted);
      font: 700 11px/1 system-ui, sans-serif;
      letter-spacing: .08em;
    }
    .genealogy-entry-card h3,
    .genealogy-methodology__grid h3 {
      margin: 0;
      color: var(--color-text);
      font-size: 19px;
      line-height: 1.25;
    }
    .genealogy-entry-card p,
    .genealogy-methodology__grid p,
    .genealogy-methodology__intro,
    .genealogy-methodology__note {
      color: var(--color-text-muted);
      line-height: 1.6;
    }
    .genealogy-entry-card p {
      min-height: 5.1em;
      margin: 10px 0 18px;
      font-size: 14px;
    }
    .genealogy-entry-card a {
      font-weight: 650;
    }
    .genealogy-methodology__intro {
      max-width: 78ch;
      margin: 16px 0 0;
      font-size: 16px;
    }
    .genealogy-methodology__mark {
      display: block;
      width: 12px;
      height: 12px;
      margin-bottom: 18px;
      border: 2px solid currentColor;
      border-radius: 999px;
    }
    .genealogy-methodology__mark[data-state="reviewed"] { color: #4f7a38; background: #4f7a38; }
    .genealogy-methodology__mark[data-state="interpretive"] { color: #9a6b2f; background: #9a6b2f; }
    .genealogy-methodology__mark[data-state="pending"] { color: #7c7569; background: transparent; }
    .genealogy-methodology__grid p {
      margin: 9px 0 0;
      font-size: 14px;
    }
    .genealogy-methodology__note {
      margin: 20px 0 0;
      padding: 15px 18px;
      border-left: 3px solid var(--color-accent);
      background: color-mix(in srgb, var(--color-accent) 7%, transparent);
      font-size: 13px;
    }
    html.dark .genealogy-hero,
    html.dark .genealogy-entry-card,
    html.dark .genealogy-methodology__grid article {
      box-shadow: none;
    }
    @media (max-width: 860px) {
      .genealogy-hero {
        grid-template-columns: 1fr;
      }
      .genealogy-hero h1 {
        max-width: 14ch;
      }
      .genealogy-entry__grid,
      .genealogy-methodology__grid {
        grid-template-columns: 1fr;
      }
      .genealogy-entry-card p {
        min-height: auto;
      }
    }
    @media (max-width: 600px) {
      .genealogy-department {
        width: min(100%, 100vw);
        padding-left: 16px;
        padding-right: 16px;
      }
      .genealogy-hero {
        padding: 24px 18px;
        border-radius: 18px;
      }
      .genealogy-hero__actions {
        display: grid;
      }
      .genealogy-hero__actions .btn {
        width: 100%;
        justify-content: center;
        text-align: center;
      }
    }
