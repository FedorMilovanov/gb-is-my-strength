    .genealogy-department .breadcrumb {
      margin-bottom: clamp(22px, 3vw, 34px);
    }
    .genealogy-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(280px, .8fr);
      gap: clamp(28px, 5vw, 64px);
      align-items: stretch;
      padding: clamp(28px, 5vw, 58px);
      border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
      border-radius: 24px;
      background:
        radial-gradient(circle at 12% 12%, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 38%),
        color-mix(in srgb, var(--color-bg) 96%, var(--color-text) 4%);
      box-shadow: 0 20px 55px color-mix(in srgb, #000 9%, transparent);
    }
    .genealogy-hero__copy {
      align-self: center;
    }
    .genealogy-hero h1 {
      max-width: 12ch;
      margin: 0;
      font-size: clamp(40px, 7vw, 78px);
      line-height: .98;
      letter-spacing: -.035em;
      text-wrap: balance;
    }
    .genealogy-hero__lead {
      max-width: 64ch;
      margin: 22px 0 0;
      color: var(--color-text-muted);
      font-size: clamp(17px, 2vw, 21px);
      line-height: 1.6;
    }
    .genealogy-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 28px;
    }
    .genealogy-hero__facts {
      display: grid;
      gap: 1px;
      margin: 0;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
      border-radius: 18px;
      background: color-mix(in srgb, var(--color-text) 11%, transparent);
    }
    .genealogy-hero__facts > div {
      padding: 18px 20px;
      background: color-mix(in srgb, var(--color-bg) 96%, var(--color-text) 4%);
