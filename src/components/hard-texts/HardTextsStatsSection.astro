---
/**
 * HardTextsStatsSection.astro — compact stat cards for /hard-texts/.
 *
 * Refactoring 6.0 parallel pilot: semantic extraction from legacy main shell.
 * Preserve every class, inline style and visible string.
 */
---
<section class="h-section h-reveal" style="padding-top:0;" aria-label="О серии">
  <div class="h-grid-4" role="list" style="grid-template-columns:repeat(auto-fit,minmax(140px,1fr));">
    <div class="h-card-glass h-reveal h-reveal-d1" role="listitem" style="text-align:center;display:block;padding:18px 16px;">
      <div style="font-size:2rem;font-weight:700;color:var(--h-accent);font-family:var(--h-font-display);">3</div>
      <p class="h-card-desc" style="margin-top:4px;">части (план)</p>
    </div>
    <div class="h-card-glass h-reveal h-reveal-d2" role="listitem" style="text-align:center;display:block;padding:18px 16px;">
      <div style="font-size:2rem;font-weight:700;color:var(--h-accent);font-family:var(--h-font-display);">2</div>
      <p class="h-card-desc" style="margin-top:4px;">опубликовано</p>
    </div>
    <div class="h-card-glass h-reveal h-reveal-d3" role="listitem" style="text-align:center;display:block;padding:18px 16px;">
      <div style="font-size:2rem;font-weight:700;color:var(--h-accent);font-family:var(--h-font-display);">53</div>
      <p class="h-card-desc" style="margin-top:4px;">минут чтения</p>
    </div>
    <div class="h-card-glass h-reveal h-reveal-d4" role="listitem" style="text-align:center;display:block;padding:18px 16px;">
      <div style="font-size:2rem;font-weight:700;color:var(--h-accent);font-family:var(--h-font-display);">Иер · Рим</div>
      <p class="h-card-desc" style="margin-top:4px;">основные тексты</p>
    </div>
  </div>
</section>
