---
/**
 * HardTextsPageChrome.astro — full body chrome / layout shell for /hard-texts/.
 *
 * 100% native Astro component (visual-fix-hard-texts-2026-06-23).
 * Replaces the former `_legacy/body-segment-0.html?raw` + `body-segment-1.html?raw`
 * raw fragments.
 *
 * IMPORTANT (Astro constraint): a tag opened inside one component CANNOT be
 * closed inside another — Astro's compiler auto-closes every element at the
 * component boundary. The legacy page wraps <main>/<aside>/<footer> inside
 * `<div class="home-v20"><div class="home-content">`, so this shell OWNS that
 * wrapper (opens AND closes it here) and exposes a default <slot/> where the
 * page injects <HardTextsMain> + <HardTextsPageFooter>. This reproduces the
 * exact legacy DOM nesting:
 *
 *   <body>
 *     skip-link · reading-progress · nav · mobile nav
 *     <div class="home-v20"><div class="home-content">
 *       <section class="h-hero">…</section>
 *       <slot/>          ← main, aside, footer land here
 *     </div></div>
 *     scroll-top · runtime <script>s
 *   </body>
 *
 * JS asset hashes are computed at build time via md5short, matching
 * scripts/cache-bust.js so legacy and dist share identical ?v= values.
 */
import { ASSET_VERSIONS } from '@/lib/asset-version';

const siteUtils = ASSET_VERSIONS['js/site-utils.js'];
const scrollPerf = ASSET_VERSIONS['js/scroll-perf.js'];
const siteJs = ASSET_VERSIONS['js/site.js'];
const highlights = ASSET_VERSIONS['js/highlights.js'];
const enhancements = ASSET_VERSIONS['js/enhancements.js'];
const swRegister = ASSET_VERSIONS['js/sw-register.js'];
const search = ASSET_VERSIONS['js/search.js'];
---
<a href="#main-content" class="skip-link">Перейти к содержимому</a>

<div class="h-reading-progress" id="hReadingProgress" aria-hidden="true"></div>

<nav class="h-navbar" id="hNavbar" role="navigation" aria-label="Основная навигация">
  <div class="h-navbar__inner">
    <a href="../" class="h-nav-logo" aria-label="Господь Бог — Сила Моя — на главную">
      <span class="h-nav-logo-main">Господь Бог</span>
      <span class="h-nav-logo-dash" aria-hidden="true">&nbsp;—&nbsp;</span>
      <span class="h-nav-logo-accent">Сила Моя</span>
    </a>
    {/* Desktop nav links */}
    <ul class="h-nav-links" role="list">
      <li><a href="../#publikacii">Публикации</a></li>
      <li><a href="../#razbor">Разбор заблуждений</a></li>
      <li><a href="../biografii/">Биографии</a></li>
      <li><a href="../articles/">Все статьи</a></li>
      <li><a href="../about/">О проекте</a></li>
    </ul>

    {/* Controls: тема + бургер. Единая кнопка темы (как на главной). */}
    <div class="mobile-controls">
      <button class="theme-toggle" id="themeToggle" aria-label="Переключить тему">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z"></path></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      </button>
      <button class="h-mobile-menu-btn" id="hMobileMenuBtn" aria-label="Открыть меню" aria-expanded="false">
        <svg class="h-burger-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line class="burger-top" x1="3" y1="6" x2="21" y2="6"></line>
          <line class="burger-mid" x1="3" y1="12" x2="21" y2="12"></line>
          <line class="burger-bottom" x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</nav>

{/* Mobile nav backdrop */}
<div id="hMobileBackdrop" class="h-mobile-backdrop" aria-hidden="true"></div>

<div class="h-mobile-nav" id="hMobileNav" aria-hidden="true">
  <a href="../#publikacii" data-close-nav>Публикации</a>
  <a href="../#razbor" data-close-nav>Разбор заблуждений</a>
  <a href="../biografii/" data-close-nav>Биографии</a>
  <a href="../articles/" data-close-nav>Все статьи</a>
  <a href="../about/" data-close-nav>О проекте</a>
</div>

<div class="home-v20">
  <div class="home-content">

    <section class="h-hero" data-pagefind-body aria-label="Серия статей">
      <nav aria-label="Хлебные крошки" style="margin-bottom:16px;">
        <ol style="list-style:none;padding:0;margin:0;display:flex;align-items:center;gap:6px;font-size:13px;flex-wrap:wrap;">
          <li><a href="../" class="gb-text-link">Главная</a></li>
          <li aria-hidden="true" style="color:var(--h-muted);opacity:.5;">›</li>
          <li aria-current="page" style="color:var(--h-text,var(--text));font-weight:500;">Тайны человеческого сердца</li>
        </ol>
      </nav>

      <p class="h-hero-tagline">Авторская серия</p>
      <h1 class="h-hero-title" tabindex="-1">
        <span class="h-title-static">Тайны человеческого</span><span class="h-title-dash" aria-hidden="true">&nbsp;</span><span class="h-title-accent">сердца</span>
      </h1>

      <section class="summary-card" aria-labelledby="summary-title-auto" data-speakable>
        <h2 id="summary-title-auto" class="summary-card__head">Коротко</h2>
        <ol class="summary-card__body" role="list">
          <li class="summary-card__item">
            <span class="summary-card__num" aria-hidden="true" data-num="01"></span>
            <p class="summary-card__text">Серия — последовательная экзегеза ключевых текстов о состоянии человеческого сердца: Иеремия 17, Римлянам 7 и Римлянам 8.</p>
          </li>
          <li class="summary-card__item">
            <span class="summary-card__num" aria-hidden="true" data-num="02"></span>
            <p class="summary-card__text">Главные вопросы: остаётся ли сердце верующего «крайне испорченным», кто говорит в Римлянам 7, и как Дух освобождает от закона греха и смерти.</p>
          </li>
          <li class="summary-card__item">
            <span class="summary-card__num" aria-hidden="true" data-num="03"></span>
            <p class="summary-card__text">Подход — историко-грамматический: контекст, оригинальные языки, богословский синтез и пастырское применение.</p>
          </li>
          <li class="summary-card__item">
            <span class="summary-card__num" aria-hidden="true" data-num="04"></span>
            <p class="summary-card__text">Цель — помочь верующему трезво смотреть на свою греховность, не теряя радости евангельской свободы и уверенности во Христе.</p>
          </li>
        </ol>
      </section>

      <p class="h-hero-desc">
        Цикл экзегетических разборов о природе падшего и возрождённого сердца. Иеремия 17:9–10, Римлянам 7 и Римлянам 8 — три ключевых текста, через которые Писание раскрывает тайну внутреннего человека.
      </p>
      <hr class="h-rule" aria-hidden="true" />
    </section>

    <slot />

  </div>
</div>

<button class="h-scroll-top" id="hScrollTop" aria-label="Наверх">
  <svg class="h-progress-ring" width="50" height="50" viewBox="0 0 50 50" aria-hidden="true">
    <circle class="h-progress-ring-circle" id="hProgressCircle" cx="25" cy="25" r="22" style="stroke-dasharray: 138.23; stroke-dashoffset: 138.23;"></circle>
  </svg>
  <span class="h-scroll-top-arrow" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="18 15 12 9 6 15"></polyline></svg>
  </span>
</button>

<script is:inline src={`../js/site-utils.js?v=${siteUtils}`}></script>
<script is:inline src={`../js/scroll-perf.js?v=${scrollPerf}`}></script>
<script is:inline src={`../js/site.js?v=${siteJs}`} defer></script>
{/* home infrastructure handled by js/site.js module 35 */}

<script is:inline src={`../js/highlights.js?v=${highlights}`} defer></script>
<script is:inline src={`../js/enhancements.js?v=${enhancements}`} defer></script>
<script is:inline src={`../js/sw-register.js?v=${swRegister}`} defer></script>
<script is:inline src={`../js/search.js?v=${search}`} defer></script>
