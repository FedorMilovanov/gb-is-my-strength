---
/**
 * HardTextsMain.astro — <main id="main-content"> of /hard-texts/.
 *
 * Refactoring 6.0 parallel pilot: the route no longer proxies one monolithic
 * `_legacy/main.html?raw` block. Instead, the semantic main shell is composed
 * from named Astro components while preserving legacy DOM/classes/text.
 *
 * Pixel-parity contract remains guarded via
 *   npm run visual:parity:screenshots -- --routes /hard-texts/
 * and source-contract audit in scripts/hard-texts-visual-parity-audit.js.
 */
import HardTextsCardsSection from './HardTextsCardsSection.astro';
import HardTextsStatsSection from './HardTextsStatsSection.astro';
import HardTextsSeriesMapSection from './HardTextsSeriesMapSection.astro';
import HardTextsArticleEndBlock from './HardTextsArticleEndBlock.astro';
---
<main id="main-content" data-pagefind-body>
  <HardTextsCardsSection />
  <HardTextsStatsSection />
  <HardTextsSeriesMapSection />
  <HardTextsArticleEndBlock />
</main>