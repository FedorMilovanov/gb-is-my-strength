---
/**
 * ArticlesPublicationsSection.astro — native publications grid for /articles/.
 *
 * Markup is hand-authored Astro matching the legacy premium cards. Series count
 * labels are received from ArticlesMain, which derives them from data/series.json.
 */
interface Props {
  hardTextsPartsLabel: string;
  genesis6PartsLabel: string;
  nagornayaPartsLabel: string;
  gillReadingTime: Record<string, number>;
}

const { hardTextsPartsLabel, genesis6PartsLabel, nagornayaPartsLabel, gillReadingTime } = Astro.props;
---
<!-- ПУБЛИКАЦИИ -->
    <section class="h-section h-reveal" id="publikacii" aria-labelledby="hPublicationsLabel">
      <p class="h-section-label" id="hPublicationsLabel">Публикации</p>
      <div class="h-section-accent" aria-hidden="true"></div>

      <div class="h-articles-group">
        <ul class="h-article-list h-article-list--grid">

          <!-- Бытие 6, Енох, Иуда и Пётр — серия -->
          <li class="h-article-li--full">
            <a href="/hard-texts/genesis-6/" class="h-article-card" style="border:2px solid #876f45;border-radius:14px;overflow:hidden;background:linear-gradient(135deg,#181715,#29251e);color:#f5efe3;">
              <div class="h-article-thumb" style="position:relative;">
                <picture>
                  <source srcset="/images/articles/genesis6/00-series-guide.avif" type="image/avif">
                  <img src="/images/articles/genesis6/00-series-guide.webp"
                       alt="Бытие 6, Енох, Иуда и Пётр — исследовательская серия"
                       decoding="async" loading="lazy" width="160" height="108">
                </picture>
                <span style="position:absolute;top:6px;right:6px;background:#876f45;color:#fff;font-size:10px;font-weight:700;padding:2px 7px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;">Серия</span>
              </div>
              <div class="h-article-body">
                <h2 class="h-article-title" style="color:#f3dfb0;">Бытие 6, Енох, Иуда и Пётр</h2>
                <div class="h-article-meta">
                  <span class="h-meta-author">Автор-редактор: Фёдор Милованов</span>
                  <span class="h-meta-sep" aria-hidden="true">·</span>
                  <span class="h-meta-tag h-meta-tag--neutral">{genesis6PartsLabel}</span>
                  <span class="h-meta-tag">Трудные тексты</span>
                  <span class="h-meta-tag">Текстология</span>
                </div>
                <p class="h-article-abstract">Шесть связанных разборов: пророчество Еноха у Иуды, состав и рукописи 1 Еноха, канонический аудит, согрешившие ангелы, духи в темнице и благовестие мёртвым.</p>
                <div style="margin-top:8px;display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#f3dfb0;">
                  Открыть серию
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </div>
              </div>
            </a>
          </li>

          <!-- Джон Гилл — исторический контекст -->
          <li>
            <a href="dzhon-gill-istoricheskiy-kontekst/" class="h-article-card">
              <div class="h-article-thumb">
                <picture>
                  <source srcset="../images/og-dzhon-gill-istoricheskiy-kontekst-600w.webp" type="image/webp">
                  <img src="../images/og-dzhon-gill-istoricheskiy-kontekst.jpg"
                     alt="Джон Гилл: исторический контекст"
                     decoding="async" loading="lazy" width="160" height="108">
                </picture>
              </div>
              <div class="h-article-body">
                <h2 class="h-article-title">Джон Гилл: исторический контекст — диссентеры, Саутварк, книги</h2>
                <div class="h-article-meta">
                  <span class="h-meta-author">Автор-редактор: Фёдор Милованов</span>
                  <span class="h-meta-sep" aria-hidden="true">·</span>
                  <span class="h-meta-time">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {gillReadingTime['dzhon-gill-istoricheskiy-kontekst']} мин
                  </span>
                  <span class="h-meta-tag h-meta-tag--neutral">Биография</span>
                </div>
                <p class="h-article-abstract">Англия после Акта о единообразии: условная терпимость, гражданские и университетские ограничения, диссентерские академии, Саутварк и книжная культура XVIII века.</p>
              </div>
            </a>
          </li>

          <!-- Джон Гилл — справочник -->
          <li>
            <a href="dzhon-gill-spravochnik/" class="h-article-card">
              <div class="h-article-thumb"><picture><source srcset="../images/gill-library-shelf-600w.webp" type="image/webp"><img src="../images/gill-library-shelf.webp" alt="Джон Гилл: справочник — обложка" decoding="async" loading="lazy" width="160" height="108"></picture></div>
              <div class="h-article-body">
                <h2 class="h-article-title">Джон Гилл: справочник — хронология, труды, источники</h2>
                <div class="h-article-meta"><span class="h-meta-author">Автор-редактор: Фёдор Милованов</span><span class="h-meta-sep" aria-hidden="true">·</span><span class="h-meta-time">{gillReadingTime['dzhon-gill-spravochnik']} мин</span><span class="h-meta-tag h-meta-tag--neutral">Биография</span></div>
                <p class="h-article-abstract">Хронология жизни и изданий, основные труды, структура Body of Divinity, источники, спорные темы и богословский словарь эпохи.</p>
              </div>
            </a>
          </li>

          <!-- Серия: Тайны человеческого сердца — full-width баннер -->
          <li class="h-article-li--full">
            <a href="/hard-texts/" class="h-article-card" style="border:2px solid #7c2d2d;border-radius:14px;overflow:hidden;background:linear-gradient(135deg,#f6ece8,#fff);">
              <div class="h-article-thumb" style="position:relative;">
                <picture>
                  <source srcset="../images/og-series-heart-600w.webp 600w, ../images/og-series-heart-900w.webp 900w" sizes="(max-width:640px) 600px, 900px" type="image/webp">
                  <img src="../images/og-series-heart.webp"
                       alt="Тайны человеческого сердца — серия экзегетических разборов"
                       decoding="async" loading="lazy" width="160" height="108">
                </picture>
                <span style="position:absolute;top:6px;right:6px;background:#7c2d2d;color:#fff;font-size:10px;font-weight:700;padding:2px 7px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;">Серия</span>
              </div>
              <div class="h-article-body">
                <h2 class="h-article-title" style="color:#5f2323;">Тайны человеческого сердца — серия</h2>
                <div class="h-article-meta">
                  <span class="h-meta-author">Автор-редактор: Фёдор Милованов</span>
                  <span class="h-meta-sep" aria-hidden="true">·</span>
                  <span class="h-meta-tag h-meta-tag--neutral">{hardTextsPartsLabel}</span>
                  <span class="h-meta-tag">Иеремия 17 · Римлянам 7–8</span>
                  <span class="h-meta-tag">Экзегеза</span>
                </div>
                <p class="h-article-abstract">Цикл экзегетических разборов о природе падшего и возрождённого сердца. Иеремия 17:9–10, Римлянам 7 и Римлянам 8 — три ключевых текста, через которые Писание раскрывает тайну внутреннего человека.</p>
                <div style="margin-top:8px;display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#7c2d2d;">
                  Открыть серию
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </div>
              </div>
            </a>
          </li>

          <!-- Иеремия 17 -->
          <li>
            <a href="krajne-li-isporcheno-serdce/" class="h-article-card">
              <div class="h-article-thumb">
                <picture>
                  <source srcset="../images/og-krajne-isporcheno-600w.webp" type="image/webp">
                  <img src="../images/og-krajne-isporcheno.jpg"
                     alt="Крайне ли испорчено сердце верующего?"
                     decoding="async" loading="lazy" width="160" height="108">
                </picture>
              </div>
              <div class="h-article-body">
                <h2 class="h-article-title">Крайне ли испорчено моё сердце — если я уже верующий?</h2>
                <div class="h-article-meta">
                  <span class="h-meta-author">Редактор: Фёдор Милованов</span>
                  <span class="h-meta-sep" aria-hidden="true">·</span>
                  <span class="h-meta-time">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    41 мин
                  </span>
                  <span class="h-meta-tag h-meta-tag--neutral">Авторская статья</span>
                  <span class="h-meta-tag">Экзегеза</span>
                </div>
                <p class="h-article-abstract">Разбор Иеремии 17:9–10: что значит «сердце обманчиво более всего» — и относится ли это к верующему? Экзегеза, богословский синтез и пастырское применение.</p>
              </div>
            </a>
          </li>

          <!-- Римлянам 7 -->
          <li>
            <a href="rimlyanam-7-veruyushchiy-ili-neveruyushchiy/" class="h-article-card">
              <div class="h-article-thumb">
                <picture>
                  <source srcset="../images/og-rimlyanam-7-600w.webp" type="image/webp">
                  <img src="../images/og-rimlyanam-7.jpg"
                     alt="Римлянам 7: верующий или неверующий?"
                     decoding="async" loading="lazy" width="160" height="108">
                </picture>
              </div>
              <div class="h-article-body">
                <h2 class="h-article-title">Римлянам 7: верующий, неверующий или человек под законом?</h2>
                <div class="h-article-meta">
                  <span class="h-meta-author">Редактор: Фёдор Милованов</span>
                  <span class="h-meta-sep" aria-hidden="true">·</span>
                  <span class="h-meta-time">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    12 мин
                  </span>
                  <span class="h-meta-tag h-meta-tag--neutral">Авторская статья</span>
                  <span class="h-meta-tag">Экзегеза</span>
                </div>
                <p class="h-article-abstract">Кто такой человек из Римлянам 7:14–25? Разбор ключевых экзегетических подходов и почему конфликт «внутреннего человека» и «плоти» так важен для понимания освящения.</p>
              </div>
            </a>
          </li>

          <!-- 20 антисоветов пастору -->
          <li>
            <a href="20-antisovetov-pastoru/" class="h-article-card">
              <div class="h-article-thumb">
                <picture>
                  <source srcset="../images/pastor-series/og-hero.webp" type="image/webp">
                  <img src="../images/pastor-series/og-hero.webp"
                     alt="20 антисоветов пастору — как разрушить своё служение"
                     decoding="async" loading="lazy" width="160" height="108">
                </picture>
              </div>
              <div class="h-article-body">
                <h2 class="h-article-title">20 антисоветов, как пастору разрушить своё служение</h2>
                <div class="h-article-meta">
                  <span class="h-meta-author">Автор-редактор: Фёдор Милованов</span>
                  <span class="h-meta-sep" aria-hidden="true">·</span>
                  <span class="h-meta-time">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    67 мин
                  </span>
                  <span class="h-meta-tag h-meta-tag--neutral">Авторская статья</span>
                </div>
                <p class="h-article-abstract">Системный библейский разбор искажений пастырской власти: власть, подотчётность, страх, манипуляция Писанием и путь к здоровой церковной культуре.</p>
              </div>
            </a>
          </li>

          <!-- Нагорная проповедь — ПОЛНАЯ СЕРИЯ ({nagornayaPartsLabel}) -->
          <li class="h-article-li--full">
            <a href="/nagornaya/seriya/" class="h-article-card" style="border:2px solid #d97706;border-radius:14px;overflow:hidden;background:linear-gradient(135deg,#fefce8,#fff);">
              <div class="h-article-thumb" style="position:relative;">
                <img src="../images/og-nagornaya-propoved.webp"
                     alt="Нагорная проповедь — полная серия"
                     decoding="async" loading="lazy" width="160" height="108">
                <span style="position:absolute;top:6px;right:6px;background:#d97706;color:#fff;font-size:10px;font-weight:700;padding:2px 7px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;">Серия</span>
              </div>
              <div class="h-article-body">
                <h2 class="h-article-title" style="color:#92400e;">Нагорная проповедь — полная серия</h2>
                <div class="h-article-meta">
                  <span class="h-meta-author">Автор-редактор: Фёдор Милованов</span>
                  <span class="h-meta-sep" aria-hidden="true">·</span>
                  <span class="h-meta-tag h-meta-tag--neutral">{nagornayaPartsLabel}</span>
                  <span class="h-meta-tag">120+ источников</span>
                  <span class="h-meta-tag">2026</span>
                </div>
                <p class="h-article-abstract">Полная серия по Матфея 5–7 и Луки 6:17–49: содержание, методология записи, адресат, богодухновенность, Закон и Евангелие — как единое исследование.</p>
                <div style="margin-top:8px;display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#d97706;">
                  Открыть серию
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </div>
              </div>
            </a>
          </li>

          <!-- Нагорная проповедь — часть I (старая версия, сохранена для SEO) -->

          <!-- Нагорная проповедь — часть II -->

          <!-- Нагорная проповедь — часть III -->

          <!-- Герменевтика -->
          <li>
            <a href="hermenevticheskaya-otsenka-hristotsentrichnoy-germenevtiki/" class="h-article-card">
              <div class="h-article-thumb">
                <img src="../images/hermenevtika-preview.webp"
                     alt="Герменевтическая оценка христоцентричной герменевтики"
                     decoding="async" loading="lazy" width="160" height="108">
              </div>
              <div class="h-article-body">
                <h2 class="h-article-title">Герменевтическая оценка христоцентричной герменевтики</h2>
                <div class="h-article-meta">
                  <span class="h-meta-author">Абнер Чау</span>
                  <span class="h-meta-sep" aria-hidden="true">·</span>
                  <span class="h-meta-time">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    50 мин
                  </span>
                  <span class="h-meta-tag">Перевод</span>
                </div>
                <p class="h-article-abstract">Статья оценивает претензии христоцентричной герменевтики и утверждает, что грамматико-исторический метод оправдан Писанием и более чем достаточен для раскрытия славы Христа.</p>
              </div>
            </a>
          </li>

        </ul>
      </div>
    </section>
