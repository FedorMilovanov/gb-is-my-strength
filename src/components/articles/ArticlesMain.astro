---
/**
 * ArticlesMain.astro — native semantic catalog body for /articles/.
 *
 * The exhaustive article/series projection is owned by ArticlesLibrarySection,
 * which derives current published destinations from existing repository
 * authorities instead of a second hand-maintained card inventory.
 */
import ArticlesHeroSection from './ArticlesHeroSection.astro';
import ArticlesLibrarySection from './ArticlesLibrarySection.astro';
import ArticlesRefutationsSection from './ArticlesRefutationsSection.astro';
import ArticlesArticleEndBlock from './ArticlesArticleEndBlock.astro';
---
<main id="main-content">

<!-- Mobile menu -->
<div id="hMobileBackdrop" class="h-mobile-backdrop" aria-hidden="true"></div>
<div class="h-mobile-nav" id="hMobileNav" aria-hidden="true">
  <a href="../#publikacii" data-close-nav>Публикации</a>
  <a href="../#razbor" data-close-nav>Разбор заблуждений</a>
  <a href="../biografii/" data-close-nav>Биографии</a>
  <a href="./" data-close-nav aria-current="page">Все статьи</a>
  <a href="../about/" data-close-nav>О проекте</a>
</div>

<!-- PAGE WRAPPER -->
<div class="home-v20">

  <div class="home-content">

    <ArticlesHeroSection />
<ArticlesLibrarySection />
<ArticlesRefutationsSection />
<ArticlesArticleEndBlock />

  </div><!-- /.home-content -->
</div><!-- /.home-v20 -->
</main>
