---
/**
 * ArticlesMain.astro — native semantic catalog body for /articles/.
 *
 * 100% native lane (2026-06-23): no loader-backed document shell and no raw
 * legacy fragment imports. The component keeps the premium catalog DOM
 * (mobile menu, home-v20 wrapper, hero, publications/refutations grids and SDG
 * block) as first-class Astro markup and derives series counters from the shared
 * data/series.json contract.
 */
import seriesData from '../../../data/series.json';
import ArticlesHeroSection from './ArticlesHeroSection.astro';
import ArticlesPublicationsSection from './ArticlesPublicationsSection.astro';
import ArticlesRefutationsSection from './ArticlesRefutationsSection.astro';
import ArticlesArticleEndBlock from './ArticlesArticleEndBlock.astro';

const hardTexts = seriesData['hard-texts'];
const nagornaya = seriesData.nagornaya;
const gill = seriesData['dzhon-gill'];
const gillReadingTime = Object.fromEntries(
  gill.parts.map((part) => [part.slug, part.readingTime]),
);
const hardTextsPublished = hardTexts.parts.filter((part) => part.status === 'published').length;
const hardTextsPartsLabel = `${hardTexts.parts.length} части (${hardTextsPublished} опубликованы)`;
const nagornayaPublished = nagornaya.parts.filter((part) => part.status === 'published').length;
const nagornayaPartsLabel = `${nagornayaPublished} частей`;
---
<main id="main-content">

<!-- Mobile menu -->
<div id="hMobileBackdrop" class="h-mobile-backdrop" aria-hidden="true"></div>
<div class="h-mobile-nav" id="hMobileNav" aria-hidden="true">
  <a href="../#publikacii" data-close-nav>Публикации</a>
  <a href="../#razbor" data-close-nav>Разбор заблуждений</a>
  <a href="../biografii/" data-close-nav>Биографии</a>
  <a href="./" data-close-nav aria-current="page">Все статьи</a>
  <a href="../about/" data-close-nav>О проекте</a>
</div>

<!-- PAGE WRAPPER -->
<div class="home-v20">

  <div class="home-content">

    <ArticlesHeroSection />
<ArticlesPublicationsSection
  hardTextsPartsLabel={hardTextsPartsLabel}
  nagornayaPartsLabel={nagornayaPartsLabel}
  gillReadingTime={gillReadingTime}
/>
<ArticlesRefutationsSection />
<ArticlesArticleEndBlock />

  </div><!-- /.home-content -->
</div><!-- /.home-v20 -->
</main>
