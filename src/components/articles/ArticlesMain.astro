---
/**
 * ArticlesMain.astro — <main id="main-content"> of /articles/.
 *
 * Refactoring 6.0 parallel pilot: the route no longer depends on raw legacy
 * fragment imports for the catalog sections. The premium catalog shell is now
 * assembled from hand-authored Astro components that preserve the legacy DOM,
 * copy, URLs and utility classes.
 *
 * Pixel-parity contract remains guarded via
 *   npm run visual:parity:screenshots -- --routes /articles/
 * and source-contract audit in scripts/articles-visual-parity-audit.js.
 */
import ArticlesHeroSection from './ArticlesHeroSection.astro';
import ArticlesPublicationsSection from './ArticlesPublicationsSection.astro';
import ArticlesRefutationsSection from './ArticlesRefutationsSection.astro';
import ArticlesArticleEndBlock from './ArticlesArticleEndBlock.astro';
---
<main id="main-content">
  <ArticlesHeroSection />
  <ArticlesPublicationsSection />
  <ArticlesRefutationsSection />
  <ArticlesArticleEndBlock />
</main>
