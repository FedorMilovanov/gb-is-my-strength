---
/**
 * ArticlesLibrarySection.astro — exhaustive /articles/ projection.
 *
 * Derived from existing publication authorities rather than a second
 * hand-maintained catalog. Search manifest owns reader-facing metadata;
 * page-ownership decides whether the destination is current production output.
 * Scripture occurrences remain owned by their source graph and generated index,
 * never by another hand-maintained catalog inventory.
 */
import searchManifest from '../../../data/search-manifest.json';
import pageOwnership from '../../../migration/page-ownership.json';

interface PublicationRecord {
  status?: string;
  publicationStatus?: string;
  publicationGate?: string;
}
interface CatalogItem extends PublicationRecord {
  id?: string;
  type?: string;
  url: string;
  title?: string;
  description?: string;
  section?: string;
  author?: string;
  editor?: string;
  translator?: string;
  readTime?: number;
  image?: string;
  priority?: number;
  modifiedTime?: string;
}

type CatalogAttribution = {
  kind: 'author-editor' | 'editor' | 'author' | 'translator' | 'site';
  label: string;
};

const OWNER_NAME = 'Фёдор Милованов';

function cleanRole(value?: string) {
  return String(value || '').trim();
}

function catalogAttribution(item: CatalogItem): CatalogAttribution {
  const author = cleanRole(item.author);
  const editor = cleanRole(item.editor);
  const translator = cleanRole(item.translator);

  // Original A/B material: the owner-approved public role is Автор-редактор.
  if (author && editor && author === editor && !translator) {
    return { kind: 'author-editor', label: `Автор-редактор: ${author}` };
  }

  // Owner-sensitive fail-closed boundary: never render forbidden "Автор: Фёдор".
  if (author === OWNER_NAME && !editor) {
    throw new Error(`Articles catalog attribution missing editor authority for ${item.url}`);
  }
  if (translator === OWNER_NAME && !editor) {
    throw new Error(`Articles catalog translation missing editor authority for ${item.url}`);
  }

  // Translation/editorial material keeps the owner-approved catalog label.
  // A translator role is never promoted into editor authority by this consumer.
  if (editor) return { kind: 'editor', label: `Ред.: ${editor}` };
  if (author) return { kind: 'author', label: `Автор: ${author}` };
  if (translator) return { kind: 'translator', label: `Перевод: ${translator}` };
  return { kind: 'site', label: 'Господь Бог — Сила Моя' };
}

// Build-time role contract: fail before rendering if catalog attribution drifts.
for (const [fixture, expectedKind, expectedLabel] of [
  [{ url: '/fixture/author/', author: 'Автор, не редактор' }, 'author', 'Автор: Автор, не редактор'],
  [{ url: '/fixture/original/', author: OWNER_NAME, editor: OWNER_NAME }, 'author-editor', 'Автор-редактор: Фёдор Милованов'],
  [{ url: '/fixture/translation/', author: 'Абнер Чау', translator: OWNER_NAME, editor: OWNER_NAME }, 'editor', 'Ред.: Фёдор Милованов'],
] as const) {
  const actual = catalogAttribution(fixture);
  if (actual.kind !== expectedKind || actual.label !== expectedLabel) {
    throw new Error(`Articles catalog attribution contract failed for ${fixture.url}: ${actual.kind} / ${actual.label}`);
  }
}
for (const forbiddenFixture of [
  { url: '/fixture/forbidden-owner-author/', author: OWNER_NAME },
  { url: '/fixture/forbidden-owner-translator/', translator: OWNER_NAME },
] as const) {
  let rejected = false;
  try {
    catalogAttribution(forbiddenFixture);
  } catch {
    rejected = true;
  }
  if (!rejected) throw new Error(`Articles catalog accepted owner-sensitive incomplete attribution for ${forbiddenFixture.url}`);
}

const manifestItems = searchManifest.items as CatalogItem[];
const productionRoutes = pageOwnership.routes as Record<string, PublicationRecord>;
const held = (record?: PublicationRecord) => [record?.status, record?.publicationStatus, record?.publicationGate].includes('PUBLICATION_HOLD');
const routeIsPublished = (item: CatalogItem) => {
  const owner = productionRoutes[String(item.url || '').split('#')[0]];
  // A HOLD is only a veto, never a second positive publication authority.
  return owner?.status === 'production-dist' && !held(owner) && !held(item);
};
const byEditorialOrder = (a: CatalogItem, b: CatalogItem) => {
  const priorityDelta = Number(b.priority || 0) - Number(a.priority || 0);
  if (priorityDelta) return priorityDelta;
  const aModified = Date.parse(String(a.modifiedTime || ''));
  const bModified = Date.parse(String(b.modifiedTime || ''));
  if (Number.isFinite(aModified) && Number.isFinite(bModified) && bModified !== aModified) return bModified - aModified;
  return String(a.title || '').localeCompare(String(b.title || ''), 'ru');
};

const series = manifestItems
  .filter((item) => item.type === 'series' && routeIsPublished(item))
  .sort(byEditorialOrder);
const items = manifestItems
  .filter((item) => item.type === 'article' && routeIsPublished(item))
  .sort(byEditorialOrder);

// A navigation projection of the SAME item set, not another catalog registry.
const topics = [...new Set(items.map((item) => item.section || 'Другие материалы'))].map((name) => ({
  name,
  id: `catalog-topic-${name.toLocaleLowerCase('ru').replace(/[^а-яёa-z0-9]+/giu, '-').replace(/^-|-$/g, '')}`,
  items: items.filter((item) => (item.section || 'Другие материалы') === name),
}));
const plural = (count: number, one: string, few: string, many: string) => {
  const last = count % 10, teen = count % 100;
  return last === 1 && teen !== 11 ? one : last >= 2 && last <= 4 && (teen < 12 || teen > 14) ? few : many;
};
---
<!-- Full SSR navigation: every published destination remains reachable without scripts. -->
<section class="h-section articles-library" id="publikacii" aria-labelledby="hLibraryLabel" data-catalog-source="search-manifest+page-ownership">
  <div class="articles-section-heading">
    <div><p class="eyebrow">Библиотека издания</p><h2 id="hLibraryLabel">Выберите направление</h2></div>
    <p class="articles-count"><strong>{items.length}</strong> {plural(items.length, 'материал', 'материала', 'материалов')}<span>{series.length} {plural(series.length, 'серия и сборник', 'серии и сборника', 'серий и сборников')}</span></p>
  </div>
  <nav class="articles-topics" aria-label="Рубрики каталога" data-catalog-topics>
    <ul>
      {topics.map((topic) => <li><a href={`#${topic.id}`}><span>{topic.name}</span><span class="articles-topic-count">{topic.items.length}</span></a></li>)}
    </ul>
    {series.length > 0 && <a class="articles-series-jump" href="#catalog-series">Серии и сборники <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v16m-6-6 6 6 6-6" /></svg></a>}
  </nav>

  <section class="h-articles-group articles-materials" id="catalog-materials" aria-labelledby="hArticlesLabel" tabindex="-1">
    <div class="articles-section-heading"><h2 id="hArticlesLabel">Все материалы</h2><p>Полный каталог по рубрикам</p></div>
    {topics.map((topic) => (
      <section class="articles-topic" aria-labelledby={topic.id}>
        <div class="articles-topic-heading"><h3 id={topic.id} tabindex="-1">{topic.name}</h3><span>{topic.items.length} {plural(topic.items.length, 'материал', 'материала', 'материалов')}</span></div>
        <ul class="h-article-list h-article-list--grid">
          {topic.items.map((item) => (
            <li class="h-article-card">
              <a href={item.url} class="articles-entry" data-catalog-route={item.url}>
                <!-- Text-first index: original covers stay in manifest/articles, not an OG-download gallery. -->
                <div class="h-article-body">
                  <h4 class="h-article-title">{item.title || item.id || item.url}</h4>
                  <div class="h-article-meta">
                    <span class="h-meta-author" data-catalog-role={catalogAttribution(item).kind}>{catalogAttribution(item).label}</span>
                    {Number.isFinite(item.readTime) && <span class="h-meta-time">{item.readTime} мин</span>}
                    {item.section && <span class="h-meta-tag h-meta-tag--neutral">{item.section}</span>}
                  </div>
                  {item.description && <p class="h-article-abstract">{item.description}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>

  {series.length > 0 && (
    <section class="h-articles-group articles-series" id="catalog-series" aria-labelledby="hSeriesLabel" tabindex="-1">
      <div class="articles-section-heading"><h2 id="hSeriesLabel">Серии и сборники</h2><p>Для последовательного чтения</p></div>
      <ul class="h-article-list h-article-list--grid">
        {series.map((item) => (
          <li class="h-article-card">
            <a href={item.url} class="articles-entry" data-catalog-series={item.url}>
              <div class="h-article-body">
                <h3 class="h-article-title">{item.title || item.id || item.url}</h3>
                <div class="h-article-meta">
                  <span class="h-meta-tag">Серия</span>
                  {Number.isFinite(item.readTime) && <span class="h-meta-time">{item.readTime} мин</span>}
                  {item.section && <span class="h-meta-tag h-meta-tag--neutral">{item.section}</span>}
                </div>
                {item.description && <p class="h-article-abstract">{item.description}</p>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

</section>
