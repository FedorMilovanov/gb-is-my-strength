---
/**
 * KartyMain.astro — <div class="karty-hub" data-pagefind-body>...</div> of /karty/.
 *
 * Refactoring 6.0 parallel pilot: the route no longer proxies one monolithic
 * legacy hub block. Instead, the premium standalone hub is composed
 * from named Astro leaf components while preserving legacy DOM/classes/text.
 *
 * Pixel-parity contract remains guarded via
 *   npm run visual:parity:screenshots -- --routes /karty/ --threshold 0.5
 * and source-contract audit in scripts/karty-visual-parity-audit.js.
 */
import KartyBackLink from './KartyBackLink.astro';
import KartyHeroSection from './KartyHeroSection.astro';
import KartyBodySection from './KartyBodySection.astro';
import KartyNote from './KartyNote.astro';
---
<div class="karty-hub" data-pagefind-body>
  <KartyBackLink />
  <KartyHeroSection />
  <KartyBodySection />
  <KartyNote />
</div>
