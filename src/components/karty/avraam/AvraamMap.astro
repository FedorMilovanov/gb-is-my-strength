<script is:inline>
(function(){
  function fail(container, error) {
    var message = error && error.message
      ? 'Не удалось запустить карту: ' + error.message
      : 'Не удалось запустить интерактивную карту.';
    if (window.GBMapRuntime && typeof window.GBMapRuntime.renderFailure === 'function') {
      window.GBMapRuntime.renderFailure(container, {
        title: 'Карта пути Авраама временно недоступна',
        message: message
      });
    }
    console.error('[avraam] MapEngine init failed:', error);
  }

  function init() {
    var container = document.getElementById('stage');
    if (!container) return;

    // Inject Avraam-specific visual overrides (from legacy avraam-app.js style block)
    var style = document.createElement('style');
    style.textContent = `
      :root {
        --lot:#e0813f;
        --cand:#9b8cf0;
      }
      .me-sig-light-node { fill: rgba(232,200,121,0.2) }
    `;
    document.head.appendChild(style);

    if (window.MapEngine) {
      window.MapEngine.getPlaceVisual = function(pl) {
        if (pl.type === 'lot') {
          return { markerClass: 'me-place me-place-lot', cssColor: 'var(--lot)', color: '#e0813f' };
        }
        if (pl.type === 'cand') {
          return { markerClass: 'me-place me-place-cand', cssColor: 'var(--cand)', color: '#9b8cf0' };
        }
        return null;
      };
    }

    fetch('route.json')
      .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
      .then(function(route){
        if (!window.MapEngine || typeof window.MapEngine.createMap !== 'function') {
          throw new Error('движок карты не загрузился');
        }
        var inst = window.MapEngine.createMap(container, route, {
          baseGeoUrl: 'base.svg'
        });
        if (!inst) throw new Error('движок не создал карту');
        container.setAttribute('data-map-state', 'ready');
        container.setAttribute('aria-busy', 'false');
      })
      .catch(function(e){ fail(container, e); });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else { init(); }
})();
</script>
