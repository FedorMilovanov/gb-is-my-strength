---
/**
 * KartyHoldingPage — shared native template for map routes withheld from the hub.
 *
 * Route metadata is the single source of truth. Callers provide only slug;
 * title, canonical and OG copy are derived from karty/<slug>/route.json.
 */
import fs from 'node:fs';
import path from 'node:path';
import ReaderPreferencesHead from '@/components/reader-platform/ReaderPreferencesHead.astro';

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
if (!/^[a-z0-9-]+$/.test(slug)) throw new Error(`Invalid Karty holding slug: ${slug}`);

const routePath = path.join(process.cwd(), 'karty', slug, 'route.json');
if (!fs.existsSync(routePath)) throw new Error(`Missing Karty route metadata: ${routePath}`);
const route = JSON.parse(fs.readFileSync(routePath, 'utf8'));
const publication = route.publication || {};
if (publication.hub !== 'withheld') {
  throw new Error(`KartyHoldingPage may only render hub-withheld routes: ${slug}`);
}

const routeTitle = String(route.meta?.title || slug);
const canonical = `https://gospod-bog.ru/karty/${slug}/`;
const title = `${routeTitle} — временно на визуальном аудите | Господь Бог — Сила Моя`;
const h1 = routeTitle;
const ogTitle = `${routeTitle} — визуальный аудит`;
const description = 'Карта временно снята с витрины до ручной визуальной доводки: масштаб, подписи, мобильный вид и общее качество.';
const ogDescription = description;
const twitterDescription = description;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": "https://gospod-bog.ru/#organization", name: "Господь Бог — Сила Моя", url: "https://gospod-bog.ru/", logo: { "@type": "ImageObject", url: "https://gospod-bog.ru/icons/icon-512.png", width: 512, height: 512 } },
    { "@type": "WebPage", "@id": `${canonical}#webpage`, url: canonical, name: ogTitle, description: ogDescription, inLanguage: "ru-RU", isPartOf: { "@id": "https://gospod-bog.ru/#website" } },
    { "@type": "WebSite", "@id": "https://gospod-bog.ru/#website", name: "Господь Бог — Сила Моя", url: "https://gospod-bog.ru/", inLanguage: "ru-RU", publisher: { "@id": "https://gospod-bog.ru/#organization" } },
  ],
};
---
<!DOCTYPE html>
<html lang="ru">
<head>

<meta charset="utf-8" />
  <ReaderPreferencesHead />


<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="robots" content="noindex, follow" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content="https://gospod-bog.ru/images/og-karty-1200x630.webp" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/webp" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@FedorMilovanov" />
<meta name="twitter:creator" content="@FedorMilovanov" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={twitterDescription} />
<meta name="twitter:image" content="https://gospod-bog.ru/images/og-karty-1200x630.webp" />
<meta name="theme-color" content="#0b0f16" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f7f1e8" media="(prefers-color-scheme: light)" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="stylesheet" href="../../fonts/fonts.css?v=864cc57a" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style is:inline>
:root{--bg:#0b0f16;--card:#121820;--line:#3b3328;--ink:#f5efe6;--muted:#b9aea2;--gold:#d6b25e;--accent:#8b2f2f}
*{box-sizing:border-box}body{margin:0;min-height:100dvh;background:radial-gradient(circle at 28% 12%,rgba(214,178,94,.14),transparent 34%),linear-gradient(135deg,#070a10,#11161d 55%,#080b10);color:var(--ink);font-family:Lora,Georgia,serif;display:grid;place-items:center;padding:28px}
main{width:min(760px,100%);min-width:0;border:1px solid color-mix(in srgb,var(--gold) 28%,var(--line));border-radius:28px;background:linear-gradient(145deg,rgba(18,24,32,.94),rgba(10,14,20,.98));box-shadow:0 30px 90px rgba(0,0,0,.42);padding:clamp(28px,5vw,56px)}
.eyebrow{margin:0 0 12px;font-family:Arial,sans-serif;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);font-weight:800}h1{margin:0;font-size:clamp(34px,6vw,62px);line-height:1.02;letter-spacing:-.04em}p{font-size:18px;line-height:1.75;color:var(--muted);max-width:62ch}.note{border-top:1px solid rgba(214,178,94,.22);margin-top:28px;padding-top:24px}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}a{color:var(--ink)}.btn{display:inline-flex;min-height:46px;align-items:center;justify-content:center;padding:0 18px;border-radius:999px;border:1px solid rgba(214,178,94,.32);background:rgba(214,178,94,.12);font-family:Arial,sans-serif;font-weight:800;text-decoration:none}.btn--ghost{background:transparent;color:var(--muted)}
</style>
</head>
<body>
<main data-pagefind-ignore data-content-status="temporary-placeholder">
  <p class="eyebrow">Визуальный аудит карт</p>
  <h1>{h1}</h1>
  <p>Эта карта временно не показывается на витрине. Мы не выдаём недоведённые интерактивные материалы за готовые: перед возвратом нужны ручная доводка масштаба, наложения подписей, мобильного вида и общего визуального качества.</p>
  <p class="note">Статус витрины управляется метаданными самой карты. Маршрут возвращается в раздел только после технических проверок и обязательного owner review.</p>
  <div class="actions">
    <a class="btn btn--ghost" href="/app/">Приложение</a>
    <a class="btn btn--ghost" href="../">К разделу карт</a>
    <a class="btn btn--ghost" href="../../">На главную</a>
  </div>
</main>
</body>
</html>
