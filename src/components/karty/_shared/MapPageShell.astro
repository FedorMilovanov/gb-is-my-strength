---
import MapSearchRail from './MapSearchRail.astro';

interface Props {
  lang?: string;
}

const { lang = 'ru' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <slot name="head" />
  </head>
  <body class="has-app-search-map">
    <slot />
    <MapSearchRail />
  </body>
</html>
