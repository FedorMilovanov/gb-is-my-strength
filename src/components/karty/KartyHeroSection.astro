---
/**
 * KartyHeroSection — publication-driven map hub.
 *
 * The hub never owns a second allowlist. route.publication is the sole source
 * of technical readiness and owner-approved hub visibility.
 */
import inventoryModule from '../../lib/karty-hub-inventory.cjs';

const { getKartyHubInventory } = inventoryModule;
const { routeCount, publishedCount, auditCount, publishedRecords } = getKartyHubInventory();

function publishedLabel(count: number) {
  const mod100 = count % 100;
  const mod10 = count % 10;
  if (mod100 >= 11 && mod100 <= 14) return 'карт открыто';
  if (mod10 === 1) return 'карта открыта';
  if (mod10 >= 2 && mod10 <= 4) return 'карты открыты';
  return 'карт открыто';
}
---
<section class="karty-hero" aria-labelledby="mapsTitle">
  <div class="karty-hero-layout">
    <div class="karty-hero__copy">
      <p class="karty-kicker">География Священного Писания</p>
      <h1 id="mapsTitle">Библейские карты</h1>
      <div class="he" lang="he">מַפּוֹת</div>
      <p class="desc">Проследите библейские события на карте: от городов и рек до путей через пустыню. Каждая открытая карта сопровождается историческим контекстом и пояснениями к спорным местоположениям.</p>
    </div>
    <div class="karty-feature-list" data-karty-published-list>
      {publishedRecords.map((record) => {
        const route = record.route;
        const publication = record.publication;
        const title = String(route.meta?.title || record.slug);
        const titleHe = String(route.meta?.title_he || '');
        const image = String(publication?.hub_image || '/images/og-karty-1200x630.webp');
        const summary = String(publication?.hub_summary || route.meta?.subtitle || '');
        return (
          <a
            href={`./${record.slug}/`}
            class="karty-map-card"
            data-karty-published={record.slug}
          >
            <figure class="karty-map-card__figure">
              <img src={image} alt="" width="1200" height="630" decoding="async" />
            </figure>
            <div class="karty-map-card__body">
              <span class="karty-map-card__eyebrow">Проверенная карта</span>
              <h2>{title} {titleHe && <span lang="he">{titleHe}</span>}</h2>
              <p>{summary}</p>
              <span class="karty-map-card__cta">Открыть карту <span aria-hidden="true">→</span></span>
            </div>
          </a>
        );
      })}
    </div>
      <div class="karty-hero__meta" role="group" aria-label="Статус раздела" data-route-count={routeCount} data-published-count={publishedCount} data-audit-count={auditCount}>
        <div class="karty-stat"><b>{publishedCount}</b><span>{publishedLabel(publishedCount)}</span></div>
        <div class="karty-stat"><b>{auditCount}</b><span>на аудите</span></div>
        <div class="karty-stat"><b>0</b><span>черновиков на витрине</span></div>
      </div>
  </div>
</section>
<style>
  .karty-hero-layout {
    position:relative;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(min(100%,19rem),1fr));
    align-items:start;
    gap:clamp(1rem,2.5vw,1.75rem);
    padding:clamp(1.1rem,3vw,2rem);
  }
  .karty-hero-layout h1 {
    font-size:clamp(2rem,4.15vw,3.5rem);
    line-height:1.05;
    hyphens:none;
    overflow-wrap:normal;
  }
  .karty-hero-layout .he { direction:rtl; text-align:left; font-size:1.8rem; }
  .karty-hero-layout .desc { font-family:"Source Sans 3",Inter,system-ui,sans-serif; font-size:1rem; line-height:1.65; }
  .karty-feature-list { display:grid; gap:1rem; min-width:0; }
  /* The governed illustration and the reading surface are separate regions.
     The native card owns its presentation, not the old background-overlay
     selector in the page head. No text is positioned over the image. */
  .karty-map-card {
    display:block;
    min-width:0;
    border:1px solid var(--kh-line);
    border-radius:18px;
    background:var(--kh-card);
    color:var(--kh-ink);
    text-decoration:none;
    box-shadow:var(--kh-shadow);
  }
  .karty-map-card__figure {
    margin:0;
    overflow:hidden;
    border-radius:17px 17px 0 0;
    background:var(--kh-deep);
  }
  .karty-map-card__figure img {
    display:block;
    width:100%;
    height:auto;
    aspect-ratio:40/21;
    object-fit:contain;
  }
  .karty-map-card__body {
    padding:clamp(1rem,2vw,1.5rem);
    background:var(--kh-card);
    border-radius:0 0 17px 17px;
    min-width:0;
  }
  .karty-map-card__eyebrow {
    display:block;
    color:var(--kh-accent);
    font-size:.75rem;
    line-height:1.4;
    letter-spacing:.08em;
    font-weight:750;
    text-transform:uppercase;
  }
  .karty-map-card h2 {
    font:600 clamp(1.35rem,2.5vw,1.9rem)/1.2 "Playfair Display",Georgia,serif;
    margin:.6rem 0;
    color:var(--kh-ink);
    overflow-wrap:anywhere;
  }
  .karty-map-card h2 span {
    font-family:"Noto Serif Hebrew",serif;
    font-size:.75em;
    color:var(--kh-muted);
    unicode-bidi:isolate;
  }
  .karty-map-card p {
    margin:0;
    color:var(--kh-muted);
    font-size:1rem;
    line-height:1.55;
  }
  .karty-map-card__cta {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:.5rem;
    min-height:44px;
    margin-top:.85rem;
    border-top:1px solid var(--kh-line);
    padding-top:.65rem;
    color:var(--kh-accent);
    font-weight:750;
  }
  .karty-map-card:hover { border-color:var(--kh-accent); text-decoration:none; }
  .karty-map-card:focus-visible { outline:3px solid var(--kh-accent); outline-offset:4px; }
  .karty-hero-layout .karty-hero__meta {
    grid-column:1/-1;
    grid-template-columns:repeat(auto-fit,minmax(min(100%,10rem),1fr));
    margin-top:0;
    padding-top:1rem;
    border-top:1px solid var(--kh-line);
  }
  .karty-hero-layout .karty-stat {
    padding:.5rem .65rem;
    border:0;
    border-radius:0;
    background:transparent;
    box-shadow:none;
    display:flex;
    align-items:center;
    gap:.65rem;
  }
  .karty-hero-layout .karty-stat:last-child { grid-column:auto; }
  .karty-hero-layout .karty-stat b { font-size:1.45rem; }
  .karty-hero-layout .karty-stat span { font-size:.83rem; text-transform:none; letter-spacing:0; margin:0; line-height:1.3; }
  @media(max-width:560px) {
    .karty-hero-layout .karty-hero__meta { gap:.2rem; grid-template-columns:minmax(0,1fr); }
  }
</style>
