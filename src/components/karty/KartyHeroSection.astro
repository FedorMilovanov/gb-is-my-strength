---
/**
 * KartyHeroSection.astro — hero + published map cards for /karty/.
 *
 * Refactoring 6.0 parallel pilot: preserve legacy structure/classes/text.
 * Counts are derived from the governed route inventory so a newly added
 * audit-pending map cannot desynchronise the hub and its fail-closed validator.
 *
 * Publication model: a map is opened on the hub only after it passed the visual
 * audit, which is recorded once in PUBLISHED_KARTY_SLUGS and projected here as
 * one card per published map. The remaining routes stay listed as audit-pending
 * material and are never shown as ready.
 */
import inventoryModule from '../../lib/karty-hub-inventory.cjs';

const { getKartyHubInventory } = inventoryModule;
const { routeCount, publishedCount, auditCount, publishedSlugs } = getKartyHubInventory();
const publishedLabel = publishedCount === 1 ? 'карта открыта' : 'карты открыты';

// The card link carries no aria-label on purpose: an action-only name such as
// «Открыть карту …» would hide the visible card text from the accessible name
// (axe label-content-name-mismatch), so the visible card content is the name.
type PublishedCard = { href: string; title: string; hebrew: string; description: string };
const PUBLISHED_CARDS: Record<string, PublishedCard> = {
  avraam: {
    href: './avraam/',
    title: 'Путь Авраама',
    hebrew: 'אַבְרָהָם',
    description: 'Бытие 11–25: маршрут патриарха, ключевые места, богословский и исторический слой.',
  },
  ishod: {
    href: './ishod/',
    title: 'Исход из Египта',
    hebrew: 'יְצִיאַת מִצְרַיִם',
    description: 'Числа 33: станы исхода, Пи-Гахироф как нерешённая локализация, Синай и путь к Моаву.',
  },
};
const cards = publishedSlugs.map((slug) => PUBLISHED_CARDS[slug]).filter((card): card is PublishedCard => Boolean(card));
---
<section class="karty-hero" aria-labelledby="mapsTitle">
  <div class="karty-hero__inner">
    <div class="karty-hero__copy">
      <p class="karty-kicker">Премиальная витрина карт</p>
      <h1 id="mapsTitle">Библейские карты</h1>
      <div class="he" lang="he">מַפּוֹת</div>
      <p class="desc">Карты должны помогать видеть текст Писания в пространстве: маршруты, города, реки, пустыни, спорные точки локализации и исторический контекст. Поэтому на витрине остаётся только то, что прошло визуальную проверку.</p>
      <div class="karty-hero__meta" role="group" aria-label="Статус раздела" data-route-count={routeCount} data-published-count={publishedCount} data-audit-count={auditCount}>
        <div class="karty-stat"><b>{publishedCount}</b><span>{publishedLabel}</span></div>
        <div class="karty-stat"><b>{auditCount}</b><span>на аудите</span></div>
        <div class="karty-stat"><b>0</b><span>черновиков на витрине</span></div>
      </div>
    </div>
    <div class="karty-feature-list" data-published-map-count={publishedCount}>
      {cards.map((card) => (
        <a href={card.href} class="karty-feature">
          <div class="karty-feature__body">
            <span class="badge badge--ready">Проверенная карта</span>
            <h2>{card.title} <span lang="he">{card.hebrew}</span></h2>
            <p>{card.description}</p>
            <span class="karty-feature__cta">Открыть карту →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
