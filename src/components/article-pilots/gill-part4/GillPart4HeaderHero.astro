---
import GillSeriesHero from '../gill-series/GillSeriesHero.astro';
// Strict-native parity contract: class="gbs2-hero" is rendered by GillSeriesHero.
---
<GillSeriesHero
  src="../../images/og-dzhon-gill-chast-4-ekzeget-600w.webp"
  srcset="../../images/og-dzhon-gill-chast-4-ekzeget-600w.webp 600w, ../../images/og-dzhon-gill-chast-4-ekzeget.webp 1200w"
  alt="Раскрытая рукопись комментария и перо — образ Гилла-экзегета за работой"
  caption="Серия «Джон Гилл» · Часть III"
  width={1200}
  height={630}
/>
<header class="article-header gbs2-head">
  <p class="reveal section-label">Биографии служителей</p>
  <h1>Джон Гилл (1697–1771). Часть III: Экзегет</h1>
  <p class="reveal article-desc">Как экзегет читал тексты, которые «на первый взгляд» рушат его систему: герменевтический метод, построчный разбор семи «универсальных» текстов против арминианина Даниэля Уитби, учение об отвержении и долг веры.</p>
  <p class="reveal article-byline"><span class="article-byline__strong">Автор-редактор: Фёдор Милованов</span></p>
</header>
