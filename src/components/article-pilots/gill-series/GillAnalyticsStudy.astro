---
import { GILL_SERIES, type SeriesConfig } from '../_shared/series/seriesConfig';
interface Props { pageId: string; config?: SeriesConfig; }
const { pageId, config = GILL_SERIES } = Astro.props as Props;
const studyData = JSON.stringify({
  pageId,
  seriesId: config.seriesId,
  series: config.quiz ?? [],
});
---
<!-- One movable research module: native mobile Analytics, W57 Research, or standard desktop inline fallback.
     No additional modal, storage, glossary, notes pane or search index. -->
<details id="gbAnalyticsStudy" class="gb-analytics-study gbr-marginalia-group" data-reader-exclude data-pagefind-ignore data-no-speech data-print-policy="exclude" data-print-disclosure="ui" data-study={studyData} hidden>
  <!-- One canonical accordion shell shared with Scripture, Terms, Text Flow and Notes.
       The movable quiz retains exactly one ID, DOM owner and saved attempt. -->
  <summary class="gb-analytics-study__title gbr-marginalia-group-head"><strong>Проверь себя</strong><span id="gbAnalyticsStudyCount"></span></summary>
  <div class="gb-analytics-study__inner">
    <div class="gb-analytics-study__modes" role="group" aria-label="Выбрать тест">
      <button type="button" data-study-mode="article" hidden>По статье</button>
      <button type="button" data-study-mode="series" hidden>По серии</button>
    </div>
    <div id="gbAnalyticsQuiz" aria-live="polite"></div>
  </div>
</details>
<script>
  import { initReaderAnalyticsStudy } from '@/runtime/reader-analytics-study.js';
  initReaderAnalyticsStudy();
</script>
<style is:global>
  #gbAnalyticsStudy {margin:12px 0 16px; border:1px solid color-mix(in srgb,#a18460 35%,transparent);border-radius:12px;color:inherit;background:transparent;min-width:0}
  #gbAnalyticsStudy[hidden] {display:none!important}
  .gb-study-inline-launch{font:600 14px/1.4 system-ui,sans-serif;padding:12px 16px;min-height:44px;border:1px solid color-mix(in srgb,#a18460 35%,transparent);border-radius:10px;color:inherit;background:transparent;cursor:pointer}
  .gb-study-inline-launch[hidden]{display:none!important}
  #gbAnalyticsStudy > summary {cursor:pointer;min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 13px;font:600 14px/1.4 system-ui,sans-serif;list-style:none}
  #gbAnalyticsStudy > summary::-webkit-details-marker{display:none}
  #gbAnalyticsStudy > summary span {font-size:12px;opacity:.7}
  #gbAnalyticsStudy .gb-analytics-study__inner{padding:10px 13px 16px;border-top:1px solid color-mix(in srgb,currentColor 12%,transparent)}
  #gbAnalyticsStudy .gb-analytics-study__modes{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
  #gbAnalyticsStudy .gb-analytics-study__modes[hidden]{display:none!important}
  #gbAnalyticsStudy .gb-analytics-study__modes button{font:600 13px/1.3 system-ui,sans-serif;padding:9px 12px;min-height:42px;border:1px solid color-mix(in srgb,currentColor 25%,transparent);border-radius:10px;color:inherit;background:transparent;cursor:pointer}
  #gbAnalyticsStudy .gb-analytics-study__modes button[hidden]{display:none}
  #gbAnalyticsStudy .gb-analytics-study__modes button[aria-pressed=true]{background:color-mix(in srgb,#b08a56 17%,transparent);border-color:#9e7c4d}
  #gbAnalyticsQuiz {font:400 14px/1.65 system-ui,sans-serif}
  #gbAnalyticsQuiz h4{font:600 16px/1.5 system-ui,sans-serif;margin:8px 0 12px}
  #gbAnalyticsQuiz button{font:500 14px/1.45 system-ui,sans-serif;color:inherit;cursor:pointer;background:transparent;border:1px solid color-mix(in srgb,currentColor 25%,transparent);border-radius:10px;min-height:44px;padding:10px 12px;text-align:left}
  #gbAnalyticsQuiz button:disabled{cursor:default;opacity:.75}
  #gbAnalyticsQuiz button:focus-visible,#gbAnalyticsStudy button:focus-visible{outline:2px solid #b08a56;outline-offset:2px}
  #gbAnalyticsQuiz .gb-study-options{display:grid;gap:7px;margin:10px 0}
  #gbAnalyticsQuiz .gb-study-options button.is-correct{border-color:#3e946d;background:color-mix(in srgb,#3e946d 14%,transparent)}
  #gbAnalyticsQuiz .gb-study-options button.is-wrong{border-color:#bd6b56;background:color-mix(in srgb,#bd6b56 12%,transparent)}
  #gbAnalyticsQuiz .gb-study-confidence{display:grid;gap:7px;margin:12px 0}
  #gbAnalyticsQuiz .gb-study-confidence>div{display:flex;flex-wrap:wrap;gap:7px}
  #gbAnalyticsQuiz .gb-study-status{font:500 12px/1.4 system-ui,sans-serif;opacity:.78;margin:0 0 8px}
  #gbAnalyticsQuiz .gb-study-feedback{border-left:2px solid #b08a56;padding:9px 12px;margin:12px 0;background:color-mix(in srgb,#b08a56 8%,transparent)}
  #gbAnalyticsQuiz .gb-study-feedback a{display:inline-block;min-height:35px;margin-top:8px;color:inherit;text-decoration:underline;text-underline-offset:3px}
  #gbAnalyticsQuiz .gb-study-next{display:block;margin:12px 0 0}
  #gbAnalyticsQuiz .gb-study-score{font-weight:650}
  #gbAnalyticsStudy .gb-study-empty {font:400 13px/1.5 system-ui,sans-serif;opacity:.7}
  #gbAnalyticsStudy .gb-study-deeplink {text-decoration:underline;text-underline-offset:3px}
  .gb-study-summary{display:grid;gap:6px;padding:10px 0;font:400 13px/1.5 system-ui,sans-serif}
  .gb-study-summary p{margin:0}
  .gb-study-summary a{display:inline-block;color:inherit;text-decoration:underline;text-underline-offset:3px;min-height:32px}
  #gbrMarginalia .gb-study-summary {padding:10px 12px;border-left:2px solid #a38255}
  #npUResearch .gb-study-summary {padding:10px 12px;border-left:2px solid #a38255}
  @media(max-width:1120px){#gbAnalyticsStudy{margin:12px 10px 16px}}
</style>