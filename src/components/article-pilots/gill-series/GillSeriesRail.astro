---
import SaveButton from '@/components/ui/floating-cluster/SaveButton.astro';
import PlayEmber from '@/components/ui/floating-cluster/PlayEmber.astro';
import SeriesMark from './SeriesMark.astro';
import GillLeatherDefs from './GillLeatherDefs.astro';
import GillLeatherRibbon from './GillLeatherRibbon.astro';
import { GILL_SERIES, satellitesOf, chapterArticles, topLevelItems, type SeriesConfig } from '../_shared/series/seriesConfig';

// Leather bookmark treatment for the two label rows (kind: 'label'):
//   «Введение» → lily ornament, warm leather;  «Справочник» → book ornament,
//   darker neutral-chocolate leather. Roman rows keep the gold numeral.
const leatherFor = (id: string) =>
  id === 'context'
    ? { word: 'Введение', ornament: 'lily' as const, variant: 'default' as const }
    : id === 'spravochnik'
      ? { word: 'Справочник', ornament: 'book' as const, variant: 'reference' as const }
      : null;

interface Props {
  pageId: string;
  config?: SeriesConfig;
}

const { pageId, config = GILL_SERIES } = Astro.props;
const page = config.pages[pageId];
// Верхний уровень рельса: главы + форзацы + плоские части. Спутники живут в
// аккордеоне «Оглавление части», статьи глав (mark 'arabic') — внутри своей
// главы; ни те ни другие не рисуются строками верхнего уровня.
const seriesItems = topLevelItems(config);

// Assign each submenu row to a collapsible group: every top-level (H2) row
// opens a new group; the H3 rows beneath it inherit that group index. The rail
// keeps a FLAT <li> list (so anchors stay in document order for the scroll-spy
// and the parity audit) — collapse is driven by class + max-height on the sub
// rows, not by nesting. `hasSubs` marks groups that actually have sub-rows.
let grpIdx = -1;
const subCountByGrp: Record<number, number> = {};
const partTocRows = page.partToc.map((item) => {
  if (item.level === 2) grpIdx += 1;
  else subCountByGrp[grpIdx] = (subCountByGrp[grpIdx] || 0) + 1;
  return { ...item, grp: Math.max(0, grpIdx) };
});
const currentGrp = (partTocRows.find((r) => r.current) || partTocRows[0] || { grp: 0 }).grp;

// Historical flow-rail (witness bcf6389f + enhancements.js GBS pilot v2.1):
// the current part's compact card is NOT rendered in the list — in its place
// sits the expanded gbs2-current card (cover + «Сейчас читаете» + part title +
// progress bar + the part TOC), with the remaining parts flowing below it.
// The pilot did this client-side (display:none + node moves); the Astro rail
// renders the same result server-side.
// Спутник (tier:'satellite') сам не входит в seriesItems (ядро) — рельс
// показывает окружение его РОДИТЕЛЬСКОЙ части, читатель спутника «Движение
// А1» по-прежнему находится «внутри» Части I для целей навигации/прогресса.
// Без этой развязки currentIdx был -1 → partsBefore/After пустые и
// seriesMeta всегда откатывался на дефолт «Часть 1 из N» (баг, найденный
// content-агентом 2026-07-14 при вводе 18 спутников серии «Сердце»).
const rawCurrent = config.items.find((item) => item.id === pageId);
// Вложенные материалы (спутник части ИЛИ статья главы) разворачиваются на
// своего родителя: рельс показывает окружение части/главы, не самой статьи.
const parentId = rawCurrent?.parent ?? pageId;
const currentIdx = seriesItems.findIndex((item) => item.id === parentId);
const partsBefore = seriesItems.slice(0, Math.max(0, currentIdx));
const partsAfter = currentIdx >= 0 ? seriesItems.slice(currentIdx + 1) : [];
// Введение/Справочник — «label»-пункты серии (mark.kind==="label"), не
// пронумерованные части. Two bugs fixed here together:
//  1. "Часть 1 из 5" for Введение — forbidden wording (audit:
//     premium-controls-rollout-audit.js), the intro isn't "part 1" in any
//     reader sense. Labels show their own mark value instead.
//  2. Numbered parts must count ONLY themselves (I/II/III), not the 5-item
//     raw array — a naive currentIdx+1 over seriesItems.length made
//     Part II read as "Часть 3 из 5" (index 2 in the 5-item list, off by
//     the 2 label entries) instead of the correct "Часть 2 из 3".
const currentItem = currentIdx >= 0 ? seriesItems[currentIdx] : null;
const romanItems = seriesItems.filter((item) => item.mark.kind === 'roman');
const romanIdx = romanItems.findIndex((item) => item.id === parentId);
const partNumber = romanIdx >= 0 ? romanIdx + 1 : 1;
// Книжная серия: римские пункты — ГЛАВЫ, счёт читается «Глава N из M».
const countWord = currentItem?.tier === 'chapter' ? 'Глава' : 'Часть';
const seriesMeta = currentItem && currentItem.mark.kind === 'label'
  ? currentItem.mark.value
  : `${countWord} ${partNumber} из ${romanItems.length}`;

// Owner (2026-07-15): подпункты читаются ПРЯМО В РЕЙЛЕ, без всплывающего окна —
// «в рейле нужно все сделать, там все подпункты пускай раскрываются в пункте».
// Книжная серия: строки «В этой главе» — ВСЕ статьи главы, текущая подсвечена.
// Плоская серия: строки «Дополнения к части» — спутники текущей части.
const currentKids = currentItem
  ? (currentItem.tier === 'chapter' ? chapterArticles(config, currentItem.id) : satellitesOf(config, currentItem.id))
  : [];
const kidsLabel = currentItem?.tier === 'chapter' ? 'В этой главе' : 'Дополнения к части';
---

<aside class="gbs-rail" aria-label={`Серия «${config.seriesTitle}»`}>
  <GillLeatherDefs />
  <!-- Верх рейла: только назад + домой. Поиск/PLAY/скорости уехали в
       gbs-theme-corner (owner: "внизу останется стрелочка назад только,
       и значок домой еще можно"). -->
  <div class="gbs-rail-topbar">
    <button class="gbs-rail-back" type="button" aria-label="Назад" data-home-href={config.railBackHref}>
      <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
    </button>
    <a class="gbs-rail-home" href="/" aria-label="На главную">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8" /><path d="M5 10v10h4v-6h6v6h4V10" /></svg>
    </a>
  </div>

  <!-- Прогресс СЕРИИ (не только текущей части) — восстановлен по образцу
       серии «Сердце» (krajne): .gbs2-rprogress/.gbs2-ring/#gbs2Ring/#gbs2Pct
       взяты 1-в-1 (та же разметка, тот же r=18/circ=113 в CSS). Раньше это
       было и в Gill (до перехода на v16 — коммит 1d9ee644 его убрал вместе
       со старым inline-рейлом), значение считает уже существующая
       updateScrollProgress() в floating-cluster-controller.js по
       data-gbs2-done-min/-part-min/-total-min на body (эти атрибуты у Gill
       уже проставлены, отдельных правок данных не нужно). -->
  <div class="gbs2-rprogress">
    <div class="gbs2-ring" aria-hidden="true">
      <svg width="44" height="44" viewBox="0 0 44 44">
        <circle class="t" cx="22" cy="22" r="18" />
        <circle class="f" id="gbs2Ring" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="113" />
      </svg>
      <b id="gbs2Pct">0%</b>
    </div>
    <div><small>Прогресс серии</small><span id="gbs2Meta">{seriesMeta}</span></div>
  </div>

  <div class="gbs2-rmid" id="gbsRailMid">
    {partsBefore.length > 0 && (
      <nav class="gbs-rail-list" aria-label="Предыдущие части серии">
        {partsBefore.map((item) => { const leather = item.ribbon ?? (item.mark.kind === 'label' ? leatherFor(item.id) : null); return (
          <a class="gbs-rail-card" href={item.href}>
            {leather
              ? <GillLeatherRibbon word={leather.word} ornament={leather.ornament} variant={leather.variant} className="gbs-rail-card__num" />
              : <SeriesMark kind={item.mark.kind} value={item.mark.value} className="gbs-rail-card__num" />}
            <span class="gbs-rail-card__info"><small>{item.readingTime}</small><b>{item.title}</b></span>
            <span class="gbs-rail-card__chevron" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg></span>
          </a>
        ); })}
      </nav>
    )}

    <section
      class="gbs2-current"
      aria-label="Текущая часть"
      aria-current="page"
      style={`--gbs2-cover:url('${page.railCover}')`}
    >
      <div class="gbs2-current-cover" aria-hidden="true"></div>
      <div class="gbs2-current-body">
        <div class="gbs2-current-label">Сейчас читаете</div>
        <h2 class="gbs2-current-title">{page.railNowTitle}</h2>
        <div class="gbs2-curbar"><i id="gbs2Curbar"></i></div>
      </div>
      <div class="gbs2-toch">
        <span>{currentItem?.tier === 'chapter' ? 'Оглавление статьи' : 'Оглавление части'}</span>
        <span class="gbs2-count" id="gbs2Count">1 / {page.partToc.length}</span>
        <!-- Mechanism 3: раскрытие/сворачивание оглавления части. Персист в
             localStorage gb:rail:toc-collapsed; класс toc-collapsed на
             .gbs2-current. Шеврон вниз (раскрыто) → вправо (свёрнуто). -->
        <button class="gbs2-toch-toggle" id="gbsTocToggle" type="button" aria-expanded="true" aria-controls="gbsTocScroll" aria-label="Свернуть оглавление части">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
        </button>
      </div>
      <div class="gbs2-tocscroll" id="gbsTocScroll">
        {/* Historical placement (witness bcf6389f): the track lives INSIDE the ul —
            .gbs2-track{left:9px} resolves against .gbs2-toc, putting the line exactly
            through the dot centres (dots sit at left:-17px from the 22px list padding).
            As a .gbs2-tocscroll sibling it was offset by the ul inset → dots floated
            7.5px right of the line (audit §8 dot-alignment caught this). */}
        <ul class="gbs2-toc" id="gbs2Toc" data-gbs2-cur-grp={String(currentGrp)}>
          <span aria-hidden="true" class="gbs2-track"><i></i></span>
          {partTocRows.map((item) => (
            <li
              class:list={{ 'gbs2-sub': item.level === 3, 'gbs2-collapsed': item.level === 3 && item.grp !== currentGrp }}
              data-gbs2-grp={String(item.grp)}
            ><a href={item.href} class:list={{ 'gbs2-active': item.current }}><span aria-hidden="true" class="gbs2-dot"></span>{item.label}</a></li>
          ))}
        </ul>
        {currentKids.length > 0 && (
          <div class="gbs2-sats">
            <span class="gbs2-sats-lab">{kidsLabel}</span>
            {currentKids.map((kid) => {
              const kidNum = kid.mark.value.includes('.') ? kid.mark.value.split('.')[1] : kid.mark.value;
              const isHere = kid.id === pageId;
              return (
                <a class:list={['gbs2-satrow', isHere && 'is-here']} href={isHere ? undefined : kid.href} aria-current={isHere ? 'page' : undefined}>
                  <span class="gbs2-satmark" aria-hidden="true">{kidNum}</span>
                  <span class="gbs2-satrow-t">{kid.title}</span>
                  <span class="gbs2-satrow-min">{kid.readingTime}</span>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </section>

    {partsAfter.length > 0 && (
      <nav class="gbs-rail-list gbs-rail-list--after" aria-label="Следующие части серии">
        {partsAfter.map((item) => { const leather = item.ribbon ?? (item.mark.kind === 'label' ? leatherFor(item.id) : null); return (
          <a class="gbs-rail-card" href={item.href}>
            {leather
              ? <GillLeatherRibbon word={leather.word} ornament={leather.ornament} variant={leather.variant} className="gbs-rail-card__num" />
              : <SeriesMark kind={item.mark.kind} value={item.mark.value} className="gbs-rail-card__num" />}
            <span class="gbs-rail-card__info"><small>{item.readingTime}</small><b>{item.title}</b></span>
            <span class="gbs-rail-card__chevron" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg></span>
          </a>
        ); })}
      </nav>
    )}
  </div>

  <div class="gbs-rail-foot" data-fc-root data-fc-variant="gill" data-fc-mode="series-rich">
    <!-- Real site-sections menu (owner, said several times: this icon must
         open the menu, not search) — reuses the exact canon dropdown already
         wired site-wide (#hMobileMenuBtn/#hMobileNav/#hMobileBackdrop, JS in
         site.js, markup+links pattern from PastorSeriesPageChrome.astro),
         just rendered once here in GillSeriesChrome.astro. Search stays a
         click away via the corner-cluster magnifying glass. -->
    <button class="gbs-rail-foot__btn gbs-rail-menu-btn" type="button" id="hMobileMenuBtn" aria-label="Открыть меню" aria-expanded="false" data-tip="Меню сайта"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><line class="burger-top" x1="4" y1="7" x2="20" y2="7" /><line class="burger-mid" x1="4" y1="12" x2="20" y2="12" /><line class="burger-bottom" x1="4" y1="17" x2="20" y2="17" /></svg></button>
    <!-- Настройки чтения (owner: собрать A-/A+ + тему в одно меню, «как на
         телефоне»): открывает ТОТ ЖЕ GillReaderSettingsSheet, что и мобильный
         mobSettingsBtn — второй триггер на тот же оверлей, не дублирующий
         логику (floating-cluster-controller.js слушает ЛЮБОЙ элемент с
         [data-gill-settings-open], а не только id). Ширина текста в листе
         на десктопе спрятана (owner: «не меняем» ширину статьи). -->
    <button class="gbs-rail-foot__btn" type="button" id="railSettingsBtn" data-gill-settings-open aria-label="Настройки чтения" aria-expanded="false" aria-controls="gillSettingsOverlay" data-tip="Настройки"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h10M18 7h2M4 17h2M10 17h10" /><circle cx="16" cy="7" r="2" /><circle cx="8" cy="17" r="2" /></svg></button>
    <!-- Скачать: тот же data-action="print" → window.print() (тот же глобальный
         обработчик, что и в футере part-TOC) — системный диалог печати даёт
         выбрать «Сохранить как PDF» или реальный принтер. Иконка — классическая
         «скачать» (стрелка в лоток), не принтер: то же действие, другой смысл
         для читателя (owner: скачать, а не распечатать). -->
    <button class="gbs-rail-foot__btn" type="button" data-action="print" aria-label="Скачать страницу" data-tip="Скачать"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12" /><polyline points="7 10 12 15 17 10" /><path d="M5 21h14" /></svg></button>
    <button class="gbs-rail-foot__btn" data-action="share" aria-label="Поделиться" data-tip="Поделиться"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="2.6" /><circle cx="6" cy="12" r="2.6" /><circle cx="18" cy="19" r="2.6" /><path d="M8.3 10.7l7.4-4.2M8.3 13.3l7.4 4.2" /></svg></button>
  </div>
</aside>

<!-- Единый вертикальный кластер — та же позиция, что раньше держала только
     тему (top:calc(clamp(24px,3.5vw,44px) - 4px); right:max(8.5vw,...),
     1-в-1 с .gb-floater--hermeneutics — формулу не переизобретаю). Owner:
     "перенести PLAY и поиск в ГИЛЛЕ под SVG день ночь и добавить в
     избранное: день-ночь, поиск, PLAY (с нынешним раскрытием), избранное" —
     4 чистых SVG, тот же canonical паттерн, что уже есть на одиночных
     статьях (SingleArticleCluster: theme → search → PlayEmber → Save).
     Скорость больше НЕ кастомный слот-свап (поиск ⇄ чипы) — тот флайаут был
     непрошеным отклонением от canonical-паттерна и мешал: подряд два разных
     UI для одной вещи. Теперь ember без data-gb-speed-custom, поэтому
     initPlayExpand() в floating-cluster-controller.js сама вешает
     canonical-панель .gb-ember-expand — тот же bloom и то же направление
     (влево), что и на одиночных статьях, без Gill-специфичных отклонений. -->
<div class="gbs-theme-corner" data-fc-root data-fc-variant="gill" data-fc-mode="series-rich">
  <button class="gb-icon gb-theme-toggle" data-fc-action="theme" aria-label="Тема" aria-pressed="false">
    <span class="theme-icon-sun" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg></span>
    <span class="theme-icon-moon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg></span>
  </button>
  <button class="gb-icon" data-fc-action="search" aria-label="Поиск" data-tip="Поиск"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg></button>
  <span class="gbs-rail-playwrap">
    <PlayEmber audioState="none" class="gbs-rail-ember" tip="Озвучка" />
    <span class="gbs-rail-spdbadge" id="gbsRailSpdBadge" aria-hidden="true">1×</span>
  </span>
  <SaveButton tip="Сохранить" />
</div>
