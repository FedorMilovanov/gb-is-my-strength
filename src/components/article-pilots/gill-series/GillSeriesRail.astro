---
import SaveButton from '@/components/ui/floating-cluster/SaveButton.astro';
import PlayEmber from '@/components/ui/floating-cluster/PlayEmber.astro';
import SeriesMark from './SeriesMark.astro';
import GillLeatherDefs from './GillLeatherDefs.astro';
import GillLeatherRibbon from './GillLeatherRibbon.astro';
import { GILL_PAGE_DATA, GILL_SERIES_ITEMS, type GillSeriesPageId } from './gillSeriesData';

// Leather bookmark treatment for the two label rows (kind: 'label'):
//   «Введение» → lily ornament, warm leather;  «Справочник» → book ornament,
//   darker neutral-chocolate leather. Roman rows keep the gold numeral.
const leatherFor = (id: string) =>
  id === 'context'
    ? { word: 'Введение', ornament: 'lily' as const, variant: 'default' as const }
    : id === 'spravochnik'
      ? { word: 'Справочник', ornament: 'book' as const, variant: 'reference' as const }
      : null;

interface Props {
  pageId: GillSeriesPageId;
}

const { pageId } = Astro.props;
const page = GILL_PAGE_DATA[pageId];

// Assign each submenu row to a collapsible group: every top-level (H2) row
// opens a new group; the H3 rows beneath it inherit that group index. The rail
// keeps a FLAT <li> list (so anchors stay in document order for the scroll-spy
// and the parity audit) — collapse is driven by class + max-height on the sub
// rows, not by nesting. `hasSubs` marks groups that actually have sub-rows.
let grpIdx = -1;
const subCountByGrp: Record<number, number> = {};
const partTocRows = page.partToc.map((item) => {
  if (item.level === 2) grpIdx += 1;
  else subCountByGrp[grpIdx] = (subCountByGrp[grpIdx] || 0) + 1;
  return { ...item, grp: Math.max(0, grpIdx) };
});
const currentGrp = (partTocRows.find((r) => r.current) || partTocRows[0] || { grp: 0 }).grp;

// Historical flow-rail (witness bcf6389f + enhancements.js GBS pilot v2.1):
// the current part's compact card is NOT rendered in the list — in its place
// sits the expanded gbs2-current card (cover + «Сейчас читаете» + part title +
// progress bar + the part TOC), with the remaining parts flowing below it.
// The pilot did this client-side (display:none + node moves); the Astro rail
// renders the same result server-side.
const currentIdx = GILL_SERIES_ITEMS.findIndex((item) => item.id === pageId);
const partsBefore = GILL_SERIES_ITEMS.slice(0, Math.max(0, currentIdx));
const partsAfter = currentIdx >= 0 ? GILL_SERIES_ITEMS.slice(currentIdx + 1) : [];
const partNumber = currentIdx >= 0 ? currentIdx + 1 : 1;
---

<aside class="gbs-rail" aria-label="Серия «Джон Гилл»">
  <GillLeatherDefs />
  <!-- Верх рейла: назад + слот-свап (поиск ⇄ скорости) + Play. Тот же
       механизм, что проверен на мобильном референсе (bar.html): PLAY жмут —
       иконка поиска уходит, на её месте выезжают чипы скорости в том же
       слоте; выбор скорости — чипы уходят, поиск возвращается, выбранная
       скорость остаётся бейджем на самом Play. НЕ goo-блум (GooPlayMini) и
       НЕ канонная bloom-пилюля (initPlayExpand/.gb-ember-expand) — обе
       заблокированы data-gb-speed-custom на этом ember, чтобы не завести
       вторую параллельную панель скоростей. -->
  <div class="gbs-rail-topbar" data-fc-root data-fc-variant="gill" data-fc-mode="series-rich" data-gb-speed-custom>
    <button class="gbs-rail-back" type="button" aria-label="Назад" data-home-href="../../biografii/">
      <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
    </button>
    <div class="gbs-rail-slot" id="gbsRailSlot">
      <button class="gbs-rail-foot__btn gbs-rail-slot__search" data-fc-action="search" aria-label="Поиск" data-tip="Поиск"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg></button>
      <div class="gbs-rail-speedrail" id="gbsRailSpeedrail" role="radiogroup" aria-label="Скорость озвучки">
        <button class="gbs-rail-spd" type="button" role="radio" data-speed="1" aria-checked="true">1×</button>
        <button class="gbs-rail-spd" type="button" role="radio" data-speed="1.25" aria-checked="false">1.25×</button>
        <button class="gbs-rail-spd" type="button" role="radio" data-speed="1.5" aria-checked="false">1.5×</button>
        <button class="gbs-rail-spd" type="button" role="radio" data-speed="1.75" aria-checked="false">1.75×</button>
        <button class="gbs-rail-spd" type="button" role="radio" data-speed="2" aria-checked="false">2×</button>
      </div>
    </div>
    <span class="gbs-rail-playwrap">
      <PlayEmber audioState="none" class="gbs-rail-ember" tip="Озвучка" />
      <button class="gbs-rail-spdbadge" id="gbsRailSpdBadge" type="button" aria-label="Выбрать скорость, сейчас 1×">1×</button>
    </span>
  </div>

  <!-- Прогресс СЕРИИ (не только текущей части) — восстановлен по образцу
       серии «Сердце» (krajne): .gbs2-rprogress/.gbs2-ring/#gbs2Ring/#gbs2Pct
       взяты 1-в-1 (та же разметка, тот же r=18/circ=113 в CSS). Раньше это
       было и в Gill (до перехода на v16 — коммит 1d9ee644 его убрал вместе
       со старым inline-рейлом), значение считает уже существующая
       updateScrollProgress() в floating-cluster-controller.js по
       data-gbs2-done-min/-part-min/-total-min на body (эти атрибуты у Gill
       уже проставлены, отдельных правок данных не нужно). -->
  <div class="gbs2-rprogress">
    <div class="gbs2-ring" aria-hidden="true">
      <svg width="44" height="44" viewBox="0 0 44 44">
        <circle class="t" cx="22" cy="22" r="18" />
        <circle class="f" id="gbs2Ring" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="113" />
      </svg>
      <b id="gbs2Pct">0%</b>
    </div>
    <div><small>Прогресс серии</small><span id="gbs2Meta">Часть {partNumber} из {GILL_SERIES_ITEMS.length}</span></div>
  </div>

  <div class="gbs2-rmid">
    {partsBefore.length > 0 && (
      <nav class="gbs-rail-list" aria-label="Предыдущие части серии">
        {partsBefore.map((item) => { const leather = item.mark.kind === 'label' ? leatherFor(item.id) : null; return (
          <a class="gbs-rail-card" href={item.href}>
            {leather
              ? <GillLeatherRibbon word={leather.word} ornament={leather.ornament} variant={leather.variant} className="gbs-rail-card__num" />
              : <SeriesMark kind={item.mark.kind} value={item.mark.value} className="gbs-rail-card__num" />}
            <span class="gbs-rail-card__info"><small>{item.readingTime}</small><b>{item.title}</b></span>
            <span class="gbs-rail-card__chevron" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg></span>
          </a>
        ); })}
      </nav>
    )}

    <section
      class="gbs2-current"
      aria-label="Текущая часть"
      aria-current="page"
      style={`--gbs2-cover:url('${page.railCover}')`}
    >
      <div class="gbs2-current-cover" aria-hidden="true"></div>
      <div class="gbs2-current-body">
        <div class="gbs2-current-label">Сейчас читаете</div>
        <h2 class="gbs2-current-title">{page.railNowTitle}</h2>
        <div class="gbs2-curbar"><i id="gbs2Curbar"></i></div>
      </div>
      <div class="gbs2-toch"><span>Оглавление части</span><span class="gbs2-count" id="gbs2Count">1 / {page.partToc.length}</span></div>
      <div class="gbs2-tocscroll">
        {/* Historical placement (witness bcf6389f): the track lives INSIDE the ul —
            .gbs2-track{left:9px} resolves against .gbs2-toc, putting the line exactly
            through the dot centres (dots sit at left:-17px from the 22px list padding).
            As a .gbs2-tocscroll sibling it was offset by the ul inset → dots floated
            7.5px right of the line (audit §8 dot-alignment caught this). */}
        <ul class="gbs2-toc" id="gbs2Toc" data-gbs2-cur-grp={String(currentGrp)}>
          <span aria-hidden="true" class="gbs2-track"><i></i></span>
          {partTocRows.map((item) => (
            <li
              class:list={{ 'gbs2-sub': item.level === 3, 'gbs2-collapsed': item.level === 3 && item.grp !== currentGrp }}
              data-gbs2-grp={String(item.grp)}
            ><a href={item.href} class:list={{ 'gbs2-active': item.current }}><span aria-hidden="true" class="gbs2-dot"></span>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </section>

    {partsAfter.length > 0 && (
      <nav class="gbs-rail-list gbs-rail-list--after" aria-label="Следующие части серии">
        {partsAfter.map((item) => { const leather = item.mark.kind === 'label' ? leatherFor(item.id) : null; return (
          <a class="gbs-rail-card" href={item.href}>
            {leather
              ? <GillLeatherRibbon word={leather.word} ornament={leather.ornament} variant={leather.variant} className="gbs-rail-card__num" />
              : <SeriesMark kind={item.mark.kind} value={item.mark.value} className="gbs-rail-card__num" />}
            <span class="gbs-rail-card__info"><small>{item.readingTime}</small><b>{item.title}</b></span>
            <span class="gbs-rail-card__chevron" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg></span>
          </a>
        ); })}
      </nav>
    )}
  </div>

  <div class="gbs-rail-foot" data-fc-root data-fc-variant="gill" data-fc-mode="series-rich">
    <button class="gbs-rail-foot__btn gbs-rail-foot__btn--text" data-fc-action="font-down" aria-label="Уменьшить шрифт" data-tip="Меньше">A−</button>
    <button class="gbs-rail-foot__btn gbs-rail-foot__btn--text" data-fc-action="font-up" aria-label="Увеличить шрифт" data-tip="Больше">A+</button>
    <SaveButton class="gbs-rail-foot__btn" tip="Сохранить" />
  </div>
</aside>

<!-- Тема — вынесена из рейла на уровень хлебных крошек в колонке статьи.
     Канон 1-в-1: та же разметка (.gb-icon.gb-theme-toggle — halo-ring, crossfade
     sun/moon), тот же fixed top/right что и у .gb-floater--hermeneutics
     (css/floating-cluster.css: "DO NOT invent calc formulas — use these exact
     values": top:calc(clamp(24px,3.5vw,44px) - 4px); right:max(8.5vw,...)).
     Не переизобретаю новый вид кружка — просто другой [data-fc-root] с той же
     канонной кнопкой, не завязанной на gbs-rail-foot. -->
<div class="gbs-theme-corner" data-fc-root data-fc-variant="gill" data-fc-mode="series-rich">
  <button class="gb-icon gb-theme-toggle" data-fc-action="theme" aria-label="Тема" aria-pressed="false">
    <span class="theme-icon-sun" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg></span>
    <span class="theme-icon-moon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg></span>
  </button>
</div>

<script>
  // Слот-свап скоростей в верхнем рейле — та же механика, что проверена на
  // мобильном референсе (bar.html): openSpeeds/closeSpeeds, drag с отложенным
  // setPointerCapture (чтобы обычный тап не промахивался мимо чипа), бейдж
  // выбранной скорости на самом Play. НЕ дублирует применение скорости —
  // читает/пишет те же ключи localStorage и тот же CustomEvent, что и
  // канонная initPlayExpand() в floating-cluster-controller.js, так TTS-движок
  // подхватывает выбор одинаково, откуда бы он ни пришёл.
  (function () {
    function initGillRailSpeedSlot(topbar: HTMLElement) {
      var ember = topbar.querySelector('.gbs-rail-ember') as HTMLElement | null;
      var speedrail = topbar.querySelector('.gbs-rail-speedrail') as HTMLElement | null;
      var badge = topbar.parentElement ? topbar.parentElement.querySelector('.gbs-rail-spdbadge') as HTMLElement | null : null;
      if (!ember || !speedrail || !badge) return;
      var chips = Array.prototype.slice.call(speedrail.querySelectorAll('.gbs-rail-spd')) as HTMLElement[];
      var offeredThisSession = false;
      var closeTimer: ReturnType<typeof setTimeout> | null = null;

      function fmt(r: number) { return String(r).replace(/\.0$/, '') + '×'; }
      function readRate() {
        try {
          var r = parseFloat(localStorage.getItem('gb:audio:rate') || localStorage.getItem('gbx-tts-rate') || '1');
          return (!isNaN(r) && r > 0) ? r : 1;
        } catch (_) { return 1; }
      }
      function syncActive(rate: number) {
        chips.forEach(function (c) {
          var on = parseFloat(c.dataset.speed || '') === rate;
          c.setAttribute('aria-checked', on ? 'true' : 'false');
        });
        badge!.textContent = fmt(rate);
        badge!.setAttribute('aria-label', 'Выбрать скорость, сейчас ' + fmt(rate));
      }
      syncActive(readRate());

      function open(autoClose: boolean) {
        if (closeTimer) clearTimeout(closeTimer);
        topbar.classList.add('speed-open');
        var active = speedrail!.querySelector('.gbs-rail-spd[aria-checked="true"]') as HTMLElement | null;
        if (active) { var activeChip = active; setTimeout(function () { activeChip.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'auto' }); }, 20); }
        if (autoClose) closeTimer = setTimeout(close, 4500);
      }
      function close() {
        if (closeTimer) clearTimeout(closeTimer);
        topbar.classList.remove('speed-open');
      }

      // Первый свежий запуск (idle/complete → playing) один раз за сессию
      // предлагает рельсу; повторный play/pause (resume) её не трогает.
      var prevState = ember.dataset.state || 'idle';
      new MutationObserver(function () {
        var state = ember!.dataset.state || 'idle';
        if (state === 'playing' && (prevState === 'idle' || prevState === 'complete') && !offeredThisSession) {
          offeredThisSession = true;
          open(true);
        }
        prevState = state;
      }).observe(ember, { attributes: true, attributeFilter: ['data-state'] });

      badge.addEventListener('click', function (e: Event) {
        e.preventDefault();
        e.stopPropagation();
        topbar.classList.contains('speed-open') ? close() : open(false);
      });

      chips.forEach(function (chip) {
        chip.addEventListener('click', function (e: Event) {
          e.stopPropagation();
          var rate = parseFloat(chip.dataset.speed || '');
          syncActive(rate);
          badge!.classList.remove('is-bump'); void badge!.offsetWidth; badge!.classList.add('is-bump');
          try {
            localStorage.setItem('gb:audio:rate', String(rate));
            localStorage.setItem('gbx-tts-rate', String(rate));
          } catch (_) {}
          window.dispatchEvent(new CustomEvent('gb:tts-rate-change', { detail: { rate: rate } }));
          setTimeout(close, 220);
        });
      });

      window.addEventListener('gb:tts-rate-change', function (ev: Event) {
        var r = (ev as CustomEvent)?.detail?.rate;
        if (typeof r === 'number' && !isNaN(r)) syncActive(r);
      });

      document.addEventListener('pointerdown', function (e: PointerEvent) {
        if (topbar.classList.contains('speed-open') && !topbar.contains(e.target as Node)) close();
      }, { passive: true });

      // Drag-to-scroll: setPointerCapture только после реального сдвига, иначе
      // обычный тап по чипу не долетает до его click-обработчика (тот самый
      // баг, уже пойманный и исправленный на мобильном референсе).
      var dragging = false, startX = 0, startScroll = 0, moved = false, pid: number | null = null;
      speedrail.addEventListener('pointerdown', function (e: PointerEvent) {
        dragging = true; moved = false; startX = e.clientX; startScroll = speedrail!.scrollLeft; pid = e.pointerId;
      });
      speedrail.addEventListener('pointermove', function (e: PointerEvent) {
        if (!dragging || e.pointerId !== pid) return;
        var dx = e.clientX - startX;
        if (!moved && Math.abs(dx) > 4) {
          moved = true;
          speedrail!.classList.add('is-dragging');
          try { speedrail!.setPointerCapture(pid as number); } catch (_) {}
        }
        if (moved) speedrail!.scrollLeft = startScroll - dx;
      });
      function endDrag(e: PointerEvent) {
        if (!dragging || (pid !== null && e.pointerId !== pid)) return;
        dragging = false; pid = null;
        speedrail!.classList.remove('is-dragging');
      }
      speedrail.addEventListener('pointerup', endDrag);
      speedrail.addEventListener('pointercancel', endDrag);
      speedrail.addEventListener('click', function (e: MouseEvent) { if (moved) { e.stopPropagation(); moved = false; } }, true);
    }

    function boot() {
      document.querySelectorAll('.gbs-rail-topbar[data-gb-speed-custom]').forEach(function (el) { initGillRailSpeedSlot(el as HTMLElement); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
    else boot();
  })();
</script>
