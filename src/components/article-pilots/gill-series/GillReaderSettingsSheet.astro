---
/**
 * GillReaderSettingsSheet — mobile (<64em) reading settings for the Gill
 * series: theme (День/Сепия/Ночь), text size (A−/A+, reuses the existing
 * site-wide font-scale contract via data-fc-action), line-height and
 * measure (width). Same .toc-overlay/.toc-sheet shell as the other Gill
 * sheets — open/close/focus-trap/scroll-lock come from
 * initTocPopups() in floating-cluster-controller.js.
 *
 * State comes from the universal GBReaderPreferences store. Existing Gill
 * attributes/CSS variables remain a compatibility adapter so visual parity and
 * selectors stay stable while Day, Sepia, Night, line height and measure now
 * persist across books, series, standalone articles and ordinary pages.
 *
 * Carries an optional `config` prop for series-engine symmetry (Chrome threads
 * the same SeriesConfig to every subcomponent); this sheet is data-free, so the
 * prop is currently unused at render time.
 */
import { GILL_SERIES, type SeriesConfig } from '../_shared/series/seriesConfig';

interface Props {
  config?: SeriesConfig;
}

const { config: _config = GILL_SERIES } = Astro.props as Props;
---
<div id="gillSettingsOverlay" class="toc-overlay gill-settings-overlay" data-gill-overlay="settings" aria-hidden="true">
  <section class="toc-sheet gill-settings-sheet" role="dialog" aria-modal="true" aria-labelledby="gillSettingsTitle">
    <button type="button" class="toc-sheet__handle" data-overlay-close aria-label="Закрыть настройки"></button>
    <div class="toc-sheet__head">
      <div class="head-copy"><div class="lab">Чтение</div><h3 id="gillSettingsTitle">Настройки</h3></div>
      <button type="button" class="gb-icon" data-overlay-close aria-label="Закрыть"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
    </div>
    <div class="toc-sheet__body">
      <div class="setting-group">
        <span class="setting-label">Тема</span>
        <div class="setting-segment" id="gillSettingsThemeGroup">
          <button type="button" class="reader-setting-btn" data-gill-theme-btn data-theme="light" aria-pressed="true">День</button>
          <button type="button" class="reader-setting-btn" data-gill-theme-btn data-theme="sepia" aria-pressed="false">Сепия</button>
          <button type="button" class="reader-setting-btn" data-gill-theme-btn data-theme="dark" aria-pressed="false">Ночь</button>
        </div>
      </div>
      <div class="setting-group">
        <span class="setting-label">Размер текста</span>
        <div class="font-track">
          <button type="button" class="font-step font-step--sm" data-fc-action="font-down" aria-label="Уменьшить текст">A</button>
          <div class="font-dots" id="gillFontDots" aria-hidden="true"></div>
          <button type="button" class="font-step font-step--lg" data-fc-action="font-up" aria-label="Увеличить текст">A</button>
        </div>
      </div>
      <div class="setting-group">
        <span class="setting-label">Межстрочный интервал</span>
        <div class="setting-segment" id="gillLineHeightGroup">
          <button type="button" class="reader-setting-btn" data-line="compact" aria-pressed="false">Плотный</button>
          <button type="button" class="reader-setting-btn" data-line="normal" aria-pressed="true">Обычный</button>
          <button type="button" class="reader-setting-btn" data-line="relaxed" aria-pressed="false">Свободный</button>
        </div>
      </div>
      <!-- Ширина статьи — единая настройка всех reader surfaces. Значение
           «Шире» намеренно ограничено 46rem: заметно просторнее обычного, но
           сохраняет безопасный коридор для desktop speed-morph. -->
      <div class="setting-group setting-group--measure">
        <span class="setting-label">Ширина статьи</span>
        <div class="setting-segment" id="gillMeasureGroup">
          <button type="button" class="reader-setting-btn" data-measure="narrow" aria-pressed="false">Узкая</button>
          <button type="button" class="reader-setting-btn" data-measure="normal" aria-pressed="true">Обычная</button>
          <button type="button" class="reader-setting-btn" data-measure="wide" aria-pressed="false">Шире</button>
        </div>
      </div>
      <div class="setting-group">
        <span class="setting-label">Оформление текста</span>
        <div class="setting-segment" id="gillTextModeGroup">
          <button type="button" class="reader-setting-btn" data-text-mode="rich" aria-pressed="true">Полное</button>
          <button type="button" class="reader-setting-btn" data-text-mode="plain" aria-pressed="false">Простое</button>
        </div>
      </div>
      <div class="setting-group">
        <span class="setting-label">Анимация</span>
        <div class="setting-segment" id="gillMotionGroup">
          <button type="button" class="reader-setting-btn" data-motion="system" aria-pressed="true">Обычная</button>
          <button type="button" class="reader-setting-btn" data-motion="reduced" aria-pressed="false">Спокойная</button>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  const LINE_VALUES: Record<string, string> = { compact: '1.45', normal: '1.6', relaxed: '1.85' };
  // B6: intentional — Gill maps narrow/normal/wide to 36/43/46rem (same as the
  // first-paint bootstrap); standalone maps the same keys to 42/50/58rem.
  const MEASURE_VALUES: Record<string, string> = { narrow: '36rem', normal: '43rem', wide: '46rem' };

  function initGillReaderSettings() {
    const overlay = document.getElementById('gillSettingsOverlay');
    if (!overlay) return;
    const gillRoot = document.querySelector('[data-gill-v16]') as HTMLElement | null;
    const api = () => (window as any).GBReaderPreferences || null;
    const state = () => api()?.get?.() || (window as any).__GB_READER_PREFS_BOOTSTRAP__ || { theme: 'light', fontScale: 1, lineHeight: 'normal', measure: 'normal' };

    function setPressed(group: Element | null, attribute: string, value: string) {
      group?.querySelectorAll('button').forEach((button) => {
        const element = button as HTMLElement;
        element.setAttribute('aria-pressed', element.getAttribute(attribute) === value ? 'true' : 'false');
      });
    }

    const lineGroup = document.getElementById('gillLineHeightGroup');
    const measureGroup = document.getElementById('gillMeasureGroup');
    const themeGroup = document.getElementById('gillSettingsThemeGroup');
    const textModeGroup = document.getElementById('gillTextModeGroup');
    const motionGroup = document.getElementById('gillMotionGroup');
    const dots = document.getElementById('gillFontDots');

    function applyCompatibility(preferences: any) {
      const line = preferences.lineHeight || 'normal';
      const measure = preferences.measure || 'normal';
      if (gillRoot) {
        gillRoot.style.setProperty('--gbs2-article-line', LINE_VALUES[line] || LINE_VALUES.normal);
        const measureValue = MEASURE_VALUES[measure] || MEASURE_VALUES.normal;
        gillRoot.style.setProperty('--gbs2-article-measure', `min(${measureValue}, var(--gb-measure, ${measureValue}))`);
        if (preferences.theme === 'sepia') gillRoot.setAttribute('data-gill-reader-theme', 'sepia');
        else gillRoot.removeAttribute('data-gill-reader-theme');
      }
    }

    function syncDots(scale: number) {
      if (!dots) return;
      if (!dots.childElementCount) {
        for (let i = 0; i < 5; i++) { const dot = document.createElement('span'); dot.className = 'font-dot'; dots.appendChild(dot); }
      }
      const index = Math.round(((Number(scale) || 1) - .85) / .05);
      Array.prototype.forEach.call(dots.children, (dot: HTMLElement, i: number) => dot.classList.toggle('is-on', i <= index));
    }

    function sync(preferences = state()) {
      applyCompatibility(preferences);
      setPressed(lineGroup, 'data-line', preferences.lineHeight || 'normal');
      setPressed(measureGroup, 'data-measure', preferences.measure || 'normal');
      setPressed(themeGroup, 'data-theme', preferences.theme || 'light');
      setPressed(textModeGroup, 'data-text-mode', preferences.textMode || 'rich');
      setPressed(motionGroup, 'data-motion', preferences.motion || 'system');
      syncDots(preferences.fontScale || 1);
    }

    lineGroup?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('[data-line]') as HTMLElement | null;
      if (!button) return;
      const value = button.dataset.line || 'normal';
      if (api()) api().set({ lineHeight: value }, { source: 'series-reader-settings' });
      else sync({ ...state(), lineHeight: value });
    });

    measureGroup?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('[data-measure]') as HTMLElement | null;
      if (!button) return;
      const value = button.dataset.measure || 'normal';
      if (api()) api().set({ measure: value }, { source: 'series-reader-settings' });
      else sync({ ...state(), measure: value });
    });

    textModeGroup?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('[data-text-mode]') as HTMLElement | null;
      if (!button) return;
      const value = button.dataset.textMode || 'rich';
      if (api()) api().set({ textMode: value }, { source: 'series-reader-settings' });
      else sync({ ...state(), textMode: value });
    });

    motionGroup?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('[data-motion]') as HTMLElement | null;
      if (!button) return;
      const value = button.dataset.motion || 'system';
      if (api()) api().set({ motion: value }, { source: 'series-reader-settings' });
      else sync({ ...state(), motion: value });
    });

    themeGroup?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('[data-gill-theme-btn]') as HTMLElement | null;
      if (!button) return;
      const theme = button.dataset.theme || 'light';
      if ((window as any).applyGillReaderTheme) (window as any).applyGillReaderTheme(theme);
      else if (api()) api().setTheme(theme, { source: 'series-reader-settings' });
    });

    document.querySelectorAll('[data-fc-action="font-up"], [data-fc-action="font-down"]').forEach((button) => {
      button.addEventListener('click', () => requestAnimationFrame(() => sync()));
    });
    document.addEventListener('gb:reader-preferences-change', (event: Event) => {
      sync((event as CustomEvent).detail?.preferences || state());
    });
    sync();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initGillReaderSettings, { once: true });
  else initGillReaderSettings();
</script>
