<style is:global>
  [data-gill-v16],
  [data-gill-v16] .page-wrap,
  [data-gill-v16] .article-body {
    min-inline-size: 0;
  }

  /*
   * Desktop series chrome starts at 64rem and reserves a fixed 304px rail.
   * The legacy page/main widths are viewport-based, so at the exact 1024px
   * boundary a nested article can remain 92vw wide inside the reduced content
   * area and create a ~147px horizontal overflow. Keep the desktop rail, but
   * size the content column against the viewport remainder and force nested
   * article mains to honor that containing block.
   */
  @media (min-width: 64rem) {
    body[data-gbs2-series] [data-gill-v16] .page-wrap {
      box-sizing: border-box;
      width: min(820px, calc(100vw - 304px));
      max-width: calc(100vw - 304px);
    }

    body[data-gbs2-series] [data-gill-v16] .page-wrap > main.article-main {
      box-sizing: border-box;
      width: 100%;
      max-width: 100%;
      margin-inline: auto;
    }
  }

  @media (max-width: 63.999rem) {
    /*
     * The fixed mobile bar is the interaction owner. WebKit can otherwise
     * hit-test text underneath a transparent control surface while the
     * button remains visibly on top. Keep the whole control rectangle
     * pointer-active and make its decorative text children transparent to
     * pointer targeting, so touch/click always resolves to the native button.
     */
    [data-gill-v16] .mobile-bottom-bar,
    [data-gill-v16] .mobile-btoc-section {
      pointer-events: auto !important;
    }

    [data-gill-v16] .mobile-btoc-section {
      touch-action: manipulation;
    }

    [data-gill-v16] .mobile-btoc-section > * {
      pointer-events: none !important;
    }

    /*
     * Series routes own a fixed bottom bar but do not depend on the legacy
     * body.has-bottom-bar class. Keep the native resume prompt above that bar.
     */
    body[data-gbs2-series] .bookmark-toast {
      bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    }

    /*
     * WebKit may still hit-test wrapped resume copy below the toast box over
     * the bar. The copy is informational, so it must not become a touch
     * target; the close control and action buttons remain fully interactive.
     */
    body[data-gbs2-series] .bookmark-toast-copy,
    body[data-gbs2-series] .bookmark-toast-copy * {
      pointer-events: none !important;
    }

    body[data-gbs2-series] .bookmark-toast-close,
    body[data-gbs2-series] .bookmark-toast-actions,
    body[data-gbs2-series] .bookmark-toast-actions * {
      pointer-events: auto !important;
    }
  }

  @media (max-width: 48rem) {
    /*
     * `data-gill-v16` is retained as a historical shared-engine layout hook,
     * so non-Gill series also carry it. Legacy floating-cluster CSS hides
     * heading paperclips under that hook on narrow layouts with an !important
     * rule. Native heading-anchor ownership is retained by the other series,
     * therefore restore the target whenever the canonical series identity says
     * this is not Gill. Use the same width boundary as the legacy responsive
     * treatment instead of input-device heuristics: a narrow desktop/browser
     * viewport must not silently lose a retained capability either. Gill keeps
     * its reviewed mobile paperclip-hidden treatment.
     */
    body[data-gbs2-series]:not([data-gbs2-series="dzhon-gill"])
      [data-gill-v16]
      .heading-anchor[data-gb-heading-anchor-owner="native-v1"] {
      display: inline-flex !important;
    }

    [data-gill-v16] .article-body > * {
      min-inline-size: 0;
      max-inline-size: 100%;
    }

    [data-gill-v16] table.manuscript-table {
      display: block;
      inline-size: 100%;
      max-inline-size: 100%;
      min-inline-size: 0 !important;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }

    body[data-gbs2-series="dzhon-gill"] .tooltip {
      box-sizing: border-box;
      inline-size: auto !important;
      max-inline-size: min(32rem, calc(100vw - 24px)) !important;
      min-inline-size: 0 !important;
      white-space: normal !important;
      overflow-wrap: anywhere;
      word-break: normal;
    }

    body[data-gbs2-series="dzhon-gill"] .tooltip * {
      box-sizing: border-box;
      max-inline-size: 100%;
      min-inline-size: 0;
      white-space: normal !important;
      overflow-wrap: anywhere;
      word-break: normal;
    }
  }

  @media print {
    [data-gill-v16] table.manuscript-table {
      display: table;
      inline-size: 100%;
      max-inline-size: 100%;
      min-inline-size: 0 !important;
      overflow: visible;
    }

    [data-gill-v16] table.manuscript-table thead {
      display: table-header-group;
    }

    [data-gill-v16] table.manuscript-table tr {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    /*
     * Series articles use dark editorial quote surfaces on screen. The global
     * paper palette intentionally removes saturated fills, so print restores a
     * readable paper treatment. Chromium can still fragment the final border
     * of an ordinary block even with break-inside: avoid; a full-width inline
     * block is an atomic inline-level box and therefore moves as one rectangle.
     * Keeping this in the shared series chrome avoids route-specific PDF fixes.
     */
    [data-gill-v16] .quote-box {
      display: inline-block !important;
      box-sizing: border-box !important;
      inline-size: 100% !important;
      max-inline-size: 100% !important;
      vertical-align: top !important;
      color: #1a1a1a !important;
      -webkit-text-fill-color: currentColor !important;
      background: #f7f4ee !important;
      border: 1px solid #d8d1c4 !important;
      border-inline-start: 3px solid #7a2e2e !important;
      box-shadow: none !important;
      filter: none !important;
      opacity: 1 !important;
      mix-blend-mode: normal !important;
      overflow: visible !important;
      break-inside: avoid-page !important;
      page-break-inside: avoid !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    [data-gill-v16] .quote-box,
    [data-gill-v16] .quote-box * {
      color: #1a1a1a !important;
      -webkit-text-fill-color: currentColor !important;
    }
  }
</style>