<style is:global>
  [data-gill-v16],
  [data-gill-v16] .page-wrap,
  [data-gill-v16] .article-body {
    min-inline-size: 0;
  }

  /*
   * The Wave 12 hero carries authored intrinsic dimensions (1536×1024).
   * WebKit with JavaScript disabled can otherwise keep that intrinsic inline
   * size and expand the document to 1584px. Keep the authored ratio while
   * constraining only the released Wave 12 route's wide media to the reader
   * column. The body publication marker is server-rendered and therefore
   * remains available when JavaScript is disabled. Physical width properties
   * accompany their logical equivalents because no-JS WebKit retained the
   * authored width attribute when only inline-size was declared.
   */
  body[data-wave12-publication="true"] .article-img.wide,
  body[data-wave12-publication="true"] .article-img.wide picture,
  body[data-wave12-publication="true"] .article-img.wide img {
    box-sizing: border-box;
    min-width: 0;
    max-width: 100%;
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  body[data-wave12-publication="true"] .article-img.wide picture,
  body[data-wave12-publication="true"] .article-img.wide img {
    display: block;
    width: 100%;
    inline-size: 100%;
  }

  body[data-wave12-publication="true"] .article-img.wide img {
    height: auto;
    block-size: auto;
  }

  @media (max-width: 63.999rem) {
    /*
     * The fixed mobile bar is the interaction owner. WebKit can otherwise
     * hit-test text underneath a transparent control surface while the
     * button remains visibly on top. Keep the whole control rectangle
     * pointer-active and make its decorative text children transparent to
     * pointer targeting, so touch/click always resolves to the native button.
     */
    [data-gill-v16] .mobile-bottom-bar,
    [data-gill-v16] .mobile-btoc-section {
      pointer-events: auto !important;
    }

    [data-gill-v16] .mobile-btoc-section {
      touch-action: manipulation;
    }

    [data-gill-v16] .mobile-btoc-section > * {
      pointer-events: none !important;
    }

    /*
     * Series routes own a fixed bottom bar but do not depend on the legacy
     * body.has-bottom-bar class. Keep the native resume prompt above that bar
     * so its copy and actions never intercept the primary mobile controls.
     */
    body[data-gbs2-series] .bookmark-toast {
      bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    }

    /*
     * The resume prompt's copy is not interactive. A late WebKit prompt can
     * appear between preflight and a physical TOC tap; make only its authored
     * controls hit-testable so decorative text never masks the fixed reader
     * bar. The prompt remains visible and its close/resume actions still work.
     */
    body[data-gbs2-series] .bookmark-toast.show {
      pointer-events: none;
    }

    body[data-gbs2-series] .bookmark-toast.show :is(
      button,
      a[href],
      input,
      select,
      textarea,
      [role="button"],
      [role="link"],
      [tabindex]:not([tabindex="-1"])
    ) {
      pointer-events: auto;
    }
  }

  @media (max-width: 48rem) {
    [data-gill-v16] .article-body > * {
      min-inline-size: 0;
      max-inline-size: 100%;
    }

    [data-gill-v16] table.manuscript-table {
      display: block;
      inline-size: 100%;
      max-inline-size: 100%;
      min-inline-size: 0 !important;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }

    body[data-gbs2-series="dzhon-gill"] .tooltip {
      box-sizing: border-box;
      inline-size: auto !important;
      max-inline-size: min(32rem, calc(100vw - 24px)) !important;
      min-inline-size: 0 !important;
      white-space: normal !important;
      overflow-wrap: anywhere;
      word-break: normal;
    }

    body[data-gbs2-series="dzhon-gill"] .tooltip * {
      box-sizing: border-box;
      max-inline-size: 100%;
      min-inline-size: 0;
      white-space: normal !important;
      overflow-wrap: anywhere;
      word-break: normal;
    }
  }

  @media print {
    [data-gill-v16] table.manuscript-table {
      display: table;
      inline-size: 100%;
      max-inline-size: 100%;
      min-inline-size: 0 !important;
      overflow: visible;
    }

    [data-gill-v16] table.manuscript-table thead {
      display: table-header-group;
    }

    [data-gill-v16] table.manuscript-table tr {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    /*
     * Series articles use dark editorial quote surfaces on screen. The global
     * paper palette intentionally removes saturated fills, so print restores a
     * readable paper treatment. Chromium can still fragment the final border
     * of an ordinary block even with break-inside: avoid; a full-width inline
     * block is an atomic inline-level box and therefore moves as one rectangle.
     * Keeping this in the shared series chrome avoids route-specific PDF fixes.
     */
    [data-gill-v16] .quote-box {
      display: inline-block !important;
      box-sizing: border-box !important;
      inline-size: 100% !important;
      max-inline-size: 100% !important;
      vertical-align: top !important;
      color: #1a1a1a !important;
      -webkit-text-fill-color: currentColor !important;
      background: #f7f4ee !important;
      border: 1px solid #d8d1c4 !important;
      border-inline-start: 3px solid #7a2e2e !important;
      box-shadow: none !important;
      filter: none !important;
      opacity: 1 !important;
      mix-blend-mode: normal !important;
      overflow: visible !important;
      break-inside: avoid-page !important;
      page-break-inside: avoid !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    [data-gill-v16] .quote-box,
    [data-gill-v16] .quote-box * {
      color: #1a1a1a !important;
      -webkit-text-fill-color: currentColor !important;
    }
  }
</style>
