<style is:global>
  [data-gill-v16],
  [data-gill-v16] .page-wrap,
  [data-gill-v16] .article-body {
    min-inline-size: 0;
  }

  @media (max-width: 84.999rem) {
    /*
     * The fixed mobile bar is the interaction owner. WebKit can otherwise
     * hit-test text underneath a transparent control surface while the
     * button remains visibly on top. Keep the whole control rectangle
     * pointer-active and make its decorative text children transparent to
     * pointer targeting, so touch/click always resolves to the native button.
     */
    [data-gill-v16] .mobile-bottom-bar,
    [data-gill-v16] .mobile-btoc-section {
      pointer-events: auto !important;
    }

    [data-gill-v16] .mobile-btoc-section {
      touch-action: manipulation;
    }

    [data-gill-v16] .mobile-btoc-section > * {
      pointer-events: none !important;
    }

    /*
     * Series routes own a fixed bottom bar but do not depend on the legacy
     * body.has-bottom-bar class. Keep the native resume prompt above that bar.
     */
    body[data-gbs2-series] .bookmark-toast {
      bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    }

    /*
     * WebKit may still hit-test wrapped resume copy below the toast box over
     * the bar. The copy is informational, so it must not become a touch
     * target; the close control and action buttons remain fully interactive.
     */
    body[data-gbs2-series] .bookmark-toast-copy,
    body[data-gbs2-series] .bookmark-toast-copy * {
      pointer-events: none !important;
    }

    body[data-gbs2-series] .bookmark-toast-close,
    body[data-gbs2-series] .bookmark-toast-actions,
    body[data-gbs2-series] .bookmark-toast-actions * {
      pointer-events: auto !important;
    }
  }

  @media (max-width: 48rem) {
    /*
     * `data-gill-v16` is retained as a historical shared-engine layout hook,
     * so non-Gill series also carry it. Legacy floating-cluster CSS hides
     * heading paperclips under that hook on narrow layouts with an !important
     * rule. Native heading-anchor ownership is retained by the other series,
     * therefore restore the target whenever the canonical series identity says
     * this is not Gill. Use the same width boundary as the legacy responsive
     * treatment instead of input-device heuristics: a narrow desktop/browser
     * viewport must not silently lose a retained capability either. Gill keeps
     * its reviewed mobile paperclip-hidden treatment.
     */
    body[data-gbs2-series]:not([data-gbs2-series="dzhon-gill"])
      [data-gill-v16]
      .heading-anchor[data-gb-heading-anchor-owner="native-v1"] {
      display: inline-flex !important;
    }

    [data-gill-v16] .article-body > * {
      min-inline-size: 0;
      max-inline-size: 100%;
    }

    [data-gill-v16] table.manuscript-table {
      display: block;
      inline-size: 100%;
      max-inline-size: 100%;
      min-inline-size: 0 !important;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }

    body[data-gbs2-series="dzhon-gill"] .tooltip {
      box-sizing: border-box;
      inline-size: auto !important;
      max-inline-size: min(32rem, calc(100vw - 24px)) !important;
      min-inline-size: 0 !important;
      white-space: normal !important;
      overflow-wrap: anywhere;
      word-break: normal;
    }

    body[data-gbs2-series="dzhon-gill"] .tooltip * {
      box-sizing: border-box;
      max-inline-size: 100%;
      min-inline-size: 0;
      white-space: normal !important;
      overflow-wrap: anywhere;
      word-break: normal;
    }
  }


  /*
   * Gill editorial geometry (2026-11-19).
   * One canonical responsive owner: avoid patching compiled floating-cluster.css,
   * preserve the fixed rail, native TTS and the original SVG controls.
   */
  @media (min-width: 85em) {
    body[data-gbs2-series="dzhon-gill"]
      .gbs2-world[data-gill-v16] > .page-wrap {
      /* True viewport centre, unless the real fixed rail needs 24px clearance.
         Rail is 22vw on intermediate desktop widths and caps near 325px. */
      margin-left: max(
        calc((100vw - var(--gb-measure)) / 2),
        calc(min(22vw, 325px) + 24px)
      );
    }
  }

  @media (max-width: 63.999em) and (orientation: landscape) and (max-height: 500px) {
    body[data-gbs2-series="dzhon-gill"]
      .mobile-top-slot .reader-mobile-menu-trigger {
      /* The TOC stays a button, not a 559px empty pill. */
      max-width: 220px;
      margin-inline: auto;
    }

    body[data-gbs2-series="dzhon-gill"]
      .gbs2-world[data-gill-v16] .gbs2-hero {
      /* Preserve the original illustration, show the heading on first screen. */
      height: clamp(116px, 34dvh, 144px);
      aspect-ratio: auto;
    }

    body[data-gbs2-series="dzhon-gill"]
      .gbs2-world[data-gill-v16] .gbs2-hero img {
      height: 100%;
      max-height: none;
    }

    body[data-gbs2-series="dzhon-gill"]
      .gbs2-world[data-gill-v16] .mobile-bottom-bar {
      min-height: 54px;
      height: 54px;
      padding-block: 3px;
    }
  }

  /* The rail Play control is 32px, its peers are 40–44px. Keep SVGs
     untouched; make the five desktop action centres land every 48px. */
  @media (min-width: 85em) {
    body[data-gbs2-series="dzhon-gill"]
      .gbs2-world[data-gill-v16] .gbs-theme-corner {
      gap: 8px;
    }
    body[data-gbs2-series="dzhon-gill"]
      .gbs2-world[data-gill-v16] .gbs-theme-corner .gb-ember-wrap {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
    }
  }

  /* Warm dark-paper scale: paper, rail and floating actions share one family.
     Restrict to Gill; do not recolour independent article/series engines. */
  html.dark body[data-gbs2-series="dzhon-gill"] {
    --gb-gill-paper: #141312;
    --gb-gill-rail: #1c1916;
    --gb-gill-float: #191715;
    background: var(--gb-gill-paper);
  }

  html.dark body[data-gbs2-series="dzhon-gill"]
    .gbs2-world[data-gill-v16],
  html.dark body[data-gbs2-series="dzhon-gill"]
    .gbs2-world[data-gill-v16] .page-wrap {
    background: var(--gb-gill-paper);
  }

  html.dark body[data-gbs2-series="dzhon-gill"]
    .gbs2-world[data-gill-v16] > .gbs-rail {
    background: var(--gb-gill-rail);
  }

  html.dark body[data-gbs2-series="dzhon-gill"]
    .gbs2-world[data-gill-v16] .mobile-top-bar,
  html.dark body[data-gbs2-series="dzhon-gill"]
    .gbs2-world[data-gill-v16] .mobile-bottom-bar {
    background: rgba(25, 23, 21, .96);
  }

  /* Keep only the life-year range inseparable, not the full article title. */
  body[data-gbs2-series="dzhon-gill"]
    [data-gill-v16] .gill-life-years {
    white-space: nowrap;
  }

  /* A consistent readable micro-type scale, without squeezing the left rail. */
  body[data-gbs2-series="dzhon-gill"] [data-gill-v16] .gbs2-pn {
    font-size: 10.5px;
    letter-spacing: .07em;
  }
  body[data-gbs2-series="dzhon-gill"] [data-gill-v16] .gbs2-ps,
  body[data-gbs2-series="dzhon-gill"] [data-gill-v16] .gbs2-rprogress small,
  body[data-gbs2-series="dzhon-gill"] [data-gill-v16] .gbs2-current-label,
  body[data-gbs2-series="dzhon-gill"] [data-gill-v16] .gbs2-toch span:first-child {
    font-size: 11px;
  }
  body[data-gbs2-series="dzhon-gill"] [data-gill-v16] .gbs2-current-label {
    letter-spacing: .11em;
  }
  body[data-gbs2-series="dzhon-gill"] [data-gill-v16] .gbs2-toch span:first-child {
    letter-spacing: .07em;
  }

  @media (max-width: 84.999em) {
    /* Speed is a secondary setting: keep its full native 44px hitbox,
       soften only the painted badge so TOC/reading stay visually primary. */
    body[data-gbs2-series="dzhon-gill"] .reader-mobile-speed-badge {
      color: var(--reader-speed-wine, #7a2e2e);
    }
    body[data-gbs2-series="dzhon-gill"] .reader-mobile-speed-badge::before {
      background: color-mix(
        in srgb,
        var(--reader-speed-wine, #7a2e2e) 12%,
        var(--color-surface, #fdfcf9)
      );
      border-color: color-mix(
        in srgb,
        var(--reader-speed-wine, #7a2e2e) 35%,
        transparent
      );
      box-shadow: none;
    }
  }

  @media print {
    /* Terminal series navigation is reader chrome, not authored paper content.
       Keep the rule in the compiled global SeriesReader stylesheet so it stays
       active after GBPrintPagination prepares terminal followers. */
    [data-gill-v16] :is(.gbs2-vignette, .gbs2-next) {
      display: none !important;
    }

    [data-gill-v16] table.manuscript-table {
      display: table;
      inline-size: 100%;
      max-inline-size: 100%;
      min-inline-size: 0 !important;
      overflow: visible;
    }

    [data-gill-v16] table.manuscript-table thead {
      display: table-header-group;
    }

    [data-gill-v16] table.manuscript-table tr {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    /*
     * Series articles use dark editorial quote surfaces on screen. The global
     * paper palette intentionally removes saturated fills, so print restores a
     * readable paper treatment. Chromium can still fragment the final border
     * of an ordinary block even with break-inside: avoid; a full-width inline
     * block is an atomic inline-level box and therefore moves as one rectangle.
     * Keeping this in the shared series chrome avoids route-specific PDF fixes.
     */
    [data-gill-v16] .quote-box {
      display: inline-block !important;
      box-sizing: border-box !important;
      inline-size: 100% !important;
      max-inline-size: 100% !important;
      vertical-align: top !important;
      color: #1a1a1a !important;
      -webkit-text-fill-color: currentColor !important;
      background: #f7f4ee !important;
      border: 1px solid #d8d1c4 !important;
      border-inline-start: 3px solid #7a2e2e !important;
      box-shadow: none !important;
      filter: none !important;
      opacity: 1 !important;
      mix-blend-mode: normal !important;
      overflow: visible !important;
      break-inside: avoid-page !important;
      page-break-inside: avoid !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    [data-gill-v16] .quote-box,
    [data-gill-v16] .quote-box * {
      color: #1a1a1a !important;
      -webkit-text-fill-color: currentColor !important;
    }
  }
</style>
