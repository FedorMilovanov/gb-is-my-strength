---
/**
 * GillLeatherRibbon — a leather bookmark for the Gill series rail
 * («Введение» / «Справочник»). Ported from the approved scratchpad design.
 *
 * Renders the leather silhouette (with geometric thickness, physically-lit
 * pores/mottle/creases/micro-grain/specular texture, edge darkening, top roll,
 * fold light and stitched border) plus an embossed gold ornament + word.
 *
 * `variant="reference"` gives the darker neutral-chocolate «Справочник» leather.
 */
interface Props {
  word: string;
  ornament: 'lily' | 'book';
  variant?: 'default' | 'reference';
  className?: string;
}
const { word, ornament, variant = 'default', className = '' } = Astro.props;
const baseFill = variant === 'reference' ? 'url(#gblr-lzReference)' : 'url(#gblr-lz)';
const lily = 'M12 2c.8 2 .4 3.5-.7 4.7-1 1.1-1.6 2.1-1.4 3.5-1.4-.5-2.2-1.6-2.2-3-1.5.9-2.2 2.3-1.9 4.1.3 1.5 1.5 2.6 3.4 2.9-.3.7-.9 1.1-2 1.3v1.5h3.8c.2 1.4.5 2.5 1.1 4.4.6-1.9.9-3 1.1-4.4h3.8v-1.5c-1-.2-1.6-.6-2-1.3 1.9-.3 3.1-1.4 3.4-2.9.3-1.8-.4-3.2-1.9-4.1 0 1.4-.8 2.5-2.2 3 .2-1.4-.4-2.4-1.4-3.5C11.6 5.5 11.2 4 12 2z';
const book = 'M12 6.2C10.1 4.6 7.4 4 4.5 4.2v13.4c2.9-.2 5.6.5 7.5 2.1 1.9-1.6 4.6-2.3 7.5-2.1V4.2C16.6 4 13.9 4.6 12 6.2zm-1 11.6c-1.5-.9-3.3-1.4-5.2-1.5V6.1c1.9.1 3.7.7 5.2 1.7v10zm7.2-1.5c-1.9.1-3.7.6-5.2 1.5v-10c1.5-1 3.3-1.6 5.2-1.7v10.2z';
const ornPath = ornament === 'lily' ? lily : book;
const P = 'M8,2 H104 Q110,2 110,8 V124 L56,103 L2,124 V8 Q2,2 8,2 Z';
---
<span class:list={['gblr-ribbon', variant === 'reference' && 'gblr-ribbon--reference', className]} aria-hidden="true">
  <svg class="gblr-ribbon__shape" viewBox="0 0 112 142" preserveAspectRatio="none">
    <!-- geometric thickness: dark slice offset down -->
    <path d={P} fill="#160a03" transform="translate(0,1.9)"/>
    <path d={P} fill="#57300f" opacity=".5" transform="translate(0,.9)"/>
    <path d={P} fill={baseFill}/>
    <g clip-path="url(#gblr-clip)">
      <rect width="112" height="142" fill="#8a6a4a" filter="url(#gblr-pores)" style="mix-blend-mode:soft-light" class="gblr-l-pores"/>
      <rect width="112" height="142" fill="#000" filter="url(#gblr-mottle)" opacity=".42" style="mix-blend-mode:multiply"/>
      <rect width="112" height="142" fill="#000" filter="url(#gblr-creases)" opacity=".15" style="mix-blend-mode:multiply"/>
      <rect width="112" height="142" fill="#000" filter="url(#gblr-microgr)" opacity=".12" style="mix-blend-mode:multiply"/>
      <rect width="112" height="142" fill="#000" filter="url(#gblr-spec)" style="mix-blend-mode:screen" class="gblr-l-spec"/>
      <rect width="112" height="142" fill="#7a2f10" style="mix-blend-mode:overlay" class="gblr-l-warm"/>
      <rect width="11" height="142" fill="url(#gblr-edgeL)"/>
      <rect x="101" width="11" height="142" fill="url(#gblr-edgeR)"/>
    </g>
    <path d={P} fill="#160d09" style="mix-blend-mode:multiply" class="gblr-l-glaze"/>
    <path d={P} fill="url(#gblr-vig)"/>
    <path d={P} fill="url(#gblr-sheen)"/>
    <path d={P} fill="url(#gblr-sheen2)"/>
    <path d="M8,2 H104 Q110,2 110,8 V72 H2 V8 Q2,2 8,2 Z" fill="url(#gblr-topedge)"/>
    <path d={P} fill="url(#gblr-fold)"/>
    <!-- top roll -->
    <rect x="7.2" y="1.4" width="97.6" height="6.2" rx="3.1" fill="url(#gblr-rollg)"/>
    <path d="M9,2.1 H103" stroke="#ffe9c0" stroke-opacity=".38" stroke-width=".9" stroke-linecap="round"/>
    <path d="M8.5,8.4 H103.5" stroke="#120702" stroke-opacity=".5" stroke-width="1.6" stroke-linecap="round" style="filter:blur(.8px)"/>
    <!-- stitching -->
    <path d="M9.5,9.5 H102.5 V119 L56,100.5 L9.5,119 Z" fill="none" stroke="#000" stroke-opacity=".3" stroke-width="4.2" stroke-linecap="round" style="filter:blur(1px)"/>
    <path d="M9.5,9.5 H102.5 V119 L56,100.5 L9.5,119 Z" pathLength="416" fill="none" stroke="#241005" stroke-opacity=".62" stroke-width="2.2" stroke-dasharray="1.6 3.6" stroke-linecap="round"/>
    <path d="M9,9 H103 V118.5 L56,100 L9,118.5 Z" pathLength="414" fill="none" stroke="#ffdf9e" stroke-opacity=".72" stroke-width="1.25" stroke-dasharray="1.4 3.2" stroke-dashoffset=".6" stroke-linecap="round" class="gblr-l-stitchlight"/>
    <path d={P} fill="none" stroke="#000" stroke-opacity=".42" stroke-width="1"/>
  </svg>
  <span class="gblr-ribbon__text">
    <span class="gblr-ribbon__orn">
      <svg viewBox="0 0 24 24"><path d={ornPath}/></svg>
    </span>
    <span class="gblr-ribbon__word">{word}</span>
    <span class="gblr-ribbon__div"><i></i></span>
  </span>
</span>
