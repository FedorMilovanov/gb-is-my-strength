<style is:global>
  /*
   * Gill image system — editorial, not decorative.
   * The image remains the primary object; captions are museum labels beneath it,
   * not accidental strips or stickers. Rail covers use a real photographic crop
   * with text floating inside the frame, never on a separate bottom band.
   */

  [data-gill-v16] .gbs2-hero {
    isolation: isolate;
    background: #17110d;
    border-color: color-mix(in srgb, var(--gbs2-accent2) 22%, var(--color-border));
    box-shadow:
      0 22px 54px -28px rgba(30, 18, 9, .72),
      0 8px 22px -16px rgba(0, 0, 0, .45),
      inset 0 1px 0 rgba(255, 255, 255, .08);
  }

  [data-gill-v16] .gbs2-hero img {
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-height: none !important;
    object-fit: cover !important;
    transform: scale(1.012) !important;
    transform-origin: center;
    will-change: auto !important;
  }

  [data-gill-v16] .gbs2-hero::after {
    background:
      linear-gradient(180deg, rgba(10, 7, 5, .05) 16%, rgba(10, 7, 5, .02) 46%, rgba(10, 7, 5, .58) 100%),
      linear-gradient(90deg, rgba(10, 7, 5, .14), transparent 42%);
  }

  [data-gill-v16] .gbs2-hero-cap {
    left: clamp(10px, 2vw, 16px);
    right: auto;
    bottom: clamp(10px, 2vw, 14px);
    max-width: calc(100% - 20px);
    width: max-content;
    padding: 8px 12px;
    gap: 8px;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: 12px;
    background: rgba(18, 13, 9, .62);
    box-shadow: 0 8px 24px -14px rgba(0, 0, 0, .9), inset 0 1px 0 rgba(255, 255, 255, .08);
    -webkit-backdrop-filter: blur(10px) saturate(1.12);
    backdrop-filter: blur(10px) saturate(1.12);
    line-height: 1.25;
    text-wrap: balance;
  }

  [data-gill-v16="context"] .gbs2-hero img { object-position: 50% 50%; }
  [data-gill-v16="part1"] .gbs2-hero img { object-position: 50% 34%; }
  [data-gill-v16="part2"] .gbs2-hero img { object-position: 53% 50%; }
  [data-gill-v16="part3"] .gbs2-hero img { object-position: 57% 50%; }
  [data-gill-v16="spravochnik"] .gbs2-hero img { object-position: 50% 51%; }

  /* Body figures: image and caption read as one crafted editorial object. */
  [data-gill-v16] .article-body .article-img:not(#gbs2Hero) {
    overflow: visible;
    border-radius: 0;
    line-height: 1.5;
  }

  [data-gill-v16] .article-body .article-img:not(#gbs2Hero) > picture,
  [data-gill-v16] .article-body .article-img:not(#gbs2Hero) > a.gill-figure-zoom {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border-strong) 72%, transparent);
    border-radius: 16px;
    background: color-mix(in srgb, var(--color-surface) 94%, #17110d);
    box-shadow:
      0 20px 48px -30px rgba(49, 29, 13, .72),
      0 8px 20px -16px rgba(0, 0, 0, .38),
      inset 0 1px 0 rgba(255, 255, 255, .45);
  }

  [data-gill-v16] .article-body .article-img:not(#gbs2Hero) > picture img,
  [data-gill-v16] .article-body .article-img:not(#gbs2Hero) > a.gill-figure-zoom img,
  [data-gill-v16] .article-body .article-img:not(#gbs2Hero) > img {
    display: block;
    border-radius: 15px;
  }

  [data-gill-v16] .article-body .article-img:not(#gbs2Hero) > figcaption {
    position: relative;
    z-index: 2;
    width: calc(100% - clamp(18px, 5vw, 36px));
    max-width: 700px;
    margin: 9px auto 0 !important;
    padding: 9px 13px 10px;
    border: 1px solid color-mix(in srgb, var(--color-border-strong) 62%, transparent);
    border-top-color: color-mix(in srgb, var(--gbs2-accent2, #d4a857) 34%, var(--color-border-strong));
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-surface) 96%, transparent);
    color: var(--color-text-muted);
    box-shadow:
      0 12px 26px -22px rgba(34, 21, 11, .58),
      inset 0 1px 0 rgba(255, 255, 255, .72);
    -webkit-backdrop-filter: blur(10px) saturate(1.05);
    backdrop-filter: blur(10px) saturate(1.05);
    font-size: 12.4px;
    line-height: 1.48;
    text-align: center;
    text-wrap: pretty;
  }

  html.dark [data-gill-v16] .article-body .article-img:not(#gbs2Hero) > figcaption {
    border-color: rgba(230, 203, 163, .16);
    border-top-color: rgba(230, 203, 163, .35);
    background: rgba(23, 20, 17, .88);
    color: rgba(244, 235, 221, .72);
    box-shadow: 0 14px 32px -24px rgba(0, 0, 0, .9), inset 0 1px 0 rgba(255, 255, 255, .05);
  }

  [data-gill-v16] .gill-figure--bunhill {
    max-width: 460px;
    margin-inline: auto;
  }

  [data-gill-v16] .gill-figure--infographic {
    max-width: 860px;
    margin-inline: auto;
  }

  [data-gill-v16] .gill-figure-zoom {
    color: inherit;
    text-decoration: none;
  }

  [data-gill-v16] .gill-figure-zoom > picture {
    display: block;
  }

  [data-gill-v16] .gill-figure-zoom::after {
    content: "Увеличить";
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    padding: 5px 9px;
    border: 1px solid rgba(255, 255, 255, .24);
    border-radius: 999px;
    background: rgba(17, 12, 8, .68);
    color: rgba(255, 255, 255, .9);
    box-shadow: 0 6px 18px -10px rgba(0, 0, 0, .9);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font: 800 9px/1.2 "Source Sans 3", system-ui, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  /* Expanded current-part rail card: one continuous cover/title composition. */
  @media (min-width: 64em) {
    [data-gill-v16] .gbs2-current {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto minmax(96px, 1fr);
    }

    [data-gill-v16] .gbs2-current-cover {
      grid-column: 1;
      grid-row: 1;
      height: 128px;
      opacity: 1;
      background-image:
        linear-gradient(180deg, rgba(13, 10, 8, .04) 0%, rgba(13, 10, 8, .16) 42%, rgba(13, 10, 8, .78) 100%),
        linear-gradient(90deg, rgba(13, 10, 8, .16), transparent 54%),
        var(--gbs2-cover, linear-gradient(135deg, var(--gbs2-accent), #2b1b13));
      background-size: cover;
      background-position: var(--gbs2-cover-position, center);
      filter: saturate(.92) contrast(1.04);
      box-shadow: inset 0 -1px 0 rgba(232, 184, 120, .12);
    }

    [data-gill-v16] .gbs2-current-body {
      grid-column: 1;
      grid-row: 1;
      align-self: end;
      z-index: 1;
      padding: 54px 14px 15px;
      background: none;
      text-shadow: 0 2px 12px rgba(0, 0, 0, .78), 0 0 2px rgba(0, 0, 0, .8);
    }

    [data-gill-v16] .gbs2-current-label {
      color: #e8bd84;
    }

    [data-gill-v16] .gbs2-current-title {
      margin-top: 4px;
      font-size: 17px;
      color: #fffdf8;
    }

    [data-gill-v16] .gbs2-curbar {
      margin-top: 10px;
      background: rgba(255, 255, 255, .22);
    }

    [data-gill-v16] .gbs2-toch { grid-column: 1; grid-row: 2; }
    [data-gill-v16] .gbs2-tocscroll { grid-column: 1; grid-row: 3; }

    [data-gill-v16="context"] .gbs2-current-cover { --gbs2-cover-position: 79% 50%; }
    [data-gill-v16="part1"] .gbs2-current-cover { --gbs2-cover-position: 50% 28%; }
    [data-gill-v16="part2"] .gbs2-current-cover { --gbs2-cover-position: 54% 52%; }
    [data-gill-v16="part3"] .gbs2-current-cover { --gbs2-cover-position: 61% 50%; }
    [data-gill-v16="spravochnik"] .gbs2-current-cover { --gbs2-cover-position: 50% 52%; }
  }

  @media (max-width: 63.999em) {
    [data-gill-v16="context"] .gbs2-hero img { object-position: 36% 50%; }
    [data-gill-v16="part1"] .gbs2-hero img { object-position: 50% 32%; }
    [data-gill-v16="part2"] .gbs2-hero img { object-position: 53% 50%; }
    [data-gill-v16="part3"] .gbs2-hero img { object-position: 57% 50%; }
    [data-gill-v16="spravochnik"] .gbs2-hero img { object-position: 50% 52%; }
  }

  @media (max-width: 640px) {
    [data-gill-v16] .gbs2-hero img {
      transform: none !important;
    }

    [data-gill-v16] .gbs2-hero-cap {
      max-width: calc(100% - 20px);
      padding: 7px 10px;
      font-size: 9.5px;
      letter-spacing: .075em;
    }

    [data-gill-v16] .article-body .article-img.float-left,
    [data-gill-v16] .article-body .article-img.float-right {
      float: none !important;
      clear: both !important;
      width: min(100%, 360px) !important;
      max-width: 100% !important;
      margin: 30px auto 34px !important;
      shape-outside: none !important;
    }

    [data-gill-v16] .article-body .article-img:has(img[src*="gill-southwark-sermon"]),
    [data-gill-v16] .article-body .article-img:has(img[src*="gill-bunhill-fields"]) {
      width: min(78vw, 286px) !important;
    }

    [data-gill-v16] .article-body .article-img:has(img[src*="gill-london-horsleydown"]) {
      width: 100% !important;
    }

    [data-gill-v16] .article-body .article-img:has(img[src*="gill-pulpit-strip"]) > picture,
    [data-gill-v16] .article-body .article-img:has(img[src*="gill-bookshop-strip"]) > picture {
      aspect-ratio: auto;
    }

    [data-gill-v16] .article-body .article-img:has(img[src*="gill-pulpit-strip"]) img,
    [data-gill-v16] .article-body .article-img:has(img[src*="gill-bookshop-strip"]) img {
      width: 100% !important;
      height: auto !important;
      max-height: none !important;
      object-fit: contain !important;
      object-position: 50% 50%;
    }

    [data-gill-v16] .article-body .article-img:not(#gbs2Hero) > figcaption {
      width: calc(100% - 16px);
      margin-top: 8px !important;
      padding: 8px 10px 9px;
      font-size: 12px;
      border-radius: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-gill-v16] .gbs2-hero img { transform: none !important; }
  }
</style>
