---
import SeriesMark from './SeriesMark.astro';
import { GILL_PAGE_DATA, type GillPartTocItem, type GillSeriesPageId } from './gillSeriesData';

interface Props { pageId: GillSeriesPageId; }
const { pageId } = Astro.props;
const page = GILL_PAGE_DATA[pageId];
function splitHistoricalLabel(item: GillPartTocItem) {
  const match = item.label.match(/^([IVX]+)\.\s*(.+)$/);
  return { mark: match ? match[1] : '·', title: match ? match[2] : item.label, isRoman: Boolean(match) };
}
---
<div class="toc-overlay" id="partTocOverlay" aria-hidden="true">
  <div class="toc-sheet" role="dialog" aria-modal="true" aria-label={page.partDialogLabel}>
    <button class="toc-sheet__handle" type="button" aria-label="Закрыть"></button>
    <div class="toc-sheet__head toc-sheet__head--grid">
      <button class="back" id="backToSeries" aria-label="Назад к серии"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg></button>
      <div class="toc-head-txt"><div class="lab">{page.partLabel}</div><h3>{page.title}</h3></div>
    </div>
    <div class="toc-sheet__scroll-bar"><i style="--scroll-pct:0%"></i></div>
    <div class="toc-sheet__list" id="gbs2PartToc">
      {page.partToc.map((item) => {
        const view = splitHistoricalLabel(item);
        const className = ['toc-part-item', item.level === 3 && 'toc-part-item--sub', item.current && 'is-current'].filter(Boolean).join(' ');
        const content = (<>{view.isRoman ? <SeriesMark kind="roman" value={view.mark} className="toc-part-item__num" /> : <span aria-hidden="true" class="gb-series-mark--label toc-part-item__num toc-part-item__num--sub">·</span>}<div class="toc-part-item__info"><b>{view.title}</b><small>{item.level === 3 ? 'Подраздел' : 'Раздел'}</small></div><div class="toc-part-item__progress"><i style={item.current ? 'width:0%' : undefined}></i></div></>);
        return item.current ? <div class={className}>{content}</div> : <a class={className} href={item.href}>{content}</a>;
      })}
    </div>
    <div class="toc-sheet__actions toc-sheet__actions--grid">
      <button class="toc-action-btn gb-save" data-fc-action="save"><svg viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" /></svg><span>Сохранить</span></button>
      <button class="toc-action-btn" data-action="share"><svg viewBox="0 0 24 24"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg><span>Поделиться</span></button>
      <button class="toc-action-btn" data-action="print"><svg viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2V11a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg><span>PDF</span></button>
    </div>
  </div>
</div>
