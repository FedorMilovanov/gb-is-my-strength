---
import { GILL_SERIES, satellitesOf, type SeriesConfig } from '../_shared/series/seriesConfig';

interface Props { pageId: string; config?: SeriesConfig; }
const { pageId, config = GILL_SERIES } = Astro.props;
const page = config.pages[pageId];
/* Аккордеон показывает ЯДРО серии; спутники (tier: 'satellite') рендерятся
   строками ВНУТРИ своей родительской части (см. satRows ниже). */
const seriesItems = config.items.filter((it) => it.tier !== 'satellite');
/**
 * «Оглавление части» — АККОРДЕОН (канон владельца 2026-07-13, эталон:
 * auditrepo/references/gb-ui-canon-2026-07-13/mobile-toc-accordion-v5.html).
 * Каждая часть серии — сворачиваемая строка; текущая раскрыта по умолчанию
 * со своим оглавлением (partToc, H2+H3); у чужих частей первая строка —
 * «→ Перейти к части», а строки разделов ведут глубокими ссылками
 * item.href + '#anchor'. Форзацы (Введение/Справочник) — слово вертикально,
 * без пилюль. Футер: [▶ Слушать часть][Продолжить →][⎙].
 * Оболочка .toc-overlay/.toc-sheet и её open/close/focus-trap — без изменений
 * (initTocPopups в floating-cluster-controller.js).
 */
/* Текущая страница может быть спутником — тогда «текущая часть» аккордеона
   это её родитель (раскрыт), а сам спутник подсвечен своей строкой. */
const currentRaw = config.items.find((item) => item.id === pageId)!;
const currentPartId = currentRaw.tier === 'satellite' ? currentRaw.parent! : currentRaw.id;
const current = seriesItems.find((item) => item.id === currentPartId)!;
/* NBSP между «Часть» и нумералом: при длинном имени серии (Тёмная сторона
   кафедры) лейбл переносится — нумерал не должен отрываться на свою строку. */
const currentPartLabel = currentRaw.tier === 'satellite'
  ? `${currentRaw.mark.value} · ${currentRaw.shortTitle || currentRaw.title}`
  : current.mark.kind === 'roman' ? `Часть ${current.mark.value}` : current.title;
/* Убираем дубль «Часть N.» из заголовка строки — колонка нумерала уже говорит это. */
const shortTitle = (t: string) => t.replace(/^Часть\s+[IVXLC]+\.\s*/, '');
const currentAnchor = (page.partToc.find((r) => r.current) || page.partToc[0])?.href || '';
---
<div class="toc-overlay" id="partTocOverlay" aria-hidden="true">
  <div class="toc-sheet" role="dialog" aria-modal="true" aria-label={page.partDialogLabel}>
    <button class="toc-sheet__handle" type="button" aria-label="Закрыть"></button>
    <div class="toc-sheet__head toc-sheet__head--grid">
      <button class="back" id="backToSeries" aria-label="Назад к серии"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg></button>
      <div class="toc-head-txt"><div class="lab">{config.seriesTitle} · {currentPartLabel}</div><h3>Оглавление части</h3></div>
    </div>
    <div class="toc-sheet__scroll-bar"><i style="--scroll-pct:0%"></i></div>
    <div class="toc-sheet__list gbat" id="gbs2PartToc" data-gill-parts-nav>
      {seriesItems.map((item) => {
        const isCurrent = item.id === currentPartId;
        const sats = satellitesOf(config, item.id);
        const secs = config.pages[item.id]?.partToc || [];
        const isLabel = item.mark.kind === 'label';
        return (
          <div class={['gbat-part', isCurrent && 'cur open', isLabel && 'gbat-part--label'].filter(Boolean).join(' ')}>
            <button class="gbat-hd" type="button" aria-expanded={isCurrent ? 'true' : 'false'}>
              {isLabel
                ? <span class="gbat-num gbat-num--label"><i>{item.mark.value}</i></span>
                : <span class="gbat-num">{item.mark.value}</span>}
              <span class="gbat-meta">
                <span class="gbat-t">{shortTitle(item.title)}</span>
                <span class="gbat-s">{isCurrent ? <span class="gbat-now">Сейчас читаете</span> : item.shortTitle}</span>
              </span>
              <span class="gbat-min">{item.readingTime}</span>
              <span class="gbat-chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg></span>
            </button>
            <div class="gbat-subs"><div><div class="gbat-pad">
              <span class="gbat-rail" aria-hidden="true"></span>
              {!isCurrent && <a class="gbat-sub gbat-go" href={item.href}><span class="gbat-dot"></span><span>Перейти к части</span></a>}
              {secs.map((row) => (
                <a class={['gbat-sub', row.level === 3 && 'h3', isCurrent && row.current && pageId === item.id && 'active'].filter(Boolean).join(' ')}
                   href={pageId === item.id ? row.href : item.href + row.href}>
                  <span class="gbat-dot"></span><span>{row.label}</span>
                </a>
              ))}
              {sats.map((sat) => (
                <a class={['gbat-sub', 'gbat-sat', sat.id === pageId && 'active'].filter(Boolean).join(' ')} href={sat.href}>
                  <span class="gbat-satmark" aria-hidden="true">{sat.mark.value}</span>
                  <span>{sat.shortTitle || sat.title}</span>
                  <span class="gbat-satmin">{sat.readingTime}</span>
                </a>
              ))}
            </div></div></div>
          </div>
        );
      })}
    </div>
    <div class="toc-sheet__actions gbat-foot">
      <button class="gbat-fbtn gbat-fbtn--listen" type="button" data-gbat-listen><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.8v14.4L18.5 12 7 4.8z" /></svg><span>Слушать часть</span></button>
      <button class="gbat-fbtn gbat-fbtn--cont" type="button" data-gbat-continue><span>Продолжить</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>
      <button class="gbat-fbtn gbat-fbtn--pdf" type="button" data-action="print" aria-label="Распечатать страницу и сохранить в PDF" title="Распечатать · PDF"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2V11a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg></button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ currentAnchor }}>
(function () {
  'use strict';
  var ov = document.getElementById('partTocOverlay');
  if (!ov || ov.dataset.gbatBound) return;
  ov.dataset.gbatBound = '1';
  function closeOverlay() {
    var h = ov.querySelector('.toc-sheet__handle');
    if (h) h.click();
  }
  /* Аккордеон: заголовок части сворачивает/раскрывает её субменю. */
  ov.querySelectorAll('.gbat-hd').forEach(function (hd) {
    hd.addEventListener('click', function () {
      var part = hd.closest('.gbat-part');
      var open = part.classList.toggle('open');
      hd.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });
  /* Якорные ссылки текущей части: закрыть лист, дать браузеру доскроллить. */
  ov.querySelectorAll('a.gbat-sub[href^="#"]').forEach(function (a) {
    a.addEventListener('click', function () { closeOverlay(); });
  });
  /* ▶ Слушать часть: жмём реальный PLAY ember (мобильный бар / десктоп-угол). */
  var listen = ov.querySelector('[data-gbat-listen]');
  if (listen) listen.addEventListener('click', function () {
    closeOverlay();
    var ember = document.querySelector('.mobile-top-bar .gb-ember') ||
                document.querySelector('.gbs-theme-corner .gb-ember');
    if (ember) setTimeout(function () { ember.click(); }, 120);
  });
  /* Продолжить: закрыть и плавно вернуть читателя к текущему разделу. */
  var cont = ov.querySelector('[data-gbat-continue]');
  if (cont) cont.addEventListener('click', function () {
    closeOverlay();
    if (!currentAnchor) return;
    var el = document.querySelector(currentAnchor);
    if (el) setTimeout(function () { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 140);
  });
})();
</script>
