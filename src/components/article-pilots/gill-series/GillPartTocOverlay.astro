---
import SeriesMark from './SeriesMark.astro';
import { GILL_SERIES_ITEMS, GILL_PAGE_DATA, type GillSeriesPageId } from './gillSeriesData';

interface Props { pageId: GillSeriesPageId; }
const { pageId } = Astro.props;
const page = GILL_PAGE_DATA[pageId];
// v2.9 canon: «Оглавление части» (.btoc-nav) lists the SERIES PARTS — the whole
// Gill series navigation — NOT the sections of the current article. Each row is
// a part: its series mark (roman numeral I…IV, or the Введение / Справочник
// text mark) + part title. The CURRENT part is marked; clicking any other part
// navigates to that part's page (real href from gillSeriesData).
const current = GILL_SERIES_ITEMS.find((item) => item.id === pageId)!;
// Subtitle reads "Джон Гилл · Часть N" — derive the short part label from the
// real series mark (roman parts → "Часть III"); the intro / reference rows carry
// a text mark, so they fall back to their own title.
const currentPartLabel = current.mark.kind === 'roman' ? `Часть ${current.mark.value}` : current.title;
---
<div class="toc-overlay" id="partTocOverlay" aria-hidden="true">
  <div class="toc-sheet" role="dialog" aria-modal="true" aria-label={page.partDialogLabel}>
    <button class="toc-sheet__handle" type="button" aria-label="Закрыть"></button>
    <div class="toc-sheet__head toc-sheet__head--grid">
      <button class="back" id="backToSeries" aria-label="Назад к серии"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg></button>
      <div class="toc-head-txt"><div class="lab">Джон Гилл · {currentPartLabel}</div><h3>Оглавление части</h3></div>
    </div>
    <div class="toc-sheet__scroll-bar"><i style="--scroll-pct:0%"></i></div>
    <div class="toc-sheet__list" id="gbs2PartToc" data-gill-parts-nav>
      {GILL_SERIES_ITEMS.map((item) => {
        const isCurrent = item.id === pageId;
        const className = ['toc-part-item', isCurrent && 'is-current'].filter(Boolean).join(' ');
        const content = (<><SeriesMark kind={item.mark.kind} value={item.mark.value} className="toc-part-item__num" /><div class="toc-part-item__info"><b>{item.title}</b></div></>);
        return isCurrent
          ? <div class={className} aria-current="page">{content}</div>
          : <a class={className} href={item.href}>{content}</a>;
      })}
    </div>
    <div class="toc-sheet__actions">
      <button class="toc-action-btn toc-action-btn--print" data-action="print" aria-label="Распечатать страницу и сохранить в PDF"><svg viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2V11a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg><span>Распечатать · сохранить PDF</span></button>
    </div>
  </div>
</div>
