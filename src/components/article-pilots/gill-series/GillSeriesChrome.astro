---
import { GILL_PAGE_DATA, type GillSeriesPageId } from './gillSeriesData';
import GillSeriesRail from './GillSeriesRail.astro';
import GillSeriesMobileBar from './GillSeriesMobileBar.astro';
import GillSeriesOverlay from './GillSeriesOverlay.astro';
import GillPartTocOverlay from './GillPartTocOverlay.astro';
import GillSeriesImagePremium from './GillSeriesImagePremium.astro';

interface Props {
  pageId: GillSeriesPageId;
}

const { pageId } = Astro.props;
const page = GILL_PAGE_DATA[pageId];
---
<GillSeriesImagePremium />
<style is:global>
  /* Final calibration from the 390/768/1440 Playwright witness. */
  @media (max-width: 640px) {
    [data-gill-v16] .gbs2-hero-cap { font-size: 11px; }
  }
  @media (min-width: 64em) {
    [data-gill-v16="context"] .gbs2-current-cover { --gbs2-cover-position: 100% 50%; }
  }
</style>
<a class="skip-link" href="#main-content">Перейти к содержимому</a>

<div class="gbs2-world" data-gill-v16={pageId}>
  <GillSeriesRail pageId={pageId} />

  <div class="page-wrap" id="content">
    <nav aria-label="Хлебные крошки" class="breadcrumb"><ol class="breadcrumb__list"><li class="breadcrumb__item"><a class="breadcrumb__link" href="../../"><span aria-hidden="true" class="breadcrumb__home">⌂</span> Главная</a></li><li class="breadcrumb__item"><a class="breadcrumb__link" href="../../biografii/">Биографии служителей</a></li><li aria-current="page" class="breadcrumb__item"><span class="breadcrumb__current">{page.label}</span></li></ol></nav>
    <slot />
  </div>

  <GillSeriesMobileBar pageId={pageId} />
  <GillSeriesOverlay pageId={pageId} />
  <GillPartTocOverlay pageId={pageId} />
</div><!-- /gbs2-world: overlays+bottom-bar nested so [data-gill-v16] descendant CSS applies -->

<script is:inline defer src="../../js/bookmark-engine.js?v=fdfb2ed7"></script>
<script is:inline defer src="../../js/site-utils.js?v=897afa55"></script>
<script is:inline defer src="../../js/scroll-perf.js?v=454d6f7b"></script>
<script is:inline defer src="../../js/site.js?v=36d399a5"></script>
<script is:inline defer src="../../js/glossary.js?v=ae46a35b"></script>
<script is:inline defer src="../../js/sw-register.js?v=7a8bd1e7"></script>
