---
import GillSeriesRail from './GillSeriesRail.astro';
import GillSeriesMobileBar from './GillSeriesMobileBar.astro';
import GillSeriesOverlay from './GillSeriesOverlay.astro';
import GillPartTocOverlay from './GillPartTocOverlay.astro';
import GillLearningSheet from './GillLearningSheet.astro';
import GillReaderSettingsSheet from './GillReaderSettingsSheet.astro';
import GillSeriesImagePremium from './GillSeriesImagePremium.astro';
import { GILL_SERIES, type SeriesConfig } from '../_shared/series/seriesConfig';

interface Props {
  pageId: string;
  config?: SeriesConfig;
}

const { pageId, config = GILL_SERIES } = Astro.props;
const page = config.pages[pageId];
---
<GillSeriesImagePremium />
<style is:global>
  /* Final calibration from the 390/768/1440 Playwright witness. */
  @media (max-width: 640px) {
    [data-gill-v16] .gbs2-hero-cap { font-size: 11px; }
  }
  @media (min-width: 64em) {
    [data-gill-v16="context"] .gbs2-current-cover { --gbs2-cover-position: 100% 50%; }
  }
</style>
<a class="skip-link" href="#main-content">Перейти к содержимому</a>

<!-- Site-sections menu opened by the rail's hamburger (#hMobileMenuBtn) —
     same canon backdrop+panel+JS as PastorSeriesPageChrome.astro etc., just
     with paths adjusted for Gill's two-levels-deep route. -->
<div id="hMobileBackdrop" class="h-mobile-backdrop" aria-hidden="true"></div>
<div class="h-mobile-nav" id="hMobileNav" aria-hidden="true">
  <span class="gbs-menu-label" aria-hidden="true">Разделы сайта</span>
  <a href="../../#publikacii" data-close-nav><span>Публикации</span><svg class="gbs-menu-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg></a>
  <a href="../../#razbor" data-close-nav><span>Разбор заблуждений</span><svg class="gbs-menu-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg></a>
  <a href="../../biografii/" data-close-nav><span>Биографии</span><svg class="gbs-menu-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg></a>
  <a href="../../articles/" data-close-nav><span>Все статьи</span><svg class="gbs-menu-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg></a>
  <a href="../../about/" data-close-nav><span>О проекте</span><svg class="gbs-menu-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg></a>
</div>

<div class="gbs2-world" data-gill-v16={pageId} data-series-theme={config.theme}>
  <GillSeriesRail pageId={pageId} config={config} />

  <div class="page-wrap" id="content">
    <nav aria-label="Хлебные крошки" class="breadcrumb"><ol class="breadcrumb__list"><li class="breadcrumb__item"><a class="breadcrumb__link" href="../../"><span aria-hidden="true" class="breadcrumb__home">⌂</span> Главная</a></li><li class="breadcrumb__item"><a class="breadcrumb__link" href={config.breadcrumbParent.href}>{config.breadcrumbParent.label}</a></li><li aria-current="page" class="breadcrumb__item"><span class="breadcrumb__current">{page.label}</span></li></ol></nav>
    <slot />
  </div>

  <GillSeriesMobileBar pageId={pageId} config={config} />
  <GillSeriesOverlay pageId={pageId} config={config} />
  <GillPartTocOverlay pageId={pageId} config={config} />
  <GillLearningSheet pageId={pageId} config={config} />
  <GillReaderSettingsSheet config={config} />
</div><!-- /gbs2-world: overlays+bottom-bar nested so [data-gill-v16] descendant CSS applies -->

<script is:inline defer src="../../js/bookmark-engine.js?v=fba4e559"></script>
<script is:inline defer src="../../js/site-utils.js?v=30ed46cf"></script>
<script is:inline defer src="../../js/scroll-perf.js?v=454d6f7b"></script>
<script is:inline defer src="../../js/site.js?v=38b94307"></script>
<script is:inline defer src="../../js/glossary.js?v=81fc28c2"></script>
<script is:inline defer src="../../js/sw-register.js?v=7a8bd1e7"></script>
