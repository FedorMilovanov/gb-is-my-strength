---
/**
 * GillSeriesMobileBar — mobile (<64em) control surface, v5.
 *
 *   TOP bar: Back(→«Биографии служителей») → Home(→«/») → Learning trigger
 *     /inline speed rail slot-swap (data-fc-speed-mode="inline" opts the
 *     ember OUT of the canonical bloom-pill in floating-cluster-controller.js
 *     — see initGillInlineSpeedRail()) → Play+badge → Save. Auto-hides on
 *     scroll-down, reveals on scroll-up, stays pinned while any Gill sheet
 *     or the speed rail is open, or while TTS is playing/paused
 *     (initGillMobileTopBarAutoHide below implements the exact
 *     hasOpenGillSheet/canAutoHideGillTopBar contract — this is also the
 *     fix for the A−/A+ reflow bug: hideGillTopBar() only ever touches the
 *     top bar's own class, never closeGillSheet()).
 *   BOTTOM bar: dual-progress ring → «Сейчас читаете» (opens Part TOC,
 *     unchanged) → theme cycle (День→Сепия→Ночь→День,
 *     window.applyGillReaderTheme) → settings sheet trigger → «Поделиться»
 *     (data-action="share" — kept verbatim; js/highlights.js docks its
 *     contextual save FAB immediately before this exact selector). Always
 *     visible, never auto-hides.
 *
 * data-fc-action="save" and data-action="share" go through the existing
 * global cluster delegation / initActionHandlers() on
 * [data-fc-root]/[data-fc-controls]. Learning/Settings sheet open+close,
 * focus-trap and scroll-lock are wired generically in initTocPopups()
 * (floating-cluster-controller.js) alongside the existing Part/Series TOC —
 * only the theme cycle, inline speed rail and top-bar auto-hide are
 * bar-local script here.
 */
import PlayEmber from '@/components/ui/floating-cluster/PlayEmber.astro';
import SaveButton from '@/components/ui/floating-cluster/SaveButton.astro';
import MobileChromeShell from '../_shared/MobileChromeShell.astro';
import { GILL_SERIES, type SeriesConfig } from '../_shared/series/seriesConfig';

interface Props {
  pageId: string;
  config?: SeriesConfig;
}

const { pageId, config = GILL_SERIES } = Astro.props as Props;
const page = config.pages[pageId];
---
<MobileChromeShell
  engine="series"
  topAttrs={{ 'data-fc-root': true, 'data-fc-variant': 'gill', 'data-gill-mobile-bar': true, 'data-fc-speed-mode': 'inline' }}
  bottomAttrs={{ 'data-fc-root': true, 'data-fc-variant': 'gill', 'data-gill-mobile-bar': true }}
>
  <Fragment slot="top-leading">
    <button class="gb-icon" id="mobBackBtn" type="button" aria-label="Назад" data-home-href="../../biografii/">
      <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
    </button>
    <a class="gb-icon" id="mobHomeBtn" href="../../" aria-label="На главную">
      <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" /></svg>
    </a>
  </Fragment>

  <div class="mobile-top-slot" slot="top-primary">
    <button type="button" class="mobile-learning-trigger" id="mobLearningBtn" data-gill-learning-open aria-expanded="false" aria-controls="gillLearningOverlay">
      <svg viewBox="0 0 24 24"><path d="M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 2 9 2 12 0v-5" /><path d="M22 10v6" /></svg>
      <span>Обучение</span>
    </button>
    <div class="mobile-speedrail" id="mobileSpeedrail" role="radiogroup" aria-label="Скорость озвучки" aria-hidden="true">
      <button type="button" class="mobile-speed" role="radio" data-speed="0.8" aria-checked="false">0.8×</button>
      <button type="button" class="mobile-speed" role="radio" data-speed="1" aria-checked="true">1×</button>
      <button type="button" class="mobile-speed" role="radio" data-speed="1.25" aria-checked="false">1.25×</button>
      <button type="button" class="mobile-speed" role="radio" data-speed="1.5" aria-checked="false">1.5×</button>
      <button type="button" class="mobile-speed" role="radio" data-speed="1.75" aria-checked="false">1.75×</button>
      <button type="button" class="mobile-speed" role="radio" data-speed="2" aria-checked="false">2×</button>
    </div>
  </div>

  <span class="mobile-playwrap" slot="top-playback">
    <PlayEmber audioState="none" class="mobile-top-ember" tip="Озвучка" />
    <button type="button" class="mobile-spdbadge" id="mobSpdBadge" aria-label="Скорость озвучки 1×">1×</button>
  </span>

  <SaveButton class="mobile-top-save" tip="Сохранить" slot="top-trailing" />

  <Fragment slot="bottom-progress">
    <!-- Progress is a read-only indicator, not a control: it never had a click
         handler (the controller only refreshes its aria-label on scroll), so it
         must not announce as an interactive button. role="img" + live aria-label
         gives screen readers the two progress values without implying an action. -->
    <div class="bar-progress dual-progress" id="gbs2DualProgress" role="img" aria-label="Статья 0%, серия 0%">
      <svg viewBox="0 0 36 36" aria-hidden="true">
        <circle class="bar-series-track" cx="18" cy="18" r="16"></circle>
        <circle class="bar-series-fill" id="gbs2MobSeriesRing" cx="18" cy="18" r="16" stroke-dasharray="100.53" stroke-dashoffset="100.53"></circle>
        <circle class="bar-progress-track" cx="18" cy="18" r="12.5"></circle>
        <circle class="bar-progress-fill" id="gbs2MobArticleRing" cx="18" cy="18" r="12.5" stroke-dasharray="78.54" stroke-dashoffset="78.54"></circle>
      </svg>
      <span class="bar-progress-text" id="gbs2MobPct">0%</span>
    </div>
  </Fragment>

  <button
    type="button"
    class="mobile-btoc-section"
    id="mobPartTocBtn"
    aria-label={`Открыть оглавление части: ${page.mobileSection}`}
    slot="bottom-context"
  >
    <span class="mobile-btoc-section__label">Сейчас читаете</span>
    <span class="mobile-btoc-section__main" id="gbs2MobSec">{page.mobileSection}</span>
  </button>

  <Fragment slot="bottom-actions">
    <button class="gb-icon" type="button" id="mobGillThemeBtn" data-gill-theme-cycle aria-label="Тема: День">
      <span class="theme-glyph" aria-hidden="true">☀</span>
    </button>

    <button class="gb-icon" type="button" id="mobSettingsBtn" data-gill-settings-open aria-label="Настройки чтения" aria-expanded="false" aria-controls="gillSettingsOverlay">
      <svg viewBox="0 0 24 24"><path d="M4 7h10M18 7h2M4 17h2M10 17h10" /><circle cx="16" cy="7" r="2" /><circle cx="8" cy="17" r="2" /></svg>
    </button>

    <button class="gb-icon" type="button" data-action="share" aria-label="Поделиться">
      <svg viewBox="0 0 24 24"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg>
    </button>
  </Fragment>
</MobileChromeShell>

<script>
  const READER_THEME_KEY = 'gb:gill-reader-theme:v1';

  // Shared by the bottom-bar quick-cycle button AND GillReaderSettingsSheet's
  // segmented control — one function owns theme application so the two
  // surfaces can never fall out of sync. "Ночь" reuses the sitewide
  // html.dark toggle (single dark-mode implementation); "Сепия" is scoped
  // to [data-gill-v16][data-gill-reader-theme="sepia"] under <64em only
  // (see css/floating-cluster.css) and never touches html.sepia, which
  // doesn't exist sitewide.
  function applyGillReaderTheme(theme: string) {
    const gillRoot = document.querySelector('[data-gill-v16]') as HTMLElement | null;
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
      if (gillRoot) gillRoot.removeAttribute('data-gill-reader-theme');
    } else if (theme === 'sepia') {
      document.documentElement.classList.remove('dark');
      if (gillRoot) gillRoot.setAttribute('data-gill-reader-theme', 'sepia');
    } else {
      document.documentElement.classList.remove('dark');
      if (gillRoot) gillRoot.removeAttribute('data-gill-reader-theme');
    }
    try { localStorage.setItem(READER_THEME_KEY, theme); } catch (_) {}
    try { localStorage.setItem('theme', theme === 'dark' ? 'dark' : 'light'); } catch (_) {}

    const label = theme === 'dark' ? 'Ночь' : theme === 'sepia' ? 'Сепия' : 'День';
    const glyph = theme === 'dark' ? '☾' : theme === 'sepia' ? '◐' : '☀';
    const cycleBtn = document.getElementById('mobGillThemeBtn');
    if (cycleBtn) {
      cycleBtn.setAttribute('aria-label', 'Тема: ' + label);
      const g = cycleBtn.querySelector('.theme-glyph');
      if (g) g.textContent = glyph;
    }
    document.querySelectorAll('[data-gill-theme-btn]').forEach((btn) => {
      btn.setAttribute('aria-pressed', (btn as HTMLElement).dataset.theme === theme ? 'true' : 'false');
    });
  }
  (window as any).applyGillReaderTheme = applyGillReaderTheme;

  function initGillThemeCycle() {
    const cycleBtn = document.getElementById('mobGillThemeBtn');
    if (!cycleBtn) return;
    const order = ['light', 'sepia', 'dark'];
    cycleBtn.addEventListener('click', () => {
      const gillRoot = document.querySelector('[data-gill-v16]') as HTMLElement | null;
      const current = document.documentElement.classList.contains('dark')
        ? 'dark'
        : gillRoot && gillRoot.getAttribute('data-gill-reader-theme') === 'sepia'
          ? 'sepia'
          : 'light';
      applyGillReaderTheme(order[(order.indexOf(current) + 1) % order.length]);
    });
    // Restore on load — best effort only (no FOUC guard for the sepia
    // scope specifically; a brief flash for returning sepia readers is an
    // accepted trade-off, see lane report).
    try {
      const saved = localStorage.getItem(READER_THEME_KEY);
      if (saved) applyGillReaderTheme(saved);
    } catch (_) {}
  }

  // Smart auto-hide (owner: "верхняя как-то умно убирается и появляется…
  // если PLAY нажали, то пускай фиксируется"): hides the top bar on
  // scroll-down, reveals on scroll-up, stays pinned while ANY Gill sheet
  // (Part/Series TOC, Learning, Settings) or the inline speed rail is open,
  // or while TTS is playing/paused. This is also the A−/A+ reflow fix: the
  // hide function only ever toggles the bar's own class and NEVER closes a
  // sheet — a font-size change reflowing the article and nudging scrollTop
  // can no longer read as "the settings sheet vanished".
  function initGillMobileTopBarAutoHide() {
    const worldEl = document.querySelector('.gbs2-world[data-gill-v16]');
    const topBar = document.querySelector('.mobile-top-bar[data-gill-mobile-bar]');
    const ember = topBar ? topBar.querySelector('.gb-ember') : null;
    if (!worldEl || !topBar) return;
    const world = worldEl;

    let lastY = window.scrollY || 0;
    let hidden = false;
    let ttsActive = false;
    let ticking = false;

    function hasOpenGillSheet() {
      return Boolean(document.querySelector('.toc-overlay.is-open'));
    }
    function speedRailOpen() {
      return topBar!.classList.contains('speed-open');
    }
    function canAutoHide() {
      return !hasOpenGillSheet() && !speedRailOpen() && !ttsActive && !topBar!.contains(document.activeElement);
    }
    function apply() {
      world!.classList.toggle('gbs2-tbhidden', hidden && canAutoHide());
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY || 0;
        // v2.8: top bar is transparent/frameless at the very top and gains its
        // frosted background + hairline only once the page is scrolled.
        topBar!.classList.toggle('is-scrolled', y > 4);
        if (!canAutoHide()) {
          hidden = false;
          lastY = y;
          apply();
          ticking = false;
          return;
        }
        const delta = y - lastY;
        if (Math.abs(delta) > 6) {
          hidden = y >= 80 && delta > 0;
          lastY = y;
          apply();
        }
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    // Seed the scrolled state in case the page loads already scrolled (reload
    // mid-article / anchor navigation), so the top bar isn't stuck transparent.
    topBar.classList.toggle('is-scrolled', (window.scrollY || 0) > 4);

    if (ember) {
      const syncTts = () => {
        const st = (ember as HTMLElement).dataset.state;
        const wasActive = ttsActive;
        ttsActive = st === 'playing' || st === 'paused';
        if (ttsActive !== wasActive) apply();
      };
      syncTts();
      new MutationObserver(syncTts).observe(ember, { attributes: true, attributeFilter: ['data-state'] });
    }

    // A sheet or the speed rail opening must re-show the bar immediately,
    // even mid-scroll-down — not just on the next scroll tick.
    document.addEventListener('gb:gill-sheet-open', () => { hidden = false; apply(); });
  }

  function boot() {
    initGillThemeCycle();
    initGillMobileTopBarAutoHide();

    const backBtn = document.getElementById('mobBackBtn');
    if (backBtn) backBtn.addEventListener('click', () => {
      const href = (backBtn as HTMLElement).dataset.homeHref;
      if (href) window.location.href = href;
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
  else boot();
</script>
