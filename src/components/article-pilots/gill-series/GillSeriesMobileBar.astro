---
/**
 * GillSeriesMobileBar — shared series mobile (<85em) control surface, v6.
 *
 *   TOP bar: Back(→config.railBackHref) → Home(→«/») → primary
 *     «Аналитика» (opens research tab INSIDE native Part TOC) → canonical
 *     round PlayEmber and the original #83439219 IN-SLOT speed strip + tiny selected-rate
 *     echo → Settings → Save. «Аналитика» yields its place to the speed rail.
 *     Learning remains in the native Reader Settings sheet,
 *     not a competing top-level action. One canonical speedSlot owner.
 *     Auto-hides on scroll-down, reveals on scroll-up; stays pinned while
 *     any Gill sheet, the in-slot speed strip or TTS playing/paused
 *     (initGillMobileTopBarAutoHide below implements the exact
 *     hasOpenGillSheet/canAutoHideGillTopBar contract — this is also the
 *     fix for the A−/A+ reflow bug: hideGillTopBar() only ever touches the
 *     top bar's own class, never closeGillSheet()).
 *   BOTTOM bar: dual-progress ring → «Сейчас читаете» (opens Part TOC,
 *     unchanged) → Library → PDF → «Поделиться»
 *     (data-action="share" — kept verbatim; js/highlights.js docks its
 *     contextual save FAB before PDF/share). No redundant bottom Settings. Always
 *     visible, never auto-hides.
 *
 * data-fc-action="save" and data-action="share" go through the existing
 * global cluster delegation / initActionHandlers() on
 * [data-fc-root]/[data-fc-controls]. Research/TOC/Learning/Settings
 * share the existing initTocPopups() overlay/focus/scroll owner;
 * TTS is owned by floating-cluster-controller; rate UI by speedSlot.ts.
 * Only theme sync and top-bar auto-hide are bar-local.
 */
import SaveButton from '@/components/ui/floating-cluster/SaveButton.astro';
import MobileChromeShell from '../_shared/MobileChromeShell.astro';
import ReaderMobileMenuTrigger from '../_shared/ReaderMobileMenuTrigger.astro';
import ReaderSpeedOptions from '../_shared/ReaderSpeedOptions.astro';
import ReaderMobileActions from '../_shared/ReaderMobileActions.astro';
import ReaderMobileSettingsButton from '../_shared/ReaderMobileSettingsButton.astro';
import ReaderMobileHome from '../_shared/ReaderMobileHome.astro';
import ReaderMobilePlayGroup from '../_shared/ReaderMobilePlayGroup.astro';
// Mobile Reader chrome must own its styling directly: it cannot disappear
// when a particular speed-picker component is removed from this route.
import '@/styles/reader-mobile-canonical.css';
import { GILL_SERIES, type SeriesConfig } from '../_shared/series/seriesConfig';

interface Props {
  pageId: string;
  config?: SeriesConfig;
}

const { pageId, config = GILL_SERIES } = Astro.props as Props;
const page = config.pages[pageId];
---
<MobileChromeShell
  engine="series"
  topAttrs={{ 'data-fc-root': true, 'data-fc-variant': 'gill', 'data-gill-mobile-bar': true, 'data-reader-mobile-speed': true, 'data-gb-speed-custom': true }}
  bottomAttrs={{ 'data-fc-root': true, 'data-fc-variant': 'gill', 'data-gill-mobile-bar': true }}
>
  <Fragment slot="top-leading">
    <button class="gb-icon" id="mobBackBtn" type="button" aria-label="Назад" data-home-href={config.railBackHref}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
    </button>
    <ReaderMobileHome engine="series" href="../../" />
  </Fragment>

  <div class="mobile-top-slot" slot="top-primary">
    <ReaderMobileMenuTrigger mode="research" />
    <ReaderSpeedOptions id="mobileSpeedrail" railClass="mobile-speedrail" chipClass="mobile-speed" rates={[0.75, 1, 1.25, 1.5, 1.75, 2]} initiallyInert />
  </div>

  <ReaderMobilePlayGroup engine="series" slot="top-playback" />

  <Fragment slot="top-trailing">
    <ReaderMobileSettingsButton engine="series" top />
    <SaveButton class="mobile-top-save" tip="Сохранить" />
  </Fragment>

  <Fragment slot="bottom-progress">
    <!-- Progress is a read-only indicator, not a control: it never had a click
         handler (the controller only refreshes its aria-label on scroll), so it
         must not announce as an interactive button. role="img" + live aria-label
         gives screen readers the two progress values without implying an action. -->
    <div class="bar-progress dual-progress" id="gbs2DualProgress" role="img" aria-label="Статья 0%, серия 0%">
      <svg viewBox="0 0 36 36" aria-hidden="true">
        <circle class="bar-series-track" cx="18" cy="18" r="16"></circle>
        <circle class="bar-series-fill" id="gbs2MobSeriesRing" cx="18" cy="18" r="16" stroke-dasharray="100.53" stroke-dashoffset="100.53"></circle>
        <circle class="bar-progress-track" cx="18" cy="18" r="12.5"></circle>
        <circle class="bar-progress-fill" id="gbs2MobArticleRing" cx="18" cy="18" r="12.5" stroke-dasharray="78.54" stroke-dashoffset="78.54"></circle>
      </svg>
      <span class="bar-progress-text" id="gbs2MobPct">0%</span>
    </div>
  </Fragment>

  <!-- a11y D-3 (browser audit 2026-10-13): WCAG 2.5.3 — the accessible name must contain
       the visible label text. The visible pair («Сейчас читаете» + the section title) is
       swapped at runtime by js/enhancements.js (mobSec.textContent = current heading), so a
       static aria-label can never stay in sync; the name is therefore computed FROM the
       content and the action hint is appended as a visually hidden suffix. -->
  <button type="button" class="mobile-btoc-section" id="mobPartTocBtn" slot="bottom-context">
    <span class="mobile-btoc-section__label">Сейчас читаете</span>
    <span class="mobile-btoc-section__main" id="gbs2MobSec">{page.mobileSection}</span>
    <span class="sr-only">— открыть оглавление части</span>
  </button>

  <Fragment slot="bottom-actions">
    <ReaderMobileActions engine="series" settingsPlacement="none" />
  </Fragment>
</MobileChromeShell>

<script>
  function currentGillTheme() {
    const preferences = (window as any).GBReaderPreferences?.get?.() || (window as any).__GB_READER_PREFS_BOOTSTRAP__;
    if (preferences?.theme) return preferences.theme;
    return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  }

  function syncGillThemeSegment(theme = currentGillTheme()) {
    const gillRoot = document.querySelector('[data-gill-v16]') as HTMLElement | null;
    if (gillRoot) {
      if (theme === 'sepia') gillRoot.setAttribute('data-gill-reader-theme', 'sepia');
      else gillRoot.removeAttribute('data-gill-reader-theme');
    }
    const label = theme === 'dark' ? 'Ночь' : theme === 'sepia' ? 'Сепия' : 'День';
    const glyph = theme === 'dark' ? '☾' : theme === 'sepia' ? '◐' : '☀';
    const cycleBtn = document.getElementById('mobGillThemeBtn');
    if (cycleBtn) {
      cycleBtn.setAttribute('aria-label', 'Тема: ' + label);
      const glyphNode = cycleBtn.querySelector('.theme-glyph');
      if (glyphNode) glyphNode.textContent = glyph;
    }
    document.querySelectorAll('[data-gill-theme-btn]').forEach((button) => {
      button.setAttribute('aria-pressed', (button as HTMLElement).dataset.theme === theme ? 'true' : 'false');
    });
  }

  function applyGillReaderTheme(theme: string) {
    const api = (window as any).GBReaderPreferences;
    if (api && typeof api.setTheme === 'function') api.setTheme(theme, { source: 'gill-reader-theme' });
    else {
      document.documentElement.classList.toggle('dark', theme === 'dark');
      document.documentElement.setAttribute('data-reader-theme', theme);
    }
    syncGillThemeSegment(theme);
  }
  (window as any).applyGillReaderTheme = applyGillReaderTheme;

  function initGillThemeSync() {
    syncGillThemeSegment();
    document
      .querySelectorAll('.mobile-bottom-bar .gb-theme-toggle, .gbs-theme-corner .gb-theme-toggle')
      .forEach((button) => button.addEventListener('click', () => requestAnimationFrame(() => syncGillThemeSegment())));
    const settingsButton = document.getElementById('mobSettingsBtn');
    if (settingsButton) settingsButton.addEventListener('click', () => requestAnimationFrame(() => syncGillThemeSegment()));
    document.addEventListener('gb:reader-preferences-change', (event: Event) => {
      syncGillThemeSegment((event as CustomEvent).detail?.preferences?.theme || currentGillTheme());
    });
  }

  // Smart auto-hide (owner: "верхняя как-то умно убирается и появляется…
  // если PLAY нажали, то пускай фиксируется"): hides the top bar on
  // scroll-down, reveals on scroll-up, stays pinned while ANY Gill sheet
  // (Part/Series TOC, Learning, Settings) or the inline speed rail is open,
  // or while TTS is playing/paused. This is also the A−/A+ reflow fix: the
  // hide function only ever toggles the bar's own class and NEVER closes a
  // sheet — a font-size change reflowing the article and nudging scrollTop
  // can no longer read as "the settings sheet vanished".
  function initGillMobileTopBarAutoHide() {
    const worldEl = document.querySelector('.gbs2-world[data-gill-v16]');
    const topBar = document.querySelector('.mobile-top-bar[data-gill-mobile-bar]');
    const ember = topBar ? topBar.querySelector('.gb-ember') : null;
    if (!worldEl || !topBar) return;
    const world = worldEl;

    let lastY = window.scrollY || 0;
    let hidden = false;
    let ttsActive = false;
    let ticking = false;

    function hasOpenGillSheet() {
      return document.documentElement.hasAttribute('data-scroll-locked') ||
        Boolean(document.querySelector('.toc-overlay.is-open, #gb-hl-backdrop.is-open'));
    }
    function speedRailOpen() {
      return topBar!.classList.contains('speed-open');
    }
    function canAutoHide() {
      return !hasOpenGillSheet() && !speedRailOpen() && !ttsActive && !topBar!.contains(document.activeElement);
    }
    function apply() {
      if (!hasOpenGillSheet()) world.classList.toggle('gbs2-tbhidden', hidden && canAutoHide());
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        // Locking the body temporarily resets scrollY. Keep the backdrop still.
        if (hasOpenGillSheet()) return;
        const y = window.scrollY || 0;
        // v2.8: top bar is transparent/frameless at the very top and gains its
        // frosted background + hairline only once the page is scrolled.
        topBar!.classList.toggle('is-scrolled', y > 4);
        if (!canAutoHide()) {
          hidden = false;
          lastY = y;
          apply();
          ticking = false;
          return;
        }
        const delta = y - lastY;
        if (Math.abs(delta) > 6) {
          hidden = y >= 80 && delta > 0;
          lastY = y;
          apply();
        }
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    // Seed the scrolled state in case the page loads already scrolled (reload
    // mid-article / anchor navigation), so the top bar isn't stuck transparent.
    topBar.classList.toggle('is-scrolled', (window.scrollY || 0) > 4);

    if (ember) {
      const syncTts = () => {
        const st = (ember as HTMLElement).dataset.state;
        const wasActive = ttsActive;
        ttsActive = st === 'playing' || st === 'paused';
        if (ttsActive !== wasActive) apply();
      };
      syncTts();
      new MutationObserver(syncTts).observe(ember, { attributes: true, attributeFilter: ['data-state'] });
    }

  }

  function boot() {
    initGillThemeSync();
    initGillMobileTopBarAutoHide();

    const backBtn = document.getElementById('mobBackBtn');
    // B14: DEAD — reader-actions.js capture-handles [data-home-href] (goBack:
    // same-origin history.back(), else the fallback href) before this bubble
    // listener runs. Kept for documentation; extend goBack() there, not here.
    if (backBtn) backBtn.addEventListener('click', () => {
      const href = (backBtn as HTMLElement).dataset.homeHref;
      if (href) window.location.href = href;
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
  else boot();
</script>

<!-- Gill mobile reference: 83439219 (original in-slot speed strip).
     Back and Home remain visible; six rates replace only «Аналитика».
     Play is a 44px target with ONE softly painted 36px SVG ring. -->
<style is:global>
@media (max-width:84.999em) {
  [data-gill-v16] .mobile-top-bar .reader-mobile-play-group.mobile-playwrap {
    box-sizing:border-box;position:relative;z-index:2;display:flex;align-items:center;
    justify-content:flex-start;flex:0 0 88px;width:88px;min-width:88px;
    height:44px;gap:0;margin:0;overflow:visible;
    /* Two non-overlapping 44px targets: rate first, then Play.
       This positions the visible Play immediately beside Settings. */
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-play-group .reader-mobile-play {
    --ember-size:44px;
    position:relative;z-index:1;box-sizing:border-box;
    display:grid;place-items:center;flex:0 0 44px;
    width:44px;height:44px;min-width:44px;min-height:44px;
    margin:0;padding:0;border:0;border-radius:50%;
    background:transparent;color:var(--gill-mobile-bar-ink,#291f1b);
    box-shadow:none;transform:none;
  }
  /* AuditRepo PremiumControls v4: one genuine --p SVG progress arc,
     never a decorative second border. Owner W101 reduces optical ring
     diameter from 36px to 28.8px while preserving the 44px Play target. */
  [data-gill-v16] .mobile-top-bar .reader-mobile-play .gb-ember__ring-svg {
    inset:6px;width:32px;height:32px;opacity:1;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-play .gb-ember__ring-track {
    stroke:var(--gill-mobile-bar-gold,#b18b62);stroke-width:3;opacity:.58;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-play .gb-ember__ring-progress {
    stroke-width:3.6;opacity:1;
    /* The actual TTS --p value controls stroke-dashoffset in
       floating-cluster.css. Keep the warm moving arc, no fake looping fill. */
    stroke-linecap:round;
    filter:drop-shadow(0 0 1px rgba(197,151,88,.13));
    transition:stroke-dashoffset .55s cubic-bezier(.2,.75,.3,1);
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-play[data-state="playing"] .gb-ember__ring-progress {
    filter:drop-shadow(0 0 1.5px rgba(197,151,88,.32));
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-play::before {
    inset:19%;border:none;
    background:radial-gradient(circle,
      color-mix(in srgb,var(--gill-mobile-bar-gold,#b18b62) 13%,transparent) 0%,
      transparent 78%);
    transition:opacity .18s ease;
  }
  @media(hover:hover) and (pointer:fine) {
    [data-gill-v16] .mobile-top-bar .reader-mobile-play:hover {transform:none;}
  }
  /* A separate 44px speed target precedes Play in DOM and paint order.
     Its small painted chip reaches the lower-right Play arc, while the
     true hit-box stays clear of Settings and Play's primary tap target. */
  [data-gill-v16] .mobile-top-bar .reader-mobile-play-group .reader-mobile-speed-badge {
    position:relative;z-index:3;box-sizing:border-box;flex:0 0 44px;
    width:44px;height:44px;min-width:44px;min-height:44px;
    padding:0;margin:0;border:0;border-radius:0;background:transparent;
    box-shadow:none;overflow:visible;cursor:pointer;color:inherit;
    pointer-events:auto;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-speed-badge::before {
    content:none;display:none;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-speed-chip {
    box-sizing:border-box;position:absolute;left:auto;right:-40px;bottom:1px;z-index:4;
    display:grid;place-items:center;width:max-content;
    min-width:24px;max-width:35px;height:15px;padding:0 3px;
    border:1px solid color-mix(in srgb,var(--gill-mobile-bar-paper,#fffaf5) 68%,transparent);
    border-radius:999px;background:#544333;color:#fff9f0;
    font:720 8.5px/1 "Source Sans 3",system-ui,sans-serif;
    white-space:nowrap;box-shadow:0 1px 5px rgba(35,24,17,.13);
    /* The visible chip delegates to the dedicated rate button.
       It never projects into the neighbouring Settings hit area. */
    pointer-events:auto;cursor:pointer;
  }
  html.dark [data-gill-v16] .mobile-top-bar .reader-mobile-speed-chip {
    background:#c7a170;color:#191617;border-color:#312826;
    box-shadow:0 1px 5px rgba(0,0,0,.23);
  }
  [data-gill-v16] .mobile-top-bar .mobile-top-slot {
    position:relative;flex:1 1 auto;min-width:0;z-index:3;
  }
  /* Original Gill #83439219: the rail occupies ONLY the central slot.
     Back/Home stay visible, clickable, keyboard-focusable during the swap. */
  [data-gill-v16] .mobile-top-bar.speed-open .mobile-top-slot .reader-mobile-speedrail {
    /* Historical 44px accessibility badge stays in the DOM, but while rates
       are open their rail extends across that badge and stops before Play.
       Never overlay the 44px Play or Settings hitboxes. */
    position:absolute;inset:0;left:0;right:-44px;
    width:calc(100% + 44px);max-width:calc(100% + 44px);
    height:44px;min-height:44px;z-index:7;
    padding:0;gap:2px;border:0;border-radius:0;
    /* The six rate choices must cover article artwork with a legible,
       theme-matched near-opaque surface, rather than see-through text. */
    background:var(--gill-mobile-bar-bg,#fdfbf6);
    /* Keep each series' palette but force alpha=1. Older browsers keep
       the themed token above as a graceful fallback. */
    background:rgb(from var(--gill-mobile-bar-bg,#fdfbf6) r g b / 1);
    box-shadow:none;
    opacity:1;transform:translateX(0);
    transition:opacity .18s ease,transform .18s cubic-bezier(.2,.7,.2,1);
    white-space:nowrap;
  }
  html.dark [data-gill-v16] .mobile-top-bar.speed-open .reader-mobile-speedrail {
    border:0;background:var(--gill-mobile-bar-bg,#0d1117);
    background:rgb(from var(--gill-mobile-bar-bg,#0d1117) r g b / 1);
    box-shadow:none;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-speed-rate {
    flex:0 0 44px;min-width:44px;width:44px;height:44px;
    padding:0;position:relative;isolation:isolate;
    color:var(--gill-mobile-bar-muted,#786552);font-size:10.5px;
    /* Global floating-cluster.css adds a rectangular box-shadow to
       every checked speed button. The selected Gill pill is painted by
       its rounded ::before, so remove the extra 44px square only here. */
    background:transparent;border:0;box-shadow:none;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-speed-rate::before {
    content:'';position:absolute;z-index:-1;inset:6px 1px;
    border:1px solid color-mix(in srgb,var(--gill-mobile-bar-gold,#b18b62) 28%,transparent);
    border-radius:999px;background:transparent;
    transition:background .16s ease,border-color .16s ease;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-speed-rate::after {
    content:none;display:none;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-speed-rate[aria-checked="true"] {
    color:#744e26;background:transparent;box-shadow:none;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-speed-rate[aria-checked="true"]::before {
    background:color-mix(in srgb,var(--gill-mobile-bar-gold,#b18b62) 18%,transparent);
    border-color:color-mix(in srgb,var(--gill-mobile-bar-gold,#b18b62) 88%,transparent);
  }
  html.dark [data-gill-v16] .mobile-top-bar .reader-mobile-speed-rate {
    color:#c9ad8d;
  }
  html.dark [data-gill-v16] .mobile-top-bar .reader-mobile-speed-rate[aria-checked="true"] {
    color:#f3d19b;
  }
  html.dark [data-gill-v16] .mobile-top-bar .reader-mobile-speed-rate[aria-checked="true"]::before {
    background:rgba(210,163,101,.17);border-color:#c6a06b;
  }
  [data-gill-v16] .mobile-top-bar.speed-open .reader-mobile-menu-trigger {
    opacity:0;transform:none;pointer-events:none;
  }
}
/* Optical spacing: independent 44px targets with Play adjacent to Settings. */
@media (min-width:431px) and (max-width:84.999em) {
  [data-gill-v16] .mobile-top-bar {gap:2px!important;}
  [data-gill-v16] .mobile-top-bar .reader-mobile-action--top-settings svg,
  [data-gill-v16] .mobile-top-bar .mobile-top-save svg {
    transform:translateX(-8px);
  }
}
@media (min-width:361px) and (max-width:430px) {
  [data-gill-v16] .mobile-top-bar .reader-mobile-action--top-settings svg,
  [data-gill-v16] .mobile-top-bar .mobile-top-save svg {
    transform:translateX(-4px);
  }
}
@media(max-width:430px) {
  [data-gill-v16] .mobile-top-bar.speed-open .reader-mobile-speedrail {
    -webkit-mask-image:linear-gradient(to right,#000 0%,#000 calc(100% - 10px),transparent 100%);
    mask-image:linear-gradient(to right,#000 0%,#000 calc(100% - 10px),transparent 100%);
  }
}
@media(prefers-reduced-motion:reduce) {
  [data-gill-v16] .mobile-top-bar .reader-mobile-speedrail,
  [data-gill-v16] .mobile-top-bar .reader-mobile-menu-trigger,
  [data-gill-v16] .mobile-top-bar .reader-mobile-play::before {transition:none;}
  [data-gill-v16] .mobile-top-bar .reader-mobile-play .gb-ember__ring-progress {transition:none;filter:none;}
}

/* Owner W61: move the existing Settings sheet trigger beside Play.
   Its former bottom action is absent, freeing a true 44px for the chapter.
   Every icon remains a 44×44 touch/keyboard target. */
@media (max-width:84.999em) {
  [data-gill-v16] .mobile-top-bar .reader-mobile-action--top-settings {
    box-sizing:border-box;flex:0 0 44px;display:grid;place-items:center;
    width:44px;min-width:44px;height:44px;min-height:44px;
    padding:0;margin:0;border:0;border-radius:50%;
    color:var(--gill-mobile-bar-ink,#291f1b);background:transparent;
    box-shadow:none;cursor:pointer;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-action--top-settings svg {
    display:block;width:18px;height:18px;fill:none;stroke:currentColor;
    stroke-width:1.7;stroke-linecap:round;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-action--top-settings:focus-visible {
    outline:2px solid var(--gill-mobile-bar-gold,#b18b62);outline-offset:2px;
  }
  @media(hover:hover) and (pointer:fine) {
    [data-gill-v16] .mobile-top-bar .reader-mobile-action--top-settings:hover {
      background:color-mix(in srgb,currentColor 6%,transparent);
    }
  }
}
/* The six original top targets total 308px including the central 44px
   research icon. Use only the leftover spacing at 320px, do not shrink hit
   areas or squeeze the Play/speed controller into overlapping hitboxes. */
@media (max-width:430px) {
  [data-gill-v16] .mobile-top-bar {
    gap:clamp(0px,calc(5vw - 16px),4px) !important;
    padding-left:calc(6px + env(safe-area-inset-left,0px)) !important;
    padding-right:calc(6px + env(safe-area-inset-right,0px)) !important;
  }
}
@media (max-width:360px) {
  [data-gill-v16] .mobile-top-bar .reader-mobile-menu-trigger {
    padding:0;gap:0;justify-content:center;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-menu-trigger span {
    display:none;
  }
}

/* Reader 1024–1360 breakpoint: legacy Gill overrides can still shrink
   Back and Save to 40px. Keep the same 44px targets as narrow phones. */
@media (min-width:431px) and (max-width:84.999em) {
  [data-gill-v16] .mobile-top-bar #mobBackBtn,
  [data-gill-v16] .mobile-top-bar .mobile-top-save {
    box-sizing:border-box;
    width:44px !important;min-width:44px !important;
    height:44px !important;min-height:44px !important;
    flex:0 0 44px !important;
  }
}
