---
/**
 * GillSeriesMobileBar — shared series mobile (<85em) control surface, v6.
 *
 *   TOP bar: Back(→config.railBackHref) → Home(→«/») → primary
 *     «На полях» (opens research tab INSIDE native Part TOC) → canonical
 *     round PlayEmber with the #72 speed bloom DOWN + tiny selected-rate
 *     echo → Save. Learning remains in the native Reader Settings sheet,
 *     not a competing top-level action. Never mount a second speed owner.
 *     Auto-hides on scroll-down, reveals on scroll-up; stays pinned while
 *     any Gill sheet, the speed bloom or TTS playing/paused
 *     (initGillMobileTopBarAutoHide below implements the exact
 *     hasOpenGillSheet/canAutoHideGillTopBar contract — this is also the
 *     fix for the A−/A+ reflow bug: hideGillTopBar() only ever touches the
 *     top bar's own class, never closeGillSheet()).
 *   BOTTOM bar: dual-progress ring → «Сейчас читаете» (opens Part TOC,
 *     unchanged) → fast binary Day/Night toggle through the canonical global
 *     preference adapter (Sepia remains in Settings) → settings → «Поделиться»
 *     (data-action="share" — kept verbatim; js/highlights.js docks its
 *     contextual save FAB immediately before this exact selector). Always
 *     visible, never auto-hides.
 *
 * data-fc-action="save" and data-action="share" go through the existing
 * global cluster delegation / initActionHandlers() on
 * [data-fc-root]/[data-fc-controls]. Research/TOC/Learning/Settings
 * share the existing initTocPopups() overlay/focus/scroll owner;
 * original speed-bloom and TTS remain owned by floating-cluster-controller.
 * Only theme sync and top-bar auto-hide are bar-local.
 */
import SaveButton from '@/components/ui/floating-cluster/SaveButton.astro';
import MobileChromeShell from '../_shared/MobileChromeShell.astro';
import ReaderMobileMenuTrigger from '../_shared/ReaderMobileMenuTrigger.astro';
import ReaderMobileActions from '../_shared/ReaderMobileActions.astro';
import ReaderMobileHome from '../_shared/ReaderMobileHome.astro';
import ReaderMobilePlayGroup from '../_shared/ReaderMobilePlayGroup.astro';
// Mobile Reader chrome must own its styling directly: it cannot disappear
// when a particular speed-picker component is removed from this route.
import '@/styles/reader-mobile-canonical.css';
import { GILL_SERIES, type SeriesConfig } from '../_shared/series/seriesConfig';

interface Props {
  pageId: string;
  config?: SeriesConfig;
}

const { pageId, config = GILL_SERIES } = Astro.props as Props;
const page = config.pages[pageId];
---
<MobileChromeShell
  engine="series"
  topAttrs={{ 'data-fc-root': true, 'data-fc-variant': 'gill', 'data-gill-mobile-bar': true, 'data-reader-mobile-speed': true }}
  bottomAttrs={{ 'data-fc-root': true, 'data-fc-variant': 'gill', 'data-gill-mobile-bar': true }}
>
  <Fragment slot="top-leading">
    <button class="gb-icon" id="mobBackBtn" type="button" aria-label="Назад" data-home-href={config.railBackHref}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
    </button>
    <ReaderMobileHome engine="series" href="../../" />
  </Fragment>

  <div class="mobile-top-slot" slot="top-primary">
    <ReaderMobileMenuTrigger mode="research" />
  </div>

  <ReaderMobilePlayGroup engine="series" bloom slot="top-playback" />

  <SaveButton class="mobile-top-save" tip="Сохранить" slot="top-trailing" />

  <Fragment slot="bottom-progress">
    <!-- Progress is a read-only indicator, not a control: it never had a click
         handler (the controller only refreshes its aria-label on scroll), so it
         must not announce as an interactive button. role="img" + live aria-label
         gives screen readers the two progress values without implying an action. -->
    <div class="bar-progress dual-progress" id="gbs2DualProgress" role="img" aria-label="Статья 0%, серия 0%">
      <svg viewBox="0 0 36 36" aria-hidden="true">
        <circle class="bar-series-track" cx="18" cy="18" r="16"></circle>
        <circle class="bar-series-fill" id="gbs2MobSeriesRing" cx="18" cy="18" r="16" stroke-dasharray="100.53" stroke-dashoffset="100.53"></circle>
        <circle class="bar-progress-track" cx="18" cy="18" r="12.5"></circle>
        <circle class="bar-progress-fill" id="gbs2MobArticleRing" cx="18" cy="18" r="12.5" stroke-dasharray="78.54" stroke-dashoffset="78.54"></circle>
      </svg>
      <span class="bar-progress-text" id="gbs2MobPct">0%</span>
    </div>
  </Fragment>

  <!-- a11y D-3 (browser audit 2026-10-13): WCAG 2.5.3 — the accessible name must contain
       the visible label text. The visible pair («Сейчас читаете» + the section title) is
       swapped at runtime by js/enhancements.js (mobSec.textContent = current heading), so a
       static aria-label can never stay in sync; the name is therefore computed FROM the
       content and the action hint is appended as a visually hidden suffix. -->
  <button type="button" class="mobile-btoc-section" id="mobPartTocBtn" slot="bottom-context">
    <span class="mobile-btoc-section__label">Сейчас читаете</span>
    <span class="mobile-btoc-section__main" id="gbs2MobSec">{page.mobileSection}</span>
    <span class="sr-only">— открыть оглавление части</span>
  </button>

  <Fragment slot="bottom-actions">
    <ReaderMobileActions engine="series" />
  </Fragment>
</MobileChromeShell>

<script>
  function currentGillTheme() {
    const preferences = (window as any).GBReaderPreferences?.get?.() || (window as any).__GB_READER_PREFS_BOOTSTRAP__;
    if (preferences?.theme) return preferences.theme;
    return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  }

  function syncGillThemeSegment(theme = currentGillTheme()) {
    const gillRoot = document.querySelector('[data-gill-v16]') as HTMLElement | null;
    if (gillRoot) {
      if (theme === 'sepia') gillRoot.setAttribute('data-gill-reader-theme', 'sepia');
      else gillRoot.removeAttribute('data-gill-reader-theme');
    }
    const label = theme === 'dark' ? 'Ночь' : theme === 'sepia' ? 'Сепия' : 'День';
    const glyph = theme === 'dark' ? '☾' : theme === 'sepia' ? '◐' : '☀';
    const cycleBtn = document.getElementById('mobGillThemeBtn');
    if (cycleBtn) {
      cycleBtn.setAttribute('aria-label', 'Тема: ' + label);
      const glyphNode = cycleBtn.querySelector('.theme-glyph');
      if (glyphNode) glyphNode.textContent = glyph;
    }
    document.querySelectorAll('[data-gill-theme-btn]').forEach((button) => {
      button.setAttribute('aria-pressed', (button as HTMLElement).dataset.theme === theme ? 'true' : 'false');
    });
  }

  function applyGillReaderTheme(theme: string) {
    const api = (window as any).GBReaderPreferences;
    if (api && typeof api.setTheme === 'function') api.setTheme(theme, { source: 'gill-reader-theme' });
    else {
      document.documentElement.classList.toggle('dark', theme === 'dark');
      document.documentElement.setAttribute('data-reader-theme', theme);
    }
    syncGillThemeSegment(theme);
  }
  (window as any).applyGillReaderTheme = applyGillReaderTheme;

  function initGillThemeSync() {
    syncGillThemeSegment();
    document
      .querySelectorAll('.mobile-bottom-bar .gb-theme-toggle, .gbs-theme-corner .gb-theme-toggle')
      .forEach((button) => button.addEventListener('click', () => requestAnimationFrame(() => syncGillThemeSegment())));
    const settingsButton = document.getElementById('mobSettingsBtn');
    if (settingsButton) settingsButton.addEventListener('click', () => requestAnimationFrame(() => syncGillThemeSegment()));
    document.addEventListener('gb:reader-preferences-change', (event: Event) => {
      syncGillThemeSegment((event as CustomEvent).detail?.preferences?.theme || currentGillTheme());
    });
  }

  // Smart auto-hide (owner: "верхняя как-то умно убирается и появляется…
  // если PLAY нажали, то пускай фиксируется"): hides the top bar on
  // scroll-down, reveals on scroll-up, stays pinned while ANY Gill sheet
  // (Part/Series TOC, Learning, Settings) or the inline speed rail is open,
  // or while TTS is playing/paused. This is also the A−/A+ reflow fix: the
  // hide function only ever toggles the bar's own class and NEVER closes a
  // sheet — a font-size change reflowing the article and nudging scrollTop
  // can no longer read as "the settings sheet vanished".
  function initGillMobileTopBarAutoHide() {
    const worldEl = document.querySelector('.gbs2-world[data-gill-v16]');
    const topBar = document.querySelector('.mobile-top-bar[data-gill-mobile-bar]');
    const ember = topBar ? topBar.querySelector('.gb-ember') : null;
    if (!worldEl || !topBar) return;
    const world = worldEl;

    let lastY = window.scrollY || 0;
    let hidden = false;
    let ttsActive = false;
    let ticking = false;

    function hasOpenGillSheet() {
      return Boolean(document.querySelector('.toc-overlay.is-open'));
    }
    function speedRailOpen() {
      return topBar!.classList.contains('speed-open') || Boolean(topBar!.querySelector('.gb-ember-expand.is-open'));
    }
    function canAutoHide() {
      return !hasOpenGillSheet() && !speedRailOpen() && !ttsActive && !topBar!.contains(document.activeElement);
    }
    function apply() {
      world!.classList.toggle('gbs2-tbhidden', hidden && canAutoHide());
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY || 0;
        // v2.8: top bar is transparent/frameless at the very top and gains its
        // frosted background + hairline only once the page is scrolled.
        topBar!.classList.toggle('is-scrolled', y > 4);
        if (!canAutoHide()) {
          hidden = false;
          lastY = y;
          apply();
          ticking = false;
          return;
        }
        const delta = y - lastY;
        if (Math.abs(delta) > 6) {
          hidden = y >= 80 && delta > 0;
          lastY = y;
          apply();
        }
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    // Seed the scrolled state in case the page loads already scrolled (reload
    // mid-article / anchor navigation), so the top bar isn't stuck transparent.
    topBar.classList.toggle('is-scrolled', (window.scrollY || 0) > 4);

    if (ember) {
      const syncTts = () => {
        const st = (ember as HTMLElement).dataset.state;
        const wasActive = ttsActive;
        ttsActive = st === 'playing' || st === 'paused';
        if (ttsActive !== wasActive) apply();
      };
      syncTts();
      new MutationObserver(syncTts).observe(ember, { attributes: true, attributeFilter: ['data-state'] });
    }

    // A sheet or the speed rail opening must re-show the bar immediately,
    // even mid-scroll-down — not just on the next scroll tick.
    document.addEventListener('gb:gill-sheet-open', () => { hidden = false; apply(); });
  }

  function boot() {
    initGillThemeSync();
    initGillMobileTopBarAutoHide();

    const backBtn = document.getElementById('mobBackBtn');
    // B14: DEAD — reader-actions.js capture-handles [data-home-href] (goBack:
    // same-origin history.back(), else the fallback href) before this bubble
    // listener runs. Kept for documentation; extend goBack() there, not here.
    if (backBtn) backBtn.addEventListener('click', () => {
      const href = (backBtn as HTMLElement).dataset.homeHref;
      if (href) window.location.href = href;
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
  else boot();
</script>

<!-- Canonical Gill top: one research entrance, historical Play bloom from #72.
     Speed buttons are generated by the shared floating-cluster controller;
     there is no second TTS/rate owner and no standalone 1× trigger. -->
<style is:global>
@media (max-width:84.999em) {
  [data-gill-v16] .mobile-top-bar .reader-mobile-play-group.mobile-playwrap {
    position:relative;display:flex;align-items:center;justify-content:center;
    width:44px;min-width:44px;flex:0 0 44px;height:44px;overflow:visible;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-play-group .gb-ember-wrap {
    position:relative;display:flex;align-items:center;justify-content:center;
    width:44px;min-width:44px;height:44px;overflow:visible;
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-play-group .reader-mobile-play {
    position:relative;display:grid;place-items:center;
    width:44px;height:44px;min-width:44px;min-height:44px;
    flex:0 0 44px;border:1px solid rgba(108,84,68,.30);border-radius:50%;
    background:color-mix(in srgb,var(--gill-mobile-bar-paper,#fffaf5) 80%,transparent);
    color:var(--gill-mobile-bar-ink,#291f1b);
    box-shadow:0 1px 3px rgba(42,32,27,.055);
  }
  [data-gill-v16] .mobile-top-bar .reader-mobile-play .gb-ember__ring-svg {opacity:1;}
  [data-gill-v16] .mobile-top-bar .reader-mobile-play .gb-ember__ring-track {
    stroke:var(--gill-mobile-bar-gold,#b18b62);opacity:.6;
  }
  [data-gill-v16] .mobile-top-bar .gb-ember-wrap > .gb-ember-speed-echo {
    right:-3px;bottom:-3px;min-width:23px;max-width:32px;height:17px;
    border-radius:10px;font-size:9px;
  }
  [data-gill-v16] .mobile-top-bar .gb-ember-expand {
    box-sizing:border-box;display:flex;flex-direction:column;align-items:center;
    position:absolute;top:calc(100% + 7px);bottom:auto;left:50%;right:auto;
    width:50px;min-width:50px;max-height:calc(100dvh - 75px);overflow-y:auto;overflow-x:hidden;
    padding:6px 2px;gap:1px;
    transform:translateX(-50%) translateX(var(--gb-ember-shift,0px));
    border:1px solid rgba(125,91,70,.25);border-radius:25px;
    background:var(--color-surface,#fcf9f3);
    box-shadow:0 14px 30px rgba(30,21,17,.14);
    -webkit-backdrop-filter:none;backdrop-filter:none;
    clip-path:circle(20px at 50% 0);z-index:2;
  }
  [data-gill-v16] .mobile-top-bar .gb-ember-expand.is-open {
    clip-path:inset(0 0 0 0 round 25px);
  }
  [data-gill-v16] .mobile-top-bar .gb-ember-expand__btn {
    box-sizing:border-box;flex:0 0 44px;width:44px;min-width:44px;
    height:44px;min-height:44px;padding:0;
    font:750 12px/1 "Source Sans 3",system-ui,sans-serif;
    text-shadow:none;box-shadow:none;
  }
  [data-gill-v16] .mobile-top-bar .gb-ember-expand__btn.is-active {
    color:var(--color-accent,#7a2e2e);text-shadow:none;
  }
  [data-gill-v16] .mobile-top-bar .gb-ember-expand__stop {display:none;}
  html.dark [data-gill-v16] .mobile-top-bar .gb-ember-expand {
    background:var(--color-surface,#231c1f);
    border-color:rgba(244,224,199,.23);
    box-shadow:0 15px 35px rgba(0,0,0,.48);
  }
  html.dark [data-gill-v16] .mobile-top-bar .gb-ember-expand__btn.is-active {
    color:#f1cb96;
  }
}
@media (prefers-reduced-motion: reduce) {
  [data-gill-v16] .mobile-top-bar .gb-ember-expand {transition:none;}
}
</style>
