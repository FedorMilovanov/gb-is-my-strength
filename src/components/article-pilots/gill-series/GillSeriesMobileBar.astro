---
/**
 * GillSeriesMobileBar — mobile (<64em) control surface.
 *
 *   TOP bar: back(→«Биографии служителей») → search-this-part input
 *     (filters the current part's TOC by heading text, always visible —
 *     no longer swaps with a speed rail; that swap was confusing and is
 *     gone) → Play (canon .gb-ember; speed is its own canonical bloom
 *     panel, .gb-ember-expand, same as everywhere else in the app) →
 *     Save (binary toggle, no halo).
 *   BOTTOM bar: dual-progress ring (inner=текущая статья %, outer=вся
 *     серия %) → «Сейчас читаете» + текущий раздел (opens the existing
 *     part-TOC sheet — series access stays one tap further via its
 *     #backToSeries arrow, same two-sheet system already live) → theme →
 *     A−/A+ → «Поделиться».
 *
 * data-fc-action="theme"/"play"/"save"/"font-up"/"font-down" and
 * data-action="share" go through the existing global cluster delegation on
 * [data-fc-root] (floating-cluster-controller.js) — only the local TOC
 * search is bar-local script here.
 */
import PlayEmber from '@/components/ui/floating-cluster/PlayEmber.astro';
import SaveButton from '@/components/ui/floating-cluster/SaveButton.astro';
import { GILL_PAGE_DATA, type GillSeriesPageId } from './gillSeriesData';

interface Props {
  pageId: GillSeriesPageId;
}

const { pageId } = Astro.props as Props;
const page = GILL_PAGE_DATA[pageId];
---
<div class="mobile-top-bar" data-fc-root data-fc-variant="gill" data-gill-mobile-bar>
  <button class="gb-icon" id="mobBackBtn" type="button" aria-label="Назад" data-home-href="../../biografii/">
    <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
  </button>
  <label class="mobile-top-search" for="mobTocSearch">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
    <input id="mobTocSearch" type="text" placeholder="Поиск по разделам…" autocomplete="off" />
  </label>
  <span class="mobile-playwrap">
    <PlayEmber audioState="none" class="mobile-top-ember" tip="Озвучка" />
  </span>
  <SaveButton class="gb-icon" tip="Сохранить" />
</div>

<div class="mobile-bottom-bar" data-fc-root data-fc-variant="gill" data-gill-mobile-bar>
  <!-- Progress is a read-only indicator, not a control: it never had a click
       handler (the controller only refreshes its aria-label on scroll), so it
       must not announce as an interactive button. role="img" + live aria-label
       gives screen readers the two progress values without implying an action. -->
  <div class="bar-progress dual-progress" id="gbs2DualProgress" role="img" aria-label="Статья 0%, серия 0%">
    <svg viewBox="0 0 36 36" aria-hidden="true">
      <circle class="bar-series-track" cx="18" cy="18" r="16"></circle>
      <circle class="bar-series-fill" id="gbs2MobSeriesRing" cx="18" cy="18" r="16" stroke-dasharray="100.53" stroke-dashoffset="100.53"></circle>
      <circle class="bar-progress-track" cx="18" cy="18" r="12.5"></circle>
      <circle class="bar-progress-fill" id="gbs2MobArticleRing" cx="18" cy="18" r="12.5" stroke-dasharray="78.54" stroke-dashoffset="78.54"></circle>
    </svg>
    <span class="bar-progress-text" id="gbs2MobPct">0%</span>
  </div>

  <button
    type="button"
    class="mobile-btoc-section"
    id="mobPartTocBtn"
    aria-label={`Открыть оглавление части: ${page.mobileSection}`}
  >
    <span class="mobile-btoc-section__label">Сейчас читаете</span>
    <span class="mobile-btoc-section__main" id="gbs2MobSec">{page.mobileSection}</span>
  </button>

  <span class="mobile-bottom-divider" aria-hidden="true"></span>

  <button class="gb-icon gb-theme-toggle" type="button" data-fc-action="theme" aria-label="Тема">
    <span class="theme-icon-sun"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg></span>
    <span class="theme-icon-moon"><svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg></span>
  </button>

  <button class="mobile-font-btn" type="button" data-fc-action="font-down" aria-label="Уменьшить шрифт">A−</button>
  <button class="mobile-font-btn" type="button" data-fc-action="font-up" aria-label="Увеличить шрифт">A+</button>

  <span class="mobile-bottom-divider" aria-hidden="true"></span>

  <button class="gb-icon" type="button" data-action="share" aria-label="Поделиться">
    <svg viewBox="0 0 24 24"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg>
  </button>
</div>

<script>
  // Локальный поиск по оглавлению ТЕКУЩЕЙ части (референс: 'input' на
  // #tocSearch фильтрует .btoc-link по тексту и открывает панель только
  // когда есть реальный запрос — очистка поля не форсит открытие заново).
  function initGillMobileTocSearch() {
    const input = document.getElementById('mobTocSearch') as HTMLInputElement | null;
    const partBtn = document.getElementById('mobPartTocBtn') as HTMLElement | null;
    const list = document.getElementById('gbs2PartToc') as HTMLElement | null;
    const empty = document.getElementById('gbs2PartTocEmpty') as HTMLElement | null;
    if (!input || !list) return;

    function items(): HTMLElement[] {
      return Array.prototype.slice.call(list!.querySelectorAll('.toc-part-item')) as HTMLElement[];
    }

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      const rows = items();
      let shown = 0;
      rows.forEach((row) => {
        const hit = !q || (row.textContent || '').toLowerCase().indexOf(q) > -1;
        row.hidden = !hit;
        if (hit) shown++;
      });
      if (empty) empty.hidden = shown !== 0 || rows.length === 0;
      if (q && partBtn) partBtn.click();
    });
  }

  function boot() {
    initGillMobileTocSearch();

    const backBtn = document.getElementById('mobBackBtn');
    if (backBtn) backBtn.addEventListener('click', () => {
      const href = (backBtn as HTMLElement).dataset.homeHref;
      if (href) window.location.href = href;
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
  else boot();
</script>
