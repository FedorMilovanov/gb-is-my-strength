---
import SeriesMark from './SeriesMark.astro';
import { GILL_SERIES, type SeriesConfig } from '../_shared/series/seriesConfig';

interface Props {
  pageId: string;
  config?: SeriesConfig;
}

const { pageId, config = GILL_SERIES } = Astro.props;
const seriesItems = config.items.filter((it) => it.tier !== 'satellite');
---
<div class="toc-overlay" id="seriesTocOverlay" aria-hidden="true">
  <div class="toc-sheet" role="dialog" aria-modal="true" aria-label="Содержание серии">
    <button class="toc-sheet__handle" type="button" aria-label="Закрыть"></button>
    <div class="toc-sheet__head">
      <div class="lab">Содержание серии</div>
      <h3>{config.seriesTitleFull}</h3>
    </div>
    <div class="toc-sheet__list">
      {seriesItems.map((item) => {
        const isCurrent = item.id === pageId;
        const href = isCurrent ? '#partTocOverlay' : item.href;
        return (
          <a class:list={['toc-item', isCurrent && 'is-current']} href={href} aria-current={isCurrent ? 'page' : undefined}>
            <SeriesMark kind={item.mark.kind} value={item.mark.value} className="toc-item__num" />
            <div class="toc-item__info">
              <b>{item.title}</b>
              {isCurrent ? (
                <small style="color:var(--gb-accent,#7a2e2e)">Оглавление части · {item.readingTime}</small>
              ) : (
                <small>{item.readingTime}</small>
              )}
            </div>
            <div class="toc-item__chevron"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg></div>
          </a>
        );
      })}
    </div>
  </div>
</div>
