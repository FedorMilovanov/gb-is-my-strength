---
interface Props {
  src: string;
  srcset: string;
  alt: string;
  caption: string;
  width: number;
  height: number;
}

const { src, srcset, alt, caption, width, height } = Astro.props;
---
<figure class="gbs2-hero" id="gbs2Hero">
  <picture>
    <source srcset={srcset} sizes="(max-width: 1023px) 92vw, 760px" type="image/webp" />
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <figcaption class="gbs2-hero-cap"><i aria-hidden="true"></i>{caption}</figcaption>
</figure>
