---
/**
 * GillLearningSheet — mobile (<64em) «Обучение» sheet for the Gill series.
 * Five tabs: Поиск (in-article search) · Термины (real glossary hydration) ·
 * Конспект (partToc level:2 summaries) · Тест (gillLearningData pool,
 * infinite shuffle) · Заметки (window.GBHighlights.getAll()).
 *
 * Reuses the canonical .toc-overlay/.toc-sheet shell (same as
 * GillPartTocOverlay/GillSeriesOverlay) so it inherits open/close, backdrop,
 * handle, focus-trap and scroll-lock from initTocPopups() in
 * floating-cluster-controller.js — this file only owns tab-panel content.
 */
import { GILL_LEARNING_QUIZ } from './gillLearningData';
import { GILL_SERIES, type SeriesConfig } from '../_shared/series/seriesConfig';

interface Props {
  pageId: string;
  config?: SeriesConfig;
}

const { pageId, config = GILL_SERIES } = Astro.props as Props;
const page = config.pages[pageId];
// «Обучение · Часть III» context label, reusing the same part naming the
// bottom bar and Part TOC already show — matches the reference's inline
// part-context header instead of a generic static title.
const partTag = page.partLabel.split('·')[0].trim();
const outline = page.partToc.filter((item) => item.level === 2 && item.summary);
const seriesPool = config.quiz ?? GILL_LEARNING_QUIZ;
const quizPool = seriesPool.filter((q) => !q.relatedPageId || q.relatedPageId === pageId);
// Fall back to the full pool on thinner pages so the quiz tab is never empty.
const quizItems = quizPool.length >= 4 ? quizPool : seriesPool;
const hasQuiz = quizItems.length > 0;
---
<div id="gillLearningOverlay" class="toc-overlay gill-learning-overlay" data-gill-overlay="learning" aria-hidden="true">
  <section class="toc-sheet gill-learning-sheet" role="dialog" aria-modal="true" aria-labelledby="gillLearningTitle">
    <button type="button" class="toc-sheet__handle" data-overlay-close aria-label="Закрыть обучение"></button>
    <div class="toc-sheet__head">
      <div class="head-copy"><div class="lab">Справка · {partTag}</div><h3 id="gillLearningTitle">Разобраться и запомнить</h3></div>
      <button type="button" class="gb-icon" data-overlay-close aria-label="Закрыть"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
    </div>

    <div class="gill-tabs" role="tablist" aria-label="Инструменты обучения">
      <button type="button" class="gill-tab" id="tabTerms" role="tab" aria-selected="true" aria-controls="panelTerms" data-tab="terms">Термины</button>
      <button type="button" class="gill-tab" id="tabOutline" role="tab" aria-selected="false" aria-controls="panelOutline" data-tab="outline" tabindex="-1">Конспект</button>
      {hasQuiz && <button type="button" class="gill-tab" id="tabQuiz" role="tab" aria-selected="false" aria-controls="panelQuiz" data-tab="quiz" tabindex="-1">Тест</button>}
      <button type="button" class="gill-tab" id="tabNotes" role="tab" aria-selected="false" aria-controls="panelNotes" data-tab="notes" tabindex="-1">Заметки</button>
      <span class="gill-tabs__sep" aria-hidden="true"></span>
      <button type="button" class="gill-tab gill-tab--icon" id="tabSearch" role="tab" aria-selected="false" aria-controls="panelSearch" data-tab="search" tabindex="-1" aria-label="Поиск по разделу">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
      </button>
    </div>

    <div class="toc-sheet__body">
      <section class="gill-panel" id="panelSearch" role="tabpanel" aria-labelledby="tabSearch" data-panel="search" hidden>
        <label class="gill-searchbox">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
          <input id="learningSearchInput" type="search" placeholder="Найти в этой статье" autocomplete="off" />
        </label>
        <div class="gill-search-status" id="learningSearchStatus" aria-live="polite">Введите минимум 2 символа</div>
        <div class="gill-search-results" id="learningSearchResults"></div>
        <button type="button" class="gill-global-search" id="globalSearchBtn">Искать по всему сайту</button>
      </section>

      <section class="gill-panel" id="panelTerms" role="tabpanel" aria-labelledby="tabTerms" data-panel="terms">
        <div id="termsList"></div>
      </section>

      <section class="gill-panel" id="panelOutline" role="tabpanel" aria-labelledby="tabOutline" data-panel="outline" hidden>
        <div id="outlineList">
          {outline.length ? outline.map((item) => (
            <a href={item.href} class="outline-card" data-outline-link>
              <span class="outline-card__num" aria-hidden="true">§</span>
              <span>
                <strong>{item.label.replace(/^[IVXLCDM]+\.\s*/, '')}</strong>
                <small>{item.summary}</small>
              </span>
            </a>
          )) : <div class="empty-state">Конспект появится, когда в разделе будет структура.</div>}
        </div>
      </section>

      <section class="gill-panel" id="panelQuiz" role="tabpanel" aria-labelledby="tabQuiz" data-panel="quiz" hidden>
        <div class="quiz-meta"><span class="quiz-category" id="glsQuizCategory"></span><span id="glsQuizStreak"></span></div>
        <!-- Метр калибровки (CBM): насколько уверенность совпадает со знанием.
             Виден только после первого ответа (seen>0). -->
        <div class="quiz-calib" id="glsQuizCalib" hidden title="Совпадение уверенности с результатом">
          <span class="quiz-calib__lbl">Калибровка</span>
          <span class="quiz-calib__bar"><i id="glsQuizCalibFill"></i></span>
          <span class="quiz-calib__pct" id="glsQuizCalibPct"></span>
        </div>
        <h4 class="quiz-question" id="glsQuizQuestion"></h4>
        <div class="quiz-options" id="glsQuizOptions"></div>
        <!-- Certainty-Based Marking: сначала оцени уверенность → это разблокирует
             варианты. Строится в JS (renderQuiz). -->
        <div class="quiz-conf" id="glsQuizConf">
          <span class="quiz-conf__q">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-9 9M12 3a9 9 0 0 1 9 9" /><path d="M12 12l4-3" /></svg>
            Насколько уверены?
          </span>
          <div class="quiz-conf__row" id="glsQuizConfRow"></div>
        </div>
        <div class="quiz-verdict" id="glsQuizVerdict" hidden></div>
        <div class="quiz-explanation" id="glsQuizExplanation" hidden></div>
        <a class="quiz-source" id="glsQuizSource" href="#" hidden></a>
        <button type="button" class="quiz-next" id="glsQuizNext">Следующий вопрос</button>
        <div id="glsQuizLive" class="sr-only" aria-live="polite"></div>
        <div id="gillQuizData" data-quiz={JSON.stringify(quizItems)} hidden></div>
      </section>

      <section class="gill-panel" id="panelNotes" role="tabpanel" aria-labelledby="tabNotes" data-panel="notes" hidden>
        <div id="notesList"></div>
        <button type="button" class="gill-global-search" id="manageNotesBtn">Управлять заметками</button>
      </section>
    </div>
  </section>
</div>

<script>
  type GillLearningQuizItem = {
    id: string;
    category: string;
    question: string;
    answers: [string, string, string, string];
    correctIndex: 0 | 1 | 2 | 3;
    explanation: string;
    sourceHref: string;
    sourceLabel: string;
  };

  const CATEGORY_LABEL: Record<string, string> = {
    people: 'Люди', dates: 'Даты', places: 'Места', works: 'Труды',
    theology: 'Богословие', method: 'Метод', sources: 'Источники',
  };

  function initGillLearningSheet() {
    const overlay = document.getElementById('gillLearningOverlay');
    if (!overlay) return;

    // ---- Tabs (roving tabindex, ArrowLeft/Right/Home/End) ----
    const tabs = Array.prototype.slice.call(overlay.querySelectorAll('.gill-tab')) as HTMLElement[];
    function activateTab(tab: HTMLElement, focus: boolean) {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') || '');
        if (panel) (panel as HTMLElement).hidden = !on;
      });
      if (focus) tab.focus();
      tab.scrollIntoView({ inline: 'center', block: 'nearest' });
      // Build panes on activation (click OR keyboard), not on a click listener —
      // otherwise keyboard/arrow activation leaves the pane empty. Rebuild notes
      // every time so freshly-saved highlights show up.
      if (tab.dataset.tab === 'terms') buildTerms();
      if (tab.dataset.tab === 'notes') buildNotes();
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(tab, false));
      tab.addEventListener('keydown', (e) => {
        let next: HTMLElement | null = null;
        if (e.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];
        else if (e.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
        else if (e.key === 'Home') next = tabs[0];
        else if (e.key === 'End') next = tabs[tabs.length - 1];
        if (next) { e.preventDefault(); activateTab(next, true); }
      });
    });

    // ---- Поиск: index the real article body, DOM-built highlight (no innerHTML) ----
    const article = document.querySelector('[data-pagefind-body]') as HTMLElement | null;
    type SearchRecord = { el: HTMLElement; heading: string; text: string };
    const searchRecords: SearchRecord[] = [];
    if (article) {
      const nodes = Array.prototype.slice.call(article.querySelectorAll('h2, h3, p, blockquote, li')) as HTMLElement[];
      nodes.forEach((el, index) => {
        // Skip chrome/quiz/source-tooltip noise that sometimes lives inside the body wrapper.
        if (el.closest('.gbs2-toc, [data-fc-root], [data-fc-controls], #quizPlaceholder, .fn-marker, .source-tooltip')) return;
        if (!el.id) el.id = 'gill-search-p-' + String(index + 1).padStart(3, '0');
        let heading = '';
        let prev: Element | null = el;
        while (prev && !heading) {
          prev = prev.previousElementSibling;
          if (prev && /^H[23]$/.test(prev.tagName)) heading = (prev.textContent || '').trim();
        }
        if (/^H[23]$/.test(el.tagName)) heading = (el.textContent || '').trim();
        const text = (el.textContent || '').replace(/\s+/g, ' ').trim();
        if (text.length < 8) return;
        searchRecords.push({ el, heading: heading || 'Текст статьи', text });
      });
    }

    function appendHighlighted(parent: HTMLElement, text: string, query: string) {
      const q = query.toLocaleLowerCase('ru');
      const lower = text.toLocaleLowerCase('ru');
      let at = 0, found;
      while ((found = lower.indexOf(q, at)) !== -1) {
        if (found > at) parent.append(document.createTextNode(text.slice(at, found)));
        const mark = document.createElement('mark');
        mark.textContent = text.slice(found, found + query.length);
        parent.append(mark);
        at = found + query.length;
      }
      if (at < text.length) parent.append(document.createTextNode(text.slice(at)));
    }

    function jumpTo(href: string) {
      closeSheet();
      const el = document.querySelector(href);
      if (!el) return;
      (el as HTMLElement).scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'center',
      });
      el.classList.add('is-search-target');
      setTimeout(() => el.classList.remove('is-search-target'), 1600);
    }

    function closeSheet() {
      const closeBtn = overlay!.querySelector('[data-overlay-close]') as HTMLElement | null;
      if (closeBtn) closeBtn.click();
    }

    const searchInput = document.getElementById('learningSearchInput') as HTMLInputElement | null;
    const searchStatus = document.getElementById('learningSearchStatus');
    const searchResults = document.getElementById('learningSearchResults');
    let searchTimer = 0;
    function renderSearch(query: string) {
      if (!searchStatus || !searchResults) return;
      searchResults.replaceChildren();
      if (query.length < 2) { searchStatus.textContent = 'Введите минимум 2 символа'; return; }
      const q = query.toLocaleLowerCase('ru');
      const found = searchRecords.filter((r) => r.text.toLocaleLowerCase('ru').includes(q)).slice(0, 20);
      searchStatus.textContent = found.length ? 'Найдено: ' + found.length : 'Ничего не найдено';
      found.forEach((record) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'gill-search-result';
        const strong = document.createElement('strong');
        strong.textContent = record.heading;
        const span = document.createElement('span');
        const pos = record.text.toLocaleLowerCase('ru').indexOf(q);
        const start = Math.max(0, pos - 45);
        const snippet = record.text.slice(start, start + 150);
        appendHighlighted(span, (start ? '…' : '') + snippet + (start + 150 < record.text.length ? '…' : ''), query);
        b.append(strong, span);
        b.addEventListener('click', () => jumpTo('#' + record.el.id));
        searchResults.appendChild(b);
      });
    }
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimer);
        const query = (e.target as HTMLInputElement).value.trim();
        searchTimer = window.setTimeout(() => renderSearch(query), 120);
      });
    }
    const globalSearchBtn = document.getElementById('globalSearchBtn');
    if (globalSearchBtn) {
      globalSearchBtn.addEventListener('click', () => {
        closeSheet();
        if ((window as any).GBSearch && (window as any).GBSearch.open) (window as any).GBSearch.open();
        else window.dispatchEvent(new CustomEvent('gb:openSearch'));
      });
    }

    // ---- Термины: hydrate from the real glossary runtime, dedupe by term ----
    let termsBuilt = false;
    function buildTerms() {
      if (termsBuilt) return;
      termsBuilt = true;
      const list = document.getElementById('termsList');
      if (!list || !article) return;
      const hydrate = (window as any).SiteUtils && (window as any).SiteUtils.hydrateGlossaryTerms;
      const render = () => {
        const seen = new Set<string>();
        const terms = Array.prototype.slice.call(article.querySelectorAll('.gterm[data-term]')) as HTMLElement[];
        terms.forEach((el) => {
          const term = el.dataset.term || (el.textContent || '').trim();
          const key = term.trim().toLocaleLowerCase('ru');
          if (!key || seen.has(key)) return;
          seen.add(key);
          const brief = el.querySelector('.gtip-brief');
          const detail = el.querySelector('.gtip-detail');
          const definition = (brief && brief.textContent) || (detail && detail.textContent) || el.getAttribute('data-definition') || 'Определение раскрывается в тексте статьи.';
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'term-card';
          b.setAttribute('aria-expanded', 'false');
          const head = document.createElement('span');
          head.className = 'term-card__head';
          head.textContent = term;
          const hint = document.createElement('span');
          hint.className = 'term-card__hint';
          hint.textContent = 'коснись, чтобы раскрыть определение';
          const def = document.createElement('span');
          def.className = 'term-card__definition';
          def.textContent = definition.trim();
          b.append(head, hint, def);
          b.addEventListener('click', () => {
            const open = b.getAttribute('aria-expanded') === 'true';
            list.querySelectorAll('.term-card').forEach((x) => x.setAttribute('aria-expanded', 'false'));
            b.setAttribute('aria-expanded', open ? 'false' : 'true');
          });
          list.appendChild(b);
        });
        if (!seen.size) {
          const empty = document.createElement('div');
          empty.className = 'empty-state';
          empty.textContent = 'В этой статье пока нет терминов.';
          list.appendChild(empty);
        }
      };
      if (hydrate) hydrate(article).then(render).catch(render);
      else render();
    }

    // ---- Тест: infinite shuffle over the JSON pool embedded above ----
    const quizDataEl = document.getElementById('gillQuizData');
    let quizPool: GillLearningQuizItem[] = [];
    try { quizPool = quizDataEl ? JSON.parse(quizDataEl.getAttribute('data-quiz') || '[]') : []; } catch (_) { quizPool = []; }
    let quizOrder: number[] = [];
    let quizIndex = 0;
    let quizStreak = 0;
    let quizSeen = 0;
    let quizBest = 0;
    // Streak label mirrors the v2.9 reference: never a bare "Серия: 0" —
    // stay quiet until there's a run or progress worth showing.
    function updateQuizStreak() {
      const el = document.getElementById('glsQuizStreak');
      if (!el) return;
      el.textContent = quizStreak >= 2
        ? '🔥 ' + quizStreak + ' подряд'
        : quizSeen
          ? 'Пройдено: ' + quizSeen + (quizBest > 1 ? ' · рекорд ' + quizBest : '')
          : '';
    }
    // ---- Certainty-Based Marking (CBM) ----
    // Confidence chosen BEFORE the answer; calibration = how often confidence
    // matched the outcome (only an "honest" match counts). v2.9 reference.
    let quizConf: string | null = null;
    let quizCalScore = 0;
    const CONF: Array<{ k: string; t: string; d: number }> = [
      { k: 'sure', t: 'Точно знаю', d: 3 },
      { k: 'guess', t: 'Кажется', d: 2 },
      { k: 'random', t: 'Наугад', d: 1 },
    ];
    function updateQuizCalib() {
      const wrap = document.getElementById('glsQuizCalib') as HTMLElement | null;
      const fill = document.getElementById('glsQuizCalibFill') as HTMLElement | null;
      const pct = document.getElementById('glsQuizCalibPct');
      if (!wrap) return;
      if (!quizSeen) { wrap.hidden = true; return; }
      const val = Math.round((quizCalScore / quizSeen) * 100);
      wrap.hidden = false;
      if (fill) { fill.style.width = val + '%'; fill.className = val >= 70 ? 'is-hi' : val >= 40 ? 'is-mid' : 'is-lo'; }
      if (pct) pct.textContent = val + '%';
    }
    function shuffle<T>(values: T[]): T[] {
      const a = values.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }
    function resetQuizOrder() {
      const order = shuffle(quizPool.map((_, i) => i));
      // Don't let last cycle's final question reappear first.
      if (order.length > 1 && quizOrder.length && order[0] === quizOrder[quizOrder.length - 1]) {
        [order[0], order[1]] = [order[1], order[0]];
      }
      quizOrder = order;
      quizIndex = 0;
    }
    function renderQuiz() {
      if (!quizPool.length) {
        const q = document.getElementById('panelQuiz');
        if (q) q.innerHTML = '<div class="empty-state">Вопросы появятся позже.</div>';
        return;
      }
      if (!quizOrder.length || quizIndex >= quizOrder.length) resetQuizOrder();
      const item = quizPool[quizOrder[quizIndex]];
      quizConf = null;
      const catEl = document.getElementById('glsQuizCategory');
      const qEl = document.getElementById('glsQuizQuestion');
      if (catEl) catEl.textContent = CATEGORY_LABEL[item.category] || item.category;
      updateQuizStreak();
      updateQuizCalib();
      if (qEl) qEl.textContent = item.question;
      const optionsEl = document.getElementById('glsQuizOptions');
      const explEl = document.getElementById('glsQuizExplanation') as HTMLElement | null;
      const sourceEl = document.getElementById('glsQuizSource') as HTMLAnchorElement | null;
      const nextEl = document.getElementById('glsQuizNext');
      const verdictEl = document.getElementById('glsQuizVerdict') as HTMLElement | null;
      const confEl = document.getElementById('glsQuizConf') as HTMLElement | null;
      const confRow = document.getElementById('glsQuizConfRow');
      if (optionsEl) optionsEl.replaceChildren();
      if (explEl) explEl.hidden = true;
      if (verdictEl) { verdictEl.hidden = true; verdictEl.className = 'quiz-verdict'; verdictEl.textContent = ''; }
      if (sourceEl) sourceEl.hidden = true;
      if (nextEl) nextEl.classList.remove('is-visible');
      if (confEl) confEl.hidden = false;
      // Options render DISABLED — a confidence pick unlocks them.
      const order = shuffle(item.answers.map((text, index) => ({ text, index })));
      order.forEach((answer) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'quiz-option';
        b.textContent = answer.text;
        b.disabled = true;
        b.addEventListener('click', () => { if (quizConf) answerQuiz(b, answer.index, item); });
        if (optionsEl) optionsEl.appendChild(b);
      });
      // Confidence buttons (Точно знаю / Кажется / Наугад).
      if (confRow) {
        confRow.replaceChildren();
        CONF.forEach((c) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'quiz-conf__btn';
          b.setAttribute('data-conf', c.k);
          const lbl = document.createElement('span');
          lbl.textContent = c.t;
          const dots = document.createElement('span');
          dots.className = 'quiz-conf__dots';
          for (let d = 0; d < 3; d++) { const i = document.createElement('i'); if (d < c.d) i.className = 'on'; dots.appendChild(i); }
          b.append(lbl, dots);
          b.addEventListener('click', () => pickConf(c.k));
          confRow.appendChild(b);
        });
      }
    }
    function pickConf(k: string) {
      if (quizConf) return;
      quizConf = k;
      const confRow = document.getElementById('glsQuizConfRow');
      if (confRow) confRow.querySelectorAll('.quiz-conf__btn').forEach((b) => {
        (b as HTMLButtonElement).disabled = true;
        b.classList.toggle('is-picked', b.getAttribute('data-conf') === k);
      });
      document.querySelectorAll('#glsQuizOptions .quiz-option').forEach((b) => { (b as HTMLButtonElement).disabled = false; });
    }
    function answerQuiz(button: HTMLElement, index: number, item: GillLearningQuizItem) {
      const buttons = Array.prototype.slice.call(document.querySelectorAll('#glsQuizOptions .quiz-option')) as HTMLButtonElement[];
      buttons.forEach((b) => { b.disabled = true; });
      const correct = index === item.correctIndex;
      button.classList.add(correct ? 'is-correct' : 'is-wrong');
      const liveEl = document.getElementById('glsQuizLive');
      quizSeen++;
      if (correct) {
        quizStreak++;
        if (quizStreak > quizBest) quizBest = quizStreak;
        if (liveEl) liveEl.textContent = 'Верно';
      } else {
        quizStreak = 0;
        const correctText = item.answers[item.correctIndex];
        const correctBtn = buttons.find((b) => b.textContent === correctText);
        if (correctBtn) correctBtn.classList.add('is-correct');
        if (liveEl) liveEl.textContent = 'Неверно. ' + item.explanation;
      }
      // Calibration verdict (3 honest grades) — tone matches meaning:
      //  good    — confidence matched knowledge (sure+right, doubtful+wrong)
      //  warn    — confident error (overrated): most important to revisit
      //  neutral — lucky guess (random+right): no alarm, but reinforce.
      let tone: string, msg: string;
      if (correct) {
        if (quizConf === 'sure') { tone = 'good'; msg = 'Верно — и вы были уверены. Точная калибровка.'; }
        else if (quizConf === 'guess') { tone = 'good'; msg = 'Верно, хотя сомневались — знаете лучше, чем думали.'; }
        else { tone = 'neutral'; msg = 'Верно, хоть и наугад. Закрепите, чтобы знать уверенно.'; }
      } else {
        if (quizConf === 'sure') { tone = 'warn'; msg = 'Неверно — а уверенность была высокой. Такие «уверенные ошибки» важнее всего пересмотреть.'; }
        else { tone = 'good'; msg = 'Неверно — и вы это чувствовали. Честная оценка своих знаний.'; }
      }
      if (tone === 'good') quizCalScore++; // калибровка засчитывается только за точное совпадение
      const confEl = document.getElementById('glsQuizConf') as HTMLElement | null;
      if (confEl) confEl.hidden = true;
      const verdictEl = document.getElementById('glsQuizVerdict') as HTMLElement | null;
      if (verdictEl) { verdictEl.className = 'quiz-verdict is-' + tone; verdictEl.textContent = msg; verdictEl.hidden = false; }
      // v2.8 elaborative interrogation: the "why it matters" note shows on
      // EVERY answer (correct too), not only on wrong ones.
      const explEl = document.getElementById('glsQuizExplanation');
      if (explEl) { explEl.textContent = item.explanation; explEl.hidden = false; }
      updateQuizStreak();
      updateQuizCalib();
      const sourceEl = document.getElementById('glsQuizSource') as HTMLAnchorElement | null;
      if (sourceEl && item.sourceHref) {
        sourceEl.href = item.sourceHref;
        sourceEl.textContent = 'Перечитать: ' + item.sourceLabel;
        sourceEl.hidden = false;
      }
      const nextEl = document.getElementById('glsQuizNext');
      if (nextEl) nextEl.classList.add('is-visible');
    }
    const quizNextBtn = document.getElementById('glsQuizNext');
    if (quizNextBtn) quizNextBtn.addEventListener('click', () => { quizIndex++; renderQuiz(); });
    if (quizPool.length) renderQuiz();

    // ---- Заметки: read-only view of the canonical highlights store ----
    function buildNotes() {
      const list = document.getElementById('notesList');
      if (!list) return;
      list.replaceChildren();
      const store = (window as any).GBHighlights;
      const notes: Array<{ text: string; articleTitle: string; url: string; savedAt: number | string }> =
        store && typeof store.getAll === 'function' ? store.getAll() : [];
      if (!notes.length) {
        const empty = document.createElement('div');
        empty.className = 'empty-state';
        empty.textContent = 'Сохранённых заметок пока нет.';
        list.appendChild(empty);
        return;
      }
      notes.slice(0, 20).forEach((note) => {
        const card = document.createElement('article');
        card.className = 'note-card';
        const q = document.createElement('blockquote');
        q.textContent = note.text;
        const meta = document.createElement('div');
        meta.className = 'note-meta';
        const date = new Date(Number(note.savedAt) || Date.now());
        meta.textContent = note.articleTitle + ' · ' + date.toLocaleDateString('ru-RU');
        const actions = document.createElement('div');
        actions.className = 'note-actions';
        const open = document.createElement('button');
        open.type = 'button';
        open.textContent = 'Открыть место';
        open.addEventListener('click', () => { closeSheet(); window.location.href = note.url; });
        actions.appendChild(open);
        card.append(q, meta, actions);
        list.appendChild(card);
      });
    }
    const manageNotesBtn = document.getElementById('manageNotesBtn');
    if (manageNotesBtn) {
      manageNotesBtn.addEventListener('click', () => {
        closeSheet();
        const hl = (window as any).GBHighlights;
        if (hl && typeof hl.open === 'function') hl.open();
      });
    }

    // Outline cards close the sheet and jump like search results.
    overlay.querySelectorAll('[data-outline-link]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        jumpTo((a as HTMLAnchorElement).getAttribute('href') || '');
      });
    });

    // Термины is the default pane (v2.6), but buildTerms() depends on glossary
    // hydration (SiteUtils.hydrateGlossaryTerms), which isn't ready at page-init —
    // building then renders empty AND trips the `termsBuilt` guard so it never
    // recovers. Build on the first sheet OPEN instead (hydration ready by then).
    const buildTermsOnOpen = new MutationObserver(() => {
      if (overlay.classList.contains('is-open') || overlay.getAttribute('aria-hidden') === 'false') buildTerms();
    });
    buildTermsOnOpen.observe(overlay, { attributes: true, attributeFilter: ['class', 'aria-hidden'] });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initGillLearningSheet, { once: true });
  else initGillLearningSheet();
</script>
