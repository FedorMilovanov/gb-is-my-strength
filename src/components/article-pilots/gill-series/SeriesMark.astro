---
import RomanNumeral from '@/components/ui/floating-cluster/RomanNumeral.astro';

interface Props {
  kind: 'label' | 'roman' | 'letter';
  value: string;
  className?: string;
}

const { kind, value, className = '' } = Astro.props;
const classes = ['gb-series-mark', kind === 'label' ? 'gb-series-mark--label' : '', className]
  .filter(Boolean)
  .join(' ');
---
{kind === 'roman' ? (
  <RomanNumeral value={value} className={classes} />
) : (
  <span class={classes}>{value}</span>
)}
