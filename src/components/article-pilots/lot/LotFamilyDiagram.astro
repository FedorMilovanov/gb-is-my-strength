      <text x="180" y="60" text-anchor="middle" class="lot-family__meta">Быт. 11:27 · отец Аврама, Нахора и Арана</text>
    </g>

    <g transform="translate(36,136)">
      <rect width="388" height="82" rx="12" class="lot-family__card lot-family__card--altar" />
      <text x="194" y="34" text-anchor="middle" class="lot-family__name">Аврам / Авраам</text>
      <text x="194" y="62" text-anchor="middle" class="lot-family__meta">Завет, алтарь и ходатайство · Быт. 13; 18</text>
    </g>

    <g transform="translate(536,136)">
      <rect width="388" height="82" rx="12" class="lot-family__card" />
      <text x="194" y="34" text-anchor="middle" class="lot-family__name">Аран</text>
      <text x="194" y="62" text-anchor="middle" class="lot-family__meta">Умер прежде отца в Уре · Быт. 11:28</text>
    </g>

