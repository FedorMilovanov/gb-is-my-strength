      <path d="M 480 118 H 730 V 136" />
      <path d="M 730 218 V 242 H 605 V 264" />
      <line x1="710" y1="308" x2="736" y2="308" stroke-dasharray="4 4" />
      <path d="M 605 352 V 376 H 526 V 404" stroke="#8c2f25" stroke-dasharray="5 4" />
      <path d="M 605 376 H 806 V 404" stroke="#8c2f25" stroke-dasharray="5 4" />
      <line x1="526" y1="476" x2="526" y2="500" stroke="#8c2f25" />
      <line x1="806" y1="476" x2="806" y2="500" stroke="#8c2f25" />
    </g>

    <g transform="translate(300,20)">
