      <text x="105" y="30" text-anchor="middle" class="lot-family__name">Лот</text>
      <text x="105" y="55" text-anchor="middle" class="lot-family__meta">Праведный, но пленный</text>
      <text x="105" y="75" text-anchor="middle" class="lot-family__meta">выбором · 2 Пет. 2:7</text>
    </g>

    <g transform="translate(736,264)">
      <rect width="204" height="88" rx="12" class="lot-family__card lot-family__card--warn" />
      <text x="102" y="30" text-anchor="middle" class="lot-family__name">Жена Лота</text>
      <text x="102" y="55" text-anchor="middle" class="lot-family__meta">Оглянулась назад</text>
      <text x="102" y="75" text-anchor="middle" class="lot-family__meta">Быт. 19:26 · Лк. 17:32</text>
    </g>

    <text x="666" y="394" text-anchor="middle" class="lot-family__branch-note">Пещера после Сигора · Быт. 19:30–38</text>

    <g transform="translate(396,404)">
      <rect width="260" height="72" rx="12" class="lot-family__card" />
      <text x="130" y="30" text-anchor="middle" class="lot-family__name">Старшая дочь</text>
      <text x="130" y="55" text-anchor="middle" class="lot-family__meta">Родила сына Моава · Быт. 19:37</text>
    </g>

    <g transform="translate(676,404)">
      <rect width="260" height="72" rx="12" class="lot-family__card" />
      <text x="130" y="30" text-anchor="middle" class="lot-family__name">Младшая дочь</text>
      <text x="130" y="55" text-anchor="middle" class="lot-family__meta">Родила Бен-Амми · Быт. 19:38</text>
    </g>

    <g transform="translate(396,500)">
      <rect width="260" height="78" rx="12" class="lot-family__card lot-family__card--warn" />
      <text x="130" y="26" text-anchor="middle" class="lot-family__name">Моавитяне</text>
      <text x="130" y="48" text-anchor="middle" class="lot-family__meta">Вражда · но из Моава Руфь</text>
      <text x="130" y="67" text-anchor="middle" class="lot-family__meta">Быт. 19:37; Руфь 4:13–22</text>
    </g>

    <g transform="translate(676,500)">
      <rect width="260" height="78" rx="12" class="lot-family__card lot-family__card--warn" />
      <text x="130" y="26" text-anchor="middle" class="lot-family__name">Аммонитяне</text>
      <text x="130" y="48" text-anchor="middle" class="lot-family__meta">Соседи и противники Израиля</text>
      <text x="130" y="67" text-anchor="middle" class="lot-family__meta">Быт. 19:38; Втор. 2:19</text>
    </g>

    <g transform="translate(36,404)">
      <rect width="336" height="140" rx="12" class="lot-family__note-box" />
      <text x="18" y="30" class="lot-family__note-title">Парадокс благодати</text>
      <text x="18" y="56" class="lot-family__meta">Линия греха и страха не отменяет</text>
      <text x="18" y="78" class="lot-family__meta">Божьего замысла: моавитянка Руфь</text>
      <text x="18" y="100" class="lot-family__meta">войдёт в родословную Давида и Христа</text>
      <text x="18" y="122" class="lot-family__meta">(Мф. 1:5).</text>
    </g>
  </svg>
</figure>

