---
import ReaderPreferencesHead from '@/components/reader-platform/ReaderPreferencesHead.astro';
import { LOT_QUIZ_QUESTIONS } from './lotQuiz';

const canonical = 'https://gospod-bog.ru/articles/lot-i-sodom/';
const title = 'Лот: праведник у ворот Содома';
const description = 'Бытие 13–19 без морализаторского упрощения: выбор Лота, Содом, суд и милость, 2 Петра 2, жена Лота, Моав и Аммон, Руфь, география и границы археологических доказательств.';
const publishedTime = '2026-08-09T00:00:00+03:00';
const readingTime = 28;
const ogImage = 'https://gospod-bog.ru/images/og-preview-1200x630.webp';

const quizQuestions = LOT_QUIZ_QUESTIONS.map((item) => ({
  id: item.id,
  type: item.type,
  category: item.category,
  difficulty: item.difficulty,
  question: item.q,
  options: item.options,
  explanation: item.explanation,
  correct: item.answer,
  sourceRef: item.sourceRef,
}));

const siteConfig = {
  version: 1778943682,
  site: {
    id: 'gb-strength',
    name: 'Господь Бог — Сила Моя',
    baseUrl: 'https://gospod-bog.ru',
    locale: 'ru-RU',
    themeStorageKey: 'theme',
    debug: false,
  },
  page: {
    type: 'article',
    id: 'lot-i-sodom',
    title,
    section: 'Экзегеза',
    readingTime,
  },
  features: {
    themeToggle: { enabled: true },
    share: { enabled: true },
    backToTop: { enabled: true, showAfter: 400 },
    readingProgress: { enabled: true },
    toc: { enabled: true, mobile: true, desktop: true },
    footnotes: { enabled: true },
    timeline: { enabled: false },
    flipCards: { enabled: false },
    quiz: { enabled: true },
    bookmarks: {
      enabled: true,
      articleSelector: 'article',
      headingSelector: 'h2[id], h3[id]',
      minScrollToSave: 320,
      minProgressToSave: 6,
      maxProgressToSave: 96,
      completedAtProgress: 97,
      minTimeOnPage: 10000,
      scrollThrottle: 600,
      periodicSaveInterval: 15000,
      maxAgeDays: 14,
      cleanupAgeDays: 45,
      cleanupIntervalHours: 24,
      promptDelay: 900,
      promptAutoHide: 12000,
      showPrompt: true,
      dismissForSession: true,
      respectHashNavigation: true,
      minDocumentHeightRatio: 2,
    },
    homepageResume: { enabled: false },
    headingAnchors: { enabled: true },
  },
  selectors: {
    headings: 'article h2[id], article h3[id]',
  },
  quiz: {
    questions: quizQuestions,
    scores: [
      { min: 7, title: 'Внимательный экзегет', badge: '📖', desc: 'Вы удержали вместе текст Бытия, каноническую оценку Лота и границы исторических доказательств.' },
      { min: 5, title: 'Хороший читатель', badge: '🔎', desc: 'Главная линия усвоена; несколько деталей стоит перепроверить по разделам статьи.' },
      { min: 3, title: 'Нужно перечитать', badge: '🧭', desc: 'Вернитесь к разделам о выборе Лота, 2 Петра и археологических границах.' },
      { min: 0, title: 'Начало пути', badge: '📜', desc: 'Пройдите статью ещё раз, сверяя выводы с самим текстом Писания.' },
    ],
    bonusQuestions: [],
    bonusScores: [],
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://gospod-bog.ru/#organization',
      name: 'Господь Бог — Сила Моя',
      url: 'https://gospod-bog.ru/',
      logo: { '@type': 'ImageObject', url: 'https://gospod-bog.ru/icons/icon-512.png', width: 512, height: 512 },
    },
    {
      '@type': 'Article',
      '@id': `${canonical}#article`,
      headline: title,
      description,
      url: canonical,
      datePublished: publishedTime,
      dateModified: publishedTime,
      inLanguage: 'ru',
      author: { '@type': 'Person', '@id': 'https://gospod-bog.ru/about/#person', name: 'Фёдор Милованов', url: 'https://gospod-bog.ru/about/' },
      editor: { '@id': 'https://gospod-bog.ru/about/#person' },
      publisher: { '@id': 'https://gospod-bog.ru/#organization' },
      image: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      articleSection: 'Экзегеза',
      keywords: ['Лот', 'Содом', 'Бытие 13', 'Бытие 19', '2 Петра 2', 'Моав', 'Аммон', 'Руфь', 'археология Библии'],
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.article-lead', '.summary-card', '[data-speakable]'] },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://gospod-bog.ru/' },
        { '@type': 'ListItem', position: 2, name: 'Статьи', item: 'https://gospod-bog.ru/articles/' },
        { '@type': 'ListItem', position: 3, name: title, item: canonical },
      ],
    },
  ],
};
---

<meta charset="utf-8" />
<link rel="preconnect" href="https://mc.yandex.ru" crossorigin />
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com https://cdn.jsdelivr.net; img-src 'self' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com wss://mc.yandex.ru wss://*.yandex.ru wss://mc.yandex.com wss://*.yandex.com https://huggingface.co https://*.aws.cdn.hf.co https://cdn.jsdelivr.net; frame-src 'self' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self';" />
<ReaderPreferencesHead />
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
<meta http-equiv="Content-Language" content="ru" />

<title>{title} | Господь Бог — Сила Моя</title>
<meta name="description" content={description} />
<meta name="author" content="Фёдор Милованов" />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="keywords" content="Лот, Содом, Бытие 13, Бытие 19, 2 Петра 2, жена Лота, Моав, Аммон, Руфь, археология Библии" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fdfcf9" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171411" />

<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Господь Бог — Сила Моя" />
<meta property="og:locale" content="ru_RU" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/webp" />
<meta property="og:image:alt" content="Лот и Содом — экзегетический разбор Бытия 13–19" />
<meta property="article:published_time" content={publishedTime} />
<meta property="article:modified_time" content={publishedTime} />
<meta property="article:author" content="Фёдор Милованов" />
<meta property="article:section" content="Экзегеза" />
<meta property="article:tag" content="Лот" />
<meta property="article:tag" content="Содом" />
<meta property="article:tag" content="Бытие 19" />
<meta property="article:tag" content="археология Библии" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@FedorMilovanov" />
<meta name="twitter:creator" content="@FedorMilovanov" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="Лот и Содом — экзегетический разбор Бытия 13–19" />

<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="ru" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="Господь Бог — Сила Моя — RSS" href="https://gospod-bog.ru/feed.xml" />
<link rel="icon" href="https://gospod-bog.ru/favicon.ico" type="image/x-icon" />
<link rel="apple-touch-icon" href="https://gospod-bog.ru/apple-touch-icon.png" sizes="180x180" />
<link rel="icon" href="https://gospod-bog.ru/favicon-48.png" sizes="48x48" type="image/png" />
<link rel="icon" href="https://gospod-bog.ru/favicon-120.png" sizes="120x120" type="image/png" />
<link rel="icon" href="https://gospod-bog.ru/icons/icon-192.png" sizes="192x192" />
<link rel="manifest" href="https://gospod-bog.ru/manifest.json" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
<link rel="preload" as="style" href="../../fonts/fonts.css?v=864cc57a" />
<link rel="preload" as="font" type="font/woff2" href="/fonts/Lora/lora-cyrillic-400.woff2" crossorigin />
<link rel="stylesheet" href="../../fonts/fonts.css?v=864cc57a" />
<link rel="stylesheet" href="../../css/site.css?v=d1015157" />
<link rel="stylesheet" href="../../css/command-palette.css?v=3b88813f" />
<link rel="stylesheet" href="../../css/mobile-hotfix.css?v=a6a3187a" />
<link rel="stylesheet" href="../../css/floating-cluster.css?v=85a1bfb6" />

<script is:inline define:vars={{ siteConfig }}>
  window.SITE_CONFIG = siteConfig;
</script>
