</figure>


<figure class="article-img float-left reveal">
  <picture>
    <source srcset="../../images/gill-spurgeon-succession-600w.webp 600w, ../../images/gill-spurgeon-succession-900w.webp 900w, ../../images/gill-spurgeon-succession.webp 1408w" sizes="(max-width: 640px) 600px, (max-width: 1024px) 900px, 900px" type="image/webp">
