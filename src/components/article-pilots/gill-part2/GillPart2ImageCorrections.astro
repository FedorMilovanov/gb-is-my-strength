<!--
  Route-local bridge while GillPart2ArticleBody.astro remains monolithic.
  It only corrects attributes/captions on existing nodes; no new content or layout
  node is introduced. Remove when the affected sections are split into components.
-->
<script is:inline>
  (() => {
    const article = document.querySelector('#main-content > .article-body[data-pagefind-body]');
    if (!article) return;

    const patchFigure = (fragment, options) => {
      const image = article.querySelector(`img[src*="${fragment}"]`);
      const figure = image?.closest('figure');
      if (!image || !figure) return;

      if (options.alt) image.alt = options.alt;

      const caption = figure.querySelector('figcaption');
      if (caption && options.caption) caption.textContent = options.caption;

      const source = figure.querySelector('source[sizes]');
      if (source && options.sizes) source.setAttribute('sizes', options.sizes);
    };

    patchFigure('gill-young-boy-shop', {
      alt: 'Чернильница и перо XVIII века — символ рукописной работы над толкованием Песни Песней',
      caption: 'Перо и чернильница — символ многолетней рукописной работы над циклом проповедей и толкованием Песни Песней.',
      sizes: '(max-width: 640px) 92vw, 760px',
    });

    patchFigure('gill-talmud-study-authentic', {
      alt: 'Художественная реконструкция самостоятельного изучения раввинистических книг в кабинете XVIII века',
      caption: 'Художественная реконструкция: гебраист-самоучка за изучением раввинистических текстов.',
      sizes: '(max-width: 640px) 92vw, 760px',
    });

    patchFigure('gill-wesley-debate', {
      alt: 'Символическая реконструкция богословской полемики Джона Гилла и Джона Уэсли в XVIII веке',
      caption: 'Символическая реконструкция богословской полемики эпохи; изображение не воспроизводит конкретную историческую встречу Гилла и Уэсли.',
      sizes: '(max-width: 640px) 92vw, (max-width: 1024px) 70vw, 420px',
    });
  })();
</script>
