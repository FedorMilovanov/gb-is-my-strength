---
/**
 * GillPart1PageChrome — v16 series chrome for Gill «Часть I. Человек»
 *
 * Source of truth: GillContextPageChrome.astro (owner-approved v16 reference).
 * Scope: [data-gill-v16="part"] on wrapper div.
 *
 * Converged from legacy gbs2-rail/gbs2-sheet to v16:
 * - gbs-rail (desktop): roman-numeral cards, no thumbnails
 * - mobile-bottom-bar: TOC + section + gold progress + icons
 * - toc-overlay #seriesTocOverlay / #partTocOverlay (italic-serif numerals)
 */
import PlayEmber from '@/components/ui/floating-cluster/PlayEmber.astro';
import SaveButton from '@/components/ui/floating-cluster/SaveButton.astro';
---

<a class="skip-link" href="#main-content">Перейти к содержимому</a>

<div class="gbs2-world" data-gill-v16="part">

<!-- ====== Desktop Rail ====== -->
<aside class="gbs-rail" aria-label="Серия «Джон Гилл»">
  <button class="gbs-rail-back" aria-label="Назад" data-home-href="../../biografii/">
    <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
  </button>
  <div style="margin-top:50px">
    <div class="gbs-rail-now">
      <div class="lab">Сейчас читаете</div>
      <h2>Джон Гилл (1697–1771)</h2>
      <div class="bar"><i id="gbs2Curbar"></i></div>
    </div>
    <div class="gbs-rail-list">
      <a class="gbs-rail-card" href="../dzhon-gill-istoricheskiy-kontekst/"><div class="gbs-rail-card__num">I</div><div class="gbs-rail-card__info"><small>16 мин</small><b>Исторический контекст</b></div><div class="gbs-rail-card__chevron"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></div></a>
      <a class="gbs-rail-card" href="../dzhon-gill-chast-1-chelovek/"><div class="gbs-rail-card__num">II</div><div class="gbs-rail-card__info"><small>32 мин</small><b>Часть I. Человек</b></div><div class="gbs-rail-card__chevron"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></div></a>
      <a class="gbs-rail-card is-current" href="./" aria-current="page"><div class="gbs-rail-card__num">III</div><div class="gbs-rail-card__info"><small>39 мин</small><b>Часть II. Учёный</b></div><div class="gbs-rail-card__check">✓</div><div class="gbs-rail-card__chevron"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></div></a>
      <a class="gbs-rail-card" href="../dzhon-gill-chast-3-nasledie/"><div class="gbs-rail-card__num">IV</div><div class="gbs-rail-card__info"><small>54 мин</small><b>Часть III. Наследие</b></div><div class="gbs-rail-card__chevron"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></div></a>
      <a class="gbs-rail-card" href="../dzhon-gill-spravochnik/"><div class="gbs-rail-card__num">V</div><div class="gbs-rail-card__info"><small>8 мин</small><b>Справочник по Гиллу</b></div><div class="gbs-rail-card__chevron"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></div></a>
    </div>
  </div>
  <div class="gbs-rail-spacer"></div>
  <div class="gbs-rail-foot" data-fc-root data-fc-variant="gill" data-fc-mode="series-rich">
    <button class="gbs-rail-foot__btn gb-theme-toggle" data-fc-action="theme" aria-label="Тема" data-tip="Тема">
      <span class="theme-icon-sun"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg></span>
      <span class="theme-icon-moon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>
    </button>
    <button class="gbs-rail-foot__btn" data-fc-action="search" aria-label="Поиск" data-tip="Поиск"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></button>
    <button class="gbs-rail-foot__btn gbs-rail-foot__btn--text" data-fc-action="font-down" aria-label="Уменьшить шрифт" data-tip="Меньше">A−</button>
    <button class="gbs-rail-foot__btn gbs-rail-foot__btn--text" data-fc-action="font-up" aria-label="Увеличить шрифт" data-tip="Больше">A+</button>
    <PlayEmber audioState="none" class="gbs-rail-ember" tip="Озвучка" />
    <SaveButton class="gbs-rail-foot__btn" tip="Сохранить" />
  </div>
</aside>

<!-- ====== Main Content ====== -->
<div class="page-wrap" id="content">
  <nav aria-label="Хлебные крошки" class="breadcrumb"><ol class="breadcrumb__list"><li class="breadcrumb__item"><a class="breadcrumb__link" href="../../"><span aria-hidden="true" class="breadcrumb__home">⌂</span> Главная</a></li><li class="breadcrumb__item"><a class="breadcrumb__link" href="../../biografii/">Биографии служителей</a></li><li aria-current="page" class="breadcrumb__item"><span class="breadcrumb__current">Джон Гилл</span></li></ol></nav>
  <slot />
</div>


<!-- ====== v16 Mobile Bottom Bar ====== -->
<div class="mobile-bottom-bar" data-fc-root data-fc-variant="gill">
  <button class="mobile-toc-btn" id="mobTocBtn" aria-label="Содержание">
    <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
  </button>
  <div class="mobile-btoc-section" id="gbs2MobSec">Часть II. Учёный</div>
  <div class="mobile-btoc-progress-track"><div class="mobile-btoc-progress-fill" id="gbs2MobProgress" style="width:0%"></div></div>
  <div class="mobile-btoc-pct" id="gbs2MobPct">0%</div>
  <div class="mobile-icon-row">
    <button class="gb-icon gb-theme-toggle" data-fc-action="theme" aria-label="Тема">
      <span class="theme-icon-sun"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg></span>
      <span class="theme-icon-moon"><svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>
    </button>
    <button class="gb-icon" data-fc-action="search" aria-label="Поиск"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></button>
    <PlayEmber audioState="none" />
  </div>
</div>

<!-- ====== v16 Series TOC Popup ====== -->
<div class="toc-overlay" id="seriesTocOverlay">
  <div class="toc-sheet" role="dialog" aria-label="Содержание серии">
    <div class="toc-sheet__handle"></div>
    <div class="toc-sheet__head">
      <div class="lab">Содержание серии</div>
      <h3>Джон Гилл (1697–1771)</h3>
    </div>
    <div class="toc-sheet__list">
      <a class="toc-item" href="../dzhon-gill-istoricheskiy-kontekst/"><div class="toc-item__num">I</div><div class="toc-item__info"><b>Исторический контекст</b><small>16 мин</small></div><div class="toc-item__chevron"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></div></a>
      <a class="toc-item" href="../dzhon-gill-chast-1-chelovek/"><div class="toc-item__num">II</div><div class="toc-item__info"><b>Часть I. Человек</b><small>32 мин</small></div><div class="toc-item__chevron"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></div></a>
      <a class="toc-item is-current" href="./" aria-current="page"><div class="toc-item__num">III</div><div class="toc-item__info"><b>Часть II. Учёный</b><small style="color:var(--gb-accent,#7a2e2e)">● Читаете сейчас · 39 мин</small></div><div class="toc-item__chevron"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></div></a>
      <a class="toc-item" href="../dzhon-gill-chast-3-nasledie/"><div class="toc-item__num">IV</div><div class="toc-item__info"><b>Часть III. Наследие</b><small>54 мин</small></div><div class="toc-item__chevron"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></div></a>
      <a class="toc-item" href="../dzhon-gill-spravochnik/"><div class="toc-item__num">V</div><div class="toc-item__info"><b>Справочник по Гиллу</b><small>8 мин</small></div><div class="toc-item__chevron"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></div></a>
    </div>
  </div>
</div>

<!-- ====== v16 Part TOC Popup with Action Bar ====== -->
<div class="toc-overlay" id="partTocOverlay">
  <div class="toc-sheet" role="dialog" aria-label="Часть II · Учёный">
    <div class="toc-sheet__handle"></div>
    <div class="toc-sheet__head toc-sheet__head--grid">
      <button class="back" id="backToSeries" aria-label="Назад к серии">
        <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <div class="toc-head-txt">
        <div class="lab">Часть II · Содержание</div>
        <h3>Часть II. Учёный</h3>
      </div>
    </div>
    <div class="toc-sheet__scroll-bar"><i style="--scroll-pct:0%"></i></div>
    <div class="toc-sheet__list" id="gbs2PartToc">
      <a class="toc-part-item is-current" href="#sec-hebrew"><div class="toc-part-item__num">I</div><div class="toc-part-item__info"><b>Раввинист — гебраист с Мишной в руках</b><small style="color:var(--gb-accent,#7a2e2e)">● Глава 1</small></div><div class="toc-part-item__progress"><i style="width:0%"></i></div></a>
      <a class="toc-part-item" href="#sec-canticles"><div class="toc-part-item__num">II</div><div class="toc-part-item__info"><b>Песнь Песней (1728): аллегория Христа и Церкви</b><small>Глава 2</small></div><div class="toc-part-item__progress"><i></i></div></a>
      <a class="toc-part-item" href="#sec-systematics"><div class="toc-part-item__num">III</div><div class="toc-part-item__info"><b>«Свод богословия» (1769–1770)</b><small>Глава 3</small></div><div class="toc-part-item__progress"><i></i></div></a>
      <a class="toc-part-item" href="#sec-ordinances"><div class="toc-part-item__num">IV</div><div class="toc-part-item__info"><b>Церковь, таинства и пасторское сердце</b><small>Глава 4</small></div><div class="toc-part-item__progress"><i></i></div></a>
      <a class="toc-part-item" href="#sec-eschatology"><div class="toc-part-item__num">V</div><div class="toc-part-item__info"><b>Эсхатология: царствование Христа</b><small>Глава 5</small></div><div class="toc-part-item__progress"><i></i></div></a>
      <a class="toc-part-item" href="#sec-quiz"><div class="toc-part-item__num">VI</div><div class="toc-part-item__info"><b>Проверь себя</b><small>Глава 6</small></div><div class="toc-part-item__progress"><i></i></div></a>
    </div>
    <div class="toc-sheet__actions toc-sheet__actions--grid">
      <button class="toc-action-btn gb-save" data-fc-action="save">
        <svg viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        <span>Сохранить</span>
      </button>
      <button class="toc-action-btn" data-action="share">
        <svg viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        <span>Поделиться</span>
      </button>
      <button class="toc-action-btn" data-action="print">
        <svg viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2V11a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        <span>PDF</span>
      </button>
    </div>
  </div>
</div>

</div><!-- /gbs2-world: overlays+bottom-bar nested so [data-gill-v16] descendant CSS applies -->

