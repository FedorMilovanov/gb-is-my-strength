---
interface Props {
  chapter: 3 | 4;
}

const CHAPTER_LAUNCH = {
  3: {
    startParam: 'v1_site_ch3__chapter3',
    href: 'https://t.me/milovanovaibot?startapp=v1_site_ch3__chapter3',
    roman: 'III',
    articleLabel: '1 Петра 3',
  },
  4: {
    startParam: 'v1_site_ch4__chapter4',
    href: 'https://t.me/milovanovaibot?startapp=v1_site_ch4__chapter4',
    roman: 'IV',
    articleLabel: '1 Петра 4',
  },
} as const satisfies Record<Props['chapter'], { startParam: string; href: string; roman: string; articleLabel: string }>;

const { chapter } = Astro.props as Props;
const { startParam, href, roman, articleLabel } = CHAPTER_LAUNCH[chapter];
---

<aside
  class="genesis6-app-cta"
  data-pagefind-ignore
  data-bible-app-chapter={chapter}
  data-bible-app-start-param={startParam}
  aria-label={`Библейский тренажёр по 1 Петра, глава ${chapter}`}
>
  <div class="genesis6-app-cta__chapter" aria-hidden="true">
    <span>{roman}</span>
    <small>глава</small>
  </div>

  <div class="genesis6-app-cta__copy">
    <span class="genesis6-app-cta__eyebrow">Сайт ↔ Библейский тренажёр</span>
    <strong class="genesis6-app-cta__title">Проверьте понимание {articleLabel}</strong>
    <p>
      Продолжите работу с этой же главой в Mini App: вопрос, ответ, объяснение и повтор ошибок —
      без поиска нужного раздела вручную.
    </p>
    <div class="genesis6-app-cta__flow" aria-label="Учебный маршрут">
      <span>Статья</span><i aria-hidden="true">→</i><span>Проверка</span><i aria-hidden="true">→</i><span>Возврат к тексту</span>
    </div>
  </div>

  <div class="genesis6-app-cta__launch">
    <a
      class="genesis6-app-cta__action"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      data-bible-app-launch
    >
      <span>Проверить главу {chapter}</span>
      <span class="genesis6-app-cta__arrow" aria-hidden="true">↗</span>
    </a>
    <span class="genesis6-app-cta__note">Откроется сразу нужная глава · Telegram Mini App</span>
  </div>
</aside>

<style>
  .genesis6-app-cta {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(188px, auto);
    align-items: center;
    gap: clamp(18px, 3vw, 30px);
    overflow: hidden;
    margin: clamp(38px, 5vw, 64px) 0 34px;
    padding: clamp(22px, 3.4vw, 32px);
    border: 1px solid color-mix(in srgb, var(--manuscript-gold) 58%, var(--manuscript-line));
    border-radius: 14px;
    background:
      radial-gradient(circle at 92% 4%, color-mix(in srgb, #35b7c7 12%, transparent), transparent 23rem),
      linear-gradient(132deg, color-mix(in srgb, var(--manuscript-gold) 10%, transparent), transparent 38%),
      var(--manuscript-paper);
    box-shadow: 0 22px 54px color-mix(in srgb, var(--manuscript-shadow) 88%, transparent);
  }

  .genesis6-app-cta::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(180deg, #35b7c7, var(--manuscript-gold));
  }

  .genesis6-app-cta::after {
    content: '↔';
    position: absolute;
    z-index: -1;
    right: 22px;
    top: -24px;
    color: color-mix(in srgb, var(--manuscript-gold) 10%, transparent);
    font-family: "Inter", system-ui, sans-serif;
    font-size: 100px;
    font-weight: 300;
    line-height: 1;
    pointer-events: none;
  }

  .genesis6-app-cta__chapter {
    display: grid;
    width: 66px;
    aspect-ratio: 1;
    place-items: center;
    align-content: center;
    gap: 2px;
    border: 1px solid color-mix(in srgb, var(--manuscript-gold) 62%, var(--manuscript-line));
    border-radius: 50%;
    color: var(--manuscript-gold);
    background: color-mix(in srgb, var(--manuscript-gold) 6%, transparent);
  }

  .genesis6-app-cta__chapter span {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 21px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: .05em;
  }

  .genesis6-app-cta__chapter small {
    color: var(--manuscript-ink-soft);
    font-family: "Inter", system-ui, sans-serif;
    font-size: 8px;
    font-weight: 760;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .genesis6-app-cta__copy {
    min-width: 0;
  }

  .genesis6-app-cta__eyebrow {
    display: block;
    margin-bottom: 7px;
    color: color-mix(in srgb, #209daf 78%, var(--manuscript-gold));
    font-family: "Inter", system-ui, sans-serif;
    font-size: 10px;
    font-weight: 820;
    letter-spacing: .14em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .genesis6-app-cta__title {
    display: block;
    color: var(--manuscript-ink);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(21px, 2.5vw, 28px);
    font-weight: 700;
    line-height: 1.16;
  }

  .genesis6-app-cta p {
    max-width: 650px;
    margin: 9px 0 0;
    color: var(--manuscript-ink-soft);
    font-size: 14px;
    line-height: 1.62;
  }

  .genesis6-app-cta__flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin-top: 14px;
    color: var(--manuscript-ink-soft);
    font-family: "Inter", system-ui, sans-serif;
    font-size: 9px;
    font-weight: 760;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .genesis6-app-cta__flow i {
    color: var(--manuscript-gold);
    font-style: normal;
  }

  .genesis6-app-cta__launch {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: stretch;
    gap: 9px;
  }

  .genesis6-app-cta__action {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 0 18px;
    border: 1px solid var(--manuscript-gold);
    border-radius: 999px;
    color: var(--manuscript-paper);
    font-family: "Inter", system-ui, sans-serif;
    font-size: 12px;
    font-weight: 820;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    background: linear-gradient(135deg, var(--manuscript-gold-bright), var(--manuscript-gold));
    box-shadow: 0 15px 30px -20px rgba(49, 31, 17, .5);
    transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
  }

  .genesis6-app-cta__action:hover {
    transform: translateY(-2px);
    filter: brightness(1.04);
    box-shadow: 0 20px 34px -18px rgba(49, 31, 17, .58);
  }

  .genesis6-app-cta__action:focus-visible {
    outline: 3px solid color-mix(in srgb, #35b7c7 48%, transparent);
    outline-offset: 3px;
  }

  .genesis6-app-cta__arrow {
    font-size: 15px;
  }

  .genesis6-app-cta__note {
    max-width: 210px;
    color: var(--manuscript-ink-soft);
    font-family: "Inter", system-ui, sans-serif;
    font-size: 9px;
    line-height: 1.45;
    text-align: center;
  }

  @media (max-width: 820px) {
    .genesis6-app-cta {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .genesis6-app-cta__launch {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .genesis6-app-cta__note {
      max-width: 180px;
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .genesis6-app-cta {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 20px;
    }

    .genesis6-app-cta__chapter {
      width: 54px;
    }

    .genesis6-app-cta__launch {
      grid-column: auto;
      grid-template-columns: 1fr;
    }

    .genesis6-app-cta__action {
      width: 100%;
      min-height: 52px;
    }

    .genesis6-app-cta__note {
      max-width: none;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .genesis6-app-cta__action {
      transition: none;
    }

    .genesis6-app-cta__action:hover {
      transform: none;
    }
  }
</style>
