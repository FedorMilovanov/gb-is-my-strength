---
/**
 * GillSpravochnikArticleBody — Phase GS2 article-body section seams.
 *
 * The legacy article-body monolith has been split into ordered fragments while
 * this component owns the <article class="article-body"> wrapper. Promote one
 * section at a time after parity proof and Gill-specific guard updates.
 */
const sectionModules = import.meta.glob('./_legacy/article-sections/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const sections = Object.entries(sectionModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, html]) => html);
---
<article class="article-body">{sections.map((html) => <Fragment set:html={html} />)}</article>
