---
import FloatingCluster from '@/components/ui/floating-cluster/FloatingCluster.astro';
import ReaderRail from '@/components/article-pilots/_shared/ReaderRail.astro';
import HermenevtikaMobileBar from '@/components/article-pilots/hermenevtika/HermenevtikaMobileBar.astro';
import ReaderSettings from '@/components/article-pilots/_shared/ReaderSettings.astro';
import { LAWSON_TOC } from './lawsonToc';

// Статья о Лоусоне потребляет канонических владельцев одиночной читательской
// поверхности (рельс, угловой кластер, мобильная панель, лист настроек) и не
// форкает их рантайм — так же, как lot-i-sodom и kod-da-vinchi.
const railTitle = 'Падение Стивена Лоусона: что должно говорить громче слов';
---

<div class="lawson-cluster-scope">
  <FloatingCluster mode="single" variant="hermeneutics" audioState="none" />
</div>
<style is:global>
  @media (max-width: 1199px) {
    .lawson-cluster-scope { display: none !important; }
  }
</style>
<ReaderRail
  eyebrow="Библиотека проекта · Разбор"
  title={railTitle}
  backHref="../../"
  toc={LAWSON_TOC}
  palette="ink-gold"
/>
<HermenevtikaMobileBar
  title={railTitle}
  backHref="../../"
  readingMinutes={87}
  toc={LAWSON_TOC}
  palette="ink-gold"
/>
<ReaderSettings />
