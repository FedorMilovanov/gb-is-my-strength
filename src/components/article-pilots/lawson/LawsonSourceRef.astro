---
import { LAWSON_EVIDENCE_LABEL, lawsonSource } from './sourceRegistry';

interface Props {
  id: string;
}

const { id } = Astro.props as Props;
const source = lawsonSource(id);
---
<span class="lawson-source-ref" data-reader-exclude data-pagefind-ignore>
  <a class="lawson-source-fallback" href={`#source-${source.id}`} aria-label={`Источник ${source.n}: ${source.label}`}>[{source.n}]</a>
  <button type="button" hidden aria-expanded="false" aria-label={`Источник ${source.n}: ${source.label}`}>{source.n}</button>
  <span class="lawson-source-popover" role="note" hidden>
    <span class="lawson-source-meta">{LAWSON_EVIDENCE_LABEL[source.evidenceClass]}</span>
    <strong>{source.label}</strong>
    <span>{source.proves}</span>
    {source.boundary && <span class="lawson-source-boundary"><b>Предел вывода:</b> {source.boundary}</span>}
    <a href={source.href} rel="noopener noreferrer">{source.destinationLabel ?? 'Открыть источник ↗'}</a>
    <a class="lawson-source-bibliography" href={`#source-${source.id}`}>К записи в библиографии</a>
  </span>
</span>

<style>
  /* A source marker must be phrasing content: <details> inside a paragraph
     made the HTML parser close that paragraph and create 164 empty ones. */
  .lawson-source-ref {
    position: relative;
    display: inline-block;
    margin-inline: .08em;
    vertical-align: super;
    line-height: 1;
  }
  .lawson-source-ref > :is(button, .lawson-source-fallback) {
    display: inline-grid;
    place-items: center;
    min-width: 1.42rem;
    height: 1.42rem;
    padding: 0 .25rem;
    border: 1px solid color-mix(in srgb, var(--accent, #7a2e2e) 42%, var(--border, #ddd));
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent, #7a2e2e) 7%, var(--bg, #fff));
    color: var(--accent, #7a2e2e);
    font: 700 .67rem/1 var(--font-body, Inter, system-ui, sans-serif);
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
  }
  .lawson-source-ref > :is(button, .lawson-source-fallback)[hidden] { display: none; }
  .lawson-source-ref > :is(button, .lawson-source-fallback):focus-visible {
    outline: 2px solid var(--accent, #7a2e2e);
    outline-offset: 2px;
  }
  .lawson-source-popover {
    position: absolute;
    z-index: 80;
    left: 0;
    bottom: calc(100% + .55rem);
    width: min(22rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100dvh - 6rem));
    overflow: auto;
    overscroll-behavior: contain;
    box-sizing: border-box;
    overflow-wrap: anywhere;
    display: grid;
    gap: .48rem;
    padding: .85rem .9rem;
    border: 1px solid var(--border, #dedbd4);
    border-radius: .8rem;
    background: color-mix(in srgb, var(--bg, #fff) 96%, var(--accent, #7a2e2e) 4%);
    color: var(--text, #211f1c);
    box-shadow: 0 14px 38px rgb(0 0 0 / .16);
    font: 400 .84rem/1.45 var(--font-body, Inter, system-ui, sans-serif);
    text-align: left;
  }
  .lawson-source-popover[hidden] { display: none; }
  .lawson-source-popover strong { font-weight: 700; }
  .lawson-source-meta {
    color: var(--muted, #6b6862);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .lawson-source-boundary {
    padding-top: .4rem;
    border-top: 1px solid var(--border, #dedbd4);
    color: var(--muted, #6b6862);
  }
  .lawson-source-popover a {
    width: fit-content;
    max-width: 100%;
    padding: .35rem .55rem;
    border-radius: .4rem;
    background: var(--bg, #fff);
    color: var(--accent, #7a2e2e);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  @media screen {
    .lawson-source-popover a {
      display: grid;
      grid-template-columns: minmax(0, 1fr) .65rem;
      align-items: center;
      gap: .75rem;
      width: 100%;
      box-sizing: border-box;
      min-height: 44px;
      padding: .4rem .55rem;
      color: var(--accent);
      background: transparent;
      border-radius: 2px;
      font-weight: 600;
      text-decoration: none;
      overflow-wrap: anywhere;
    }
    .lawson-source-popover a::after {
      content: '';
      inline-size: .45rem;
      block-size: .45rem;
      border-block-start: 1.5px solid currentColor;
      border-inline-end: 1.5px solid currentColor;
      transform: rotate(45deg);
      justify-self: center;
    }
    .lawson-source-popover a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    @media (hover: hover) and (pointer: fine) {
      .lawson-source-popover a:hover { text-decoration: underline; text-underline-offset: .2em; }
    }
  }
  @media screen and (forced-colors: active) {
    .lawson-source-popover a { color: LinkText; text-decoration: underline; }
    .lawson-source-popover a:focus-visible { outline-color: Highlight; }
  }
  @media (max-width: 1199px) {
    .lawson-source-popover {
      position: fixed;
      left: 1rem;
      right: 1rem;
      --lawson-popover-bottom: max(calc(4.5rem + env(safe-area-inset-bottom, 0px)), var(--lawson-popover-chrome-bottom, 0px));
      --lawson-popover-top: max(calc(.5rem + env(safe-area-inset-top, 0px)), var(--lawson-popover-chrome-top, 0px));
      bottom: var(--lawson-popover-bottom);
      width: auto;
      max-height: max(0px, calc(100dvh - var(--lawson-popover-bottom) - var(--lawson-popover-top)));
    }
  }
  @media print {
    .lawson-source-ref { vertical-align: baseline; }
    /* A single literal bracketed anchor preserves the PDF destination.
       The explicit override is needed for the enhanced fallback's hidden state. */
    .lawson-source-ref > button { display: none !important; }
    .lawson-source-ref > .lawson-source-fallback,
    .lawson-source-ref > .lawson-source-fallback[hidden] {
      display: inline !important;
      border: 0; background: transparent; min-width: 0; height: auto;
      padding: 0; color: inherit; font: inherit; text-decoration: none;
    }
    .lawson-source-popover { display: none !important; }
  }
</style>

<script>
  import { placeLawsonPopover } from './lawsonPopoverPlacement';

  function placeSourceCard(ref: HTMLElement) {
    if (!ref.hasAttribute('data-open')) return;
    const card = ref.querySelector<HTMLElement>('.lawson-source-popover');
    if (!card) return;
    if (!placeLawsonPopover(ref, card, .55 * parseFloat(getComputedStyle(document.documentElement).fontSize))) {
      const restore = card.contains(document.activeElement);
      closeSource(ref);
      if (restore) ref.querySelector<HTMLButtonElement>('button')?.focus({ preventScroll: true });
    }
  }
  function closeSource(ref: HTMLElement) {
    ref.removeAttribute('data-open');
    const card = ref.querySelector<HTMLElement>('.lawson-source-popover');
    if (card) card.hidden = true;
    ref.querySelector('button')?.setAttribute('aria-expanded', 'false');
  }
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    const marker = event.target.closest<HTMLElement>('.lawson-source-ref');
    const trigger = event.target.closest<HTMLButtonElement>('.lawson-source-ref > button');
    const bibliography = event.target.closest<HTMLAnchorElement>('.lawson-source-bibliography');
    if (bibliography && marker) {
      closeSource(marker);
      return;
    }
    const wasOpen = marker?.hasAttribute('data-open');
    document.querySelectorAll<HTMLElement>('.lawson-source-ref[data-open]').forEach((ref) => {
      if (ref !== marker || trigger) closeSource(ref);
    });
    if (!trigger || !marker || wasOpen) return;
    const card = marker.querySelector<HTMLElement>('.lawson-source-popover');
    if (!card) return;
    marker.setAttribute('data-open', '');
    card.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
    placeSourceCard(marker);
  });
  document.addEventListener('focusin', (event) => {
    if (!(event.target instanceof Element)) return;
    const target = event.target;
    document.querySelectorAll<HTMLElement>('.lawson-source-ref[data-open]').forEach((ref) => {
      if (!ref.contains(target)) closeSource(ref);
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = document.querySelector<HTMLElement>('.lawson-source-ref[data-open]');
    if (!open) return;
    closeSource(open);
    open.querySelector('button')?.focus();
  });
  function repositionOpenCards() {
    document.querySelectorAll<HTMLElement>('.lawson-source-ref[data-open]').forEach(placeSourceCard);
  }
  window.addEventListener('resize', repositionOpenCards, { passive: true });
  window.addEventListener('scroll', repositionOpenCards, { passive: true });
  // Keep the native link until all delegated handlers are installed.
  document.querySelectorAll<HTMLElement>('.lawson-source-ref').forEach((ref) => {
    const fallback = ref.querySelector<HTMLAnchorElement>('.lawson-source-fallback');
    const button = ref.querySelector<HTMLButtonElement>('button');
    if (!fallback || !button || !ref.querySelector('.lawson-source-popover')) return;
    const focused = document.activeElement === fallback;
    button.hidden = false;
    fallback.hidden = true;
    if (focused) button.focus();
  });
</script>
