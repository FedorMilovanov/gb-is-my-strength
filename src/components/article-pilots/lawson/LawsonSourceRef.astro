---
import { LAWSON_EVIDENCE_LABEL, lawsonSource } from './sourceRegistry';

interface Props {
  id: string;
}

const { id } = Astro.props as Props;
const source = lawsonSource(id);
---
<span class="lawson-source-ref">
  <button type="button" aria-expanded="false" aria-label={`Источник ${source.n}: ${source.label}`}>{source.n}</button>
  <span class="lawson-source-popover" role="note" hidden>
    <span class="lawson-source-meta">{LAWSON_EVIDENCE_LABEL[source.evidenceClass]}</span>
    <strong>{source.label}</strong>
    <span>{source.proves}</span>
    {source.boundary && <span class="lawson-source-boundary"><b>Граница:</b> {source.boundary}</span>}
    <a href={source.href} rel="noopener noreferrer">Открыть источник ↗</a>
  </span>
</span>

<style>
  /* A source marker must be phrasing content: <details> inside a paragraph
     made the HTML parser close that paragraph and create 164 empty ones. */
  .lawson-source-ref {
    position: relative;
    display: inline-block;
    margin-inline: .08em;
    vertical-align: super;
    line-height: 1;
  }
  .lawson-source-ref > button {
    display: inline-grid;
    place-items: center;
    min-width: 1.42rem;
    height: 1.42rem;
    padding: 0 .25rem;
    border: 1px solid color-mix(in srgb, var(--accent, #7a2e2e) 42%, var(--border, #ddd));
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent, #7a2e2e) 7%, var(--bg, #fff));
    color: var(--accent, #7a2e2e);
    font: 700 .67rem/1 var(--font-body, Inter, system-ui, sans-serif);
    cursor: pointer;
  }
  .lawson-source-ref > button:focus-visible {
    outline: 2px solid var(--accent, #7a2e2e);
    outline-offset: 2px;
  }
  .lawson-source-popover {
    position: absolute;
    z-index: 80;
    left: 0;
    bottom: calc(100% + .55rem);
    width: min(22rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100dvh - 6rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    display: grid;
    gap: .48rem;
    padding: .85rem .9rem;
    border: 1px solid var(--border, #dedbd4);
    border-radius: .8rem;
    background: color-mix(in srgb, var(--bg, #fff) 96%, var(--accent, #7a2e2e) 4%);
    color: var(--text, #211f1c);
    box-shadow: 0 14px 38px rgb(0 0 0 / .16);
    font: 400 .84rem/1.45 var(--font-body, Inter, system-ui, sans-serif);
    text-align: left;
  }
  .lawson-source-popover[hidden] { display: none; }
  .lawson-source-popover strong { font-weight: 700; }
  .lawson-source-meta {
    color: var(--muted, #6b6862);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .lawson-source-boundary {
    padding-top: .4rem;
    border-top: 1px solid var(--border, #dedbd4);
    color: var(--muted, #6b6862);
  }
  .lawson-source-popover a {
    position: sticky;
    bottom: 0;
    width: fit-content;
    padding: .35rem .55rem;
    border-radius: .4rem;
    background: var(--bg, #fff);
    color: var(--accent, #7a2e2e);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  @media (max-width: 1199px) {
    .lawson-source-popover {
      position: fixed;
      left: 1rem;
      right: 1rem;
      bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
      width: auto;
      max-height: calc(100dvh - 6rem - env(safe-area-inset-bottom, 0px));
    }
  }
  @media print {
    .lawson-source-ref { vertical-align: baseline; }
    .lawson-source-ref > button { border: 0; background: transparent; min-width: 0; height: auto; padding: 0; color: inherit; }
    .lawson-source-ref > button::before { content: '['; }
    .lawson-source-ref > button::after { content: ']'; }
    .lawson-source-popover { display: none !important; }
  }
</style>

<script>
  function placeSourceCard(ref: HTMLElement) {
    if (!ref.hasAttribute('data-open')) return;
    const card = ref.querySelector<HTMLElement>('.lawson-source-popover');
    if (!card) return;
    if (!matchMedia('(min-width: 1200px)').matches) {
      card.style.removeProperty('left');
      card.style.translate = '';
      return;
    }
    card.style.translate = '';
    const marker = ref.getBoundingClientRect();
    card.style.left = `${Math.min(0, innerWidth - 16 - marker.left - card.offsetWidth)}px`;
    const bounds = card.getBoundingClientRect();
    const verticalShift = Math.max(16 - bounds.top, Math.min(0, innerHeight - 16 - bounds.bottom));
    card.style.translate = `0 ${verticalShift}px`;
  }
  function closeSource(ref: HTMLElement) {
    ref.removeAttribute('data-open');
    const card = ref.querySelector<HTMLElement>('.lawson-source-popover');
    if (card) card.hidden = true;
    ref.querySelector('button')?.setAttribute('aria-expanded', 'false');
  }
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const marker = event.target.closest<HTMLElement>('.lawson-source-ref');
    const trigger = event.target.closest<HTMLButtonElement>('.lawson-source-ref > button');
    const wasOpen = marker?.hasAttribute('data-open');
    document.querySelectorAll<HTMLElement>('.lawson-source-ref[data-open]').forEach((ref) => {
      if (ref !== marker || trigger) closeSource(ref);
    });
    if (!trigger || !marker || wasOpen) return;
    const card = marker.querySelector<HTMLElement>('.lawson-source-popover');
    if (!card) return;
    marker.setAttribute('data-open', '');
    card.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
    placeSourceCard(marker);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = document.querySelector<HTMLElement>('.lawson-source-ref[data-open]');
    if (!open) return;
    closeSource(open);
    open.querySelector('button')?.focus();
  });
  window.addEventListener('resize', () => {
    document.querySelectorAll<HTMLElement>('.lawson-source-ref[data-open]').forEach(placeSourceCard);
  }, { passive: true });
</script>
