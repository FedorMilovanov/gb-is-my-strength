---
import { LAWSON_EVIDENCE_LABEL, lawsonSource } from './sourceRegistry';

interface Props {
  id: string;
}

const { id } = Astro.props as Props;
const source = lawsonSource(id);
---
<details class="lawson-source-ref">
  <summary aria-label={`Источник ${source.n}: ${source.label}`}>{source.n}</summary>
  <span class="lawson-source-popover" role="note">
    <span class="lawson-source-meta">{LAWSON_EVIDENCE_LABEL[source.evidenceClass]}</span>
    <strong>{source.label}</strong>
    <span>{source.proves}</span>
    {source.boundary && <span class="lawson-source-boundary"><b>Граница:</b> {source.boundary}</span>}
    <a href={source.href} rel="noopener noreferrer">Открыть источник ↗</a>
  </span>
</details>

<style>
  .lawson-source-ref {
    position: relative;
    display: inline-block;
    margin-inline: .08em;
    vertical-align: super;
    line-height: 1;
  }
  .lawson-source-ref summary {
    display: inline-grid;
    place-items: center;
    min-width: 1.42rem;
    height: 1.42rem;
    padding: 0 .25rem;
    border: 1px solid color-mix(in srgb, var(--accent, #7a2e2e) 42%, var(--border, #ddd));
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent, #7a2e2e) 7%, var(--bg, #fff));
    color: var(--accent, #7a2e2e);
    font: 700 .67rem/1 var(--font-body, Inter, system-ui, sans-serif);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .lawson-source-ref summary::-webkit-details-marker { display: none; }
  .lawson-source-ref summary:focus-visible {
    outline: 2px solid var(--accent, #7a2e2e);
    outline-offset: 2px;
  }
  .lawson-source-popover {
    position: absolute;
    z-index: 80;
    left: 0;
    bottom: calc(100% + .55rem);
    width: min(22rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100dvh - 6rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    display: none;
    gap: .48rem;
    padding: .85rem .9rem;
    border: 1px solid var(--border, #dedbd4);
    border-radius: .8rem;
    background: color-mix(in srgb, var(--bg, #fff) 96%, var(--accent, #7a2e2e) 4%);
    color: var(--text, #211f1c);
    box-shadow: 0 14px 38px rgb(0 0 0 / .16);
    font: 400 .84rem/1.45 var(--font-body, Inter, system-ui, sans-serif);
    text-align: left;
  }
  .lawson-source-ref[open] .lawson-source-popover { display: grid; }
  .lawson-source-popover strong { font-weight: 700; }
  .lawson-source-meta {
    color: var(--muted, #6b6862);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .lawson-source-boundary {
    padding-top: .4rem;
    border-top: 1px solid var(--border, #dedbd4);
    color: var(--muted, #6b6862);
  }
  .lawson-source-popover a {
    position: sticky;
    bottom: 0;
    width: fit-content;
    padding: .35rem .55rem;
    border-radius: .4rem;
    background: var(--bg, #fff);
    color: var(--accent, #7a2e2e);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .lawson-source-popover a:hover { text-decoration: underline; }
  @media (max-width: 1199px) {
    .lawson-source-popover {
      position: fixed;
      left: 1rem;
      right: 1rem;
      bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
      width: auto;
      max-height: calc(100dvh - 6rem - env(safe-area-inset-bottom, 0px));
    }
  }
  @media print {
    .lawson-source-ref { vertical-align: baseline; }
    .lawson-source-ref summary { border: 0; background: transparent; min-width: 0; height: auto; padding: 0; }
    .lawson-source-ref summary::before { content: '['; }
    .lawson-source-ref summary::after { content: ']'; }
    .lawson-source-popover { display: none !important; }
  }
</style>

<script>
  // Keep the desktop card inside the viewport even when its marker is at the
  // right end of a line. The mobile card uses a fixed position above the bar.
  function placeSourceCard(ref: HTMLDetailsElement) {
    if (!ref.open) return;
    const card = ref.querySelector<HTMLElement>('.lawson-source-popover');
    if (!card) return;
    if (!matchMedia('(min-width: 1200px)').matches) {
      card.style.removeProperty('left');
      card.style.translate = '';
      return;
    }
    card.style.translate = '';
    const marker = ref.getBoundingClientRect();
    card.style.left = `${Math.min(0, innerWidth - 16 - marker.left - card.offsetWidth)}px`;
    const bounds = card.getBoundingClientRect();
    const verticalShift = Math.max(16 - bounds.top, Math.min(0, innerHeight - 16 - bounds.bottom));
    card.style.translate = `0 ${verticalShift}px`;
  }
  document.addEventListener('toggle', (event) => {
    if (event.target instanceof HTMLDetailsElement && event.target.classList.contains('lawson-source-ref')) {
      placeSourceCard(event.target);
    }
  }, true);
  window.addEventListener('resize', () => {
    document.querySelectorAll<HTMLDetailsElement>('.lawson-source-ref[open]').forEach(placeSourceCard);
  }, { passive: true });
</script>