---
const phases = [
  { date: '1980-е–2014', label: 'Долгая пасторская служба' },
  { date: '2014–2020', label: 'Публичное учение и ранние сигналы' },
  { date: 'сентябрь 2024', label: 'Падение и отстранение' },
  { date: 'март 2025', label: 'Признание и помощь' },
  { date: '2026', label: 'Книга и продолжение публичного разговора' },
];
---

<figure class="lawson-timeline-overview" aria-labelledby="lawson-timeline-overview-caption">
  <figcaption id="lawson-timeline-overview-caption">Ключевые этапы</figcaption>
  <svg class="lawson-timeline-overview__track lawson-timeline-overview__track--desktop" viewBox="0 0 1000 48" aria-hidden="true" focusable="false">
    <path d="M100 24H900" fill="none" stroke="currentColor" stroke-opacity=".55" stroke-width="2" stroke-linecap="round" />
    <g fill="currentColor">
      <circle cx="100" cy="24" r="5.5" />
      <circle cx="300" cy="24" r="5.5" />
      <circle cx="500" cy="24" r="5.5" />
      <circle cx="700" cy="24" r="5.5" />
      <circle cx="900" cy="24" r="5.5" />
    </g>
  </svg>
  <svg class="lawson-timeline-overview__track lawson-timeline-overview__track--mobile" viewBox="0 0 48 350" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M24 35V315" fill="none" stroke="currentColor" stroke-opacity=".42" stroke-width="2" stroke-linecap="round" />
    <g fill="currentColor">
      <circle cx="24" cy="35" r="5.5" />
      <circle cx="24" cy="105" r="5.5" />
      <circle cx="24" cy="175" r="5.5" />
      <circle cx="24" cy="245" r="5.5" />
      <circle cx="24" cy="315" r="5.5" />
    </g>
  </svg>
  <ol class="lawson-timeline-overview__items" aria-label="Основные этапы истории">
    {phases.map((phase) => (
      <li>
        <time>{phase.date}</time>
        <span>{phase.label}</span>
      </li>
    ))}
  </ol>
</figure>
