---
/**
 * HermenevtikaRail — left rail for the single-article layout, structurally
 * identical to the Gill series rail (back button, scrollable TOC with a
 * metro-line track + dots, footer icon row) but content = the article's OWN
 * H2/H3 outline instead of a series part list, and palette = the site's own
 * day/night tokens (day: warm cream + maroon; night: dark wine + dusty rose),
 * not Gill's brown-chocolate/gold leather skin.
 *
 * Footer keeps the same icon family as the old floating cluster (theme,
 * search, font-, font+, save) — Play moved out to the big top-right
 * SpeedBloom, so the freed slot is Share.
 */
import SaveButton from '@/components/ui/floating-cluster/SaveButton.astro';
import GooPlayMini from '@/components/ui/speed-bloom/GooPlayMini.astro';
import { HERMENEVTIKA_TOC } from './hermenevtikaToc';

interface Props {
  eyebrow: string;
  title: string;
  backHref: string;
}
const { eyebrow, title, backHref } = Astro.props;
---
<aside class="hrail" aria-label={title}>
  <button class="hrail-back" type="button" aria-label="Назад" data-home-href={backHref}>
    <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
  </button>
  <div class="hrail-meta">
    <div class="hrail-meta__eyebrow">{eyebrow}</div>
    <p class="hrail-meta__title">{title}</p>
  </div>
  <div class="hrail-toch">
    Оглавление статьи
    <b id="hrailCount">1 / {HERMENEVTIKA_TOC.length}</b>
  </div>
  <div class="hrail-scroll">
    <ul class="hrail-toc" id="hrailToc">
      <span class="hrail-track" aria-hidden="true"><i></i></span>
      {HERMENEVTIKA_TOC.map((item) => (
        <li class:list={{ 'hrail-sub': item.level === 3 }}>
          <a href={item.href}><span class="hrail-dot" aria-hidden="true"></span>{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
  <div class="hrail-foot" data-fc-root data-fc-variant="single" data-fc-mode="single">
    <button class="hrail-foot__btn gb-theme-toggle" data-fc-action="theme" aria-label="Тема" data-tip="Тема">
      <span class="theme-icon-sun" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg></span>
      <span class="theme-icon-moon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg></span>
    </button>
    <button class="hrail-foot__btn" data-fc-action="search" aria-label="Поиск" data-tip="Поиск">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
    </button>
    <button class="hrail-foot__btn hrail-foot__btn--text" data-fc-action="font-down" aria-label="Уменьшить шрифт" data-tip="Меньше">A−</button>
    <button class="hrail-foot__btn hrail-foot__btn--text" data-fc-action="font-up" aria-label="Увеличить шрифт" data-tip="Больше">A+</button>
    <button class="hrail-foot__btn" id="hrailShare" aria-label="Поделиться" data-tip="Поделиться">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="2.6" /><circle cx="6" cy="12" r="2.6" /><circle cx="18" cy="19" r="2.6" /><path d="M8.3 10.7l7.4-4.2M8.3 13.3l7.4 4.2" /></svg>
    </button>
    <SaveButton class="hrail-foot__btn" tip="Сохранить" />
  </div>
</aside>

<!-- Top-right big Play: the same verified GooPlayMini goo control (direction
     left), sized up from the footer's 46px default for primary visibility —
     NOT the old 90px/470px banner. Its own [data-fc-root] (standalone). -->
<div class="hrail-top-play">
  <GooPlayMini direction="left" defs={true} tip="Слушать озвучку" class="hrail-top-play__mini" />
</div>

<style is:global>
  /* ===== HermenevtikaRail — day (warm cream + maroon) / night (dark wine + dusty rose) ===== */
  .hrail{
    position:fixed; left:clamp(16px,2.4vw,40px); top:24px; bottom:24px; width:270px;
    background:linear-gradient(180deg,#fbf3ea,#f3e6d8);
    border:1px solid #e8d9c8; border-radius:28px;
    box-shadow:0 24px 60px -20px rgba(122,46,46,.18);
    display:flex; flex-direction:column; padding:20px 16px 14px; overflow:hidden;
    z-index:var(--z-sticky,1000);
  }
  html.dark .hrail{
    background:radial-gradient(130% 50% at 24% 0%, rgba(160,50,60,.10), transparent 55%),linear-gradient(180deg,#2b1219,#1c0b10 60%,#130709);
    border-color:rgba(212,140,150,.16);
    box-shadow:0 34px 100px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.04);
  }
  .hrail-back{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;color:#7a2e2e;margin:0 0 8px 4px;opacity:.85;
    transition:transform .3s,color .3s;cursor:pointer;background:none;border:0;padding:0;font:inherit}
  html.dark .hrail-back{color:#e0a89c}
  .hrail-back svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:1.8}
  @media(hover:hover) and (pointer:fine){
    .hrail-back:hover{transform:translateX(-3px);color:#5f2323}
    html.dark .hrail-back:hover{color:#f2c4b6}
  }
  .hrail-meta{padding:2px 4px 14px}
  .hrail-meta__eyebrow{font-size:9.5px;font-weight:900;letter-spacing:.2em;text-transform:uppercase;color:#7a2e2e}
  html.dark .hrail-meta__eyebrow{color:#d68a7a}
  .hrail-meta__title{font-family:var(--f-serif,Lora,Georgia,serif);font-size:17px;font-weight:700;line-height:1.28;color:#2a1814;margin:6px 0 0}
  html.dark .hrail-meta__title{color:#f2e9e6}

  .hrail-toch{display:flex;align-items:center;gap:8px;padding:12px 2px 8px;font-size:9.5px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:rgba(42,24,20,.5);border-top:1px solid rgba(0,0,0,.08)}
  html.dark .hrail-toch{color:rgba(255,255,255,.5);border-top-color:rgba(255,255,255,.07)}
  .hrail-toch b{margin-left:auto;background:rgba(122,46,46,.08);border:1px solid rgba(122,46,46,.22);border-radius:99px;padding:2px 9px;font-size:10px;color:#7a2e2e;font-variant-numeric:tabular-nums}
  html.dark .hrail-toch b{background:rgba(212,168,87,.08);border-color:rgba(224,160,150,.24);color:#e0a89c}
  .hrail-scroll{flex:1 1 auto; overflow-y:auto; margin-right:-8px; padding-right:8px}
  .hrail-toc{position:relative;list-style:none;margin:6px 0 0;padding:2px 12px 14px 0;--toc-axis-x:14px}
  .hrail-track{position:absolute;left:calc(var(--toc-axis-x) - 1px);width:2px;border-radius:9px;overflow:hidden;
    top:14px;bottom:22px;background:rgba(0,0,0,.08)}
  html.dark .hrail-track{background:rgba(255,255,255,.08)}
  .hrail-track i{position:absolute;left:0;top:0;width:100%;height:100%;border-radius:9px;overflow:hidden;
    transform-origin:50% 0;transform:scaleY(var(--track-progress,.08));transition:transform 460ms cubic-bezier(.22,1,.36,1);
    background:linear-gradient(180deg,#c4694c 0%,#a94847 48%,#7a2e2e 100%)}
  .hrail-toc li{position:relative;margin:1px 0;padding-left:30px}
  .hrail-toc a{display:block;padding:6px 10px;border-radius:9px;color:rgba(42,24,20,.68);text-decoration:none;
    font-family:var(--f-serif,Lora,Georgia,serif);font-size:12.5px;line-height:1.3;transition:color .2s,background-color .2s}
  html.dark .hrail-toc a{color:rgba(255,255,255,.62)}
  .hrail-dot{position:absolute;left:calc(var(--toc-axis-x) - 4.5px);top:50%;width:9px;height:9px;margin-top:-4.5px;border-radius:50%;
    border:2px solid rgba(42,24,20,.22);background:#fff;box-shadow:0 0 0 3px #f3e6d8;z-index:1;transition:.2s}
  html.dark .hrail-dot{border-color:rgba(255,255,255,.18);background:#1c0e10;box-shadow:0 0 0 3px #170b0c}
  .hrail-toc li.hrail-passed .hrail-dot{background:#b85c3e;border-color:#b85c3e}
  .hrail-toc li.hrail-sub a{font-size:11px}
  .hrail-toc li.hrail-sub:not(.hrail-act):not(.hrail-passed) a{color:rgba(42,24,20,.5)}
  html.dark .hrail-toc li.hrail-sub:not(.hrail-act):not(.hrail-passed) a{color:rgba(255,255,255,.46)}
  .hrail-toc li.hrail-act a{background:linear-gradient(90deg,rgba(122,46,46,.14),rgba(122,46,46,.045) 72%,transparent);
    color:#2a1814;font-weight:700;box-shadow:inset 0 0 0 1px rgba(122,46,46,.22)}
  html.dark .hrail-toc li.hrail-act a{background:linear-gradient(90deg,rgba(122,46,46,.44),rgba(122,46,46,.16) 72%,rgba(122,46,46,.05));
    color:#f6efe9;box-shadow:inset 0 0 0 1px rgba(224,160,150,.16)}
  .hrail-toc li.hrail-act .hrail-dot{background:#dd7c5d;border-color:#dd7c5d;transform:scale(1.11)}
  .hrail-toc li.hrail-sub .hrail-dot{width:7px;height:7px;margin-top:-3.5px;left:calc(var(--toc-axis-x) - 3.5px);border-width:1.5px}
  @media(hover:hover) and (pointer:fine){
    .hrail-toc li:not(.hrail-act) a:hover{color:#2a1814;background:rgba(122,46,46,.05)}
    html.dark .hrail-toc li:not(.hrail-act) a:hover{color:#f6efe9;background:rgba(255,255,255,.03)}
  }

  .hrail-foot{display:flex;align-items:center;justify-content:space-between;margin-top:8px;padding:10px 6px 2px;border-top:1px solid rgba(0,0,0,.08)}
  html.dark .hrail-foot{border-top-color:rgba(255,255,255,.07)}
  .hrail-foot__btn{position:relative;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;color:#8a5a4a;cursor:pointer;
    transition:color .3s,transform .32s cubic-bezier(.34,1.56,.64,1);background:none;border:0;padding:0;font:inherit}
  html.dark .hrail-foot__btn{color:#caa1a0}
  @media(hover:hover) and (pointer:fine){
    .hrail-foot__btn:hover{color:#7a2e2e;transform:translateY(-1px) scale(1.06)}
    html.dark .hrail-foot__btn:hover{color:#f2c9c9}
  }
  .hrail-foot__btn svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .hrail-foot__btn--text{font-family:var(--f-serif,Lora,Georgia,serif);font-size:13px;font-weight:700}
  .hrail-foot .gb-save{width:34px;height:34px;color:#8a5a4a}
  html.dark .hrail-foot .gb-save{color:#caa1a0}
  .hrail-foot .gb-save svg{width:17px;height:17px}
  .hrail-foot .gb-save.is-saved{color:#b8724f}
  .hrail-foot .gb-save.is-saved svg{fill:#b8724f;stroke:#b8724f}
  html.dark .hrail-foot .gb-save.is-saved{color:#e0a89c}
  html.dark .hrail-foot .gb-save.is-saved svg{fill:#e0a89c;stroke:#e0a89c}
  .hrail-foot .theme-icon-sun,.hrail-foot .theme-icon-moon{display:grid;place-items:center}
  .hrail-foot .theme-icon-moon{display:none}
  html.dark .hrail-foot .theme-icon-sun{display:none}
  html.dark .hrail-foot .theme-icon-moon{display:grid}

  .hrail-top-play{position:fixed;top:28px;right:clamp(20px,3vw,44px);z-index:var(--z-sticky,1000)}
  .hrail-top-play__mini{--gbmini-size:48px}

  @media(max-width:1200px){ .hrail,.hrail-top-play{display:none} }

  /* Article column clears the fixed rail on desktop only — text stays centred
     in the viewport when there's room, the rail just hugs the left edge (Gill
     precedent). .article-main's own base rule sets width:min(820px,92vw) with
     margin:0 auto; a same-specificity override risks losing to load order, so
     this uses the doubled-class selector to win outright. */
  @media(min-width:1200px){
    .article-main.article-main--hrail{ margin-left: max((100vw - min(820px, 92vw)) / 2, 334px); }
  }
</style>

<script>
  function initHermenevtikaRail(){
    const toc = document.getElementById('hrailToc');
    const countEl = document.getElementById('hrailCount');
    if(!toc) return;
    const rows = Array.from(toc.querySelectorAll('li'));
    const links = rows.map((li) => li.querySelector('a'));
    const targets = links.map((a) => a ? document.querySelector(a.getAttribute('href') || '') : null);
    const track = toc.querySelector('.hrail-track') as HTMLElement | null;
    const trackFill = track ? track.querySelector('i') as HTMLElement | null : null;

    function setActive(idx: number){
      rows.forEach((li, i) => {
        li.classList.toggle('hrail-act', i === idx);
        li.classList.toggle('hrail-passed', i < idx);
      });
      if(countEl) countEl.textContent = `${idx + 1} / ${rows.length}`;
      if(trackFill) trackFill.style.setProperty('--track-progress', String((idx + 1) / rows.length));
    }

    let ticking = false;
    function onScroll(){
      if(ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        let idx = 0;
        const line = window.innerHeight * 0.3;
        targets.forEach((el, i) => {
          if(el && el.getBoundingClientRect().top <= line) idx = i;
        });
        setActive(idx);
      });
    }
    setActive(0);
    window.addEventListener('scroll', onScroll, { passive: true });

    const shareBtn = document.getElementById('hrailShare');
    if(shareBtn) shareBtn.addEventListener('click', async () => {
      const url = location.href;
      const title = document.title;
      try {
        if(navigator.share){ await navigator.share({ title, url }); return; }
      } catch(_) { /* user cancelled or unsupported — fall through to clipboard */ }
      try {
        await navigator.clipboard.writeText(url);
        shareBtn.setAttribute('data-tip', 'Ссылка скопирована');
      } catch(_) { /* clipboard unavailable — silently no-op */ }
    });

    const backBtn = document.querySelector('.hrail-back') as HTMLElement | null;
    if(backBtn){
      const href = backBtn.dataset.homeHref;
      if(href) backBtn.addEventListener('click', () => { window.location.href = href; });
    }
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHermenevtikaRail, { once: true });
  else initHermenevtikaRail();
</script>
