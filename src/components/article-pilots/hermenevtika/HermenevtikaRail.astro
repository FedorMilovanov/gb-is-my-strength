---
/**
 * HermenevtikaRail — тонкая обёртка над общим ReaderRail: подставляет
 * оглавление Герменевтики и её лист настроек (settingsTrigger='hm'). Вся
 * разметка/CSS/JS рельса живёт в ReaderRail (обобщён, чтобы одиночные статьи
 * не форкали рельс — kod-da-vinchi использует тот же ReaderRail).
 */
import ReaderRail from '../_shared/ReaderRail.astro';
import { HERMENEVTIKA_TOC } from './hermenevtikaToc';
import { projectStandaloneReaderToc } from '../_shared/series/readerTocProjection';
interface Props { eyebrow: string; title: string; backHref: string; }
const { eyebrow, title, backHref } = Astro.props;
// The original integrated Hermenevtika reader was explicitly selected for
// restoration. Keep one native TOC and one scroll/ReaderState owner on this
// route without requiring an unpublished preview-only environment flag.
const grokPilot = true;
const grokNodes = grokPilot ? projectStandaloneReaderToc(
  '/articles/hermenevticheskaya-otsenka-hristotsentrichnoy-germenevtiki/',
  HERMENEVTIKA_TOC.map(({ href, label, level }) => ({ id: href.slice(1), label, level })),
) : undefined;
---
<ReaderRail eyebrow={eyebrow} title={title} backHref={backHref} toc={HERMENEVTIKA_TOC} settingsTrigger="hm" grokPilot={grokPilot} grokNodes={grokNodes} />
