---
/**
 * HermenevtikaMobileBar — mobile (<1200px) control surface. Below 1200px the
 * desktop FloatingCluster + HermenevtikaRail are both hidden, so this is the
 * ONLY chrome — everything (theme/search/Play/save/font/TOC/share/PDF) lives
 * here across two fixed bars, ported from the approved mobile reference
 * (gb_single_mobile_v4_refined_no_accuracy.html):
 *
 *   TOP bar (fixed top): back → PlayEmber(canon .gb-ember) → search-slot
 *     slot-swaps for the speed rail when Play starts (same mechanic verified
 *     on GillSeriesRail's desktop topbar — search icon fades out, speed chips
 *     fade into the same slot, picked speed persists as a badge on Play) →
 *     save (binary toggle, no halo — SaveButton).
 *   BOTTOM bar (fixed bottom): reading-progress ring → "Сейчас читаете"
 *     (opens the TOC sheet) → theme → font A-/A+ → share.
 *   TOC sheet: local search filter over HERMENEVTIKA_TOC (own feature, not
 *     the sitewide data-fc-action="search" — that one opens the command
 *     palette from the top bar's search icon) + progress row + nav list +
 *     Share/PDF action row (same pattern as the desktop rail's hrail-actions).
 *
 * data-fc-action="theme"/"search"/"save"/"font-up"/"font-down" all go through
 * the existing global cluster delegation (data-fc-root on both bars) — only
 * the speed-slot swap and the TOC sheet are bar-local script here.
 */
import SaveButton from '@/components/ui/floating-cluster/SaveButton.astro';
import PlayEmber from '@/components/ui/floating-cluster/PlayEmber.astro';
import MobileChromeShell from '../_shared/MobileChromeShell.astro';
import { HERMENEVTIKA_TOC } from './hermenevtikaToc';

type HermenevtikaTocItem = (typeof HERMENEVTIKA_TOC)[number];

interface Props {
  title: string;
  backHref: string;
  readingMinutes?: number;
  /** Оглавление статьи. Дефолт — Герменевтика; КдВ передаёт своё
   *  (движок статей ОДИН, бар переиспользуется без форка). */
  toc?: typeof HERMENEVTIKA_TOC;
}
const { title, backHref, readingMinutes = 50, toc = HERMENEVTIKA_TOC } = Astro.props;
---
<MobileChromeShell
  engine="article"
  topClass="hmtop"
  bottomClass="hmbar"
  topAttrs={{ 'data-fc-root': true, 'data-fc-variant': 'single', 'data-fc-mode': 'single', 'data-gb-speed-custom': true }}
  bottomAttrs={{ 'data-fc-root': true, 'data-fc-variant': 'single', 'data-fc-mode': 'single' }}
>
  <button class="hm-icon" id="hmBackBtn" type="button" aria-label="Назад" data-home-href={backHref} slot="top-leading">
    <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
  </button>
  <div class="hm-slot" id="hmSlot" slot="top-primary">
    <label class="hm-slot-search" for="hmTocSearch">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
      <input id="hmTocSearch" type="text" placeholder="Поиск по разделам…" autocomplete="off" />
    </label>
    <div class="hm-speedrail" id="hmSpeedrail" role="radiogroup" aria-label="Скорость озвучки">
      <button class="hm-spd" type="button" role="radio" data-speed="1" aria-checked="true">1×</button>
      <button class="hm-spd" type="button" role="radio" data-speed="1.25" aria-checked="false">1.25×</button>
      <button class="hm-spd" type="button" role="radio" data-speed="1.5" aria-checked="false">1.5×</button>
      <button class="hm-spd" type="button" role="radio" data-speed="1.75" aria-checked="false">1.75×</button>
      <button class="hm-spd" type="button" role="radio" data-speed="2" aria-checked="false">2×</button>
    </div>
  </div>
  <span class="hm-playwrap" slot="top-playback">
    <PlayEmber audioState="none" class="hm-ember" tip="Озвучка" />
    <button class="hm-spdbadge" id="hmSpdBadge" type="button" aria-label="Выбрать скорость, сейчас 1×">1×</button>
  </span>
  <SaveButton class="hm-icon" tip="Сохранить" slot="top-trailing" />

  <button class="hmbar-progress" id="hmBottomBtn" type="button" aria-label="Открыть оглавление статьи" slot="bottom-progress">
    <svg aria-hidden="true" viewBox="0 0 36 36">
      <circle class="hmbar-progress-track" cx="18" cy="18" r="15.5" />
      <circle class="hmbar-progress-fill" id="hmProgressFill" cx="18" cy="18" r="15.5" stroke-dasharray="97.4" stroke-dashoffset="97.4" />
    </svg>
    <span class="hmbar-progress-text" id="hmProgressText">0%</span>
  </button>
  <button class="hmbar-section" id="hmSectionBtn" type="button" aria-label="Открыть оглавление статьи" slot="bottom-context">
    <span class="hmbar-section-label">Сейчас читаете</span>
    <span class="hmbar-section-name" id="hmSectionName">{toc[0]?.label}</span>
  </button>
  <Fragment slot="bottom-actions">
  <span class="hmbar-divider"></span>
  <button class="hmbar-btn gb-theme-toggle" data-fc-action="theme" aria-label="Тема">
    <span class="theme-icon-sun" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg></span>
    <span class="theme-icon-moon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg></span>
  </button>
  <button class="hmbar-btn" id="hmSettingsBtn" type="button" aria-label="Настройки чтения">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h11M4 12h7M4 17h13"/><circle cx="18" cy="7" r="2.2"/><circle cx="14" cy="12" r="2.2"/><circle cx="20" cy="17" r="2.2"/></svg>
  </button>
  <span class="hmbar-divider"></span>
  <button class="hmbar-btn" id="hmShareBtn" type="button" aria-label="Поделиться">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" /></svg>
  </button>
  </Fragment>

  <div class="hmsheet" id="hmSheet" aria-hidden="true" data-reading-minutes={readingMinutes} slot="overlays">
  <div class="hmsheet-backdrop" id="hmSheetBackdrop"></div>
  <div class="hmsheet-panel" role="dialog" aria-modal="true" aria-labelledby="hmSheetTitle">
    <div class="hmsheet-handle"></div>
    <div class="hmsheet-head">
      <div class="hmsheet-head-left">
        <div class="hmsheet-title" id="hmSheetTitle">Оглавление</div>
        <div class="hmsheet-subtitle" id="hmSheetSubtitle">{toc.length} разделов</div>
      </div>
      <button class="hmsheet-close" id="hmSheetClose" type="button" aria-label="Закрыть">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="hmsheet-progress-row">
      <div class="hmsheet-progress-wrap"><div class="hmsheet-progress-fill" id="hmSheetProgressFill" style="width:0%"></div></div>
      <span class="hmsheet-progress-pct" id="hmSheetProgressPct">0%</span>
    </div>
    <div class="hmsheet-time">
      <span>~{readingMinutes} мин чтения</span>
      <span id="hmSheetTimeLeft">Осталось: ~{readingMinutes} мин</span>
    </div>
    <label class="hmsheet-search" for="hmSheetSearch">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
      <input id="hmSheetSearch" type="text" placeholder="Поиск по разделам…" autocomplete="off">
    </label>
    <ul class="hmsheet-list" id="hmSheetList">
      {toc.map((item: HermenevtikaTocItem, i: number) => (
        <li class:list={{ 'hmsheet-sub': item.level === 3 }} data-idx={i}>
          <a href={item.href} class="hmsheet-link" data-name={item.label}>{item.label}</a>
        </li>
      ))}
      <li id="hmSheetEmpty" hidden class="hmsheet-empty">Ничего не найдено</li>
    </ul>
    <div class="hmsheet-actions">
      <SaveButton class="hmsheet-action-btn" tip="Сохранить" />
      <button class="hmsheet-action-btn" id="hmSheetShareBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="2.6" /><circle cx="6" cy="12" r="2.6" /><circle cx="18" cy="19" r="2.6" /><path d="M8.3 10.7l7.4-4.2M8.3 13.3l7.4 4.2" /></svg>
        <span>Поделиться</span>
      </button>
      <button class="hmsheet-action-btn" type="button" onclick="window.print()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2V11a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
        <span>PDF</span>
      </button>
    </div>
  </div>
  </div>
</MobileChromeShell>

<style is:global>
  .hmtop, .hmbar{display:none}
  @media(max-width:1199px){
    .hmtop{
      display:flex; align-items:center; gap:6px; position:fixed; left:0; right:0; top:0;
      z-index:var(--z-sticky,1000); padding:calc(env(safe-area-inset-top,0px) + 9px) 10px 8px;
      background:color-mix(in srgb, #fbf3ea 92%, transparent); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);
      border-bottom:1px solid #e8d9c8;
    }
    html.dark .hmtop{background:color-mix(in srgb, #1c0e14 90%, transparent); border-bottom-color:rgba(212,140,150,.16)}
    .hmbar{
      display:flex; align-items:center; gap:8px; position:fixed; left:0; right:0; bottom:0;
      z-index:var(--z-bottom-bar,2000); padding:8px 10px calc(8px + env(safe-area-inset-bottom,0px));
      background:linear-gradient(180deg,#fbf3ea,#f3e6d8); border-top:1px solid #e8d9c8;
      box-shadow:0 -8px 24px -12px rgba(122,46,46,.18);
    }
    html.dark .hmbar{
      background:linear-gradient(180deg,#241019,#150a0e); border-top-color:rgba(212,140,150,.16);
      box-shadow:0 -8px 24px -12px rgba(0,0,0,.5);
    }
    .article-main--hrail{ padding-top:calc(60px + env(safe-area-inset-top,0px)); padding-bottom: calc(84px + env(safe-area-inset-bottom,0px)); }
  }
  @media(min-width:1200px){ .hmtop, .hmbar{display:none !important} }

  /* ---- top bar: canon .gb-icon halo, slot-swap search⇄speeds, Play badge ---- */
  .hm-icon{width:38px;height:38px;flex-shrink:0;border-radius:50%;position:relative;display:grid;place-items:center;
    color:#8a5a4a;background:none;border:0;cursor:pointer;-webkit-tap-highlight-color:transparent}
  html.dark .hm-icon{color:#caa1a0}
  .hm-icon::before{content:'';position:absolute;inset:0;border-radius:50%;background:currentColor;opacity:0;transform:scale(.6);
    transition:opacity .18s ease,transform .22s cubic-bezier(.34,1.56,.64,1);pointer-events:none}
  @media(hover:hover) and (pointer:fine){ .hm-icon:hover::before{opacity:.08;transform:scale(1)} }
  .hm-icon:active::before{opacity:.14;transform:scale(1)}
  .hm-icon svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;position:relative}
  .hm-icon.gb-save.is-saved{color:#b8724f}
  .hm-icon.gb-save.is-saved svg{fill:#b8724f;stroke:#b8724f}
  html.dark .hm-icon.gb-save.is-saved{color:#e0a89c}
  html.dark .hm-icon.gb-save.is-saved svg{fill:#e0a89c;stroke:#e0a89c}

  .hm-slot{position:relative;flex:1;min-width:0;height:38px}
  /* Референс gb_single_mobile_v4_refined: .gb-search — широкий инпут с
     плейсхолдером «Поиск по разделам…», ЛОКАЛЬНЫЙ фильтр по оглавлению
     статьи (не глобальный сайтовый поиск/command palette). Раньше здесь
     была маленькая иконка с data-fc-action="search" — открывала совсем
     другую (сайтовую) панель, не то, что показано в образце. */
  .hm-slot-search{position:absolute;inset:0;margin:0;display:flex;align-items:center;gap:7px;
    height:38px;padding:0 12px;border-radius:999px;border:1px solid rgba(122,46,46,.18);
    background:rgba(122,46,46,.05);cursor:text;transition:opacity .25s ease,transform .25s cubic-bezier(.3,1.2,.4,1)}
  html.dark .hm-slot-search{border-color:rgba(224,160,150,.2);background:rgba(224,160,150,.06)}
  .hm-slot-search svg{width:15px;height:15px;stroke:#8a5a4a;fill:none;stroke-width:2;stroke-linecap:round;flex-shrink:0}
  html.dark .hm-slot-search svg{stroke:#caa1a0}
  .hm-slot-search input{flex:1;min-width:0;border:0;background:transparent;outline:0;
    font:13px "Source Sans 3",system-ui,sans-serif;color:#2a1814}
  html.dark .hm-slot-search input{color:#f2e9e6}
  .hm-slot-search input::placeholder{color:#8a5a4a;opacity:.75}
  html.dark .hm-slot-search input::placeholder{color:#caa1a0;opacity:.7}
  .hmtop.speed-open .hm-slot-search{opacity:0;transform:translateX(-8px);pointer-events:none}
  .hm-speedrail{position:absolute;inset:0;display:flex;align-items:center;gap:3px;
    opacity:0;transform:translateX(8px);pointer-events:none;transition:opacity .25s ease,transform .25s cubic-bezier(.3,1.2,.4,1);
    overflow-x:auto;overflow-y:hidden;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;
    scroll-snap-type:x proximity;cursor:grab}
  .hm-speedrail::-webkit-scrollbar{display:none}
  .hm-speedrail.is-dragging{cursor:grabbing;scroll-snap-type:none}
  .hmtop.speed-open .hm-speedrail{opacity:1;transform:translateX(0);pointer-events:auto}
  .hm-spd{flex:0 0 auto;font:700 10.5px/1 var(--f-ui,"Source Sans 3",system-ui,sans-serif);
    border:1px solid rgba(122,46,46,.22);background:transparent;color:#8a5a4a;padding:6px 8px;border-radius:8px;
    cursor:pointer;white-space:nowrap;position:relative;transition:background .15s,color .15s,border-color .15s,transform .12s;
    scroll-snap-align:center;-webkit-tap-highlight-color:transparent}
  html.dark .hm-spd{border-color:rgba(224,160,150,.24);color:#caa1a0}
  .hm-spd::before{content:'';position:absolute;inset:-7px -1px}
  .hm-spd:active{transform:scale(.92);transition-duration:.08s}
  .hm-spd[aria-checked="true"]{background:#7a2e2e;color:#fff;border-color:transparent}
  html.dark .hm-spd[aria-checked="true"]{background:#e0a89c;color:#2a1814}
  .hm-speedrail.is-dragging .hm-spd{transition:none}

  .hm-playwrap{position:relative;flex-shrink:0;display:grid;place-items:center}
  .hm-playwrap .hm-ember{--ember-size:38px}
  /* Позиция — точно как в референсе (.play-speed: right:-3px;bottom:-2px),
     не top: тот же баг (и тот же фикс), что был найден на Gill-баре. */
  .hm-spdbadge{position:absolute;right:-3px;bottom:-2px;z-index:2;min-width:18px;height:13px;padding:0 3px;border-radius:999px;
    border:1px solid #7a2e2e;background:#7a2e2e;color:#fff;font:800 8px/12px "Source Sans 3",system-ui,sans-serif;
    text-align:center;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,.28);transition:transform .18s cubic-bezier(.34,1.56,.64,1)}
  html.dark .hm-spdbadge{background:#e0a89c;border-color:#e0a89c;color:#2a1814}
  .hm-spdbadge::before{content:'';position:absolute;inset:-4px -3px}
  .hm-spdbadge:active{transform:scale(.94)}
  .hm-spdbadge.is-bump{animation:hm-spdbadge-bump .3s cubic-bezier(.34,1.56,.64,1)}
  @keyframes hm-spdbadge-bump{0%{transform:scale(1)}50%{transform:scale(1.16)}100%{transform:scale(1)}}

  /* ---- bottom bar: progress ring + section + theme/font/share ---- */
  .hmbar-progress{position:relative;width:36px;height:36px;flex-shrink:0;border:0;background:none;cursor:pointer;padding:0}
  .hmbar-progress svg{transform:rotate(-90deg);width:36px;height:36px}
  .hmbar-progress-track{fill:none;stroke:rgba(122,46,46,.15);stroke-width:3}
  html.dark .hmbar-progress-track{stroke:rgba(224,160,150,.18)}
  .hmbar-progress-fill{fill:none;stroke:#7a2e2e;stroke-width:3;stroke-linecap:round;transition:stroke-dashoffset .15s linear}
  html.dark .hmbar-progress-fill{stroke:#e0a89c}
  .hmbar-progress-text{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    font:700 9px "Source Sans 3",system-ui,sans-serif;color:#7a2e2e;pointer-events:none;font-variant-numeric:tabular-nums}
  html.dark .hmbar-progress-text{color:#e0a89c}
  .hmbar-section{flex:1;min-width:0;background:none;border:0;cursor:pointer;padding:6px 4px;text-align:left;
    display:flex;flex-direction:column;gap:2px;overflow:hidden;font:inherit}
  .hmbar-section-label{font:700 9px "Source Sans 3",system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;
    color:rgba(42,24,20,.55);opacity:.8}
  html.dark .hmbar-section-label{color:rgba(255,255,255,.55)}
  .hmbar-section-name{font:600 13px "Source Sans 3",system-ui,sans-serif;color:#2a1814;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  html.dark .hmbar-section-name{color:#f2e9e6}
  .hmbar-divider{width:1px;height:24px;background:rgba(0,0,0,.08);flex-shrink:0}
  html.dark .hmbar-divider{background:rgba(255,255,255,.08)}
  .hmbar-btn{position:relative;width:36px;height:36px;border:0;background:none;cursor:pointer;border-radius:50%;
    display:grid;place-items:center;color:#8a5a4a;flex-shrink:0}
  html.dark .hmbar-btn{color:#caa1a0}
  .hmbar-btn svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .hmbar-font{width:32px;height:36px;border:0;background:none;cursor:pointer;border-radius:8px;
    display:grid;place-items:center;font:700 15px var(--f-serif,Lora,Georgia,serif);color:#8a5a4a;flex-shrink:0}
  html.dark .hmbar-font{color:#caa1a0}

  /* ---- TOC sheet ---- */
  .hmsheet{display:none}
  .hmsheet.is-open{display:block}
  .hmsheet-backdrop{position:fixed;inset:0;background:rgba(20,10,8,.42);z-index:var(--z-overlay,2500)}
  .hmsheet-panel{position:fixed;left:0;right:0;bottom:0;z-index:var(--z-overlay-high,3000);
    max-height:80vh;display:flex;flex-direction:column;border-radius:20px 20px 0 0;
    padding:8px 18px calc(14px + env(safe-area-inset-bottom,0px));
    background:#fbf3ea;box-shadow:0 -20px 50px -10px rgba(0,0,0,.35);
    transform:translateY(100%);transition:transform .3s cubic-bezier(.22,1,.36,1)}
  .hmsheet.is-open .hmsheet-panel{transform:translateY(0)}
  html.dark .hmsheet-panel{background:#1c0e14;box-shadow:0 -20px 50px -10px rgba(0,0,0,.6)}
  .hmsheet-handle{width:36px;height:4px;border-radius:2px;background:rgba(0,0,0,.15);margin:0 auto 8px}
  html.dark .hmsheet-handle{background:rgba(255,255,255,.15)}
  .hmsheet-head{display:flex;align-items:flex-start;justify-content:space-between;padding-bottom:8px}
  .hmsheet-title{font-family:var(--f-serif,Lora,Georgia,serif);font-weight:700;font-size:16px;color:#2a1814}
  html.dark .hmsheet-title{color:#f2e9e6}
  .hmsheet-subtitle{font-size:11px;color:rgba(42,24,20,.55);margin-top:2px}
  html.dark .hmsheet-subtitle{color:rgba(255,255,255,.5)}
  .hmsheet-close{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;border:0;
    background:rgba(122,46,46,.08);color:#7a2e2e;cursor:pointer;flex-shrink:0}
  html.dark .hmsheet-close{background:rgba(224,160,150,.1);color:#e0a89c}
  .hmsheet-close svg{width:15px;height:15px}
  .hmsheet-progress-row{display:flex;align-items:center;gap:10px;padding-bottom:8px}
  .hmsheet-progress-wrap{flex:1;height:4px;background:rgba(0,0,0,.08);border-radius:2px;overflow:hidden}
  html.dark .hmsheet-progress-wrap{background:rgba(255,255,255,.1)}
  .hmsheet-progress-fill{height:100%;background:#7a2e2e;border-radius:2px;transition:width .15s linear}
  html.dark .hmsheet-progress-fill{background:#e0a89c}
  .hmsheet-progress-pct{font:700 11px "Source Sans 3",system-ui,sans-serif;color:#7a2e2e;min-width:30px;text-align:right}
  html.dark .hmsheet-progress-pct{color:#e0a89c}
  .hmsheet-time{display:flex;justify-content:space-between;font-size:11px;color:rgba(42,24,20,.55);padding-bottom:10px}
  html.dark .hmsheet-time{color:rgba(255,255,255,.5)}
  .hmsheet-search{display:flex;align-items:center;gap:8px;height:38px;background:rgba(122,46,46,.05);
    border:1px solid rgba(122,46,46,.14);border-radius:999px;padding:0 12px;margin-bottom:8px;flex-shrink:0}
  html.dark .hmsheet-search{background:rgba(224,160,150,.06);border-color:rgba(224,160,150,.16)}
  .hmsheet-search svg{width:15px;height:15px;stroke:rgba(42,24,20,.5);fill:none;stroke-width:2;stroke-linecap:round;flex-shrink:0}
  html.dark .hmsheet-search svg{stroke:rgba(255,255,255,.5)}
  .hmsheet-search input{flex:1;min-width:0;border:0;background:transparent;outline:0;font-size:13.5px;color:#2a1814}
  html.dark .hmsheet-search input{color:#f2e9e6}
  .hmsheet-list{list-style:none;margin:0;padding:0 0 4px;overflow-y:auto;flex:1;min-height:0}
  .hmsheet-list li{margin:0}
  .hmsheet-link{display:block;padding:9px 4px;color:rgba(42,24,20,.72);text-decoration:none;
    font-family:var(--f-serif,Lora,Georgia,serif);font-size:14px;border-bottom:1px solid rgba(0,0,0,.05)}
  html.dark .hmsheet-link{color:rgba(255,255,255,.68);border-bottom-color:rgba(255,255,255,.06)}
  .hmsheet-sub .hmsheet-link{padding-left:18px;font-size:13px;color:rgba(42,24,20,.55)}
  html.dark .hmsheet-sub .hmsheet-link{color:rgba(255,255,255,.5)}
  li[data-idx].hm-current .hmsheet-link{color:#7a2e2e;font-weight:700}
  html.dark li[data-idx].hm-current .hmsheet-link{color:#e0a89c}
  li[hidden]{display:none}
  .hmsheet-empty{padding:24px 4px;text-align:center;color:rgba(42,24,20,.5);font-size:13px}
  html.dark .hmsheet-empty{color:rgba(255,255,255,.5)}
  .hmsheet-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding-top:10px;border-top:1px solid rgba(0,0,0,.08);flex-shrink:0}
  html.dark .hmsheet-actions{border-top-color:rgba(255,255,255,.08)}
  .hmsheet-action-btn{display:flex;flex-direction:column;align-items:center;gap:4px;padding:9px 4px;border-radius:12px;
    color:#8a5a4a;background:rgba(122,46,46,.05);border:1px solid rgba(122,46,46,.12);cursor:pointer;font:inherit}
  html.dark .hmsheet-action-btn{color:#caa1a0;background:rgba(224,160,150,.05);border-color:rgba(224,160,150,.14)}
  .hmsheet-action-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .hmsheet-action-btn span{font-size:9.5px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;white-space:nowrap}
  .hmsheet-action-btn.gb-save{width:auto;height:auto}
  .hmsheet-action-btn.gb-save::after{content:'Сохранить';font-size:9.5px;font-weight:800;letter-spacing:.02em;text-transform:uppercase}
  .hmsheet-action-btn.gb-save.is-saved{color:#b8724f;background:rgba(184,114,79,.10);border-color:rgba(184,114,79,.3)}
  .hmsheet-action-btn.gb-save.is-saved svg{fill:#b8724f;stroke:#b8724f}
  html.dark .hmsheet-action-btn.gb-save.is-saved{color:#e0a89c;background:rgba(224,168,156,.12);border-color:rgba(224,168,156,.32)}

  /* На десктопе прячем мобильные листы бара, КРОМЕ листа настроек чтения
     (.hmsettings): его теперь открывает шестерёнка в HermenevtikaRail
     (#hrailSettingsBtn). Раньше это !important гасил и настройки на десктопе. */
  @media(min-width:1200px){ .hmsheet:not(.hmsettings){display:none !important} }
</style>

<script>
  import { initSpeedSlot } from '../_shared/speedSlot';

  function initHermenevtikaMobileBar(){
    const topbar = document.querySelector('.hmtop[data-gb-speed-custom]') as HTMLElement | null;
    if (topbar) initSpeedSlot(topbar, {
      ember: '.hm-ember',
      speedrail: '.hm-speedrail',
      badge: '.hm-spdbadge',
      chip: '.hm-spd',
      searchInput: '#hmTocSearch',
    });

    const backBtn = document.getElementById('hmBackBtn');
    if (backBtn) backBtn.addEventListener('click', () => {
      const href = (backBtn as HTMLElement).dataset.homeHref;
      if (href) window.location.href = href;
    });

    // ---- TOC sheet: open/close, search filter, scrollspy, progress ----
    const sheet = document.getElementById('hmSheet');
    const backdrop = document.getElementById('hmSheetBackdrop');
    const closeBtn = document.getElementById('hmSheetClose');
    const bottomBtn = document.getElementById('hmBottomBtn');
    const sectionBtn = document.getElementById('hmSectionBtn');
    if (!sheet) return;
    const OVERLAY_OWNER = 'hermenevtika-toc';
    const overlayRuntime = () => (window as any).OverlayRuntime || null;
    const fallbackUtils = () => (window as any).SiteUtils || null;

    const closeSheet = (reason = 'programmatic', restoreFocus = true) => {
      sheet.classList.remove('is-open');
      sheet.setAttribute('aria-hidden', 'true');
      const runtime = overlayRuntime();
      if (runtime?.close) runtime.close(OVERLAY_OWNER, reason, { restoreFocus });
      else fallbackUtils()?.unlockScroll?.(OVERLAY_OWNER);
    };

    const openSheet = (opener?: EventTarget | null) => {
      sheet.classList.add('is-open');
      sheet.setAttribute('aria-hidden', 'false');
      const runtime = overlayRuntime();
      if (runtime?.open) runtime.open(OVERLAY_OWNER, {
        element: sheet,
        opener: opener instanceof Element ? opener : document.activeElement,
        onRequestClose: (closeReason: string) => closeSheet(closeReason, true),
        closeOnEscape: true,
        trapFocus: true
      });
      else fallbackUtils()?.lockScroll?.(OVERLAY_OWNER);
    };
    bottomBtn?.addEventListener('click', (event) => openSheet(event.currentTarget));
    sectionBtn?.addEventListener('click', (event) => openSheet(event.currentTarget));
    backdrop?.addEventListener('click', () => closeSheet('backdrop', true));
    closeBtn?.addEventListener('click', () => closeSheet('button', true));
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (!overlayRuntime() && e.key === 'Escape' && sheet.classList.contains('is-open')) closeSheet('escape', true);
    });
    sheet.querySelectorAll('.hmsheet-link').forEach((a) => a.addEventListener('click', () => closeSheet('navigate', false)));


    const rows = Array.from(document.querySelectorAll('#hmSheetList li[data-idx]')) as HTMLElement[];
    const links = rows.map((li) => li.querySelector('a') as HTMLAnchorElement | null);
    const targets = links.map((a) => a ? document.querySelector(a.getAttribute('href') || '') as HTMLElement | null : null);
    const sectionName = document.getElementById('hmSectionName');
    const progressFill = document.getElementById('hmProgressFill') as HTMLElement | null;
    const progressText = document.getElementById('hmProgressText');
    const sheetProgressFill = document.getElementById('hmSheetProgressFill');
    const sheetProgressPct = document.getElementById('hmSheetProgressPct');
    const sheetTimeLeft = document.getElementById('hmSheetTimeLeft');
    const CIRC = 97.4;
    const readingMinutesAttr = document.getElementById('hmSheet')?.getAttribute('data-reading-minutes');
    const READING_MINUTES = readingMinutesAttr ? parseInt(readingMinutesAttr, 10) : 50;

    function setActive(idx: number){
      rows.forEach((li, i) => li.classList.toggle('hm-current', i === idx));
      if (sectionName && links[idx]) sectionName.textContent = (links[idx] as HTMLAnchorElement).dataset.name || '';
    }

    let ticking = false;
    function onScroll(){
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        let idx = 0;
        const line = window.innerHeight * 0.3;
        targets.forEach((el, i) => { if (el && el.getBoundingClientRect().top <= line) idx = i; });
        setActive(idx);
        const docH = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docH > 0 ? Math.min(100, Math.max(0, Math.round((window.scrollY / docH) * 100))) : 0;
        if (progressFill) progressFill.style.strokeDashoffset = String(CIRC * (1 - pct / 100));
        if (progressText) progressText.textContent = pct + '%';
        if (sheetProgressFill) (sheetProgressFill as HTMLElement).style.width = pct + '%';
        if (sheetProgressPct) sheetProgressPct.textContent = pct + '%';
        if (sheetTimeLeft) sheetTimeLeft.textContent = 'Осталось: ~' + Math.max(0, Math.round(READING_MINUTES - READING_MINUTES * pct / 100)) + ' мин';
      });
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // local TOC search filter (own feature — not the sitewide command palette).
    // Референс: одно и то же поле фильтрации — в топбаре (#hmTocSearch,
    // сворачивает рельсу скоростей на своё место) и внутри самой панели
    // оглавления (#hmSheetSearch) — оба фильтруют один и тот же список.
    const topSearchInput = document.getElementById('hmTocSearch') as HTMLInputElement | null;
    const sheetSearchInput = document.getElementById('hmSheetSearch') as HTMLInputElement | null;
    const subtitle = document.getElementById('hmSheetSubtitle');
    const empty = document.getElementById('hmSheetEmpty');
    function plural(n: number): string { return n === 1 ? 'раздел' : (n >= 2 && n <= 4 ? 'раздела' : 'разделов'); }
    function filterToc(q: string): number {
      const needle = q.trim().toLowerCase();
      let shown = 0;
      rows.forEach((li) => {
        const a = li.querySelector('a');
        const hit = !needle || (a?.textContent || '').toLowerCase().indexOf(needle) > -1;
        li.hidden = !hit;
        if (hit) shown++;
      });
      if (subtitle) subtitle.textContent = shown + ' ' + plural(shown);
      if (empty) empty.hidden = shown !== 0;
      return shown;
    }
    sheetSearchInput?.addEventListener('input', () => filterToc(sheetSearchInput.value));
    topSearchInput?.addEventListener('input', () => {
      filterToc(topSearchInput.value);
      // Референс: реальный запрос открывает панель; очистка поля — нет
      // (иначе стирание текста после закрытия само её снова открывает).
      if (topSearchInput.value.trim()) openSheet();
    });

    // share (both top-bar-adjacent bottom bar button and sheet footer button)
    async function share() {
      const url = location.href;
      const title = document.title;
      try {
        if (navigator.share) { await navigator.share({ title, url }); return; }
      } catch (_) {}
      try { await navigator.clipboard.writeText(url); } catch (_) {}
    }
    document.getElementById('hmShareBtn')?.addEventListener('click', share);
    document.getElementById('hmSheetShareBtn')?.addEventListener('click', share);

    // Шестерёнка «Настройки чтения» — открывает отдельный лист
    // (ReaderSettings слушает это событие). Перед открытием гасим
    // TOC-лист, чтобы одновременно был открыт ровно один лист.
    document.getElementById('hmSettingsBtn')?.addEventListener('click', () => {
      closeSheet();
      document.dispatchEvent(new CustomEvent('hm:open-settings'));
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHermenevtikaMobileBar, { once: true });
  else initHermenevtikaMobileBar();
</script>
