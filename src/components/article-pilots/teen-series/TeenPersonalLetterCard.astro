---
import { statSync } from 'node:fs';
import { resolve } from 'node:path';
import { assertTeenPersonalLetterMedia, type TeenPersonalLetterCard } from './teenPersonalLetterCard';

interface Props {
  card: TeenPersonalLetterCard;
}

const { card } = Astro.props;
assertTeenPersonalLetterMedia(card, (url) => {
  try {
    const file = statSync(resolve(process.cwd(), 'public', url.slice(1)));
    return file.isFile() && file.size > 0;
  } catch {
    return false;
  }
});
---
<section
  class="teen-letter"
  aria-labelledby="teen-personal-letter-title"
  data-teen-personal-letter={card.kind}
  data-pagefind-ignore={card.kind === 'preview' ? 'all' : undefined}
>
  {card.media && (
    <figure class="teen-letter__artwork">
      <img
        src={card.media.src}
        srcset={card.media.srcset}
        sizes="(max-width: 48rem) calc(100vw - 2rem), 820px"
        width="1600"
        height="900"
        alt={card.media.alt}
        loading="lazy"
        decoding="async"
      />
    </figure>
  )}
  <div class="teen-letter__content">
    <p class="teen-letter__kicker">
      <span>Личное обращение</span>
      {card.readingTime && <span class="teen-letter__time"> · {card.readingTime} мин</span>}
    </p>
    <h2 id="teen-personal-letter-title">{card.title}</h2>
    <p class="teen-letter__description">{card.description}</p>
    {card.kind === 'published' ? (
      <a class="teen-letter__link" href={card.href} aria-label={`Читать личное обращение: ${card.title}`}>
        Читать обращение
        <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
          <path d="M4 10h11m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    ) : (
      <p class="teen-letter__preview">Предпросмотр · статья ещё не опубликована</p>
    )}
  </div>
</section>
<style>
  .teen-letter {
    overflow: hidden;
    margin: 0 0 2.5rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-inline-start: 3px solid var(--color-accent);
    border-radius: 1.25rem;
    color: var(--color-text);
    background: var(--color-surface-quote, var(--color-surface));
  }
  .teen-letter__artwork { margin: 0; padding: 0; }
  .teen-letter__artwork img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
  }
  .teen-letter__content {
    min-width: 0;
    padding: clamp(1.25rem, 4vw, 2.25rem);
  }
  .teen-letter__content p, .teen-letter__content h2 { text-align: start; }
  .teen-letter__kicker {
    margin: 0 0 .65rem;
    font-size: .8rem;
    line-height: 1.5;
    font-weight: 700;
    letter-spacing: .035em;
    text-transform: uppercase;
  }
  .teen-letter__time { font-weight: 400; letter-spacing: 0; text-transform: none; }
  .teen-letter h2 {
    margin: 0 0 .65rem;
    padding: 0;
    border: 0;
    color: inherit;
    font-size: clamp(1.45rem, 3.5vw, 2.2rem);
    line-height: 1.26;
    overflow-wrap: break-word;
    max-width: 36rem;
  }
  .teen-letter__description {
    margin: 0 0 1rem;
    font-size: 1rem;
    line-height: 1.65;
    max-width: 36rem;
  }
  .teen-letter__link {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-height: 44px;
    max-width: 100%;
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .22em;
  }
  .teen-letter__link svg { flex: 0 0 20px; }
  .teen-letter__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: .2rem;
  }
  .teen-letter__preview { margin: .35rem 0 0; font-size: .875rem; }
</style>
