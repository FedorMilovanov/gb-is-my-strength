---
import { assetUrl } from '@/lib/asset-version';
import ReaderFloatingControlsRuntime from '@/components/reader-platform/ReaderFloatingControlsRuntime.astro';
import ReaderActionsRuntime from '@/components/reader-platform/ReaderActionsRuntime.astro';
import SiteSectionsMenu from '../SiteSectionsMenu.astro';
import GillSeriesRail from '../../gill-series/GillSeriesRail.astro';
import GillSeriesMobileBar from '../../gill-series/GillSeriesMobileBar.astro';
import GillMobileOverlayActivationBoundary from '../../gill-series/GillMobileOverlayActivationBoundary.astro';
import GillSeriesOverlay from '../../gill-series/GillSeriesOverlay.astro';
import GillPartTocOverlay from '../../gill-series/GillPartTocOverlay.astro';
import GillLearningSheet from '../../gill-series/GillLearningSheet.astro';
import GillReaderSettingsSheet from '../../gill-series/GillReaderSettingsSheet.astro';
import GillSeriesImagePremium from '../../gill-series/GillSeriesImagePremium.astro';
import GillSeriesResponsiveStyles from '../../gill-series/GillSeriesResponsiveStyles.astro';
import { GILL_SERIES, type SeriesConfig } from './seriesConfig';


interface Props {
  pageId: string;
  config?: SeriesConfig;
}

const { pageId, config = GILL_SERIES } = Astro.props;
const page = config.pages[pageId];
---
<GillSeriesImagePremium />
<GillSeriesResponsiveStyles />
<style is:global>
  /* Final calibration from the 390/768/1440 Playwright witness. */
  @media (max-width: 640px) {
    [data-gill-v16] .gbs2-hero-cap { font-size: 11px; }
  }
  @media (min-width: 64em) {
    [data-gill-v16="context"] .gbs2-current-cover { --gbs2-cover-position: 100% 50%; }
  }
</style>
<a class="skip-link" href="#main-content">Перейти к содержимому</a>

<SiteSectionsMenu />

<div class="gbs2-world" data-reader-engine="series" data-reader-shape={config.shape ?? 'flat'} data-gill-v16={pageId} data-series-theme={config.theme}>
  <GillSeriesRail pageId={pageId} config={config} />

  <div class="page-wrap" id="content">
    <nav aria-label="Хлебные крошки" class="breadcrumb"><ol class="breadcrumb__list"><li class="breadcrumb__item"><a class="breadcrumb__link" href="../../"><span aria-hidden="true" class="breadcrumb__home">⌂</span> Главная</a></li><li class="breadcrumb__item"><a class="breadcrumb__link" href={config.breadcrumbParent.href}>{config.breadcrumbParent.label}</a></li><li aria-current="page" class="breadcrumb__item"><span class="breadcrumb__current">{page.label}</span></li></ol></nav>
    <slot />
  </div>

  <GillSeriesMobileBar pageId={pageId} config={config} />
  <GillSeriesOverlay pageId={pageId} config={config} />
  <GillPartTocOverlay pageId={pageId} config={config} />
  <GillLearningSheet pageId={pageId} config={config} />
  <GillReaderSettingsSheet config={config} />
  <GillMobileOverlayActivationBoundary />
</div><!-- /gbs2-world: overlays+bottom-bar nested so [data-gill-v16] descendant CSS applies -->

<script is:inline defer src={assetUrl('js/bookmark-engine.js')}></script>
<script is:inline defer src={assetUrl('js/site-utils.js')}></script>
<script is:inline defer src={assetUrl('js/scroll-perf.js')}></script>
<script is:inline defer src={assetUrl('js/glossary.js')}></script>
<script is:inline defer src={assetUrl('js/sw-register.js')}></script>

<script is:inline defer src={assetUrl('js/highlights.js')}></script>
<!-- Gill routes are fully owned by the native article interaction modules below.
     The legacy enhancements bundle is intentionally absent: loading both owners
     recreated reader controls and competed for glossary/quiz interaction state. -->
<ReaderFloatingControlsRuntime />
<ReaderActionsRuntime />