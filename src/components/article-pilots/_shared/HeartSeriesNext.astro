---
/**
 * HeartSeriesNext — the «Соседние части серии» prev/next cards (.gbs2-next),
 * derived from series order. Roman pages chain among roman entries; the label
 * book-ends link inward to the nearest roman. Reorder-safe.
 */
import { heartNeighbors, type HeartPageId } from './heartSeriesData';

interface Props { pageId: HeartPageId }
const { pageId } = Astro.props;
const neighbors = heartNeighbors(pageId);
const dirWord = (dir: 'prev' | 'next') => (dir === 'prev' ? 'Назад по серии' : 'Дальше по серии');
const cover = (img: string | null) =>
  img ? `background-image:url('../../images/${img}')` : 'background:var(--color-surface-muted,#f4f2ed)';
---
<nav aria-label="Соседние части серии" class="gbs2-next">{neighbors.map((n) => (
  <a class="gbs2-next-card" href={`../${n.item.slug}/`}><span class="gbs2-next-cover" style={cover(n.item.thumbImg)}></span><span><span class="gbs2-next-eyebrow">{dirWord(n.dir)} · {n.eyebrowN} · ~{n.item.minutes} мин</span><span class="gbs2-next-title">{n.item.cardTitle}</span><span class="gbs2-next-desc">{n.item.cardDesc}</span></span></a>
))}</nav>
