---
/**
 * SiteSectionsMenuRuntime.astro
 *
 * One runtime owner for #hMobileMenuBtn -> #hMobileNav across native readers,
 * series readers and legacy-style landing shells. Visual markup stays route-
 * appropriate; lifecycle is always delegated to the shared OverlayRuntime.
 */
---
<script is:inline>
  (() => {
    'use strict';

    const VERSION = 7;
    const OWNER_ID = 'site-sections-menu';
    const API_KEY = 'GBSiteSectionsMenu';
    const CONTROLLER_KEY = '__gbSiteSectionsMenuController';

    if (window[API_KEY]?.version === VERSION && typeof window[API_KEY].init === 'function') {
      window[API_KEY].init();
      return;
    }

    const desktopMenu = () => Boolean(window.matchMedia?.('(min-width: 85em)').matches);
    const firstAction = (panel) => (
      (desktopMenu() && panel.querySelector('[data-gb-menu-filter]'))
      || panel.querySelector('a[href]:not([hidden]),button:not([disabled]):not([hidden]),[tabindex]:not([tabindex="-1"])')
    );

    function init() {
      const trigger = document.getElementById('hMobileMenuBtn');
      const panel = document.getElementById('hMobileNav');
      const backdrop = document.getElementById('hMobileBackdrop');
      const previous = window[CONTROLLER_KEY];

      if (!trigger || !panel) {
        previous?.destroy?.();
        return null;
      }

      if (
        previous
        && previous.version === VERSION
        && previous.trigger === trigger
        && previous.panel === panel
        && trigger.isConnected
        && panel.isConnected
      ) return previous;

      previous?.destroy?.();

      const overlayApi = window.OverlayRuntime;
      if (!overlayApi || typeof overlayApi.register !== 'function') return null;

      let controller;
      let nativeHideTimer = 0;
      // This is only a local view over six server-rendered menu destinations.
      // GBSearch still exclusively owns search; OverlayRuntime owns the overlay.
      const filter = panel.querySelector('[data-gb-menu-filter]');
      const clearFilter = panel.querySelector('[data-gb-menu-clear]');
      const status = panel.querySelector('[data-gb-menu-status]');
      const empty = panel.querySelector('[data-gb-menu-empty]');
      const entries = [...panel.querySelectorAll('a[data-gb-menu-section]')];
      const groupTitles = [...panel.querySelectorAll('[data-gb-menu-group-title]')];
      const desktopQuery = window.matchMedia?.('(min-width: 85em)');
      const normalize = (value) => String(value || '').toLocaleLowerCase('ru-RU')
        .normalize('NFKC').replace(/ё/g, 'е').replace(/\s+/g, ' ').trim();
      const firstVisible = () => entries.find((node) => !node.hidden);
      const renderFilter = () => {
        if (!filter) return;
        const term = desktopMenu() ? normalize(filter.value) : '';
        const words = term ? term.split(' ') : [];
        let visible = 0;
        for (const link of entries) {
          const match = words.every((word) => normalize(link.textContent).includes(word));
          link.hidden = !match;
          if (match) visible++;
        }
        for (const heading of groupTitles) {
          const group = heading.getAttribute('data-gb-menu-group-title');
          heading.hidden = !entries.some((link) => !link.hidden && link.getAttribute('data-gb-menu-group') === group);
        }
        if (clearFilter) clearFilter.hidden = !filter.value;
        if (empty) empty.hidden = visible !== 0;
        if (status) status.textContent = term
          ? (visible ? 'Найдено разделов: ' + visible : 'Совпадений нет')
          : 'Всего разделов: ' + visible;
      };
      const onFilterInput = () => renderFilter();
      const onFilterKeydown = (event) => {
        if (!desktopMenu() || (event.key !== 'ArrowDown' && event.key !== 'Enter')) return;
        const link = firstVisible();
        if (!link) return;
        event.preventDefault();
        link.focus({ preventScroll: false });
      };
      const onFilterClear = () => {
        if (!filter) return;
        filter.value = '';
        renderFilter();
        filter.focus({ preventScroll: true });
      };
      const onPanelKeydown = (event) => {
        if (!desktopMenu() || event.key !== 'ArrowUp' || event.target !== firstVisible()) return;
        event.preventDefault();
        filter?.focus({ preventScroll: true });
      };
      const onDesktopChange = () => {
        // A focused desktop search field disappears at the responsive boundary.
        // Keep keyboard focus inside the open canonical menu rather than losing
        // it to <body> when the browser hides that field.
        const active = document.activeElement;
        const focusLost = active === filter || active === document.body
          || (active && !active.getClientRects().length);
        if (!desktopMenu() && filter) filter.value = '';
        renderFilter();
        if (!panel.hidden && focusLost) {
          (desktopMenu() ? filter : firstVisible())?.focus({ preventScroll: true });
        }
      };
      filter?.addEventListener('input', onFilterInput);
      filter?.addEventListener('keydown', onFilterKeydown);
      clearFilter?.addEventListener('click', onFilterClear);
      panel.addEventListener('keydown', onPanelKeydown);
      desktopQuery?.addEventListener?.('change', onDesktopChange);
      renderFilter();

      const hasExitTransition = () => {
        if (!panel.isConnected) return false;
        if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return false;
        const durations = window.getComputedStyle(panel).transitionDuration.split(',');
        return durations.some((raw) => {
          const value = raw.trim();
          const amount = Number.parseFloat(value);
          if (!Number.isFinite(amount) || amount <= 0) return false;
          return value.endsWith('ms') ? amount > 0 : amount * 1000 > 0;
        });
      };
      const hideNatively = () => {
        if (panel.classList.contains('open')) return;
        panel.hidden = true;
        if (backdrop) backdrop.hidden = true;
        window.clearTimeout(nativeHideTimer);
        nativeHideTimer = 0;
      };
      const onPanelTransitionSettled = (event) => {
        if (event.target !== panel || panel.classList.contains('open')) return;
        hideNatively();
      };
      const syncVisual = (open) => {
        window.clearTimeout(nativeHideTimer);
        nativeHideTimer = 0;

        if (open) {
          panel.hidden = false;
          if (backdrop) backdrop.hidden = false;
        }

        panel.classList.toggle('open', open);
        panel.toggleAttribute('inert', !open);
        if ('inert' in panel) panel.inert = !open;
        if (open) panel.removeAttribute('aria-hidden');
        else panel.setAttribute('aria-hidden', 'true');

        trigger.classList.toggle('is-open', open);
        trigger.setAttribute('aria-controls', panel.id || 'hMobileNav');
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        trigger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
        trigger.setAttribute('data-gb-site-menu-owner', 'canonical-runtime');
        backdrop?.classList.toggle('open', open);

        if (!open) {
          if (!hasExitTransition()) hideNatively();
          else nativeHideTimer = window.setTimeout(hideNatively, 260);
        }
      };

      const layer = overlayApi.register(OWNER_ID, {
        element: panel,
        opener: trigger,
        focusTarget: () => firstAction(panel),
        closeOnEscape: true,
        trapFocus: true,
        restoreFocus: true,
        lockScroll: true,
        onRequestClose: () => {
          syncVisual(false);
          return true;
        },
      });

      const open = (reason = 'trigger') => {
        if (layer.isOpen()) return true;
        // The site menu and reader settings are alternate views of the same
        // rail. Close the canonical settings overlay before opening this one;
        // OverlayRuntime remains the single scroll-lock/focus owner.
        if (overlayApi.isOpen('reader-settings')) {
          overlayApi.requestClose('reader-settings', 'switch');
        }
        if (filter) { filter.value = ''; renderFilter(); }
        syncVisual(true);
        layer.open({
          element: panel,
          opener: trigger,
          focusTarget: () => firstAction(panel),
          reason,
        });
        panel.removeAttribute('aria-hidden');
        // OverlayRuntime owns the generic focus lifecycle. Keep the menu's
        // concrete focus target deterministic as well: WebKit can retain the
        // trigger after programmatic layer.open(), which leaves the visible
        // panel open but fails the keyboard-accessibility contract. Focus the
        // first real action on the next frame, after the open state is painted.
        requestAnimationFrame(() => {
          if (!layer.isOpen() || panel.hidden || panel.hasAttribute('inert')) return;
          const target = firstAction(panel);
          if (target instanceof HTMLElement) target.focus({ preventScroll: true });
        });
        return true;
      };

      const close = (reason = 'close', options = {}) => {
        if (!layer.isOpen()) {
          syncVisual(false);
          return false;
        }
        syncVisual(false);
        return layer.close(reason, options);
      };

      const onTrigger = (event) => {
        event.preventDefault();
        if (layer.isOpen()) close('toggle');
        else open('trigger');
      };
      const onBackdrop = () => close('backdrop');
      const onDocumentPointerDown = (event) => {
        if (!layer.isOpen() || !window.matchMedia('(min-width: 64em)').matches) return;
        const target = event.target;
        if (!(target instanceof Node)) return;
        // A desktop menu is an anchored, nonmodal popover: the mobile-only
        // backdrop has no hit area at desktop widths. Outside pointerdown
        // closes it, while interaction with the menu or its button remains.
        if (panel.contains(target) || trigger.contains(target)) return;
        close('outside');
      };
      const onPanelClick = (event) => {
        const action = event.target?.closest?.('[data-close-nav]');
        if (action) close('menu-action');
      };
      const onPageShow = (event) => {
        if (event.persisted) close('pageshow', { restoreFocus: false });
      };

      const legacyClose = () => close('legacy-api');
      trigger.addEventListener('click', onTrigger);
      panel.addEventListener('click', onPanelClick);
      panel.addEventListener('transitionend', onPanelTransitionSettled);
      panel.addEventListener('transitioncancel', onPanelTransitionSettled);
      backdrop?.addEventListener('click', onBackdrop);
      document.addEventListener('pointerdown', onDocumentPointerDown);
      window.addEventListener('pageshow', onPageShow);
      window.closeMobileNav = legacyClose;
      syncVisual(false);

      controller = {
        version: VERSION,
        ownerId: OWNER_ID,
        trigger,
        panel,
        backdrop,
        open,
        close,
        toggle: () => layer.isOpen() ? close('api-toggle') : open('api-toggle'),
        isOpen: () => layer.isOpen(),
        destroy: () => {
          window.clearTimeout(nativeHideTimer);
          nativeHideTimer = 0;
          filter?.removeEventListener('input', onFilterInput);
          filter?.removeEventListener('keydown', onFilterKeydown);
          clearFilter?.removeEventListener('click', onFilterClear);
          panel.removeEventListener('keydown', onPanelKeydown);
          desktopQuery?.removeEventListener?.('change', onDesktopChange);
          trigger.removeEventListener('click', onTrigger);
          panel.removeEventListener('click', onPanelClick);
          panel.removeEventListener('transitionend', onPanelTransitionSettled);
          panel.removeEventListener('transitioncancel', onPanelTransitionSettled);
          backdrop?.removeEventListener('click', onBackdrop);
          document.removeEventListener('pointerdown', onDocumentPointerDown);
          window.removeEventListener('pageshow', onPageShow);
          close('destroy', { restoreFocus: false });
          layer.destroy();
          trigger.removeAttribute('data-gb-site-menu-owner');
          if (window.closeMobileNav === legacyClose) {
            try { delete window.closeMobileNav; } catch (_) { window.closeMobileNav = undefined; }
          }
          if (window[CONTROLLER_KEY] === controller) window[CONTROLLER_KEY] = null;
        },
      };

      window[CONTROLLER_KEY] = controller;
      return controller;
    }

    const scheduleInit = () => {
      if (init()) return;
      requestAnimationFrame(() => {
        if (init()) return;
        window.setTimeout(init, 50);
      });
    };

    window[API_KEY] = Object.freeze({ version: VERSION, init, close: () => window[CONTROLLER_KEY]?.close?.('api') });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', scheduleInit, { once: true });
    else scheduleInit();
    document.addEventListener('astro:page-load', scheduleInit);
  })();
</script>
