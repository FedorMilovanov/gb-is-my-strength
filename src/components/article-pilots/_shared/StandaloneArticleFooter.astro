---
/**
 * StandaloneArticleFooter — shared residual runtime/footer shell for native standalone articles.
 *
 * Keeps bookmark-toast markup and the existing residual JS asset ownership in one place.
 * Reader-level controls/actions remain owned by ReaderActionsRuntime through the shared chrome.
 * Asset paths are page-relative and intentionally target one-level article routes such as
 * /articles/<slug>/; this component is not a generic arbitrary-depth layout primitive.
 */
---

<!-- ===== BOTTOM APP BAR ===== -->
<!-- ===== BOTTOM TOC OVERLAY ===== -->
<!-- Reader-level share/print/back actions are owned by ReaderActionsRuntime. -->

<!-- Bookmark toast -->
<div aria-atomic="true" aria-live="polite">
  <div class="bookmark-toast" hidden="" id="bookmarkToast">
    <div class="bookmark-toast-inner">
      <div class="bookmark-toast-top">
        <span aria-hidden="true" class="bookmark-toast-icon">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-2px">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
        </span>
        <div class="bookmark-toast-copy">
          <span class="bookmark-toast-label">Продолжить чтение</span>
          <span class="bookmark-toast-title" id="bookmarkToastTitle">Раздел статьи</span>
          <span class="bookmark-toast-meta" id="bookmarkToastMeta">Вы остановились примерно на 42%</span>
        </div>
        <button aria-label="Закрыть" class="bookmark-toast-close" id="bookmarkToastClose" type="button">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" style="display:inline-block;vertical-align:-1px">
            <path d="M6 6l12 12M18 6l-12 12"/>
          </svg>
        </button>
      </div>
      <div class="bookmark-toast-actions">
        <button class="bookmark-btn bookmark-btn-primary" id="bookmarkToastResume" type="button">Продолжить</button>
        <button class="bookmark-btn bookmark-btn-secondary" id="bookmarkToastRestart" type="button">Сначала</button>
      </div>
      <div aria-hidden="true" class="bookmark-toast-progress">
        <div class="bookmark-toast-progress-fill" id="bookmarkToastProgress"></div>
      </div>
    </div>
  </div>
</div>

<!-- Explicit residual runtimes. Reader actions and standalone chrome no longer
     depend on the legacy site.js monolith. is:inline preserves root asset URLs. -->
<script is:inline defer src="../../js/bookmark-engine.js?v=fba4e559"></script>
<script is:inline defer src="../../js/site-utils.js?v=661c6cc1"></script>
<script is:inline defer src="../../js/scroll-perf.js?v=454d6f7b"></script>
<script is:inline src="../../js/glossary.js?v=c7f8b6e9" defer></script>
<script is:inline src="../../js/sw-register.js?v=e61e1210" defer></script>
