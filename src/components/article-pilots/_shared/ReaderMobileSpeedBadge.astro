---
/** Accessible speed control shared by Reader top bars. Kept as its own 44px
 * button; Gill places it immediately BEFORE Play to keep Play beside Settings.
 * The tiny chip is painted on the lower-right arc without overlapping Settings.
 */
interface Props { engine: 'series' | 'article'; }
const { engine } = Astro.props as Props;
const series = engine === 'series';
---
<button
  type="button"
  class:list={['reader-mobile-speed-badge', series ? 'mobile-spdbadge' : 'hm-spdbadge']}
  id={series ? 'mobSpdBadge' : 'hmSpdBadge'}
  aria-controls={series ? 'mobileSpeedrail' : 'hmSpeedrail'}
  aria-expanded="false"
  aria-label="Выбрать скорость озвучки, сейчас 1×"
>{series ? <span class="reader-mobile-speed-chip" aria-hidden="true">1×</span> : '1×'}</button>
