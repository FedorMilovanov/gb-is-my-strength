---
/**
 * MobileChromeShell — общий структурный каркас мобильной обвязки.
 *
 * (Пакет GILL_RESEARCH_3_ENGINES, документ 03 §4.) Гарантирует единую
 * структуру верхней/нижней панелей, safe-area, landmarks и общий data-контракт
 * для рантайма (js/floating-cluster-controller.js расширяется аддитивно и
 * может инициализировать всё по [data-mobile-chrome]).
 *
 * Shell НЕ знает про Gill/Hermenevtika/Pagefind/TTS/BookmarkEngine/quiz — он
 * только раскладывает именованные слоты. Конкретное наполнение (marks, dual
 * progress, Learning, Search…) кладёт адаптер движка.
 *
 * Pixel-parity контракт (этап 2→3, миграция без визуального диффа):
 *  - Слоты вставляются ПРЯМЫМИ детьми header/footer, без div-обёрток: легаси
 *    CSS использует селекторы прямого потомка (.mobile-bottom-bar > .gb-icon),
 *    и даже display:contents-обёртка сломала бы их (селектор `>` матчится по
 *    DOM-дереву, не по layout-дереву).
 *  - Корневой .mobile-chrome нейтрализуется display:contents в
 *    css/floating-cluster.css — новых CSS-файлов не создаём (protected
 *    contract), лейаут-дерево баров идентично долегаси-разметке.
 *  - Контрактные атрибуты панелей (data-fc-root, data-fc-variant,
 *    data-gill-mobile-bar, data-fc-speed-mode…) адаптер передаёт через
 *    topAttrs/bottomAttrs — делегирование кластера живёт на самой панели.
 */
import type { MobileChromeEngine } from './mobileChromeTypes';

interface Props {
  engine: MobileChromeEngine;
  id?: string;
  rootClass?: string;
  topClass?: string;
  bottomClass?: string;
  /** Дополнительные атрибуты верхней панели (data-fc-root и т.п.). */
  topAttrs?: Record<string, string | boolean>;
  /** Дополнительные атрибуты нижней панели. */
  bottomAttrs?: Record<string, string | boolean>;
}

const {
  engine,
  id,
  rootClass = '',
  topClass = 'mobile-top-bar',
  bottomClass = 'mobile-bottom-bar',
  topAttrs = {},
  bottomAttrs = {},
} = Astro.props as Props;
---
<div
  id={id}
  class:list={['mobile-chrome', rootClass]}
  data-mobile-chrome
  data-mobile-chrome-engine={engine}
>
  <header class={topClass} data-mobile-topbar {...topAttrs}>
    <slot name="top-leading" />
    <slot name="top-primary" />
    <slot name="top-playback" />
    <slot name="top-trailing" />
  </header>

  <footer class={bottomClass} data-mobile-bottombar {...bottomAttrs}>
    <slot name="bottom-progress" />
    <slot name="bottom-context" />
    <slot name="bottom-actions" />
  </footer>

  <slot name="overlays" />
</div>
