---
/** One historical hamburger/TOC trigger for every Reader mobile bar.
 * Icon is taken from ReaderRail.astro (#hMobileMenuBtn), not redesigned.
 * Runtime forwards to the corresponding canonical TOC button.
 */
interface Props { targetId?: string; mode?: 'toc' | 'learning' | 'research'; }
const { targetId, mode = 'toc' }=Astro.props as Props;
---
<button
  class="reader-mobile-menu-trigger"
  type="button"
  data-reader-mobile-menu-target={mode === 'toc' ? targetId : undefined}
  data-gill-learning-open={mode === 'learning' ? '' : undefined}
  data-gill-marginalia-open={mode === 'research' ? '' : undefined}
  aria-controls={mode === 'learning' ? 'gillLearningOverlay' : mode === 'research' ? 'partTocOverlay' : undefined}
  aria-expanded={mode === 'learning' || mode === 'research' ? 'false' : undefined}
  aria-label={mode === 'research' ? 'Открыть раздел «Аналитика»: определения и контекст статьи' : mode === 'learning' ? 'Открыть обучение: термины, конспект, тест и заметки' : 'Открыть оглавление и поиск'}
  aria-haspopup="dialog"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {mode === 'research' ? (
      <Fragment>
        <path d="M5 3.5h11.5a2 2 0 0 1 2 2v15H7a2 2 0 0 1-2-2z" />
        <path d="M8.5 9.5h6M8.5 13h6" />
      </Fragment>
    ) : mode === 'learning' ? (
      <Fragment>
        <!-- Original Gill v5 «Обучение» academic cap, not the TOC hamburger. -->
        <path d="M2 10l10-5 10 5-10 5z" />
        <path d="M6 12v5c3 2 9 2 12 0v-5" />
        <path d="M22 10v6" />
      </Fragment>
    ) : <path d="M4 7h16M4 12h16M4 17h16" />}
  </svg>
  <span>{mode === 'research' ? 'Аналитика' : mode === 'learning' ? 'Обучение' : 'Оглавление'}</span>
</button>
<script>
  function bindReaderMobileMenuTriggers() {
    document.querySelectorAll<HTMLButtonElement>('[data-reader-mobile-menu-target]').forEach(btn=>{
      if(btn.dataset.readerMobileMenuBound==='1')return;
      btn.dataset.readerMobileMenuBound='1';
      let pendingRestorer: (()=>void)|null=null;
      btn.addEventListener('click',()=>{
        const id=btn.dataset.readerMobileMenuTarget;
        const target=id&&document.getElementById(id);
        if(!(target instanceof HTMLElement))return;
        // Keep the original TOC controller as the only modal state owner.
        // The lower bar's canonical trigger is a transport, not the user's
        // opener: return focus to the visible button after Escape/backdrop.
        if(pendingRestorer) target.removeEventListener('focus',pendingRestorer);
        pendingRestorer=()=>{
          pendingRestorer=null;
          if(btn.isConnected) queueMicrotask(()=>btn.isConnected&&btn.focus({preventScroll:true}));
        };
        target.addEventListener('focus',pendingRestorer,{once:true});
        target.click();
      });
    });
  }
  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',bindReaderMobileMenuTriggers,{once:true});
  }else{bindReaderMobileMenuTriggers();}
  document.addEventListener('astro:page-load',bindReaderMobileMenuTriggers);
</script>
