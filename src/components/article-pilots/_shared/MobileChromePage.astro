---
/**
 * MobileChromePage — лёгкий landing/page-адаптер общего mobile chrome.
 *
 * Используется обычными каталогами с engine='page' и книжными лендингами с
 * engine='series'. UI намеренно одинаков: Back · Home · Глобальный поиск,
 * без reader-progress, TTS, Save и Learning — эти возможности принадлежат
 * страницам чтения, а не полке книги.
 *
 * Принципы:
 *  - Поиск НЕ создаёт второй поиск: клик по кнопке обрабатывает СОБСТВЕННЫЙ
 *    скрипт адаптера — он вызывает GBSearch.open() напрямую, если палитра уже
 *    загружена, иначе диспатчит синтетический Ctrl/⌘+K. Оба сайтовых
 *    lazy-loader'а слушают именно keydown Ctrl/⌘+K → лениво грузят js/search.js
 *    и открывают палитру.
 *  - Без «двойной шапки»: у страниц v20 родной fixed-navbar (#hNavbar, 58px)
 *    с автоскрытием (.nav-hidden при скролле вниз). Бар движка спрятан, пока
 *    navbar виден, и выезжает, когда navbar уехал. Фолбэк без #hNavbar —
 *    после 160px скролла.
 *  - Самодостаточен: scoped-стили на сайтовых токенах; floating-cluster.css
 *    не требуется.
 */
import MobileChromeShell from './MobileChromeShell.astro';
import type { MobileChromeEngine } from './mobileChromeTypes';
import { assetUrl } from '@/lib/asset-version';

interface Props {
  /** Семантический движок поверхности: page или series landing. */
  engine?: MobileChromeEngine;
  /** Куда ведёт «Назад», если истории нет (прямой заход). */
  backHref: string;
  homeHref?: string;
  searchLabel?: string;
}
const {
  engine = 'page',
  backHref,
  homeHref = '/',
  searchLabel = 'Поиск по сайту…',
} = Astro.props as Props;

// Кэш-бастнутый путь палитры — движок сам догружает её на страницах без
// сайтового lazy-loader'а, поэтому поиск работает везде.
const searchSrc = assetUrl('js/search.js');
const paletteCss = assetUrl('css/command-palette.css');
---
<MobileChromeShell engine={engine} topClass="mcp-top" id="mobileChromePage">
  <button class="mcp-icon" id="mcpBackBtn" type="button" aria-label="Назад" data-back-href={backHref} slot="top-leading">
    <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
  </button>
  <a class="mcp-icon" href={homeHref} aria-label="На главную" slot="top-leading">
    <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" /></svg>
  </a>

  <!-- Клик обрабатывает скрипт адаптера, а не класс/атрибут-хук конкретного
       лоадера: так один поиск работает на page и series landing. -->
  <button class="mcp-search" type="button" aria-label="Открыть поиск по сайту" data-search-src={searchSrc} data-palette-css={paletteCss} slot="top-primary">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
    <span>{searchLabel}</span>
    <kbd aria-hidden="true">Ctrl K</kbd>
  </button>
</MobileChromeShell>

<style is:global>
  /* Лёгкий landing chrome живёт только на мобильной ширине. */
  .mcp-top { display: none; }
  @media (max-width: 63.99em) {
    .mcp-top {
      display: flex;
      align-items: center;
      gap: 6px;
      position: fixed;
      left: 0; right: 0; top: 0;
      z-index: 1000;
      min-height: 52px;
      padding: calc(env(safe-area-inset-top, 0px) + 7px) 10px 7px;
      background: color-mix(in srgb, var(--bg, #faf7f2) 88%, transparent);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
      backdrop-filter: blur(14px) saturate(1.4);
      border-bottom: 1px solid var(--border, #e5e2dc);
      transform: translateY(-110%);
      transition: transform .28s cubic-bezier(.22, 1, .36, 1);
    }
    .mobile-chrome.is-shown .mcp-top { transform: translateY(0); }

    .mcp-icon {
      width: 38px; height: 38px; flex-shrink: 0;
      display: grid; place-items: center;
      border: 0; border-radius: 50%;
      background: none; color: var(--muted, #6a6a6a);
      cursor: pointer; -webkit-tap-highlight-color: transparent;
    }
    .mcp-icon:active { background: color-mix(in srgb, var(--accent, #7a2e2e) 10%, transparent); }
    .mcp-icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

    .mcp-search {
      flex: 1; min-width: 0; height: 38px;
      display: flex; align-items: center; gap: 8px;
      padding: 0 12px;
      border: 1px solid var(--border, #e5e2dc);
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent, #7a2e2e) 5%, transparent);
      color: var(--muted, #6a6a6a);
      font: 13px/1 var(--font-body, 'Source Sans 3', system-ui, sans-serif);
      cursor: pointer; text-align: left;
      -webkit-tap-highlight-color: transparent;
    }
    .mcp-search svg { width: 15px; height: 15px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
    .mcp-search span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mcp-search kbd {
      flex-shrink: 0; padding: 2px 6px;
      border: 1px solid var(--border, #e5e2dc); border-radius: 5px;
      font: 600 9.5px/1.3 var(--font-body, 'Source Sans 3', system-ui, sans-serif);
      color: var(--muted, #6a6a6a); background: transparent;
      display: none;
    }
    @media (hover: hover) and (pointer: fine) { .mcp-search kbd { display: inline-block; } }
  }
</style>

<script>
  function initMobileChromePage() {
    const root = document.getElementById('mobileChromePage');
    if (!root) return;

    const back = document.getElementById('mcpBackBtn');
    back?.addEventListener('click', () => {
      const href = (back as HTMLElement).dataset.backHref || '/';
      if (window.history.length > 1 && document.referrer && new URL(document.referrer, location.href).origin === location.origin) {
        window.history.back();
      } else {
        window.location.href = href;
      }
    });

    const search = root.querySelector('.mcp-search') as HTMLElement | null;
    search?.addEventListener('click', (e) => {
      e.preventDefault();
      const w = window as unknown as {
        GBSearch?: { open?: () => void };
        __gbSearchLoading?: boolean;
        __gbSearchBootRequested?: boolean;
        __gbSearchOpenAfterLoad?: boolean;
      };
      const pcss = search.dataset.paletteCss;
      if (pcss && !document.querySelector('link[data-mcp-palette-css]')) {
        const href = pcss.split('?')[0];
        const present = [...document.querySelectorAll('link[rel=stylesheet]')]
          .some((l) => (l as HTMLLinkElement).href.split('?')[0].endsWith(href));
        if (!present) {
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = pcss;
          link.setAttribute('data-mcp-palette-css', '');
          document.head.appendChild(link);
        }
      }
      if (w.GBSearch && typeof w.GBSearch.open === 'function') {
        w.GBSearch.open();
        return;
      }
      w.__gbSearchOpenAfterLoad = true;
      if (w.__gbSearchLoading || w.__gbSearchBootRequested) return;
      w.__gbSearchLoading = true;
      w.__gbSearchBootRequested = true;
      const s = document.createElement('script');
      s.defer = true;
      s.src = search.dataset.searchSrc || '/js/search.js';
      s.onload = () => { w.__gbSearchLoading = false; w.GBSearch?.open?.(); };
      s.onerror = () => { w.__gbSearchLoading = false; };
      document.head.appendChild(s);
    });

    const navbar = document.getElementById('hNavbar');
    let ticking = false;
    function sync() {
      ticking = false;
      const shown = navbar
        ? navbar.classList.contains('nav-hidden')
        : window.scrollY > 160;
      root!.classList.toggle('is-shown', shown);
    }
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(sync); }
    }, { passive: true });
    sync();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initMobileChromePage, { once: true });
  else initMobileChromePage();
</script>
