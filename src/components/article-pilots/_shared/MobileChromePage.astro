---
/**
 * MobileChromePage — адаптер движка «page» (план GILL_RESEARCH_3_ENGINES §8):
 * мобильная обвязка для НЕконтентных страниц (каталоги/лендинги/карты).
 *
 *   Top: Back · Home · Глобальный Поиск   |   Bottom: нет (по умолчанию)
 *
 * Принципы:
 *  - НЕТ Learning/TTS/прогресса чтения/Save — этому движку они запрещены.
 *  - Поиск НЕ создаёт второй поиск: клик по кнопке обрабатывает СОБСТВЕННЫЙ
 *    скрипт адаптера — он вызывает GBSearch.open() напрямую, если палитра уже
 *    загружена, иначе диспатчит синтетический Ctrl/⌘+K. Оба сайтовых
 *    lazy-loader'а (articles-стиль в футере страниц v20 И BaseLayout) слушают
 *    именно keydown Ctrl/⌘+K → лениво грузят js/search.js и открывают палитру.
 *    Единый триггер портируется на любой тип страницы без дубль-открытия
 *    (не полагаемся на класс/атрибут-хук конкретного лоадера).
 *  - Без «двойной шапки»: у страниц v20 родной fixed-navbar (#hNavbar, 58px)
 *    с автоскрытием (.nav-hidden при скролле вниз). Бар движка спрятан, пока
 *    navbar виден, и выезжает, когда navbar уехал, — постоянный доступ к
 *    Назад/Домой/Поиску без конкуренции с родным хедером. Фолбэк (нет
 *    #hNavbar): порог 160px скролла.
 *  - Самодостаточен: scoped-стили на сайтовых токенах (--bg/--text/--accent…),
 *    floating-cluster.css НЕ требуется (прецедент: HermenevtikaMobileBar).
 */
import MobileChromeShell from './MobileChromeShell.astro';

interface Props {
  /** Куда ведёт «Назад», если истории нет (прямой заход). */
  backHref: string;
  homeHref?: string;
  searchLabel?: string;
}
const { backHref, homeHref = '/', searchLabel = 'Поиск по сайту…' } = Astro.props as Props;
---
<MobileChromeShell engine="page" topClass="mcp-top" id="mobileChromePage">
  <button class="mcp-icon" id="mcpBackBtn" type="button" aria-label="Назад" data-back-href={backHref} slot="top-leading">
    <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
  </button>
  <a class="mcp-icon" href={homeHref} aria-label="На главную" slot="top-leading">
    <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" /></svg>
  </a>

  <!-- Клик обрабатывает скрипт адаптера (см. ниже), а НЕ класс/атрибут-хук
       конкретного лоадера: .gb-search-btn коллидирует с command-palette.css
       (прячет текстовый span), а data-fc-action работает не на всех страницах. -->
  <button class="mcp-search" type="button" aria-label="Открыть поиск по сайту" slot="top-primary">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
    <span>{searchLabel}</span>
    <kbd aria-hidden="true">Ctrl K</kbd>
  </button>
</MobileChromeShell>

<style is:global>
  /* Движок «page» живёт только на мобильной ширине. */
  .mcp-top { display: none; }
  @media (max-width: 63.99em) {
    .mcp-top {
      display: flex;
      align-items: center;
      gap: 6px;
      position: fixed;
      left: 0; right: 0; top: 0;
      z-index: 1000;
      min-height: 52px;
      padding: calc(env(safe-area-inset-top, 0px) + 7px) 10px 7px;
      background: color-mix(in srgb, var(--bg, #faf7f2) 88%, transparent);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
      backdrop-filter: blur(14px) saturate(1.4);
      border-bottom: 1px solid var(--border, #e5e2dc);
      transform: translateY(-110%);
      transition: transform .28s cubic-bezier(.22, 1, .36, 1);
    }
    .mobile-chrome.is-shown .mcp-top { transform: translateY(0); }

    .mcp-icon {
      width: 38px; height: 38px; flex-shrink: 0;
      display: grid; place-items: center;
      border: 0; border-radius: 50%;
      background: none; color: var(--muted, #6a6a6a);
      cursor: pointer; -webkit-tap-highlight-color: transparent;
    }
    .mcp-icon:active { background: color-mix(in srgb, var(--accent, #7a2e2e) 10%, transparent); }
    .mcp-icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

    .mcp-search {
      flex: 1; min-width: 0; height: 38px;
      display: flex; align-items: center; gap: 8px;
      padding: 0 12px;
      border: 1px solid var(--border, #e5e2dc);
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent, #7a2e2e) 5%, transparent);
      color: var(--muted, #6a6a6a);
      font: 13px/1 var(--font-body, 'Source Sans 3', system-ui, sans-serif);
      cursor: pointer; text-align: left;
      -webkit-tap-highlight-color: transparent;
    }
    .mcp-search svg { width: 15px; height: 15px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
    .mcp-search span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mcp-search kbd {
      flex-shrink: 0; padding: 2px 6px;
      border: 1px solid var(--border, #e5e2dc); border-radius: 5px;
      font: 600 9.5px/1.3 var(--font-body, 'Source Sans 3', system-ui, sans-serif);
      color: var(--muted, #6a6a6a); background: transparent;
      /* На тач-девайсах хоткей неуместен. */
      display: none;
    }
    @media (hover: hover) and (pointer: fine) { .mcp-search kbd { display: inline-block; } }
  }
</style>

<script>
  function initMobileChromePage() {
    const root = document.getElementById('mobileChromePage');
    if (!root) return;

    const back = document.getElementById('mcpBackBtn');
    back?.addEventListener('click', () => {
      const href = (back as HTMLElement).dataset.backHref || '/';
      if (window.history.length > 1 && document.referrer && new URL(document.referrer, location.href).origin === location.origin) {
        window.history.back();
      } else {
        window.location.href = href;
      }
    });

    // Поиск: единый портируемый триггер. Прямой вызов, если палитра готова;
    // иначе синтетический Ctrl+K — его слушают оба сайтовых lazy-loader'а.
    const search = root.querySelector('.mcp-search');
    search?.addEventListener('click', (e) => {
      e.preventDefault();
      const w = window as unknown as { GBSearch?: { open?: () => void } };
      if (w.GBSearch && typeof w.GBSearch.open === 'function') {
        w.GBSearch.open();
        return;
      }
      document.dispatchEvent(new KeyboardEvent('keydown', {
        key: 'k', ctrlKey: true, bubbles: true, cancelable: true,
      }));
    });

    // Показ бара: когда родной navbar уехал (.nav-hidden) — либо, без navbar,
    // после 160px скролла. Никакой двойной шапки в верхней точке страницы.
    const navbar = document.getElementById('hNavbar');
    let ticking = false;
    function sync() {
      ticking = false;
      const shown = navbar
        ? navbar.classList.contains('nav-hidden')
        : window.scrollY > 160;
      root!.classList.toggle('is-shown', shown);
    }
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(sync); }
    }, { passive: true });
    sync();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initMobileChromePage, { once: true });
  else initMobileChromePage();
</script>
