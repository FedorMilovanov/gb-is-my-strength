---
/**
 * ReaderSpeedOptions — one semantic speed-choice UI for article and series.
 *
 * Both readers retain their existing interaction owners and CSS class hooks.
 * This component owns only the accessible radiogroup and its options:
 * no storage, TTS listeners, route inspection or rendering engine.
 */
import '@/styles/reader-mobile-canonical.css';

interface Props {
  id: string;
  railClass: string;
  chipClass: string;
  rates: readonly number[];
  initiallyHidden?: boolean;
  initiallyInert?: boolean;
}

const {
  id, railClass, chipClass, rates,
  initiallyHidden = false, initiallyInert = false,
} = Astro.props;
if (!id || !railClass || !chipClass) {
  throw new Error('[reader-speed-options] Missing rail identity or CSS hooks');
}
if (!rates.length || !rates.includes(1) ||
    new Set(rates).size !== rates.length ||
    !rates.every((rate, index) => Number.isFinite(rate) && rate > 0 &&
      rate <= 2 && (index === 0 || rate > rates[index - 1]))) {
  throw new Error('[reader-speed-options] Expected ascending, unique speeds including 1×');
}
---
<div class:list={[railClass,"reader-mobile-speedrail"]} id={id} role="radiogroup" aria-label="Скорость воспроизведения"
  aria-hidden="true" hidden={initiallyHidden} inert={initiallyInert}>
  {rates.map((rate) => (
    <button type="button" class:list={[chipClass,"reader-mobile-speed-rate"]} role="radio"
      data-speed={String(rate)} aria-checked={rate === 1 ? 'true' : 'false'}>
      {rate}×
    </button>
  ))}
</div>

<script>
  import { initSpeedSlot } from './speedSlot';

  /** The single mobile speed controller for all Reader series and articles.
   * Both bar variants expose the same semantic selectors; route-specific
   * Gill and Hermenevtika state machines are no longer involved.
   */
  function initCanonicalMobileSpeed() {
    document.querySelectorAll<HTMLElement>('[data-reader-mobile-speed]').forEach(bar => {
      if (bar.dataset.readerSpeedBound === '1') return;
      if (!bar.querySelector('.reader-mobile-speedrail')) return;
      bar.dataset.readerSpeedBound = '1';
      initSpeedSlot(bar, {
        ember: '.gb-ember',
        speedrail: '.reader-mobile-speedrail',
        badge: '.reader-mobile-speed-badge',
        chip: '.reader-mobile-speed-rate',
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCanonicalMobileSpeed, { once:true });
  } else {
    initCanonicalMobileSpeed();
  }
  document.addEventListener('astro:page-load', initCanonicalMobileSpeed);
</script>
