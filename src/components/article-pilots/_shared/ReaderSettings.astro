---
/**
 * ReaderSettings — премиум-лист «Настройки чтения» для мобильной
 * (<64em) обвязки Hermenevtika, по стандарту Gill v5 (тема День/Сепия/Ночь,
 * размер текста, межстрочный интервал, ширина колонки).
 *
 * Разметка и scoped-стили остаются самостоятельным standalone-adapter, чтобы
 * не менять рабочие селекторы Hermenevtika/Kod Da Vinci. Состояние больше не
 * принадлежит компоненту: тема, сепия, интервал, ширина и размер текста читаются
 * и записываются через общий GBReaderPreferences store.
 *
 * Открывается по событию `hm:open-settings`; размер текста сохраняет существующий
 * data-fc-action="font-up/down" контракт через общий floating-cluster adapter.
 */
---
<div id="hmSettings" class="hmsheet hmsettings" aria-hidden="true">
  <div class="hmsheet-backdrop" id="hmSettingsBackdrop"></div>
  <div class="hmsheet-panel" role="dialog" aria-modal="true" aria-labelledby="hmSettingsTitle">
    <div class="hmsheet-handle" aria-hidden="true"></div>
    <div class="hmsheet-head">
      <div>
        <div class="hmsheet-title" id="hmSettingsTitle">Настройки</div>
        <div class="hmsheet-subtitle">Чтение</div>
      </div>
      <button class="hmsheet-close" id="hmSettingsClose" type="button" aria-label="Закрыть настройки">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <div class="hmset-group">
      <span class="hmset-label">Тема</span>
      <div class="hmset-segment" id="hmThemeGroup">
        <button type="button" class="hmset-btn" data-hm-theme="light" aria-pressed="true">День</button>
        <button type="button" class="hmset-btn" data-hm-theme="sepia" aria-pressed="false">Сепия</button>
        <button type="button" class="hmset-btn" data-hm-theme="dark" aria-pressed="false">Ночь</button>
      </div>
    </div>

    <div class="hmset-group">
      <span class="hmset-label">Размер текста</span>
      <div class="hmset-fonttrack">
        <button type="button" class="hmset-font hmset-font--sm" data-fc-action="font-down" aria-label="Уменьшить текст">A</button>
        <div class="hmset-dots" id="hmFontDots" aria-hidden="true"><span class="hmset-dot"></span><span class="hmset-dot"></span><span class="hmset-dot"></span><span class="hmset-dot"></span><span class="hmset-dot"></span></div>
        <button type="button" class="hmset-font hmset-font--lg" data-fc-action="font-up" aria-label="Увеличить текст">A</button>
      </div>
    </div>

    <div class="hmset-group">
      <span class="hmset-label">Межстрочный интервал</span>
      <div class="hmset-segment" id="hmLineGroup">
        <button type="button" class="hmset-btn" data-hm-line="compact" aria-pressed="false">Плотный</button>
        <button type="button" class="hmset-btn" data-hm-line="normal" aria-pressed="true">Обычный</button>
        <button type="button" class="hmset-btn" data-hm-line="relaxed" aria-pressed="false">Свободный</button>
      </div>
    </div>

    <div class="hmset-group">
      <span class="hmset-label">Ширина текста</span>
      <div class="hmset-segment" id="hmMeasureGroup">
        <button type="button" class="hmset-btn" data-hm-measure="narrow" aria-pressed="false">Узкая</button>
        <button type="button" class="hmset-btn" data-hm-measure="normal" aria-pressed="true">Обычная</button>
        <button type="button" class="hmset-btn" data-hm-measure="wide" aria-pressed="false">Широкая</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Скелет листа-«шторки» (.hmsheet*) — САМОДОСТАТОЧНО здесь, чтобы лист не
     зависел от HermenevtikaMobileBar (раньше эти стили жили только там, и на
     страницах без бара, напр. kod-da-vinchi, панель оставалась position:static
     и уезжала за рельс). Значения 1-в-1 с прежним баром. */
  .hmsheet-backdrop{position:fixed;inset:0;background:rgba(20,10,8,.42);z-index:var(--z-overlay,2500)}
  .hmsheet-panel{position:fixed;left:0;right:0;bottom:0;z-index:var(--z-overlay-high,3000);
    max-height:80vh;display:flex;flex-direction:column;border-radius:20px 20px 0 0;
    padding:8px 18px calc(14px + env(safe-area-inset-bottom,0px));
    background:#fbf3ea;box-shadow:0 -20px 50px -10px rgba(0,0,0,.35);
    transform:translateY(100%);transition:transform .3s cubic-bezier(.22,1,.36,1)}
  .hmsheet.is-open .hmsheet-panel{transform:translateY(0)}
  :global(html.dark) .hmsheet-panel{background:#1c0e14;box-shadow:0 -20px 50px -10px rgba(0,0,0,.6)}
  .hmsheet-handle{width:36px;height:4px;border-radius:2px;background:rgba(0,0,0,.15);margin:0 auto 8px}
  :global(html.dark) .hmsheet-handle{background:rgba(255,255,255,.15)}
  .hmsheet-head{display:flex;align-items:flex-start;justify-content:space-between;padding-bottom:8px}
  .hmsheet-title{font-family:var(--f-serif,Lora,Georgia,serif);font-weight:700;font-size:16px;color:#2a1814}
  :global(html.dark) .hmsheet-title{color:#f2e9e6}
  .hmsheet-subtitle{font-size:11px;color:rgba(42,24,20,.55);margin-top:2px}
  :global(html.dark) .hmsheet-subtitle{color:rgba(255,255,255,.5)}
  .hmsheet-close{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;border:0;
    background:rgba(122,46,46,.08);color:#7a2e2e;cursor:pointer;flex-shrink:0}
  :global(html.dark) .hmsheet-close{background:rgba(224,160,150,.1);color:#e0a89c}
  .hmsheet-close svg{width:15px;height:15px}

  /* Лист доступен на ВСЕХ ширинах: на мобиле его открывает шестерёнка в баре,
     на десктопе — шестерёнка в HermenevtikaRail (#hrailSettingsBtn). Раньше
     стили и открытие были заперты под @media(max-width:1199px), из-за чего на
     десктопе лист был мёртв (регрессия — тот же паттерн, что чинился у Гилла:
     лист есть, входа нет). Обёртка снята (@media all), лист всё равно скрыт до
     .is-open, поэтому сайтвайд ничего не течёт. */
  .hmsettings { display: none; }
  @media all {
    .hmsettings.is-open { display: block; }

    .hmset-group { padding: 12px 0 4px; }
    .hmset-group + .hmset-group { border-top: 1px solid rgba(42,24,20,.08); }
    html.dark .hmset-group + .hmset-group { border-top-color: rgba(255,255,255,.08); }
    .hmset-label {
      display: block; margin-bottom: 8px;
      font: 700 11px/1 "Source Sans 3", system-ui, sans-serif;
      letter-spacing: .08em; text-transform: uppercase; color: rgba(42,24,20,.55);
    }
    html.dark .hmset-label { color: rgba(255,255,255,.5); }

    .hmset-segment { display: flex; gap: 4px; padding: 3px; border-radius: 11px;
      background: rgba(122,46,46,.05); border: 1px solid rgba(122,46,46,.14); }
    html.dark .hmset-segment { background: rgba(224,160,150,.06); border-color: rgba(224,160,150,.16); }
    .hmset-btn { flex: 1; height: 34px; border: 0; border-radius: 8px; background: transparent;
      font: 600 13px/1 "Source Sans 3", system-ui, sans-serif; color: rgba(42,24,20,.7);
      cursor: pointer; transition: background .15s, color .15s; }
    html.dark .hmset-btn { color: rgba(255,255,255,.7); }
    .hmset-btn[aria-pressed="true"] { background: #7a2e2e; color: #fff; box-shadow: 0 1px 3px rgba(122,46,46,.3); }
    html.dark .hmset-btn[aria-pressed="true"] { background: #e0a89c; color: #1c0e14; }

    .hmset-fonttrack { display: flex; align-items: center; gap: 12px; padding: 4px 12px;
      border-radius: 11px; background: rgba(122,46,46,.05); border: 1px solid rgba(122,46,46,.14); }
    html.dark .hmset-fonttrack { background: rgba(224,160,150,.06); border-color: rgba(224,160,150,.16); }
    .hmset-font { border: 0; background: transparent; color: #7a2e2e; font-family: ui-serif, Georgia, serif;
      cursor: pointer; line-height: 1; padding: 6px; }
    html.dark .hmset-font { color: #e0a89c; }
    .hmset-font--sm { font-size: 15px; }
    .hmset-font--lg { font-size: 22px; }
    .hmset-dots { flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px; }
    .hmset-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(122,46,46,.2); transition: background .15s; }
    html.dark .hmset-dot { background: rgba(224,160,150,.2); }
    .hmset-dot.is-on { background: #7a2e2e; }
    html.dark .hmset-dot.is-on { background: #e0a89c; }

    /* --- Applied reader vars on Hermenevtika's #content only (глобально:
       элементы вне этого компонента; маркер [data-hm-reader] не даёт правилам
       протечь на другие страницы с id="content", включая Gill). --- */
    :global([data-reader-root]) { --hm-article-line: 1.6; --hm-article-measure: 43rem; }
    :global([data-reader-root] .article-body) { line-height: var(--hm-article-line); }
    :global([data-reader-root] .article-body > *) { max-width: var(--hm-article-measure); margin-left: auto; margin-right: auto; }

    /* Compatibility selector for existing standalone article CSS. The canonical
       Sepia state is global; GBReaderPreferences mirrors it onto this root. */
    :global([data-reader-root][data-hm-reader-theme="sepia"]),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .article-main),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .article-body) { background: #ece0c6 !important; }
    :global([data-reader-root][data-hm-reader-theme="sepia"] .article-body),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .article-body p),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .article-body li),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .article-body td) { color: #4a3820 !important; }
    :global([data-reader-root][data-hm-reader-theme="sepia"] .article-body h1),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .article-body h2),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .article-body h3),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .article-body h4),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .article-body strong) { color: #3a2712 !important; }
    /* Внутристатейные карточки (Коротко/автор/примечание переводчика) не должны
       «пробивать» белым по сепии — тёплая слоновая кость поверх бумаги #ece0c6. */
    :global([data-reader-root][data-hm-reader-theme="sepia"] .summary-card),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .author-card),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .original-author-card),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .translation-note) {
      background: #f3ead4 !important; border-color: rgba(74,56,32,.18) !important;
    }
    :global([data-reader-root][data-hm-reader-theme="sepia"] .summary-card__head),
    :global([data-reader-root][data-hm-reader-theme="sepia"] .summary-card__item + .summary-card__item) {
      border-color: rgba(74,56,32,.14) !important;
    }
    :global(html:has([data-reader-root][data-hm-reader-theme="sepia"]) body) { background: #ece0c6; }
  }

  /* ДЕСКТОП: не полноширинный bottom-sheet, а компактный поповер снизу-слева —
     всплывает от шестерёнки в rail (owner-канон Гилла: «вылезает там, где
     нажимаем»), без затемнения экрана. Только для листа настроек (.hmsettings),
     мобильный TOC-лист бара это не трогает. */
  @media (min-width: 1200px) {
    .hmsettings .hmsheet-backdrop { background: transparent; }
    .hmsettings .hmsheet-panel {
      left: clamp(16px, 2.4vw, 40px); right: auto; bottom: 16px;
      width: 300px; max-height: 78vh; border-radius: 18px;
      box-shadow: 0 24px 60px -14px rgba(122,46,46,.34), 0 2px 10px rgba(42,24,20,.14);
      transform-origin: bottom left;
    }
    .hmsettings .hmsheet-handle { display: none; }
  }
</style>

<script>
  const LINE_VALUES: Record<string, string> = { compact: '1.45', normal: '1.6', relaxed: '1.85' };
  const MEASURE_VALUES: Record<string, string> = { narrow: '36rem', normal: '43rem', wide: '50rem' };

  function readerPreferences() {
    return (window as any).GBReaderPreferences || null;
  }

  function currentPreferences() {
    const api = readerPreferences();
    if (api && typeof api.get === 'function') return api.get();
    return (window as any).__GB_READER_PREFS_BOOTSTRAP__ || {
      theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light',
      fontScale: 1,
      lineHeight: 'normal',
      measure: 'normal'
    };
  }

  function initReaderSettings() {
    const sheet = document.getElementById('hmSettings');
    if (!sheet) return;
    const content = document.querySelector('[data-reader-root]') as HTMLElement | null;
    const backdrop = document.getElementById('hmSettingsBackdrop');
    const closeBtn = document.getElementById('hmSettingsClose');

    const OVERLAY_OWNER = 'reader-settings';
    const overlayRuntime = () => (window as any).OverlayRuntime || null;
    const fallbackUtils = () => (window as any).SiteUtils || null;

    const close = (reason = 'programmatic', restoreFocus = true) => {
      sheet.classList.remove('is-open');
      sheet.setAttribute('aria-hidden', 'true');
      const runtime = overlayRuntime();
      if (runtime?.close) runtime.close(OVERLAY_OWNER, reason, { restoreFocus });
      else fallbackUtils()?.unlockScroll?.(OVERLAY_OWNER);
    };

    const open = () => {
      const runtime = overlayRuntime();
      const toc = document.getElementById('hmSheet');
      if (runtime?.isOpen?.('hermenevtika-toc')) runtime.requestClose('hermenevtika-toc', 'switch');
      else if (toc?.classList.contains('is-open')) {
        toc.classList.remove('is-open');
        toc.setAttribute('aria-hidden', 'true');
        fallbackUtils()?.unlockScroll?.('hermenevtika-toc');
      }
      sheet.classList.add('is-open');
      sheet.setAttribute('aria-hidden', 'false');
      if (runtime?.open) runtime.open(OVERLAY_OWNER, {
        element: sheet,
        opener: document.activeElement,
        onRequestClose: (closeReason: string) => close(closeReason, true),
        closeOnEscape: true,
        trapFocus: true
      });
      else fallbackUtils()?.lockScroll?.(OVERLAY_OWNER);
    };
    document.addEventListener('hm:open-settings', open);
    backdrop?.addEventListener('click', () => close('backdrop', true));
    closeBtn?.addEventListener('click', () => close('button', true));
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (!overlayRuntime() && e.key === 'Escape' && sheet.classList.contains('is-open')) close('escape', true);
    });


    function setPressed(group: Element | null, selector: string, value: string) {
      group?.querySelectorAll('button').forEach((button) => {
        const element = button as HTMLElement;
        element.setAttribute('aria-pressed', element.dataset[selector] === value ? 'true' : 'false');
      });
    }

    const themeGroup = document.getElementById('hmThemeGroup');
    const lineGroup = document.getElementById('hmLineGroup');
    const measureGroup = document.getElementById('hmMeasureGroup');
    const dots = document.getElementById('hmFontDots');

    function applyCompatibility(state: any) {
      const theme = state.theme || 'light';
      if (theme === 'sepia') content?.setAttribute('data-hm-reader-theme', 'sepia');
      else content?.removeAttribute('data-hm-reader-theme');
      content?.style.setProperty('--hm-article-line', LINE_VALUES[state.lineHeight] || LINE_VALUES.normal);
      content?.style.setProperty('--hm-article-measure', MEASURE_VALUES[state.measure] || MEASURE_VALUES.normal);
    }

    function syncDots(scale: number) {
      if (!dots) return;
      if (!dots.childElementCount) {
        for (let i = 0; i < 5; i++) { const dot = document.createElement('span'); dot.className = 'hmset-dot'; dots.appendChild(dot); }
      }
      const index = Math.round(((Number(scale) || 1) - .85) / .05);
      Array.prototype.forEach.call(dots.children, (dot: HTMLElement, i: number) => dot.classList.toggle('is-on', i <= index));
    }

    function sync(state = currentPreferences()) {
      applyCompatibility(state);
      setPressed(themeGroup, 'hmTheme', state.theme || 'light');
      setPressed(lineGroup, 'hmLine', state.lineHeight || 'normal');
      setPressed(measureGroup, 'hmMeasure', state.measure || 'normal');
      syncDots(state.fontScale || 1);
    }

    themeGroup?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('[data-hm-theme]') as HTMLElement | null;
      if (!button) return;
      const theme = button.dataset.hmTheme || 'light';
      const api = readerPreferences();
      if (api) api.setTheme(theme, { source: 'standalone-reader-settings' });
      else {
        document.documentElement.classList.toggle('dark', theme === 'dark');
        document.documentElement.setAttribute('data-reader-theme', theme);
        sync({ ...currentPreferences(), theme });
      }
    });

    lineGroup?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('[data-hm-line]') as HTMLElement | null;
      if (!button) return;
      const value = button.dataset.hmLine || 'normal';
      const api = readerPreferences();
      if (api) api.set({ lineHeight: value }, { source: 'standalone-reader-settings' });
      else sync({ ...currentPreferences(), lineHeight: value });
    });

    measureGroup?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('[data-hm-measure]') as HTMLElement | null;
      if (!button) return;
      const value = button.dataset.hmMeasure || 'normal';
      const api = readerPreferences();
      if (api) api.set({ measure: value }, { source: 'standalone-reader-settings' });
      else sync({ ...currentPreferences(), measure: value });
    });

    document.querySelectorAll('[data-fc-action="theme"], [data-fc-action="font-up"], [data-fc-action="font-down"]').forEach((button) => {
      button.addEventListener('click', () => requestAnimationFrame(() => sync()));
    });
    document.addEventListener('gb:reader-preferences-change', (event: Event) => {
      sync((event as CustomEvent).detail?.preferences || currentPreferences());
    });
    sync();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initReaderSettings, { once: true });
  else initReaderSettings();
</script>
