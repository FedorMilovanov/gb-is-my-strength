<script>
  function initReaderRail(){
    // Десктопная шестерёнка «Настройки чтения» — тот же лист
    // ReaderSettings, что открывается с мобильного #hmSettingsBtn
    // (через событие 'hm:open-settings'). Независимо от наличия TOC.
    const railSettingsBtn = document.getElementById('hrailSettingsBtn');
    if (railSettingsBtn && !railSettingsBtn.dataset.bound) {
      railSettingsBtn.dataset.bound = '1';
      railSettingsBtn.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('hm:open-settings'));
      });
    }

    const toc = document.getElementById('hrailToc');
    const countEl = document.getElementById('hrailCount');
    if(!toc) return;
    const isGrok = toc.classList.contains('grok-toc');
    if (isGrok) {
      const rail = toc.closest<HTMLElement>('.hrail--grok');
      const toggle = rail?.querySelector<HTMLButtonElement>('#hrailLayoutToggle');
      const content = rail?.querySelectorAll<HTMLElement>('.hrail-meta,.hrail-toch,.hrail-scroll');
      if (rail && toggle && content) {
        // Native theme/search/PlayEmber/bookmark controls: reparent existing
        // DOM subtree, never clone buttons or create a second runtime.
        const compactTools = rail.querySelector<HTMLElement>('#grokCompactTools');
        const floatingControls = document.getElementById('gbFloatingControls');
        const floatingHome = floatingControls?.parentNode || null;
        const floatingNext = floatingControls?.nextSibling || null;
        // Both the rail and the floating subtree carry the canonical
        // data-fc-root controller. In compact nesting, bubbling to the rail
        // would execute THE SAME theme/save action twice and cancel itself.
        // Stop only that parent bubble; preserve the original root listener.
        floatingControls?.addEventListener('click', (event) => {
          if (compactTools?.contains(floatingControls)) event.stopPropagation();
        });
        const setCompact = (compact: boolean) => {
          if (compact && rail.contains(document.activeElement) && document.activeElement !== toggle) {
            toggle.focus({ preventScroll:true });
          }
          if (floatingControls && floatingHome && compactTools) {
            if (compact) compactTools.appendChild(floatingControls);
            else if (floatingNext?.parentNode === floatingHome)
              floatingHome.insertBefore(floatingControls, floatingNext);
            else floatingHome.appendChild(floatingControls);
          }
          rail.classList.toggle('hrail--compact', compact);
          document.body.classList.toggle('grok-rail-compact', compact);
          toggle.setAttribute('aria-expanded', String(!compact));
          toggle.setAttribute('aria-label', compact ? 'Развернуть оглавление' : 'Свернуть оглавление');
