        const dots = Array.from(toc.querySelectorAll<HTMLElement>(
          ':scope > li.grok-row--h2 > .grok-entry > .hrail-dot'));
        if (!dots.length) return;
        const bounds = toc.getBoundingClientRect();
        const first = dots[0].getBoundingClientRect();
        const last = dots[dots.length - 1].getBoundingClientRect();
        const start = first.top + first.height / 2 - bounds.top;
        const end = last.top + last.height / 2 - bounds.top;
        toc.style.setProperty('--grok-track-top', Math.max(0,start).toFixed(2) + 'px');
        toc.style.setProperty('--grok-track-height', Math.max(0,end-start).toFixed(2) + 'px');
      };
      const updateAxis = () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(measureAxis);
      };
      updateAxis();
      const observer = new ResizeObserver(updateAxis);
      observer.observe(toc);
      toc.addEventListener('transitionend', updateAxis);
      window.addEventListener('resize', updateAxis, {passive:true});
    }

    // Presentation-only disclosure. ReaderState is still the sole scroll,
    // history and active-heading owner. The fallback rail is unchanged.
    function setDisclosure(button: HTMLButtonElement, collapsed: boolean) {
      const row = button.closest<HTMLLIElement>('li.grok-row');
      if (!row) return;
      const childList = row.querySelector<HTMLElement>(
        ':scope > .grok-child-motion > .grok-child-clip > .grok-child-list');
      if (!childList) return;
      if (collapsed && childList.contains(document.activeElement)) {
        button.focus({ preventScroll: true });
      }
      button.setAttribute('aria-expanded', String(!collapsed));
      row.toggleAttribute('data-grok-collapsed', collapsed);
      childList.toggleAttribute('inert', collapsed);
      if (collapsed) childList.setAttribute('aria-hidden', 'true');
      else childList.removeAttribute('aria-hidden');
    }

    if (isGrok) {
      toc.closest('.hrail')?.classList.add('grok-ready');
      toc.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest<HTMLButtonElement>('[data-grok-toggle]');
        if (button && toc.contains(button)) {
          setDisclosure(button, button.getAttribute('aria-expanded') === 'true');
        }
      });

      // Progressive keyboard traversal of the existing nested list, not a
      // second ARIA tree or a new scroll/URL owner. Tab and Enter retain their
      // native link/button behavior; arrow keys only work inside this TOC.
      const rowLink = (row: HTMLLIElement) =>
        row.querySelector<HTMLAnchorElement>(':scope > .grok-entry > a');
      const rowToggle = (row: HTMLLIElement) =>
        row.querySelector<HTMLButtonElement>(':scope > .grok-entry > [data-grok-toggle]');
      const parentRow = (row: HTMLLIElement) =>
        row.parentElement?.closest<HTMLLIElement>('li.grok-row') ?? null;
      const visibleRows = () =>
        Array.from(toc.querySelectorAll<HTMLLIElement>('li.grok-row')).filter((row) => {
          if (!rowLink(row)) return false;
          let parent = parentRow(row);
          while (parent && toc.contains(parent)) {
            if (parent.hasAttribute('data-grok-collapsed')) return false;
            parent = parentRow(parent);
          }
          return true;
        });
      const focusRow = (row?: HTMLLIElement | null) => {
        const link = row && rowLink(row);
        if (!link) return;
        // Focus naturally scrolls the rail's own scroller without changing the
        // article fragment or initiating a ReaderState navigation.
        link.focus();
      };
      toc.addEventListener('keydown', (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        if (!(event.target instanceof HTMLAnchorElement ||
              event.target instanceof HTMLButtonElement)) return;
        const entry = event.target.closest<HTMLElement>('.grok-entry');
        const row = entry?.parentElement;
        if (!(row instanceof HTMLLIElement) || !row.matches('li.grok-row') ||
            !toc.contains(row)) return;

        const navigable = visibleRows();
        const index = navigable.indexOf(row);
        if (index < 0) return;
        let next: HTMLLIElement | null = null;
        switch (event.key) {
          case 'ArrowDown':
            next = navigable[Math.min(index + 1, navigable.length - 1)] ?? null;
            break;
          case 'ArrowUp':
            next = navigable[Math.max(0, index - 1)] ?? null;
            break;
          case 'Home':
            next = navigable[0] ?? null;
            break;
          case 'End':
            next = navigable[navigable.length - 1] ?? null;
            break;
          case 'ArrowRight': {
            const toggle = rowToggle(row);
            if (!toggle) return;
            if (toggle.getAttribute('aria-expanded') === 'false') {
              setDisclosure(toggle, false);
              event.preventDefault();
              return;
            }
            const child = row.querySelector<HTMLLIElement>(
              ':scope > .grok-child-motion > .grok-child-clip > .grok-child-list > li.grok-row');
            if (!child) return;
            next = child;
            break;
          }
          case 'ArrowLeft': {
            const toggle = rowToggle(row);
            if (toggle?.getAttribute('aria-expanded') === 'true') {
              setDisclosure(toggle, true);
              next = row;
            } else {
              next = parentRow(row);
              if (!next) return;
            }
            break;
          }
          default:
            return;
        }
        event.preventDefault();
        focusRow(next);
      });
    }
    function revealAncestorForActive(row: HTMLLIElement) {
      let ancestor = row.parentElement?.closest<HTMLLIElement>('li.grok-row') ?? null;
      while (ancestor) {
        const toggle = ancestor.querySelector<HTMLButtonElement>(
          ':scope > .grok-entry > [data-grok-toggle]');
        if (toggle && toggle.getAttribute('aria-expanded') === 'false') {
          setDisclosure(toggle, false);
        }
        ancestor = ancestor.parentElement?.closest<HTMLLIElement>('li.grok-row') ?? null;
      }
    }

    function setActive(idx: number, phase = 'active-section'){
      if (isGrok && idx >= 0) revealAncestorForActive(rows[idx]);
      rows.forEach((li, i) => {
        const active = i === idx;
        li.classList.toggle('hrail-act', active);
        li.classList.toggle('hrail-passed', idx >= 0 && i < idx);
        const link = links[i];
        if (link) {
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      });
      if(countEl) {
        countEl.textContent = phase === 'before-content'
          ? 'Введение'
          : phase === 'after-content'
            ? 'Готово'
            : (isGrok && idx < 0 ? 'Введение' : `${idx + 1} / ${rows.length}`);
      }
    }

    const readerState = (window as any).GBReaderState || (window as any).ReaderState;
    if (readerState?.configure && readerState?.subscribe) {
      readerState.configure({ headingSelector: 'h2[id], h3[id]' }).init();
      readerState.subscribe((reader: any) => {
        const sectionId = String(reader?.sectionId || '');
        const idx = links.findIndex((link) => !!link && (link.getAttribute('href') || '').replace(/^#/, '') === sectionId);
        setActive(idx, String(reader?.phase || 'before-content'));
        if(trackFill) trackFill.style.setProperty('--track-progress', String(Math.max(0, Math.min(1, Number(reader?.progressRatio) || 0))));
      });
    }


    // Share (Web Share API + clipboard fallback + "Ссылка скопирована" tip) —
    // общий контракт data-action="share" в floating-cluster-controller.js
    // (PR-4 плана unification, дрейф D8). Раньше это была bespoke-копия здесь.

    // Back, share and print are owned by ReaderActionsRuntime.
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initReaderRail, { once: true });
  else initReaderRail();
</script>