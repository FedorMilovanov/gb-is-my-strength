---
/**
 * ReaderRail — общий левый читательский рельс для одиночных статей
 * (оглавление статьи + метро-линия прогресса + нижний тулбар с ⚙). Обобщён из
 * HermenevtikaRail: TOC и триггер настроек приходят пропсами, палитра/механика —
 * те же. Герменевтика рендерит его через тонкую обёртку (байт-в-байт).
 */
export interface ReaderRailTocItem { href: string; label: string; level: number; }
interface Props {
  eyebrow: string;
  title: string;
  backHref: string;
  toc: ReaderRailTocItem[];
  /** 'hm' → CustomEvent('hm:open-settings') (ReaderSettings);
   *  'gill' → data-gill-settings-open (GillReaderSettingsSheet). */
  settingsTrigger?: 'hm' | 'gill';
  tocLabel?: string;
}
const { eyebrow, title, backHref, toc, settingsTrigger = 'hm', tocLabel = 'Оглавление статьи' } = Astro.props;
---
<aside class="hrail" aria-label={title} data-fc-root data-fc-variant="single" data-fc-mode="single">
  <!-- Верх рейла: только назад — Поиск/PLAY/Сохранить уехали в угловой
       кластер справа сверху, как у Гилла (owner: "должно быть как в Гилле,
       справа сверху PLAY, а не в левом меню... стандарт Гилла с адаптацией
       цветовой только" — MOBILE_CHROME_ENGINE_UNIFICATION_2026-07-12,
       SingleArticleCluster.astro). -->
  <div class="hrail-top">
    <button class="hrail-back" type="button" aria-label="Назад" data-home-href={backHref}>
      <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
    </button>
  </div>
  <div class="hrail-meta">
    <div class="hrail-meta__eyebrow">{eyebrow}</div>
    <p class="hrail-meta__title">{title}</p>
  </div>
  <div class="hrail-toch">
    {tocLabel}
    <b id="hrailCount">1 / {toc.length}</b>
  </div>
  <div class="hrail-scroll">
    <ul class="hrail-toc" id="hrailToc">
      <span class="hrail-track" aria-hidden="true"><i></i></span>
      {toc.map((item) => (
        <li class:list={{ 'hrail-sub': item.level === 3 }}>
          <a href={item.href}>{item.level !== 3 && <span class="hrail-dot" aria-hidden="true"></span>}{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
  <div class="hrail-bottom">
    <button class="hrail-bottom-btn" type="button" data-fc-action="search" aria-label="Поиск и разделы сайта">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <!-- Настройки чтения. 'hm' → id=hrailSettingsBtn, шлём CustomEvent
         'hm:open-settings' (ReaderSettings). 'gill' →
         data-gill-settings-open, контроллер сам открывает GillReaderSettingsSheet. -->
    <button class="hrail-bottom-btn" type="button" aria-label="Настройки чтения" aria-haspopup="dialog" data-tip="Настройки"
      id={settingsTrigger === 'hm' ? 'hrailSettingsBtn' : undefined}
      data-gill-settings-open={settingsTrigger === 'gill' ? '' : undefined}
      aria-controls={settingsTrigger === 'gill' ? 'gillSettingsOverlay' : undefined}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h10M18 7h2M4 17h2M10 17h10" /><circle cx="16" cy="7" r="2" /><circle cx="8" cy="17" r="2" /></svg>
    </button>
    <button class="hrail-bottom-btn" id="hrailShare" data-action="share" data-tip="Поделиться" type="button" aria-label="Поделиться">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="2.6" /><circle cx="6" cy="12" r="2.6" /><circle cx="18" cy="19" r="2.6" /><path d="M8.3 10.7l7.4-4.2M8.3 13.3l7.4 4.2" /></svg>
    </button>
    <button class="hrail-bottom-btn" data-action="print" type="button" aria-label="Скачать PDF">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12" /><polyline points="7 10 12 15 17 10" /><path d="M5 21h14" /></svg>
    </button>
    <!-- A−/A+ убраны (владелец 2026-07-17: «настройки в отдельном значке»):
         размер текста живёт в листе настроек, открываемом ⚙ выше. -->
  </div>
</aside>

<style is:global>
  /* ===== ReaderRail — day (warm cream + maroon) / night (dark wine + dusty rose) ===== */
  .hrail{
    position:fixed; left:clamp(16px,2.4vw,40px); top:24px; bottom:24px; width:270px;
    background:linear-gradient(180deg,#fbf3ea,#f3e6d8);
    border:1px solid #e8d9c8; border-radius:28px;
    box-shadow:0 24px 60px -20px rgba(122,46,46,.18);
    display:flex; flex-direction:column; padding:20px 16px 14px; overflow:hidden;
    z-index:var(--z-sticky,1000);
  }
  html.dark .hrail{
    background:radial-gradient(130% 50% at 24% 0%, rgba(160,50,60,.10), transparent 55%),linear-gradient(180deg,#2b1219,#1c0b10 60%,#130709);
    border-color:rgba(212,140,150,.16);
    box-shadow:0 34px 100px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.04);
  }
  /* ---- top bar: back only — Search/Play/Save moved to the corner cluster
     (SingleArticleCluster.astro, top-right, Gill's standard). ---- */
  .hrail-top{display:flex;align-items:center;gap:6px;margin:0 0 12px;position:relative}
  .hrail-back{flex:none;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;color:#7a2e2e;opacity:.85;
    transition:transform .3s,color .3s;cursor:pointer;background:none;border:0;padding:0;font:inherit}
  html.dark .hrail-back{color:#e0a89c}
  .hrail-back svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.8}
  @media(hover:hover) and (pointer:fine){
    .hrail-back:hover{transform:translateX(-3px);color:#5f2323}
    html.dark .hrail-back:hover{color:#f2c4b6}
  }

  .hrail-meta{padding:2px 4px 14px}
  .hrail-meta__eyebrow{font-size:9.5px;font-weight:900;letter-spacing:.2em;text-transform:uppercase;color:#7a2e2e}
  html.dark .hrail-meta__eyebrow{color:#d68a7a}
  .hrail-meta__title{font-family:var(--f-serif,Lora,Georgia,serif);font-size:17px;font-weight:700;line-height:1.28;color:#2a1814;margin:6px 0 0}
  html.dark .hrail-meta__title{color:#f2e9e6}

  .hrail-toch{display:flex;align-items:center;gap:8px;padding:12px 2px 8px;font-size:9.5px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:rgba(42,24,20,.5);border-top:1px solid rgba(0,0,0,.08)}
  html.dark .hrail-toch{color:rgba(255,255,255,.5);border-top-color:rgba(255,255,255,.07)}
  .hrail-toch b{margin-left:auto;background:rgba(122,46,46,.08);border:1px solid rgba(122,46,46,.22);border-radius:99px;padding:2px 9px;font-size:10px;color:#7a2e2e;font-variant-numeric:tabular-nums}
  html.dark .hrail-toch b{background:rgba(212,168,87,.08);border-color:rgba(224,160,150,.24);color:#e0a89c}
  .hrail-scroll{flex:1 1 auto; overflow-y:auto; margin-right:-8px; padding-right:8px}
  .hrail-toc{position:relative;list-style:none;margin:6px 0 0;padding:2px 12px 14px 0;--toc-axis-x:22px;--toc-sub-in:16px}
  .hrail-track{position:absolute;left:calc(var(--toc-axis-x) - 1px);width:2px;border-radius:9px;overflow:hidden;
    top:14px;bottom:22px;background:rgba(0,0,0,.08)}
  html.dark .hrail-track{background:rgba(255,255,255,.08)}
  .hrail-track i{position:absolute;left:0;top:0;width:100%;height:100%;border-radius:9px;overflow:hidden;
    transform-origin:50% 0;transform:scaleY(var(--track-progress,0));
    /* 120ms, not the old 460ms: progress now updates continuously every
       scroll frame (see script below), not just on discrete heading jumps —
       a long transition would fight that and permanently lag behind the
       real scroll position instead of tracking it. */
    transition:transform 120ms linear;
    background:linear-gradient(180deg,#c4694c 0%,#a94847 48%,#7a2e2e 100%)}
  .hrail-toc li{position:relative;margin:1px 0;padding-left:38px}
  .hrail-toc a{display:block;padding:6px 10px;border-radius:9px;color:rgba(42,24,20,.68);text-decoration:none;
    font-family:var(--f-serif,Lora,Georgia,serif);font-size:12.5px;line-height:1.3;transition:color .2s,background-color .2s}
  html.dark .hrail-toc a{color:rgba(255,255,255,.62)}
  .hrail-dot{position:absolute;left:calc(var(--toc-axis-x) - 4.5px);top:50%;width:9px;height:9px;margin-top:-4.5px;border-radius:50%;
    border:2px solid rgba(42,24,20,.22);background:#fff;box-shadow:0 0 0 3px #f3e6d8;z-index:1;transition:.2s}
  html.dark .hrail-dot{border-color:rgba(255,255,255,.18);background:#1c0e10;box-shadow:0 0 0 3px #170b0c}
  .hrail-toc li.hrail-passed .hrail-dot{background:#b85c3e;border-color:#b85c3e}
  /* Sub-items: pushed further right (no dot of their own — the track/dots
     mark only the article's main sections, matching "пункты и подпункты, а
     не просто список" — subs read as nested text, not extra stops). */
  .hrail-toc li.hrail-sub{padding-left:calc(38px + var(--toc-sub-in))}
  .hrail-toc li.hrail-sub a{font-size:11px}
  .hrail-toc li.hrail-sub:not(.hrail-act):not(.hrail-passed) a{color:rgba(42,24,20,.5)}
  html.dark .hrail-toc li.hrail-sub:not(.hrail-act):not(.hrail-passed) a{color:rgba(255,255,255,.46)}
  .hrail-toc li.hrail-act a{background:linear-gradient(90deg,rgba(122,46,46,.14),rgba(122,46,46,.045) 72%,transparent);
    color:#2a1814;font-weight:700;box-shadow:inset 0 0 0 1px rgba(122,46,46,.22)}
  html.dark .hrail-toc li.hrail-act a{background:linear-gradient(90deg,rgba(122,46,46,.44),rgba(122,46,46,.16) 72%,rgba(122,46,46,.05));
    color:#f6efe9;box-shadow:inset 0 0 0 1px rgba(224,160,150,.16)}
  .hrail-toc li.hrail-act .hrail-dot{background:#dd7c5d;border-color:#dd7c5d;transform:scale(1.11)}
  @media(hover:hover) and (pointer:fine){
    .hrail-toc li:not(.hrail-act) a:hover{color:#2a1814;background:rgba(122,46,46,.05)}
    html.dark .hrail-toc li:not(.hrail-act) a:hover{color:#f6efe9;background:rgba(255,255,255,.03)}
  }

  /* Bottom row: site menu / share / print / font-size — plain SVG icon
     buttons in a flat row, no boxed icon+label grid (owner: "слишком
     громоздко", "нужны минималистичные SVG"). Halo-on-hover only, matching
     canon .gb-icon. The "≡" opens the sitewide command palette (real search
     + navigation), not a dead link — owner: "проработай меню умнее, полнее". */
  .hrail-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:8px;padding:10px 4px 0;border-top:1px solid rgba(0,0,0,.08)}
  html.dark .hrail-bottom{border-top-color:rgba(255,255,255,.07)}
  .hrail-bottom-btn{position:relative;width:31px;height:31px;border-radius:50%;display:grid;place-items:center;color:#8a5a4a;cursor:pointer;
    transition:color .25s,transform .25s cubic-bezier(.34,1.56,.64,1);background:none;border:0;padding:0;font:inherit;text-decoration:none}
  .hrail-bottom-btn::before{content:'';position:absolute;inset:2px;border-radius:50%;border:1px solid currentColor;
    opacity:0;transform:scale(.7);transition:opacity .25s,transform .3s cubic-bezier(.34,1.56,.64,1)}
  html.dark .hrail-bottom-btn{color:#caa1a0}
  @media(hover:hover) and (pointer:fine){
    .hrail-bottom-btn:hover{color:#7a2e2e;transform:translateY(-1px)}
    .hrail-bottom-btn:hover::before{opacity:.3;transform:scale(1)}
    html.dark .hrail-bottom-btn:hover{color:#f2c9c9}
  }
  .hrail-bottom-btn svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .hrail-bottom-btn--text{font-family:var(--f-serif,Lora,Georgia,serif);font-size:12px;font-weight:700}

  @media(max-width:1200px){ .hrail{display:none} }

  /* Article column clears the fixed rail on desktop only — text stays centred
     in the viewport when there's room, the rail just hugs the left edge (Gill
     precedent). .article-main's own base rule sets width:min(820px,92vw) with
     margin:0 auto; a same-specificity override risks losing to load order, so
     this uses the doubled-class selector to win outright. */
  @media(min-width:1200px){
    .article-main.article-main--hrail{ margin-left: max((100vw - min(820px, 92vw)) / 2, 334px); }
  }
</style>

<script>
  function initReaderRail(){
    // Десктопная шестерёнка «Настройки чтения» — тот же лист
    // ReaderSettings, что открывается с мобильного #hmSettingsBtn
    // (через событие 'hm:open-settings'). Независимо от наличия TOC.
    const railSettingsBtn = document.getElementById('hrailSettingsBtn');
    if (railSettingsBtn && !railSettingsBtn.dataset.bound) {
      railSettingsBtn.dataset.bound = '1';
      railSettingsBtn.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('hm:open-settings'));
      });
    }

    const toc = document.getElementById('hrailToc');
    const countEl = document.getElementById('hrailCount');
    if(!toc) return;
    const rows = Array.from(toc.querySelectorAll('li'));
    const links = rows.map((li) => li.querySelector('a'));
    const targets = links.map((a) => a ? document.querySelector(a.getAttribute('href') || '') : null);
    const track = toc.querySelector('.hrail-track') as HTMLElement | null;
    const trackFill = track ? track.querySelector('i') as HTMLElement | null : null;

    function setActive(idx: number){
      rows.forEach((li, i) => {
        li.classList.toggle('hrail-act', i === idx);
        li.classList.toggle('hrail-passed', i < idx);
      });
      if(countEl) countEl.textContent = `${idx + 1} / ${rows.length}`;
    }

    // Bug fixed: the old fill was a step function — (idx+1)/rows.length only
    // moved when scroll crossed the NEXT heading, so it sat frozen through
    // long sections ("не всегда начинает идти") and started at 1/N instead
    // of 0 on load ("начинается не с начала"). This interpolates continuously
    // between the active heading and the next one (or the document's bottom
    // edge for the last heading), so the line tracks scroll position smoothly
    // and starts empty at the very top of the article.
    function updateTrackFill(idx: number, line: number){
      if(!trackFill) return;
      const scrollY = window.scrollY;
      const positions = targets.map((el) => el ? el.getBoundingClientRect().top + scrollY : null);
      const curPos = positions[idx] ?? 0;
      const docBottom = document.documentElement.scrollHeight - window.innerHeight + line;
      const nextPos = (idx + 1 < positions.length && positions[idx + 1] !== null) ? (positions[idx + 1] as number) : docBottom;
      const span = nextPos - curPos;
      const frac = span > 0 ? Math.max(0, Math.min(1, (scrollY + line - curPos) / span)) : 0;
      const progress = Math.max(0, Math.min(1, (idx + frac) / rows.length));
      trackFill.style.setProperty('--track-progress', String(progress));
    }

    let ticking = false;
    function onScroll(){
      if(ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        let idx = 0;
        const line = window.innerHeight * 0.3;
        targets.forEach((el, i) => {
          if(el && el.getBoundingClientRect().top <= line) idx = i;
        });
        setActive(idx);
        updateTrackFill(idx, line);
      });
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Share (Web Share API + clipboard fallback + "Ссылка скопирована" tip) —
    // общий контракт data-action="share" в floating-cluster-controller.js
    // (PR-4 плана unification, дрейф D8). Раньше это была bespoke-копия здесь.

    const backBtn = document.querySelector('.hrail-back') as HTMLElement | null;
    if(backBtn){
      const href = backBtn.dataset.homeHref;
      if(href) backBtn.addEventListener('click', () => { window.location.href = href; });
    }
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initReaderRail, { once: true });
  else initReaderRail();
</script>
