---
/**
 * MobileSheetShell — общий скелет нижнего листа (sheet/overlay).
 *
 * (Пакет GILL_RESEARCH_3_ENGINES, документ 03 §5.) Единый каркас для всех
 * листов движков: TOC, Learning, Settings, Search, Actions. Даёт общий
 * backdrop-контракт (.toc-overlay), диалог (role="dialog", aria-modal),
 * ручку-закрытие и слоты head / body / actions.
 *
 * Классы совпадают с текущим Gill каноном (.toc-overlay / .toc-sheet), плюс
 * добавляются data-mobile-sheet и .mobile-sheet* — чтобы рантайм мог управлять
 * всеми листами единообразно (взаимное исключение: открыт ровно один лист,
 * один scroll-lock, один focus-trap), не ломая существующие Gill-стили.
 */
import type { MobileSheetKind } from './mobileChromeTypes';

interface Props {
  id: string;
  label: string;
  titleId?: string;
  kind: MobileSheetKind;
}
const { id, label, titleId, kind } = Astro.props as Props;
---
<div
  id={id}
  class:list={['toc-overlay', 'mobile-sheet-overlay', `mobile-sheet-overlay--${kind}`]}
  data-mobile-sheet={kind}
  aria-hidden="true"
>
  <section
    class:list={['toc-sheet', 'mobile-sheet', `mobile-sheet--${kind}`]}
    role="dialog"
    aria-modal="true"
    aria-label={titleId ? undefined : label}
    aria-labelledby={titleId}
  >
    <button
      type="button"
      class="toc-sheet__handle"
      data-mobile-sheet-close
      aria-label="Закрыть"
    ></button>
    <slot name="head" />
    <slot />
    <slot name="actions" />
  </section>
</div>
