---
/**
 * HeartSheetParts — the mobile sheet «Части серии» list (.gbs2-sheet-parts),
 * rendered from heartSeriesData. Roman entries get a «{roman} · …» title
 * prefix; label book-ends carry their full title verbatim.
 */
import HeartLeatherRibbon from './HeartLeatherRibbon.astro';
import { HEART_SERIES_ITEMS, heartRoman, type HeartPageId } from './heartSeriesData';

interface Props { pageId: HeartPageId }
const { pageId } = Astro.props;
---
<div class="gbs2-sheet-parts">{HEART_SERIES_ITEMS.map((item) => {
  const cur = item.id === pageId;
  const href = cur ? './' : `../${item.slug}/`;
  const roman = heartRoman(item.id);
  const title = item.kind === 'roman' ? `${roman} · ${item.sheetTitle}` : item.sheetTitle;
  const small = `${item.sheetSub} · ${item.minutes} мин`;
  return (
    <a aria-current={cur ? 'page' : undefined} class="gbs2-sheet-part" href={href}>{item.ribbon
      ? <HeartLeatherRibbon word={item.ribbon.word} ornament={item.ribbon.ornament} variant={item.ribbon.variant} />
      : item.thumbImg
        ? <img alt="" height="315" src={`../../images/${item.thumbImg}`} width="600"/>
        : <span class="gbs2-noimg" style="width:64px;height:44px;border-radius:9px;flex:0 0 auto;position:relative"><b class="gbs2-noimg-n">{roman}</b></span>}<span><b>{title}</b><small>{small}</small></span></a>
  );
})}</div>
