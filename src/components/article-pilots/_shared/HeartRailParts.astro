---
/**
 * HeartRailParts — the desktop rail «Части серии» list (.gbs2-parts), rendered
 * from heartSeriesData. Replaces the hand-drawn 6-row block in every hard-texts
 * pilot Body. Order, roman numerals and the current-page marker all derive from
 * the data — a series reorder needs no edit here.
 */
import HeartLeatherRibbon from './HeartLeatherRibbon.astro';
import { HEART_SERIES_ITEMS, heartMark, heartRoman, type HeartPageId } from './heartSeriesData';

interface Props { pageId: HeartPageId }
const { pageId } = Astro.props;
---
<nav aria-label="Части серии" class="gbs2-parts">{HEART_SERIES_ITEMS.map((item) => {
  const cur = item.id === pageId;
  const href = cur ? './' : `../${item.slug}/`;
  const pn = `${heartMark(item)} · ${item.minutes} мин`;
  return (
    <a aria-current={cur ? 'page' : undefined} class="gbs2-part" href={href}>{item.ribbon
      ? <HeartLeatherRibbon word={item.ribbon.word} ornament={item.ribbon.ornament} variant={item.ribbon.variant} />
      : item.thumbImg
        ? <span class="gbs2-thumb"><img alt="" decoding="async" height="315" loading="lazy" src={`../../images/${item.thumbImg}`} width="600"/></span>
        : <span class="gbs2-thumb gbs2-noimg"><b class="gbs2-noimg-n">{heartRoman(item.id)}</b></span>}<span><span class="gbs2-pn">{pn}</span><span class="gbs2-pt">{item.railTitle}</span><span class="gbs2-ps">{item.railSub}</span></span><span aria-hidden="true" class="gbs2-check">✓</span></a>
  );
})}</nav>
