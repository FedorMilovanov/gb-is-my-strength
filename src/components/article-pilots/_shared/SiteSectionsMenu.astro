---
import SiteSectionsMenuRuntime from './SiteSectionsMenuRuntime.astro';

type CurrentSection = 'biografii' | 'articles';
type Variant = 'plain' | 'rich';

interface Props {
  current?: CurrentSection;
  variant?: Variant;
}

const { current, variant = 'rich' } = Astro.props;
const links = [
  { id: 'publications', href: '/#publikacii', label: 'Публикации', description: 'Книги, циклы и исследования', group: 'reading' },
  { id: 'refutations', href: '/#razbor', label: 'Разбор заблуждений', description: 'Богословские разборы', group: 'reading' },
  { id: 'biografii', href: '/biografii/', label: 'Биографии', description: 'Жизнь и наследие христиан', group: 'reading' },
  { id: 'articles', href: '/articles/', label: 'Все статьи', description: 'Каталог отдельных материалов', group: 'reading' },
  { id: 'app', href: '/app/', label: 'Приложение', description: 'Инструменты для чтения', group: 'project' },
  { id: 'about', href: '/about/', label: 'О проекте', description: 'Информация о библиотеке', group: 'project' },
] as const;
---
<!-- Canonical static projection of the site-sections menu. Runtime lifecycle is
     owned by SiteSectionsMenuRuntime -> OverlayRuntime across every shell.
     The rich reader treatment is owned here as well, so standalone and series
     readers cannot silently depend on Gill-only CSS for a usable menu.

     Closed-state safety is intentionally native as well as visual: hidden +
     inert make the menu/backdrop non-rendering before CSS/runtime ownership is
     established, and the chevron SVG carries bounded geometry/fill attributes
     so a missing stylesheet can never turn it into a 300x150 black triangle. -->
<div
  id="hMobileBackdrop"
  class:list={['h-mobile-backdrop', variant === 'rich' && 'gb-site-menu-backdrop--rich']}
  aria-hidden="true"
  hidden
></div>
<div
  class:list={['h-mobile-nav', variant === 'rich' && 'gb-site-menu--rich']}
  id="hMobileNav"
  aria-hidden="true"
  inert
  hidden
  data-gb-site-menu-runtime="canonical"
  data-gb-site-menu-variant={variant}
>
  {variant === 'rich' && <span class="gbs-menu-label" aria-hidden="true">Разделы сайта</span>}
  {variant === 'rich' && (
    <div class="gbs-menu-desktop-filter" data-gb-menu-filter-wrap>
      <label for="gbSiteMenuFilter">Быстро найти раздел</label>
      <div class="gbs-menu-filter-field">
        <input id="gbSiteMenuFilter" type="search" data-gb-menu-filter
          autocomplete="off" spellcheck="false" placeholder="Например, биографии"
          aria-describedby="gbSiteMenuFilterStatus" />
        <button type="button" data-gb-menu-clear aria-label="Очистить фильтр разделов" hidden>×</button>
      </div>
      <p data-gb-menu-status id="gbSiteMenuFilterStatus" role="status" aria-live="polite" aria-atomic="true">Всего разделов: 6</p>
    </div>
  )}
  {links.map((link, index) => (
    <>
      {variant === 'rich' && (index === 0 || index === 4) && (
        <span class="gbs-menu-group-heading" data-gb-menu-group-title={link.group} aria-hidden="true">
          {index === 0 ? 'Читать и исследовать' : 'Проект'}
        </span>
      )}
      <a href={link.href} data-close-nav
        data-gb-menu-section={variant === 'rich' ? '' : undefined}
        data-gb-menu-group={variant === 'rich' ? link.group : undefined}
        aria-current={current === link.id ? 'page' : undefined}>
      {variant === 'rich' ? (
        <>
          <span class="gbs-menu-entry-copy"><span>{link.label}</span><small class="gbs-menu-description">{link.description}</small></span>
          <svg
            class="gbs-menu-chevron"
            viewBox="0 0 24 24"
            width="13"
            height="13"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          ><path d="M9 18l6-6-6-6" /></svg>
        </>
      ) : link.label}
      </a>
    </>
  ))}
  {variant === 'rich' && <p class="gbs-menu-no-matches" data-gb-menu-empty hidden>Совпадений нет. Уточните запрос или очистите фильтр.</p>}
</div>

<noscript>
  <nav data-gb-site-menu-nojs aria-label="Основная навигация без JavaScript">
    <ul>
      {links.map((link) => (
        <li><a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
</noscript>

<SiteSectionsMenuRuntime />

<style is:global>
  /* Rich menu is a shared reader primitive. Before this ownership boundary,
     the same markup was styled only under body:has([data-gill-v16]), leaving
     standalone ReaderRail routes with an unpositioned panel and 300px SVGs.
     Keep the card independent of the historical Gill implementation name. */
  #hMobileNav.gb-site-menu--rich {
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    position: fixed;
    z-index: var(--z-panel, 19000);
    margin: 0;
    box-sizing: border-box;
    transition:
      opacity .26s cubic-bezier(.22, .72, .22, 1),
      transform .32s cubic-bezier(.22, 1, .36, 1),
      visibility 0s linear .32s;
  }
  #hMobileNav.gb-site-menu--rich.open {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transition:
      opacity .26s cubic-bezier(.22, .72, .22, 1),
      transform .32s cubic-bezier(.22, 1, .36, 1),
      visibility 0s linear 0s;
  }
  #hMobileNav.gb-site-menu--rich .gbs-menu-label {
    display: block;
    padding: 6px 12px 9px;
    margin-bottom: 2px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-gold, #b8936a) 18%, var(--color-border, #e5e2dc));
    font-family: var(--gb-font-sans, "Source Sans 3", system-ui, sans-serif);
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-text-muted, #6a6a6a);
  }
  #hMobileNav.gb-site-menu--rich a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 0;
    padding: 10px 12px;
    border-radius: 10px;
    border-left: 2px solid transparent;
    font-family: var(--gb-font-serif, Georgia, serif);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text, #1a1a1a);
    text-decoration: none;
    transition: background .16s ease, color .16s ease, border-color .16s ease, padding-left .16s ease;
  }
  #hMobileNav.gb-site-menu--rich a + a {
    border-top: 1px solid color-mix(in srgb, var(--color-border, #e5e2dc) 60%, transparent);
  }
  #hMobileNav.gb-site-menu--rich .gbs-menu-chevron {
    display: block;
    width: 13px;
    height: 13px;
    max-width: 13px;
    max-height: 13px;
    flex: 0 0 13px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity .18s ease, transform .22s cubic-bezier(.34, 1.56, .64, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    #hMobileNav.gb-site-menu--rich a:hover {
      background: color-mix(in srgb, var(--color-accent-gold, #b8936a) 10%, transparent);
      color: var(--color-accent, #7a2e2e);
      border-left-color: var(--color-accent, #7a2e2e);
      padding-left: 16px;
    }
    #hMobileNav.gb-site-menu--rich a:hover .gbs-menu-chevron {
      opacity: .75;
      transform: translateX(0);
    }
    html.dark #hMobileNav.gb-site-menu--rich a:hover {
      background: color-mix(in srgb, var(--gb-accent-gold-bright, #f0c896) 15%, transparent);
      color: var(--gb-accent-gold-bright, #f0c896);
      border-left-color: var(--gb-accent-gold-bright, #f0c896);
    }
  }
  html.dark #hMobileNav.gb-site-menu--rich a + a {
    border-top-color: rgba(255,255,255,.06);
  }

  @media (min-width: 64em) {
    #hMobileNav.gb-site-menu--rich {
      top: auto;
      bottom: 78px;
      left: 26px;
      right: auto;
      width: 230px;
      max-width: calc(100vw - 52px);
      padding: 8px;
      border-radius: 16px;
      background: color-mix(in srgb, var(--color-surface, #fff) 96%, transparent);
      border: 1.5px solid color-mix(in srgb, var(--color-accent-gold, #b8936a) 30%, var(--color-border, #e5e2dc));
      box-shadow: 0 20px 50px -20px rgba(20,12,6,.35), 0 8px 26px -14px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.5);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      backdrop-filter: blur(20px) saturate(180%);
      transform: translateY(10px) scale(.97);
      transform-origin: bottom left;
    }
    #hMobileNav.gb-site-menu--rich.open { transform: none; }
    html.dark #hMobileNav.gb-site-menu--rich {
      background: color-mix(in srgb, var(--color-surface, #161a21) 94%, transparent);
      border-color: color-mix(in srgb, var(--color-accent-gold, #b8936a) 22%, rgba(255,255,255,.08));
      box-shadow: 0 20px 50px -20px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.05);
    }
    #hMobileNav.gb-site-menu--rich::after {
      content: '';
      position: absolute;
      bottom: -7px;
      left: 28px;
      width: 13px;
      height: 13px;
      background: color-mix(in srgb, var(--color-surface, #fff) 96%, transparent);
      border-right: 1.5px solid color-mix(in srgb, var(--color-accent-gold, #b8936a) 30%, var(--color-border, #e5e2dc));
      border-bottom: 1.5px solid color-mix(in srgb, var(--color-accent-gold, #b8936a) 30%, var(--color-border, #e5e2dc));
      transform: rotate(45deg);
      border-radius: 0 0 3px 0;
    }
    html.dark #hMobileNav.gb-site-menu--rich::after {
      background: color-mix(in srgb, var(--color-surface, #161a21) 94%, transparent);
      border-color: color-mix(in srgb, var(--color-accent-gold, #b8936a) 22%, rgba(255,255,255,.08));
    }
  }

  @media (max-width: 63.999em) {
    #hMobileNav.gb-site-menu--rich {
      top: max(12px, env(safe-area-inset-top, 0px));
      left: max(12px, env(safe-area-inset-left, 0px));
      right: max(12px, env(safe-area-inset-right, 0px));
      width: auto;
      max-height: calc(100dvh - 24px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));
      overflow: auto;
      padding: 10px;
      border-radius: 18px;
      background: color-mix(in srgb, var(--color-surface, #fff) 97%, transparent);
      border: 1px solid var(--color-border, #e5e2dc);
      box-shadow: 0 24px 70px -26px rgba(0,0,0,.42);
      transform: translateY(-8px) scale(.985);
      transform-origin: top center;
    }
    #hMobileNav.gb-site-menu--rich.open { transform: none; }
    html.dark #hMobileNav.gb-site-menu--rich {
      background: color-mix(in srgb, var(--color-surface, #161a21) 96%, transparent);
      border-color: rgba(255,255,255,.1);
    }
    .gb-site-menu-backdrop--rich {
      display: none;
      position: fixed;
      inset: 0;
      z-index: calc(var(--z-panel, 19000) - 1);
      background: rgba(20,14,9,.34);
      -webkit-backdrop-filter: blur(2px);
      backdrop-filter: blur(2px);
    }
    .gb-site-menu-backdrop--rich.open { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    #hMobileNav.gb-site-menu--rich,
    #hMobileNav.gb-site-menu--rich .gbs-menu-chevron {
      transition: none !important;
    }
  }
  /* Desktop-only progressive enhancement. Mobile and no-JS remain the same
     six canonical links, with one OverlayRuntime owner for open/close. */
  #hMobileNav.gb-site-menu--rich .gbs-menu-desktop-filter,
  #hMobileNav.gb-site-menu--rich .gbs-menu-group-heading,
  #hMobileNav.gb-site-menu--rich .gbs-menu-description { display: none; }
  #hMobileNav.gb-site-menu--rich a[data-gb-menu-section][hidden],
  #hMobileNav.gb-site-menu--rich [data-gb-menu-group-title][hidden],
  #hMobileNav.gb-site-menu--rich [data-gb-menu-empty][hidden] { display: none; }
  @media (min-width: 85em) {
    #hMobileNav.gb-site-menu--rich {
      width: 300px;
      max-height: min(520px, calc(100dvh - 100px));
      overflow-x: hidden;
      overflow-y: auto;
      scrollbar-width: thin;
      overscroll-behavior: contain;
    }
    #hMobileNav.gb-site-menu--rich .gbs-menu-desktop-filter {
      display: block;
      position: sticky;
      z-index: 1;
      top: -8px;
      padding: 10px 12px 8px;
      background: var(--color-surface, #fff);
      border-bottom: 1px solid var(--color-border, #e5e2dc);
    }
    html.dark #hMobileNav.gb-site-menu--rich .gbs-menu-desktop-filter {
      background: var(--color-surface, #161a21);
    }
    #hMobileNav.gb-site-menu--rich .gbs-menu-desktop-filter > label {
      display: block;
      margin-bottom: 5px;
      color: var(--color-text-muted, #6a6a6a);
      font: 700 10px/1.3 var(--gb-font-sans, system-ui, sans-serif);
    }
    #hMobileNav.gb-site-menu--rich .gbs-menu-filter-field {
      display: flex;
      align-items: center;
      min-height: 36px;
      gap: 5px;
      padding: 0 6px 0 10px;
      border: 1px solid var(--color-border, #e5e2dc);
      border-radius: 9px;
      background: var(--color-surface, #fff);
    }
    #hMobileNav.gb-site-menu--rich .gbs-menu-filter-field:focus-within {
      border-color: var(--color-accent, #7a2e2e);
      outline: 2px solid color-mix(in srgb, var(--color-accent, #7a2e2e) 20%, transparent);
      outline-offset: 1px;
    }
    #hMobileNav.gb-site-menu--rich [data-gb-menu-filter] {
      flex: 1;
      min-width: 0;
      width: 100%;
      padding: 8px 0;
      border: 0;
      outline: 0;
      color: var(--color-text, #1a1a1a);
      background: transparent;
      font: 500 12px/1.4 var(--gb-font-sans, system-ui, sans-serif);
    }
    #hMobileNav.gb-site-menu--rich [data-gb-menu-clear] {
      flex: 0 0 27px;
      width: 27px;
      height: 27px;
      border: 0;
      border-radius: 6px;
      background: transparent;
      color: var(--color-text-muted, #6a6a6a);
      font-size: 18px;
      cursor: pointer;
    }
    #hMobileNav.gb-site-menu--rich [data-gb-menu-clear][hidden] { display: none; }
    #hMobileNav.gb-site-menu--rich [data-gb-menu-clear]:hover {
      background: color-mix(in srgb, var(--color-accent-gold, #b8936a) 12%, transparent);
    }
    #hMobileNav.gb-site-menu--rich [data-gb-menu-status] {
      margin: 5px 0 0;
      color: var(--color-text-muted, #6a6a6a);
      font: 500 10px/1.35 var(--gb-font-sans, system-ui, sans-serif);
    }
    #hMobileNav.gb-site-menu--rich .gbs-menu-group-heading {
      display: block;
      padding: 12px 12px 4px;
      color: var(--color-text-muted, #6a6a6a);
      font: 750 9px/1.35 var(--gb-font-sans, system-ui, sans-serif);
      letter-spacing: .11em;
      text-transform: uppercase;
    }
    #hMobileNav.gb-site-menu--rich .gbs-menu-entry-copy {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
    #hMobileNav.gb-site-menu--rich .gbs-menu-description {
      display: block;
      margin-top: 2px;
      color: var(--color-text-muted, #6a6a6a);
      font: 400 10.5px/1.4 var(--gb-font-sans, system-ui, sans-serif);
    }
    #hMobileNav.gb-site-menu--rich a[data-gb-menu-section] {
      min-height: 45px;
      padding-top: 8px;
      padding-bottom: 8px;
    }
    #hMobileNav.gb-site-menu--rich .gbs-menu-no-matches {
      margin: 10px 7px;
      padding: 12px;
      border: 1px dashed var(--color-border, #e5e2dc);
      border-radius: 9px;
      color: var(--color-text-muted, #6a6a6a);
      font: 500 12px/1.5 var(--gb-font-sans, system-ui, sans-serif);
    }
  }
  @media (min-width: 85em) and (max-height: 360px) {
    #hMobileNav.gb-site-menu--rich { max-height: calc(100dvh - 90px); }
    #hMobileNav.gb-site-menu--rich .gbs-menu-label { padding-top: 3px; padding-bottom: 5px; }
    #hMobileNav.gb-site-menu--rich .gbs-menu-desktop-filter { padding-top: 5px; padding-bottom: 3px; }
    #hMobileNav.gb-site-menu--rich .gbs-menu-desktop-filter > label { margin-bottom: 2px; }
    #hMobileNav.gb-site-menu--rich .gbs-menu-group-heading { padding-top: 5px; }
  }
</style>
