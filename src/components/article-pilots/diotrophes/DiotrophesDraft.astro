          <ol type="A">
            {options.map((option, optionIndex) => <li data-correct={optionIndex === correct ? 'true' : 'false'}>{option}</li>)}
          </ol>
          <p><strong>Разбор:</strong> {explanation}</p>
        </details>
      ))}
    </section>

