---
import manifest from '../../../../data/diotrophes-wave11-faithful-witness-manifest.json';
import caseData from '../../../../data/diotrophes-wave11-faithful-witness-cases.json';
import responseData from '../../../../data/diotrophes-wave11-faithful-witness-responses.json';
import sourceData from '../../../../data/diotrophes-wave11-faithful-witness-sources.json';

const content = manifest;
const pathways = caseData.casePathways;
const responses = responseData.faithfulResponses;
const readerSources = sourceData.readerSources;

// The Wave 11 evidence snapshot remains unchanged. These are narrowly verified
// reader-facing clarifications, not edits to the historical Research handoff.
const readerStepCorrections: Record<string, Record<string, string>> = {
  'cj-mahaney': {
    'осуждение советом': 'совет старейшин осуждает публичные заявления Брента Детуайлера',
  },
  'paige-patterson': {
    'разрешение на доступ к записи': 'изучение записи студентки, предоставленной с её разрешения',
  },
};
const readerStep = (caseId: string, step: string) => readerStepCorrections[caseId]?.[step] ?? step;

// Explicit editorial cross-references, not a numbered one-to-one pairing or a
// claim that any single response resolves every manifestation of a problem.
const relatedAntiAdvice: Record<string, readonly number[]> = {
  'FW-01': [3, 8, 17],
  'FW-02': [17, 19],
  'FW-03': [17, 19],
  'FW-04': [10, 14],
  'FW-05': [10, 14],
  'FW-06': [4, 6],
  'FW-07': [5, 6, 15],
  'FW-08': [13, 19],
  'FW-09': [18, 19],
  'FW-10': [20],
  'FW-11': [18],
  'FW-12': [10, 14],
  'FW-13': [4, 6],
  'FW-14': [4, 19],
  'FW-15': [18, 19],
  'FW-16': [16, 17],
  'FW-17': [1, 2],
  'FW-18': [7, 16],
  'FW-19': [18, 20],
  'FW-20': [20],
};

---

<section
  class="article-body faithful-witness-supplement"
  id="faithful-witness-under-pressure"
  aria-labelledby="faithful-witness-heading"
  data-wave11-faithful-witness="true"
  data-faithful-cases={content.counts.casePathways}
  data-faithful-responses={content.counts.faithfulResponses}
  data-authority-sources={content.counts.totalAuthoritySources}
  data-reader-links={content.counts.totalReaderLinks}
>
  <header class="article-header">
    <p class="anti-kicker">Верные люди в трудной церковной ситуации</p>
    <h2 id="faithful-witness-heading">Как сохраняли верность Богу, не превращая послушание лидеру в молчание</h2>
    <p>
      Выше рассмотрены механизмы власти. Теперь внимание обращено к людям, которые жили
      внутри кризиса: сестёр и братьев, рядовых членов, сотрудников, пасторов-собратьев,
      старейшин, попечителей и защитников пострадавших. Они часто не хотели разрушать церковь,
      не отрицали добра, полученного через служение, и не начинали с публичного обвинения.
      Но постепенно обнаруживали, что любовь к общине требует не только терпения, а правды,
      защиты слабого и реальной подотчётности.
    </p>
  </header>

  <div class="warn-box">
    <strong>Главная граница.</strong>
    Несогласие не равно злоупотреблению, сообщение не равно доказанному факту, а сильный
    характер не равен диотрефству. Но церковная лояльность не требует скрывать преступление,
    возвращать уязвимого человека один на один к контролирующему лидеру или считать всякую
    независимую проверку мятежом.
  </div>

  <aside class="summary-card" aria-labelledby="faithful-witness-summary">
    <h3 id="faithful-witness-summary">Что повторялось в зрелых путях</h3>
    <ul>
      <li>люди называли конкретные решения и действия, а не ставили психологический диагноз;</li>
      <li>там, где это было безопасно, пытались говорить внутри и привлекали нескольких служителей;</li>
      <li>сохраняли письма, даты и решения, чтобы отличить память от документа;</li>
      <li>искали независимое подтверждение, а не собирали партию слухов;</li>
      <li>обращались к старейшинам, попечителям, сети или деноминации, способным реально ограничить лидера;</li>
      <li>при преступлении и риске для уязвимых не заменяли гражданскую власть церковной беседой;</li>
      <li>после кризиса добивались не только смены имени, но исправления устройства власти.</li>
    </ul>
  </aside>

  <h2 id="fifteen-faithful-pathways">Пятнадцать реальных путей</h2>
  <p>
    Ни один путь не объявляется универсальной схемой или обязательной последовательностью
    ухудшения церковной жизни. В каждой истории следует отдельно различать исходное событие
    и то, как руководство отреагировало на сообщение о нём: критика процедуры не доказывает
    автоматически предъявленное человеку обвинение. В одних случаях личный разговор был
    безопасен; в других требование «сначала иди к пастору» могло вернуть уязвимого человека
    под прежний контроль. Кто-то оставался внутри и добивался исправления, другие уходили
    ради защиты семьи, но содействовали независимой проверке. Для каждого случая отдельно
    указана граница допустимого вывода.
  </p>

  <div class="case-grid faithful-pathway-grid">
    {pathways.map((pathway) => (
      <section class="note-box evidence-card faithful-pathway" id={`faithful-${pathway.id}`} data-faithful-case={pathway.id} data-evidence-records={pathway.sourceIds.join(',')}>
        <h3>{pathway.name}</h3>
        <p><strong>Кто действовал:</strong> {pathway.actors}.</p>
        <p><strong>Напряжение верности:</strong> {pathway.loyaltyTension}</p>
        <ol class="action-chain">
          {pathway.steps.map((step) => <li>{readerStep(pathway.id, step)}</li>)}
        </ol>
        <p><strong>Урок:</strong> {pathway.lesson}</p>
        <p class="muted"><strong>Граница:</strong> {pathway.boundary}</p>
        <p class="source-ref">
          <strong>Документальные ссылки:</strong>
          {readerSources.filter((source) => pathway.sourceIds.includes(source.id)).map((source, index) => (
            <span>{index > 0 ? ' · ' : ' '}<a href={source.href} rel="noopener noreferrer">{source.label}</a></span>
          ))}
          {pathway.id === 'paige-patterson' && (
            <span> <a href="#sources">Три заявления SWBTS о Паттерсоне и решениях попечителей находятся в основном списке источников выше</a>.</span>
          )}
          {!readerSources.some((source) => pathway.sourceIds.includes(source.id)) && pathway.id !== 'paige-patterson' && (
            <span> См. основной список источников и границы подтверждения этого случая.</span>
          )}
        </p>
      </section>
    ))}
  </div>

  <section class="note-box positive-comparator" id="positive-board-comparator">
    <h2>Контрпример: когда совет действительно действует</h2>
    <p>
      История The Journey и Darrin Patrick важна не как ещё один скандал, а как проверка всей
      рамки. Старейшины не отрицали даров основателя и не ограничились одним резким эпизодом.
      Они описали повторные вмешательства, привлекали пасторов-собратьев, единогласно
      отстранили лидера, организовали заботу об общине и позднее проводили встречи, где
      слушали членов. Это показывает, что сильная церковная власть и верность основателю не
      исключают реального ограничения: совет может действовать без публичной демонизации и
      без превращения всей церкви в собственность одного человека.
    </p>
    <p class="muted">
      Последующая трагическая смерть Darrin Patrick не используется для объяснения её причин,
      посмертного диагноза или отмены решения старейшин 2016 года.
    </p>
  </section>

  <h2 id="twenty-faithful-responses">Двадцать верных ответов</h2>
  <p>
    Эти ответы соотносятся с темами «20 антисоветов пастору», но их номера не образуют
    пар с номерами антисоветов. Ссылки ниже помогают сопоставить темы двух материалов:
    они не утверждают, будто каждый документальный случай доказывает соответствующий антисовет.
    Это самостоятельные практические различения, а не двадцать гарантированных противоядий.
  </p>

  <div class="case-grid faithful-response-grid">
    {responses.map((item, index) => (
      <section class="note-box faithful-response" id={`faithful-response-${String(index + 1).padStart(2, '0')}`} data-faithful-response={item.id}>
        <h3>{index + 1}. {item.title}</h3>
        <p><strong>Сложность:</strong> {item.tension}</p>
        <p><strong>Верный ответ:</strong> {item.response}</p>
        <p class="muted"><strong>Где этого недостаточно:</strong> {item.limit}</p>
        <p class="source-ref">
          <strong>Связанные темы из Части I:</strong>
          {(relatedAntiAdvice[item.id] ?? []).map((point, pointIndex) => (
            <span>{pointIndex > 0 ? ' · ' : ' '}<a href={`/articles/20-antisovetov-pastoru/#point-${point}`}>антисовет № {point}</a></span>
          ))}
        </p>
        <p class="source-ref">
          Примеры:
          {pathways.filter((pathway) => item.caseIds.includes(pathway.id)).map((pathway, index) => (
            <span>{index > 0 ? ' · ' : ' '}<a href={`#faithful-${pathway.id}`}>{pathway.name}</a></span>
          ))}
          {' · '}Писание: {item.scriptures.join('; ')}
        </p>
      </section>
    ))}
  </div>

  <section class="note-box decision-ladder" id="faithful-decision-ladder">
    <h2>Практическая лестница различения</h2>
    <p>
      Это перечень вопросов, а не обязательная последовательность действий. При непосредственной
      опасности защита пострадавших и обращение в компетентные органы не откладываются ради
      личной встречи с руководителем, сбора полного досье или завершения церковной процедуры.
      Юридические обязанности зависят от обстоятельств и применимого законодательства.
    </p>
    <ol>
      <li><strong>Есть ли непосредственный риск?</strong> Обеспечить безопасность ребёнка или уязвимого взрослого и при необходимости незамедлительно сообщить компетентным органам.</li>
      <li><strong>Что именно произошло?</strong> Отделить наблюдаемое действие от диагноза характера, не откладывая необходимую защиту.</li>
      <li><strong>Безопасен ли прямой разговор?</strong> При обычном личном конфликте — да; при принуждении, страхе или захваченной власти — не обязательно.</li>
      <li><strong>Кто ещё обладает независимым знанием?</strong> Не собирать слухи, а искать документы, очевидцев и совпадающие самостоятельные сообщения.</li>
      <li><strong>Кто реально может ограничить лидера?</strong> Проверить полномочия старейшин, попечителей, сети или деноминации.</li>
      <li><strong>Нужна ли независимая проверка?</strong> Зафиксировать её мандат, доступ к документам, отвод конфликтующих лиц и способ публикации вывода.</li>
      <li><strong>Нужно ли выйти наружу?</strong> Гражданская власть обязательна при преступлении; публичность может стать поздним шагом при сохраняющемся риске или захваченной процедуре.</li>
      <li><strong>Что изменилось после признания?</strong> Проверять не только слова, но доступ к власти, защиту уязвимых, возмещение, надзор и пригодность к должности.</li>
    </ol>
  </section>

  <section class="reading-list-section" id="faithful-witness-sources" data-new-reader-links={content.counts.newReaderLinks}>
    <h2>Документы и свидетельства: дополнительная подборка</h2>
    <p>
      Здесь приведены 33 ссылки; в основном разделе размещены ещё 40. Некоторые документы
      встречаются в обеих подборках: повторная ссылка помогает найти их в контексте истории,
      но не означает нового независимого свидетельства. Подборка включает официальные документы,
      независимые отчёты и публикации, уточняющие хронологию и позиции участников.
      Каждое сообщение используется в пределах того, что оно способно подтвердить;
      вторичная публикация сама по себе не доказывает спорного факта.
    </p>
    <ol>
      {readerSources.map((source) => (
        <li>
          <a href={source.href} rel="noopener noreferrer">{source.label}</a>
          <span class="muted" data-evidence-class={source.class}>
            {' — '}{source.class === 'B1' ? 'дополнительная публикация' : 'документальный источник'}
          </span>
        </li>
      ))}
    </ol>
  </section>

  <div class="warn-box">
    <strong>Что эта часть не разрешает.</strong>
    Она не разрешает объявлять всякого строгого пастора опасным, верить любому слуху,
    нарушать частную жизнь пострадавшего, игнорировать право ответа или использовать
    публичность как месть. Она также не разрешает совету требовать от жертвы приватной встречи
    с предполагаемым виновником, подменять полицию церковной беседой или объявлять лидера
    восстановленным только потому, что он снова собрал аудиторию.
  </div>

  <section class="note-box faithful-positive-conclusion" id="faithful-positive-conclusion" aria-labelledby="faithful-positive-heading">
    <h2 id="faithful-positive-heading">Не только против зла — за верность Христу</h2>
    <p>
      Третье послание Иоанна показывает не одного Диотрефа. В стихах 5–8 одобрено
      гостеприимство Гая к братьям, а стих 12 сообщает о добром свидетельстве
      о Димитрии. Между ними звучит призыв не подражать злу, а следовать добру
      (3 Ин. 11). Писание не сообщает всех обстоятельств жизни этих людей,
      поэтому их нельзя превращать в придуманные биографии или универсальные модели
      разрешения каждого церковного конфликта.
    </p>
    <p>
      Зрелый ответ на зло не исчерпывается разоблачением: он бережёт уязвимого,
      говорит правду с проверяемыми основаниями, не делает пастырскую власть
      неприкосновенной и не отвечает новым произволом на старый. Цель — не победа
      одной церковной стороны, а верность Христу и созидание общины, в которой
      служение проверяемо, братское гостеприимство возможно и совесть не подчинена
      человеческой непогрешимости.
    </p>
  </section>
</section>
