---
/**
 * Search metadata for the Kod Da Vinci pilot article.
 *
 * First real Astro-owned island inside <article class="article-body">.
 * It replaces the former 00-pagefind-meta.html raw fragment and keeps the
 * Pagefind public contract explicit while visible article sections remain
 * legacy fragments until one-section-at-a-time MDX activation.
 */
const meta = {
  image: '/images/og-kod-da-vinchi.webp',
  author: 'Автор-редактор: Фёдор Милованов',
  readTime: 30,
  category: 'Апологетика',
};
---
<span data-pagefind-meta="image" hidden>{meta.image}</span>
<span data-pagefind-meta="author" hidden>{meta.author}</span>
<span data-pagefind-meta="readTime" hidden>{meta.readTime}</span>
<span data-pagefind-meta="category" hidden>{meta.category}</span>
