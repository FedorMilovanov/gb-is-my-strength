---
/**
 * KodDaVinchiPostArticle — Рефакторинг 6.0 hand-authored Astro.
 *
 * gb-accuracy-block + related-articles + sdg-wrap (after </article>)
 * Promoted from former post-article fragment; preserves the legacy DOM/classes
 * byte-for-byte in rendered shape. No longer a raw-fragment shadow leaf.
 */
---

<aside class="gb-accuracy-block" aria-label="Обратная связь">
  <div class="gb-accuracy-inner">
    <h2 class="gb-accuracy-title">Нашли неточность?</h2>
    <p class="gb-accuracy-desc">
      Богословскую или техническую — напишите, исправим.
    </p>
    <div class="gb-accuracy-actions" role="list">
      <a href="mailto:viktorcoy2012@gmail.com?subject=Неточность%20в%20статье&body=Здравствуйте%2C%0A%0AЯ%20нашёл%20неточность%20в%20материале.%0A%0AОписание%3A%20"
         class="gb-accuracy-btn gb-accuracy-btn--email"
         role="listitem"
         aria-label="Написать на Email">
        <svg class="gb-accuracy-btn__icon"
             width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
          <rect x="2" y="4" width="20" height="16" rx="3"/>
          <path d="m2 7 10 7 10-7"/>
        </svg>
        <span class="gb-accuracy-btn__label">Email</span>
      </a>
      <a href="https://t.me/fedormilovanov"
         class="gb-accuracy-btn gb-accuracy-btn--tg"
         role="listitem"
         target="_blank" rel="noopener noreferrer"
         aria-label="Написать в Telegram (откроется в новой вкладке)">
        <svg class="gb-accuracy-btn__icon"
             width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
          <path d="M21.5 2.5 2.5 10l7.5 2 2 7.5 9.5-17Z"/>
          <path d="m10 12 10-9.5"/>
        </svg>
        <span class="gb-accuracy-btn__label">Telegram</span>
      </a>
    </div>
  </div>
</aside>

<section aria-label="Читайте также" class="related-articles">
<h2 class="related-articles__heading">Читайте также</h2>
<ul class="related-articles__list">
<li class="related-articles__item">
<div class="related-articles__img-wrap">
<picture>
  <source srcset="../../images/ieremia-cover.webp" type="image/webp">
  <img alt="Крайне ли испорчено моё сердце — Иеремия 17" class="related-articles__img" decoding="async" height="136" loading="lazy" src="../../images/ieremia-cover.jpg" width="400"/>
</picture>
</div>
<div class="related-articles__body">
<p class="related-articles__tag">Под редакцией · 41 мин</p>
<a class="related-articles__link" href="../../articles/krajne-li-isporcheno-serdce/">
            Крайне ли испорчено моё сердце — если я уже верующий?
          </a>
<p class="related-articles__meta">Ред.: Фёдор Милованов · Апрель 2026</p>
</div>
</li>
<li class="related-articles__item">
<div class="related-articles__img-wrap">
<img alt="Герменевтическая оценка христоцентричной герменевтики" class="related-articles__img" decoding="async" height="136" loading="lazy" src="../../images/hermenevtika-preview.webp" width="400"/>
</div>
<div class="related-articles__body">
<p class="related-articles__tag">Перевод · 50 мин</p>
<a class="related-articles__link" href="../../articles/hermenevticheskaya-otsenka-hristotsentrichnoy-germenevtiki/">
            Герменевтическая оценка христоцентричной герменевтики
          </a>
<p class="related-articles__meta">Абнер Чау · Fall 2016</p>
</div>
</li>
</ul>
</section><div class="article-end-block article-end-sdg-wrap"><div class="article-end-sdg" itemscope="" itemtype="https://schema.org/CreativeWork"><meta itemprop="about" content="Soli Deo Gloria"><span class="sdg" itemprop="name">Soli Deo Gloria</span><svg width="52" height="70" viewBox="0 0 52 70" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><line x1="26" y1="3" x2="26" y2="67" stroke="currentColor" stroke-width="5" stroke-linecap="round"></line><line x1="6" y1="19" x2="46" y2="19" stroke="currentColor" stroke-width="5" stroke-linecap="round"></line></svg></div></div>
