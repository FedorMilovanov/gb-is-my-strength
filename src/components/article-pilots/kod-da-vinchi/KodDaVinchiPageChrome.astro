---
import FloatingCluster from '@/components/ui/floating-cluster/FloatingCluster.astro';
/**
 * KodDaVinchiPageChrome — Phase 5a: body-segment-0 Astro component.
 *
 * Replaces the last raw-fragment import before <main>.
 * Contains: skip-link, reading-progress, section-label, theme-toggle,
 *           toc-sidebar, breadcrumb.
 *
 * DOM/classes/IDs are byte-identical to the legacy HTML so site.js
 * selectors and CSS rules continue to match.
 */
---
<a class="skip-link" href="#content">Перейти к содержанию</a>
<!-- ВНИМАНИЕ: inline style="top:..." на этой кнопке ЗАПРЕЩЁН — позиция задана в site.css (.theme-toggle) и выровнена по хлебным крошкам -->
<FloatingCluster mode="single" variant="article" audioState="none" />
