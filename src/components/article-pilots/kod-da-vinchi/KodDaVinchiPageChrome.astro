---
import FloatingCluster from '@/components/ui/floating-cluster/FloatingCluster.astro';
import ReaderRail from '@/components/article-pilots/_shared/ReaderRail.astro';
import ReaderSettings from '@/components/article-pilots/_shared/ReaderSettings.astro';
import HermenevtikaMobileBar from '@/components/article-pilots/hermenevtika/HermenevtikaMobileBar.astro';
import { KOD_DA_VINCHI_TOC } from './kodDaVinchiToc';
/**
 * KodDaVinchiPageChrome — хром одиночной статьи.
 *
 * Одиночная статья использует ОБЩИЙ движок одиночных статей (не серия-движок
 * Гилла): ReaderRail (десктоп-рельс с оглавлением + ⚙) + ReaderSettings
 * (самодостаточный лист тема/сепия/размер/интервал/ширина, работает и на
 * десктопе, и на мобиле). Тот же комплект у Герменевтики. С Gill-листом серий
 * НЕ связано.
 */
---
<a class="skip-link" href="#content">Перейти к содержанию</a>
<!-- Угловой кластер — ТОЛЬКО десктоп (владелец 2026-07-17: на мобиле не «старое
     меню со значками», а канонные бары движка статей, как у Герменевтики).
     Обёртка скрывает кластер <1200px точечно, не трогая другие статьи. -->
<div class="kdv-cluster-scope">
  <FloatingCluster mode="single" variant="article" audioState="none" settings={true} />
</div>
<style is:global>
  @media (max-width: 1199px) {
    .kdv-cluster-scope { display: none; }
  }

  /* This route keeps breadcrumb, main and footer inside .page-wrap. The
     structural canvas spans the client border box, while its inherited 24px
     inline padding remains the containing-block origin for the classless main.
     Expose that origin as a structural token so ReaderRail can compare the
     readable edge with the fixed rail in one coordinate system. */
  @media (min-width: 1200px) {
    .page-wrap.page-wrap--hrail {
      --hrail-canvas-inset-left: 24px;
      width: 100%;
      max-width: none;
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>
<!-- Мобильные бары движка статей (общий компонент с Герменевтикой): верх
     Back·Справка/Speed·PLAY·Save, низ прогресс·«Сейчас читаете»·тема·⚙·share,
     лист оглавления с поиском и прогрессом. -->
<HermenevtikaMobileBar
  title="«Код да Винчи»: триллер или подмена?"
  backHref="../../"
  readingMinutes={30}
  toc={KOD_DA_VINCHI_TOC}
/>
<!-- Десктоп (≥1200px): читательский рельс слева (оглавление статьи + ⚙ в нижнем
     тулбаре). settingsTrigger="hm" → рельсовая ⚙ шлёт 'hm:open-settings'. -->
<ReaderRail
  eyebrow="Разбор заблуждений"
  title="«Код да Винчи»: триллер или подмена?"
  backHref="../../"
  toc={KOD_DA_VINCHI_TOC}
  settingsTrigger="hm"
/>
<!-- Общий лист настроек одиночных статей (тот же, что у Герменевтики);
     применяется к <main data-reader-root>. -->
<ReaderSettings />
<script is:inline>
  // Угловая ⚙ (мобила) открывает тот же ReaderSettings через 'hm:open-settings'.
  (function () {
    var btn = document.getElementById('gbFcSettings');
    if (btn && !btn.dataset.readerBound) {
      btn.dataset.readerBound = '1';
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        document.dispatchEvent(new CustomEvent('hm:open-settings'));
      });
    }
  })();
</script>
