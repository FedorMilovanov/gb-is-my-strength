---
/**
 * KodDaVinchiMainShell — Phase 2: semantic split of <main>.
 *
 * Three component boundaries:
 *   1. HeaderHero — <header> + hero <figure>
 *   2. ArticleBody — <article class="article-body">
 *   3. PostArticle — gb-accuracy-block, author-card, sdg-wrap
 *
 * Each still renders verbatim legacy HTML via ?raw imports.
 * Phase 3 will activate MDX in ArticleBody.
 */
import KodDaVinchiArticleHeaderHero from './KodDaVinchiArticleHeaderHero.astro';
import KodDaVinchiArticleBody from './KodDaVinchiArticleBody.astro';
import KodDaVinchiPostArticle from './KodDaVinchiPostArticle.astro';
---
<main id="main-content">
  <KodDaVinchiArticleHeaderHero />
  <KodDaVinchiArticleBody />
  <KodDaVinchiPostArticle />
</main>
