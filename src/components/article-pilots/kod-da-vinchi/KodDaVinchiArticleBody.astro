---
/**
 * KodDaVinchiArticleBody — Phase 3a semantic article-body breakout.
 *
 * The legacy <article class="article-body" data-pagefind-body> shell now owns
 * small ordered section fragments instead of one 80K monolith. This is still
 * visual-safe legacy HTML, but the seam is ready for per-section MDX/Astro
 * activation: one section can be replaced and parity-tested independently.
 */
const sectionModules = import.meta.glob('./_legacy/article-sections/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const sections = Object.entries(sectionModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, html]) => html);
---
<article class="article-body" data-pagefind-body>
  {sections.map((html) => <Fragment set:html={html} />)}
</article>
