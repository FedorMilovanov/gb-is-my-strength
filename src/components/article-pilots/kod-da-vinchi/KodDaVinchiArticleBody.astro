---
/**
 * KodDaVinchiArticleBody — Phase 3a semantic article-body breakout.
 *
 * All content sections are hand-authored Astro components except the
 * trailing summary-card/sources/author-card block, which must be rendered
 * as raw HTML to preserve the exact legacy DOM structure.
 */
import KodDaVinchiPagefindMeta from './KodDaVinchiPagefindMeta.astro';
import KodDaVinchiSectionIntro from './KodDaVinchiSectionIntro.astro';
import KodDaVinchiSectionPhenomenon from './KodDaVinchiSectionPhenomenon.astro';
import KodDaVinchiSectionDates from './KodDaVinchiSectionDates.astro';
import KodDaVinchiSectionErrors from './KodDaVinchiSectionErrors.astro';
import KodDaVinchiSectionLie1 from './KodDaVinchiSectionLie1.astro';
import KodDaVinchiSectionFeminine from './KodDaVinchiSectionFeminine.astro';
import KodDaVinchiSectionLie2 from './KodDaVinchiSectionLie2.astro';
import KodDaVinchiSectionCanon from './KodDaVinchiSectionCanon.astro';
import KodDaVinchiSectionQumran from './KodDaVinchiSectionQumran.astro';
import KodDaVinchiSectionLie3 from './KodDaVinchiSectionLie3.astro';
import KodDaVinchiSectionLie4 from './KodDaVinchiSectionLie4.astro';
import KodDaVinchiSectionLie5 from './KodDaVinchiSectionLie5.astro';
import KodDaVinchiSectionLie6 from './KodDaVinchiSectionLie6.astro';
import KodDaVinchiSectionGnostic from './KodDaVinchiSectionGnostic.astro';
import KodDaVinchiSectionChurch from './KodDaVinchiSectionChurch.astro';
import KodDaVinchiSectionWhy from './KodDaVinchiSectionWhy.astro';
import KodDaVinchiSectionQuiz from './KodDaVinchiSectionQuiz.astro';
import KodDaVinchiSectionFaq from './KodDaVinchiSectionFaq.astro';
import KodDaVinchiSectionConclusion from './KodDaVinchiSectionConclusion.astro';
import summaryHtml from './_legacy/20-summary-title-auto.html?raw';
---
<article class="article-body" data-pagefind-body>
  <KodDaVinchiPagefindMeta />
  <KodDaVinchiSectionIntro />
  <KodDaVinchiSectionPhenomenon />
  <KodDaVinchiSectionDates />
  <KodDaVinchiSectionErrors />
  <KodDaVinchiSectionLie1 />
  <KodDaVinchiSectionFeminine />
  <KodDaVinchiSectionLie2 />
  <KodDaVinchiSectionCanon />
  <KodDaVinchiSectionQumran />
  <KodDaVinchiSectionLie3 />
  <KodDaVinchiSectionLie4 />
  <KodDaVinchiSectionLie5 />
  <KodDaVinchiSectionLie6 />
  <KodDaVinchiSectionGnostic />
  <KodDaVinchiSectionChurch />
  <KodDaVinchiSectionWhy />
  <KodDaVinchiSectionQuiz />
  <KodDaVinchiSectionFaq />
  <KodDaVinchiSectionConclusion />
  <Fragment set:html={summaryHtml} is:inline />
</article>
