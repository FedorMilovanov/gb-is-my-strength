    <div class="gbs2-sheet-tabs" role="tablist" aria-label="Навигация серии"><button type="button" class="gbs2-sheet-tab gbs2-on" data-gbs2-tab="parts">Части серии</button><button type="button" class="gbs2-sheet-tab" data-gbs2-tab="toc">Оглавление части</button></div>
