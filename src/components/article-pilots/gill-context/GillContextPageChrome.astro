---
import GillRailControls from '@/components/ui/floating-cluster/GillRailControls.astro';
import RomanNumeral from '@/components/ui/floating-cluster/RomanNumeral.astro';
---

<a class="skip-link" href="#main-content">Перейти к содержимому</a>
<div class="gbs2-mobile-head">
  <img src="../../images/og-dzhon-gill-istoricheskiy-kontekst-600w.webp" alt="" width="600" height="315">
  <div class="gbs2-mobile-title"><span>Джон Гилл (1697–1771)</span><b>I · Исторический контекст</b></div>
  <GillRailControls context="mobile" audioState="none" includeStyles={true} />
</div>
<div class="gbs2-world">
<aside class="gbs2-rail" data-fc-variant="gill" aria-label="Серия «Джон Гилл»">
  <div class="gbs2-rhead">
    <div class="gbs2-kicker"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>Серия · Биографии</div>
    <h2 class="gbs2-rtitle">Джон Гилл (1697–1771)</h2>
    <div class="gbs2-rsub">5 частей · 149 мин серии</div>
    <div class="gbs2-rprogress">
      <div class="gbs2-ring" aria-hidden="true"><svg width="44" height="44" viewBox="0 0 44 44"><circle class="t" cx="22" cy="22" r="18"></circle><circle class="f" id="gbs2Ring" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="113"></circle></svg><b id="gbs2Pct">0%</b></div>
      <div><small>Прогресс серии</small><span id="gbs2Meta">Часть 1 из 5</span></div>
    </div>
  </div>
  <div class="gbs2-rmid">
    <nav class="gbs2-parts" aria-label="Части серии">
        <a class="gbs2-part" href="./" aria-current="page">
          <span class="gbs2-thumb"><img src="../../images/og-dzhon-gill-istoricheskiy-kontekst-600w.webp" alt="" width="600" height="315" loading="lazy" decoding="async"></span>
          <span><span class="gbs2-pn">I · 16 мин</span><span class="gbs2-pt">Исторический контекст</span><span class="gbs2-ps">Англия XVIII века</span></span>
          <span class="gbs2-check" aria-hidden="true">✓</span>
        </a>
        <a class="gbs2-part" href="../dzhon-gill-chast-1-chelovek/">
          <span class="gbs2-thumb"><img src="../../images/gill-authentic-study-cover-600w.webp" alt="" width="600" height="315" loading="lazy" decoding="async"></span>
          <span><span class="gbs2-pn">II · 32 мин</span><span class="gbs2-pt">Часть I. Человек</span><span class="gbs2-ps">Кеттеринг → Лондон</span></span>
          <span class="gbs2-check" aria-hidden="true">✓</span>
        </a>
        <a class="gbs2-part" href="../dzhon-gill-chast-2-uchenyi/">
          <span class="gbs2-thumb"><img src="../../images/og-dzhon-gill-chast-2-uchenyi-600w.webp" alt="" width="600" height="315" loading="lazy" decoding="async"></span>
          <span><span class="gbs2-pn">III · 39 мин</span><span class="gbs2-pt">Часть II. Учёный</span><span class="gbs2-ps">Экзегеза и Троица</span></span>
          <span class="gbs2-check" aria-hidden="true">✓</span>
        </a>
        <a class="gbs2-part" href="../dzhon-gill-chast-3-nasledie/">
          <span class="gbs2-thumb"><img src="../../images/og-dzhon-gill-chast-3-nasledie-600w.webp" alt="" width="600" height="315" loading="lazy" decoding="async"></span>
          <span><span class="gbs2-pn">IV · 54 мин</span><span class="gbs2-pt">Часть III. Наследие</span><span class="gbs2-ps">Сперджен и кафедра</span></span>
          <span class="gbs2-check" aria-hidden="true">✓</span>
        </a>
        <a class="gbs2-part" href="../dzhon-gill-spravochnik/">
          <span class="gbs2-thumb"><img src="../../images/gill-five-volumes-shelf-600w.webp" alt="" width="600" height="315" loading="lazy" decoding="async"></span>
          <span><span class="gbs2-pn">V · 8 мин</span><span class="gbs2-pt">Справочник по Гиллу</span><span class="gbs2-ps">Карта всех трудов</span></span>
          <span class="gbs2-check" aria-hidden="true">✓</span>
        </a>
    </nav>
    <section class="gbs2-current" aria-label="Текущая часть" style="--gbs2-cover:url(../../images/og-dzhon-gill-istoricheskiy-kontekst-600w.webp)">
      <div class="gbs2-current-cover" aria-hidden="true"></div>
      <div class="gbs2-current-body"><div class="gbs2-current-label">Сейчас читаете</div><div class="gbs2-current-title">Исторический контекст</div><div class="gbs2-curbar"><i id="gbs2Curbar"></i></div></div>
      <div class="gbs2-toch"><span>Оглавление части</span><span class="gbs2-count" id="gbs2Count">1 / 10</span></div>
      <div class="gbs2-tocscroll">
        <ul class="gbs2-toc" id="gbs2Toc">
              <li><a href="#sec-from-puritans-to-baptists" class="gbs2-active"><span class="gbs2-dot" aria-hidden="true"></span>I. От пуритан к диссентерам: путь в полтора века</a></li>
              <li><a href="#sec-particular-vs-general"><span class="gbs2-dot" aria-hidden="true"></span>II. Партикулярные и генеральные баптисты: почему это важно</a></li>
              <li><a href="#sec-great-ejection"><span class="gbs2-dot" aria-hidden="true"></span>III. Тень 1662 года: Великое изгнание</a></li>
              <li><a href="#sec-clarendon"><span class="gbs2-dot" aria-hidden="true"></span>IV. Кларендонский кодекс и позднейшие религиозные тесты</a></li>
              <li><a href="#sec-academies"><span class="gbs2-dot" aria-hidden="true"></span>V. Диссентерские академии: университеты для изгнанных</a></li>
              <li><a href="#sec-salters-hall"><span class="gbs2-dot" aria-hidden="true"></span>VI. Солтерс-Холл (1719): доктринальный разлом</a></li>
              <li><a href="#sec-coffee-house"><span class="gbs2-dot" aria-hidden="true"></span>VII. Кофейная политика</a></li>
              <li><a href="#sec-southwark"><span class="gbs2-dot" aria-hidden="true"></span>VIII. Саутварк: джин, дым и Евангелие</a></li>
              <li><a href="#sec-books"><span class="gbs2-dot" aria-hidden="true"></span>IX. Кеттеринг и книжная лавка</a></li>
              <li><a href="#sec-conclusion"><span class="gbs2-dot" aria-hidden="true"></span>X. Итог: пастор изгнанников, защитник Троицы, учёный с улицы</a></li>
        </ul>
      </div>
    </section>
  </div>
  <GillRailControls context="rail" audioState="none" homeHref="../../biografii/" />
</aside>
<div class="page-wrap" id="content">
<nav aria-label="Хлебные крошки" class="breadcrumb"><ol class="breadcrumb__list"><li class="breadcrumb__item"><a class="breadcrumb__link" href="../../">Главная</a></li><li class="breadcrumb__item"><a class="breadcrumb__link" href="../../biografii/">Биографии служителей</a></li><li aria-current="page" class="breadcrumb__item"><span class="breadcrumb__current">Исторический контекст</span></li></ol></nav>
<slot />
</div>
