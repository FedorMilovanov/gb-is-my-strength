---
/**
 * GillContextArticleBody — Phase G2–G10 article-body section seams.
 *
 * The legacy article-body monolith has been split into ordered fragments while
 * this component owns the <article class="article-body"> wrapper. Promoted
 * sections stay hand-authored Astro markup in the original reading order.
 * Do not replace the whole body with MDX; promote one section at a time after
 * parity proof and Gill-specific guard updates.
 */
import GillContextSectionParticularVsGeneral from './GillContextSectionParticularVsGeneral.astro';
import GillContextSectionGreatEjection from './GillContextSectionGreatEjection.astro';
import GillContextSectionAcademies from './GillContextSectionAcademies.astro';
import GillContextSectionSaltersHall from './GillContextSectionSaltersHall.astro';
import GillContextSectionCoffeeHouse from './GillContextSectionCoffeeHouse.astro';
import GillContextSectionSouthwark from './GillContextSectionSouthwark.astro';
import GillContextSectionBooks from './GillContextSectionBooks.astro';
import GillContextSectionConclusion from './GillContextSectionConclusion.astro';

const sectionModules = import.meta.glob('./_legacy/article-sections/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const sectionEntries = Object.entries(sectionModules).sort(([a], [b]) => a.localeCompare(b));
const sectionName = (file: string) => file.split('/').pop() || file;
const sectionsBeforeParticular = sectionEntries
  .filter(([file]) => sectionName(file) < '02-sec-particular-vs-general.html')
  .map(([, html]) => html);
const sectionsBetweenParticularAndGreatEjection = sectionEntries
  .filter(([file]) => {
    const name = sectionName(file);
    return name > '02-sec-particular-vs-general.html' && name < '03-sec-great-ejection.html';
  })
  .map(([, html]) => html);
const sectionsBetweenGreatEjectionAndAcademies = sectionEntries
  .filter(([file]) => {
    const name = sectionName(file);
    return name > '03-sec-great-ejection.html' && name < '05-sec-academies.html';
  })
  .map(([, html]) => html);
const sectionsBetweenAcademiesAndSalters = sectionEntries
  .filter(([file]) => {
    const name = sectionName(file);
    return name > '05-sec-academies.html' && name < '06-sec-salters-hall.html';
  })
  .map(([, html]) => html);
const sectionsBetweenSaltersAndCoffee = sectionEntries
  .filter(([file]) => {
    const name = sectionName(file);
    return name > '06-sec-salters-hall.html' && name < '07-sec-coffee-house.html';
  })
  .map(([, html]) => html);
const sectionsBetweenCoffeeAndSouthwark = sectionEntries
  .filter(([file]) => {
    const name = sectionName(file);
    return name > '07-sec-coffee-house.html' && name < '08-sec-southwark.html';
  })
  .map(([, html]) => html);
const sectionsBetweenSouthwarkAndBooks = sectionEntries
  .filter(([file]) => {
    const name = sectionName(file);
    return name > '08-sec-southwark.html' && name < '09-sec-books.html';
  })
  .map(([, html]) => html);
const sectionsBetweenBooksAndConclusion = sectionEntries
  .filter(([file]) => {
    const name = sectionName(file);
    return name > '09-sec-books.html' && name < '10-sec-conclusion.html';
  })
  .map(([, html]) => html);
const sectionsAfterConclusion = sectionEntries
  .filter(([file]) => sectionName(file) > '10-sec-conclusion.html')
  .map(([, html]) => html);
---
<article class="article-body">{sectionsBeforeParticular.map((html) => <Fragment set:html={html} />)}<GillContextSectionParticularVsGeneral />{sectionsBetweenParticularAndGreatEjection.map((html) => <Fragment set:html={html} />)}<GillContextSectionGreatEjection />{sectionsBetweenGreatEjectionAndAcademies.map((html) => <Fragment set:html={html} />)}<GillContextSectionAcademies />{sectionsBetweenAcademiesAndSalters.map((html) => <Fragment set:html={html} />)}<GillContextSectionSaltersHall />{sectionsBetweenSaltersAndCoffee.map((html) => <Fragment set:html={html} />)}<GillContextSectionCoffeeHouse />{sectionsBetweenCoffeeAndSouthwark.map((html) => <Fragment set:html={html} />)}<GillContextSectionSouthwark />{sectionsBetweenSouthwarkAndBooks.map((html) => <Fragment set:html={html} />)}<GillContextSectionBooks />{sectionsBetweenBooksAndConclusion.map((html) => <Fragment set:html={html} />)}<GillContextSectionConclusion />{sectionsAfterConclusion.map((html) => <Fragment set:html={html} />)}</article>
