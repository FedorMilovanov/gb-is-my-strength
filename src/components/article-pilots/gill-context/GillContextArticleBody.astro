---
/**
 * GillContextArticleBody — Phase G14 complete article-body componentization.
 *
 * All Gill context body sections are now hand-authored Astro components while
 * preserving the legacy DOM/classes/copy. This is still not MDX activation:
 * changes to content must continue to go section-by-section under Gill guards.
 */
import SpeedBloom from '@/components/ui/speed-bloom/SpeedBloom.astro';
import GillContextSectionSummaryIntro from './GillContextSectionSummaryIntro.astro';
import GillContextSectionFromPuritansToBaptists from './GillContextSectionFromPuritansToBaptists.astro';
import GillContextSectionParticularVsGeneral from './GillContextSectionParticularVsGeneral.astro';
import GillContextSectionGreatEjection from './GillContextSectionGreatEjection.astro';
import GillContextSectionClarendon from './GillContextSectionClarendon.astro';
import GillContextSectionAcademies from './GillContextSectionAcademies.astro';
import GillContextSectionSaltersHall from './GillContextSectionSaltersHall.astro';
import GillContextSectionCoffeeHouse from './GillContextSectionCoffeeHouse.astro';
import GillContextSectionSouthwark from './GillContextSectionSouthwark.astro';
import GillContextSectionBooks from './GillContextSectionBooks.astro';
import GillContextSectionConclusion from './GillContextSectionConclusion.astro';
import GillContextSectionSourcesAndSeriesTail from './GillContextSectionSourcesAndSeriesTail.astro';
---
<article class="article-body" data-pagefind-body><SpeedBloom class="gb-article-listen" defs={false} /><GillContextSectionSummaryIntro /><GillContextSectionFromPuritansToBaptists /><GillContextSectionParticularVsGeneral /><GillContextSectionGreatEjection /><GillContextSectionClarendon /><GillContextSectionAcademies /><GillContextSectionSaltersHall /><GillContextSectionCoffeeHouse /><GillContextSectionSouthwark /><GillContextSectionBooks /><GillContextSectionConclusion /><GillContextSectionSourcesAndSeriesTail /></article>
