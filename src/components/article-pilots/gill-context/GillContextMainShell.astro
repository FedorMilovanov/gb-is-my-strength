---
/**
 * GillContextMainShell — Phase G1 componentized shadow-breakout.
 *
 * Keeps the public GBS2 visual world unchanged while giving the Gill context
 * page real Astro seams: HeaderHero / ArticleBody / PostArticle.
 */
import GillContextHeaderHero from './GillContextHeaderHero.astro';
import GillContextArticleBody from './GillContextArticleBody.astro';
import GillContextPostArticle from './GillContextPostArticle.astro';
---
<main id="main-content">
  <GillContextHeaderHero />
  <GillContextArticleBody />
  <GillContextPostArticle />
</main>
