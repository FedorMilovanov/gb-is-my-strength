---
import GillSeriesHero from '../gill-series/GillSeriesHero.astro';
// Strict-native parity contract: class="gbs2-hero" is rendered by GillSeriesHero.
---
<GillSeriesHero
  src="../../images/og-dzhon-gill-istoricheskiy-kontekst-600w.webp"
  srcset="../../images/og-dzhon-gill-istoricheskiy-kontekst-600w.webp 600w, ../../images/og-dzhon-gill-istoricheskiy-kontekst.webp 1200w"
  alt="Англия XVIII века — исторический мир Джона Гилла"
  caption="Серия «Джон Гилл» · Введение"
  width={1200}
  height={630}
/>
<header class="article-header gbs2-head">
  <p class="reveal section-label">Биографии служителей · Контекст</p>
  <h1>Джон Гилл: исторический контекст</h1>
  <p class="reveal article-desc">Жизнь и труд «Доктора Многотомного» на фоне правового бесправия диссентеров, доктринальных расколов и дымящегося Саутварка.</p>
  <p class="reveal article-byline"><span class="article-byline__strong">Автор-редактор: Фёдор Милованов</span><span aria-hidden="true" class="article-byline__sep">·</span><time datetime="2026-06-01">1 июня 2026</time></p>
</header>
