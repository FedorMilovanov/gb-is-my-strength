---
/**
 * HomePageFooter.astro — footer block for /.
 */
---
<footer class="h-footer" role="contentinfo">
  <span class="h-footer-copy">© 2026 Господь Бог — <span>Сила Моя</span></span>
  <span class="h-footer-separator" aria-hidden="true">•</span>
  <a href="/about/">Об авторе</a>
</footer>

<style is:global>
  body.home-page .h-footer {
    justify-content: center;
    gap: 12px 28px;
    text-align: center;
  }

  body.home-page .h-footer-separator {
    color: var(--h-gold);
    font-size: 10px;
    line-height: 1;
    opacity: .68;
  }

  @media (max-width: 760px) {
    body.home-page .h-footer-separator {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    if (!['127.0.0.1', 'localhost'].includes(location.hostname)) return;

    const check = () => {
      const footer = document.querySelector('.h-footer');
      const copy = footer?.querySelector('.h-footer-copy');
      const link = footer?.querySelector('a');
      if (!(footer instanceof HTMLElement) || !(copy instanceof HTMLElement) || !(link instanceof HTMLElement)) {
        console.error('[home-footer-contract] footer structure is incomplete');
        return;
      }

      const footerRect = footer.getBoundingClientRect();
      const copyRect = copy.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      if (innerWidth > 760) {
        const groupCenter = (Math.min(copyRect.left, linkRect.left) + Math.max(copyRect.right, linkRect.right)) / 2;
        const footerCenter = (footerRect.left + footerRect.right) / 2;
        if (Math.abs(groupCenter - footerCenter) > 2) {
          console.error(`[home-footer-contract] desktop footer group is off-centre by ${Math.abs(groupCenter - footerCenter).toFixed(2)}px`);
        }
        if (getComputedStyle(footer).justifyContent !== 'center') {
          console.error('[home-footer-contract] desktop footer reverted to edge distribution');
        }
      }

      if (footerRect.left < 17 || innerWidth - footerRect.right < 17) {
        console.error('[home-footer-contract] footer touches a viewport edge');
      }
    };

    addEventListener('resize', check, { passive: true });
    addEventListener('load', check, { once: true });
    document.fonts?.ready.then(check);
  })();
</script>
