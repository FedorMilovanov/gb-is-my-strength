---
/**
 * HomePageFooter.astro — footer block for /.
 *
 * This component owns footer markup and presentation only. Responsive geometry
 * is verified after settled layout by the canonical Home browser contract;
 * production HTML must not emit test diagnostics during raw resize events.
 */
---
<footer class="h-footer" role="contentinfo">
  <span class="h-footer-copy">© 2026 Господь Бог — <span>Сила Моя</span></span>
  <span class="h-footer-separator" aria-hidden="true">•</span>
  <a href="/about/">Об авторе</a>
</footer>

<style is:global>
  body.home-page .h-footer {
    justify-content: center;
    gap: 12px 28px;
    text-align: center;
  }

  body.home-page .h-footer-separator {
    color: var(--h-gold);
    font-size: 10px;
    line-height: 1;
    opacity: .68;
  }

  @media (max-width: 760px) {
    body.home-page .h-footer-separator {
      display: none;
    }
  }
</style>
