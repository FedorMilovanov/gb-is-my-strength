---
/**
 * HomePageChrome.astro — native body chrome + runtime shell for /.
 */
---
<a href="#main-content" class="skip-link">Перейти к содержимому</a>

<!-- site.js uses this non-visual hook to coordinate home scroll effects.
     Reading progress itself is rendered by the ring around #hScrollTop. -->
<div id="hReadingProgress" hidden aria-hidden="true" data-home-scroll-hook></div>

<nav class="h-navbar" id="hNavbar" role="navigation" aria-label="Основная навигация">
  <div class="h-navbar__inner">
    <a href="/" class="h-nav-logo" aria-label="Господь Бог — Сила Моя — на главную">
      <span class="h-nav-logo-main">Господь Бог</span>
      <span class="h-nav-logo-dash" aria-hidden="true">&nbsp;—&nbsp;</span>
      <span class="h-nav-logo-accent">Сила Моя</span>
    </a>

    <ul class="h-nav-links" role="list">
      <li><a href="#issledovat" class="h-scroll-target">Исследовать</a></li>
      <li><a href="#publikacii" class="h-scroll-target">Публикации</a></li>
      <li><a href="/nagornaya/">Серии</a></li>
      <li><a href="/biografii/">История</a></li>
      <li><a href="/karty/">Карты</a></li>
      <li><a href="/articles/">Каталог</a></li>
    </ul>

    <div class="mobile-controls">
      <button
        class="gb-nav-search-icon"
        id="gbSearchBtn"
        type="button"
        aria-label="Поиск (Ctrl+K)"
        title="Поиск Ctrl+K"
        data-search-shortcut
        data-search-shortcut-label="Поиск"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Переключить тему">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z"></path></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      </button>
      <button class="h-mobile-menu-btn" id="hMobileMenuBtn" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="hMobileNav">
        <svg class="h-burger-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line class="burger-top" x1="3" y1="6" x2="21" y2="6"></line>
          <line class="burger-mid" x1="3" y1="12" x2="21" y2="12"></line>
          <line class="burger-bottom" x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <noscript>
        <details class="h-nojs-nav">
          <summary aria-label="Открыть меню без JavaScript">
            <span class="h-nojs-nav__burger" aria-hidden="true"></span>
          </summary>
          <div class="h-nojs-nav__sheet">
            <p class="h-nojs-nav__title">Библиотека</p>
            <nav class="h-nojs-nav__links" aria-label="Навигация без JavaScript">
              <a href="/articles/">Статьи и ответы</a>
              <a href="/nagornaya/">Последовательные серии</a>
              <a href="/biografii/">Люди и история</a>
              <a href="/karty/">Карты и исследования</a>
              <a href="#razbor">Разбор заблуждений</a>
              <a href="/konfessii/">Конфессии</a>
              <a href="/izbrannoe/">Избранное</a>
              <a href="#about">О проекте</a>
            </nav>
          </div>
        </details>
      </noscript>
    </div>
  </div>
</nav>

<div class="h-mobile-nav" id="hMobileNav" role="dialog" aria-modal="true" aria-labelledby="hMobileNavTitle" aria-hidden="true">
  <div class="h-mobile-nav__head">
    <p id="hMobileNavTitle">Библиотека</p>
    <div class="h-mobile-nav__head-actions">
      <button type="button" data-action="open-search" data-close-nav>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        Найти материал
      </button>
      <button class="h-mobile-nav__close" type="button" data-close-nav aria-label="Закрыть меню">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>
    </div>
  </div>
  <div class="h-mobile-nav__primary">
    <a href="/articles/" data-close-nav><span>01</span>Статьи и ответы</a>
    <a href="/nagornaya/" data-close-nav><span>02</span>Последовательные серии</a>
    <a href="/biografii/" data-close-nav><span>03</span>Люди и история</a>
    <a href="/karty/" data-close-nav><span>04</span>Карты и исследования</a>
  </div>
  <div class="h-mobile-nav__secondary">
    <a href="#razbor" data-close-nav>Разбор заблуждений</a>
    <a href="/konfessii/" data-close-nav>Конфессии</a>
    <a href="/izbrannoe/" data-close-nav>Избранное</a>
    <a href="#about" data-close-nav>О проекте</a>
  </div>
</div>

<div id="hMobileBackdrop" class="h-mobile-backdrop" aria-hidden="true"></div>

<div class="home-v20">
  <slot />
</div><!-- /.home-v20 -->

<button class="h-scroll-top" id="hScrollTop" type="button" aria-label="Наверх">
  <svg class="h-progress-ring" width="50" height="50" viewBox="0 0 50 50" aria-hidden="true">
    <circle class="h-progress-ring-circle" id="hProgressCircle" cx="25" cy="25" r="22" style="stroke-dasharray: 138.23; stroke-dashoffset: 138.23;"></circle>
  </svg>
  <span class="h-scroll-top-arrow" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="18 15 12 9 6 15"></polyline></svg>
  </span>
</button>

<style is:global>
  body.home-page .h-mobile-nav__head-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  body.home-page .h-mobile-nav__close {
    width: 44px;
    min-width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--h-muted);
    cursor: pointer;
  }

  body.home-page .h-mobile-nav__close:is(:hover, :focus-visible) {
    background: var(--h-surface);
    color: var(--h-accent);
  }

  body.home-page .h-mobile-nav__close:focus-visible {
    outline: 2px solid var(--h-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    body.home-page .h-mobile-nav__close {
      transition: none;
    }
  }
</style>

<script is:inline>
window.SITE_CONFIG = {
  version: 1778943682,
  site: {
    id: 'gb-strength',
    name: 'Господь Бог — Сила Моя',
    baseUrl: 'https://gospod-bog.ru',
    locale: 'ru-RU',
    themeStorageKey: 'theme',
    debug: false
  },
  page: {
    type: 'home',
    id: 'home',
    title: 'Господь Бог — Сила Моя'
  },
  features: {
    themeToggle: { enabled: true },
    share: { enabled: false },
    backToTop: { enabled: true, showAfter: 500 },
    readingProgress: { enabled: true },
    toc: { enabled: false },
    footnotes: { enabled: false },
    timeline: { enabled: false },
    flipCards: { enabled: false },
    quiz: { enabled: false },
    bookmarks: { enabled: false },
    homepageResume: { enabled: true, maxItems: 5 }
  }
};
</script>
<script is:inline>
  (() => {
    const trigger = document.getElementById('hMobileMenuBtn');
    const panel = document.getElementById('hMobileNav');
    if (!trigger || !panel) return;

    const controls = () => Array.from(
      panel.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
    ).filter((control) => control.getAttribute('aria-hidden') !== 'true');
    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true' && panel.classList.contains('open');
    const desktopMedia = window.matchMedia('(min-width: 761px)');
    const desktopFocusTarget = document.querySelector('.h-nav-links a');
    const inertRoots = [
      document.querySelector('.home-v20'),
      document.getElementById('hScrollTop'),
      document.querySelector('.h-nav-logo'),
      document.querySelector('.h-nav-links'),
      document.getElementById('gbSearchBtn'),
      document.getElementById('themeToggle'),
    ].filter(Boolean);
    let wasOpen = false;

    const syncModalIsolation = (open) => {
      inertRoots.forEach((root) => root.toggleAttribute('inert', open));
    };

    const syncFocus = () => {
      const open = isOpen();
      syncModalIsolation(open);
      if (open && !wasOpen) {
        requestAnimationFrame(() => controls()[0]?.focus({ preventScroll: true }));
      } else if (!open && wasOpen && panel.contains(document.activeElement)) {
        trigger.focus({ preventScroll: true });
      }
      wasOpen = open;
    };

    const closeAtDesktopBreakpoint = () => {
      if (!desktopMedia.matches || !isOpen()) return;
      const shouldMoveFocus = panel.contains(document.activeElement) || document.activeElement === trigger;
      window.closeMobileNav?.();
      if (shouldMoveFocus) {
        requestAnimationFrame(() => desktopFocusTarget?.focus({ preventScroll: true }));
      }
    };

    new MutationObserver(syncFocus).observe(trigger, {
      attributes: true,
      attributeFilter: ['aria-expanded'],
    });

    desktopMedia.addEventListener('change', closeAtDesktopBreakpoint);
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) window.closeMobileNav?.();
      else syncFocus();
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen() || event.key !== 'Tab') return;
      const focusable = controls();
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && (active === first || !panel.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (active === last || !panel.contains(active))) {
        event.preventDefault();
        first.focus();
      }
    }, true);

    syncFocus();
  })();
</script>
<script is:inline>
  (() => {
    const platform = navigator.userAgentData?.platform || navigator.platform || navigator.userAgent || '';
    const modifier = /Mac|iPhone|iPad|iPod/i.test(platform) ? '⌘' : 'Ctrl';
    const shortcut = `${modifier}+K`;

    document.querySelectorAll('[data-search-shortcut]').forEach((control) => {
      const label = control.getAttribute('data-search-shortcut-label') || 'Поиск';
      control.setAttribute('aria-label', `${label} (${shortcut})`);
      control.setAttribute('title', `${label} ${shortcut}`);
    });
    document.querySelectorAll('[data-search-shortcut-modifier]').forEach((hint) => {
      hint.textContent = modifier;
    });
  })();
</script>
