<script is:inline>
  (() => {
    if (window.__gbSearchLazyBound) return;
    window.__gbSearchLazyBound = true;
    const src = './js/search.js?v=b0fd43b8';

    const load = (open) => {
      if (window.GBSearch?.__ready) {
        if (open) window.GBSearch.open();
        return;
      }
      if (open) window.__gbSearchOpenAfterLoad = true;
      if (window.__gbSearchLoading) return;
      window.__gbSearchLoading = true;
      window.__gbSearchBootRequested = true;
      const script = document.createElement('script');
      script.defer = true;
      script.src = src;
      script.onload = () => {
        window.__gbSearchLoading = false;
        if (open && window.GBSearch?.open) window.GBSearch.open();
      };
      script.onerror = () => {
        window.__gbSearchLoading = false;
      };
      document.head.appendChild(script);
    };

    const onShortcut = (event) => {
      if (String(event.key).toLowerCase() !== 'k' || (!event.metaKey && !event.ctrlKey)) return;
      if (event.altKey || event.shiftKey || (event.metaKey && event.ctrlKey)) {
        event.stopImmediatePropagation();
        return;
      }
      if (window.GBSearch?.__ready) return;
      event.preventDefault();
      load(true);
    };

    const onSearchClick = (event) => {
      const selector = [
        '#gbSearchBtn',
        '[data-gbs2-search]',
        '[data-fc-action="search"]',
        '.gb-nav-search-icon',
        '.gb-search-btn',
        '[data-action="open-search"]',
      ].join(',');
      const target = event.target?.closest?.(selector);
      if (!target) return;
      event.preventDefault();
      load(true);
    };

    const onCloseNavClick = (event) => {
      const target = event.target?.closest?.('[data-close-nav]');
      if (target) window.closeMobileNav?.();
    };

    document.addEventListener('keydown', onShortcut, true);
    document.addEventListener('click', onSearchClick, true);
    document.addEventListener('click', onCloseNavClick, true);
    window.addEventListener('gb:openSearch', () => load(true));
  })();
</script>
