---
/**
 * HomePageChrome.astro — native body chrome + runtime shell for /.
 */
---
<a href="#main-content" class="skip-link">Перейти к содержимому</a>

<!-- ══════════════════════════════════════════════════════
     READING PROGRESS BAR
══════════════════════════════════════════════════════ -->
<div class="h-reading-progress" id="hReadingProgress" aria-hidden="true"></div>

<!-- ══════════════════════════════════════════════════════
     SMART NAVBAR
══════════════════════════════════════════════════════ -->
<nav class="h-navbar" id="hNavbar" role="navigation" aria-label="Основная навигация">
  <div class="h-navbar__inner">
    <a href="/" class="h-nav-logo" aria-label="Господь Бог — Сила Моя — на главную">
      <span class="h-nav-logo-main">Господь Бог</span>
      <span class="h-nav-logo-dash" aria-hidden="true">&nbsp;—&nbsp;</span>
      <span class="h-nav-logo-accent">Сила Моя</span>
    </a>

    <ul class="h-nav-links" role="list">
      <li><a href="#issledovat" class="h-scroll-target">Исследовать</a></li>
      <li><a href="#publikacii" class="h-scroll-target">Публикации</a></li>
      <li><a href="/nagornaya/">Серии</a></li>
      <li><a href="/biografii/">История</a></li>
      <li><a href="/karty/">Карты</a></li>
      <li><a href="/articles/">Каталог</a></li>
    </ul>

    <div class="mobile-controls">
      {/* Static search icon: search.js used to inject #gbSearchBtn only after
          its lazy load (first interaction), so the header had no search icon
          on first paint. Rendered here up-front; search.js dedupes by id. */}
      <button class="gb-nav-search-icon" id="gbSearchBtn" type="button" aria-label="Поиск (⌘K)" title="Поиск ⌘K">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Переключить тему">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z"></path></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      </button>
      <button class="h-mobile-menu-btn" id="hMobileMenuBtn" type="button" aria-label="Открыть меню" aria-expanded="false">
        <svg class="h-burger-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line class="burger-top" x1="3" y1="6" x2="21" y2="6"></line>
          <line class="burger-mid" x1="3" y1="12" x2="21" y2="12"></line>
          <line class="burger-bottom" x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</nav>

<div class="h-mobile-nav" id="hMobileNav" aria-hidden="true">
  <div class="h-mobile-nav__head">
    <p>Библиотека</p>
    <button type="button" data-action="open-search" data-close-nav>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      Найти материал
    </button>
  </div>
  <div class="h-mobile-nav__primary">
    <a href="/articles/" data-close-nav><span>01</span>Статьи и ответы</a>
    <a href="/nagornaya/" data-close-nav><span>02</span>Последовательные серии</a>
    <a href="/biografii/" data-close-nav><span>03</span>Люди и история</a>
    <a href="/karty/" data-close-nav><span>04</span>Карты и исследования</a>
  </div>
  <div class="h-mobile-nav__secondary">
    <a href="#razbor" data-close-nav>Разбор заблуждений</a>
    <a href="/konfessii/" data-close-nav>Конфессии</a>
    <a href="/izbrannoe/" data-close-nav>Избранное</a>
    <a href="#about" data-close-nav>О проекте</a>
  </div>
</div>

<div id="hMobileBackdrop" class="h-mobile-backdrop" aria-hidden="true"></div>

<div class="home-v20">
  <div class="h-scripture-bg" aria-hidden="true" id="hScriptureBg">
    <!-- Phrases injected by JS -->
  </div>

  <slot />
</div><!-- /.home-v20 -->

<button class="h-scroll-top" id="hScrollTop" type="button" aria-label="Наверх">
  <svg class="h-progress-ring" width="50" height="50" viewBox="0 0 50 50" aria-hidden="true">
    <circle class="h-progress-ring-circle" id="hProgressCircle" cx="25" cy="25" r="22" style="stroke-dasharray: 138.23; stroke-dashoffset: 138.23;"></circle>
  </svg>
  <span class="h-scroll-top-arrow" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="18 15 12 9 6 15"></polyline></svg>
  </span>
</button>

