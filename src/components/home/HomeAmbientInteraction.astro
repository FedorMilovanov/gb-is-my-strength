---
/**
 * HomeAmbientInteraction.astro — progressive interaction owner for the
 * manuscript marginalia rendered by HomeAmbientPhrases.
 *
 * The phrase corpus remains static Astro markup. This owner upgrades every
 * visible phrase into one real keyboard/click control without duplicating the
 * phrase data or changing the safe-rail layout.
 */
---

<style is:global>
  @media (min-width: 1480px) {
    body.home-page .h-ambient-word[data-ambient-interactive="true"] {
      cursor: pointer;
      touch-action: manipulation;
    }

    body.home-page .h-ambient-word[data-ambient-interactive="true"]:focus-visible {
      outline: none;
    }

    body.home-page .h-ambient-word[data-ambient-interactive="true"]:focus-visible .h-ambient-word__text {
      color: #171411;
      filter: none;
      text-decoration: underline;
      text-decoration-color: color-mix(in srgb, var(--h-accent) 62%, transparent);
      text-decoration-thickness: 1px;
      text-underline-offset: .2em;
      transform: translateY(-3px);
    }

    html.dark body.home-page .h-ambient-word[data-ambient-interactive="true"]:focus-visible .h-ambient-word__text {
      color: #f1e5cd;
    }

    body.home-page .h-ambient-word[data-ambient-open] {
      z-index: 5;
    }

    body.home-page .h-ambient-word[data-ambient-open] .h-ambient-word__text {
      color: #171411;
      filter: none;
      transform: translateY(-3px);
      text-shadow: 0 2px 7px rgba(24, 20, 16, .13), 0 10px 28px rgba(84, 58, 20, .08);
    }

    html.dark body.home-page .h-ambient-word[data-ambient-open] .h-ambient-word__text {
      color: #f1e5cd;
      text-shadow: 0 2px 8px rgba(0, 0, 0, .45), 0 10px 30px rgba(66, 196, 213, .06);
    }

    body.home-page .h-ambient-word[data-ambient-open] .h-ambient-word__tooltip {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition-delay: .04s, 0s, .04s;
    }

    body.home-page .h-ambient-word[data-ambient-open] .h-ambient-word__source {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition-delay: .12s, 0s, .12s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body.home-page .h-ambient-word[data-ambient-interactive="true"] {
      scroll-behavior: auto;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('.h-ambient-native');
    if (!(root instanceof HTMLElement)) return;

    const words = [...root.querySelectorAll('.h-ambient-word')]
      .filter((word) => word instanceof HTMLElement);
    if (!words.length) return;

    root.removeAttribute('aria-hidden');

    const isPinned = (word) => word.hasAttribute('data-ambient-open');
    const setPinned = (word, open) => {
      const tooltip = word.querySelector('.h-ambient-word__tooltip');
      word.toggleAttribute('data-ambient-open', open);
      word.setAttribute('aria-expanded', open ? 'true' : 'false');
      tooltip?.setAttribute('aria-hidden', open ? 'false' : 'true');
    };
    const closeAll = (except = null) => {
      words.forEach((word) => {
        if (word !== except) setPinned(word, false);
      });
    };

    words.forEach((word, index) => {
      const text = word.querySelector('.h-ambient-word__text')?.textContent?.trim() || '';
      const meaning = word.querySelector('.h-ambient-word__meaning')?.textContent?.trim() || '';
      const source = word.querySelector('.h-ambient-word__source')?.textContent?.trim() || '';
      const tooltip = word.querySelector('.h-ambient-word__tooltip');
      const tooltipId = `home-ambient-meaning-${index + 1}`;

      word.dataset.ambientInteractive = 'true';
      word.setAttribute('role', 'button');
      word.setAttribute('tabindex', '-1');
      word.setAttribute('aria-expanded', 'false');
      word.setAttribute('aria-controls', tooltipId);
      word.setAttribute(
        'aria-label',
        `${text}. Перевод: ${meaning}. Источник: ${source}. Нажмите, чтобы закрепить перевод.`
      );

      if (tooltip instanceof HTMLElement) {
        tooltip.id = tooltipId;
        tooltip.setAttribute('role', 'tooltip');
        tooltip.setAttribute('aria-hidden', 'true');
      }

      word.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const next = !isPinned(word);
        closeAll(word);
        setPinned(word, next);
      });

      word.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          const next = !isPinned(word);
          closeAll(word);
          setPinned(word, next);
        } else if (event.key === 'Escape') {
          event.preventDefault();
          setPinned(word, false);
        }
      });

      word.addEventListener('blur', () => {
        if (!isPinned(word)) tooltip?.setAttribute('aria-hidden', 'true');
      });
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('.h-ambient-word')) return;
      closeAll();
    });

    let resizeTimer = 0;
    const syncVisibility = () => {
      resizeTimer = 0;
      words.forEach((word) => {
        const visible = getComputedStyle(word).display !== 'none';
        word.tabIndex = visible ? 0 : -1;
        word.toggleAttribute('aria-hidden', !visible);
        if (!visible) setPinned(word, false);
      });
    };
    const scheduleVisibility = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(syncVisibility, 80);
    };

    addEventListener('resize', scheduleVisibility, { passive: true });
    addEventListener('pageshow', scheduleVisibility);
    document.fonts?.ready.then(scheduleVisibility);
    syncVisibility();

    if (!['127.0.0.1', 'localhost'].includes(location.hostname)) return;

    const report = (message) => console.error(`[home-ambient-contract] ${message}`);
    const rectWithinViewport = (rect, tolerance = 1) => rect.left >= -tolerance && rect.right <= innerWidth + tolerance;
    const runContract = () => {
      syncVisibility();
      const visible = words.filter((word) => getComputedStyle(word).display !== 'none');
      const expected = innerWidth >= 1600 ? 32 : innerWidth >= 1480 ? 16 : 0;
      if (visible.length !== expected) {
        report(`expected ${expected} visible phrases at ${innerWidth}px, got ${visible.length}`);
      }

      const content = document.querySelector('.home-content');
      const contentRect = content instanceof HTMLElement ? content.getBoundingClientRect() : null;
      const outerFloor = Math.min(64, Math.max(48, innerWidth * .03));
      const centerGuard = Math.min(32, Math.max(22, innerWidth * .015));
      const edgeGapFor = (word, rect = word.getBoundingClientRect()) => (
        word.classList.contains('h-ambient-word--left') ? rect.left : innerWidth - rect.right
      );
      const innerGapFor = (word, rect = word.getBoundingClientRect()) => {
        if (!contentRect) return Infinity;
        return word.classList.contains('h-ambient-word--left')
          ? contentRect.left - rect.right
          : rect.left - contentRect.right;
      };

      words.forEach((word, index) => {
        const shouldBeVisible = getComputedStyle(word).display !== 'none';
        const tooltip = word.querySelector('.h-ambient-word__tooltip');
        const prefix = `phrase ${index + 1}`;

        if (word.getAttribute('role') !== 'button') report(`${prefix} lost button role`);
        if (!word.getAttribute('aria-label')?.includes('Перевод:')) report(`${prefix} lost accessible translation`);
        if (!word.getAttribute('aria-controls')) report(`${prefix} lost aria-controls`);
        if (!(tooltip instanceof HTMLElement) || tooltip.getAttribute('role') !== 'tooltip') {
          report(`${prefix} lost tooltip semantics`);
        }
        if (word.tabIndex !== (shouldBeVisible ? 0 : -1)) {
          report(`${prefix} has wrong tabIndex ${word.tabIndex}`);
        }
      });

      visible.forEach((word, index) => {
        const prefix = `visible phrase ${index + 1}`;
        const phraseRect = word.getBoundingClientRect();
        const edgeGap = edgeGapFor(word, phraseRect);
        const innerGap = innerGapFor(word, phraseRect);

        if (!rectWithinViewport(phraseRect)) report(`${prefix} leaves the viewport`);
        if (edgeGap < outerFloor - 1) {
          report(`${prefix} is only ${edgeGap.toFixed(2)}px from the viewport edge; expected at least ${outerFloor.toFixed(2)}px`);
        }
        if (innerGap < centerGuard - 1) {
          report(`${prefix} is only ${innerGap.toFixed(2)}px from the central reading surface; expected at least ${centerGuard.toFixed(2)}px`);
        }

        word.click();
        if (!isPinned(word) || word.getAttribute('aria-expanded') !== 'true') {
          report(`${prefix} did not open by click`);
        }

        const tooltip = word.querySelector('.h-ambient-word__tooltip');
        const source = word.querySelector('.h-ambient-word__source');
        if (tooltip instanceof HTMLElement && !rectWithinViewport(tooltip.getBoundingClientRect())) {
          report(`${prefix} translation leaves the viewport`);
        }
        if (source instanceof HTMLElement && !rectWithinViewport(source.getBoundingClientRect())) {
          report(`${prefix} source leaves the viewport`);
        }

        word.click();
        if (isPinned(word) || word.getAttribute('aria-expanded') !== 'false') {
          report(`${prefix} did not close by second click`);
        }

        word.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', bubbles: true }));
        if (!isPinned(word)) report(`${prefix} did not open by Enter`);
        word.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
        if (isPinned(word)) report(`${prefix} did not close by Escape`);

        word.dispatchEvent(new KeyboardEvent('keydown', { key: ' ', bubbles: true }));
        if (!isPinned(word)) report(`${prefix} did not open by Space`);
        setPinned(word, false);
      });

      if (innerWidth >= 1700) {
        for (const side of ['left', 'right']) {
          const sideGaps = visible
            .filter((word) => word.classList.contains(`h-ambient-word--${side}`))
            .map((word) => edgeGapFor(word));
          const uniqueGaps = new Set(sideGaps.map((gap) => Math.round(gap)));
          const spread = sideGaps.length ? Math.max(...sideGaps) - Math.min(...sideGaps) : 0;
          if (uniqueGaps.size < 3 || spread < 20) {
            report(`${side} marginalia lost their historical stagger (${uniqueGaps.size} positions, ${spread.toFixed(2)}px spread)`);
          }
        }

        const holy = visible.find((word) => word.querySelector('.h-ambient-word__text')?.textContent?.trim() === 'ἅγιος ἅγιος ἅγιος');
        if (holy) {
          const historicalPreference = holy.style.getPropertyValue('--ambient-edge').trim();
          if (historicalPreference !== '7.3%') {
            report(`ἅγιος historical preference drifted: ${historicalPreference || 'missing'}, expected 7.3%`);
          }
          const rootRect = root.getBoundingClientRect();
          const holyRect = holy.getBoundingClientRect();
          const actualRailInset = rootRect.right - holyRect.right;
          const resolved = Number.parseFloat(getComputedStyle(holy).right);
          if (!Number.isFinite(resolved) || Math.abs(actualRailInset - resolved) > 1) {
            report(`ἅγιος resolved edge disagrees with its rail: ${actualRailInset.toFixed(2)}px vs ${Number.isFinite(resolved) ? resolved.toFixed(2) : 'invalid'}`);
          }
        } else {
          report('ἅγιος phrase is missing from the full marginalia set');
        }
      }
    };

    let contractTimer = 0;
    const scheduleContract = () => {
      window.clearTimeout(contractTimer);
      contractTimer = window.setTimeout(() => {
        requestAnimationFrame(() => requestAnimationFrame(runContract));
      }, 120);
    };

    addEventListener('resize', scheduleContract, { passive: true });
    addEventListener('pageshow', scheduleContract);
    document.fonts?.ready.then(scheduleContract);
    addEventListener('load', scheduleContract, { once: true });
  })();
</script>