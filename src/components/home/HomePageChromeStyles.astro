---
/**
 * HomePageChromeStyles.astro — route-scoped visual owner for home navigation.
 *
 * Kept as an Astro style component so shared css/** remains untouched and the
 * native homepage chrome does not depend on section component import order.
 */
---

<style is:global>
  body.home-page .h-navbar {
    height: 70px;
  }

  body.home-page .h-navbar__inner {
    width: min(100%, 1370px);
    max-width: 1370px;
    padding-inline: clamp(20px, 4vw, 54px);
  }

  body.home-page .h-navbar.scrolled {
    background: color-mix(in srgb, var(--h-glass) 90%, transparent);
    border-color: var(--h-border);
    box-shadow: 0 18px 48px -40px rgba(25, 20, 12, .5);
  }

  html.dark body.home-page .h-navbar.scrolled {
    box-shadow: 0 20px 60px -42px rgba(0, 0, 0, .95);
  }

  body.home-page .h-nav-logo-main,
  body.home-page .h-nav-logo-dash,
  body.home-page .h-nav-logo-accent {
    font-size: 17px;
  }

  body.home-page .h-nav-logo-main,
  body.home-page .h-nav-logo-accent {
    color: var(--h-heading);
  }

  body.home-page .h-nav-logo-accent {
    color: var(--h-gold);
  }

  body.home-page .h-nav-links {
    gap: clamp(16px, 2.1vw, 28px);
  }

  body.home-page .h-nav-links a {
    color: var(--h-muted);
    font-size: 10.5px;
    font-weight: 680;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  body.home-page .h-nav-links a::after {
    background: linear-gradient(90deg, var(--h-gold), var(--h-accent));
  }

  body.home-page .h-navbar .mobile-controls > button {
    position: relative;
    inset: auto;
    width: 44px;
    min-width: 44px;
    height: 44px;
    min-height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--h-muted);
    transition: color .24s ease, transform .32s cubic-bezier(.16, 1, .3, 1);
  }

  body.home-page .h-navbar .mobile-controls > button svg,
  body.home-page .h-navbar #themeToggle .icon-moon,
  body.home-page .h-navbar #themeToggle .icon-sun {
    width: 18px;
    height: 18px;
    overflow: visible;
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  body.home-page .h-navbar .mobile-controls > button svg :is(path, circle, line, polyline) {
    stroke-width: 1.45;
    vector-effect: non-scaling-stroke;
  }

  /* The crescent has more visual mass than the magnifier at the same numeric
     stroke. Give it a slightly lighter optical weight instead of making the
     search icon artificially heavy. */
  body.home-page .h-navbar #themeToggle svg :is(path, circle, line) {
    stroke-width: 1.32;
  }

  body.home-page .h-navbar .mobile-controls > button:is(:hover, :focus-visible) {
    color: var(--h-accent);
    transform: translateY(-1px);
  }

  body.home-page .h-navbar .mobile-controls > button:focus-visible {
    outline: 1px solid var(--h-accent);
    outline-offset: 2px;
  }

  @media (min-width: 761px) {
    body.home-page .h-navbar #hMobileMenuBtn {
      display: none;
    }
  }

  /* The source component's historical 1220px breakpoint predates the current
     1120/1180px reading measure. Between 1220 and 1479px there is no physical
     side rail, so manuscript phrases visibly sit beneath cards. Keep them off
     until the curated 1480px rail contract takes ownership. */
  @media (min-width: 1220px) and (max-width: 1479.98px) {
    body.home-page .home-v20 .h-ambient-word {
      display: none;
      pointer-events: none;
    }
  }

  /* The shared search engine remains the data owner. Home only supplies a
     route-scoped visual skin and an explicit close affordance. Card planes stay
     stationary: depth comes from border, light and shadow rather than elements
     climbing across neighbouring results. */
  body.home-page .cp-backdrop {
    padding-top: calc(clamp(76px, 10vh, 104px) + env(safe-area-inset-top, 0px));
  }

  body.home-page .cp-box {
    max-width: 920px;
    border-radius: 18px;
    border-color: color-mix(in srgb, var(--h-border-strong) 72%, transparent);
    background: color-mix(in srgb, var(--h-surface-solid) 96%, var(--h-bg));
    box-shadow: 0 36px 100px -48px rgba(21, 15, 7, .46), 0 2px 8px rgba(21, 15, 7, .05), inset 0 1px rgba(255, 255, 255, .3);
  }

  html.dark body.home-page .cp-box {
    box-shadow: 0 42px 110px -44px rgba(0, 0, 0, .94), 0 2px 10px rgba(0, 0, 0, .42), inset 0 1px rgba(255, 255, 255, .035);
  }

  body.home-page .cp-input-wrap {
    gap: 13px;
    min-height: 70px;
    padding: 12px 12px 12px 21px;
  }

  body.home-page .cp-input {
    font-size: 17px;
    line-height: 1.35;
  }

  body.home-page .cp-home-close {
    width: 44px;
    min-width: 44px;
    height: 44px;
    min-height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 11px;
    background: transparent;
    color: var(--cp-ink-muted);
    cursor: pointer;
    touch-action: manipulation;
    transition: color .2s ease, background-color .2s ease, border-color .2s ease;
  }

  body.home-page .cp-home-close svg {
    width: 18px;
    height: 18px;
  }

  body.home-page .cp-home-close:is(:hover, :focus-visible) {
    border-color: color-mix(in srgb, var(--h-accent) 20%, transparent);
    background: color-mix(in srgb, var(--h-accent) 8%, transparent);
    color: var(--h-accent);
  }

  body.home-page .cp-home-close:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--h-accent) 62%, transparent);
    outline-offset: 2px;
  }

  body.home-page .cp-scope-row {
    min-height: 52px;
    padding-inline: 16px;
  }

  body.home-page .cp-scope-chip {
    min-height: 44px;
    padding-inline: 13px;
  }

  body.home-page .cp-item,
  body.home-page .cp-item:hover,
  body.home-page .cp-item.is-active {
    transform: none;
  }

  body.home-page .cp-item {
    margin-block: 3px;
    border-radius: 11px;
  }

  body.home-page .cp-item:hover {
    box-shadow: 0 10px 26px -20px rgba(20, 14, 7, .34), inset 0 1px rgba(255, 255, 255, .24);
  }

  body.home-page .cp-item.is-active {
    box-shadow: 0 12px 30px -22px rgba(20, 14, 7, .38), 0 0 0 1px color-mix(in srgb, var(--h-accent) 9%, transparent), inset 0 1px rgba(255, 255, 255, .28);
  }

  html.dark body.home-page .cp-item:hover,
  html.dark body.home-page .cp-item.is-active {
    box-shadow: 0 14px 34px -22px rgba(0, 0, 0, .9), 0 0 0 1px color-mix(in srgb, var(--h-accent) 8%, transparent), inset 0 1px rgba(255, 255, 255, .025);
  }

  body.home-page .cp-preview-col {
    min-width: 310px;
  }

  /* HomeAmbientPhrases is rendered inside the centred .home-content wrapper.
     Its absolute containing block therefore used to be that wrapper, so even
     small left/right offsets placed the manuscript words underneath the cards.
     Expand only the ambient layer back to the viewport while retaining the
     document-height coordinate system supplied by .home-content. */
  body.home-page .home-v20 .h-ambient-native {
    right: auto;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
  }

  /* The directions block used to break out almost to the viewport edge while
     the manuscript phrases remained in those same rails. Keep every wide Home
     section on the native content measure so marginalia never sit under cards.
     Explicit border-box sizing makes the declared 1120/1180px measures include
     their generous inner padding instead of silently consuming both rails. */
  @media (min-width: 1480px) {
    body.home-page .home-v20 .home-content {
      box-sizing: border-box;
    }

    body.home-page .home-v20 #main-content #issledovat {
      width: 100%;
      max-width: none;
      margin-left: 0;
    }
  }

  /* Rail sizes are based on the narrowest physical free field, not just the
     nominal content max-width. They still leave a visible safety gap while
     giving the frameless translations enough measure to read as typography
     rather than a stack of single-word fragments. */
  @media (min-width: 1480px) and (max-width: 1599.98px) and (hover: hover) and (pointer: fine) {
    body.home-page .home-v20 .h-ambient-native .h-ambient-word {
      width: 120px;
      max-width: 120px;
    }

    body.home-page .home-v20 .h-ambient-native .h-ambient-word--left { left: 20px; }
    body.home-page .home-v20 .h-ambient-native .h-ambient-word--right { right: 20px; }
  }

  @media (min-width: 1600px) and (max-width: 1699.98px) and (hover: hover) and (pointer: fine) {
    body.home-page .home-v20 .h-ambient-native .h-ambient-word {
      width: 150px;
      max-width: 150px;
    }

    body.home-page .home-v20 .h-ambient-native .h-ambient-word--left { left: 20px; }
    body.home-page .home-v20 .h-ambient-native .h-ambient-word--right { right: 20px; }
  }

  @media (min-width: 1700px) and (hover: hover) and (pointer: fine) {
    body.home-page .home-v20 .h-ambient-native .h-ambient-word {
      width: 200px;
      max-width: 200px;
    }

    body.home-page .home-v20 .h-ambient-native .h-ambient-word--left { left: 24px; }
    body.home-page .home-v20 .h-ambient-native .h-ambient-word--right { right: 24px; }
  }

  /* The project statement, mirrored quotation and roadmap are consecutive
     terminal scenes. Use whitespace and soft surfaces to separate them instead
     of stacking section borders, ornamental rules and item dividers. */
  body.home-page .h-quote-section .h-ornament,
  body.home-page .h-planned-line {
    display: none;
  }

  body.home-page .h-quote-section {
    padding-top: clamp(34px, 4.5vw, 62px);
    padding-bottom: clamp(48px, 5.8vw, 78px);
  }

  body.home-page .h-planned-header {
    gap: 9px;
    margin-bottom: 18px;
    padding-inline: 2px;
  }

  body.home-page .h-home-roadmap__items {
    gap: 14px;
  }

  body.home-page .h-home-roadmap__item {
    padding: 18px 20px;
    border-top: 0;
    border-radius: 14px;
    background: color-mix(in srgb, var(--h-surface) 68%, transparent);
    box-shadow: inset 0 1px rgba(255, 255, 255, .24), 0 14px 34px -32px rgba(42, 28, 10, .38);
  }

  html.dark body.home-page .h-home-roadmap__item {
    background: color-mix(in srgb, var(--h-surface-solid) 82%, transparent);
    box-shadow: inset 0 1px rgba(255, 255, 255, .035), 0 16px 38px -32px rgba(0, 0, 0, .9);
  }

  @media (max-width: 760px) {
    body.home-page .h-navbar {
      height: calc(62px + env(safe-area-inset-top, 0px));
    }

    body.home-page .h-mobile-nav {
      top: calc(62px + env(safe-area-inset-top, 0px));
      max-height: calc(100dvh - 62px - env(safe-area-inset-top, 0px));
      background: color-mix(in srgb, var(--h-surface-solid) 94%, transparent);
    }

    body.home-page .cp-backdrop {
      align-items: flex-start;
      padding: calc(8px + env(safe-area-inset-top, 0px)) calc(8px + env(safe-area-inset-right, 0px)) calc(8px + env(safe-area-inset-bottom, 0px)) calc(8px + env(safe-area-inset-left, 0px));
    }

    body.home-page .cp-box {
      width: 100%;
      max-width: none;
      max-height: calc(100dvh - 16px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));
      border-radius: 16px;
    }

    body.home-page .cp-input-wrap {
      min-height: 62px;
      gap: 10px;
      padding: 8px 8px 8px 15px;
    }

    body.home-page .cp-input {
      font-size: 16px;
    }

    body.home-page .cp-scope-row {
      min-height: 50px;
      overflow: hidden;
      padding-inline: 10px;
    }

    body.home-page .cp-scope-chips {
      min-width: 0;
      flex: 1 1 auto;
      overflow-x: auto;
      padding-block: 1px;
      scrollbar-width: none;
    }

    body.home-page .cp-scope-chips::-webkit-scrollbar {
      display: none;
    }

    /* Counts are already repeated in every result-group heading. Keep the live
       region available to assistive technology without allowing it to consume
       the last mobile pixels and clip the Authors scope. */
    body.home-page .cp-status {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    body.home-page .cp-scope-chip {
      min-height: 40px;
      gap: 5px;
      padding-inline: 10px;
      font-size: 9.5px;
    }

    body.home-page .cp-list {
      min-height: 0;
    }

    body.home-page .cp-preview-col {
      display: none;
    }

    body.home-page .cp-footer {
      min-height: 44px;
      padding-inline: 12px;
    }

    /* The button border is part of the visible circle, while an absolutely
       positioned SVG sized to 100% resolves against the inner box. Expand it by
       that one-pixel border on every side so the progress arc is a true,
       concentric circle instead of a smaller offset oval. */
    body.home-page .h-scroll-top svg.h-progress-ring {
      inset: -1px;
      width: calc(100% + 2px);
      height: calc(100% + 2px);
    }

    body.home-page .h-home-roadmap {
      padding-top: 36px;
    }

    body.home-page .h-planned-header {
      margin-bottom: 14px;
    }

    body.home-page .h-home-roadmap__items {
      gap: 10px;
    }

    body.home-page .h-home-roadmap__item {
      padding: 16px;
    }
  }

  @media (max-width: 390px) {
    body.home-page .h-navbar .mobile-controls {
      gap: 0;
    }

    body.home-page .h-nav-logo-main,
    body.home-page .h-nav-logo-dash,
    body.home-page .h-nav-logo-accent {
      font-size: 12.5px;
    }

    body.home-page .cp-footer .cp-hint:not(.cp-hint-right) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body.home-page .h-navbar .mobile-controls > button,
    body.home-page .cp-home-close {
      transition: none;
    }
  }
</style>
