---
/**
 * HomeResponsiveContracts.astro — route-local viewport and motion contracts for /.
 *
 * Leaf components continue to own their normal presentation. This component owns
 * only cross-section edge states that depend on the complete homepage geometry:
 * safe desktop marginalia rails, mobile title semantics, an odd final gateway
 * card, terminal spacing, and reduced motion.
 */
---

<style is:global>
  /* Marginalia are decoration, never layout content. The leaf component keeps
     them hidden by default; this route-level owner decides when the viewport
     has a real outer rail. The former 1220–1479px window had no rail contract
     and could place names of God under/against the central reading surface. */
  @media (min-width: 1220px) and (max-width: 1479.98px) {
    body.home-page .home-v20 .h-ambient-word {
      display: none;
      pointer-events: none;
    }
  }

  /* At the first safe desktop width we deliberately show only half of the
     marginalia, at a reduced scale. Below this breakpoint they disappear
     before they can compete with the central reading surface. */
  @media (min-width: 1480px) and (max-width: 1599.98px) and (hover: hover) and (pointer: fine) {
    body.home-page .home-v20 .home-content {
      max-width: 1120px;
    }

    body.home-page .home-v20 .h-ambient-word {
      display: none;
      font-size: calc(var(--ambient-size) * .82);
    }

    body.home-page .home-v20 .h-ambient-word:nth-child(odd) {
      display: block;
      pointer-events: auto;
    }
  }

  /* Full marginalia return once both rails are genuinely wide enough, but stay
     slightly reduced until 1800px. This keeps the transition from curated to
     full density soft rather than suddenly crowding the page. */
  @media (min-width: 1600px) and (hover: hover) and (pointer: fine) {
    body.home-page .home-v20 .home-content {
      max-width: 1180px;
    }

    body.home-page .home-v20 .h-ambient-word {
      display: block;
      font-size: calc(var(--ambient-size) * .9);
      pointer-events: auto;
    }
  }

  @media (min-width: 1800px) and (hover: hover) and (pointer: fine) {
    body.home-page .home-v20 .h-ambient-word {
      font-size: var(--ambient-size);
    }
  }

  /* This route contract is the single geometry owner for manuscript marginalia.
     HomeAmbientPhrases supplies the historical per-phrase preferred inset only;
     the current viewport decides whether that preference physically fits.

     The ambient layer is rendered inside the centred .home-content wrapper, so
     expand only this decorative layer back to the viewport while retaining the
     page-height coordinate system of its parent. */
  @media (min-width: 1480px) and (hover: hover) and (pointer: fine) {
    body.home-page .home-v20 .h-ambient-native {
      right: auto;
      left: 50%;
      width: 100vw;
      transform: translateX(-50%);
    }

    body.home-page .home-v20 .h-ambient-word {
      --ambient-content-width: 1120px;
      --ambient-rail-width: calc((100vw - var(--ambient-content-width)) / 2);
      --ambient-outer-floor: clamp(48px, 3vw, 64px);
      --ambient-center-guard: clamp(22px, 1.5vw, 32px);
      --ambient-min-width: 72px;
      --ambient-preferred-edge: min(var(--ambient-edge), 240px);
      --ambient-edge-ceiling: calc(var(--ambient-rail-width) - var(--ambient-center-guard) - var(--ambient-min-width));
      --ambient-resolved-edge: clamp(var(--ambient-outer-floor), var(--ambient-preferred-edge), var(--ambient-edge-ceiling));
      width: min(210px, max(var(--ambient-min-width), calc(var(--ambient-rail-width) - var(--ambient-resolved-edge) - var(--ambient-center-guard))));
      max-width: 210px;
      box-sizing: border-box;
      white-space: normal;
      overflow-wrap: normal;
      word-break: normal;
      cursor: help;
    }

    body.home-page .home-v20 .h-ambient-word--left {
      left: var(--ambient-resolved-edge);
      text-align: left;
    }

    body.home-page .home-v20 .h-ambient-word--right {
      right: var(--ambient-resolved-edge);
      text-align: right;
    }

    body.home-page .home-v20 .h-ambient-word__text {
      color: rgba(24, 31, 32, .16);
      filter: blur(.12px);
      text-shadow: 0 8px 24px rgba(89, 61, 24, .035);
    }

    html.dark body.home-page .home-v20 .h-ambient-word__text {
      color: rgba(235, 225, 206, .16);
    }

    /* Translation floats above the word, source settles below — both
       frameless, ink-on-paper, surfacing only on hover/focus. */
    body.home-page .home-v20 .h-ambient-word__tooltip {
      bottom: calc(100% + .34em);
      left: 0;
      width: 100%;
      min-width: 0;
      max-width: none;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      color: #171411;
      opacity: 0;
      visibility: hidden;
      transform: translateY(7px);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    body.home-page .home-v20 .h-ambient-word--right .h-ambient-word__tooltip {
      left: auto;
      right: 0;
    }

    html.dark body.home-page .home-v20 .h-ambient-word__tooltip {
      color: #f1e5cd;
    }

    body.home-page .home-v20 .h-ambient-word__meaning {
      display: block;
      color: inherit;
      font-family: var(--f-body);
      font-size: clamp(12px, .82vw, 14px);
      font-style: normal;
      font-weight: 650;
      line-height: 1.18;
      text-shadow: 0 1px 5px rgba(24, 20, 16, .08);
    }

    body.home-page .home-v20 .h-ambient-word__source {
      top: calc(100% + .28em);
      left: 0;
      width: 100%;
      max-width: none;
      margin-top: 0;
      color: color-mix(in srgb, var(--h-accent) 82%, #1d5d70 18%);
      font-size: 7px;
      font-weight: 740;
      letter-spacing: .1em;
      text-shadow: 0 1px 8px color-mix(in srgb, var(--h-accent) 10%, transparent);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-5px);
    }

    html.dark body.home-page .home-v20 .h-ambient-word__source {
      color: color-mix(in srgb, var(--h-accent) 88%, #d8f6f8 12%);
    }

    body.home-page .home-v20 .h-ambient-word--right .h-ambient-word__source {
      left: auto;
      right: 0;
    }

    body.home-page .home-v20 .h-ambient-word:is(:hover, :focus-within) {
      z-index: 4;
    }

    body.home-page .home-v20 .h-ambient-word:is(:hover, :focus-within) .h-ambient-word__text {
      color: #171411;
      filter: none;
      transform: translateY(-3px);
      text-shadow: 0 2px 7px rgba(24, 20, 16, .13), 0 10px 28px rgba(84, 58, 20, .08);
    }

    html.dark body.home-page .home-v20 .h-ambient-word:is(:hover, :focus-within) .h-ambient-word__text {
      color: #f1e5cd;
      text-shadow: 0 2px 8px rgba(0, 0, 0, .45), 0 10px 30px rgba(66, 196, 213, .06);
    }

    body.home-page .home-v20 .h-ambient-word:is(:hover, :focus-within) .h-ambient-word__tooltip {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition-delay: .04s, 0s, .04s;
    }

    body.home-page .home-v20 .h-ambient-word:is(:hover, :focus-within) .h-ambient-word__source {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition-delay: .12s, 0s, .12s;
    }
  }

  @media (min-width: 1600px) and (hover: hover) and (pointer: fine) {
    body.home-page .home-v20 .h-ambient-word {
      --ambient-content-width: 1180px;
    }
  }

  /* The gateway card selection (полноширинное выделение) is owned entirely by
     Directions.astro: its ::before surface, full-height side-glow box-shadows
     and ::after edge tint render the active card edge-to-edge without any 1px
     frame. Keyboard focus keeps a 2px ring via Directions' :focus-visible
     rule, so no hover frame is needed here. */

  /* Paired editorial cards used to rotate toward the pointer and physically
     cross over their neighbour. The card plane stays flat and non-overlapping
     at rest (so the visual-parity contract still reads transform:none), while
     the premium 3D pointer tilt already authored in css/home.css is restored
     on hover for fine-pointer, tilt-ready surfaces. Keyboard focus keeps the
     border/shadow highlight without any 3D motion. */
  body.home-page .home-v20 #main-content .h-featured-series {
    --home-tilt-x: 0deg;
    --home-tilt-y: 0deg;
    --home-tilt-lift: 0px;
    --home-tilt-gloss: 0;
    transform: none;
    transform-style: flat;
    transition: transform .22s cubic-bezier(.22, 1, .36, 1), border-color .32s ease, box-shadow .32s ease;
  }

  /* Soft warm-cyan sheen over the featured cards (replaces the harsh white
     tilt-gloss authored in css/home.css). A gentle gold→cyan iridescence tied
     to --home-tilt-gloss reads as a premium perlevescent sweep instead of a
     bright white glare. */
  body.home-page .home-v20 #main-content .h-featured-series::before {
    opacity: var(--home-tilt-gloss, 0);
    background: linear-gradient(
      115deg,
      transparent 30%,
      color-mix(in srgb, var(--h-gold) 14%, transparent) 46%,
      color-mix(in srgb, var(--h-accent) 16%, transparent) 52%,
      color-mix(in srgb, var(--h-gold) 11%, transparent) 60%,
      transparent 72%
    );
  }

  html.dark body.home-page .home-v20 #main-content .h-featured-series::before {
    background: linear-gradient(
      115deg,
      transparent 30%,
      color-mix(in srgb, var(--h-gold) 16%, transparent) 46%,
      color-mix(in srgb, var(--h-accent) 18%, transparent) 52%,
      color-mix(in srgb, var(--h-gold) 12%, transparent) 60%,
      transparent 72%
    );
  }

  body.home-page .home-v20 #main-content .h-featured-series:is(:hover, :focus-visible) {
    border-color: color-mix(in srgb, var(--h-accent) 28%, var(--h-border-strong));
    box-shadow: 0 30px 78px -54px rgba(3, 35, 48, .72), 0 0 0 1px color-mix(in srgb, var(--h-accent) 10%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    body.home-page .home-v20 #main-content .h-featured-series.is-home-tilt-ready:hover {
      --home-tilt-lift: -2px;
      --home-tilt-gloss: 1;
      transform: perspective(1100px) rotateX(var(--home-tilt-x, 0deg)) rotateY(var(--home-tilt-y, 0deg)) translate3d(0, var(--home-tilt-lift, 0px), 0);
    }
  }

  /* Publication cards are independent surfaces. Real grid gaps and a stationary
     hover state prevent one card from climbing above the adjacent card. */
  @media (min-width: 761px) {
    body.home-page .home-v20 #main-content #publikacii .h-articles-group > .h-article-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    body.home-page .home-v20 #main-content #publikacii .h-articles-group > .h-article-list > li {
      min-width: 0;
    }

    body.home-page .home-v20 #main-content #publikacii .h-articles-group > .h-article-list .h-article-card {
      height: 100%;
      margin: 0;
      padding: 16px;
      border: 1px solid var(--h-border);
      border-radius: 16px;
      background: var(--h-surface);
      transform: none;
      isolation: isolate;
      transition: border-color .28s ease, background-color .28s ease, box-shadow .32s ease;
    }

    body.home-page .home-v20 #main-content #publikacii .h-articles-group > .h-article-list li:first-child .h-article-card {
      padding-top: 16px;
    }

    body.home-page .home-v20 #main-content #publikacii .h-articles-group > .h-article-list li:last-child .h-article-card {
      border-bottom: 1px solid var(--h-border);
    }

    body.home-page .home-v20 #main-content #publikacii .h-articles-group > .h-article-list .h-article-card:is(:hover, :focus-visible) {
      z-index: 1;
      transform: none;
      border-color: var(--h-border-strong);
      background: var(--h-surface-solid);
      box-shadow: 0 20px 48px -38px rgba(40, 28, 14, .34), inset 0 1px rgba(255, 255, 255, .36);
    }
  }


  /* Five routes end with one centred card. Give the intentional singleton enough
     measure for its longest label and description. A future sixth route removes
     the odd-item rule automatically and completes a normal two-card row. */
  @media (max-width: 760px) {
    body.home-page #main-content .h-home-route:last-child {
      width: auto;
      min-height: 166px;
      grid-column: auto;
      grid-template-columns: 72px minmax(0, 1fr);
      justify-self: stretch;
    }

    body.home-page #main-content .h-home-route:last-child .h-home-route__glyph {
      width: 72px;
      height: 72px;
      min-height: 72px;
    }

    body.home-page #main-content .h-home-route:last-child:nth-child(odd) {
      width: min(236px, calc(100% - 32px));
      grid-column: 1 / -1;
      justify-self: center;
    }
  }

  @media (max-width: 340px) {
    body.home-page #main-content .h-home-route:last-child {
      min-height: 144px;
      grid-template-columns: 58px minmax(0, 1fr);
    }

    body.home-page #main-content .h-home-route:last-child .h-home-route__glyph {
      width: 58px;
      height: 58px;
      min-height: 58px;
    }

    body.home-page #main-content .h-home-route:last-child:nth-child(odd) {
      width: min(212px, calc(100% - 24px));
    }
  }

  /* Terminal signature and footer share the same centred measure. The SDG mark
     now finishes the page content before the footer instead of hanging below it
     against the viewport edge. */
  body.home-page .article-end-sdg-wrap {
    margin: 0;
    padding: clamp(52px, 6vw, 78px) 20px clamp(42px, 5vw, 62px);
  }

  body.home-page .article-end-sdg {
    gap: 12px;
  }

  body.home-page .article-end-sdg svg {
    width: 44px;
    height: 60px;
  }

  body.home-page .h-footer {
    width: min(calc(100% - 40px), 1180px);
    margin: 0 auto;
    padding: 28px 0 34px;
  }

  /* The progress ring has a 50×50 viewBox. Explicitly scale it to its button so
     it cannot render as an offset oval when the mobile control is reduced. */
  body.home-page .h-scroll-top .h-progress-ring {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 760px) {
    body.home-page .h-scroll-top {
      right: max(18px, env(safe-area-inset-right, 0px));
      bottom: max(22px, calc(env(safe-area-inset-bottom, 0px) + 14px));
      width: 46px;
      height: 46px;
    }

    body.home-page .h-scroll-top-arrow {
      width: 100%;
      height: 100%;
      align-items: center;
      justify-content: center;
    }

    body.home-page .h-quote-section {
      padding-inline: 0;
    }

    body.home-page .h-quote-section .h-ornament {
      display: none;
    }

    body.home-page .h-quote-mirror {
      gap: 28px;
      padding-inline: 18px;
    }

    body.home-page .h-quote-left {
      padding-top: 0;
      padding-inline: 6px;
      border-top: 0;
    }

    body.home-page .h-blockquote--mirror {
      padding-inline: 4px;
      margin-bottom: 14px;
    }

    body.home-page .h-cite--mirror {
      padding-inline: 4px;
      line-height: 1.5;
    }

    body.home-page .h-footer {
      width: calc(100% - 36px);
      justify-content: center;
      gap: 10px 20px;
      padding: 24px 0 max(30px, env(safe-area-inset-bottom, 0px));
      text-align: center;
    }

    body.home-page .h-footer-copy,
    body.home-page .h-footer a {
      flex: 0 1 auto;
    }

    body.home-page .article-end-sdg-wrap {
      padding: 30px 18px 22px;
    }
  }

  /* site.js may initialise the pointer tilt on a fine pointer. Reduced-motion
     wins at the route boundary even when that pointer capability is present. */
  @media (prefers-reduced-motion: reduce) {
    body.home-page :is(
      .is-home-tilt-ready,
      .h-featured-series,
      .resume-reading-card,
      .resume-list-item,
      .favorites-card
    ) {
      --home-tilt-x: 0deg !important;
      --home-tilt-y: 0deg !important;
      --home-tilt-lift: 0px !important;
      --home-tilt-gloss: 0 !important;
      transform: none !important;
      transition: none !important;
    }

    body.home-page :is(
      .h-featured-series,
      .resume-reading-card,
      .resume-list-item,
      .favorites-card
    ) :is(img, picture, .favorites-card__img) {
      transform: none !important;
      transition: none !important;
    }
  }
</style>