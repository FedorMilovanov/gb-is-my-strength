---
/**
 * HomeResponsiveContracts.astro — route-local viewport and motion contracts for /.
 *
 * Leaf components continue to own their normal presentation. This component owns
 * only cross-section edge states that depend on the complete homepage geometry:
 * safe desktop marginalia rails, mobile title semantics, an odd final gateway
 * card, and reduced motion.
 */
---

<style is:global>
  /* The page needs a real outer rail before marginalia can become interactive.
     Between the old 1220px threshold and 1600px the words could sit beneath the
     central library surface, leaving part of a phrase impossible to target. */
  @media (min-width: 1220px) and (max-width: 1599.98px) and (hover: hover) and (pointer: fine) {
    body.home-page .h-ambient-word {
      display: none;
      pointer-events: none;
    }
  }

  @media (min-width: 1600px) and (hover: hover) and (pointer: fine) {
    body.home-page .h-ambient-word {
      --ambient-safe-width: calc((100vw - 1280px) / 2 - var(--ambient-edge) - 16px);
      width: min(260px, max(72px, var(--ambient-safe-width)));
      max-width: none;
      box-sizing: border-box;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    body.home-page .h-ambient-word--left {
      text-align: left;
    }

    body.home-page .h-ambient-word--right {
      text-align: right;
    }

    body.home-page .h-ambient-word__tooltip {
      width: 100%;
      min-width: 0;
      max-width: none;
      box-sizing: border-box;
    }
  }

  /* Keep the authored dash in the rendered H1 on mobile. The previous visual
     replacement used generated content, which looked correct but disappeared
     from innerText and blocked the immutable production release smoke. The
     100%-wide inline first span creates the visual line break without inserting
     a semantic newline into the heading text. */
  @media (max-width: 760px) {
    body.home-page #main-content .h-hero .h-hero-title .h-title-static {
      display: inline-block;
      width: 100%;
    }

    body.home-page #main-content .h-hero .h-hero-title .h-title-dash,
    body.home-page #main-content .h-hero .h-hero-title .h-title-accent {
      display: inline-block;
      margin-top: .08em;
    }

    body.home-page #main-content .h-hero .h-hero-title .h-title-dash {
      margin-right: .2em;
      opacity: .76;
      transform: translateY(-.04em);
    }

    body.home-page #main-content .h-hero .h-hero-title .h-title-accent::before {
      content: none;
    }
  }

  /* Five routes end with one centred card. A future sixth route automatically
     removes the odd-item rule and completes a normal two-card row. */
  @media (max-width: 760px) {
    body.home-page #main-content .h-home-route:last-child {
      width: auto;
      min-height: 166px;
      grid-column: auto;
      grid-template-columns: 72px minmax(0, 1fr);
      justify-self: stretch;
    }

    body.home-page #main-content .h-home-route:last-child .h-home-route__glyph {
      width: 72px;
      height: 72px;
      min-height: 72px;
    }

    body.home-page #main-content .h-home-route:last-child:nth-child(odd) {
      width: calc((100% - 10px) / 2);
      grid-column: 1 / -1;
      justify-self: center;
    }
  }

  @media (max-width: 340px) {
    body.home-page #main-content .h-home-route:last-child {
      min-height: 144px;
      grid-template-columns: 58px minmax(0, 1fr);
    }

    body.home-page #main-content .h-home-route:last-child .h-home-route__glyph {
      width: 58px;
      height: 58px;
      min-height: 58px;
    }

    body.home-page #main-content .h-home-route:last-child:nth-child(odd) {
      width: calc((100% - 8px) / 2);
    }
  }

  /* site.js may initialise the pointer tilt on a fine pointer. Reduced-motion
     wins at the route boundary even when that pointer capability is present. */
  @media (prefers-reduced-motion: reduce) {
    body.home-page :is(
      .is-home-tilt-ready,
      .h-featured-series,
      .resume-reading-card,
      .resume-list-item,
      .favorites-card
    ) {
      --home-tilt-x: 0deg !important;
      --home-tilt-y: 0deg !important;
      --home-tilt-lift: 0px !important;
      --home-tilt-gloss: 0 !important;
      transform: none !important;
      transition: none !important;
    }

    body.home-page :is(
      .h-featured-series,
      .resume-reading-card,
      .resume-list-item,
      .favorites-card
    ) :is(img, picture, .favorites-card__img) {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
