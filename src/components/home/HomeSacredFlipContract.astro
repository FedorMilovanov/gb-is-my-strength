---
/**
 * HomeSacredFlipContract.astro — final late owner for the interactive
 * Habakkuk word swap on the native Home route.
 *
 * The component deliberately overrides the legacy route cascade after
 * HomeHero/HomeVisualAuditFixes. It owns only front/back visibility, revealed
 * translation colour and the sacred-name label position. Click/tap toggling
 * remains owned by the existing enhancements runtime.
 */
---

<style is:global>
  body.home-page #main-content .h-sacred-block--hero :is(.hb-back, .h-tetra-name) {
    color: var(--h-ink) !important;
    background: none !important;
    -webkit-text-fill-color: currentColor !important;
    filter: none !important;
  }

  body.home-page #main-content .h-sacred-block--hero .hb-back {
    text-shadow: 0 1px 8px rgba(28, 25, 23, .1);
  }

  body.home-page #main-content .h-sacred-block--hero .h-tetra-name {
    text-shadow: 0 2px 8px rgba(28, 25, 23, .15), 0 4px 30px rgba(28, 25, 23, .08);
  }

  html.dark body.home-page #main-content .h-sacred-block--hero .h-tetra-name {
    text-shadow: 0 2px 6px rgba(0, 0, 0, .34), 0 4px 28px rgba(245, 237, 224, .08);
  }

  body.home-page #main-content .h-sacred-block--hero :is(.hb-w, .h-tetra) > .hb-front,
  body.home-page #main-content .h-sacred-block--hero :is(.hb-back, .h-tetra-back) {
    backface-visibility: hidden;
  }

  /* Fail closed before interaction: the Hebrew face is the only visible face. */
  body.home-page #main-content .h-sacred-block--hero :is(.hb-w, .h-tetra) > .hb-front {
    visibility: visible !important;
  }

  body.home-page #main-content .h-sacred-block--hero :is(.hb-back, .h-tetra-back) {
    visibility: hidden !important;
    opacity: 0 !important;
  }

  body.home-page #main-content .h-sacred-block--hero .h-tetra-label {
    opacity: 0 !important;
    visibility: hidden !important;
    filter: blur(5px) !important;
    transform: translate(-50%, -100%) translateY(22px) !important;
  }

  /*
   * The active state is intentionally not wrapped in a hover/pointer media
   * query. Desktop browsers and hybrid Windows devices have reported an
   * incorrect primary-pointer capability while still dispatching a physical
   * mouse hover. :hover plus the pointer-preview attribute keeps the visual
   * contract deterministic without changing touch click ownership.
   */
  body.home-page #main-content .h-sacred-block--hero
    :is(.hb-w, .h-tetra):is(:hover, :focus-visible, [data-pointer-preview], [data-toggled]) > .hb-front {
    visibility: hidden !important;
    opacity: 0 !important;
    transform: rotate(-8deg) scale(.85) !important;
    pointer-events: none;
  }

  body.home-page #main-content .h-sacred-block--hero
    .hb-w:is(:hover, :focus-visible, [data-pointer-preview], [data-toggled]) > .hb-back,
  body.home-page #main-content .h-sacred-block--hero
    .h-tetra:is(:hover, :focus-visible, [data-pointer-preview], [data-toggled]) > .h-tetra-back {
    visibility: visible !important;
    opacity: 1 !important;
    transform: rotate(0) scale(1) !important;
  }

  body.home-page #main-content .h-sacred-block--hero
    .h-tetra:is(:hover, :focus-visible, [data-pointer-preview], [data-toggled]) > .h-tetra-label {
    opacity: 1 !important;
    visibility: visible !important;
    filter: blur(0) !important;
    transform: translate(-50%, -100%) translateY(22px) !important;
    letter-spacing: .28em !important;
  }

  @media (prefers-reduced-motion: reduce) {
    body.home-page #main-content .h-sacred-block--hero
      :is(.hb-w, .h-tetra, .hb-front, .hb-back, .h-tetra-back, .h-tetra-label) {
      transition: none !important;
      animation: none !important;
    }

    body.home-page #main-content .h-sacred-block--hero :is(.hb-w, .h-tetra) > .hb-front {
      display: inline-block !important;
      visibility: visible !important;
      opacity: 1 !important;
      transform: none !important;
    }

    body.home-page #main-content .h-sacred-block--hero :is(.hb-back, .h-tetra-back) {
      visibility: hidden !important;
      opacity: 0 !important;
      transform: none !important;
    }

    body.home-page #main-content .h-sacred-block--hero
      :is(.hb-w, .h-tetra):is(:hover, :focus-visible, [data-pointer-preview], [data-toggled]) > .hb-front {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
    }

    body.home-page #main-content .h-sacred-block--hero
      .hb-w:is(:hover, :focus-visible, [data-pointer-preview], [data-toggled]) > .hb-back,
    body.home-page #main-content .h-sacred-block--hero
      .h-tetra:is(:hover, :focus-visible, [data-pointer-preview], [data-toggled]) > .h-tetra-back {
      visibility: visible !important;
      opacity: 1 !important;
      transform: none !important;
    }

    body.home-page #main-content .h-sacred-block--hero .h-tetra-label {
      transform: translate(-50%, -100%) translateY(22px) !important;
    }

    body.home-page #main-content .h-sacred-block--hero
      .h-tetra:is(:hover, :focus-visible, [data-pointer-preview], [data-toggled]) > .h-tetra-label {
      visibility: visible !important;
      opacity: 1 !important;
      filter: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const selector = '.h-sacred-block--hero button.hb-w, .h-sacred-block--hero button.h-tetra';
    const words = document.querySelectorAll(selector);

    words.forEach((word) => {
      if (word.dataset.sacredPointerPreview === '1') return;
      word.dataset.sacredPointerPreview = '1';

      const closePreview = () => word.removeAttribute('data-pointer-preview');
      word.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse' || event.pointerType === 'pen') {
          word.setAttribute('data-pointer-preview', '');
        }
      });
      word.addEventListener('pointerleave', closePreview);
      word.addEventListener('pointercancel', closePreview);
    });

    window.addEventListener('pagehide', () => {
      document.querySelectorAll(`${selector}[data-pointer-preview]`).forEach((word) => {
        word.removeAttribute('data-pointer-preview');
      });
    });
  })();
</script>
