---
/**
 * HomeMain.astro — <main id="main-content" data-pagefind-body>...</main> of /.
 *
 * Refactoring 6.0 parallel pilot: the route no longer proxies one monolithic
 * `_legacy/main.html?raw` block. Instead, the premium standalone home main is
 * assembled from named legacy-faithful fragments while preserving exact DOM,
 * copy and section order.
 *
 * Pixel-parity contract remains guarded via
 *   npm run visual:parity:screenshots -- --routes / --threshold 0.5
 * and source-contract audit in scripts/home-visual-parity-audit.js.
 */
import HomeHeroSection from './HomeHeroSection.astro';
import resumeMobile from './_legacy/resume-mobile.html?raw';
import directions from './_legacy/directions.html?raw';
import planned from './_legacy/planned.html?raw';
import publications from './_legacy/publications.html?raw';
import refutations from './_legacy/refutations.html?raw';
import about from './_legacy/about.html?raw';
import quote from './_legacy/quote.html?raw';
import HomeArticleEndBlock from './HomeArticleEndBlock.astro';
---

<main id="main-content" data-pagefind-body>
  <div class="home-content">
    <HomeHeroSection />
    <Fragment set:html={resumeMobile} />
    <Fragment set:html={directions} />
    <Fragment set:html={planned} />
    <Fragment set:html={publications} />
    <Fragment set:html={refutations} />
    <Fragment set:html={about} />
    <Fragment set:html={quote} />
  </div><!-- /.home-content -->
  <HomeArticleEndBlock />
</main>
