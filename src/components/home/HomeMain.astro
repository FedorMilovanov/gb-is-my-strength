---
/**
 * HomeMain.astro — native semantic main for /.
 */
import HomeHero from './HomeHero.astro';
import ResumeMobile from './HomeSections/ResumeMobile.astro';
import Directions from './HomeSections/Directions.astro';
import Planned from './HomeSections/Planned.astro';
import Publications from './HomeSections/Publications.astro';
import Refutations from './HomeSections/Refutations.astro';
import About from './HomeSections/About.astro';
import Quote from './HomeSections/Quote.astro';
