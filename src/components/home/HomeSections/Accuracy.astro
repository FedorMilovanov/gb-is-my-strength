---
/**
 * Accuracy.astro — feedback block for /.
 */
---
<aside class="gb-accuracy-block" aria-label="Обратная связь">
  <div class="gb-accuracy-inner">
    <h2 class="gb-accuracy-title">Нашли неточность?</h2>
    <p class="gb-accuracy-desc">
      Богословскую или техническую — напишите, исправим.
    </p>
    <div class="gb-accuracy-actions">
      <a href="mailto:viktorcoy2012@gmail.com?subject=Неточность%20в%20статье&body=Здравствуйте%2C%0A%0AЯ%20нашёл%20неточность%20в%20материале.%0A%0AОписание%3A%20"
         class="gb-accuracy-btn gb-accuracy-btn--email"
         aria-label="Написать на Email">
        <svg class="gb-accuracy-btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <rect x="2" y="4" width="20" height="16" rx="3"></rect>
          <path d="m2 7 10 7 10-7"></path>
        </svg>
        <span class="gb-accuracy-btn__label">Email</span>
      </a>
      <a href="https://t.me/fedormilovanov"
         class="gb-accuracy-btn gb-accuracy-btn--tg"
         target="_blank" rel="noopener noreferrer"
         aria-label="Написать в Telegram (откроется в новой вкладке)">
        <svg class="gb-accuracy-btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M21.5 2.5 2.5 10l7.5 2 2 7.5 9.5-17Z"></path>
          <path d="m10 12 10-9.5"></path>
        </svg>
        <span class="gb-accuracy-btn__label">Telegram</span>
      </a>
    </div>
  </div>
</aside>
