<script is:inline>
  (() => {
    const deck = document.querySelector('[data-home-routes]');
    if (!(deck instanceof HTMLElement) || deck.dataset.homeRoutesReady === '1') return;
    deck.dataset.homeRoutesReady = '1';

    const cards = Array.from(deck.querySelectorAll('.h-home-route'));
    const dividers = Array.from(deck.querySelectorAll('.h-home-route__divider'));
    if (!cards.length || dividers.length !== cards.length - 1) return;

    let activeCard = null;
    let touchClearTimer = 0;

    const setActive = (card) => {
      activeCard = card instanceof HTMLElement ? card : null;
      const activeIndex = activeCard ? cards.indexOf(activeCard) : -1;

      cards.forEach((item) => item.classList.toggle('is-active', item === activeCard));
      dividers.forEach((divider, dividerIndex) => {
        divider.classList.toggle(
          'is-active',
          activeIndex >= 0 && (dividerIndex === activeIndex - 1 || dividerIndex === activeIndex),
        );
      });

      if (activeCard) {
        deck.setAttribute('data-home-route-active', activeCard.dataset.homeRoute || 'active');
      } else {
        deck.removeAttribute('data-home-route-active');
      }
    };

    cards.forEach((card) => {
      card.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
        window.clearTimeout(touchClearTimer);
        setActive(card);
      });

      card.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'touch') return;
        window.clearTimeout(touchClearTimer);
        setActive(card);
      }, { passive: true });

      card.addEventListener('pointerup', (event) => {
        if (event.pointerType !== 'touch') return;
        window.clearTimeout(touchClearTimer);
        touchClearTimer = window.setTimeout(() => setActive(null), 180);
      }, { passive: true });

      card.addEventListener('pointercancel', () => {
        window.clearTimeout(touchClearTimer);
        setActive(null);
      });

      card.addEventListener('focus', () => setActive(card));
      card.addEventListener('blur', () => {
        window.setTimeout(() => {
          if (!deck.contains(document.activeElement)) setActive(null);
        }, 0);
      });
    });

    deck.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
      if (deck.contains(document.activeElement)) return;
      setActive(null);
    });

    deck.addEventListener('focusout', () => {
      window.setTimeout(() => {
        if (!deck.contains(document.activeElement)) setActive(null);
      }, 0);
    });

    window.addEventListener('pagehide', () => {
      window.clearTimeout(touchClearTimer);
      setActive(null);
    });
  })();
</script>
