---
/**
 * Directions.astro — responsive library gateway with owner-selected archival art.
 *
 * This component owns route data, the cinematic PNG objects, wide desktop
 * breakout and responsive card layout. Images are decorative; every route keeps
 * a real text label and description.
 */
const routes = [
  {
    href: '/articles/',
    key: 'articles',
    eyebrow: 'Тексты',
    title: 'Статьи',
    description: 'Экзегеза, богословие, переводы и ответы',
    image: '/images/home/directions/articles-scroll.png',
    width: 300,
    height: 205,
  },
  {
    href: '/nagornaya/',
    key: 'series',
    eyebrow: 'По порядку',
    title: 'Серии',
    description: 'Цельные исследования от первой части к последней',
    image: '/images/home/directions/series-documents.png',
    width: 300,
    height: 292,
  },
  {
    href: '/biografii/',
    key: 'biographies',
    eyebrow: 'Люди',
    title: 'Биографии',
    description: 'Служители, реформаторы, богословы и их эпохи',
    image: '/images/home/directions/biographies-theologian.png',
    width: 202,
    height: 300,
  },
  {
    href: '/karty/',
    key: 'maps',
    eyebrow: 'Пространство',
    title: 'Карты',
    description: 'Маршруты, события, связи и библейская география',
    image: '/images/home/directions/maps-biblical-atlas.png',
    width: 300,
    height: 206,
  },
  {
    href: '/konfessii/',
    key: 'confessions',
    eyebrow: 'Системы',
    title: 'Конфессии',
    description: 'Документы веры, традиции и богословские различия',
    image: '/images/home/directions/confessions-dossier.png',
    width: 300,
    height: 247,
  },
];
---

<section class="h-home-gateway h-reveal h-scroll-target" id="issledovat" aria-labelledby="hDirectionsLabel">
  <header class="h-home-section-head h-home-section-head--gateway">
    <div>
      <p class="h-section-label">Пять направлений</p>
      <h2 id="hDirectionsLabel">Исследовать библиотеку</h2>
    </div>
    <p>Начните с отдельного текста, пройдите серию по порядку, откройте исторический контекст или исследуйте материал через карту и документы веры.</p>
  </header>

  <nav
    class="h-home-routes"
    aria-label="Основные направления библиотеки"
    data-home-routes
    data-pagefind-ignore
  >
    {routes.map((route, index) => (
      <>
        {index > 0 && (
          <span
            class="h-home-route__divider"
            data-home-route-divider={index - 1}
            aria-hidden="true"
          ></span>
        )}
        <a
          class="h-home-route h-reveal"
          href={route.href}
          data-home-route={route.key}
          data-home-route-index={index}
        >
          <span class="h-home-route__surface" aria-hidden="true"></span>
          <span class="h-home-route__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="h-home-route__glyph" aria-hidden="true">
            <img
              class={`h-route-object h-route-object--${route.key}`}
              src={route.image}
              alt=""
              width={route.width}
              height={route.height}
              loading="eager"
              decoding="async"
              fetchpriority="low"
            />
          </span>
          <span class="h-home-route__copy">
            <span class="h-home-route__eyebrow">{route.eyebrow}</span>
            <strong>{route.title}</strong>
            <span>{route.description}</span>
          </span>
          <span class="h-home-route__arrow" aria-hidden="true">→</span>
        </a>
      </>
    ))}
  </nav>

  <div class="h-home-gateway__footer">
    <span>Одна библиотека — разные способы начать</span>
    <a href="/izbrannoe/">Открыть избранное <span aria-hidden="true">→</span></a>
  </div>
</section>

<style is:global>
  body.home-page #main-content #issledovat {
    padding: clamp(76px, 8vw, 112px) 0 clamp(48px, 5vw, 70px);
  }

  body.home-page #main-content #issledovat + #publikacii {
    padding-top: clamp(42px, 4.5vw, 62px);
  }

  body.home-page #main-content .h-home-routes {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr) 1px) minmax(0, 1fr);
    /* The legacy 4-column owner in css/home.css sets gap: clamp(22px,3vw,44px).
       This 9-track deck interleaves 1px dividers between cards, so any inherited
       gap inserts ~30px on BOTH sides of every divider and shrinks each card to
       the central two-thirds of its cell. Reset gap to 0 here so cards sit flush
       against their dividers (edge-to-edge selection surface). */
    gap: 0;
    column-gap: 0;
    row-gap: 0;
    border: 1px solid color-mix(in srgb, var(--h-border-strong) 82%, transparent);
    border-radius: 24px;
    background:
      radial-gradient(115% 68% at 50% -20%, color-mix(in srgb, var(--h-accent) 4%, transparent), transparent 66%),
      color-mix(in srgb, var(--h-surface-solid) 46%, transparent);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .32),
      0 30px 86px -68px rgba(43, 28, 10, .56);
    overflow: hidden;
    isolation: isolate;
  }

  html.dark body.home-page #main-content .h-home-routes {
    border-color: color-mix(in srgb, var(--h-gold) 29%, var(--h-border));
    background:
      radial-gradient(118% 72% at 50% -20%, rgba(74, 184, 196, .055), transparent 64%),
      linear-gradient(180deg, rgba(15, 30, 30, .9), rgba(8, 20, 20, .95));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .028),
      inset 0 -1px 0 rgba(196, 153, 84, .035),
      0 38px 94px -66px rgba(0, 0, 0, .88);
  }

  body.home-page #main-content .h-home-route {
    --route-object-scale: 1;
    --route-object-hover-scale: 1.014;
    --route-object-y: 0px;
    --route-shadow-width: 62%;
    --route-shadow-height: 17px;
    --route-shadow-bottom: 19px;
    --route-shadow-opacity: .13;
    position: relative;
    min-width: 0;
    min-height: 410px;
    display: grid;
    grid-template-rows: auto minmax(176px, 1fr) auto auto;
    padding: 20px clamp(17px, 1.55vw, 25px) 23px;
    border: 0;
    color: var(--h-heading);
    text-decoration: none;
    background: transparent;
    overflow: hidden;
    isolation: isolate;
    filter: none;
    transition:
      opacity 520ms cubic-bezier(.22, 1, .36, 1),
      filter 360ms ease,
      transform 700ms cubic-bezier(.22, 1, .36, 1);
    -webkit-tap-highlight-color: transparent;
  }

  /* Padded content wrapper — owns the grid layout + inline padding so the outer
     card equals the full grid cell (padding:0) and the surface (inset:0) fills
     it edge-to-edge between dividers. Mirrors the reference deck → full-width
     card → surface → padded content ownership. */
  /* Direct children (except the surface) sit above the surface. The surface is
     position:absolute; inset:0 and fills the card's padding-box edge-to-edge —
     the same model as the reference .card-surface inside a padded .library-card. */
  body.home-page #main-content .h-home-route > :not(.h-home-route__surface) {
    position: relative;
    z-index: 1;
  }

  /* Retire the legacy 1px underline ::after authored in css/home.css so it can
     no longer conflict with the selection surface. (The legacy owner lives in
     a guarded shared file; removing it there is a separate cleanup task.) */
  body.home-page #main-content .h-home-route::after {
    content: none;
  }

  /* Full-width selection surface — a REAL element (not a pseudo) with
     position:absolute; inset:0, so its bounding rect matches the card exactly
     (edge-to-edge between dividers). This mirrors the reference .card-surface
     and ends the cascade confusion: the card's ::before/::after pseudos are
     retired (the legacy 1px underline ::after from css/home.css is neutralised
     with content:none) and the selection lives on one measurable rectangle. */
  body.home-page #main-content .h-home-route__surface {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: auto;
    max-width: none;
    margin: 0;
    transform: none;
    overflow: hidden;
    border: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(108% 62% at 50% -12%, color-mix(in srgb, var(--h-accent) 12%, transparent), transparent 68%),
      linear-gradient(180deg,
        color-mix(in srgb, var(--h-surface-solid) 84%, transparent),
        color-mix(in srgb, var(--h-surface-solid) 66%, transparent));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .38),
      inset 0 -1px 0 color-mix(in srgb, var(--h-accent) 7%, transparent);
    transition: opacity 340ms ease, background-color 420ms ease, box-shadow 420ms ease;
  }

  /* Soft top halo, clipped to the surface top edge (reference card-surface::before).
     Values 1:1: bright 34% / main 14%, opacity .78, blur 4px. */
  body.home-page #main-content .h-home-route__surface::before {
    content: "";
    position: absolute;
    top: -5px;
    left: 10%;
    right: 10%;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 50% 0,
      color-mix(in srgb, var(--h-accent-dim) 34%, transparent) 0%,
      color-mix(in srgb, var(--h-accent) 14%, transparent) 42%,
      transparent 76%
    );
    filter: blur(4px);
    opacity: .78;
    pointer-events: none;
  }

  /* Edge tint re-inking the very left/right edges so the highlight reads
     across the full card width (reference card-surface::after). Values carried
     1:1: radial 5% + linear 2.5% at stops 23% / 77%. */
  body.home-page #main-content .h-home-route__surface::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(70% 34% at 50% 0%, color-mix(in srgb, var(--h-accent) 5%, transparent), transparent 76%),
      linear-gradient(90deg,
        color-mix(in srgb, var(--h-accent) 2.5%, transparent),
        transparent 23%,
        transparent 77%,
        color-mix(in srgb, var(--h-accent) 2.5%, transparent));
  }

  html.dark body.home-page #main-content .h-home-route__surface {
    background:
      radial-gradient(110% 68% at 50% -16%, rgba(75, 187, 198, .11), transparent 67%),
      linear-gradient(180deg, rgba(25, 47, 47, .82), rgba(12, 29, 29, .76));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .035),
      inset 0 -1px 0 rgba(75, 187, 198, .05);
  }

  html.dark body.home-page #main-content .h-home-route__surface::before {
    background: radial-gradient(
      ellipse at 50% 0,
      rgba(118, 211, 220, .18) 0%,
      rgba(75, 187, 198, .07) 42%,
      transparent 76%
    );
    opacity: .62;
    filter: blur(5px);
  }

  body.home-page #main-content .h-home-route__divider {
    position: relative;
    z-index: 4;
    width: 1px;
    min-width: 1px;
    align-self: stretch;
    background: linear-gradient(
      to bottom,
      transparent 0,
      var(--h-border) 3%,
      var(--h-border) 97%,
      transparent 100%
    );
    box-shadow: none;
    pointer-events: none;
    transition: background 360ms ease, box-shadow 420ms ease;
  }

  body.home-page #main-content .h-home-route__divider.is-active {
    background: linear-gradient(
      to bottom,
      transparent 0,
      color-mix(in srgb, var(--h-accent) 20%, var(--h-border)) 3%,
      color-mix(in srgb, var(--h-accent) 58%, var(--h-border)) 18%,
      color-mix(in srgb, var(--h-accent) 58%, var(--h-border)) 82%,
      color-mix(in srgb, var(--h-accent) 20%, var(--h-border)) 97%,
      transparent 100%
    );
    box-shadow: 0 0 8px color-mix(in srgb, var(--h-accent) 7%, transparent);
  }

  html.dark body.home-page #main-content .h-home-route__divider {
    background: linear-gradient(
      to bottom,
      transparent 0,
      color-mix(in srgb, var(--h-gold) 11%, var(--h-border)) 3%,
      color-mix(in srgb, var(--h-gold) 18%, var(--h-border)) 22%,
      color-mix(in srgb, var(--h-gold) 18%, var(--h-border)) 78%,
      color-mix(in srgb, var(--h-gold) 11%, var(--h-border)) 97%,
      transparent 100%
    );
  }

  html.dark body.home-page #main-content .h-home-route__divider.is-active {
    background: linear-gradient(
      to bottom,
      transparent 0,
      rgba(75, 187, 198, .12) 3%,
      rgba(75, 187, 198, .38) 18%,
      rgba(75, 187, 198, .42) 50%,
      rgba(75, 187, 198, .38) 82%,
      rgba(75, 187, 198, .12) 97%,
      transparent 100%
    );
    box-shadow: 0 0 9px rgba(75, 187, 198, .05);
  }

  /* Reveal the surface (opacity:1 + full-height cyan side beams) on hover,
     focus, active and JS-pinned is-active. Side-beam values carried 1:1 from
     the reference light theme: inset 26px 0 68px -64px @ 28%. :hover is listed
     so the highlight fires immediately inside an iframe preview. */
  body.home-page #main-content .h-home-route:is(.is-active, :hover, :active, :focus-visible) .h-home-route__surface {
    opacity: 1;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .34),
      inset 0 -1px 0 color-mix(in srgb, var(--h-accent) 7%, transparent),
      inset 26px 0 68px -64px color-mix(in srgb, var(--h-accent) 28%, transparent),
      inset -26px 0 68px -64px color-mix(in srgb, var(--h-accent) 28%, transparent);
  }

  /* Dark active side beams — 1:1 from the reference: inset 24px 0 62px -58px
     rgba(75,187,198,.15). */
  html.dark body.home-page #main-content .h-home-route:is(.is-active, :hover, :active, :focus-visible) .h-home-route__surface {
    box-shadow:
      inset 0 1px rgba(255, 255, 255, .035),
      inset 0 -1px rgba(75, 187, 198, .05),
      inset 24px 0 62px -58px rgba(75, 187, 198, .15),
      inset -24px 0 62px -58px rgba(75, 187, 198, .15);
  }

  /* Keyboard focus: a 2px ring instead of the side glow. */
  body.home-page #main-content .h-home-route:focus-visible .h-home-route__surface {
    box-shadow:
      inset 0 0 0 2px color-mix(in srgb, var(--h-accent) 34%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, .38),
      inset 0 -1px 0 color-mix(in srgb, var(--h-accent) 7%, transparent);
  }

  body.home-page #main-content .h-home-routes[data-home-route-active] .h-home-route.h-in:not(.is-active) {
    opacity: .92;
    filter: saturate(.96);
  }

  html.dark body.home-page #main-content .h-home-routes[data-home-route-active] .h-home-route.h-in:not(.is-active) {
    opacity: .88;
    filter: saturate(.93) brightness(.97);
  }

  body.home-page #main-content .h-home-route[data-home-route="articles"] {
    --route-object-scale: 1.16;
    --route-object-hover-scale: 1.166;
    --route-object-y: 4px;
    --route-shadow-width: 56%;
    --route-shadow-height: 14px;
    --route-shadow-bottom: 21px;
    --route-shadow-opacity: .10;
  }

  body.home-page #main-content .h-home-route[data-home-route="series"] {
    --route-object-scale: .95;
    --route-object-hover-scale: .956;
    --route-shadow-width: 61%;
    --route-shadow-height: 17px;
    --route-shadow-bottom: 17px;
    --route-shadow-opacity: .13;
  }

  body.home-page #main-content .h-home-route[data-home-route="biographies"] {
    --route-object-scale: .98;
    --route-object-hover-scale: .986;
    --route-object-y: -1px;
    --route-shadow-width: 45%;
    --route-shadow-height: 13px;
    --route-shadow-bottom: 15px;
    --route-shadow-opacity: .095;
  }

  body.home-page #main-content .h-home-route[data-home-route="maps"] {
    --route-object-scale: 1.06;
    --route-object-hover-scale: 1.066;
    --route-object-y: 6px;
    --route-shadow-width: 68%;
    --route-shadow-height: 13px;
    --route-shadow-bottom: 21px;
    --route-shadow-opacity: .085;
  }

  body.home-page #main-content .h-home-route[data-home-route="confessions"] {
    --route-object-scale: 1.02;
    --route-object-hover-scale: 1.026;
    --route-object-y: 4px;
    --route-shadow-width: 61%;
    --route-shadow-height: 16px;
    --route-shadow-bottom: 18px;
    --route-shadow-opacity: .115;
  }

  body.home-page #main-content .h-home-route__index {
    color: var(--h-muted);
    font-family: var(--f-ui);
    font-size: 8px;
    font-weight: 760;
    letter-spacing: .24em;
    opacity: .68;
    transition: color 320ms ease, opacity 320ms ease;
  }

  body.home-page #main-content .h-home-route__glyph {
    position: relative;
    width: 100%;
    min-height: 176px;
    display: grid;
    place-items: center;
    align-self: center;
    margin: 4px 0 8px;
    overflow: visible;
  }

  body.home-page #main-content .h-home-route__glyph::before,
  body.home-page #main-content .h-home-route__glyph::after {
    content: "";
    position: absolute;
    left: 50%;
    border-radius: 50%;
    pointer-events: none;
    transition: opacity 420ms ease, transform 720ms cubic-bezier(.18, .86, .26, 1.04), filter 520ms ease;
  }

  body.home-page #main-content .h-home-route__glyph::before {
    z-index: 0;
    top: 16%;
    width: 82%;
    height: 62%;
    background: radial-gradient(ellipse at center,
      rgba(183, 132, 65, .045) 0%,
      rgba(39, 138, 151, .018) 46%,
      transparent 76%);
    filter: blur(13px);
    opacity: .62;
    transform: translateX(-50%);
  }

  body.home-page #main-content .h-home-route__glyph::after {
    z-index: 0;
    bottom: var(--route-shadow-bottom);
    width: var(--route-shadow-width);
    height: var(--route-shadow-height);
    background: radial-gradient(ellipse at center,
      rgba(62, 40, 17, .10) 0%,
      rgba(62, 40, 17, .035) 40%,
      rgba(62, 40, 17, .008) 64%,
      transparent 82%);
    filter: blur(15px);
    opacity: var(--route-shadow-opacity);
    transform: translateX(-50%) scale(.98, .94);
  }

  html.dark body.home-page #main-content .h-home-route__glyph::before {
    background: radial-gradient(ellipse at center,
      rgba(199, 155, 91, .055) 0%,
      rgba(76, 136, 137, .028) 44%,
      transparent 76%);
    filter: blur(14px);
    opacity: .72;
  }

  html.dark body.home-page #main-content .h-home-route__glyph::after {
    background: radial-gradient(ellipse at center,
      rgba(0, 0, 0, .34) 0%,
      rgba(0, 0, 0, .10) 43%,
      transparent 80%);
    filter: blur(18px);
    opacity: calc(var(--route-shadow-opacity) * 1.05);
  }

  body.home-page #main-content .h-route-object {
    position: relative;
    z-index: 1;
    width: min(100%, 218px);
    max-height: 190px;
    display: block;
    object-fit: contain;
    filter:
      saturate(.965)
      contrast(1.01)
      drop-shadow(0 12px 16px rgba(56, 36, 16, .058))
      drop-shadow(0 3px 5px rgba(56, 36, 16, .052))
      drop-shadow(0 1px 1px rgba(56, 36, 16, .038));
    transform: translate3d(0, var(--route-object-y), 0) scale(var(--route-object-scale));
    transform-origin: center;
    transition:
      transform 760ms cubic-bezier(.18, .86, .26, 1.04),
      filter 480ms ease;
  }

  html.dark body.home-page #main-content .h-route-object {
    filter:
      saturate(.98)
      brightness(.91)
      contrast(1.03)
      drop-shadow(0 15px 18px rgba(0, 0, 0, .23))
      drop-shadow(0 4px 5px rgba(0, 0, 0, .18));
  }

  body.home-page #main-content .h-home-route.is-active .h-route-object,
  body.home-page #main-content .h-home-route:focus-visible .h-route-object,
  body.home-page #main-content .h-home-route:active .h-route-object {
    filter:
      saturate(1.03)
      contrast(1.012)
      drop-shadow(0 15px 20px rgba(56, 36, 16, .07))
      drop-shadow(0 4px 6px rgba(56, 36, 16, .058))
      drop-shadow(0 1px 1px rgba(56, 36, 16, .044));
    transform: translate3d(0, calc(var(--route-object-y) - 3px), 0) scale(var(--route-object-hover-scale));
  }

  html.dark body.home-page #main-content .h-home-route.is-active .h-route-object,
  html.dark body.home-page #main-content .h-home-route:focus-visible .h-route-object,
  html.dark body.home-page #main-content .h-home-route:active .h-route-object {
    filter:
      saturate(1.04)
      brightness(.98)
      contrast(1.035)
      drop-shadow(0 17px 21px rgba(0, 0, 0, .26))
      drop-shadow(0 4px 6px rgba(0, 0, 0, .20));
  }

  body.home-page #main-content .h-home-route.is-active .h-home-route__glyph::before,
  body.home-page #main-content .h-home-route:focus-visible .h-home-route__glyph::before,
  body.home-page #main-content .h-home-route:active .h-home-route__glyph::before {
    opacity: .9;
    transform: translateX(-50%) scale(1.035);
  }

  body.home-page #main-content .h-home-route.is-active .h-home-route__glyph::after,
  body.home-page #main-content .h-home-route:focus-visible .h-home-route__glyph::after,
  body.home-page #main-content .h-home-route:active .h-home-route__glyph::after {
    opacity: calc(var(--route-shadow-opacity) * 1.08);
    transform: translateX(-50%) scale(1.02, .96);
  }

  body.home-page #main-content .h-home-route__eyebrow {
    display: block;
    margin-bottom: 7px;
    color: var(--h-accent);
    font-family: var(--f-ui);
    font-size: 8px;
    font-weight: 760;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  body.home-page #main-content .h-home-route__copy strong {
    display: block;
    margin-bottom: 10px;
    color: var(--h-heading);
    font-family: var(--f-body);
    font-size: clamp(1.24rem, 1.48vw, 1.52rem);
    line-height: 1.1;
    transition: color 300ms ease, transform 600ms cubic-bezier(.18, .86, .26, 1.04);
  }

  body.home-page #main-content .h-home-route__copy > span:last-child {
    display: block;
    max-width: 190px;
