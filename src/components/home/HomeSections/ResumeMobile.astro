---
/**
 * ResumeMobile.astro — conditional reading-resume blocks for /.
 */
---
<section class="resume-reading-block" id="resumeReadingBlock" hidden>
  <div class="resume-reading-card">
    <div class="resume-reading-label">Продолжить чтение</div>
    <h2 class="resume-reading-title" id="resumeReadingTitle">Статья</h2>
    <p class="resume-reading-meta" id="resumeReadingMeta">Раздел и прогресс</p>
    <div class="resume-reading-progress">
      <div class="resume-reading-progress-fill" id="resumeReadingProgress"></div>
    </div>
    <div class="resume-reading-actions">
      <a href="#" class="resume-reading-btn" id="resumeReadingLink" rel="noopener" data-resume-link>Продолжить</a>
      <button type="button" class="resume-reading-dismiss" id="resumeReadingDismiss">Скрыть</button>
    </div>
  </div>
</section>

<section class="resume-list-block" id="resumeListBlock" hidden aria-labelledby="resumeListTitle">
  <div class="resume-list-head"><h2 id="resumeListTitle">Недочитанные статьи</h2></div>
  <div class="resume-list" id="resumeList"></div>
</section>
