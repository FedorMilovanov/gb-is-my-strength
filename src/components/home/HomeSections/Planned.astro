---
/**
 * Planned.astro — quiet roadmap note for /.
 */
---
<section class="h-section h-home-roadmap h-reveal" aria-labelledby="hPlannedLabel">
  <div class="h-planned-header">
    <span class="h-planned-dot" aria-hidden="true"></span>
    <h2 class="h-planned-label" id="hPlannedLabel">В планах</h2>
    <div class="h-planned-line" aria-hidden="true"></div>
  </div>

  <div class="h-home-roadmap__items" role="list">

    <!-- Гимны -->
    <div class="h-home-roadmap__item h-reveal h-reveal-d1" role="listitem">
      <svg class="h-card-icon" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M9 18V5l12-2v13"/>
        <circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
      </svg>
      <div>
        <h3 class="h-card-title">Гимны и их история</h3>
        <p class="h-card-desc">Богословское содержание классических гимнов и их исторический контекст</p>
      </div>
    </div>

    <!-- Тематические исследования -->
    <div class="h-home-roadmap__item h-reveal h-reveal-d2" role="listitem">
      <svg class="h-card-icon" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="3"/>
        <path d="M11 3v2m0 12v2M3 11h2m12 0h2M5.64 5.64l1.41 1.41m7.9 7.9 1.41 1.41M5.64 16.36l1.41-1.41m7.9-7.9 1.41-1.41"/>
      </svg>
      <div>
        <h3 class="h-card-title">Тематические исследования</h3>
        <p class="h-card-desc">Глубокие разборы отдельных тем, понятий и богословских вопросов</p>
      </div>
    </div>

  </div>
</section>
