---
/**
 * Favorites.astro — «Ваше избранное» на главной.
 * Рендерится из localStorage gb-favorites клиентским скриптом.
 * Без JS — секция скрыта (hidden).
 */
---

<section class="favorites-block" id="favoritesBlock" hidden>
  <h3 class="favorites-block__heading">Ваше избранное</h3>
  <p class="favorites-block__sub">Статьи, которые вы отметили для себя</p>
  <div class="favorites-list" id="favoritesList"></div>
</section>

<script is:inline>
(function() {
  var FAV_KEY = 'gb-favorites';
  var block = document.getElementById('favoritesBlock');
  var list = document.getElementById('favoritesList');
  if (!block || !list) return;
  var favs = [];
  try { favs = JSON.parse(localStorage.getItem(FAV_KEY)) || []; } catch(e) {}
  if (!favs.length) return;

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  favs.slice(0, 8).forEach(function(f) {
    var card = document.createElement('a');
    card.className = 'favorites-card';
    var safePath = f.path ? String(f.path) : '/';
    card.href = safePath.endsWith('/') ? safePath : safePath + '/';
    card.setAttribute('data-fav-path', safePath);

    var safeImg = f.image && /^(https?:)?\//i.test(f.image) ? esc(f.image) : '';
    var imgHtml = safeImg
      ? '<div class="favorites-card__img" style="background-image:url(\'' + safeImg + '\')"></div>'
      : '';
    var section = f.section
      ? '<span class="favorites-card__section">' + esc(f.section) + '</span>'
      : '';

    card.innerHTML = imgHtml +
      '<div class="favorites-card__body">' +
        section +
        '<span class="favorites-card__title">' + esc(f.title || 'Статья') + '</span>' +
        (f.description ? '<span class="favorites-card__desc">' + esc(f.description) + '</span>' : '') +
      '</div>';

    list.appendChild(card);
  });

  block.hidden = false;

})();
</script>
