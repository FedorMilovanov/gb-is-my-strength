---
/**
 * Favorites.astro — «Ваше избранное» на главной.
 * Рендерится через canonical GBFavoriteStore v1.
 * Без JS — секция скрыта (hidden).
 */
---

<section class="favorites-block" id="favoritesBlock" hidden aria-labelledby="favoritesBlockTitle">
  <h2 class="favorites-block__heading" id="favoritesBlockTitle">Ваше избранное</h2>
  <p class="favorites-block__sub">Статьи, которые вы отметили для себя</p>
  <div class="favorites-list" id="favoritesList"></div>
</section>

<script>
  import '../../../runtime/favorite-store.js';

  type FavoriteRecord = {
    path?: unknown;
    schemaVersion?: unknown;
    image?: unknown;
    category?: unknown;
    section?: unknown;
    title?: unknown;
    description?: unknown;
  };

  type FavoriteStore = {
    schemaVersion: number;
    list(): FavoriteRecord[];
    normalizePath(value: unknown): string | null;
    subscribe(listener: () => void): unknown;
  };

  const favoriteWindow = window as typeof window & { GBFavoriteStore?: FavoriteStore };
  const block = document.getElementById('favoritesBlock');
  const list = document.getElementById('favoritesList');

  function textNode(className: string, value: unknown) {
    const node = document.createElement('span');
    node.className = className;
    node.textContent = String(value == null ? '' : value);
    return node;
  }

  function renderFavorites() {
    const store = favoriteWindow.GBFavoriteStore;
    if (!block || !list || !store) return;
    list.replaceChildren();

    store.list().slice(0, 8).forEach((favorite) => {
      if (!favorite || typeof favorite !== 'object' || Array.isArray(favorite)) return;
      const safePath = store.normalizePath(favorite.path);
      if (!safePath) return;

      const card = document.createElement('a');
      card.className = 'favorites-card';
      card.href = safePath === '/' ? '/' : `${safePath}/`;
      card.dataset.favPath = safePath;
      card.dataset.favoriteSchema = String(favorite.schemaVersion || store.schemaVersion);

      if (favorite.image) {
        try {
          const imageUrl = new URL(String(favorite.image), window.location.origin);
          if (imageUrl.protocol === 'http:' || imageUrl.protocol === 'https:') {
            const image = document.createElement('div');
            image.className = 'favorites-card__img';
            image.style.backgroundImage = `url("${imageUrl.href.replace(/"/g, '%22')}")`;
            card.appendChild(image);
          }
        } catch {}
      }

      const body = document.createElement('div');
      body.className = 'favorites-card__body';
      const section = favorite.category || favorite.section;
      if (section) body.appendChild(textNode('favorites-card__section', section));
      body.appendChild(textNode('favorites-card__title', favorite.title || 'Материал'));
      if (favorite.description) body.appendChild(textNode('favorites-card__desc', favorite.description));
      card.appendChild(body);
      list.appendChild(card);
    });

    block.hidden = list.children.length === 0;
  }

  if (favoriteWindow.GBFavoriteStore) {
    favoriteWindow.GBFavoriteStore.subscribe(renderFavorites);
    renderFavorites();
  } else {
    window.addEventListener('gb:favorite-store-ready', () => {
      const store = favoriteWindow.GBFavoriteStore;
      if (!store) return;
      store.subscribe(renderFavorites);
      renderFavorites();
    }, { once: true });
  }
</script>
