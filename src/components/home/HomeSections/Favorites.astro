---
/**
 * Favorites.astro — «Ваше избранное» на главной.
 * Рендерится из localStorage gb-favorites клиентским скриптом.
 * Без JS — секция скрыта (hidden).
 */
---

<section class="favorites-block" id="favoritesBlock" hidden>
  <h3 class="favorites-block__heading">Ваше избранное</h3>
  <p class="favorites-block__sub">Статьи, которые вы отметили для себя</p>
  <div class="favorites-list" id="favoritesList"></div>
</section>

<script is:inline>
(function() {
  var FAV_KEY = 'gb-favorites';
  var block = document.getElementById('favoritesBlock');
  var list = document.getElementById('favoritesList');
  if (!block || !list) return;
  var favs = [];
  try { favs = JSON.parse(localStorage.getItem(FAV_KEY)) || []; } catch(e) {}
  if (!Array.isArray(favs) || !favs.length) return;

  function textNode(className, value) {
    var node = document.createElement('span');
    node.className = className;
    node.textContent = String(value == null ? '' : value);
    return node;
  }

  favs.slice(0, 8).forEach(function(f) {
    if (!f || typeof f !== 'object' || Array.isArray(f)) return;

    var rawPath = f.path ? String(f.path) : '/';
    var safePath = /^\/(?!\/)/.test(rawPath) ? rawPath : '/';
    var card = document.createElement('a');
    card.className = 'favorites-card';
    card.href = safePath.endsWith('/') ? safePath : safePath + '/';
    card.setAttribute('data-fav-path', safePath);

    if (f.image) {
      try {
        var imageUrl = new URL(String(f.image), window.location.origin);
        if (imageUrl.protocol === 'http:' || imageUrl.protocol === 'https:') {
          var image = document.createElement('div');
          image.className = 'favorites-card__img';
          image.style.backgroundImage = 'url("' + imageUrl.href.replace(/"/g, '%22') + '")';
          card.appendChild(image);
        }
      } catch(e) {}
    }

    var body = document.createElement('div');
    body.className = 'favorites-card__body';
    if (f.section) body.appendChild(textNode('favorites-card__section', f.section));
    body.appendChild(textNode('favorites-card__title', f.title || 'Статья'));
    if (f.description) body.appendChild(textNode('favorites-card__desc', f.description));
    card.appendChild(body);

    list.appendChild(card);
  });

  if (list.children.length) block.hidden = false;

})();
</script>
