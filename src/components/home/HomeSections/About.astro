---
/**
 * About.astro — quiet project statement for /.
 *
 * The former synthetic lion roar was intentionally removed. The project mark
 * now lives in the hero as a non-interactive identity element.
 */
const principles = [
  ['Медленное чтение', 'Материалы рассчитаны на вдумчивую работу, а не на бесконечную ленту.'],
  ['Проверяемые источники', 'Цитаты, библиография и исторический контекст остаются частью исследования.'],
  ['Единая библиотека', 'Статьи, серии, биографии и карты связаны общей навигацией и поиском.'],
];
---
<section class="h-about h-reveal h-scroll-target" id="about" aria-labelledby="hAboutLabel">
  <div class="h-about__copy">
    <p class="h-about-label">О проекте</p>
    <h2 id="hAboutLabel">Библиотека, где содержание важнее шума</h2>
    <p class="h-about-text">
      Это не лента быстрых заметок и не коллекция удобных цитат. Здесь собраны авторские статьи, переводы зарубежных богословов, экзегетические разборы, биографии и ответы на вопросы, которые нельзя честно решить одним абзацем.
    </p>
    <p class="h-about-small">
      Библиотеку ведёт <a href="/about/">Фёдор Милованов</a>. Переведённые материалы публикуются в ознакомительных целях и снимаются по запросу правообладателя.
    </p>
  </div>

  <ul class="h-about-principles" role="list" aria-label="Принципы библиотеки">
    {principles.map(([title, description], index) => (
      <li>
        <span class="h-about-principles__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div>
          <strong>{title}</strong>
          <p>{description}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style is:global>
  body.home-page #main-content .h-about__copy h2 {
    max-width: 720px;
    text-wrap: balance;
    hyphens: none;
    overflow-wrap: normal;
  }

  body.home-page #main-content .h-about-text {
    max-width: 680px;
  }

  body.home-page #main-content .h-about-text::first-letter {
    color: var(--h-gold);
  }

  body.home-page #main-content .h-about-principles li {
    position: relative;
  }

  body.home-page #main-content .h-about-principles li::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--h-accent), transparent);
    opacity: 0;
    transition: opacity .28s ease;
  }

  body.home-page #main-content .h-about-principles li:is(:hover, :focus-within)::before {
    opacity: .75;
  }

  @media (min-width: 901px) {
    body.home-page #main-content .h-about {
      grid-template-columns: minmax(0, 1.12fr) minmax(340px, .72fr);
      gap: clamp(54px, 7vw, 104px);
      padding-top: clamp(76px, 8vw, 106px);
      padding-bottom: clamp(68px, 7vw, 94px);
    }

    body.home-page #main-content .h-about__copy h2 {
      font-size: clamp(2.7rem, 4.7vw, 4.5rem);
      line-height: 1.02;
      letter-spacing: -.045em;
    }

    body.home-page #main-content .h-about-principles li {
      min-height: 104px;
      padding-left: 16px;
    }
  }

  @media (max-width: 760px) {
    body.home-page #main-content .h-about {
      gap: 34px;
      margin-top: 34px;
      padding: 50px 0 40px;
    }

    body.home-page #main-content .h-about__copy h2 {
      max-width: 350px;
      margin-top: 9px;
      font-size: clamp(2.15rem, 10.2vw, 2.82rem);
      line-height: 1.03;
      letter-spacing: -.045em;
    }

    body.home-page #main-content .h-about-text {
      margin-top: 26px;
      font-size: 16px;
      line-height: 1.7;
    }

    body.home-page #main-content .h-about-text::first-letter {
      float: left;
      margin: .08em .12em 0 0;
      font-size: 3.7em;
      line-height: .76;
    }

    body.home-page #main-content .h-about-small {
      margin-top: 20px;
      font-size: 13.5px;
      line-height: 1.65;
    }

    body.home-page #main-content .h-about-principles li {
      min-height: 0;
      grid-template-columns: 34px 1fr;
      gap: 15px;
      padding: 19px 0;
    }

    body.home-page #main-content .h-about-principles strong {
      margin-bottom: 5px;
      font-size: 17px;
    }

    body.home-page #main-content .h-about-principles p {
      font-size: 14px;
      line-height: 1.5;
    }
  }

  @media (max-width: 340px) {
    body.home-page #main-content .h-about__copy h2 {
      font-size: 2.08rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body.home-page #main-content .h-about-principles li::before {
      transition: none;
    }
  }
</style>
