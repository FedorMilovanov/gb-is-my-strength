---
/**
 * Quote.astro — scripture mirror section for /.
 *
 * The Hebrew mirror echoes the upper Habakkuk sacred block as a decorative
 * right-aligned epigraph. On hover (fine pointer only) each Hebrew word flips
 * in place to reveal its Russian reading, reusing the exact flip technique
 * owned by HomeHero — same 3D rotateX/rotateZ, opacity/blur reveals and silk
 * easing — so the lower reflection feels like the upper one. No legacy hb-w
 * owner is reintroduced: the mirror stays a self-contained, pointer-inert
 * block whose individual words alone opt back into pointer events.
 */
---

<section class="h-quote-section h-reveal" aria-label="Эпиграф">
  <div class="h-ornament" aria-hidden="true">✦</div>

  <div class="h-quote-mirror">
    <div class="h-quote-left">
      <blockquote class="h-blockquote h-blockquote--mirror">
        Господь Бог — сила моя: Он сделает ноги мои как у оленя и на высоты мои возведёт меня.
      </blockquote>
      <cite class="h-cite h-cite--mirror">— Аввакум 3:19</cite>
    </div>

    <div class="h-quote-divider" aria-hidden="true"></div>

    <div class="h-quote-right">
      <div class="h-sacred-block h-sacred-block--mirror" aria-hidden="true" role="presentation">
        <span class="h-sacred-line h-sacred-line--1">
          <span class="h-sacred-mirror-word" lang="he">
            <span class="h-sacred-mirror-face h-sacred-mirror-face--front">יְהוִה</span>
            <span class="h-sacred-mirror-face h-sacred-mirror-face--back">Яхве</span>
          </span>
          <span class="h-sacred-mirror-word" lang="he">
            <span class="h-sacred-mirror-face h-sacred-mirror-face--front">אֲדֹנָי</span>
            <span class="h-sacred-mirror-face h-sacred-mirror-face--back">Господь</span>
          </span>
          <span class="h-sacred-mirror-word" lang="he">
            <span class="h-sacred-mirror-face h-sacred-mirror-face--front">חֵילִי</span>
            <span class="h-sacred-mirror-face h-sacred-mirror-face--back">сила моя</span>
          </span>
        </span>

        <span class="h-sacred-line h-sacred-line--2">
          <span class="h-sacred-mirror-word" lang="he">
            <span class="h-sacred-mirror-face h-sacred-mirror-face--front">וַיָּשֶׂם</span>
            <span class="h-sacred-mirror-face h-sacred-mirror-face--back">и сделает</span>
          </span>
          <span class="h-sacred-mirror-word" lang="he">
            <span class="h-sacred-mirror-face h-sacred-mirror-face--front">רַגְלַי</span>
            <span class="h-sacred-mirror-face h-sacred-mirror-face--back">ноги мои</span>
          </span>
          <span class="h-sacred-mirror-word" lang="he">
            <span class="h-sacred-mirror-face h-sacred-mirror-face--front">כָּאַיָּלוֹת</span>
            <span class="h-sacred-mirror-face h-sacred-mirror-face--back">как у ланей</span>
          </span>
          <span class="h-sacred-mirror-word" lang="he">
            <span class="h-sacred-mirror-face h-sacred-mirror-face--front">וְעַל</span>
            <span class="h-sacred-mirror-face h-sacred-mirror-face--back">и на</span>
          </span>
          <span class="h-sacred-mirror-word" lang="he">
            <span class="h-sacred-mirror-face h-sacred-mirror-face--front">בָּמוֹתַי</span>
            <span class="h-sacred-mirror-face h-sacred-mirror-face--back">высоты мои</span>
          </span>
          <span class="h-sacred-mirror-word" lang="he">
            <span class="h-sacred-mirror-face h-sacred-mirror-face--front">יַדְרִכֵנִי</span>
            <span class="h-sacred-mirror-face h-sacred-mirror-face--back">даст мне ступать</span>
          </span>
        </span>

        <span class="h-sacred-ref h-sacred-ref--mirror">
          <span>Аввакум 3:19</span>
        </span>
      </div>
    </div>
  </div>

  <div class="h-ornament" aria-hidden="true" style="margin-top:28px;">✦</div>
</section>

<script is:inline>
  (() => {
    const block = document.querySelector('.h-sacred-block--mirror');
    if (!block || block.dataset.mirrorOwnerReady === '1') return;
    block.dataset.mirrorOwnerReady = '1';

    const words = Array.from(block.querySelectorAll('.h-sacred-mirror-word'));
    if (!words.length) return;

    // Reuse the upper sacred block's measuring technique: pin each shell to
    // its Hebrew face width at rest and to the wider Russian reading on hover,
    // so the translation never clips and the rest line never looks scattered.
    const measure = () => {
      words.forEach((word) => {
        const front = word.querySelector('.h-sacred-mirror-face--front');
        const back = word.querySelector('.h-sacred-mirror-face--back');
        if (!(front instanceof HTMLElement) || !(back instanceof HTMLElement)) return;
        const frontWidth = Math.ceil(front.getBoundingClientRect().width + 2);
        const backWidth = Math.ceil(back.getBoundingClientRect().width + 4);
        word.style.setProperty('--mirror-closed-w', `${frontWidth}px`);
        word.style.setProperty('--mirror-open-w', `${Math.max(frontWidth, backWidth)}px`);
      });
    };

    measure();
    document.fonts?.ready.then(measure).catch(measure);
    window.addEventListener('resize', measure, { passive: true });
  })();
</script>

<style is:global>
  /* The mirror block stays pointer-inert (contract); only the individual
     Hebrew words opt back into pointer events so the hover flip can fire. */
  body.home-page #main-content .h-sacred-block--mirror {
    pointer-events: none;
  }

  /* Hebrew is right-aligned to the mirror edge, not centred. The sacred lines
     inherit direction: rtl from the hero owner, so flex-start packs the words
     against the right edge of the right column. */
  body.home-page #main-content .h-sacred-block--mirror .h-sacred-line {
    justify-content: flex-start;
  }

  body.home-page #main-content .h-sacred-block--mirror .h-sacred-mirror-word {
    --mirror-closed-w: auto;
    --mirror-open-w: auto;
    --mirror-flip-ms: 620ms;
    --mirror-silk: cubic-bezier(.22, 1, .36, 1);
    position: relative;
    display: inline-grid;
    grid-template-areas: "face";
    flex: 0 0 auto;
    width: var(--mirror-closed-w);
    min-width: 0;
    margin: 0 .15em;
    overflow: visible;
    isolation: isolate;
    perspective: 560px;
    pointer-events: auto;
    transition: width var(--mirror-flip-ms) var(--mirror-silk) 150ms;
  }

  body.home-page #main-content .h-sacred-block--mirror .h-sacred-mirror-face {
    grid-area: face;
    align-self: center;
    justify-self: center;
    display: inline-block;
    white-space: nowrap;
    transform-origin: 50% 56%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    -webkit-font-smoothing: antialiased;
    transition:
      transform var(--mirror-flip-ms) var(--mirror-silk),
      opacity 420ms ease,
      filter 480ms var(--mirror-silk);
    will-change: transform, opacity;
  }

  body.home-page #main-content .h-sacred-block--mirror .h-sacred-mirror-face--front {
    color: var(--h-ink);
    font-family: var(--f-hebrew, "Noto Serif Hebrew", "Noto Sans Hebrew", serif);
    font-style: normal;
    font-weight: 500;
    opacity: .82;
    transform: translate3d(0, 0, 0) rotateX(0deg) rotateZ(0deg) scale(1);
    filter: blur(0);
  }

  body.home-page #main-content .h-sacred-block--mirror .h-sacred-mirror-face--back {
    direction: ltr;
    color: var(--h-heading);
    font-family: var(--f-body);
    font-size: .56em;
    font-style: italic;
    font-weight: 700;
    line-height: 1;
    opacity: 0;
    transform: translate3d(0, .08em, 0) rotateX(16deg) rotateZ(7deg) scale(.86);
    filter: blur(1.8px);
    text-shadow: 0 2px 12px rgba(23, 28, 29, .08);
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    body.home-page #main-content .h-sacred-block--mirror .h-sacred-mirror-word:hover {
      width: var(--mirror-open-w);
      z-index: 4;
      transition-delay: 0ms;
    }

    body.home-page #main-content .h-sacred-block--mirror .h-sacred-mirror-word:hover .h-sacred-mirror-face--front {
      opacity: 0;
      transform: translate3d(0, -.07em, 0) rotateX(-16deg) rotateZ(-7deg) scale(.86);
      filter: blur(1.5px);
      transition-delay: 24ms, 18ms, 18ms;
    }

    body.home-page #main-content .h-sacred-block--mirror .h-sacred-mirror-word:hover .h-sacred-mirror-face--back {
      opacity: 1;
      transform: translate3d(0, 0, 0) rotateX(0deg) rotateZ(0deg) scale(1);
      filter: blur(0);
      transition-delay: 110ms, 120ms, 100ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body.home-page #main-content .h-sacred-block--mirror .h-sacred-mirror-word,
    body.home-page #main-content .h-sacred-block--mirror .h-sacred-mirror-face {
      transition: none;
    }
  }

  /* Mobile-only premium stacked epigraph: иврит as the sacred top layer
     (right-to-left, right-aligned), the gold reference as a small caption,
     the Russian translation below. No frame, no borders — pure typography.
     Desktop mirror layout is untouched above 760px. */
  @media (max-width: 760px) {
    body.home-page #main-content .h-quote-section {
      padding: 14px 0 8px;
    }

    body.home-page #main-content .h-quote-section .h-ornament {
      display: none;
    }

    body.home-page #main-content .h-quote-mirror {
      flex-direction: column;
      gap: 16px;
      padding: 0;
    }

    /* иврит first, right-to-left, right-aligned. */
    body.home-page #main-content .h-quote-right {
      order: 1;
      padding-inline: clamp(24px, 6.5vw, 28px);
      justify-content: flex-end;
    }

    body.home-page #main-content .h-quote-left {
      order: 2;
      padding-inline: clamp(24px, 6.5vw, 28px);
      text-align: left;
    }

    body.home-page #main-content .h-quote-divider {
      display: none;
    }

    /* Hebrew sacred block — right-aligned, gathered. */
    body.home-page #main-content .h-sacred-block--mirror {
      margin-bottom: 0;
    }

    body.home-page #main-content .h-sacred-block--mirror .h-sacred-line--1 {
      font-size: clamp(1.1rem, 5vw, 1.3rem);
      line-height: 1.5;
      margin-bottom: 6px;
    }

    body.home-page #main-content .h-sacred-block--mirror .h-sacred-line--2 {
      font-size: clamp(.85rem, 3.8vw, 1rem);
      line-height: 1.7;
    }

    /* Gold reference — plain text, no border separator. */
    body.home-page #main-content .h-sacred-ref--mirror {
      margin-top: 8px;
      padding-top: 0;
      border-top: 0;
      font-size: 8px;
      letter-spacing: .22em;
    }

    /* Russian translation — no frame, no border, just readable text. */
    body.home-page #main-content .h-blockquote--mirror {
      padding: 0;
      border-left: 0;
      font-size: clamp(.92rem, 3.6vw, 1.06rem);
      line-height: 1.62;
      margin-bottom: 6px;
    }

    body.home-page #main-content .h-cite--mirror {
      padding-left: 0;
      font-size: 8px;
      letter-spacing: .22em;
    }
  }
</style>
