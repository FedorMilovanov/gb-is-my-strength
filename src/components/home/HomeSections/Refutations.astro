---
/**
 * Refutations.astro — apologetics shelf for /.
 *
 * The static slots own hit-testing. The approved V3 motion is applied to an
 * inner shell so the cards can cross without throwing the pointer out of the
 * hover area or flattening the neighbouring card's depth treatment.
 */
---
<section class="h-section h-reveal h-scroll-target" id="razbor" aria-labelledby="hRefutationsLabel">
  <h2 class="h-section-label" id="hRefutationsLabel">Разбор заблуждений</h2>
  <div class="h-section-accent" aria-hidden="true"></div>

  <div class="h-mobile-shelf-head">
    <div>
      <p class="h-mobile-shelf-head__kicker">Точный вход</p>
      <h3 class="h-mobile-shelf-head__title">Апологетические разборы</h3>
    </div>
  </div>

  <div class="h-articles-group">
    <ul class="h-article-list h-article-list--grid h-refutations-deck" data-refutations-active="" aria-label="Апологетические разборы">
      <!-- Код да Винчи -->
      <li class="h-refutation-slot h-refutation-slot--left" data-refutation-side="left">
        <div class="h-refutation-shell">
          <a href="articles/kod-da-vinchi/" class="h-article-card h-article-card--debunk h-refutation-card">
            <span class="h-refutation-ambient" aria-hidden="true"></span>
            <div class="h-refutation-inner">
              <div class="h-article-thumb">
                <picture>
                  <source srcset="images/hero-kod-da-vinchi.webp" type="image/webp">
                  <img src="images/hero-kod-da-vinchi.jpg"
                       alt=""
                       decoding="async" loading="lazy" width="160" height="108">
                </picture>
              </div>
              <div class="h-article-body">
                <div class="h-article-kicker h-article-kicker--warn">Исторические мифы</div>
                <h3 class="h-article-title">«Код да Винчи»: блестящий триллер или историческая подмена?</h3>
                <div class="h-article-meta">
                  <span class="h-meta-author">Редактор: Фёдор Милованов</span>
                  <span class="h-meta-sep" aria-hidden="true">·</span>
                  <span class="h-meta-time">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    30 мин
                  </span>
                  <span class="h-meta-tag h-meta-tag--warn">Апологетика</span>
                </div>
                <p class="h-article-abstract">Мария Магдалина, Никея, канон Нового Завета, Свитки Мёртвого моря, Наг-Хаммади, Приорат Сиона — полный разбор с позиций Писания и исторической науки.</p>
              </div>
            </div>
          </a>
        </div>
      </li>

      <!-- 20 антисоветов пастору -->
      <li class="h-refutation-slot h-refutation-slot--right" data-refutation-side="right">
        <div class="h-refutation-shell">
          <a href="articles/20-antisovetov-pastoru/" class="h-article-card h-article-card--debunk h-refutation-card">
            <span class="h-refutation-ambient" aria-hidden="true"></span>
            <div class="h-refutation-inner">
              <div class="h-article-thumb">
                <picture>
                  <source srcset="images/pastor-series/mirror-600w.webp" type="image/webp">
                  <img src="images/pastor-series/mirror.webp"
                       alt=""
                       decoding="async" loading="lazy" width="160" height="108">
                </picture>
              </div>
              <div class="h-article-body">
                <div class="h-article-kicker h-article-kicker--warn">Тёмная сторона кафедры</div>
                <h3 class="h-article-title">20 антисоветов, как пастору разрушить своё служение</h3>
                <div class="h-article-meta">
                  <span class="h-meta-author">Редактор: Фёдор Милованов</span>
                  <span class="h-meta-sep" aria-hidden="true">·</span>
                  <span class="h-meta-time">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    67 мин
                  </span>
                  <span class="h-meta-tag h-meta-tag--warn">Практика</span>
                </div>
                <p class="h-article-abstract">Практический и богословский разбор типичных ошибок пасторского служения — от первых перекосов сердца до авторитарной системы.</p>
              </div>
            </div>
          </a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style is:global>
  body.home-page #main-content #razbor .h-refutations-deck {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    overflow: visible;
    isolation: isolate;
    perspective: 1500px;
  }

  /* Static hit areas: the shells move, while pointer ownership stays stable. */
  body.home-page #main-content #razbor .h-refutation-slot {
    position: relative;
    min-width: 0;
    min-height: 184px;
    z-index: 2;
  }

  body.home-page #main-content #razbor .h-refutation-shell {
    position: absolute;
    inset: 0;
    z-index: 2;
    transform: translate3d(0, 0, 0) scale(1);
    transform-origin: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition:
      transform 820ms cubic-bezier(.16, .84, .24, 1.035),
      filter 560ms cubic-bezier(.22, 1, .36, 1),
      opacity 420ms ease;
  }

  /* Wide travelling floor shadow from the approved V3. */
  body.home-page #main-content #razbor .h-refutation-shell::before {
    content: "";
    position: absolute;
    z-index: -2;
    left: 8%;
    right: 8%;
    bottom: -18px;
    height: 38px;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(49, 36, 19, .20) 0%,
      rgba(49, 36, 19, .075) 43%,
      transparent 74%
    );
    filter: blur(12px);
    transform: translate3d(0, -5px, 0) scale(.78, .68);
    transition:
      opacity 260ms ease,
      transform 820ms cubic-bezier(.16, 1, .3, 1),
      filter 540ms ease;
  }

  /* Broad contact shadow follows the moving shell; it is never a fixed seam. */
  body.home-page #main-content #razbor .h-refutation-shell::after {
    content: "";
    position: absolute;
    z-index: -1;
    top: 4%;
    bottom: 4%;
    width: 92px;
    pointer-events: none;
    opacity: 0;
    filter: blur(13px);
    transform: translate3d(0, 4px, 0) scale(.72, .9);
    transition:
      opacity 210ms ease-out,
      transform 820ms cubic-bezier(.16, 1, .3, 1),
      filter 520ms ease;
  }

  body.home-page #main-content #razbor .h-refutation-slot--left .h-refutation-shell {
    transform-origin: 78% 54%;
  }

  body.home-page #main-content #razbor .h-refutation-slot--right .h-refutation-shell {
    transform-origin: 22% 54%;
  }

  body.home-page #main-content #razbor .h-refutation-slot--left .h-refutation-shell::after {
    right: -62px;
    background: radial-gradient(
      ellipse at 0 50%,
      rgba(43, 31, 17, .255) 0%,
      rgba(43, 31, 17, .11) 32%,
      rgba(43, 31, 17, .035) 52%,
      transparent 73%
    );
  }

  body.home-page #main-content #razbor .h-refutation-slot--right .h-refutation-shell::after {
    left: -62px;
    background: radial-gradient(
      ellipse at 100% 50%,
      rgba(43, 31, 17, .255) 0%,
      rgba(43, 31, 17, .11) 32%,
      rgba(43, 31, 17, .035) 52%,
      transparent 73%
    );
  }

  body.home-page #main-content #razbor .h-refutation-card {
    box-sizing: border-box;
    --refutation-image-x: 0px;
    --refutation-image-y: 0px;
    --refutation-light-x: 50%;
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 184px;
    padding: 14px 15px 15px;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--h-border);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, .88), rgba(255, 255, 255, .22) 47%, transparent 76%),
      var(--h-surface);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, .88),
      0 7px 19px -17px rgba(55, 42, 22, .16);
    transform: none;
    transition:
      box-shadow 680ms cubic-bezier(.22, 1, .36, 1),
      border-color 460ms ease,
      background-color 460ms ease,
      filter 460ms ease;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  body.home-page #main-content #razbor .h-refutation-slot--left .h-refutation-card {
    border-radius: 15px 13px 13px 15px;
  }

  body.home-page #main-content #razbor .h-refutation-slot--right .h-refutation-card {
    border-radius: 13px 15px 15px 13px;
  }

  /* One completed soft sheen pass across the active card. A single moving
     gold→cyan diagonal ramp + one faint radial bloom travels fully from off
     the left edge to off the right edge, fading in and back out to opacity:0
     so no bright band is left frozen on the card. No white peak, no
     mix-blend-mode. One shot per activation, restarted when the active card
     changes (scoped to the active selector). */
  body.home-page #main-content #razbor .h-refutation-card::before {
    content: "";
    position: absolute;
    z-index: 3;
    inset: -45% -20%;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(130% 80% at 30% 36%, color-mix(in srgb, var(--h-gold) 6%, transparent), transparent 74%),
      linear-gradient(
        108deg,
        transparent 33%,
        color-mix(in srgb, var(--h-gold) 5%, transparent) 40%,
        color-mix(in srgb, var(--h-gold) 10%, transparent) 45%,
        color-mix(in srgb, var(--h-accent) 12%, transparent) 50%,
        color-mix(in srgb, var(--h-gold) 10%, transparent) 55%,
        color-mix(in srgb, var(--h-gold) 5%, transparent) 60%,
        transparent 67%
      );
    transform: translate3d(-68%, 0, 0) rotate(2deg);
  }

  @keyframes h-refutation-sheen-pass {
    0% {
      transform: translate3d(-68%, 0, 0) rotate(2deg);
      opacity: 0;
    }
    18% {
      opacity: .28;
    }
    68% {
      opacity: .28;
    }
    100% {
      transform: translate3d(68%, 0, 0) rotate(2deg);
      opacity: 0;
    }
  }

  html.dark body.home-page #main-content #razbor .h-refutation-card::before {
    background:
      radial-gradient(130% 80% at 30% 36%, color-mix(in srgb, var(--h-gold) 8%, transparent), transparent 74%),
      linear-gradient(
        108deg,
        transparent 33%,
        color-mix(in srgb, var(--h-gold) 6%, transparent) 40%,
        color-mix(in srgb, var(--h-gold) 12%, transparent) 45%,
        color-mix(in srgb, var(--h-accent) 15%, transparent) 50%,
        color-mix(in srgb, var(--h-gold) 12%, transparent) 55%,
        color-mix(in srgb, var(--h-gold) 6%, transparent) 60%,
        transparent 67%
      );
  }

  body.home-page #main-content #razbor .h-refutation-card::after {
    content: none;
  }

  body.home-page #main-content #razbor .h-refutation-ambient {
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(270px 170px at var(--refutation-light-x) 10%, rgba(66, 196, 213, .105), transparent 70%),
      radial-gradient(260px 170px at 50% 110%, rgba(154, 109, 46, .075), transparent 68%);
    transition: opacity 520ms ease;
  }

  body.home-page #main-content #razbor .h-refutation-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 89px minmax(0, 1fr);
    gap: 13px;
    min-height: 100%;
    opacity: 1;
    transition: opacity 420ms ease;
  }

  body.home-page #main-content #razbor .h-refutation-card .h-article-thumb {
    width: 89px;
    height: 68px;
    min-width: 89px;
    flex: none;
    margin-top: 0;
    overflow: hidden;
    border-radius: 10px;
    background: color-mix(in srgb, var(--h-surface) 82%, #d7cab6);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, .75),
      0 5px 14px rgba(47, 35, 17, .08);
    transform: translate3d(var(--refutation-image-x), var(--refutation-image-y), 0);
    transition:
      transform 760ms cubic-bezier(.22, 1, .36, 1),
      box-shadow 620ms ease;
  }

  body.home-page #main-content #razbor .h-refutation-card .h-article-thumb picture,
  body.home-page #main-content #razbor .h-refutation-card .h-article-thumb img {
    display: block;
    width: 100%;
    height: 100%;
  }

  body.home-page #main-content #razbor .h-refutation-card .h-article-thumb img {
    object-fit: cover;
    transform: scale(1.015);
    transition:
      transform 1050ms cubic-bezier(.22, 1, .36, 1),
      filter 620ms ease;
  }

  body.home-page #main-content #razbor .h-refutation-card .h-article-body {
    min-width: 0;
    padding-top: 1px;
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right {
    z-index: 8;
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--right,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--left {
    z-index: 1;
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left .h-refutation-shell {
    transform: translate3d(18px, -8px, 0);
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--right .h-refutation-shell {
    transform: translate3d(4px, 5px, 0);
    filter: saturate(.935) brightness(.992);
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right .h-refutation-shell {
    transform: translate3d(-18px, -8px, 0);
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--left .h-refutation-shell {
    transform: translate3d(-4px, 5px, 0);
    filter: saturate(.935) brightness(.992);
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left .h-refutation-shell::before,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right .h-refutation-shell::before {
    opacity: .74;
    filter: blur(12px);
    transform: translate3d(0, 2px, 0) scale(1.03, .86);
    transition-delay: 70ms, 0ms, 0ms;
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left .h-refutation-shell::after,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right .h-refutation-shell::after {
    opacity: .72;
    filter: blur(13px);
    transform: translate3d(0, 5px, 0) scale(1, .96);
    transition-delay: 95ms, 0ms, 0ms;
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-switching="1"] .h-refutation-shell::before,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-switching="1"] .h-refutation-shell::after {
    opacity: 0;
    transition-duration: 70ms;
    transition-delay: 0ms;
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left .h-refutation-card,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right .h-refutation-card {
    border-color: color-mix(in srgb, var(--h-accent) 38%, var(--h-border));
    background-color: var(--h-surface-solid);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, .9),
      0 20px 46px rgba(55, 42, 22, .115),
      0 7px 18px rgba(55, 42, 22, .06),
      0 0 0 1px rgba(66, 196, 213, .025);
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--right .h-refutation-card,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--left .h-refutation-card {
    border-color: color-mix(in srgb, var(--h-border) 82%, transparent);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, .62),
      0 6px 17px -16px rgba(55, 42, 22, .12);
    filter: contrast(.995);
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left .h-refutation-card::before,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right .h-refutation-card::before {
    animation: h-refutation-sheen-pass 1250ms cubic-bezier(.22, 1, .36, 1) both;
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left .h-refutation-ambient,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right .h-refutation-ambient {
    opacity: .5;
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left .h-article-thumb,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right .h-article-thumb {
    transform: translate3d(
      var(--refutation-image-x),
      calc(var(--refutation-image-y) - 2px),
      0
    ) scale(1.018);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, .8),
      0 11px 22px rgba(47, 35, 17, .13);
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left .h-article-thumb img,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right .h-article-thumb img {
    transform: scale(1.075);
    filter: saturate(1.04) contrast(1.015);
  }

  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--right .h-refutation-inner,
  body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--left .h-refutation-inner {
    opacity: .89;
  }

  html.dark body.home-page #main-content #razbor .h-refutation-shell::before {
    background: radial-gradient(
      ellipse at center,
      rgba(0, 0, 0, .58) 0%,
      rgba(0, 0, 0, .21) 43%,
      transparent 74%
    );
  }

  html.dark body.home-page #main-content #razbor .h-refutation-slot--left .h-refutation-shell::after {
    background: radial-gradient(
      ellipse at 0 50%,
      rgba(0, 0, 0, .7) 0%,
      rgba(0, 0, 0, .34) 35%,
      rgba(0, 0, 0, .1) 55%,
      transparent 75%
    );
  }

  html.dark body.home-page #main-content #razbor .h-refutation-slot--right .h-refutation-shell::after {
    background: radial-gradient(
      ellipse at 100% 50%,
      rgba(0, 0, 0, .7) 0%,
      rgba(0, 0, 0, .34) 35%,
      rgba(0, 0, 0, .1) 55%,
      transparent 75%
    );
  }

  html.dark body.home-page #main-content #razbor .h-refutation-card {
    border-color: rgba(199, 154, 88, .17);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, .045), transparent 48%),
      linear-gradient(150deg, rgba(18, 31, 33, .93), rgba(7, 14, 16, .94));
    box-shadow:
      inset 0 1px rgba(255, 255, 255, .035),
      0 14px 34px -28px rgba(0, 0, 0, .94);
  }

  html.dark body.home-page #main-content #razbor .h-refutation-ambient {
    background:
      radial-gradient(300px 170px at var(--refutation-light-x) -8%, rgba(66, 196, 213, .12), transparent 72%),
      radial-gradient(280px 170px at 50% 112%, rgba(199, 154, 88, .065), transparent 70%);
  }

  html.dark body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left .h-refutation-card,
  html.dark body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right .h-refutation-card {
    border-color: color-mix(in srgb, var(--h-accent) 38%, var(--h-border-strong));
    background:
      linear-gradient(145deg, rgba(255, 255, 255, .055), transparent 48%),
      linear-gradient(150deg, rgba(18, 35, 37, .99), rgba(7, 17, 19, .99));
    box-shadow:
      inset 0 1px rgba(255, 255, 255, .05),
      0 29px 62px -34px rgba(0, 0, 0, .98),
      0 9px 22px -15px rgba(0, 0, 0, .88),
      0 0 0 1px rgba(66, 196, 213, .04);
  }

  html.dark body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--right .h-refutation-card,
  html.dark body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--left .h-refutation-card {
    border-color: rgba(199, 154, 88, .11);
    filter: saturate(.9) brightness(.93);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, .025),
      0 12px 30px -26px rgba(0, 0, 0, .92);
  }

  @media (max-width: 760px) {
    body.home-page #main-content #razbor .h-refutations-deck {
      grid-template-columns: 1fr;
      gap: 12px;
      perspective: none;
    }

    body.home-page #main-content #razbor .h-refutation-slot {
      min-height: 188px;
    }

    body.home-page #main-content #razbor .h-refutation-shell {
      position: absolute;
    }

    body.home-page #main-content #razbor .h-refutation-slot--left .h-refutation-card,
    body.home-page #main-content #razbor .h-refutation-slot--right .h-refutation-card {
      min-height: 188px;
      border-radius: 15px;
    }

    body.home-page #main-content #razbor .h-refutation-shell::before,
    body.home-page #main-content #razbor .h-refutation-shell::after {
      display: none;
    }

    body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left .h-refutation-shell,
    body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right .h-refutation-shell {
      transform: translate3d(0, -7px, 0);
    }

    body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--right .h-refutation-shell,
    body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--left .h-refutation-shell {
      transform: translate3d(0, 4px, 0);
    }
  }

  @media (max-width: 460px) {
    body.home-page #main-content #razbor .h-refutation-slot,
    body.home-page #main-content #razbor .h-refutation-card {
      min-height: 224px;
    }

    body.home-page #main-content #razbor .h-refutation-card {
      padding: 13px;
    }

    body.home-page #main-content #razbor .h-refutation-inner {
      grid-template-columns: 78px minmax(0, 1fr);
      gap: 11px;
    }

    body.home-page #main-content #razbor .h-refutation-card .h-article-thumb {
      width: 78px;
      height: 60px;
      min-width: 78px;
    }
  }

  @media (forced-colors: active) {
    body.home-page #main-content #razbor .h-refutation-card {
      border-color: CanvasText;
      background: Canvas;
      color: CanvasText;
      box-shadow: none;
    }

    body.home-page #main-content #razbor .h-refutation-shell::before,
    body.home-page #main-content #razbor .h-refutation-shell::after,
    body.home-page #main-content #razbor .h-refutation-card::before,
    body.home-page #main-content #razbor .h-refutation-ambient {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body.home-page #main-content #razbor .h-refutation-shell,
    body.home-page #main-content #razbor .h-refutation-shell::before,
    body.home-page #main-content #razbor .h-refutation-shell::after,
    body.home-page #main-content #razbor .h-refutation-card,
    body.home-page #main-content #razbor .h-refutation-card::before,
    body.home-page #main-content #razbor .h-refutation-ambient,
    body.home-page #main-content #razbor .h-refutation-inner,
    body.home-page #main-content #razbor .h-article-thumb,
    body.home-page #main-content #razbor .h-article-thumb img {
      transition: none;
      animation: none;
    }

    body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--left .h-refutation-shell,
    body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--right .h-refutation-shell {
      transform: translate3d(0, -2px, 0);
    }

    body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="left"] .h-refutation-slot--right .h-refutation-shell,
    body.home-page #main-content #razbor .h-refutations-deck[data-refutations-active="right"] .h-refutation-slot--left .h-refutation-shell {
      transform: none;
      opacity: .92;
      filter: none;
    }

    body.home-page #main-content #razbor .h-refutation-shell::before,
    body.home-page #main-content #razbor .h-refutation-shell::after {
      display: none;
    }

    body.home-page #main-content #razbor .h-refutation-card,
    body.home-page #main-content #razbor .h-article-thumb,
    body.home-page #main-content #razbor .h-article-thumb img {
      transform: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const deck = document.querySelector('#razbor .h-refutations-deck');
    if (!deck || deck.dataset.refutationsMotionReady === '1') return;
    deck.dataset.refutationsMotionReady = '1';

    const slots = Array.from(deck.querySelectorAll('.h-refutation-slot'));
    const coarsePointer = window.matchMedia('(hover: none), (pointer: coarse)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeSide = '';
    let pinnedSide = '';
    let enterTimer = 0;
    let leaveTimer = 0;
    let switchTimer = 0;
    let layerTimer = 0;
    let frame = 0;
    const removers = [];

    const on = (target, type, handler, options) => {
      target.addEventListener(type, handler, options);
      removers.push(() => target.removeEventListener(type, handler, options));
    };

    const clearTimers = () => {
      window.clearTimeout(enterTimer);
      window.clearTimeout(leaveTimer);
      window.clearTimeout(switchTimer);
      window.clearTimeout(layerTimer);
      window.cancelAnimationFrame(frame);
    };

    const setLayerHints = (enabled) => {
      slots.forEach((slot) => {
        const shell = slot.querySelector('.h-refutation-shell');
        const card = slot.querySelector('.h-refutation-card');
        const image = slot.querySelector('.h-article-thumb img');
        if (shell) shell.style.willChange = enabled ? 'transform' : '';
        if (card) card.style.willChange = enabled ? 'box-shadow' : '';
        if (image) image.style.willChange = enabled ? 'transform' : '';
      });
    };

    const clearLayerHintsLater = () => {
      window.clearTimeout(layerTimer);
      layerTimer = window.setTimeout(() => setLayerHints(false), 1000);
    };

    const resetImage = (slot) => {
      const card = slot.querySelector('.h-refutation-card');
      if (!card) return;
      card.style.setProperty('--refutation-image-x', '0px');
      card.style.setProperty('--refutation-image-y', '0px');
      card.style.setProperty('--refutation-light-x', '50%');
    };

    const setActive = (side, { pinned = false } = {}) => {
      window.clearTimeout(enterTimer);
      window.clearTimeout(leaveTimer);
      const nextSide = side || '';
      const switching = Boolean(activeSide && nextSide && activeSide !== nextSide);

      if (switching && !reducedMotion.matches) {
        deck.dataset.refutationsSwitching = '1';
        window.clearTimeout(switchTimer);
        switchTimer = window.setTimeout(() => {
          delete deck.dataset.refutationsSwitching;
        }, 118);
      } else if (!switching) {
        delete deck.dataset.refutationsSwitching;
      }

      activeSide = nextSide;
      if (pinned) pinnedSide = activeSide;
      deck.dataset.refutationsActive = activeSide;
      slots.forEach((slot) => {
        slot.toggleAttribute('data-refutation-active', slot.dataset.refutationSide === activeSide);
      });
      setLayerHints(Boolean(activeSide));
      clearLayerHintsLater();
    };

    const clearActive = ({ keepPinned = true } = {}) => {
      if (keepPinned && pinnedSide) {
        setActive(pinnedSide);
        return;
      }

      activeSide = '';
      if (!keepPinned) pinnedSide = '';
      deck.dataset.refutationsActive = '';
      delete deck.dataset.refutationsSwitching;
      slots.forEach((slot) => {
        slot.removeAttribute('data-refutation-active');
        resetImage(slot);
      });
      clearLayerHintsLater();
    };

    slots.forEach((slot) => {
      const side = slot.dataset.refutationSide || '';
      const card = slot.querySelector('.h-refutation-card');
      if (!card || !side) return;

      const handlePointerEnter = (event) => {
        if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
        window.clearTimeout(leaveTimer);
        window.clearTimeout(enterTimer);
        enterTimer = window.setTimeout(() => setActive(side), activeSide ? 18 : 28);
      };

      const handlePointerLeave = (event) => {
        if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
        window.clearTimeout(enterTimer);
        window.clearTimeout(leaveTimer);
        leaveTimer = window.setTimeout(() => {
          if (!slot.matches(':focus-within')) clearActive();
        }, 128);
      };

      const handlePointerMove = (event) => {
        if ((event.pointerType !== 'mouse' && event.pointerType !== 'pen')
          || activeSide !== side
          || reducedMotion.matches) return;

        const rect = slot.getBoundingClientRect();
        const nx = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width - .5) * 2));
        const ny = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height - .5) * 2));

        window.cancelAnimationFrame(frame);
        frame = window.requestAnimationFrame(() => {
          card.style.setProperty('--refutation-image-x', `${(nx * 1.6).toFixed(2)}px`);
          card.style.setProperty('--refutation-image-y', `${(ny * 1.2).toFixed(2)}px`);
          card.style.setProperty('--refutation-light-x', `${((nx + 1) * 50).toFixed(1)}%`);
        });
      };

      const handlePointerOut = (event) => {
        const related = event.relatedTarget;
        if (related instanceof Node && slot.contains(related)) return;
        resetImage(slot);
      };

      const handleFocus = () => setActive(side);
      const handleBlur = () => {
        window.setTimeout(() => {
          if (!deck.matches(':focus-within')) clearActive();
        }, 0);
      };

      const handleClick = (event) => {
        if (!coarsePointer.matches || event.detail === 0) return;
        if (pinnedSide === side) return;

        event.preventDefault();
        pinnedSide = side;
        setActive(side, { pinned: true });
      };

      on(slot, 'pointerenter', handlePointerEnter);
      on(slot, 'pointerleave', handlePointerLeave);
      on(slot, 'pointermove', handlePointerMove);
      on(slot, 'pointerout', handlePointerOut);
      on(card, 'focus', handleFocus);
      on(card, 'blur', handleBlur);
      on(card, 'click', handleClick);
    });

    const handleOutsidePointer = (event) => {
      const target = event.target instanceof Node ? event.target : null;
      if (target && !deck.contains(target) && pinnedSide) clearActive({ keepPinned: false });
    };

    const handleEscape = (event) => {
      if (event.key !== 'Escape') return;
      clearActive({ keepPinned: false });
      const focused = deck.querySelector(':focus');
      if (focused instanceof HTMLElement) focused.blur();
    };

    const handleWindowBlur = () => {
      if (!pinnedSide) clearActive({ keepPinned: false });
    };

    const handleVisibility = () => {
      if (document.visibilityState === 'hidden' && !pinnedSide) {
        clearActive({ keepPinned: false });
      }
    };

    const cleanup = () => {
      clearTimers();
      activeSide = '';
      pinnedSide = '';
      deck.dataset.refutationsActive = '';
      delete deck.dataset.refutationsSwitching;
      slots.forEach((slot) => {
        slot.removeAttribute('data-refutation-active');
        resetImage(slot);
      });
      setLayerHints(false);
      removers.splice(0).forEach((remove) => remove());
    };

    on(document, 'pointerdown', handleOutsidePointer);
    on(document, 'keydown', handleEscape);
    on(window, 'blur', handleWindowBlur);
    on(document, 'visibilitychange', handleVisibility);
    on(window, 'pagehide', cleanup, { once: true });
  })();
</script>
