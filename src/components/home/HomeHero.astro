---
/**
 * HomeHero.astro — sacred native hero for /.
 *
 * The component is the sole owner of hero layout, Habakkuk interaction and
 * responsive behavior. Navigation, gateway and publication styles live with
 * their own route components.
 */
import HomeAmbientPhrases from './HomeAmbientPhrases.astro';
---

<HomeAmbientPhrases />

<section class="h-hero" aria-label="Главный заголовок">
  <div class="h-hero-brand">
    <span class="h-hero-brand__rule" aria-hidden="true"><i></i></span>
    <span class="h-hero-brand__copy">
      <span>Богословская библиотека</span>
      <strong>Для вдумчивого изучения Писания</strong>
    </span>
  </div>

  <div class="h-sacred-block h-sacred-block--hero" role="group" aria-label="Интерактивный текст Аввакума 3:19. Нажмите на еврейское слово, чтобы увидеть перевод.">
    <span class="h-sacred-line h-sacred-line--1">
      <button class="h-sacred-word h-sacred-word--name" type="button" disabled aria-pressed="false" aria-label="יְהוִה — показать чтение имени">
        <span class="h-sacred-name-label" aria-hidden="true">Священное Имя Бога</span>
        <span class="h-sacred-face h-sacred-face--front" lang="he">יְהוִה</span>
        <span class="h-sacred-face h-sacred-face--back h-sacred-face--name" aria-hidden="true"><span class="h-sacred-name">Яхве</span></span>
      </button>
      <button class="h-sacred-word" type="button" disabled aria-pressed="false" aria-label="אֲדֹנָי — показать перевод: Господь">
        <span class="h-sacred-face h-sacred-face--front" lang="he">אֲדֹנָי</span><span class="h-sacred-face h-sacred-face--back" aria-hidden="true">Господь</span>
      </button>
      <button class="h-sacred-word" type="button" disabled aria-pressed="false" aria-label="חֵילִי — показать перевод: сила моя">
        <span class="h-sacred-face h-sacred-face--front" lang="he">חֵילִי</span><span class="h-sacred-face h-sacred-face--back" aria-hidden="true">сила моя</span>
      </button>
    </span>

    <span class="h-sacred-line h-sacred-line--2">
      <button class="h-sacred-word" type="button" disabled aria-pressed="false" aria-label="וַיָּשֶׂם — показать перевод: и сделает">
        <span class="h-sacred-face h-sacred-face--front" lang="he">וַיָּשֶׂם</span><span class="h-sacred-face h-sacred-face--back" aria-hidden="true">и сделает</span>
      </button>
      <button class="h-sacred-word" type="button" disabled aria-pressed="false" aria-label="רַגְלַי — показать перевод: ноги мои">
        <span class="h-sacred-face h-sacred-face--front" lang="he">רַגְלַי</span><span class="h-sacred-face h-sacred-face--back" aria-hidden="true">ноги мои</span>
      </button>
      <button class="h-sacred-word" type="button" disabled aria-pressed="false" aria-label="כָּאַיָּלוֹת — показать перевод: как у ланей">
        <span class="h-sacred-face h-sacred-face--front" lang="he">כָּאַיָּלוֹת</span><span class="h-sacred-face h-sacred-face--back" aria-hidden="true">как у ланей</span>
      </button>
      <button class="h-sacred-word" type="button" disabled aria-pressed="false" aria-label="וְעַל — показать перевод: и на">
        <span class="h-sacred-face h-sacred-face--front" lang="he">וְעַל</span><span class="h-sacred-face h-sacred-face--back" aria-hidden="true">и на</span>
      </button>
      <button class="h-sacred-word" type="button" disabled aria-pressed="false" aria-label="בָּמוֹתַי — показать перевод: высоты мои">
        <span class="h-sacred-face h-sacred-face--front" lang="he">בָּמוֹתַי</span><span class="h-sacred-face h-sacred-face--back" aria-hidden="true">высоты мои</span>
      </button>
      <button class="h-sacred-word" type="button" disabled aria-pressed="false" aria-label="יַדְרִכֵנִי — показать перевод: даст мне ступать">
        <span class="h-sacred-face h-sacred-face--front" lang="he">יַדְרִכֵנִי</span><span class="h-sacred-face h-sacred-face--back" aria-hidden="true">даст мне ступать</span>
      </button>
    </span>

    <span class="h-sacred-ref"><span>Аввакум 3:19</span></span>
  </div>
  <p class="sr-only">Девиз проекта — Аввакум 3:19: «Господь Бог — сила моя; Он сделает ноги мои как у оленя и на высоты мои возведёт меня».</p>

  <p class="h-hero-tagline">Для изучения Писания</p>
  <h1 class="h-hero-title" tabindex="-1">
    <span class="h-home-title-part h-home-title__static">Господь Бог</span> <span class="h-home-title-part h-home-title__dash" aria-hidden="true">—</span> <span class="h-home-title-part h-home-title__accent">Сила Моя</span>
  </h1>
  <p class="h-hero-desc">Экзегеза, богословие, апологетика, переводы и история Церкви — в единой библиотеке для медленного чтения и честного исследования.</p>

  <div class="h-hero-search-wrap" role="search" aria-label="Поиск по материалам сайта">
    <a class="h-hero-search" id="heroSearchBar" href="/articles/" aria-label="Открыть поиск по материалам сайта" data-action="open-search">
      <svg class="h-hero-search__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span class="h-hero-search__placeholder">Что вы хотите изучить?</span>
      <span class="h-hero-search__action" aria-hidden="true">Найти</span>
      <span class="h-hero-search__kbd" aria-hidden="true"><kbd data-search-shortcut-modifier>Ctrl</kbd><kbd>K</kbd></span>
    </a>
  </div>

  <div class="h-hero-cues" role="list" aria-label="Особенности библиотеки">
    <span role="listitem">Оригинальные языки</span>
    <span role="listitem">Проверяемые источники</span>
    <span role="listitem">Исторический контекст</span>
  </div>

  <hr class="h-rule" aria-hidden="true" />
</section>

<script is:inline>
  (() => {
    const block = document.querySelector('.h-sacred-block--hero');
    if (!block || block.dataset.sacredOwnerReady === '1') return;
    block.dataset.sacredOwnerReady = '1';

    const words = Array.from(block.querySelectorAll('button.h-sacred-word'));
    if (!words.length) return;

    const reset = (except = null) => {
      words.forEach((word) => {
        const pinned = word === except;
        word.toggleAttribute('data-sacred-pinned', pinned);
        word.setAttribute('aria-pressed', pinned ? 'true' : 'false');
      });
    };

    const measure = () => {
      words.forEach((word) => {
        const front = word.querySelector('.h-sacred-face--front');
        const back = word.querySelector('.h-sacred-face--back');
        if (!(front instanceof HTMLElement) || !(back instanceof HTMLElement)) return;

        const frontWidth = Math.ceil(front.getBoundingClientRect().width + 2);
        const backWidth = Math.ceil(back.getBoundingClientRect().width + 4);
        word.style.setProperty('--sacred-closed-w', `${frontWidth}px`);
        word.style.setProperty('--sacred-open-w', `${Math.max(frontWidth, backWidth)}px`);
      });
    };

    words.forEach((word) => {
      word.disabled = false;
      word.addEventListener('click', (event) => {
        event.preventDefault();
        reset(word.hasAttribute('data-sacred-pinned') ? null : word);
      });
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !block.contains(event.target)) reset();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') reset();
    });
    window.addEventListener('resize', measure, { passive: true });
    document.fonts?.ready.then(measure).catch(measure);
    reset();
    measure();
  })();
</script>

<style is:global>
  body.home-page #main-content .h-hero {
    position: relative;
    min-height: min(900px, 92svh);
    justify-content: center;
    padding: clamp(116px, 9vw, 146px) 0 clamp(68px, 6.5vw, 88px);
    text-align: center;
  }

  body.home-page #main-content .h-hero::after {
    content: "";
    position: absolute;
    width: min(74vw, 850px);
    height: min(74vw, 850px);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -49%);
    border-radius: 50%;
    background: radial-gradient(circle, var(--h-glow), transparent 68%);
    filter: blur(28px);
    opacity: .44;
    pointer-events: none;
  }

  body.home-page #main-content .h-hero > * {
    position: relative;
    z-index: 1;
  }

  body.home-page #main-content .h-hero-brand {
    position: absolute;
    top: clamp(112px, 8.8vw, 136px);
    left: 0;
    width: 224px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 0;
    border: 0;
    text-align: left;
  }

  body.home-page #main-content .h-hero-brand__rule {
    position: relative;
    width: 18px;
    height: 58px;
    flex: 0 0 18px;
    border-left: 1px solid var(--h-border-strong);
  }

  body.home-page #main-content .h-hero-brand__rule::before,
  body.home-page #main-content .h-hero-brand__rule::after {
    content: "";
    position: absolute;
    left: -3px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  body.home-page #main-content .h-hero-brand__rule::before {
    top: 0;
    background: var(--h-gold);
    box-shadow: 0 0 18px rgba(170, 119, 45, .2);
  }

  body.home-page #main-content .h-hero-brand__rule::after {
    bottom: 0;
    background: var(--h-accent);
    box-shadow: 0 0 18px var(--h-glow);
  }

  body.home-page #main-content .h-hero-brand__copy { padding-top: 1px; }

  body.home-page #main-content .h-hero-brand__copy span,
  body.home-page #main-content .h-hero-brand__copy strong { display: block; }

  body.home-page #main-content .h-hero-brand__copy span {
    margin-bottom: 5px;
    color: var(--h-accent);
    font-family: var(--f-ui);
    font-size: 8px;
    font-weight: 760;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  body.home-page #main-content .h-hero-brand__copy strong {
    color: var(--h-muted);
    font-family: var(--f-body);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.45;
  }

  body.home-page #main-content .h-sacred-block--hero {
    --sacred-flip-ms: 620ms;
    --sacred-silk: cubic-bezier(.22, 1, .36, 1);
    width: min(100%, 780px);
    margin: 0 auto clamp(34px, 4.3vw, 52px);
  }

  body.home-page #main-content .h-sacred-block--hero::before {
    content: "нажмите на слово — перевод откроется на месте";
    margin-bottom: 20px;
    color: var(--h-muted);
    font-size: 8px;
    letter-spacing: .2em;
    opacity: .88;
  }

  body.home-page #main-content .h-sacred-line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: nowrap;
    gap: .18em;
    direction: rtl;
    color: var(--h-heading);
    font-family: var(--f-hebrew, "Noto Serif Hebrew", "Noto Sans Hebrew", serif);
    font-weight: 500;
    line-height: 1.62;
    text-shadow: 0 0 32px rgba(7, 125, 145, .08);
  }

  body.home-page #main-content .h-sacred-line--1 {
    margin-bottom: 18px;
  }

  html.dark body.home-page #main-content .h-sacred-line {
    text-shadow: 0 0 36px rgba(66, 196, 213, .1);
  }

  body.home-page #main-content .h-sacred-word {
    --sacred-closed-w: auto;
    --sacred-open-w: auto;
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    display: inline-grid;
    grid-template-areas: "face";
    flex: 0 0 auto;
    width: var(--sacred-closed-w);
    min-width: 0;
    margin: 0 .04em;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    line-height: inherit;
    vertical-align: baseline;
    cursor: pointer;
    isolation: isolate;
    perspective: 560px;
    outline: none;
    transition: width var(--sacred-flip-ms) var(--sacred-silk) 150ms, filter .35s ease;
    -webkit-tap-highlight-color: transparent;
  }

  body.home-page #main-content .h-sacred-word:is(:hover, :focus-visible, [data-sacred-pinned]) {
    width: var(--sacred-open-w);
    transition-delay: 0ms, 0ms;
    z-index: 4;
  }

  body.home-page #main-content .h-sacred-face {
    grid-area: face;
    align-self: center;
    justify-self: center;
    display: inline-block;
    white-space: nowrap;
    transform-origin: 50% 56%;
    backface-visibility: hidden;
    -webkit-font-smoothing: antialiased;
    transition:
      transform var(--sacred-flip-ms) var(--sacred-silk),
      opacity 420ms ease,
      filter 480ms var(--sacred-silk);
    will-change: transform, opacity;
  }

  body.home-page #main-content .h-sacred-face--front {
    color: var(--h-heading);
    font-family: var(--f-hebrew, "Noto Serif Hebrew", "Noto Sans Hebrew", serif);
    font-style: normal;
    font-weight: inherit;
    opacity: .96;
    transform: translate3d(0, 0, 0) rotateX(0deg) rotateZ(0deg) scale(1);
    filter: blur(0);
  }

  body.home-page #main-content .h-sacred-face--back {
    direction: ltr;
    color: var(--h-heading);
    font-family: var(--f-body);
    font-size: .56em;
    font-style: italic;
    font-weight: 700;
    line-height: 1;
    opacity: 0;
    transform: translate3d(0, .08em, 0) rotateX(16deg) rotateZ(7deg) scale(.86);
    filter: blur(1.8px);
    text-shadow: 0 2px 12px rgba(23, 28, 29, .08);
    pointer-events: none;
  }

  body.home-page #main-content .h-sacred-word:is(:hover, :focus-visible, [data-sacred-pinned]) .h-sacred-face--front {
    opacity: 0;
    transform: translate3d(0, -.07em, 0) rotateX(-16deg) rotateZ(-7deg) scale(.86);
    filter: blur(1.5px);
    transition-delay: 24ms, 18ms, 18ms;
  }

  body.home-page #main-content .h-sacred-word:is(:hover, :focus-visible, [data-sacred-pinned]) .h-sacred-face--back {
    opacity: 1;
    transform: translate3d(0, 0, 0) rotateX(0deg) rotateZ(0deg) scale(1);
    filter: blur(0);
    transition-delay: 110ms, 120ms, 100ms;
  }

  body.home-page #main-content .h-sacred-word:focus-visible {
    border-radius: 4px;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--h-accent) 58%, transparent),
      0 0 0 5px color-mix(in srgb, var(--h-accent) 10%, transparent);
  }

  body.home-page #main-content .h-sacred-word--name {
    margin-inline: .08em;
    font-weight: 900;
  }

  body.home-page #main-content .h-sacred-word--name .h-sacred-face--back {
    font-size: .76em;
  }

  body.home-page #main-content .h-sacred-name-label {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: calc(100% - .72em);
    direction: ltr;
    white-space: nowrap;
    color: var(--h-muted);
    font-family: var(--f-ui);
    font-size: clamp(7px, .72vw, 10px);
    font-style: normal;
    font-weight: 700;
    letter-spacing: .22em;
    line-height: 1;
    text-transform: uppercase;
    opacity: 0;
    transform: translate3d(-50%, 16px, 0);
    filter: blur(4px);
    pointer-events: none;
    transition:
      opacity 980ms ease 430ms,
      transform 1120ms var(--sacred-silk) 390ms,
      filter 900ms var(--sacred-silk) 420ms,
      letter-spacing 1180ms var(--sacred-silk) 400ms;
  }

  body.home-page #main-content .h-sacred-word--name:is(:hover, :focus-visible, [data-sacred-pinned]) .h-sacred-name-label {
    opacity: .88;
    transform: translate3d(-50%, 7px, 0);
    filter: blur(0);
    letter-spacing: .28em;
  }

  body.home-page #main-content .h-sacred-ref {
    color: var(--h-gold);
    opacity: 1;
  }

  body.home-page #main-content .h-hero-tagline {
    display: block;
    visibility: visible;
    margin-bottom: 14px;
    color: var(--h-accent);
    font-size: 9px;
    letter-spacing: .38em;
    opacity: 1;
    transform: none;
    animation: none;
  }

  body.home-page #main-content .h-hero-title {
    display: block;
    visibility: visible;
    margin: 0 auto 20px;
    color: var(--h-heading);
    font-size: clamp(3.5rem, 5.65vw, 5.25rem);
    line-height: 1;
    letter-spacing: -.045em;
    text-wrap: balance;
    opacity: 1;
    transform: none;
    animation: none;
  }

  body.home-page #main-content .h-home-title-part {
    display: inline-block;
    transform-origin: 50% 68%;
    transform: translate3d(0, 0, 0) scale(1, 1) rotate(0deg);
    transition:
      transform 860ms cubic-bezier(.24, 1.18, .36, 1),
      text-shadow 760ms cubic-bezier(.22, 1, .36, 1),
      opacity 680ms ease;
    will-change: transform;
  }

  body.home-page #main-content .h-home-title__static { color: var(--h-heading); }
  body.home-page #main-content .h-home-title__dash {
    margin: 0 .23em;
    color: var(--h-gold);
    opacity: .82;
    transform-origin: center;
  }
  body.home-page #main-content .h-home-title__accent {
    color: var(--h-gold);
    font-style: italic;
  }

  @media (hover: hover) and (pointer: fine) {
    body.home-page #main-content .h-hero-title:hover .h-home-title__static {
      opacity: .992;
      transform: translate3d(-.008em, -.004em, 0) scale(1.001, 1.006) rotate(.025deg);
    }

    body.home-page #main-content .h-hero-title:hover .h-home-title__dash {
      opacity: .88;
      transform: translate3d(0, -.007em, 0) scale(1.085, .995);
    }

    body.home-page #main-content .h-hero-title:hover .h-home-title__accent {
      transform: translate3d(.012em, -.012em, 0) scale(1.018, 1.008) rotate(-.07deg);
      text-shadow: 0 10px 34px rgba(167, 117, 47, .12);
    }
  }

  body.home-page #main-content .h-hero-desc {
    display: block;
    visibility: visible;
    max-width: 710px;
    color: var(--h-muted);
    font-size: clamp(1.02rem, 1.45vw, 1.22rem);
    line-height: 1.72;
    opacity: 1;
    transform: none;
    animation: none;
  }

  body.home-page #main-content .h-hero-search-wrap {
    display: block;
    visibility: visible;
    width: min(100%, 820px);
    margin-top: 34px;
    opacity: 1;
    transform: none;
    animation: none;
  }

  body.home-page #main-content .h-hero-search {
    width: 100%;
    min-height: 68px;
    display: flex;
    align-items: center;
    padding: 0 20px 0 24px;
    border: 1px solid var(--h-border-strong);
    border-radius: 15px;
    background: color-mix(in srgb, var(--h-surface-solid) 84%, transparent);
    box-shadow: var(--h-shadow), inset 0 1px rgba(255, 255, 255, .45);
    color: var(--h-heading);
    text-decoration: none;
  }

  html.dark body.home-page #main-content .h-hero-search {
    background: rgba(9, 16, 18, .82);
    box-shadow: var(--h-shadow), 0 0 48px -32px var(--h-accent), inset 0 1px rgba(255, 255, 255, .04);
  }

  body.home-page #main-content .h-hero-search__icon { flex: 0 0 auto; color: var(--h-accent); }

  body.home-page #main-content .h-hero-search__placeholder {
    min-width: 0;
    color: var(--h-muted);
    font-family: var(--f-body);
    font-size: clamp(16px, 1.7vw, 20px);
  }

  body.home-page #main-content .h-hero-search__action {
    margin-left: auto;
    padding-left: 20px;
    border-left: 1px solid var(--h-border);
    color: var(--h-accent);
    font-family: var(--f-ui);
    font-size: 11px;
    font-weight: 740;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  body.home-page #main-content .h-hero-search__kbd { margin-left: 14px; }

  body.home-page #main-content .h-hero-search:is(:hover, :focus-visible) {
    border-color: var(--h-accent);
    background: var(--h-surface-solid);
    box-shadow: 0 0 0 4px var(--h-accent-soft), 0 28px 72px -44px rgba(5, 93, 109, .5);
  }

  html.dark body.home-page #main-content .h-hero-search:is(:hover, :focus-visible) { background: #0c1719; }

  body.home-page #main-content .h-hero-cues {
    margin-top: 22px;
    color: var(--h-muted);
    font-size: 9px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  body.home-page #main-content .h-hero-cues span + span::before { background: var(--h-gold); }

  body.home-page #main-content .h-rule {
    width: min(100%, 1040px);
    margin-top: clamp(54px, 6vw, 76px);
    background: linear-gradient(90deg, transparent, var(--h-border-strong), transparent);
  }

  @media (max-width: 1120px) {
    body.home-page #main-content .h-hero-brand { left: 1.5%; width: 150px; }
  }

  @media (max-width: 900px) {
    body.home-page #main-content .h-hero { min-height: auto; }

    body.home-page #main-content .h-hero-brand {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      justify-content: center;
