---
/**
 * HomeHero.astro — sacred native hero for /.
 *
 * The component is the sole owner of hero layout, Habakkuk interaction and
 * responsive behavior. Navigation, gateway and publication styles live with
 * their own route components.
 */
import HomeAmbientPhrases from './HomeAmbientPhrases.astro';
---

<HomeAmbientPhrases />

<section class="h-hero" aria-label="Главный заголовок">
  <div class="h-hero-brand" aria-label="Богословская библиотека «Господь Бог — Сила Моя»">
    <span class="h-hero-brand__rule" aria-hidden="true"><i></i></span>
    <span class="h-hero-brand__copy">
      <span>Богословская библиотека</span>
      <strong>Для вдумчивого изучения Писания</strong>
    </span>
  </div>

  <div class="h-sacred-block h-sacred-block--hero" role="group" aria-label="Интерактивный текст Аввакума 3:19. Нажмите на еврейское слово, чтобы увидеть перевод.">
    <span class="h-sacred-line h-sacred-line--1">
      <button class="h-tetra" type="button" disabled aria-pressed="false" aria-label="יְהוִה — показать чтение имени">
        <span class="h-tetra-label" aria-hidden="true">Священное Имя Бога</span>
        <span class="hb-front" lang="he">יְהוִה</span>
        <span class="h-tetra-back" aria-hidden="true"><span class="h-tetra-name">Яхве</span></span>
      </button>
      <button class="hb-w" type="button" disabled aria-pressed="false" aria-label="אֲדֹנָי — показать перевод: Господь">
        <span class="hb-front" lang="he">אֲדֹנָי</span><span class="hb-back" aria-hidden="true">Господь</span>
      </button>
      <button class="hb-w" type="button" disabled aria-pressed="false" aria-label="חֵילִי — показать перевод: сила моя">
        <span class="hb-front" lang="he">חֵילִי</span><span class="hb-back" aria-hidden="true">сила моя</span>
      </button>
    </span>

    <span class="h-sacred-line h-sacred-line--2">
      <button class="hb-w" type="button" disabled aria-pressed="false" aria-label="וַיָּשֶׂם — показать перевод: и сделает">
        <span class="hb-front" lang="he">וַיָּשֶׂם</span><span class="hb-back" aria-hidden="true">и сделает</span>
      </button>
      <button class="hb-w" type="button" disabled aria-pressed="false" aria-label="רַגְלַי — показать перевод: ноги мои">
        <span class="hb-front" lang="he">רַגְלַי</span><span class="hb-back" aria-hidden="true">ноги мои</span>
      </button>
      <button class="hb-w" type="button" disabled aria-pressed="false" aria-label="כָּאַיָּלוֹת — показать перевод: как у ланей">
        <span class="hb-front" lang="he">כָּאַיָּלוֹת</span><span class="hb-back" aria-hidden="true">как у ланей</span>
      </button>
      <button class="hb-w" type="button" disabled aria-pressed="false" aria-label="וְעַל — показать перевод: и на">
        <span class="hb-front" lang="he">וְעַל</span><span class="hb-back" aria-hidden="true">и на</span>
      </button>
      <button class="hb-w" type="button" disabled aria-pressed="false" aria-label="בָּמוֹתַי — показать перевод: высоты мои">
        <span class="hb-front" lang="he">בָּמוֹתַי</span><span class="hb-back" aria-hidden="true">высоты мои</span>
      </button>
      <button class="hb-w" type="button" disabled aria-pressed="false" aria-label="יַדְרִכֵנִי — показать перевод: даст мне ступать">
        <span class="hb-front" lang="he">יַדְרִכֵנִי</span><span class="hb-back" aria-hidden="true">даст мне ступать</span>
      </button>
    </span>

    <span class="h-sacred-ref"><span>Аввакум 3:19</span></span>
  </div>
  <p class="sr-only">Девиз проекта — Аввакум 3:19: «Господь Бог — сила моя; Он сделает ноги мои как у оленя и на высоты мои возведёт меня».</p>

  <p class="h-hero-tagline">Для изучения Писания</p>
  <h1 class="h-hero-title" tabindex="-1">
    <span class="h-title-static">Господь Бог</span> <span class="h-title-dash" aria-hidden="true">—</span> <span class="h-title-accent">Сила Моя</span>
  </h1>
  <p class="h-hero-desc">Экзегеза, богословие, апологетика, переводы и история Церкви — в единой библиотеке для медленного чтения и честного исследования.</p>

  <div class="h-hero-search-wrap" role="search" aria-label="Поиск по материалам сайта">
    <a class="h-hero-search" id="heroSearchBar" href="/articles/" aria-label="Открыть поиск по материалам сайта" data-action="open-search">
      <svg class="h-hero-search__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span class="h-hero-search__placeholder">Что вы хотите изучить?</span>
      <span class="h-hero-search__action" aria-hidden="true">Найти</span>
      <span class="h-hero-search__kbd" aria-hidden="true"><kbd data-search-shortcut-modifier>Ctrl</kbd><kbd>K</kbd></span>
    </a>
  </div>

  <div class="h-hero-cues" role="list" aria-label="Особенности библиотеки">
    <span role="listitem">Оригинальные языки</span>
    <span role="listitem">Проверяемые источники</span>
    <span role="listitem">Исторический контекст</span>
  </div>

  <hr class="h-rule" aria-hidden="true" />
</section>

<script is:inline>
  (() => {
    const words = document.querySelectorAll('.h-sacred-block--hero button.hb-w, .h-sacred-block--hero button.h-tetra');
    const sync = (word) => word.setAttribute('aria-pressed', word.hasAttribute('data-toggled') ? 'true' : 'false');
    words.forEach((word) => {
      word.disabled = false;
      new MutationObserver(() => sync(word)).observe(word, { attributes: true, attributeFilter: ['data-toggled'] });
      sync(word);
    });
  })();
</script>

<style is:global>
  body.home-page #main-content .h-hero {
    position: relative;
    min-height: min(900px, 92svh);
    justify-content: center;
    padding: clamp(116px, 9vw, 146px) 0 clamp(68px, 6.5vw, 88px);
    text-align: center;
  }

  body.home-page #main-content .h-hero::after {
    content: "";
    position: absolute;
    width: min(74vw, 850px);
    height: min(74vw, 850px);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -49%);
    border-radius: 50%;
    background: radial-gradient(circle, var(--h-glow), transparent 68%);
    filter: blur(28px);
    opacity: .44;
    pointer-events: none;
  }

  body.home-page #main-content .h-hero > * {
    position: relative;
    z-index: 1;
  }

  body.home-page #main-content .h-hero-brand {
    position: absolute;
    top: clamp(112px, 8.8vw, 136px);
    left: 0;
    width: 224px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 0;
    border: 0;
    text-align: left;
  }

  body.home-page #main-content .h-hero-brand__rule {
    position: relative;
    width: 18px;
    height: 58px;
    flex: 0 0 18px;
    border-left: 1px solid var(--h-border-strong);
  }

  body.home-page #main-content .h-hero-brand__rule::before,
  body.home-page #main-content .h-hero-brand__rule::after {
    content: "";
    position: absolute;
    left: -3px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  body.home-page #main-content .h-hero-brand__rule::before {
    top: 0;
    background: var(--h-gold);
    box-shadow: 0 0 18px rgba(170, 119, 45, .2);
  }

  body.home-page #main-content .h-hero-brand__rule::after {
    bottom: 0;
    background: var(--h-accent);
    box-shadow: 0 0 18px var(--h-glow);
  }

  body.home-page #main-content .h-hero-brand__copy { padding-top: 1px; }

  body.home-page #main-content .h-hero-brand__copy span,
  body.home-page #main-content .h-hero-brand__copy strong { display: block; }

  body.home-page #main-content .h-hero-brand__copy span {
    margin-bottom: 5px;
    color: var(--h-accent);
    font-family: var(--f-ui);
    font-size: 8px;
    font-weight: 760;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  body.home-page #main-content .h-hero-brand__copy strong {
    color: var(--h-muted);
    font-family: var(--f-body);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.45;
  }

  body.home-page #main-content .h-sacred-block--hero {
    width: min(100%, 780px);
    margin: 0 auto clamp(34px, 4.3vw, 52px);
  }

  body.home-page #main-content .h-sacred-block--hero::before {
    content: "нажмите на слово — перевод откроется на месте";
    margin-bottom: 20px;
    color: var(--h-muted);
    font-size: 8px;
    letter-spacing: .2em;
    opacity: .88;
  }

  body.home-page #main-content .h-sacred-line {
    color: var(--h-heading);
    text-shadow: 0 0 32px rgba(7, 125, 145, .08);
  }

  html.dark body.home-page #main-content .h-sacred-line { text-shadow: 0 0 36px rgba(66, 196, 213, .1); }
  body.home-page #main-content .h-sacred-block--hero .hb-front { color: var(--h-heading); opacity: .94; }
  body.home-page #main-content .h-sacred-ref { color: var(--h-gold); opacity: 1; }

  body.home-page #main-content .h-sacred-block--hero button.hb-w,
  body.home-page #main-content .h-sacred-block--hero button.h-tetra {
    appearance: none;
    -webkit-appearance: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    line-height: inherit;
    text-align: inherit;
  }

  body.home-page #main-content .h-sacred-block--hero button:is(.hb-w, .h-tetra):focus-visible {
    outline: 2px solid var(--h-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  body.home-page #main-content .h-sacred-block--hero button:disabled { cursor: default; }

  body.home-page #main-content .h-sacred-block--hero .hb-back,
  body.home-page #main-content .h-sacred-block--hero .h-tetra-back { visibility: hidden; }

  body.home-page #main-content .h-sacred-block--hero .hb-w[data-toggled] .hb-back,
  body.home-page #main-content .h-sacred-block--hero .h-tetra[data-toggled] .h-tetra-back { visibility: visible; }

  body.home-page #main-content .h-hero-tagline {
    display: block;
    visibility: visible;
    margin-bottom: 14px;
    color: var(--h-accent);
    font-size: 9px;
    letter-spacing: .38em;
    opacity: 1;
    transform: none;
    animation: none;
  }

  body.home-page #main-content .h-hero-title {
    display: block;
    visibility: visible;
    margin: 0 auto 20px;
    color: var(--h-heading);
    font-size: clamp(3.5rem, 5.65vw, 5.25rem);
    line-height: 1;
    letter-spacing: -.045em;
    text-wrap: balance;
    opacity: 1;
    transform: none;
    animation: none;
  }

  body.home-page #main-content .h-title-static { color: var(--h-heading); }
  body.home-page #main-content .h-title-dash { color: var(--h-gold); opacity: .78; }
  body.home-page #main-content .h-title-accent { color: var(--h-gold); }
  body.home-page #main-content .h-hero-title:hover .h-title-accent { text-shadow: 0 8px 32px rgba(174, 127, 59, .23); }

  body.home-page #main-content .h-hero-desc {
    display: block;
    visibility: visible;
    max-width: 710px;
    color: var(--h-muted);
    font-size: clamp(1.02rem, 1.45vw, 1.22rem);
    line-height: 1.72;
    opacity: 1;
    transform: none;
    animation: none;
  }

  body.home-page #main-content .h-hero-search-wrap {
    display: block;
    visibility: visible;
    width: min(100%, 820px);
    margin-top: 34px;
    opacity: 1;
    transform: none;
    animation: none;
  }

  body.home-page #main-content .h-hero-search {
    width: 100%;
    min-height: 68px;
    display: flex;
    align-items: center;
    padding: 0 20px 0 24px;
    border: 1px solid var(--h-border-strong);
    border-radius: 15px;
    background: color-mix(in srgb, var(--h-surface-solid) 84%, transparent);
    box-shadow: var(--h-shadow), inset 0 1px rgba(255, 255, 255, .45);
    color: var(--h-heading);
    text-decoration: none;
  }

  html.dark body.home-page #main-content .h-hero-search {
    background: rgba(9, 16, 18, .82);
    box-shadow: var(--h-shadow), 0 0 48px -32px var(--h-accent), inset 0 1px rgba(255, 255, 255, .04);
  }

  body.home-page #main-content .h-hero-search__icon { flex: 0 0 auto; color: var(--h-accent); }

  body.home-page #main-content .h-hero-search__placeholder {
    min-width: 0;
    color: var(--h-muted);
    font-family: var(--f-body);
    font-size: clamp(16px, 1.7vw, 20px);
  }

  body.home-page #main-content .h-hero-search__action {
    margin-left: auto;
    padding-left: 20px;
    border-left: 1px solid var(--h-border);
    color: var(--h-accent);
    font-family: var(--f-ui);
    font-size: 11px;
    font-weight: 740;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  body.home-page #main-content .h-hero-search__kbd { margin-left: 14px; }

  body.home-page #main-content .h-hero-search:is(:hover, :focus-visible) {
    border-color: var(--h-accent);
    background: var(--h-surface-solid);
    box-shadow: 0 0 0 4px var(--h-accent-soft), 0 28px 72px -44px rgba(5, 93, 109, .5);
  }

  html.dark body.home-page #main-content .h-hero-search:is(:hover, :focus-visible) { background: #0c1719; }

  body.home-page #main-content .h-hero-cues {
    margin-top: 22px;
    color: var(--h-muted);
    font-size: 9px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  body.home-page #main-content .h-hero-cues span + span::before { background: var(--h-gold); }

  body.home-page #main-content .h-rule {
    width: min(100%, 1040px);
    margin-top: clamp(54px, 6vw, 76px);
    background: linear-gradient(90deg, transparent, var(--h-border-strong), transparent);
  }

  @media (max-width: 1120px) {
    body.home-page #main-content .h-hero-brand { left: 1.5%; width: 150px; }
  }

  @media (max-width: 900px) {
    body.home-page #main-content .h-hero { min-height: auto; }

    body.home-page #main-content .h-hero-brand {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      justify-content: center;
      align-items: center;
      gap: 12px;
      margin: 0 auto 36px;
      text-align: center;
    }

    body.home-page #main-content .h-hero-brand__rule {
      width: 46px;
      height: 1px;
      flex-basis: 46px;
      border-top: 1px solid var(--h-border-strong);
      border-left: 0;
    }

    body.home-page #main-content .h-hero-brand__rule::before { top: -2px; left: 0; }
    body.home-page #main-content .h-hero-brand__rule::after { top: -2px; right: 0; bottom: auto; left: auto; }
    body.home-page #main-content .h-hero-brand__copy { padding-top: 0; text-align: left; }
    body.home-page #main-content .h-hero-brand__copy strong { max-width: 260px; }
  }

  @media (max-width: 760px) {
    body.home-page #main-content .h-hero {
      min-height: 0;
      padding: calc(78px + env(safe-area-inset-top, 0px)) 0 36px;
    }

    body.home-page #main-content .h-hero::after {
      width: 130vw;
      height: 130vw;
      opacity: .35;
    }

    body.home-page #main-content .h-hero-brand { margin-bottom: 20px; }
    body.home-page #main-content .h-hero-brand__rule { width: 34px; flex-basis: 34px; }
    body.home-page #main-content .h-hero-brand__copy span { font-size: 7px; }
    body.home-page #main-content .h-hero-brand__copy strong { font-size: 12px; }

    body.home-page #main-content .h-sacred-block--hero { margin-bottom: 24px; }
    body.home-page #main-content .h-sacred-block--hero::before { margin-bottom: 12px; font-size: 7px; line-height: 1.5; letter-spacing: .17em; }
    body.home-page #main-content .h-sacred-ref { margin-top: 12px; }

    body.home-page #main-content .h-sacred-line--1 {
      font-size: clamp(1.15rem, 5.7vw, 1.45rem);
      line-height: 1.7;
    }

    body.home-page #main-content .h-sacred-line--2 {
      max-width: 390px;
      margin-inline: auto;
      font-size: clamp(.9rem, 4.3vw, 1.12rem);
      line-height: 1.86;
    }

    body.home-page #main-content .h-sacred-block--hero .h-tetra .hb-front,
    body.home-page #main-content .h-sacred-block--hero .h-tetra-back .h-tetra-name {
      font-size: clamp(1.72rem, 9vw, 2.3rem);
    }

    body.home-page #main-content .h-hero-tagline { margin-top: 0; margin-bottom: 11px; }

    body.home-page #main-content .h-hero-title {
      max-width: 350px;
      margin-bottom: 17px;
      font-size: clamp(2.35rem, 10.9vw, 3.12rem);
      line-height: .98;
    }

    body.home-page #main-content .h-title-static,
    body.home-page #main-content .h-title-accent { display: block; }
    body.home-page #main-content .h-title-dash { display: none; }
    body.home-page #main-content .h-title-accent { margin-top: .08em; }

    body.home-page #main-content .h-title-accent::before {
      content: "—";
      display: inline-block;
      margin-right: .2em;
      color: var(--h-gold);
      font-style: normal;
      opacity: .76;
      transform: translateY(-.04em);
    }

    body.home-page #main-content .h-hero-desc { max-width: 350px; font-size: 15.5px; line-height: 1.6; }
    body.home-page #main-content .h-hero-search-wrap { margin-top: 22px; }

    body.home-page #main-content .h-hero-search {
      min-height: 58px;
      padding-inline: 17px;
      border-radius: 14px;
    }

    body.home-page #main-content .h-hero-search__placeholder {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 16px;
    }

    body.home-page #main-content .h-hero-search__action { padding-left: 13px; font-size: 9px; }
    body.home-page #main-content .h-hero-search__kbd { display: none; }

    body.home-page #main-content .h-hero-cues {
      max-width: 360px;
      gap: 8px 14px;
      margin-top: 17px;
      font-size: 8px;
      line-height: 1.5;
    }

    body.home-page #main-content .h-hero-cues span + span::before { display: none; }
    body.home-page #main-content .h-rule { margin-top: 38px; }
  }

  @media (max-width: 390px) {
    body.home-page #main-content .h-hero-search__action { display: none; }
  }

  @media (max-width: 340px) {
    body.home-page #main-content .h-hero { padding-top: calc(72px + env(safe-area-inset-top, 0px)); }
    body.home-page #main-content .h-hero-title { font-size: 2.28rem; }
    body.home-page #main-content .h-hero-desc { font-size: 14.5px; }
    body.home-page #main-content .h-hero-search__placeholder { font-size: 14px; }
  }

  @media (orientation: landscape) and (max-height: 560px) and (max-width: 960px) {
    body.home-page #main-content .h-hero { padding-top: 92px; }
    body.home-page #main-content .h-hero-brand { display: none; }
    body.home-page #main-content .h-sacred-block--hero { margin-bottom: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    body.home-page #main-content .h-hero-search { transition: none; }
    body.home-page #main-content .h-sacred-block--hero .hb-front { opacity: .94 !important; }

    body.home-page #main-content .h-sacred-block--hero .hb-back,
    body.home-page #main-content .h-sacred-block--hero .h-tetra-back { opacity: 0 !important; }

    body.home-page #main-content .h-sacred-block--hero .hb-w[data-toggled] .hb-front,
    body.home-page #main-content .h-sacred-block--hero .h-tetra[data-toggled] .hb-front { opacity: 0 !important; }

    body.home-page #main-content .h-sacred-block--hero .hb-w[data-toggled] .hb-back,
    body.home-page #main-content .h-sacred-block--hero .h-tetra[data-toggled] .h-tetra-back { opacity: 1 !important; }
  }
</style>
