---
/**
 * HomeHero.astro — native hero block for /.
 *
 * Hand-authored Astro leaf preserving the legacy hero DOM/classes/copy.
 */
---
<section class="h-hero" aria-label="Главный заголовок">
  <div class="h-sacred-block h-sacred-block--hero" role="group" aria-label="Интерактивный текст Аввакума 3:19. Нажмите на еврейское слово, чтобы увидеть перевод.">
    <span class="h-sacred-line h-sacred-line--1">
      <span class="h-tetra" role="button" tabindex="0" aria-pressed="false" aria-label="יְהוִה — показать чтение имени">
        <span class="h-tetra-label" aria-hidden="true">Священное Имя Бога</span>
        <span class="hb-front" lang="he">יְהוִה</span>
        <span class="h-tetra-back" aria-hidden="true">
          <span class="h-tetra-name">Яхве</span>
        </span>
      </span>
      <span class="hb-w" role="button" tabindex="0" aria-pressed="false" aria-label="אֲדֹנָי — показать перевод: Господь">
        <span class="hb-front" lang="he">אֲדֹנָי</span>
        <span class="hb-back" aria-hidden="true">Господь</span>
      </span>
      <span class="hb-w" role="button" tabindex="0" aria-pressed="false" aria-label="חֵילִי — показать перевод: сила моя">
        <span class="hb-front" lang="he">חֵילִי</span>
        <span class="hb-back" aria-hidden="true">сила моя</span>
      </span>
    </span>

    <span class="h-sacred-line h-sacred-line--2">
      <span class="hb-w" role="button" tabindex="0" aria-pressed="false" aria-label="וַיָּשֶׂם — показать перевод: и сделает">
        <span class="hb-front" lang="he">וַיָּשֶׂם</span>
        <span class="hb-back" aria-hidden="true">и сделает</span>
      </span>
      <span class="hb-w" role="button" tabindex="0" aria-pressed="false" aria-label="רַגְלַי — показать перевод: ноги мои">
        <span class="hb-front" lang="he">רַגְלַי</span>
        <span class="hb-back" aria-hidden="true">ноги мои</span>
      </span>
      <span class="hb-w" role="button" tabindex="0" aria-pressed="false" aria-label="כָּאַיָּלוֹת — показать перевод: как у ланей">
        <span class="hb-front" lang="he">כָּאַיָּלוֹת</span>
        <span class="hb-back" aria-hidden="true">как у ланей</span>
      </span>
      <span class="hb-w" role="button" tabindex="0" aria-pressed="false" aria-label="וְעַל — показать перевод: и на">
        <span class="hb-front" lang="he">וְעַל</span>
        <span class="hb-back" aria-hidden="true">и на</span>
      </span>
      <span class="hb-w" role="button" tabindex="0" aria-pressed="false" aria-label="בָּמוֹתַי — показать перевод: высоты мои">
        <span class="hb-front" lang="he">בָּמוֹתַי</span>
        <span class="hb-back" aria-hidden="true">высоты мои</span>
      </span>
      <span class="hb-w" role="button" tabindex="0" aria-pressed="false" aria-label="יַדְרִכֵנִי — показать перевод: даст мне ступать">
        <span class="hb-front" lang="he">יַדְרִכֵנִי</span>
        <span class="hb-back" aria-hidden="true">даст мне ступать</span>
      </span>
    </span>

    <span class="h-sacred-ref">
      <span>Аввакум 3:19</span>
    </span>
  </div>
  <p class="sr-only">Девиз проекта — Аввакум 3:19: «Господь Бог — сила моя; Он сделает ноги мои как у оленя и на высоты мои возведёт меня».</p>

  <p class="h-hero-tagline">Для изучения Писания</p>

  <h1 class="h-hero-title" tabindex="-1">
    <span class="h-title-static">Господь Бог</span> <span class="h-title-dash" aria-hidden="true">—</span> <span class="h-title-accent">Сила Моя</span>
  </h1>

  <p class="h-hero-desc">
    Материалы для вдумчивого изучения Писания: экзегеза, богословие, апологетика, переводы, биографии и непростые вопросы.
  </p>

  <div class="h-hero-search-wrap" role="search" aria-label="Поиск по материалам сайта">
    <button class="h-hero-search" id="heroSearchBar" type="button" aria-label="Открыть поиск по материалам сайта" data-action="open-search">
      <svg class="h-hero-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span class="h-hero-search__placeholder">Поиск по материалам…</span>
      <span class="h-hero-search__kbd" aria-hidden="true"><kbd data-search-shortcut-modifier>Ctrl</kbd><kbd>K</kbd></span>
    </button>
  </div>

  <div class="h-hero-cues" aria-label="Особенности библиотеки">
    <span>Оригинальные языки</span>
    <span>Проверяемые источники</span>
    <span>Медленное чтение</span>
  </div>

  <hr class="h-rule" aria-hidden="true" />
</section>

<script is:inline>
  (() => {
    const words = document.querySelectorAll('.h-sacred-block--hero .hb-w, .h-sacred-block--hero .h-tetra');
    const sync = (word) => word.setAttribute('aria-pressed', word.hasAttribute('data-toggled') ? 'true' : 'false');
    words.forEach((word) => {
      word.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          word.click();
        }
      });
      new MutationObserver(() => sync(word)).observe(word, { attributes: true, attributeFilter: ['data-toggled'] });
      sync(word);
    });
  })();
</script>
