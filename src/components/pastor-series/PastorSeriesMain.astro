---
/**
 * PastorSeriesMain.astro — <main id="main-content"> of /pastor-series/.
 *
 * Refactoring 6.0 parallel pilot: the route no longer proxies one monolithic
 * `_legacy/main.html?raw` block. Instead, the semantic main shell is composed
 * from named Astro components while preserving legacy DOM/classes/text.
 *
 * Pixel-parity contract remains guarded via
 *   npm run visual:parity:screenshots -- --routes /pastor-series/
 * and source-contract audit in scripts/pastor-series-visual-parity-audit.js.
 */
import PastorSeriesCardsSection from './PastorSeriesCardsSection.astro';
import PastorSeriesStatsSection from './PastorSeriesStatsSection.astro';
import PastorSeriesArticleEndBlock from './PastorSeriesArticleEndBlock.astro';
---
<main id="main-content" data-pagefind-body>
  <PastorSeriesCardsSection />
  <PastorSeriesStatsSection />
  <PastorSeriesArticleEndBlock />
</main>