---
import JournalPageHead from '@/components/journal/JournalDocumentHead.astro';
import G3Dossier from '@/components/journal/G3Dossier.astro';
import { G3_PRODUCT_METADATA } from '@/data/journal/g3ProductMetadata';

const {
  title,
  description,
  canonical,
  publishedAt,
  modifiedAt,
  readingTimeMinutes,
} = G3_PRODUCT_METADATA;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <JournalPageHead
      title={title}
      description={description}
      canonical={canonical}
      kind="Article"
      publishedAt={publishedAt}
      modifiedAt={modifiedAt}
      readingTime={readingTimeMinutes}
    />
  </head>
  <body data-pagefind-body data-journal-surface="dossier" data-journal-id="g3">
    <G3Dossier />
  </body>
</html>
