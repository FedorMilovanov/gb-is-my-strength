---
import JournalPageHead from '@/components/journal/JournalDocumentHead.astro';
import G3Dossier from '@/components/journal/G3Dossier.astro';

const title = 'G3: рост, кризис и завершение операций';
const description = 'Документальное досье G3 Ministries: корпоративные записи, IRS Form 990, кризис Josh Buice, спор вокруг Tom Buck, прекращение операций и открытые вопросы без повышения спорных версий до факта.';
const canonical = 'https://gospod-bog.ru/journal/dossiers/g3/';
const readingTime = 8;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <JournalPageHead
      title={title}
      description={description}
      canonical={canonical}
      kind="Article"
      publishedAt="2026-09-09T00:00:00+03:00"
      modifiedAt="2026-09-09T00:00:00+03:00"
      readingTime={readingTime}
    />
  </head>
  <body data-pagefind-body data-journal-surface="dossier" data-journal-id="g3">
    <G3Dossier />
  </body>
</html>
