---
import JournalPageHead from '@/components/journal/JournalDocumentHead.astro';
import JournalLanding from '@/components/journal/JournalLanding.astro';

const title = 'Журнал — документы, новости и расследования';
const description = 'Документальный журнал сайта «Господь Бог — Сила Моя»: проверенные новости, расследования, досье, первичные документы, explainers, открытые вопросы и история исправлений.';
const canonical = 'https://gospod-bog.ru/journal/';
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <JournalPageHead title={title} description={description} canonical={canonical} kind="CollectionPage" />
  </head>
  <body data-pagefind-body data-journal-surface="landing">
    <JournalLanding />
  </body>
</html>
