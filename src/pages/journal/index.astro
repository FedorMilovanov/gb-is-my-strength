---
import JournalPageHead from '@/components/journal/JournalDocumentHead.astro';
import JournalLanding from '@/components/journal/JournalLanding.astro';
import { JOURNAL_PRODUCT_METADATA } from '@/data/journal/journalProductMetadata';

const { title, description, canonical, publishedAt, modifiedAt, readingTimeMinutes } = JOURNAL_PRODUCT_METADATA;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <JournalPageHead
      title={title}
      description={description}
      canonical={canonical}
      kind="CollectionPage"
      publishedAt={publishedAt}
      modifiedAt={modifiedAt}
      readingTime={readingTimeMinutes}
    />
  </head>
  <body data-pagefind-body data-journal-surface="landing">
    <JournalLanding />
  </body>
</html>
