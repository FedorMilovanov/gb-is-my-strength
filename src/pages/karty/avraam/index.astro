---
/**
 * /karty/avraam/ — strict-native route (Protected App Routes Native Astro Phase).
 *
 * Replaces the buggy legacy cinematic-only map with the unified MapEngine.
 * Native PageHead (SEO/JSON-LD/meta) + Native AvraamMap body.
 * Does NOT use site.css/site.js.
 */
import AvraamPageHead from '@/components/karty/avraam/AvraamPageHead.astro';
import AvraamMap from '@/components/karty/avraam/AvraamMap.astro';
import AppSearchSurface from '@/components/search/AppSearchSurface.astro';
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <AvraamPageHead />
  </head>
  <body class="has-app-search-map">
    <AvraamMap />
    <!-- The two fixed map controls are page chrome, not part of the map:
         a navigation landmark keeps them out of the axe/`region` gap. -->
    <nav class="map-search-rail" aria-label="Поиск и приложение">
      <AppSearchSurface mode="map-engine" />
    </nav>
    <script>
      const stage = document.querySelector('[data-map-stage]');
      const fallbackHeading = document.querySelector('h1.sr-only[data-pagefind-body]');

      if (stage && fallbackHeading) {
        const removeFallbackHeadingWhenReady = () => {
          if (stage.getAttribute('data-map-state') !== 'ready') return false;
          fallbackHeading.remove();
          return true;
        };

        if (!removeFallbackHeadingWhenReady()) {
          const observer = new MutationObserver(() => {
            if (removeFallbackHeadingWhenReady()) observer.disconnect();
          });
          observer.observe(stage, { attributes: true, attributeFilter: ['data-map-state'] });
        }
      }
    </script>
  </body>
</html>
