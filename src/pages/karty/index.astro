---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';

const canonical = `${SITE.url}/karty/`;
const title = 'Карты | Господь Бог — Сила Моя';
const description = 'Интерактивные библейские карты: Авраам, Исход, Павел, Судьи, Царства, 12 колен, жизнь Христа, Маккавеи, Ранняя Церковь и семь церквей Откровения.';

const maps = [
  { slug: 'avraam', title: 'Путь Авраама', he: 'אַבְרָהָם אָבִינוּ', kick: 'Быт. 11–25 · Средняя бронза', desc: '19 мест, 8 этапов, 5 сюжетных режимов. Ур → Харран → Ханаан → Египет → Содом → Мория.', meta: ['19 мест', '8 этапов', '5 историй'], accent: '#d4a857' },
  { slug: 'ishod', title: 'Исход из Египта', he: 'יְצִיאַת מִצְרַיִם', kick: 'Исход · Числа 33 · Пустыня Синай', desc: 'Раамсес → море → Синай → Кадеш → равнины Моава. Маршрут, спорные локализации и 40 лет странствий.', meta: ['11 мест', '6 этапов', '4 истории'], accent: '#8fb8d9' },
  { slug: 'pavel', title: 'Путешествия Павла', he: 'Παῦλος', kick: 'Деян. 13–28 · 1 век н.э.', desc: 'Антиохия, Кипр, Македония, Афины, Коринф, Эфес и Рим: миссионерская география апостола.', meta: ['10 городов', '3 этапа', '4 истории'], accent: '#65e6a2' },
  { slug: 'shoftim', title: 'Эпоха Судей', he: 'שֹׁפְטִים', kick: 'Суд. 1–21 · ~1200–1050 до н.э.', desc: 'Гофониил, Аод, Девора, Гедеон, Иеффай, Самсон: циклы отступления, угнетения и избавления.', meta: ['13 мест', '6 этапов', '6 историй'], accent: '#9bd06a' },
  { slug: 'melachim', title: 'Царства', he: 'מַמְלֶכֶת', kick: '1–4 Царств · ~1050–586 до н.э.', desc: 'Саул, Давид, Соломон, разделённое царство, пророки, плен и возвращение.', meta: ['17 мест', '6 этапов', '7 историй'], accent: '#c084fc' },
  { slug: 'shvatim', title: '12 колен', he: 'שִׁבְטֵי', kick: 'Нав. 13–22 · уделы Израиля', desc: 'Наследие колен Израилевых, города, север/юг, уделы и географическая логика книги Иисуса Навина.', meta: ['18 мест', '3 этапа', '5 историй'], accent: '#f4c95d' },
  { slug: 'yeshua', title: 'Жизнь Христа', he: 'יֵשׁוּעַ', kick: 'Евангелия · 1 век н.э.', desc: 'Вифлеем, Назарет, Галилея, Иерусалим, Голгофа и Воскресение: служение Христа на карте.', meta: ['15 мест', '5 этапов', '5 историй'], accent: '#ffe08a' },
  { slug: 'maccabim', title: 'Маккавеи', he: 'Μακκαβαῖοι', kick: 'Межзаветный период · 167–160 до н.э.', desc: 'Иудея под давлением эллинизма, восстание, храм и Ханука: карта эпохи между Заветами.', meta: ['12 мест', '5 этапов', '6 историй'], accent: '#ffb86b' },
  { slug: 'early-church', title: 'Ранняя Церковь', he: 'Ἐκκλησία', kick: 'Деяния · Иерусалим → Рим', desc: 'Деян. 1:8 как география: Иерусалим, Иудея, Самария и края земли.', meta: ['11 мест', '4 этапа', '5 историй'], accent: '#62d8ff' },
  { slug: 'revelation', title: '7 церквей Откровения', he: 'Ἀποκάλυψις', kick: 'Откр. 1–3 · Малая Азия', desc: 'Ефес, Смирна, Пергам, Фиатира, Сардис, Филадельфия и Лаодикия — семь светильников.', meta: ['7 мест', '1 этап', '5 историй'], accent: '#ff7aa8' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#collectionpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'ru',
      isPartOf: { '@id': SITE.websiteId },
      publisher: { '@id': SITE.orgId },
      image: `${SITE.url}/images/og-karty-1200x630.webp`,
      hasPart: maps.map((map) => ({ '@type': 'WebPage', url: `${SITE.url}/karty/${map.slug}/`, name: map.title })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE.name, item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Карты', item: canonical },
      ]
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={`${SITE.url}/images/og-karty-1200x630.webp`}
  ogTitle="Карты"
  ogDescription={description}
  jsonLd={jsonLd}
>
  <section class="astro-page astro-karty-index" data-pagefind-body>
    <header class="astro-page__header karty-hero">
      <p class="astro-eyebrow">Библейская география</p>
      <h1>Карты</h1>
      <p class="astro-lead">Десять живых интерактивных карт: маршруты, археология, иврит, источники, спорные локализации и авторские сигнатуры каждой эпохи.</p>
    </header>

    <div class="karty-premium-grid">
      {maps.map((map, index) => (
        <a href={`/karty/${map.slug}/`} class="karty-premium-card live" style={`--map-accent:${map.accent};--map-i:${index}`} data-map-card={map.slug}>
          <div class="karty-card-art" aria-hidden="true">
            <svg viewBox="0 0 360 168" preserveAspectRatio="xMidYMid slice">
              <defs>
                <linearGradient id={`bg-${map.slug}`} x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#1b1d18" />
                  <stop offset="1" stop-color="#090b10" />
                </linearGradient>
                <radialGradient id={`gl-${map.slug}`} cx="70%" cy="30%" r="70%">
                  <stop offset="0" stop-color={map.accent} stop-opacity="0.38" />
                  <stop offset="1" stop-color={map.accent} stop-opacity="0" />
                </radialGradient>
              </defs>
              <rect width="360" height="168" fill={`url(#bg-${map.slug})`} />
              <rect width="360" height="168" fill={`url(#gl-${map.slug})`} />
              <path d="M0,58 C72,45 145,37 208,45 C255,51 292,75 280,104 C266,137 208,155 150,161 L0,168 Z" fill="rgba(255,255,255,.045)" />
              <path d="M42,126 C92,98 136,76 184,70 C232,64 276,82 324,42" fill="none" stroke={map.accent} stroke-width="2.5" stroke-linecap="round" stroke-dasharray={map.slug === 'pavel' ? '7 7' : '0'} opacity="0.9" />
              <circle cx="42" cy="126" r="4.5" fill="#0b0d10" stroke={map.accent} stroke-width="2" />
              <circle cx="184" cy="70" r="4.5" fill="#0b0d10" stroke={map.accent} stroke-width="2" />
              <circle cx="324" cy="42" r="4.5" fill="#0b0d10" stroke={map.accent} stroke-width="2" />
            </svg>
          </div>
          <div class="karty-card-body">
            <div class="karty-kick">{map.kick}</div>
            <h2>{map.title} <span class="hebr">{map.he}</span></h2>
            <p>{map.desc}</p>
            <div class="karty-meta">
              {map.meta.map((m) => <span>{m}</span>)}
            </div>
            <div class="karty-cta">Открыть карту →</div>
          </div>
        </a>
      ))}
    </div>

    <p class="karty-footer-note">
      Каждая карта соединяет географию, археологию, источники и осторожность там, где данные спорны.<br />
      Если в тексте есть альтернативные локализации, они показываются как научные варианты, а не как уверенная догадка.
    </p>
  </section>
</BaseLayout>

<style>
  .astro-karty-index {
    max-width: 1280px;
    padding-inline: clamp(16px, 4vw, 48px);
  }
  .karty-hero {
    text-align: center;
    max-width: 860px;
    margin-inline: auto;
  }
  .karty-premium-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 22px;
    margin-top: 2.5rem;
  }
  .karty-premium-card {
    position: relative;
    display: grid;
    grid-template-rows: 168px 1fr;
    min-height: 430px;
    overflow: hidden;
    border-radius: 24px;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.018));
    border: 1px solid rgba(232,200,121,.15);
    box-shadow: 0 18px 60px rgba(0,0,0,.42), inset 0 0 0 1px rgba(255,255,255,.03);
    transition: transform .35s cubic-bezier(.22,1,.36,1), border-color .35s ease, box-shadow .35s ease;
  }
  .karty-premium-card::after {
    content: "Живая карта";
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #071014;
    background: var(--map-accent, #d4a857);
    border-radius: 999px;
    padding: 5px 9px;
    box-shadow: 0 10px 28px color-mix(in srgb, var(--map-accent, #d4a857) 24%, transparent);
  }
  .karty-premium-card:hover,
  .karty-premium-card:focus-visible {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--map-accent, #d4a857) 55%, rgba(255,255,255,.2));
    box-shadow: 0 28px 82px rgba(0,0,0,.56), 0 0 0 1px color-mix(in srgb, var(--map-accent, #d4a857) 52%, transparent), 0 0 36px color-mix(in srgb, var(--map-accent, #d4a857) 20%, transparent);
    text-decoration: none;
  }
  .karty-card-art {
    position: relative;
    overflow: hidden;
    background: #0b0d10;
  }
  .karty-card-art svg {
    width: 100%;
    height: 100%;
    display: block;
    transform: scale(1.02);
    transition: transform .65s cubic-bezier(.22,1,.36,1);
  }
  .karty-premium-card:hover .karty-card-art svg,
  .karty-premium-card:focus-visible .karty-card-art svg {
    transform: scale(1.08);
  }
  .karty-card-body {
    padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
  }
  .karty-kick {
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--map-accent, #d4a857);
    font-weight: 800;
    margin-bottom: 10px;
  }
  .karty-card-body h2 {
    margin: 0 0 10px;
    font-family: var(--f-serif, Georgia, serif);
    font-size: clamp(22px, 2.2vw, 29px);
    line-height: 1.05;
    color: var(--color-text-primary, #f5eddb);
  }
  .hebr {
    display: block;
    margin-top: 4px;
    font-size: .62em;
    direction: rtl;
    color: color-mix(in srgb, var(--map-accent, #d4a857) 78%, white 22%);
    opacity: .9;
  }
  .karty-card-body p {
    margin: 0;
    color: var(--color-text-secondary, #b8b0a2);
    line-height: 1.6;
    font-size: 14px;
  }
  .karty-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: auto;
    padding-top: 18px;
  }
  .karty-meta span {
    font-size: 11px;
    color: color-mix(in srgb, var(--map-accent, #d4a857) 72%, white 12%);
    border: 1px solid color-mix(in srgb, var(--map-accent, #d4a857) 34%, transparent);
    background: color-mix(in srgb, var(--map-accent, #d4a857) 10%, transparent);
    border-radius: 999px;
    padding: 5px 9px;
  }
  .karty-cta {
    margin-top: 18px;
    font-size: 12px;
    letter-spacing: .18em;
    color: var(--map-accent, #d4a857);
    font-weight: 800;
    text-transform: uppercase;
  }
  .karty-footer-note {
    margin-top: 3rem;
    font-size: 13px;
    color: var(--muted, #9aa2ae);
    text-align: center;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .karty-premium-grid { grid-template-columns: 1fr; gap: 16px; }
    .karty-premium-card { min-height: 390px; border-radius: 20px; }
    .karty-card-body { padding: 18px; }
  }
</style>
