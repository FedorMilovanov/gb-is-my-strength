---
/**
 * /karty/ishod/ — strict-native route (Рефакторинг 6.0).
 *
 * Legacy-head transport retired. The Exodus map is a self-contained
 * full-screen interactive page: native PageHead (SEO/JSON-LD/meta) +
 * native IshodMap body (map-engine.js + route.json). Does NOT use
 * site.css/site.js — the dark map renders its own UI.
 */
import IshodPageHead from '@/components/karty/ishod/IshodPageHead.astro';
import IshodMap from '@/components/karty/ishod/IshodMap.astro';
import AppSearchSurface from '@/components/search/AppSearchSurface.astro';
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <IshodPageHead />
  </head>
  <body class="has-app-search-map">
    <AppSearchSurface mode="map-engine" />
    <IshodMap />
  </body>
</html>
