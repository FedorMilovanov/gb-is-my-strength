---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadLegacyShadowPage } from '@/utils/legacyShadow';

const legacy = loadLegacyShadowPage('karty/ishod/index.html');
---

<BaseLayout
  title={legacy.title}
  description={legacy.description}
  canonical={legacy.canonical}
  robots="index, follow, max-snippet:-1, max-image-preview:large"
  ogImage={legacy.ogImage}
  ogImageAlt={legacy.ogImageAlt}
  ogTitle={legacy.ogTitle}
  ogDescription={legacy.ogDescription}
  bodyClass={legacy.bodyClass}
  mainClass="astro-main astro-main--bare"
  hideHeader={true}
  hideFooter={true}
  headHtml={legacy.headHtml}
>
  <div class="astro-ishod-shadow" data-astro-shadow-route="karty-ishod">
    <h1 class="sr-only">Исход из Египта — интерактивная карта</h1>
    <div class="sr-only" data-pagefind-body>
      Исход из Египта. Интерактивная карта: 11 ключевых мест, 6 этапов, 4 сюжетных режима, иврит, археология и источники.
      От Раамсеса через море, Синай и Кадеш-Барнеа к равнинам Моава. 40 лет странствий Израиля.
    </div>
    <Fragment set:html={legacy.bodyHtml} />
  </div>
</BaseLayout>
