---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';
import routeData from '../../../../karty/ishod/route.json';

const canonical = `${SITE.url}/karty/ishod/`;
const title = 'Исход из Египта — интерактивная карта | Господь Бог — Сила Моя';
const description = 'Интерактивная карта Исхода: от Раамсеса через море, Синай и Кадеш к равнинам Моава. В разработке.';
const ogTitle = 'Исход из Египта — карта в разработке';
const ogDescription = 'Сорок лет странствий: от Раамсеса через Красное море, Синай и Кадеш-Барнеа к равнинам Моава.';

const meta = routeData.meta;
const stories = routeData.stories;
const stages = routeData.stages;
const places = routeData.places;
const prominentPlaces = places.slice(0, 7);
const laterPlaces = places.slice(7);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: ogTitle,
      description,
      inLanguage: 'ru',
      isPartOf: { '@id': SITE.websiteId },
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Карты', item: `${SITE.url}/karty/` },
        { '@type': 'ListItem', position: 3, name: 'Исход из Египта', item: canonical },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={`${SITE.url}/images/og-karty-1200x630.webp`}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImageAlt="Библейские карты — маршрут Исхода от Египта к Синаю и Моаву"
  jsonLd={jsonLd}
>
  <section class="astro-page astro-ishod-map-page" data-pagefind-body>
    <header class="astro-page__header astro-ishod-map-page__header">
      <p class="astro-eyebrow">Библейская география · Исход · Числа 33</p>
      <h1>Исход из Египта</h1>
      <p class="astro-ishod-he">יְצִיאַת מִצְרַיִם</p>
      <p>{description}</p>
      <div class="astro-ishod-badge">В разработке</div>
      <p>
        Этот маршрут уже имеет рабочую data-основу: ключевые места, этапы, сюжеты, иврит, спорные локализации и базовую
        географию. Следующий шаг — не просто «нарисовать новую карту», а собрать полноценную интерактивную страницу такого же
        уровня, как лучшие разделы сайта: с визуальным слоем, богословской осторожностью и удобной мобильной структурой.
      </p>
    </header>

    <section class="summary-card" data-speakable>
      <h2 class="summary-card__head">Что уже готово</h2>
      <ol class="summary-card__body">
        <li class="summary-card__item">
          <span class="summary-card__num" aria-hidden="true" data-num="01"></span>
          <p class="summary-card__text">Маршрутная база уже собрана: <strong>{meta.stats.places} мест</strong>, <strong>{meta.stats.stages} этапов</strong>, <strong>{meta.stats.years} лет</strong> странствий и связанные сюжетные режимы.</p>
        </li>
        <li class="summary-card__item">
          <span class="summary-card__num" aria-hidden="true" data-num="02"></span>
          <p class="summary-card__text">В JSON уже есть ключевые библейские узлы: Раамсес, переправа через море, Мара, Елим, Рефидим, Синай, Кадеш-Барнеа, Гора Ор и равнины Моава.</p>
        </li>
        <li class="summary-card__item">
          <span class="summary-card__num" aria-hidden="true" data-num="03"></span>
          <p class="summary-card__text">Особенно важно не перепутать карту с дешёвой инфографикой: здесь уже заложены спорные локализации, route-story logic и иврит, а значит дальше нужен не «костыль», а нормальный polished map-app layer.</p>
        </li>
      </ol>
    </section>

    <div class="note-box astro-ishod-note">
      <strong>Текущее состояние.</strong> Это не пустая заглушка: карта ещё не доведена до полного интерактивного интерфейса,
      но content/data фундамент уже собран. Поэтому страница теперь работает как честный подготовительный хаб: показывает,
      что именно уже готово и в какую сторону будет расти полноценная карта.
    </div>

    <section>
      <h2>Маршрут в шести этапах</h2>
      <div class="astro-ishod-stage-grid">
        {stages.map((stage) => (
          <article class="astro-card astro-ishod-stage-card">
            <p class="astro-ishod-stage-n">{stage.n}</p>
            <h3>{stage.t}</h3>
            <p><strong>Опора:</strong> {stage.r}</p>
            <p><strong>Масштаб:</strong> {stage.km}</p>
            <p><strong>Фаза:</strong> {stage.age}</p>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2>Сюжетные режимы будущей карты</h2>
      <div class="astro-card-grid astro-ishod-story-grid">
        {stories.map((story) => (
          <article class="astro-card astro-ishod-story-card">
            <h3>{story.label}</h3>
            <p>{story.description}</p>
            <p class="astro-ishod-story-meta">
              {story.place_ids ? `${story.place_ids.length} маршрутных места` : 'полный маршрут'}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2>Ключевые места</h2>
      <div class="astro-card-grid astro-ishod-place-grid">
        {prominentPlaces.map((place) => (
          <article class="astro-card astro-ishod-place-card">
            <div class="astro-ishod-place-head">
              <h3>{place.name}</h3>
              <span>{place.he}</span>
            </div>
            <p><strong>{place.kick}</strong></p>
            <p>{place.ep1}</p>
            <p>{place.id1} · {place.id2}</p>
          </article>
        ))}
      </div>
      <p class="astro-ishod-rest-note">
        Дальше по маршруту также уже размечены: {laterPlaces.map((place) => place.name).join(', ')}.
      </p>
    </section>

    <section>
      <h2>Почему эта карта важна</h2>
      <p>
        Исход — это не просто один переход через море. Это длинная библейская драма: Пасха, ропот, вода, манна, Синай,
        золотой телец, Кадеш, приговор сорока лет, смерть поколения Исхода и последний взгляд Моисея на землю обетованную.
        Если эта логика рвётся, карта превращается в набор pin-точек. Если сохраняется — она становится настоящим инструментом
        чтения Писания.
      </p>
      <p>
        Поэтому следующий шаг здесь должен быть не декоративным. Нужен такой же disciplined route-shell, как мы уже делаем для
        других Astro shadow pages: хорошая мобильная структура, честная работа со спорными локализациями, удобный вход в сюжетные
        режимы и pagefind/indexability без ощущения «это совсем другой сайт».
      </p>
    </section>

    <section class="astro-ishod-links">
      <a href="/karty/" class="astro-link-more">← Все карты</a>
      <a href="/about/" class="astro-link-more">О проекте →</a>
    </section>
  </section>
</BaseLayout>

<style>
  .astro-ishod-map-page {
    max-width: 980px;
  }

  .astro-ishod-map-page__header {
    text-align: center;
  }

  .astro-ishod-he {
    color: var(--astro-color-gold);
    letter-spacing: .22em;
    font-size: 1rem;
    margin: .75rem 0 1rem;
  }

  .astro-ishod-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 0 14px;
    margin: .5rem 0 1rem;
    border-radius: 999px;
    border: 1px solid rgba(212, 165, 116, .35);
    background: rgba(212, 165, 116, .08);
    color: var(--astro-color-gold);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .astro-ishod-note {
    margin-top: 1.5rem;
  }

  .astro-ishod-stage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }

  .astro-ishod-stage-card h3,
  .astro-ishod-story-card h3,
  .astro-ishod-place-card h3 {
    margin: 0 0 .5rem;
    font-family: var(--astro-font-serif);
    color: var(--astro-color-text);
  }

  .astro-ishod-stage-n {
    margin: 0 0 .5rem;
    color: var(--astro-color-gold);
    font-size: .75rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .astro-ishod-story-grid,
  .astro-ishod-place-grid {
    gap: 1rem;
  }

  .astro-ishod-story-meta {
    color: var(--astro-color-gold);
    font-size: .85rem;
  }

  .astro-ishod-place-head {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    align-items: baseline;
    margin-bottom: .5rem;
  }

  .astro-ishod-place-head span {
    color: var(--astro-color-gold);
    font-size: .85rem;
    letter-spacing: .08em;
  }

  .astro-ishod-rest-note {
    margin-top: 1rem;
    color: var(--astro-color-muted);
  }

  .astro-ishod-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .astro-ishod-links {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
