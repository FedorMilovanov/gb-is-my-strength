---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';

const canonical = `${SITE.url}/about/`;
const title = 'Об авторе — Фёдор Милованов | Господь Бог — Сила Моя';
const description = 'Фёдор Милованов — автор и редактор богословского проекта «Господь Бог — Сила Моя». О проекте, методологии подготовки материалов и редакционной политике.';
const ogTitle = 'Об авторе — Фёдор Милованов';
const ogDescription = 'Фёдор Милованов — автор-редактор богословского проекта «Господь Бог — Сила Моя». Создаёт авторские апологетические разборы и редактирует переводы зарубежных богословов.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': SITE.orgId,
      name: SITE.name,
      url: `${SITE.url}/`,
      logo: { '@type': 'ImageObject', url: `${SITE.url}/icons/icon-512.png`, width: 512, height: 512 },
      sameAs: ['https://t.me/fedormilovanov', 'https://vk.com/curtmf'],
    },
    {
      '@type': 'WebSite',
      '@id': SITE.websiteId,
      name: SITE.name,
      url: `${SITE.url}/`,
      inLanguage: 'ru',
      publisher: { '@id': SITE.orgId },
    },
    {
      '@id': `${canonical}#person`,
      '@type': 'Person',
      name: 'Фёдор Милованов',
      url: canonical,
      sameAs: ['https://t.me/fedormilovanov', 'https://vk.com/curtmf', 'https://www.youtube.com/@fedormilovanov'],
      worksFor: { '@id': SITE.orgId },
      jobTitle: 'Автор-редактор',
      knowsAbout: ['Библейская герменевтика', 'Апологетика', 'Евангельское богословие', 'Редактура богословских текстов'],
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'ru-RU',
      isPartOf: { '@id': SITE.websiteId },
      mainEntity: { '@id': `${canonical}#person` },
      breadcrumb: { '@id': `${canonical}#breadcrumbs` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'О проекте', item: canonical },
      ],
    },
  ],
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
  ogImage={`${SITE.url}/images/og-about-1200x630.webp`}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  jsonLd={jsonLd}
>
  <article class="astro-about" data-pagefind-body>
    <header>
      <h1>Фёдор Милованов</h1>
      <p>
        Автор-редактор проекта «Господь Бог — Сила Моя»: подготавливаю авторские богословские
        материалы, редактирую переводы и отвечаю за доктринальную точность опубликованных текстов.
      </p>
    </header>

    <section>
      <p>
        Меня зовут <strong>Фёдор Милованов</strong>. Я живу в Санкт-Петербурге с женой и дочерью и веду
        этот проект как собрание материалов для изучения Писания, а не как поток случайных публикаций.
      </p>
      <p>
        «Господь Бог — Сила Моя» (Авв. 3:19) задуман как место, где собраны материалы, действительно
        помогающие думать по Писанию: авторские разборы, переводы серьёзных зарубежных статей,
        экзегетические и апологетические тексты. Не для быстрого просмотра, а для тех, кто хочет дойти
        до сути и проверить основания.
      </p>
    </section>

    <section>
      <h2>Богословская позиция</h2>
      <p>
        Я придерживаюсь исторического евангельского христианства: богодухновенность и достаточность
        Священного Писания, спасение по благодати через веру в Иисуса Христа. В герменевтике —
        грамматико-исторический метод с последовательно-буквальным чтением текста, включая пророчество.
        В эсхатологии — буквальное тысячелетнее царство и различение Израиля и Церкви в Божьем замысле.
      </p>
      <p>
        Для меня это не «академизм ради академизма». Сайт задуман как попытка защищать истину и делать
        её понятной — тем, кто ищет, сомневается, спорит или хочет укрепиться в вере не на уровне лозунга,
        а на уровне текста и аргумента.
      </p>
    </section>

    <section>
      <h2>Как готовятся материалы</h2>
      <p>
        Я работаю в эпоху, когда ИИ стал реальным исследовательским инструментом — примерно так же,
        как когда-то конкорданс, библиотечный каталог или симфония Писания. Поэтому я использую его
        открыто и предпочитаю говорить об этом прямо, а не создавать ложное впечатление «ручной абсолютной
        чистоты» там, где реальный процесс устроен сложнее.
      </p>
      <p>
        Для авторских статей замысел и постановка задачи — мои. Я выбираю тему, определяю угол и аудиторию.
        Сбор источников может идти частично с помощью ИИ: поиск цитат, академических работ, исторических
        данных. Всё, что попадает в текст, я стараюсь верифицировать по первоисточникам.
      </p>
      <p>
        Структура и черновик — совместная работа: я задаю направление, ИИ помогает с формулировками.
        Затем я переписываю, дополняю и уточняю. Богословская выверка остаётся моей ответственностью:
        каждое утверждение о вере, Писании, церковной истории и доктрине проверяется лично и согласуется
        с историческим евангельским исповеданием. Финальная редакция и публикация — мои.
      </p>
      <p>
        Для переводов первичный перевод может выполнять ИИ. Я выступаю редактором: проверяю богословскую
        и терминологическую точность, исправляю ошибки, отсеиваю неверифицированные цитаты и в сложных
        местах перепроверяю один инструмент через другой. Если где-то я не проверил фрагмент достаточно
        тщательно, ответственность за это остаётся на мне.
      </p>
    </section>

    <section>
      <h2>О переводах</h2>
      <p>
        Переводные материалы на сайте — это не механическое копирование английского текста. Их задача —
        передать мысль автора на хорошем русском языке и при этом сохранить богословскую точность. Поэтому
        я оставляю за собой право редактировать стиль, уточнять термины, добавлять пояснения и при необходимости
        указывать, где перевод является смысловым.
      </p>
    </section>

    <section>
      <h2>Библейские ресурсы</h2>
      <p>
        Помимо этого сайта, я веду и другие площадки, где собраны проповеди, разборы текстов и материалы авторов,
        которых считаю верными Писанию: Джон МакАртур, Р. К. Спраул, Пол Вошер, Ричард Бокэм и другие. Общий
        принцип везде один: серьёзное, экзегетически честное и максимально проверяемое отношение к Слову Божьему.
      </p>
      <ul class="astro-link-list" aria-label="Библейские ресурсы Фёдора Милованова">
        <li><a href="https://www.youtube.com/@fedormilovanov" target="_blank" rel="noopener noreferrer">YouTube — Фёдор Милованов</a><span>Около 1700 проповедей и библейских разборов.</span></li>
        <li><a href="https://rutube.ru/channel/1876662/" target="_blank" rel="noopener noreferrer">Rutube</a><span>Зеркало видеоматериалов для российской платформы.</span></li>
        <li><a href="https://t.me/lordchrist" target="_blank" rel="noopener noreferrer">Telegram-канал @lordchrist</a><span>Фрагменты проповедей, цитаты и богословские заметки.</span></li>
        <li><a href="https://vk.com/the_lord_god_is_my_strength" target="_blank" rel="noopener noreferrer">ВКонтакте — группа</a><span>Сообщество людей, стоящих на верности Писанию.</span></li>
        <li><a href="https://dzen.ru/id/5e884de1e75b2d4c5c1bc29a" target="_blank" rel="noopener noreferrer">Яндекс Дзен</a><span>Статьи и материалы для читателей, приходящих через Яндекс.</span></li>
        <li><a href="https://www.facebook.com/groups/116164165395881" target="_blank" rel="noopener noreferrer">Facebook — группа</a><span>Открытая группа для библейски укоренённой веры.</span></li>
      </ul>
    </section>

    <section>
      <h2>Обратная связь</h2>
      <p>
        Если вы нашли фактическую ошибку, неточную ссылку, спорный перевод или место, где аргументация требует
        усиления, напишите мне. Проект живой: тексты уточняются, источники перепроверяются, формулировки могут
        меняться, если это помогает точнее служить истине.
      </p>
      <div class="astro-contact-grid" aria-label="Контакты">
        <a href="https://t.me/fedormilovanov" target="_blank" rel="noopener noreferrer me"><strong>Telegram</strong><span>@fedormilovanov</span></a>
        <a href="https://vk.com/curtmf" target="_blank" rel="noopener noreferrer me"><strong>ВКонтакте</strong><span>vk.com/curtmf</span></a>
        <a href="mailto:viktorcoy2012@gmail.com"><strong>Email</strong><span>viktorcoy2012@gmail.com</span></a>
        <a href="https://max.ru/u/f9LHodD0cOLbWadIz7D3ekYEeXl3i5UtoLwO8hWJLo8W_BIs6s4ytXxqD5Q" target="_blank" rel="noopener noreferrer me"><strong>Max</strong><span>профиль</span></a>
      </div>
      <p>
        Главная цель сайта — не произвести впечатление, а помочь читателю яснее видеть Писание, Христа и
        богословские основания веры. Если материал помогает думать глубже и честнее, значит проект выполняет
        свою задачу.
      </p>
    </section>

    <section class="astro-accuracy-block" aria-label="Обратная связь о неточностях">
      <h2>Нашли неточность?</h2>
      <p>Богословскую или техническую — напишите, исправим.</p>
      <div class="astro-contact-grid astro-contact-grid--compact">
        <a href="mailto:viktorcoy2012@gmail.com?subject=Неточность%20в%20материале"><strong>Email</strong><span>сообщить о неточности</span></a>
        <a href="https://t.me/fedormilovanov" target="_blank" rel="noopener noreferrer"><strong>Telegram</strong><span>быстрое сообщение</span></a>
      </div>
    </section>

    <blockquote class="astro-epigraph">
      <p>Господь Бог — сила моя: Он сделает ноги мои как у оленя и на высоты мои возведёт меня.</p>
      <cite>Аввакум 3:19</cite>
    </blockquote>
  </article>
</BaseLayout>
