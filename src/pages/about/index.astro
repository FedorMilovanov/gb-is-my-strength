---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadLegacyShadowPage } from '@/utils/legacyShadow';

// Visual-first migration: /about/ is now an Astro shadow wrapper around the
// production legacy page. The goal is near-100% visual parity before any future
// refactor. Do not replace this with generic Astro cards/layout unless the new
// version passes desktop+mobile screenshot parity and owner review.
const legacy = loadLegacyShadowPage('about/index.html');
---

<BaseLayout
  title={legacy.title}
  description={legacy.description}
  canonical={legacy.canonical}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
  ogImage={legacy.ogImage}
  ogImageAlt={legacy.ogImageAlt}
  ogTitle={legacy.ogTitle}
  ogDescription={legacy.ogDescription}
  ogType="profile"
  profileFirstName="Фёдор"
  profileLastName="Милованов"
  bodyClass={legacy.bodyClass}
  mainClass="astro-main astro-main--bare"
  hideHeader={true}
  hideFooter={true}
  headHtml={legacy.headHtml}
>
  <div class="astro-about-shadow" data-astro-shadow-route="about">
    <Fragment set:html={legacy.bodyHtml} />
  </div>
</BaseLayout>
