---
import { readFileSync } from 'node:fs';
import path from 'node:path';

// 100% visual-parity phase for /about/:
// Astro emits the legacy document structure directly. No BaseLayout and no
// extra global Astro CSS. Future component extraction must prove screenshot parity
// before replacing this full-document shadow.
const legacyHtml = readFileSync(path.join(process.cwd(), 'about/index.html'), 'utf8');
const headHtml = legacyHtml.match(/<head[^>]*>([\s\S]*?)<\/head>/i)?.[1] || '';
const bodyMatch = legacyHtml.match(/<body([^>]*)>([\s\S]*?)<\/body>/i);
const bodyAttrs = bodyMatch?.[1] || '';
const bodyHtml = bodyMatch?.[2] || '';
const bodyAttributes = Object.fromEntries(
  [...bodyAttrs.matchAll(/([\w:-]+)(?:="([^"]*)")?/g)].map((m) => [m[1], m[2] ?? ''])
);
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={bodyHtml} />
  </body>
</html>
