---
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';

// 100% visual-parity phase for /about/:
// Astro emits the legacy document structure directly. No BaseLayout and no
// extra global Astro CSS. Future component extraction must prove screenshot parity
// before replacing this full-document shadow.
const { headHtml, bodyHtml, bodyAttributes } = loadLegacyFullDocument('about/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={bodyHtml} />
  </body>
</html>
