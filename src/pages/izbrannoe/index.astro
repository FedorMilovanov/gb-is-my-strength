---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE.url}/izbrannoe/#webpage`,
  url: `${SITE.url}/izbrannoe/`,
  name: 'Избранное — Господь Бог — Сила Моя',
  description: 'Ваша личная подборка сохранённых статей. Хранится только в вашем браузере.',
  inLanguage: 'ru',
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---
<BaseLayout
  title="Избранное — Господь Бог — Сила Моя"
  description="Ваша личная подборка сохранённых статей. Хранится только в вашем браузере."
  canonical="/izbrannoe/"
  ogType="website"
  robots="noindex, follow"
  bodyClass="page-izbrannoe"
  mainClass="izbrannoe-main"
  jsonLd={jsonLd}
>
  <section class="izbrannoe-wrap">
    <header class="izbrannoe-head">
      <p class="izbrannoe-kicker">Личное</p>
      <h1>Избранное</h1>
      <p class="izbrannoe-sub" id="izbrannoeCount"></p>
    </header>

    <div class="izbrannoe-empty" id="izbrannoeEmpty" hidden>
      <p>Здесь пока пусто.</p>
      <p class="izbrannoe-empty-hint">Нажимайте кнопку <span class="izbrannoe-save-demo">Сохранить</span> (закладка) на любой статье — и она появится здесь.</p>
      <a class="izbrannoe-cta" href="/articles/">Перейти к статьям</a>
    </div>

    <div class="izbrannoe-grid" id="izbrannoeGrid"></div>

    <div class="izbrannoe-actions" id="izbrannoeActions" hidden>
      <button type="button" class="izbrannoe-clear" id="izbrannoeClear">Очистить всё</button>
    </div>
  </section>

  <script is:inline define:vars={{ FAV_KEY: 'gb-favorites' }}>
    (function () {
      var grid = document.getElementById('izbrannoeGrid');
      var empty = document.getElementById('izbrannoeEmpty');
      var count = document.getElementById('izbrannoeCount');
      var actions = document.getElementById('izbrannoeActions');
      var clearBtn = document.getElementById('izbrannoeClear');
      if (!grid || !empty) return;

      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function read() {
        try { return JSON.parse(localStorage.getItem(FAV_KEY)) || []; }
        catch (_) { return []; }
      }
      function write(list) {
        try { localStorage.setItem(FAV_KEY, JSON.stringify(list)); }
        catch (_) {}
      }
      function ruPlural(n, one, few, many) {
        var m = Math.abs(n) % 100, d = m % 10;
        if (m > 10 && m < 20) return many;
        if (d > 1 && d < 5) return few;
        if (d === 1) return one;
        return many;
      }

      function render() {
        var favs = read();
        grid.innerHTML = '';
        if (!favs.length) {
          empty.hidden = false;
          actions.hidden = true;
          count.textContent = '';
          return;
        }
        empty.hidden = true;
        actions.hidden = false;
        count.textContent = favs.length + ' ' + ruPlural(favs.length, 'статья', 'статьи', 'статей');

        favs.forEach(function (f) {
          var path = f.path || '/';
          if (path !== '/' && !/\/$/.test(path)) path = path + '/';
          var card = document.createElement('article');
          card.className = 'izbrannoe-card';
          var img = f.image
            ? '<div class="izbrannoe-card__img" style="background-image:url(' + esc(f.image) + ')"></div>'
            : '<div class="izbrannoe-card__img izbrannoe-card__img--empty"></div>';
          var section = f.section ? '<span class="izbrannoe-card__section">' + esc(f.section) + '</span>' : '';
          card.innerHTML =
            '<a class="izbrannoe-card__link" href="' + esc(path) + '">' + img + '</a>' +
            '<div class="izbrannoe-card__body">' +
              section +
              '<a class="izbrannoe-card__title" href="' + esc(path) + '">' + esc(f.title || 'Статья') + '</a>' +
              (f.description ? '<p class="izbrannoe-card__desc">' + esc(f.description) + '</p>' : '') +
              '<div class="izbrannoe-card__foot">' +
                '<a class="izbrannoe-card__open" href="' + esc(path) + '">Читать →</a>' +
                '<button type="button" class="izbrannoe-card__remove" data-path="' + esc(f.path) + '" aria-label="Убрать из избранного">Убрать</button>' +
              '</div>' +
            '</div>';
          grid.appendChild(card);
        });
      }

      grid.addEventListener('click', function (e) {
        var rm = e.target.closest('.izbrannoe-card__remove');
        if (!rm) return;
        var p = rm.getAttribute('data-path');
        var favs = read().filter(function (f) { return f.path !== p; });
        write(favs);
        render();
      });

      clearBtn.addEventListener('click', function () {
        if (!confirm('Удалить все статьи из избранного?')) return;
        write([]);
        render();
      });

      // re-render when returning from another tab (saved there)
      window.addEventListener('storage', function (e) {
        if (e.key === FAV_KEY) render();
      });
      render();
    })();
  </script>

  <style is:global>
    .izbrannoe-main { max-width: 1080px; margin: 0 auto; padding: clamp(24px, 5vw, 56px) clamp(16px, 4vw, 32px) 64px; }
    .izbrannoe-head { margin-bottom: 28px; }
    .izbrannoe-kicker { font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-accent, #8a5a2b); margin: 0 0 6px; }
    .izbrannoe-head h1 { font-family: var(--astro-font-serif, Georgia, serif); font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0; }
    .izbrannoe-sub { color: var(--color-text-muted, #6b7280); margin: 8px 0 0; }
    .izbrannoe-empty { text-align: center; padding: 56px 16px; color: var(--color-text-muted, #6b7280); }
    .izbrannoe-empty-hint { margin: 12px 0 20px; }
    .izbrannoe-save-demo { display: inline-block; padding: 1px 8px; border: 1px solid var(--color-border, rgba(0,0,0,.12)); border-radius: 6px; font-size: .85em; }
    .izbrannoe-cta { display: inline-block; padding: 10px 22px; background: var(--color-accent, #8a5a2b); color: #fff; border-radius: 10px; text-decoration: none; font-weight: 600; }
    .izbrannoe-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .izbrannoe-card { display: flex; border: 1px solid var(--color-border, rgba(0,0,0,.10)); border-radius: 14px; overflow: hidden; background: var(--color-surface, #fffdf8); }
    .izbrannoe-card__img { width: 96px; min-height: 96px; flex: 0 0 96px; background-size: cover; background-position: center; }
    .izbrannoe-card__img--empty { background: linear-gradient(135deg, var(--color-accent, #8a5a2b)22, transparent); }
    .izbrannoe-card__body { padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1; }
    .izbrannoe-card__section { font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; color: var(--color-accent, #8a5a2b); }
    .izbrannoe-card__title { font-weight: 700; color: var(--color-text, #1f2937); text-decoration: none; line-height: 1.3; }
    .izbrannoe-card__title:hover { text-decoration: underline; }
    .izbrannoe-card__desc { font-size: .85rem; color: var(--color-text-muted, #6b7280); margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .izbrannoe-card__foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-top: 6px; }
    .izbrannoe-card__open { font-size: .85rem; color: var(--color-accent, #8a5a2b); text-decoration: none; font-weight: 600; }
    .izbrannoe-card__remove { font-size: .8rem; color: var(--color-text-muted, #9ca3af); background: none; border: none; cursor: pointer; padding: 4px 8px; border-radius: 6px; }
    .izbrannoe-card__remove:hover { color: #b91c1c; background: rgba(185,28,28,.08); }
    .izbrannoe-actions { margin-top: 32px; text-align: center; }
    .izbrannoe-clear { padding: 8px 20px; font-size: .9rem; color: var(--color-text-muted, #6b7280); background: none; border: 1px solid var(--color-border, rgba(0,0,0,.12)); border-radius: 8px; cursor: pointer; }
    .izbrannoe-clear:hover { color: #b91c1c; border-color: rgba(185,28,28,.3); }
    @media (max-width: 540px) { .izbrannoe-card { flex-direction: column; } .izbrannoe-card__img { width: 100%; min-height: 120px; flex: 0 0 auto; } }
    .izbrannoe-card__link { display: block; flex: 0 0 96px; text-decoration: none; }
    @media (max-width: 540px) { .izbrannoe-card__link { flex: 0 0 auto; } }
  </style>
</BaseLayout>
