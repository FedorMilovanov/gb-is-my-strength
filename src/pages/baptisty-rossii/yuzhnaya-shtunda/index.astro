---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { SITE } from '@/data/site';

const entry = await getEntry('articles', 'yuzhnaya-shtunda');
if (!entry) throw new Error('Article entry not found: articles/yuzhnaya-shtunda');
const { Content } = await render(entry);
const canonical = `${SITE.url}/baptisty-rossii/yuzhnaya-shtunda/`;
---
<ArticleLayout
  entry={entry}
  canonical={canonical}
  robots="index, follow"
  pilot={false}
  intendedCanonical={canonical}
>
  <Content />
</ArticleLayout>
