---
/**
 * /baptisty-rossii/yuzhnaya-shtunda/ — РЕФАКТОРИНГ 6.0 native-shadow breakout.
 *
 * native-shadow recipe: GBS2 chrome preserved verbatim through
 * body-segment-{0,1}.html fragments; semantic <main id="main-content">
 * promoted to BaptistyRossiiArticleMain.astro.
 */
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';
import BaptistyRossiiArticleMain from '@/components/baptisty-rossii/BaptistyRossiiArticleMain.astro';
import segBefore from '@/components/baptisty-rossii/_legacy/yuzhnaya-shtunda/body-segment-0.html?raw';
import segAfter from '@/components/baptisty-rossii/_legacy/yuzhnaya-shtunda/body-segment-1.html?raw';
import mainHtml from '@/components/baptisty-rossii/_legacy/yuzhnaya-shtunda/main.html?raw';

const { headHtml, bodyAttributes } = loadLegacyFullDocument('baptisty-rossii/yuzhnaya-shtunda/index.html');
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={segBefore} />
    <BaptistyRossiiArticleMain legacyHtml={mainHtml} />
    <Fragment set:html={segAfter} />
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Баптисты России. Южная штунда и первые крещения
    </div>
  </body>
</html>
