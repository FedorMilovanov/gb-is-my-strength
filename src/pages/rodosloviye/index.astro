---
/**
 * /rodosloviye/ — strict-native route (Protected App Routes Native Astro Phase).
 *
 * Interactive React family tree.
 * Native RodosloviyePageHead (SEO/JSON-LD/meta) + Native RodosloviyeBody.
 * Uses site.css + React island internally without shadow legacy wrapping.
 */
import RodosloviyePageHead from '@/components/rodosloviye/RodosloviyePageHead.astro';
import RodosloviyeStyles from '@/components/rodosloviye/RodosloviyeStyles.astro';
import RodosloviyeBody from '@/components/rodosloviye/RodosloviyeBody.astro';
import GenealogyTree from '@/components/genealogy/GenealogyTree.tsx';
import type { Person, Era } from '@/components/genealogy/types';
import genealogyData from '../../../data/genealogy/genealogy.json';
import MobileChromePage from '@/components/article-pilots/_shared/MobileChromePage.astro';
import { mobileChromeFor } from '@/components/article-pilots/_shared/mobileChromeRegistry';

const persons = genealogyData.persons as unknown as Person[];
const eras = genealogyData.eras as unknown as Era[];

// Мобильная обвязка выбирается registry (движок «page»: Back·Home·Поиск сверху).
const mobileChrome = mobileChromeFor('/rodosloviye/');
---
<!DOCTYPE html>
<html lang="ru" data-theme="light">
  <head>
    <RodosloviyePageHead />
    <RodosloviyeStyles />
  </head>
  <body class="site-page">
    {mobileChrome?.enabled && mobileChrome.mount === 'registry' && mobileChrome.engine === 'page' && (
      <MobileChromePage backHref={mobileChrome.backHref ?? '/'} homeHref="../" />
    )}
    <RodosloviyeBody />
    <div id="genealogy-tree" class="genealogy-interactive-wrap" style="width: 100%; height: 85vh; min-height: 650px; border-top: 1px solid var(--border-color, #e2e8f0); margin-top: 2rem; position: relative;">
      <GenealogyTree client:only="react" persons={persons} eras={eras} />
    </div>
  </body>
</html>
