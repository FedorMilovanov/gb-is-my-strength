---
/**
 * /hard-texts/ — native landing for the book-shaped series
 * «Тайны человеческого сердца».
 *
 * Visible sections and structured data are driven by the active series config;
 * the retired hand-maintained three-part inventory must not return.
 */
import { assetUrl } from '@/lib/asset-version';
import HardTextsPageChrome from '@/components/hard-texts/HardTextsPageChrome.astro';
import HardTextsMain from '@/components/hard-texts/HardTextsMain.astro';
import HardTextsPageFooter from '@/components/hard-texts/HardTextsPageFooter.astro';
import MobileChromePage from '@/components/article-pilots/_shared/MobileChromePage.astro';
import { mobileChromeFor } from '@/components/article-pilots/_shared/mobileChromeRegistry';
import { HARD_TEXTS_SERIES } from '@/components/article-pilots/_shared/series/hardTextsSeriesConfig';
import ReaderPreferencesHead from '@/components/reader-platform/ReaderPreferencesHead.astro';

const mobileChrome = mobileChromeFor('/hard-texts/');
const canonicalUrl = 'https://gospod-bog.ru/hard-texts/';
const description = 'Книга статей о человеческом сердце: четыре главы о диагнозе греха, внутренней войне, перемене и жизни Духом, с библейским справочником и пастырскими разборами.';
const publishedPages = HARD_TEXTS_SERIES.items
  .filter((item) => item.tier !== 'chapter')
  .map((item) => ({
    '@type': 'Article',
    url: new URL(item.href, canonicalUrl).href,
    name: item.title,
  }));

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://gospod-bog.ru/#organization',
      name: 'Господь Бог — Сила Моя',
      url: 'https://gospod-bog.ru/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://gospod-bog.ru/icons/icon-512.png',
        width: 512,
        height: 512,
      },
      sameAs: ['https://t.me/fedormilovanov', 'https://vk.com/curtmf'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://gospod-bog.ru/#website',
      name: 'Господь Бог — Сила Моя',
      url: 'https://gospod-bog.ru/',
      inLanguage: 'ru',
      publisher: { '@id': 'https://gospod-bog.ru/#organization' },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl}#collectionpage`,
      name: 'Тайны человеческого сердца — книга статей',
      description,
      url: canonicalUrl,
      inLanguage: 'ru',
      author: { '@id': 'https://gospod-bog.ru/about/#person' },
      publisher: { '@id': 'https://gospod-bog.ru/#organization' },
      image: 'https://gospod-bog.ru/images/og-series-heart.webp',
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.h-hero-desc', '.summary-card', '[data-speakable]'],
      },
      hasPart: publishedPages,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumbs`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Господь Бог — Сила Моя',
          item: 'https://gospod-bog.ru/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Тайны человеческого сердца — книга статей',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'ImageObject',
      contentUrl: 'https://gospod-bog.ru/images/og-series-heart.webp',
      name: 'Тайны человеческого сердца',
      description: 'Книга библейских и пастырских разборов о человеческом сердце',
      creditText: 'gospod-bog.ru',
      creator: {
        '@type': 'Organization',
        name: 'Господь Бог — Сила Моя',
        url: 'https://gospod-bog.ru',
      },
      copyrightNotice: '© gospod-bog.ru',
      acquireLicensePage: 'https://gospod-bog.ru/about/',
    },
  ],
});
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://mc.yandex.ru" crossorigin />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com https://cdn.jsdelivr.net; img-src 'self' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com https://commons.wikimedia.org https://upload.wikimedia.org data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com wss://mc.yandex.ru wss://*.yandex.ru wss://mc.yandex.com wss://*.yandex.com https://huggingface.co; frame-src 'self' https://mc.yandex.ru https://*.yandex.ru https://mc.yandex.com https://*.yandex.com; object-src 'none'; base-uri 'self';" />
    <ReaderPreferencesHead />

    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#fdfcf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171411" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <title>Тайны человеческого сердца — книга статей | Господь Бог — Сила Моя</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Тайны человеческого сердца — книга статей" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Господь Бог — Сила Моя" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content="https://gospod-bog.ru/images/og-series-heart.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:alt" content="Тайны человеческого сердца — книга библейских разборов" />
    <meta name="author" content="Фёдор Милованов" />
    <meta name="keywords" content="сердце, Иеремия 17, Римлянам 7, Римлянам 8, новое сердце, освящение, уныние, скорбь, библейское богословие" />
    <meta name="geo.region" content="RU-SPE" />
    <meta name="geo.placename" content="Санкт-Петербург" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@FedorMilovanov" />
    <meta name="twitter:creator" content="@FedorMilovanov" />
    <meta name="twitter:title" content="Тайны человеческого сердца — книга статей" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image:alt" content="Тайны человеческого сердца — книга статей" />
    <meta name="twitter:image" content="https://gospod-bog.ru/images/og-series-heart.webp" />

    <link href="https://gospod-bog.ru/feed.xml" rel="alternate" title="Господь Бог — Сила Моя — RSS" type="application/rss+xml" />
    <link rel="icon" type="image/x-icon" href="https://gospod-bog.ru/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://gospod-bog.ru/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="https://gospod-bog.ru/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="120x120" href="https://gospod-bog.ru/favicon-120.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="https://gospod-bog.ru/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preload" as="style" href={assetUrl('fonts/fonts.css')} />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Lora/lora-cyrillic-400.woff2" crossorigin />
    <link rel="stylesheet" href={assetUrl('fonts/fonts.css')} />

    <script is:inline type="text/javascript">
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js?id=108353327','ym');
      ym(108353327,'init',{ssr:false,webvisor:true,clickmap:true,accurateTrackBounce:true,trackLinks:true,referrer:document.referrer,url:location.href});
    </script>
    <noscript><div><img decoding="async" src="https://mc.yandex.ru/watch/108353327" style="position:absolute;left:-9999px;" alt="" /></div></noscript>

    <link rel="stylesheet" href={assetUrl('css/site.css')} />
    <link rel="stylesheet" href={assetUrl('css/home.css')} />

    <script is:inline>
      window.SITE_CONFIG = {
        version: 1778943682,
        site: { id: 'gb-strength', name: 'Господь Бог — Сила Моя', baseUrl: 'https://gospod-bog.ru', locale: 'ru-RU', themeStorageKey: 'theme', debug: false },
        page: { type: 'series', id: 'hard-texts', title: 'Тайны человеческого сердца — книга статей' },
        features: { themeToggle: { enabled: true }, bookmarks: { enabled: false }, homepageResume: { enabled: false } }
      };
    </script>

    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <link rel="stylesheet" href={assetUrl('css/command-palette.css')} />
    <link rel="stylesheet" href={assetUrl('css/mobile-hotfix.css')} />
  </head>
  <body>
    <HardTextsPageChrome>
      {mobileChrome?.enabled && mobileChrome.mount === 'registry' && mobileChrome.engine === 'page' && (
        <MobileChromePage backHref={mobileChrome.backHref ?? '/'} homeHref="../" />
      )}
      <HardTextsMain />
      <HardTextsPageFooter />
    </HardTextsPageChrome>
  </body>
</html>
