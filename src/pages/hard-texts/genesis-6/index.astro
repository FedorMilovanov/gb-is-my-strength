---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MobileChromePage from '@/components/article-pilots/_shared/MobileChromePage.astro';
import Genesis6Hub from '@/components/article-pilots/genesis6/Genesis6Hub.astro';
import { SITE } from '@/data/site';
import { assetUrl } from '@/lib/asset-version';

const canonical = `${SITE.url}/hard-texts/genesis-6/`;
const title = 'Бытие 6, Енох, Иуда и Пётр — исследовательская серия';
const description = 'Исследовательская серия о сынах Божиих, нефилимах, 1 Енохе, Иуд. 6 и 14–15, 2 Пет. 2 и 1 Пет. 3–4: опубликованные разборы, рукописи и канонический аудит.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  name: title,
  description,
  url: canonical,
  inLanguage: 'ru',
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={`${SITE.url}/images/articles/genesis6/00-series-guide.webp`}
  ogImageType="image/webp"
  ogImageAlt="Путеводитель по серии о Бытии 6, Енохе, Иуде и Петре"
  ogImageWidth="1200"
  ogImageHeight="675"
  ogType="website"
  jsonLd={jsonLd}
  bodyClass="genesis6-hub-page"
  mainClass="genesis6-hub-main"
  legacyStylesheets={[assetUrl('css/home.css'), assetUrl('css/series-manuscript.css')]}
  footerNote="Бытие 6 · Енох · Иуда · Пётр"
>
  <MobileChromePage backHref="/hard-texts/" />
  <Genesis6Hub />
</BaseLayout>
