---
/**
 * /map/ — strict-native route (Protected App Routes Native Astro Phase).
 *
 * Interactive graph map of site connections.
 * Native MapPageHead (SEO/JSON-LD/meta) + Native MapBody.
 * Does NOT use global site.css/site.js to avoid breaking custom canvas.
 */
import MapPageHead from '@/components/map/MapPageHead.astro';
import MapStyles from '@/components/map/MapStyles.astro';
import MapBody from '@/components/map/MapBody.astro';
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <MapPageHead />
    <MapStyles />
  </head>
  <body>
    <!-- sr-only marker for local search index inclusion -->
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Карта связей сайта Господь Бог — Сила Моя. Интерактивная карта связей между статьями и сериями: библейские карты, баптисты России, Нагорная проповедь, Джон Гилл, экзегетика и богословие.
    </div>
    <MapBody />
  </body>
</html>
