---
/**
 * /map/ — strict-native-app research atlas.
 *
 * Native Astro shell and accessible server-rendered list. The graph runtime
 * fetches the canonical JSON source without raw HTML transport or set:html.
 */
import MapPageHead from '@/components/map/MapPageHead.astro';
import MapStyles from '@/components/map/MapStyles.astro';
import AtlasRelationStyles from '@/components/map/AtlasRelationStyles.astro';
import AtlasBody from '@/components/map/AtlasBody.astro';
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <MapPageHead />
    <MapStyles />
    <AtlasRelationStyles />
  </head>
  <body>
    <AtlasBody />
    <section class="sr-only" data-pagefind-body aria-label="Описание Атласа исследований">
      <h2>Атлас исследований сайта «Господь Бог — Сила Моя»</h2>
      <p>
        Масштабируемая карта объединяет серии, биографии, библейские карты и богословские исследования.
        Материалы можно искать, фильтровать по темам, рассматривать в виде графа или открывать в доступном списке.
      </p>
    </section>
  </body>
</html>
