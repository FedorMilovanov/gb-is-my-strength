---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadLegacyShadowPage } from '@/utils/legacyShadow';

// Visual-first migration: /biografii/ must preserve the legacy premium landing
// before any component refactor. The previous generic astro-card grid was a
// visual regression, especially because Gill must remain presented as a strong
// series entry rather than loose cards.
const legacy = loadLegacyShadowPage('biografii/index.html');
---

<BaseLayout
  title={legacy.title}
  description={legacy.description}
  canonical={legacy.canonical}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
  ogImage={legacy.ogImage}
  ogImageAlt={legacy.ogImageAlt}
  ogTitle={legacy.ogTitle}
  ogDescription={legacy.ogDescription}
  bodyClass={legacy.bodyClass}
  mainClass="astro-main astro-main--bare"
  hideHeader={true}
  hideFooter={true}
  headHtml={legacy.headHtml}
>
  <div class="astro-biografii-index-shadow" data-astro-shadow-route="biografii-index">
    <Fragment set:html={legacy.bodyHtml} />
  </div>
</BaseLayout>
