---
/**
 * /biografii/ — 100% native Astro rewrite.
 */
import BiografiiPageChrome from '@/components/biografii/BiografiiPageChrome.astro';
import BiografiiMain from '@/components/biografii/BiografiiMain.astro';
import BiografiiPageFooter from '@/components/biografii/BiografiiPageFooter.astro';
import MobileChromePage from '@/components/article-pilots/_shared/MobileChromePage.astro';
import { mobileChromeFor } from '@/components/article-pilots/_shared/mobileChromeRegistry';

// Мобильная обвязка выбирается registry (движок «page»: Back·Home·Поиск сверху).
const mobileChrome = mobileChromeFor('/biografii/');
---
<!DOCTYPE html>
<html lang="ru" class="">
  <head>
    <BiografiiPageChrome />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Перейти к содержимому</a>

    <div class="h-reading-progress" id="hReadingProgress" aria-hidden="true"></div>

    <nav class="h-navbar" id="hNavbar" role="navigation" aria-label="Основная навигация">
      <div class="h-navbar__inner">
        <a href="../" class="h-nav-logo" aria-label="Господь Бог — Сила Моя — на главную">
          <span class="h-nav-logo-main">Господь Бог</span>
          <span class="h-nav-logo-dash" aria-hidden="true">&nbsp;—&nbsp;</span>
          <span class="h-nav-logo-accent">Сила Моя</span>
        </a>
        <ul class="h-nav-links" role="list">
          <li><a href="../#publikacii">Публикации</a></li>
          <li><a href="../#razbor">Разбор заблуждений</a></li>
          <li><a href="./" aria-current="page">Биографии</a></li>
          <li><a href="../articles/">Все статьи</a></li>
          <li><a href="../about/">О проекте</a></li>
        </ul>
        <div class="mobile-controls">
          <button class="theme-toggle" id="themeToggle" type="button" aria-label="Переключить тему">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" /></svg>
          </button>
          <button class="h-mobile-menu-btn" id="hMobileMenuBtn" type="button" aria-label="Открыть меню" aria-expanded="false">
            <svg class="h-burger-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line class="burger-top" x1="3" y1="6" x2="21" y2="6" />
              <line class="burger-mid" x1="3" y1="12" x2="21" y2="12" />
              <line class="burger-bottom" x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </button>
        </div>
      </div>
    </nav>

    {mobileChrome?.enabled && mobileChrome.mount === 'registry' && mobileChrome.engine === 'page' && (
      <MobileChromePage backHref={mobileChrome.backHref ?? '/'} homeHref="../" />
    )}

    <div id="hMobileBackdrop" class="h-mobile-backdrop" aria-hidden="true"></div>

    <div class="h-mobile-nav" id="hMobileNav" aria-hidden="true">
      <a href="../#publikacii" data-close-nav>Публикации</a>
      <a href="../#razbor" data-close-nav>Разбор заблуждений</a>
      <a href="./" data-close-nav aria-current="page">Биографии</a>
      <a href="../articles/" data-close-nav>Все статьи</a>
      <a href="../about/" data-close-nav>О проекте</a>
    </div>

    <div class="home-v20 biografii-landing">
      <div class="home-content">

        <section class="h-hero" data-pagefind-body aria-label="Биографии служителей">
          <nav aria-label="Хлебные крошки" style="margin-bottom:16px;">
            <ol style="list-style:none;padding:0;margin:0;display:flex;align-items:center;gap:6px;font-size:13px;flex-wrap:wrap;">
              <li><a href="../" class="gb-text-link">Главная</a></li>
              <li aria-hidden="true" style="color:var(--h-muted);opacity:.5;">›</li>
              <li style="color:var(--h-text,var(--text));font-weight:500;"><span aria-current="page">Биографии служителей</span></li>
            </ol>
          </nav>

          <p class="h-hero-tagline">⊹ Христианское наследие ⊹</p>
          <h1 class="h-hero-title" tabindex="-1">
            <span class="h-title-static">Биографии</span><span class="h-title-dash" aria-hidden="true">&nbsp;</span><span class="h-title-accent">служителей</span>
          </h1>

          <p class="h-hero-desc">
            Хроника тех, кто проповедовал Евангелие, защищал истину, переводил Писание и платил цену за верность — от Ранней Церкви до наших дней. Здесь биографии соединены с историческим контекстом, без которого жизнь служителей читается слишком плоско.
          </p>
          <hr class="h-rule" aria-hidden="true" />

          <figure class="bio-cover" aria-label="Библиотека биографий: открытая Библия, перья, свеча и витражное окно">
            <picture>
              <source type="image/webp"
                      srcset="../images/og-biografii-600w.webp 600w,
                              ../images/og-biografii-900w.webp 900w,
                              ../images/og-biografii.webp 1200w"
                      sizes="(max-width: 720px) 100vw, min(1100px, 92vw)" />
              <img src="../images/og-biografii.jpg"
                   alt="Старинная библиотека: открытая Библия с пером и свечой на массивном столе, ряды кожаных томов, витражное окно с крестом, мягкий свет"
                   width="1200" height="630"
                   decoding="async" loading="eager" fetchpriority="high" />
            </picture>
            <figcaption class="bio-cover__caption">
              <span>Библиотека раздела</span>
              <span class="dot" aria-hidden="true"></span>
              <span>«Поминайте наставников ваших…» — Евр. 13:7</span>
            </figcaption>
          </figure>
        </section>

        <BiografiiMain />

        <BiografiiPageFooter />

      </div>
    </div>
  </body>
</html>
