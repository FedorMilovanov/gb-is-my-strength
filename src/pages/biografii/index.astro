---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';

const canonical = `${SITE.url}/biografii/`;
const title = 'Биографии служителей — христианское наследие | Господь Бог — Сила Моя';
const description = 'Биографии пасторов, богословов, реформаторов и миссионеров — от Ранней Церкви до XXI века. Жизнь и труды тех, кто отстаивал истину и проповедовал Евангелие.';
const eras = [
  { title: 'Ранняя Церковь', period: 'I–V вв.', text: 'Апостолы, мученики и Отцы Церкви, заложившие основы веры, исповедания, богословского языка и церковной стойкости перед давлением империи.' },
  { title: 'Средние века', period: 'VI–XIV вв.', text: 'Монастырское движение, схоластика, миссионерские труды, богословские споры и борьба за чистоту Евангелия в сложной церковной истории.' },
  { title: 'Реформация', period: 'XV–XVII вв.', text: 'Великий перелом: возвращение к Писанию, оправдание верой, перевод Библии, исповедания Реформации и рождение протестантского мира.' },
  { title: 'Века Пробуждений', period: 'XVIII в.', text: 'Эпоха проповеди, миссии и богословской полемики. Здесь сейчас раскрывается серия о Джоне Гилле — пасторе, экзегете и баптистском богослове XVIII века.' },
  { title: 'XIX век', period: 'XIX в.', text: 'Рассвет миссий, великие кафедры, новые богословские вызовы, переводческие труды, проповедь городам и формирование современных евангельских движений.' },
  { title: 'XX–XXI вв.', period: 'XX–XXI вв.', text: 'Служители, богословы, пасторы и миссионеры, формирующие облик живой Церкви в мире войн, идеологий, секуляризации и новых миссионерских возможностей.' },
];
const gillCards = [
  ['Джон Гилл: исторический контекст', '/articles/dzhon-gill-istoricheskiy-kontekst/', 'Диссентеры, Саутварк, Goat’s Yard, Картер-Лейн, книжная культура и историческая плотность биографии.'],
  ['Джон Гилл. Часть I: Человек', '/articles/dzhon-gill-chast-1-chelovek/', 'Кеттеринг, самообразование, обращение, семья, первые проповеди и рукоположение в Хорслидауне.'],
  ['Джон Гилл. Часть II: Учёный', '/articles/dzhon-gill-chast-2-uchenyi/', 'Экзегеза, раввинистика, девятитомный комментарий, Троица, полемика и богословская система.'],
  ['Джон Гилл. Часть III: Наследие', '/articles/dzhon-gill-chast-3-nasledie/', 'Сперджен, Америка, гиперкальвинизм, ислам, память, критика и современная реабилитация.'],
  ['Джон Гилл: справочник', '/articles/dzhon-gill-spravochnik/', 'Хронология, основные труды, Body of Divinity, спорные темы, словарь эпохи и источники.'],
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': `${canonical}#collectionpage`, url: canonical, name: title, description, inLanguage: 'ru', isPartOf: { '@id': SITE.websiteId }, publisher: { '@id': SITE.orgId }, image: `${SITE.url}/images/og-biografii.webp` },
    { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumbs`, itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Биографии служителей', item: canonical },
    ] },
  ],
};
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={`${SITE.url}/images/og-biografii.webp`} ogTitle="Биографии служителей — христианское наследие" ogDescription={description} jsonLd={jsonLd}>
  <section class="astro-page astro-biografii-index" data-pagefind-body>
    <header class="astro-page__header">
      <p class="astro-eyebrow">Христианское наследие</p>
      <h1>Биографии служителей</h1>
      <p>{description}</p>
      <p>Раздел собирает жизни тех, кто проповедовал Евангелие, защищал истину, переводил Писание, строил церкви и платил цену за верность. Биография здесь читается не как набор дат, а как соединение характера, богословия, церковного контекста, города, книг, споров и наследия.</p>
      <p>Сейчас основной опубликованный блок раздела — серия о Джоне Гилле. Остальные эпохи остаются обозначенными как архивные направления для будущих материалов, чтобы читатель видел карту отдела и понимал, куда будет расширяться библиотека.</p>
      <p>Для каждой будущей биографии важны несколько слоёв: личная история, церковная среда, ключевые труды, богословские споры, влияние на учеников и честная оценка слабых мест. Поэтому раздел не должен превращаться в галерею героев без контекста: верность служителя видна именно там, где его жизнь встречается с реальными испытаниями эпохи.</p>
      <p>Биографический материал особенно полезен, когда помогает не поклоняться людям, а подражать вере, видеть Божий промысел и проверять собственное служение. В этом смысле раздел связан со всеми остальными частями сайта: статьями, картами, историей церкви, пастырскими предупреждениями и богословскими справочниками.</p>
    </header>

    <section class="astro-card" aria-label="Последние добавленные материалы">
      <p class="astro-eyebrow">Последние добавленные материалы</p>
      <div class="astro-card-grid">
        {gillCards.map(([cardTitle, href, text]) => <article class="astro-card"><h2><a href={href}>{cardTitle}</a></h2><p>{text}</p></article>)}
      </div>
    </section>

    <section class="astro-card-grid astro-era-grid" aria-label="Эпохи биографий">
      {eras.map((era) => (
        <article class="astro-card">
          <p class="astro-eyebrow">{era.period}</p>
          <h2>{era.title}</h2>
          <p>{era.text}</p>
          <p><strong>Архив эпохи:</strong> материалы в подготовке, кроме опубликованного блока XVIII века.</p>
        </article>
      ))}
    </section>

    <section class="astro-card">
      <h2>Знаете служителя, чья биография достойна отдела?</h2>
      <p>Проект открыт к предложениям: важны не только известные имена, но и верные служители, чьи труды помогают Церкви помнить Божью благодать в истории.</p>
    </section>
  </section>
</BaseLayout>
