---
import HermenevtikaPageHead from '@/components/article-pilots/hermenevtika/HermenevtikaPageHead.astro';
import HermenevtikaBody from '@/components/article-pilots/hermenevtika/HermenevtikaBody.astro';
---
<!DOCTYPE html>
<html lang="ru">">
  <head>
    <HermenevtikaPageHead />
    <style is:global>
      /* Static source footnotes are readable hover cards. The shared glossary
         child-only pointer policy must not make the card body transparent to the pointer. */
      html body > .tooltip.gb-floating-tip.is-open {
        pointer-events: auto !important;
      }
    </style>
  </head>
  <body class="gbs-paper">
    <HermenevtikaBody />
  </body>
</html>
