---
import { getCollection } from 'astro:content';
import Content from '@/content/articles/steven-lawson-samoobman-i-publichnyy-golos.mdx';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import LawsonPageChrome from '@/components/article-pilots/lawson/LawsonPageChrome.astro';
import { SITE } from '@/data/site';

const slug = 'steven-lawson-samoobman-i-publichnyy-golos';
const entries = await getCollection('articles');
const entry = entries.find(({ data }) => data.slug === slug);

if (!entry) {
  throw new Error(`Missing article content entry: ${slug}`);
}

const canonical = `${SITE.url}/articles/${slug}/`;
---

<ArticleLayout
  entry={entry}
  canonical={canonical}
  mainClass="astro-main article-main--hrail"
  mainAttrs={{ 'data-reader-rail-main': true }}
>
  <LawsonPageChrome slot="chrome" />
  <Content />
</ArticleLayout>
