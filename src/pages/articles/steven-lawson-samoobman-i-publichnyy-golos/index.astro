---
import { getCollection } from 'astro:content';
import Content from '@/content/articles/steven-lawson-samoobman-i-publichnyy-golos.mdx';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import LawsonPageChrome from '@/components/article-pilots/lawson/LawsonPageChrome.astro';
import { SITE } from '@/data/site';

const slug = 'steven-lawson-samoobman-i-publichnyy-golos';
const entries = await getCollection('articles');
const entry = entries.find(({ data }) => data.slug === slug);

if (!entry) {
  throw new Error(`Missing article content entry: ${slug}`);
}

const canonical = `${SITE.url}/articles/${slug}/`;
---

<ArticleLayout
  entry={entry}
  canonical={canonical}
  mainClass="astro-main article-main--hrail lawson-news-edition"
  mainAttrs={{ 'data-reader-rail-main': true }}
  hideHeader
  extraFontPreloads={[
    '/fonts/Lora/lora-latin-400.woff2',
    '/fonts/Lora/lora-cyrillic-600.woff2',
    '/fonts/Lora/lora-latin-600.woff2',
  ]}
>
  <LawsonPageChrome slot="chrome" title={entry.data.h1 || entry.data.title} readingMinutes={entry.data.readingTime} />
  <nav class="lawson-journal-return" aria-label="Навигация журнала" data-pagefind-ignore>
    <a href="/journal/"><span aria-hidden="true">←</span> В журнал</a>
    <span class="lawson-journal-kind">Документальное исследование</span>
  </nav>
  <Content />
</ArticleLayout>
