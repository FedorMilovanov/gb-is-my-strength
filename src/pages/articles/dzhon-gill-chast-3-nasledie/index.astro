---
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';

// Refactoring 5.0 visual-first migration: /articles/dzhon-gill-chast-3-nasledie/ must preserve the legacy
// premium visual world until screenshot parity and owner review approve a
// componentized Astro replacement.
const { headHtml, bodyHtml, bodyAttributes } = loadLegacyFullDocument('articles/dzhon-gill-chast-3-nasledie/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <!-- Pagefind search data: full-document visual shadow keeps legacy markup, so search text is explicit. -->
    <div class="sr-only" data-pagefind-body>
      Джон Гилл часть III: Наследие. Полемика, память, влияние, баптистская традиция, Сперджен, научная оценка и значение трудов Гилла.
    </div>
    <Fragment set:html={bodyHtml} />
  </body>
</html>
