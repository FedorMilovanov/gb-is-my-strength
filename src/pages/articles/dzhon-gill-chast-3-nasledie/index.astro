---
import GillPart3PageHead from '@/components/article-pilots/gill-part3/GillPart3PageHead.astro';
import GillPart3PageChrome from '@/components/article-pilots/gill-part3/GillPart3PageChrome.astro';
import GillPart3MainShell from '@/components/article-pilots/gill-part3/GillPart3MainShell.astro';
import { GILL_PAGE_DATA } from '@/components/article-pilots/gill-series/gillSeriesData';

const pageData = GILL_PAGE_DATA.part3;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <GillPart3PageHead />
  </head>
  <body
    class="gbs-world"
    data-gbs2-series="dzhon-gill"
    data-gbs2-done-min={pageData.readingProgressDoneMin}
    data-gbs2-part-min={pageData.readingProgressPartMin}
    data-gbs2-total-min={pageData.readingProgressTotalMin}
  >
    <GillPart3PageChrome>
      <GillPart3MainShell />
    </GillPart3PageChrome>
  </body>
</html>
