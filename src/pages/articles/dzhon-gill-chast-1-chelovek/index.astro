---
import GillPart1PageHead from '@/components/article-pilots/gill-part1/GillPart1PageHead.astro';
import GillPart1PageChrome from '@/components/article-pilots/gill-part1/GillPart1PageChrome.astro';
import GillPart1MainShell from '@/components/article-pilots/gill-part1/GillPart1MainShell.astro';
import { GILL_PAGE_DATA } from '@/components/article-pilots/gill-series/gillSeriesData';

const pageData = GILL_PAGE_DATA.part1;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <GillPart1PageHead />
  </head>
  <body
    class="gbs-world"
    data-gbs2-series="dzhon-gill"
    data-gbs2-done-min={pageData.readingProgressDoneMin}
    data-gbs2-part-min={pageData.readingProgressPartMin}
    data-gbs2-total-min={pageData.readingProgressTotalMin}
  >
    <GillPart1PageChrome>
      <GillPart1MainShell />
    </GillPart1PageChrome>
  </body>
</html>
