---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { SITE } from '@/data/site';

const entry = await getEntry('articles', 'dzhon-gill-chast-1-chelovek');
if (!entry) throw new Error('Article entry not found: articles/dzhon-gill-chast-1-chelovek');
const { Content } = await render(entry);
const canonical = `${SITE.url}/articles/dzhon-gill-chast-1-chelovek/`;
---
<ArticleLayout
  entry={entry}
  canonical={canonical}
  robots="index, follow"
  pilot={false}
  intendedCanonical={canonical}
>
  <Content />
</ArticleLayout>
