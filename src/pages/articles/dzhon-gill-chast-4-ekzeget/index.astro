---
import GillPart4PageHead from '@/components/article-pilots/gill-part4/GillPart4PageHead.astro';
import GillPart4PageChrome from '@/components/article-pilots/gill-part4/GillPart4PageChrome.astro';
import GillPart4MainShell from '@/components/article-pilots/gill-part4/GillPart4MainShell.astro';
import { GILL_PAGE_DATA } from '@/components/article-pilots/gill-series/gillSeriesData';

const pageData = GILL_PAGE_DATA.part4;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <GillPart4PageHead />
  </head>
  <body
    class="gbs-world"
    data-gbs2-series="dzhon-gill"
    data-gbs2-done-min={pageData.readingProgressDoneMin}
    data-gbs2-part-min={pageData.readingProgressPartMin}
    data-gbs2-total-min={pageData.readingProgressTotalMin}
  >
    <GillPart4PageChrome>
      <GillPart4MainShell />
    </GillPart4PageChrome>
  </body>
</html>
