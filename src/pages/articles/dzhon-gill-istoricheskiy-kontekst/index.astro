---
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';
import GillContextMainShell from '@/components/article-pilots/gill-context/GillContextMainShell.astro';
import GillContextPageChrome from '@/components/article-pilots/gill-context/GillContextPageChrome.astro';

// Refactoring 6.0 Gill: componentized shadow-breakout for the
// historical-context route. Preserve the legacy GBS2 visual world while
// giving the page Astro seams that can be promoted section-by-section.
const { headHtml, bodyAttributes } = loadLegacyFullDocument('articles/dzhon-gill-istoricheskiy-kontekst/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <!-- Pagefind search data: visual shadow keeps legacy markup without data-pagefind-body, so search text is explicit. -->
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Джон Гилл: исторический контекст. Мир пуритан и баптистов XVIII века, Лондон, диссентеры, баптисты, Уайтфилд, Уэсли, кальвинизм и история служения.
    </div>
    <GillContextPageChrome>
      <GillContextMainShell />
    </GillContextPageChrome>
  </body>
</html>
