---
import GillContextPageHead from '@/components/article-pilots/gill-context/GillContextPageHead.astro';
import GillContextPageChrome from '@/components/article-pilots/gill-context/GillContextPageChrome.astro';
import GillContextMainShell from '@/components/article-pilots/gill-context/GillContextMainShell.astro';
import { GILL_PAGE_DATA } from '@/components/article-pilots/gill-series/gillSeriesData';

const pageData = GILL_PAGE_DATA.context;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <GillContextPageHead />
  </head>
  <body
    class="gbs-world"
    data-gbs2-series="dzhon-gill"
    data-gbs2-done-min={pageData.readingProgressDoneMin}
    data-gbs2-part-min={pageData.readingProgressPartMin}
    data-gbs2-total-min={pageData.readingProgressTotalMin}
  >
    <GillContextPageChrome>
      <GillContextMainShell />
    </GillContextPageChrome>
  </body>
</html>
