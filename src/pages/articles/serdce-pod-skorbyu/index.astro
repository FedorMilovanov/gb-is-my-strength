---
import SerdceSkorbPageHead from '@/components/article-pilots/serdce-skorb/SerdceSkorbPageHead.astro';
import SerdceSkorbBody from '@/components/article-pilots/serdce-skorb/SerdceSkorbBody.astro';
import HeartSeriesSocialMeta from '@/components/article-pilots/_shared/heart/HeartSeriesSocialMeta.astro';
import { HARD_TEXTS_SERIES } from '@/components/article-pilots/_shared/series/hardTextsSeriesConfig';
const p = HARD_TEXTS_SERIES.pages['skorb'];
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <SerdceSkorbPageHead />
    <HeartSeriesSocialMeta />
  </head>
  <body class="gbs-world" data-gbs2-series="hard-texts" data-gbs2-done-min={p.readingProgressDoneMin} data-gbs2-part-min={p.readingProgressPartMin} data-gbs2-total-min={p.readingProgressTotalMin}>
    <SerdceSkorbBody />
  </body>
</html>
