---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { SITE } from '@/data/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  // Only return paths for the ones we have actually migrated and are ready for shadow ownership
  const migratedArticles = articles.filter((entry: any) => entry.id === 'dzhon-gill-spravochnik');
  return migratedArticles.map((entry: any) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = `${SITE.url}/articles/${entry.id}/`;
---
<ArticleLayout
  entry={entry}
  canonical={canonical}
>
  <Content />
</ArticleLayout>
