---
import GillSpravochnikPageHead from '@/components/article-pilots/gill-spravochnik/GillSpravochnikPageHead.astro';
import GillSpravochnikPageChrome from '@/components/article-pilots/gill-spravochnik/GillSpravochnikPageChrome.astro';
import GillSpravochnikMainShell from '@/components/article-pilots/gill-spravochnik/GillSpravochnikMainShell.astro';
import { GILL_PAGE_DATA } from '@/components/article-pilots/gill-series/gillSeriesData';

const pageData = GILL_PAGE_DATA.spravochnik;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <GillSpravochnikPageHead />
  </head>
  <body
    class="gbs-world"
    data-gbs2-series="dzhon-gill"
    data-gbs2-done-min={pageData.readingProgressDoneMin}
    data-gbs2-part-min={pageData.readingProgressPartMin}
    data-gbs2-total-min={pageData.readingProgressTotalMin}
  >
    <GillSpravochnikPageChrome>
      <GillSpravochnikMainShell />
    </GillSpravochnikPageChrome>
  </body>
</html>
