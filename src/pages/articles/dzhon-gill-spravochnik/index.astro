---
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';

// Refactoring 5.0 visual-first migration: /articles/dzhon-gill-spravochnik/ must preserve the legacy
// premium visual world until screenshot parity and owner review approve a
// componentized Astro replacement.
const { headHtml, bodyHtml, bodyAttributes } = loadLegacyFullDocument('articles/dzhon-gill-spravochnik/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <!-- Pagefind search data: full-document visual shadow keeps legacy markup, so search text is explicit. -->
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Джон Гилл: справочник. Хронология, труды, источники, издания, ссылки, навигация по серии и проверяемые материалы о жизни и наследии Гилла.
    </div>
    <Fragment set:html={bodyHtml} />
  </body>
</html>
