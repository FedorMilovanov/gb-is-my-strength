---
import KrajnePageHead from '@/components/article-pilots/krajne/KrajnePageHead.astro';
import KrajneBody from '@/components/article-pilots/krajne/KrajneBody.astro';
import { heartProgress } from '@/components/article-pilots/_shared/heartSeriesData';
const hp = heartProgress('krajne');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <KrajnePageHead />
  </head>
  <body class="gbs-world" data-gbs2-series="hard-texts" data-gbs2-done-min={hp.doneMin} data-gbs2-part-min={hp.partMin} data-gbs2-total-min={hp.totalMin}>
    <KrajneBody />
  </body>
</html>
