---
import StaryeDorozhkiPageHead from '@/components/article-pilots/starye-dorozhki/StaryeDorozhkiPageHead.astro';
import StaryeDorozhkiBody from '@/components/article-pilots/starye-dorozhki/StaryeDorozhkiBody.astro';
import { HARD_TEXTS_SERIES } from '@/components/article-pilots/_shared/series/hardTextsSeriesConfig';
const p = HARD_TEXTS_SERIES.pages['dorozhki'];
import HeartSeriesSocialImageMeta from '@/components/seo/HeartSeriesSocialImageMeta.astro';
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <StaryeDorozhkiPageHead />
    <HeartSeriesSocialImageMeta />
  </head>
  <body class="gbs-world" data-gbs2-series="hard-texts" data-gbs2-done-min={p.readingProgressDoneMin} data-gbs2-part-min={p.readingProgressPartMin} data-gbs2-total-min={p.readingProgressTotalMin}>
    <StaryeDorozhkiBody />
  </body>
</html>
