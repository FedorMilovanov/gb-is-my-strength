---
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';

// Refactoring 5.0 visual-first migration: /articles/dzhon-gill-chast-2-uchenyi/ must preserve the legacy
// premium visual world until screenshot parity and owner review approve a
// componentized Astro replacement.
const { headHtml, bodyHtml, bodyAttributes } = loadLegacyFullDocument('articles/dzhon-gill-chast-2-uchenyi/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <!-- Pagefind search data: full-document visual shadow keeps legacy markup, so search text is explicit. -->
    <div class="sr-only" data-pagefind-body>
      Джон Гилл часть II: Учёный. Экзегеза, иврит, Талмуд, комментарии, Body of Divinity, богословская система и работа с источниками.
    </div>
    <Fragment set:html={bodyHtml} />
  </body>
</html>
