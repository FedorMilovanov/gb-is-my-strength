---
import GillPart2PageHead from '@/components/article-pilots/gill-part2/GillPart2PageHead.astro';
import GillPart2PageChrome from '@/components/article-pilots/gill-part2/GillPart2PageChrome.astro';
import GillPart2MainShell from '@/components/article-pilots/gill-part2/GillPart2MainShell.astro';
import { GILL_PAGE_DATA } from '@/components/article-pilots/gill-series/gillSeriesData';

const pageData = GILL_PAGE_DATA.part2;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <GillPart2PageHead />
  </head>
  <body
    class="gbs-world"
    data-gbs2-series="dzhon-gill"
    data-gbs2-done-min={pageData.readingProgressDoneMin}
    data-gbs2-part-min={pageData.readingProgressPartMin}
    data-gbs2-total-min={pageData.readingProgressTotalMin}
  >
    <GillPart2PageChrome>
      <GillPart2MainShell />
    </GillPart2PageChrome>
  </body>
</html>
