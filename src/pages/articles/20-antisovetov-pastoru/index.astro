---
import SeriesArticleLayout from '@/layouts/SeriesArticleLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('articles', '20-antisovetov-pastoru');
if (!entry) return Astro.redirect('/404');

const seriesMeta = {
  seriesSlug: 'pastor-series',
  seriesTitle: '20 антисоветов пастору',
  seriesKicker: 'Серия · Пасторство',
  seriesEraRange: 'Практическое руководство',
  seriesEras: []
};
---
<SeriesArticleLayout 
  entry={entry} 
  canonical="https://gospod-bog.ru/articles/20-antisovetov-pastoru/"
  {...seriesMeta}
>
  {/* The content is rendered by the layout via <slot /> or entry.render() */}
</SeriesArticleLayout>
