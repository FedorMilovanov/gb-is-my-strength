---
import AntisovetovPageHead from '@/components/article-pilots/antisovetov/AntisovetovPageHead.astro';
import AntisovetovBody from '@/components/article-pilots/antisovetov/AntisovetovBody.astro';
import { PASTOR_SERIES } from '@/components/article-pilots/_shared/series/pastorSeriesConfig';
const progress = PASTOR_SERIES.pages.antisovetov;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <AntisovetovPageHead />
  </head>
  <body class="gbs-world" data-series-theme="manuscript" data-gbs2-series="pastor-series" data-gbs2-done-min={progress.readingProgressDoneMin} data-gbs2-part-min={progress.readingProgressPartMin} data-gbs2-total-min={progress.readingProgressTotalMin}>
    <AntisovetovBody />
  </body>
</html>
