---
/**
 * /articles/kod-da-vinchi/ — РЕФАКТОРИНГ 6.0 Phase 5 COMPLETE.
 *
 * 100% Astro-owned page structure. Zero raw legacy HTML fragments.
 * Shadow-breakout: CSS @layer + JS modules pilot.
 * Uses site-layered.css instead of site.css.
 * Loads site-modules.js alongside site.js for extracted module testing.
 */
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';
import { readFileSync, existsSync } from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import KodDaVinchiPageChrome from '@/components/article-pilots/kod-da-vinchi/KodDaVinchiPageChrome.astro';
import KodDaVinchiMainShell from '@/components/article-pilots/kod-da-vinchi/KodDaVinchiMainShell.astro';
import KodDaVinchiPageFooter from '@/components/article-pilots/kod-da-vinchi/KodDaVinchiPageFooter.astro';

function md5short(rel: string) {
  const abs = path.join(process.cwd(), rel);
  if (!existsSync(abs)) return '';
  return createHash('md5').update(readFileSync(abs)).digest('hex').slice(0, 8);
}

const layeredCssHash = md5short('css/site-layered.css');
const siteModulesHash = md5short('js/site-modules.js');

let { headHtml, bodyAttributes } = loadLegacyFullDocument('articles/kod-da-vinchi/index.html');

// Phase 2 CSS pilot: replace site.css → site-layered.css on this route only
headHtml = headHtml.replace(
  /css\/site\.css\?v=[\w]+/,
  `css/site-layered.css?v=${layeredCssHash}`
);
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Страница проекта Господь Бог — Сила Моя. Раздел: articles.
    </div>
    <KodDaVinchiPageChrome />
    <KodDaVinchiMainShell />
    <KodDaVinchiPageFooter />
    <!-- Phase 3 JS pilot: extracted modules with AbortController cleanup -->
    <script is:inline src={`../../js/site-modules.js?v=${siteModulesHash}`} defer></script>
  </body>
</html>
