---
import NovoeSerdcePageHead from '@/components/article-pilots/novoe-serdce/NovoeSerdcePageHead.astro';
import NovoeSerdceBody from '@/components/article-pilots/novoe-serdce/NovoeSerdceBody.astro';
import { heartProgress } from '@/components/article-pilots/_shared/heartSeriesData';
const hp = heartProgress('novoe');
import HeartSeriesSocialImageMeta from '@/components/seo/HeartSeriesSocialImageMeta.astro';
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <NovoeSerdcePageHead />
    <HeartSeriesSocialImageMeta />
  </head>
  <body class="gbs-world" data-gbs2-series="hard-texts" data-gbs2-done-min={hp.doneMin} data-gbs2-part-min={hp.partMin} data-gbs2-total-min={hp.totalMin}>
    <NovoeSerdceBody />
  </body>
</html>
