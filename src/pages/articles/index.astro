---
/**
 * /articles/ — 100% native catalog page (LANE visual-fix-articles-index-2026-06-23).
 *
 * Scope: catalog index only, not /articles/<slug>/ MDX article pages.
 * Replaces the previous native-shadow recipe with named Astro components:
 *   - ArticlesPageChrome: document head + body chrome;
 *   - ArticlesMain: catalog semantic content, backed by data/series.json;
 *   - ArticlesPageFooter: feedback/footer/runtime tail.
 *
 * No legacy full-document loader, raw HTML imports or legacy fragment directory.
 */
import ArticlesPageChrome from '@/components/articles/ArticlesPageChrome.astro';
import ArticlesMain from '@/components/articles/ArticlesMain.astro';
import ArticlesPageFooter from '@/components/articles/ArticlesPageFooter.astro';
---
<!DOCTYPE html>
<ArticlesPageChrome>
  <ArticlesMain />
  <ArticlesPageFooter />
  <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
    Каталог статей Господь Бог — Сила Моя. Все статьи: Джон Гилл, Нагорная проповедь, апологетика, экзегетика, богословие, пасторская серия, трудные тексты и библейские исследования.
  </div>
</ArticlesPageChrome>
