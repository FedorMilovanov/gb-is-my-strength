---
/**
 * /articles/ — existing strict-native catalog, selected №8 edition consumer.
 *
 * Scope: catalog index only, not /articles/<slug>/ MDX article pages.
 * Replaces the previous native-shadow recipe with named Astro components:
 *   - ArticlesPageChrome: document head + body chrome;
 *   - ArticlesMain: catalog projection from search-manifest ∩ page-ownership;
 *   - ArticlesPageFooter: feedback/footer/runtime tail.
 *
 * No legacy full-document loader, raw HTML imports or legacy fragment directory.
 */
import ArticlesPageChrome from '@/components/articles/ArticlesPageChrome.astro';
import ArticlesMain from '@/components/articles/ArticlesMain.astro';
import ArticlesPageFooter from '@/components/articles/ArticlesPageFooter.astro';
import JournalEditorialShell from '@/components/journal/JournalEditorialShell.astro';
import { mobileChromeFor } from '@/components/article-pilots/_shared/mobileChromeRegistry';

// Мобильная обвязка выбирается registry (Mobile Chrome Platform, движок
// «page»: Back·Home·Глобальный Поиск сверху), не по pathname в компоненте.
const mobileChrome = mobileChromeFor('/articles/');
---
<!DOCTYPE html>
<ArticlesPageChrome>
  <JournalEditorialShell
    kind="articles"
    backHref={mobileChrome?.backHref ?? '/'}
    mobileChromeEnabled={Boolean(mobileChrome?.enabled && mobileChrome.mount === 'registry' && mobileChrome.engine === 'page')}
  >
    <ArticlesMain />
    <ArticlesPageFooter />
  </JournalEditorialShell>
  <div class="sr-only" aria-hidden="true" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
    Каталог статей Господь Бог — Сила Моя. Все статьи: Джон Гилл, Нагорная проповедь, апологетика, экзегетика, богословие, пасторская серия, трудные тексты и библейские исследования.
  </div>
</ArticlesPageChrome>
