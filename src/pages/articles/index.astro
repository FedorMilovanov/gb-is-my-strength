---
/**
 * /articles/ — РЕФАКТОРИНГ 5.0 Phase 6 wave 3 (AGENTS-r251).
 *
 * native-shadow recipe (see REFACTORING_5_0_PIXEL_DIFF_GUARD_2026-06-20.md §8-9):
 *   - <head> via loadLegacyFullDocument => SEO byte-identical;
 *   - body chrome (navbar, mobile menu, hero/footer breadcrumbs, runtime
 *     scripts) preserved verbatim through body-segment-{0,1}.html;
 *   - <main id="main-content"> promoted to ArticlesMain.astro component.
 *
 * Pixel parity proof:
 *   npm run visual:parity:screenshots -- --routes /articles/
 */
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';
import ArticlesMain from '@/components/articles/ArticlesMain.astro';
import segBefore from '@/components/articles/_legacy/body-segment-0.html?raw';
import segAfter from '@/components/articles/_legacy/body-segment-1.html?raw';

const { headHtml, bodyAttributes } = loadLegacyFullDocument('articles/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}><Fragment set:html={segBefore} /><ArticlesMain /><Fragment set:html={segAfter} /></body>
</html>
