---
import HomePageHead from '@/components/home/HomePageHead.astro';
import HomeProgressiveEnhancementHead from '@/components/home/HomeProgressiveEnhancementHead.astro';
import HomePageChrome from '@/components/home/HomePageChrome.astro';
import HomePageChromeStyles from '@/components/home/HomePageChromeStyles.astro';
import HomeResponsiveContracts from '@/components/home/HomeResponsiveContracts.astro';
import HomeMain from '@/components/home/HomeMain.astro';
import HomeVisualAuditFixes from '@/components/home/HomeVisualAuditFixes.astro';
import HomeAmbientInteraction from '@/components/home/HomeAmbientInteraction.astro';
import HomeSearchA11yGuard from '@/components/home/HomeSearchA11yGuard.astro';
import HomePageFooter from '@/components/home/HomePageFooter.astro';
import HomeArticleEndBlock from '@/components/home/HomeArticleEndBlock.astro';
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <HomePageHead />
    <HomeProgressiveEnhancementHead />
  </head>
  <body class="home-page">
    <HomePageChrome>
      <HomePageChromeStyles />
      <HomeResponsiveContracts />
      <HomeMain />
      <HomeVisualAuditFixes />
      <HomeAmbientInteraction />
      <HomeSearchA11yGuard />
      <HomeArticleEndBlock />
      <HomePageFooter />
    </HomePageChrome>

    <style is:global>
      /* Route-local product accent: the App stays part of the native Home chrome,
         but reads as a live study tool rather than one more catalogue destination. */
      body.home-page .h-nav-links a[href="/app/"] {
        position: relative;
        display: inline-flex;
        min-height: 24px;
        align-items: center;
        color: var(--h-heading);
      }

      body.home-page .h-nav-links a[href="/app/"]::before {
        content: '';
        position: absolute;
        top: 50%;
        left: -9px;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--h-accent);
        box-shadow: 0 0 12px color-mix(in srgb, var(--h-accent) 72%, transparent);
        transform: translateY(-50%);
      }

      body.home-page .h-mobile-nav__primary a[href="/app/"] {
        border-color: color-mix(in srgb, var(--h-accent) 26%, var(--h-border));
        background:
          linear-gradient(105deg, color-mix(in srgb, var(--h-accent) 8%, transparent), transparent 44%),
          color-mix(in srgb, var(--h-surface) 96%, transparent);
        box-shadow: inset 3px 0 var(--h-accent), 0 18px 44px -38px var(--h-glow);
      }

      body.home-page .h-mobile-nav__primary a[href="/app/"] span {
        color: var(--h-accent);
      }

      body.home-page .h-nojs-nav__links a[href="/app/"] {
        color: var(--h-heading);
        text-decoration-color: color-mix(in srgb, var(--h-accent) 62%, transparent);
        text-underline-offset: .28em;
      }

      @media (prefers-reduced-motion: reduce) {
        body.home-page .h-nav-links a[href="/app/"]::before {
          box-shadow: none;
        }
      }
    </style>

    <script is:inline>
      (() => {
        if (window.__gbSearchActionQueryBound) return;
        window.__gbSearchActionQueryBound = true;

        const rawQuery = new URLSearchParams(window.location.search).get('q');
        const query = String(rawQuery ?? '')
          .replace(/\s+/g, ' ')
          .trim()
          .slice(0, 160);

        if (!query) return;

        let applied = false;
        let expiry = 0;

        const applyQuery = () => {
          if (applied) return true;
          const overlay = document.querySelector('.cp-backdrop');
          const input = document.querySelector('.cp-input');
          if (!(input instanceof HTMLInputElement) || !overlay?.classList.contains('is-open')) return false;

          applied = true;
          window.clearTimeout(expiry);
          input.value = query;
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.focus({ preventScroll: true });
          document.documentElement.dataset.searchActionQuery = 'applied';
          return true;
        };

        const observer = new MutationObserver(() => {
          if (applyQuery()) observer.disconnect();
        });
        observer.observe(document.body, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['class'],
        });
        expiry = window.setTimeout(() => observer.disconnect(), 10_000);

        window.__gbHomeSearchOpener = document.getElementById('gbSearchBtn');
        window.dispatchEvent(new CustomEvent('gb:openSearch', {
          detail: { source: 'website-search-action' },
        }));
        requestAnimationFrame(applyQuery);
      })();
    </script>
  </body>
</html>