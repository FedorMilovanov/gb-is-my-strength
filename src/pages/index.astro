---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';

const canonical = SITE.url + '/';
const title = 'Господь Бог — Сила Моя — Материалы для изучения Писания';
const description = 'Материалы для изучения Писания и переводов на русском языке. Реформатское богословие, экзегеза Писания, апологетика — для серьёзного изучения Слова Божьего.';
const ogTitle = 'Господь Бог — Сила Моя';
const ogDescription = 'Материалы для изучения Писания, богословские разборы, апологетика и переводы серьёзных зарубежных материалов.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': SITE.websiteId,
      name: SITE.name,
      url: SITE.url,
      inLanguage: 'ru',
      publisher: { '@id': SITE.orgId },
    },
    {
      '@type': 'Organization',
      '@id': SITE.orgId,
      name: SITE.name,
      url: SITE.url,
      logo: { '@type': 'ImageObject', url: `${SITE.url}/icons/icon-512.png`, width: 512, height: 512 },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': SITE.websiteId },
      breadcrumb: { '@id': `${canonical}#breadcrumbs` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Господь Бог — Сила Моя', item: canonical },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  robots="index, follow"
  ogImage={`${SITE.url}/images/og-preview-1200x630.webp`}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  jsonLd={jsonLd}
  bodyClass="home-page astro-home-page"
  mainClass="astro-main astro-main--bare"
  hideHeader={true}
  hideFooter={true}
  legacyStylesheets={[
    '/fonts/fonts.css',
    '/css/site.css',
    '/css/home.css',
    '/css/command-palette.css',
    '/css/mobile-hotfix.css',
  ]}
>
  <a href="#main-content" class="skip-link">Перейти к содержимому</a>

  <div class="home-v20 astro-home-v21">
    <main id="main-content" data-pagefind-body>
      <div class="home-content">
        <section class="h-hero astro-home-hero-v21" aria-label="Главный заголовок">
          <div class="h-sacred-block h-sacred-block--hero" aria-hidden="true">
            <span class="h-sacred-line h-sacred-line--1">יְהוִה אֲדֹנָי חֵילִי</span>
            <span class="h-sacred-line h-sacred-line--2">וַיָּשֶׂם רַגְלַי כָּאַיָּלוֹת וְעַל בָּמוֹתַי יַדְרִכֵנִי</span>
            <span class="h-sacred-ref"><span>Аввакум 3:19</span></span>
          </div>

          <p class="h-hero-tagline">Для изучения Писания</p>
          <h1 class="h-hero-title">
            <span class="h-title-static">Господь Бог</span>
            <span class="h-title-dash" aria-hidden="true">—</span>
            <span class="h-title-accent">Сила Моя</span>
          </h1>
          <p class="h-hero-desc">
            Материалы для вдумчивого изучения Писания: экзегеза, богословие, апологетика, переводы, биографии,
            интерактивные карты и длинные исследовательские серии — в структуре, которая должна быть удобна и на телефоне,
            и на большом экране.
          </p>

          <div class="astro-home-cta" aria-label="Быстрые действия">
            <a href="/articles/" class="astro-home-cta__link">Все статьи</a>
            <a href="/konfessii/russkij-baptizm/" class="astro-home-cta__link">3D-карта</a>
            <a href="/about/" class="astro-home-cta__link">О проекте</a>
          </div>

          <div class="astro-home-mobile-note note-box">
            <strong>Курс рефакторинга сейчас именно такой:</strong> не просто перенести страницы в Astro, а сделать так,
            чтобы читатель не увидел «другой сайт». Сначала — parity, shell, поиск, мобильная структура и навигация.
            Потом — уже richer cards, tilt, app-like mobile flow и визуальные усиления без потери характера проекта.
          </div>

          <hr class="h-rule" aria-hidden="true" />
        </section>

        <section class="h-section" aria-labelledby="startHereLabel">
          <p class="h-section-label" id="startHereLabel">С чего начать</p>
          <div class="h-section-accent" aria-hidden="true"></div>

          <div class="astro-home-start-grid" role="list">
            <article class="h-card-glass" role="listitem">
              <div>
                <h3 class="h-card-title">Если вы здесь впервые</h3>
                <p class="h-card-desc">
                  Начните с обзорных разделов: «Биографии», «Нагорная проповедь», «Баптисты России» и общий каталог статей.
                  Так сайт читается как библиотека и курс, а не как случайная лента публикаций.
                </p>
              </div>
            </article>
            <article class="h-card-glass" role="listitem">
              <div>
                <h3 class="h-card-title">Если нужен точечный ответ</h3>
                <p class="h-card-desc">
                  Идите сразу в статью по теме: Римлянам 7, Иеремия 17, герменевтика, Код да Винчи, Джон Гилл,
                  пастырские искажения или исторические вопросы русского баптизма.
                </p>
              </div>
            </article>
            <article class="h-card-glass" role="listitem">
              <div>
                <h3 class="h-card-title">Если нужен визуальный слой</h3>
                <p class="h-card-desc">
                  Используйте 3D-карту русского баптизма и библейские карты как исследовательский инструмент,
                  а не как замену текстам: карта показывает связи, текст даёт аргумент и проверяемый контекст.
                </p>
              </div>
            </article>
          </div>
        </section>

        <section class="h-section" aria-labelledby="directionsLabel">
          <p class="h-section-label" id="directionsLabel">Ключевые направления</p>
          <div class="h-section-accent" aria-hidden="true"></div>

          <div class="h-grid-4" role="list">
            <div class="h-card-glass" role="listitem">
              <div>
                <h3 class="h-card-title">Экзегеза и богословие</h3>
                <p class="h-card-desc">Разбор библейских текстов с опорой на контекст, аргументацию и проверяемые источники.</p>
              </div>
            </div>
            <div class="h-card-glass" role="listitem">
              <div>
                <h3 class="h-card-title">Апологетика</h3>
                <p class="h-card-desc">Исторические и богословские ответы на популярные мифы, псевдоистории и ложные развилки.</p>
              </div>
            </div>
            <div class="h-card-glass" role="listitem">
              <div>
                <h3 class="h-card-title">Биографии служителей</h3>
                <p class="h-card-desc">Люди, эпохи, споры, библиотечные миры, церковные узлы и богословское наследие.</p>
              </div>
            </div>
            <div class="h-card-glass" role="listitem">
              <div>
                <h3 class="h-card-title">Карты и исследовательские серии</h3>
                <p class="h-card-desc">От библейской географии до истории русского баптизма — с длинной логикой, а не срывками.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="h-section" aria-labelledby="seriesLabel">
          <p class="h-section-label" id="seriesLabel">Большие циклы</p>
          <div class="h-section-accent" aria-hidden="true"></div>

          <div class="astro-home-featured-stack">
            <a href="/nagornaya/seriya/" class="h-featured-series" aria-label="Нагорная проповедь — исследование в 5 частях">
              <div class="h-featured-img-wrap">
                <img src="/images/og-nagornaya-propoved.webp" alt="Нагорная проповедь — исследование в 5 частях" loading="lazy" decoding="async" width="800" height="420" />
                <div class="h-featured-overlay" aria-hidden="true"></div>
              </div>
              <div class="h-featured-body">
                <div class="h-featured-eyebrow">
                  <span class="h-featured-series-badge">Авторская серия</span>
                  <span class="h-featured-dot" aria-hidden="true">·</span>
                  <span class="h-featured-parts">5 частей</span>
                </div>
                <h3 class="h-featured-title">Нагорная проповедь</h3>
                <p class="h-featured-abstract">Сравнительное исследование Матфея 5–7 и Луки 6: содержание, аудитория, богодухновенность, Закон и Евангелие.</p>
              </div>
            </a>

            <a href="/baptisty-rossii/" class="h-featured-series" aria-label="Баптисты России — живая исследовательская серия">
              <div class="h-featured-img-wrap">
                <img src="/images/baptisty-rossii/cover-landing.svg" alt="Баптисты России — живая исследовательская серия" loading="lazy" decoding="async" width="800" height="420" />
                <div class="h-featured-overlay" aria-hidden="true"></div>
              </div>
              <div class="h-featured-body">
                <div class="h-featured-eyebrow">
                  <span class="h-featured-series-badge">Историческая серия</span>
                  <span class="h-featured-dot" aria-hidden="true">·</span>
                  <span class="h-featured-parts">10 частей</span>
                </div>
                <h3 class="h-featured-title">Баптисты России</h3>
                <p class="h-featured-abstract">Тифлис, штунда, Петербург, гонения, ВСЕХБ, Инициативная группа, самиздат и 3D-карта как единая исследовательская линия.</p>
              </div>
            </a>

            <a href="/biografii/" class="h-featured-series" aria-label="Биографии служителей">
              <div class="h-featured-img-wrap">
                <img src="/images/og-biografii.webp" alt="Биографии служителей" loading="lazy" decoding="async" width="800" height="420" />
                <div class="h-featured-overlay" aria-hidden="true"></div>
              </div>
              <div class="h-featured-body">
                <div class="h-featured-eyebrow">
                  <span class="h-featured-series-badge">Исторический проект</span>
                  <span class="h-featured-dot" aria-hidden="true">·</span>
                  <span class="h-featured-parts">Биографии</span>
                </div>
                <h3 class="h-featured-title">Биографии служителей</h3>
                <p class="h-featured-abstract">Жизнь и труд пасторов, богословов и реформаторов — с контекстом, спорами и подлинным историческим фоном.</p>
              </div>
            </a>
          </div>
        </section>

        <section class="h-section" aria-labelledby="quickReadsLabel">
          <p class="h-section-label" id="quickReadsLabel">Быстрый вход в материалы</p>
          <div class="h-section-accent" aria-hidden="true"></div>

          <div class="h-articles-group">
            <ul class="h-article-list h-article-list--grid">
              <li>
                <a href="/articles/kod-da-vinchi/" class="h-article-card h-article-card--debunk">
                  <div class="h-article-thumb">
                    <img src="/images/hero-kod-da-vinchi.webp" alt="Код да Винчи — разбор исторических мифов" decoding="async" loading="lazy" width="160" height="108" />
                  </div>
                  <div class="h-article-body">
                    <div class="h-article-kicker h-article-kicker--warn">Апологетика</div>
                    <h3 class="h-article-title">«Код да Винчи»: блестящий триллер или историческая подмена?</h3>
                    <p class="h-article-abstract">Мария Магдалина, Никея, канон Нового Завета, Наг-Хаммади и Приорат Сиона — полный разбор с опорой на источники.</p>
                  </div>
                </a>
              </li>
              <li>
                <a href="/articles/rimlyanam-7-veruyushchiy-ili-neveruyushchiy/" class="h-article-card">
                  <div class="h-article-thumb">
                    <img src="/images/og-rimlyanam-7.webp" alt="Римлянам 7 — разбор" decoding="async" loading="lazy" width="160" height="108" />
                  </div>
                  <div class="h-article-body">
                    <div class="h-article-kicker">Экзегеза</div>
                    <h3 class="h-article-title">Римлянам 7: верующий, неверующий или человек под законом?</h3>
                    <p class="h-article-abstract">Подробный разбор Рим. 7:14–25, аргументов за разные позиции и связи с Римлянам 6–8.</p>
                  </div>
                </a>
              </li>
              <li>
                <a href="/articles/dzhon-gill-chast-1-chelovek/" class="h-article-card h-article-card--biography">
                  <div class="h-article-thumb">
                    <img src="/images/gill-authentic-study-cover.webp" alt="Джон Гилл — часть I" decoding="async" loading="lazy" width="160" height="108" />
                  </div>
                  <div class="h-article-body">
                    <div class="h-article-kicker">Биография · Часть I</div>
                    <h3 class="h-article-title">Джон Гилл — человек: детство, призвание, семья</h3>
                    <p class="h-article-abstract">Первая часть большого биографического цикла о Джоне Гилле — с контекстом, эпохой и личной линией.</p>
                  </div>
                </a>
              </li>
              <li>
                <a href="/articles/20-antisovetov-pastoru/" class="h-article-card h-article-card--debunk">
                  <div class="h-article-thumb">
                    <img src="/images/pastor-series/mirror.webp" alt="20 антисоветов пастору" decoding="async" loading="lazy" width="160" height="108" />
                  </div>
                  <div class="h-article-body">
                    <div class="h-article-kicker h-article-kicker--warn">Пастырская практика</div>
                    <h3 class="h-article-title">20 антисоветов, как пастору разрушить своё служение</h3>
                    <p class="h-article-abstract">О страхе, власти без подотчётности, манипуляции Писанием и пути к здоровой церковной культуре.</p>
                  </div>
                </a>
              </li>
            </ul>
          </div>
        </section>

        <section class="h-section" aria-labelledby="toolsLabel">
          <p class="h-section-label" id="toolsLabel">Карты и инструменты</p>
          <div class="h-section-accent" aria-hidden="true"></div>

          <div class="h-grid-3" role="list">
            <a href="/konfessii/russkij-baptizm/" class="h-card-glass astro-home-tool" role="listitem">
              <div>
                <h3 class="h-card-title">3D-карта русского баптизма</h3>
                <p class="h-card-desc">Маршруты, узлы, Timeline, dossier, страны, организации и связанные статьи серии «Баптисты России».</p>
              </div>
            </a>
            <a href="/karty/" class="h-card-glass astro-home-tool" role="listitem">
              <div>
                <h3 class="h-card-title">Библейские карты</h3>
                <p class="h-card-desc">Авраам, Исход и будущие карты — как исследовательский слой поверх текста, а не развлекательный виджет.</p>
              </div>
            </a>
            <a href="/about/" class="h-card-glass astro-home-tool" role="listitem">
              <div>
                <h3 class="h-card-title">О проекте и методологии</h3>
                <p class="h-card-desc">Как подготавливаются материалы, где используется ИИ, как сверяются источники и куда писать о неточностях.</p>
              </div>
            </a>
          </div>
        </section>

        <section class="h-about" id="about" aria-labelledby="aboutLabel">
          <p class="h-about-label" id="aboutLabel">О проекте</p>
          <p class="h-about-text h-drop-cap">
            <span class="h-drop-cap__letter" aria-hidden="true">Э</span>то не лента быстрых заметок и не каталог удобных цитат. Здесь собраны материалы для медленного чтения:
            авторские статьи, переводы, экзегетические разборы, исторические серии и инструменты, которые должны помогать
            думать по Писанию глубже. Следующий шаг рефакторинга — не просто ещё один перенос, а именно мобильная витрина,
            в которой всё это будет ощущаться цельно, структурно и красиво.
          </p>
          <p class="h-about-small">
            Проект ведёт <a href="/about/">Фёдор Милованов</a>. Старый сайт остаётся эталоном, новый слой подгоняется так,
            чтобы не потерять характер, глубину и визуальную узнаваемость оригинала.
          </p>
        </section>

        <aside class="gb-accuracy-block" aria-label="Обратная связь">
          <div class="gb-accuracy-inner">
            <h2 class="gb-accuracy-title">Нашли неточность?</h2>
            <p class="gb-accuracy-desc">Богословскую или техническую — напишите, исправим.</p>
            <div class="gb-accuracy-actions" role="list">
              <a href="mailto:viktorcoy2012@gmail.com?subject=Неточность%20в%20материале" class="gb-accuracy-btn gb-accuracy-btn--email" role="listitem" aria-label="Написать на Email">
                <span class="gb-accuracy-btn__label">Email</span>
              </a>
              <a href="https://t.me/fedormilovanov" class="gb-accuracy-btn gb-accuracy-btn--tg" role="listitem" target="_blank" rel="noopener noreferrer" aria-label="Написать в Telegram">
                <span class="gb-accuracy-btn__label">Telegram</span>
              </a>
            </div>
          </div>
        </aside>

        <footer class="h-footer" role="contentinfo">
          <span class="h-footer-copy">© 2026 Господь Бог — <span>Сила Моя</span></span>
          <a href="/about/">Об авторе</a>
        </footer>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .astro-home-v21 .home-content {
    max-width: 1120px;
  }

  .astro-home-hero-v21 {
    padding-top: 88px;
  }

  .astro-home-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 0;
  }

  .astro-home-cta__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--h-border);
    background: color-mix(in srgb, var(--h-surface) 74%, transparent);
    color: var(--h-ink);
    text-decoration: none;
    font-family: var(--f-ui);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .02em;
    transition: transform .2s ease, border-color .2s ease, color .2s ease;
  }

  .astro-home-cta__link:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--h-accent) 30%, var(--h-border));
    color: var(--h-accent);
  }

  .astro-home-mobile-note {
    margin-top: 24px;
  }

  .astro-home-start-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .astro-home-featured-stack {
    display: grid;
    gap: 24px;
  }

  .astro-home-tool {
    text-decoration: none;
    color: inherit;
  }

  .astro-home-tool:hover .h-card-title {
    color: var(--h-accent);
  }

  @media (max-width: 900px) {
    .astro-home-start-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .astro-home-v21 .home-content {
      padding-inline: 16px;
    }

    .astro-home-hero-v21 {
      padding-top: 74px;
    }

    .astro-home-cta {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .astro-home-cta__link {
      min-height: 46px;
      padding-inline: 10px;
      font-size: 12px;
      text-align: center;
    }
  }

  @media (max-width: 520px) {
    .astro-home-cta {
      grid-template-columns: 1fr;
    }

    .astro-home-mobile-note {
      font-size: 14px;
      line-height: 1.7;
    }
  }
</style>
