---
import Seo from '@/components/seo/Seo.astro';
import ReaderPreferencesHead from '@/components/reader-platform/ReaderPreferencesHead.astro';
import { APOSTASY_SERIES } from '@/components/article-pilots/_shared/series/apostasySeriesConfig';
import { APOSTASY_SERIES_MEDIA, apostasySeriesMediaFor } from '@/components/article-pilots/_shared/series/apostasySeriesMedia';
import { SITE } from '@/data/site';
import { assetUrl } from '@/lib/asset-version';

const canonical = `${SITE.url}/otstupniki/`;
const ogImagePath = APOSTASY_SERIES_MEDIA.series.hero;
const ogImage = `${SITE.url}${ogImagePath}`;
const title = 'Отступники: отступничество, падение и возвращение | Господь Бог — Сила Моя';
const description = 'Пять частей о том, что Библия на самом деле называет отпадением от веры: временная вера, тяжёлое падение, ожесточение, отречение и возвращение — в Писании, истории Церкви и пастырской практике.';
const items = APOSTASY_SERIES.items;
const cards = items.map((item) => ({ ...item, media: apostasySeriesMediaFor(item.id) }));
const totalMinutes = items.reduce((sum, item) => sum + Number.parseInt(item.readingTime, 10), 0);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': SITE.orgId,
      name: SITE.name,
      url: `${SITE.url}/`,
      logo: { '@type': 'ImageObject', url: `${SITE.url}/icons/icon-512.png`, width: 512, height: 512 },
    },
    {
      '@type': 'WebSite',
      '@id': SITE.websiteId,
      name: SITE.name,
      url: `${SITE.url}/`,
      inLanguage: SITE.locale,
      publisher: { '@id': SITE.orgId },
    },
    {
      '@type': 'CollectionPage',
      '@id': canonical,
      url: canonical,
      name: APOSTASY_SERIES.seriesTitleFull,
      description,
      inLanguage: 'ru',
      isPartOf: { '@id': SITE.websiteId },
      publisher: { '@id': SITE.orgId },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
      hasPart: items.map((item) => ({
        '@type': 'Article',
        name: item.title,
        url: `${SITE.url}${item.href}`,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Отступники', item: canonical },
      ],
    },
  ],
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <ReaderPreferencesHead />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
      ogImage={ogImage}
      ogImageAlt={APOSTASY_SERIES_MEDIA.series.alt}
      ogImageWidth="1200"
      ogImageHeight="630"
      ogType="website"
      jsonLd={jsonLd}
    />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Lora/lora-cyrillic-400.woff2" crossorigin />
    <link rel="stylesheet" href={assetUrl('fonts/fonts.css')} />
    <link rel="stylesheet" href={assetUrl('css/site.css')} />
    <link rel="stylesheet" href={assetUrl('css/home.css')} />
    <link rel="stylesheet" href={assetUrl('css/command-palette.css')} />
    <link rel="stylesheet" href={assetUrl('css/mobile-hotfix.css')} />
    <link rel="stylesheet" href={assetUrl('css/floating-cluster.css')} />
  </head>
  <body class="apostasy-series-hub-page">
    <a href="#main-content" class="skip-link">Перейти к содержимому</a>
    <main id="main-content" class="article-main" data-pagefind-body>
      <article class="apostasy-hub">
        <span data-pagefind-meta="image" hidden>{ogImagePath}</span>
        <span data-pagefind-meta="author" hidden>Фёдор Милованов</span>
        <span data-pagefind-meta="readTime" hidden>{totalMinutes}</span>
        <span data-pagefind-meta="category" hidden>Отступничество и стойкость</span>

        <div class="apostasy-hub-opening">
        <header class="article-header gbs2-head">
          <nav aria-label="Хлебные крошки" style="margin-bottom:.75rem">
            <a href="/" class="gb-text-link">← Главная</a>
          </nav>
          <p class="section-label">Богословское исследование · {items.length} частей · {totalMinutes} мин</p>
          <h1>Отступники</h1>
          <p class="article-byline"><span class="article-byline__strong">Отступничество, падение и возвращение в Библии и истории Церкви</span></p>
          <p class="apostasy-hub-lead">Что Библия называет отпадением от веры? Как отличить тяжёлое падение от окончательного отступничества — и как помочь тому, кто хочет вернуться?</p>
          <nav class="apostasy-hub-actions" aria-label="Навигация по серии">
            <a class="apostasy-hub-start" href={items[0].href}>Начать с первой части <span aria-hidden="true">→</span></a>
            <a class="apostasy-hub-index" href="#series-order">Все части <span aria-hidden="true">↓</span></a>
          </nav>
        </header>

        <figure class="apostasy-series-hero">
          <img
            src={APOSTASY_SERIES_MEDIA.series.hero}
            srcset={`${APOSTASY_SERIES_MEDIA.series.rail} 600w, ${APOSTASY_SERIES_MEDIA.series.hero} 1200w`}
            sizes="(max-width: 44rem) 100vw, (max-width: 52rem) 40vw, 520px"
            width="1200"
            height="630"
            alt={APOSTASY_SERIES_MEDIA.series.alt}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>Серия об отпадении, стойкости и возвращении. Образ сеятеля и семени при дороге.</figcaption>
        </figure>
        </div>

        <section aria-labelledby="series-order">
          <div class="apostasy-hub-section-heading">
            <div><p class="apostasy-hub-kicker">Маршрут чтения</p><h2 id="series-order">Читать по порядку</h2></div>
            <p>От библейского определения — к историческим свидетельствам и пастырской практике.</p>
          </div>
          <ol class="apostasy-series-grid" role="list">
            {cards.map((item, index) => (
              <li class="apostasy-series-step">
              <a class="apostasy-series-card" href={item.href}>
                {index > 0 && <img
                  class="apostasy-series-card__image"
                  src={item.media.rail}
                  srcset={`${item.media.rail} 600w, ${item.media.hero} 1200w`}
                  sizes="(max-width: 35rem) 120px, (max-width: 52rem) 35vw, 250px"
                  width="600"
                  height="315"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />}
                <span class="apostasy-series-card__content">
                  <span class="apostasy-series-card__mark" aria-hidden="true">{item.mark.value}</span>
                  <span class="apostasy-series-card__body">
                    <span class="apostasy-series-card__eyebrow">{index === 0 ? "Начало серии · " : ""}{item.readingTime}</span>
                    <strong>{item.title}</strong>
                    {index === 0 && <span class="apostasy-series-card__intro">Временная вера, падение, ожесточение и отречение — не одна категория.</span>}
                    <span class="apostasy-series-card__link">Читать исследование <span aria-hidden="true">→</span></span>
                  </span>
                </span>
              </a>
              </li>
            ))}
          </ol>
        </section>

        <section class="apostasy-hub-context" aria-labelledby="how-to-use">
          <h2 id="how-to-use">Как устроена серия</h2>
          <p>Первая часть разбирает библейский язык темы: временная вера, тяжёлое падение, ожесточение и окончательное отступничество — не одна категория, и смешивать их значит искажать часть Писания. Вторая проходит по людям Библии — от Иуды и Саула до Димаса и лжеучителей. Третья сравнивает Петра и Иуду и учит отличать падение от отступничества. Четвёртая смотрит на отречения в истории Церкви: дециевы lapsi, Киприан, Кранмер. Пятая — пастырская: что делать церкви, семье и самому уходящему человеку.</p>
          <p>Отдельный главный разбор самого трудного текста темы — <a href="/hard-texts/otstuplenie-ot-very-iuda-evreyam-6/">Евреям 6 и Иуда: можно ли потерять спасение</a>. Серия даёт карту всей темы; тот разбор уходит в глубину одного предупреждения.</p>
        </section>

        <section class="author-card">
          <div class="author-card-icon" aria-hidden="true">ФМ</div>
          <div class="author-card-body">
            <div class="author-card-label">Редакционный принцип серии</div>
            <div class="author-card-name">Предупреждение без жестокости, милость без самообмана</div>
            <p class="author-card-desc">Не давать ложной надежды тому, кто хочет Христа отвергнуть, — и не закрывать дверь перед тем, кто хочет к Нему вернуться. Стойкость святых в этой серии — не повод для пассивности церкви, а основание её активности.</p>
          </div>
        </section>
      </article>
    </main>
    <script is:inline src={assetUrl('js/sw-register.js')} defer></script>
    <style>
      .apostasy-series-hub-page .article-main { width:100%; max-width:74rem; margin-inline:auto; padding-inline:clamp(1rem,3vw,2.5rem); box-sizing:border-box; }
      .apostasy-hub { min-width:0; }
      .apostasy-hub-opening { display:grid; gap:clamp(1rem,3vw,2.75rem); align-items:center; padding-block:clamp(.5rem,3vw,2rem) clamp(1.25rem,3vw,2rem); border-bottom:1px solid color-mix(in srgb,currentColor 18%,transparent); }
      .apostasy-hub-opening .article-header { margin:0; padding:0; border:0; min-width:0; }
      .apostasy-hub-opening h1 { font-size:clamp(2.5rem,5vw,4.6rem); line-height:1.08; margin-block:.5rem .9rem; overflow-wrap:anywhere; }
      .apostasy-hub-opening .article-byline { font-size:clamp(1.05rem,1.8vw,1.35rem); line-height:1.45; }
      .apostasy-hub-lead { max-width:53ch; line-height:1.65; text-align:start; margin:.9rem 0 0; }
      .apostasy-hub-actions { display:flex; flex-wrap:wrap; gap:.65rem 1rem; align-items:center; margin-top:1.3rem; }
      .apostasy-hub-actions a { display:inline-flex; align-items:center; justify-content:center; gap:.5rem; min-height:44px; font-weight:650; text-decoration:none; line-height:1.35; }
      .apostasy-hub-start { padding:.65rem 1rem; background:var(--color-text,CanvasText); color:var(--color-canvas,Canvas); border-radius:.5rem; }
      .apostasy-hub-index { color:inherit; padding:.5rem .2rem; border-bottom:1px solid currentColor; }
      .apostasy-series-hero { margin:0; min-width:0; }
      .apostasy-series-hero img { display:block; width:100%; height:auto; aspect-ratio:1200/630; object-fit:cover; border-radius:.7rem; }
      .apostasy-series-hero figcaption { font-size:.82rem; line-height:1.5; opacity:.8; margin-top:.6rem; }
      .apostasy-hub-section-heading { display:flex; flex-wrap:wrap; align-items:end; justify-content:space-between; gap:.3rem 2rem; margin-top:2rem; }
      .apostasy-hub-kicker { font-family:"Source Sans 3",system-ui,sans-serif; color:var(--color-accent); font-size:.8rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; margin:0 0 .4rem; }
      .apostasy-hub-section-heading h2 { margin:0; }
      .apostasy-hub-section-heading>p { max-width:45ch; margin:0; line-height:1.5; text-align:start; }
      .apostasy-hub section[aria-labelledby="series-order"] { margin-block:0; }
      .apostasy-series-grid { display:grid; grid-template-columns:minmax(0,1fr); gap:1rem; margin:1.25rem 0 2.5rem; padding:0; list-style:none; }
      .apostasy-series-step { min-width:0; margin:0; }
      .apostasy-series-step:first-child .apostasy-series-card { grid-template-columns:minmax(0,1fr); border-inline-start:3px solid var(--color-accent); background:var(--color-surface-muted); }
      .apostasy-series-step:first-child .apostasy-series-card__mark { display:grid; width:clamp(2.5rem,5vw,3.75rem); height:clamp(2.5rem,5vw,3.75rem); font-size:1.15rem; color:var(--color-accent); border-radius:.35rem; }
      .apostasy-series-step:first-child .apostasy-series-card__content { align-content:center; grid-template-columns:auto minmax(0,1fr); gap:clamp(.75rem,2vw,1.25rem); padding:clamp(1rem,2.5vw,1.75rem); }
      .apostasy-series-step:first-child .apostasy-series-card strong { font-size:clamp(1.12rem,2vw,1.65rem); }
      .apostasy-series-card__intro { line-height:1.55; font-size:.95rem; color:var(--color-text-secondary); }
      .apostasy-series-card { height:100%; display:grid; grid-template-columns:minmax(90px,34%) minmax(0,1fr); overflow:hidden; border:1px solid color-mix(in srgb,currentColor 20%,transparent); border-radius:.7rem; text-decoration:none; color:inherit; background:var(--color-surface,Canvas); }
      .apostasy-series-card:hover,.apostasy-series-card:focus-visible { border-color:currentColor; }
      .apostasy-series-card__image { display:block; width:100%; height:100%; min-height:100%; object-fit:cover; background:var(--color-surface-muted,Canvas); }
      .apostasy-series-card__content { display:grid; grid-template-columns:auto minmax(0,1fr); gap:.65rem; align-items:start; padding:clamp(.75rem,2vw,1.25rem); }
      .apostasy-series-card__mark { display:grid; place-items:center; width:2rem; height:2rem; border:1px solid currentColor; border-radius:50%; font-weight:700; font-size:.85rem; }
      .apostasy-series-card__body { display:grid; gap:.45rem; min-width:0; }
      .apostasy-series-card__eyebrow { font-family:"Source Sans 3",system-ui,sans-serif; font-size:.85rem; line-height:1.4; font-weight:600; }
      .apostasy-series-card strong { font-size:clamp(1rem,1.6vw,1.2rem); line-height:1.4; overflow-wrap:anywhere; }
      .apostasy-series-card__link { font-family:"Source Sans 3",system-ui,sans-serif; font-size:.9rem; font-weight:650; line-height:1.35; }
      .apostasy-hub-context { max-width:72ch; margin:0 auto 2rem; }
      .apostasy-hub-actions a:focus-visible,.apostasy-series-card:focus-visible { outline:2px solid currentColor; outline-offset:4px; }
      @media (min-width:44rem) and (max-width:51.999rem) {
        .apostasy-hub-opening { grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr); align-items:center; gap:1.5rem; }
        .apostasy-hub-opening h1 { font-size:clamp(2.25rem,4vw,3rem); }
        .apostasy-hub-opening .article-byline { font-size:1.05rem; }
        .apostasy-hub-lead { font-size:.95rem; }
      }
      @media (min-width:52rem) {
        .apostasy-hub-opening { grid-template-columns:minmax(0,1fr) minmax(0,.92fr); }
        .apostasy-series-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .apostasy-series-step:first-child { grid-column:1/-1; }

      }
      @media (max-width:35rem) {
        .apostasy-series-card { grid-template-columns:minmax(72px,28%) minmax(0,1fr); align-items:start; padding:.65rem; gap:.7rem; }
        .apostasy-series-card__image { height:auto; min-height:0; aspect-ratio:4/3; border-radius:.35rem; }
        .apostasy-series-card__content { grid-template-columns:minmax(0,1fr); gap:.4rem; padding:0; }
        .apostasy-series-card__mark { display:none; }
        .apostasy-hub-opening .article-header { text-align:start; }
        .apostasy-hub-opening .section-label { letter-spacing:.09em; }
        .apostasy-hub-opening .article-byline { line-height:1.4; }
        .apostasy-hub-lead { line-height:1.55; }
        .apostasy-series-step:first-child .apostasy-series-card { padding:0; }
        .apostasy-series-step:first-child .apostasy-series-card__content { padding:1rem .8rem; }
        .apostasy-hub-section-heading { margin-top:1.5rem; }
      }
      @media (hover:hover) and (prefers-reduced-motion:no-preference) {
        .apostasy-series-card { transition:border-color .18s ease,box-shadow .18s ease; }
        .apostasy-series-card:hover { box-shadow:0 5px 16px color-mix(in srgb,currentColor 10%,transparent); }
      }
    </style>
  </body>
</html>
