---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';

const canonical = `${SITE.url}/dev/astro-test/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: 'Astro test | Господь Бог — Сила Моя',
  inLanguage: 'ru',
  isPartOf: { '@id': SITE.websiteId },
};
---
<BaseLayout
  title="Astro test | Господь Бог — Сила Моя"
  description="Техническая noindex-страница Astro-прототипа: проверка layout, SEO-компонента и static build без переключения production."
  canonical={canonical}
  robots="noindex, follow"
  jsonLd={jsonLd}
  technicalBadge="Astro scaffold · noindex"
  footerNote="Технический прототип, не production switch"
>
  <h1>Astro test</h1>
  <p>
    Astro-прототип работает как <strong>build-only scaffold</strong>. Эта страница нужна только для проверки
    <code>BaseLayout</code>, <code>Seo.astro</code>, локальных стилей и static output.
  </p>
  <p>
    Production deploy, legacy HTML, URL-контракт и текущий GitHub Pages pipeline не изменены.
  </p>
</BaseLayout>
