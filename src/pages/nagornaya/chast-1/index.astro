---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadLegacyShadowPage } from '@/utils/legacyShadow';

const legacy = loadLegacyShadowPage('nagornaya/chast-1/index.html');
---

<BaseLayout
  title={legacy.title}
  description={legacy.description}
  canonical={legacy.canonical}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
  ogImage={legacy.ogImage}
  ogImageAlt={legacy.ogImageAlt}
  ogTitle={legacy.ogTitle}
  ogDescription={legacy.ogDescription}
  bodyClass={legacy.bodyClass}
  mainClass="astro-main astro-main--bare"
  hideHeader={true}
  hideFooter={true}
  headHtml={legacy.headHtml}
>
  <div class="astro-nagornaya-shadow" data-astro-shadow-route="nagornaya-chast-1">
    <div class="sr-only">
      Два текста, один Иисус. Часть I серии «Нагорная проповедь». Сравнение Матфея 5–7 и Луки 6: структура, композиция, синоптическая проблема, богодухновенность. Ключевые темы: заповеди блаженства, архитектура проповеди, антитезы, молитва Отче наш.
    </div>
    <Fragment set:html={legacy.bodyHtml} />
  </div>
</BaseLayout>
