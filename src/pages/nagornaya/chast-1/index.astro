---
/**
 * /nagornaya/chast-1/ — РЕФАКТОРИНГ 6.0 Phase 1: native pilot chast-1.
 *
 * 100% Astro-owned page structure for chast-1. Zero raw ?raw imports.
 * Uses NagornayaChast1PageChrome, MainShell, and PageFooter components.
 */
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';
import NagornayaChast1PageChrome from '@/components/nagornaya/chast-1/NagornayaChast1PageChrome.astro';
import NagornayaChast1MainShell from '@/components/nagornaya/chast-1/NagornayaChast1MainShell.astro';
import NagornayaChast1PageFooter from '@/components/nagornaya/chast-1/NagornayaChast1PageFooter.astro';

const { headHtml, bodyAttributes } = loadLegacyFullDocument('nagornaya/chast-1/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Страница проекта Господь Бог — Сила Моя. Раздел: nagornaya/chast-1.
    </div>
    <NagornayaChast1PageChrome />
    <NagornayaChast1MainShell />
    <NagornayaChast1PageFooter />
  </body>
</html>
