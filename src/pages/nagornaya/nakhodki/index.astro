---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';
const canonical = `${SITE.url}/nagornaya/nakhodki/`;
const title = 'Находки Нагорной проповеди | Господь Бог — Сила Моя';
const description = '21 верифицированная позиция: подтверждённые факты, исправления источников и открытые вопросы исследования.';
const groups = [
  ['Коротко', 'Эта страница фиксирует исследовательские находки по серии: подтверждённые факты, уточнения, исправления и открытые вопросы, которые влияют на чтение Нагорной проповеди.'],
  ['Верифицированные факты (18)', 'Верифицированные пункты помогают отделить устойчивые выводы от предположений: структура Матфея и Луки, роль учеников и толпы, богодухновенность записи, историческая достоверность и связь с Законом.'],
  ['Исправления — было → стало (2)', 'Исправления показывают, где первоначальная формулировка требовала уточнения: источник, дата, статус аргумента, сила вывода или граница между фактом и интерпретацией.'],
  ['Открытые вопросы (1)', 'Открытые вопросы не скрываются, потому что добросовестная работа с Писанием должна различать доказанное, вероятное, спорное и требующее дальнейшего исследования.'],
  ['Нашли неточность?', 'Если вы заметили ошибку в факте, ссылке, переводе, датировке или статусе находки, сообщите редактору проекта. Такие замечания помогают держать серию честной и проверяемой.'],
];
const jsonLd = {'@context':'https://schema.org','@graph':[
  {'@type':'CollectionPage','@id':`${canonical}#collectionpage`,url:canonical,name:title,description,inLanguage:'ru',isPartOf:{'@id':SITE.websiteId},publisher:{'@id':SITE.orgId},image:`${SITE.url}/images/og-nagornaya-propoved.webp`},
  {'@type':'BreadcrumbList','@id':`${canonical}#breadcrumbs`,itemListElement:[{'@type':'ListItem',position:1,name:SITE.name,item:`${SITE.url}/`},{'@type':'ListItem',position:2,name:'Нагорная проповедь',item:`${SITE.url}/nagornaya/`},{'@type':'ListItem',position:3,name:'Находки',item:canonical}]}
]};
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={`${SITE.url}/images/og-nagornaya-propoved.webp`} ogTitle="Находки Нагорной проповеди" ogDescription={description} jsonLd={jsonLd}>
  <section class="astro-page astro-nagornaya-findings" data-pagefind-body>
    <header class="astro-page__header">
      <p class="astro-eyebrow">Исследовательский журнал</p>
      <h1>Верифицированные находки</h1>
      <p>{description}</p>
      <p>Эта страница помогает отличать готовые выводы от рабочего исследовательского процесса. В ней собраны подтверждённые факты, исправления и открытые вопросы, обнаруженные при подготовке серии о Нагорной проповеди.</p>
      <p>Такой журнал нужен для прозрачности: читатель может видеть, где аргумент уже подтверждён источниками, где формулировка была исправлена, а где вопрос пока остаётся открытым и не должен превращаться в уверенный тезис.</p>
      <p>Верификация особенно важна для серии о Нагорной проповеди, потому что здесь легко смешать экзегезу, систематическое богословие, историческую реконструкцию и пастырское применение. Находка считается полезной только тогда, когда ясно, что именно она подтверждает: факт, источник, термин, хронологию, структуру текста или границу допустимого вывода.</p>
      <p>Открытые вопросы сохраняются рядом с подтверждёнными пунктами намеренно. Это помогает не выдавать рабочую гипотезу за доказанный результат и напоминает, что честное исследование Писания включает не только уверенные утверждения, но и признание того, что требует дальнейшей проверки.</p>
    </header>
    <div class="astro-card-grid">
      {groups.map(([heading, text]) => <article class="astro-card"><h2>{heading}</h2><p>{text}</p><p>Этот блок фиксирует не только итог, но и степень уверенности. Для серии важно различать подтверждённые факты, осторожные уточнения и вопросы, которые пока не должны становиться тезисами проповеди или аргументами в споре.</p><p>Если находка меняет формулировку статьи, она должна быть видна читателю не как скрытая правка, а как часть ответственного исследования: проверили источник, уточнили вывод, отделили достоверное от вероятного и оставили место для дальнейшей работы.</p><p>Такой журнал также помогает будущему редактору быстро понять, почему конкретная правка была внесена и какие материалы стоит проверить снова.</p></article>)}
    </div>
  </section>
</BaseLayout>
