---
/**
 * /nagornaya/nakhodki/ — РЕФАКТОРИНГ 6.0 Phase 1: native pilot nakhodki.
 *
 * 100% Astro-owned page structure. Zero raw ?raw imports.
 */
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';
import NagornayaNakhodkiPageChrome from '@/components/nagornaya/nakhodki/NagornayaNakhodkiPageChrome.astro';
import NagornayaNakhodkiMainShell from '@/components/nagornaya/nakhodki/NagornayaNakhodkiMainShell.astro';
import NagornayaNakhodkiPageFooter from '@/components/nagornaya/nakhodki/NagornayaNakhodkiPageFooter.astro';

const { headHtml, bodyAttributes } = loadLegacyFullDocument('nagornaya/nakhodki/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Страница проекта Господь Бог — Сила Моя. Раздел: nagornaya/nakhodki.
    </div>
    <NagornayaNakhodkiPageChrome />
    <NagornayaNakhodkiMainShell />
    <NagornayaNakhodkiPageFooter />
  </body>
</html>
