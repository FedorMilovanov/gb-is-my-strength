---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';
const canonical = `${SITE.url}/nagornaya/istochniki/`;
const title = 'Источники Нагорной проповеди | Господь Бог — Сила Моя';
const description = 'Полная библиография: 66+ позиций. TMSJ, MacArthur GTY, Chicago Statement, реформатские исповедания, отцы Церкви.';
const groups = [
  ['Коротко', 'Эта страница фиксирует источниковую базу серии о Нагорной проповеди: статьи The Master’s Seminary Journal, книги и монографии, материалы Grace to You, реформатские исповедания, Чикагское заявление, отцов Церкви, академические ресурсы и исторические ссылки.'],
  ['Статьи The Master\'s Seminary Journal', 'Материалы TMSJ используются для вопросов синоптической проблемы, богодухновенности, грамматико-исторического метода, канонических связей и доверия к евангельскому тексту.'],
  ['Книги и монографии', 'Книжная база нужна для широкого контекста: богословие Нового Завета, историчность Евангелий, проповедь Иисуса, структура Матфея и Луки, Закон и Евангелие.'],
  ['MacArthur / Grace to You', 'Материалы MacArthur и Grace to You помогают увидеть консервативное евангельское толкование, пастырское применение и связь Нагорной проповеди с ученичеством.'],
  ['Исповедания веры', 'Реформатские исповедания дают богословские рамки для закона, оправдания, освящения, добрых дел, церковной дисциплины и жизни верующего перед Богом.'],
  ['Чикагское заявление', 'Чикагское заявление важно для разговора о богодухновенности, безошибочности, авторитете Писания и доверии к словам Христа в Евангелиях.'],
  ['Отцы Церкви', 'Патристические свидетельства показывают, как ранняя Церковь читала слова Христа, исповедовала авторитет Писания и применяла Евангелие в жизни общин.'],
  ['Академические и онлайн-ресурсы', 'Онлайн-ресурсы используются не как замена первичным текстам, а как вспомогательные указатели: библиографии, справочные базы, тексты исповеданий и проверяемые публикации.'],
  ['Только историческая ссылка', 'Некоторые источники используются не для богословского вывода, а только для исторического фона, датировок, терминологии, издательской истории или карты дискуссий.'],
  ['Нашли неточность?', 'Если вы видите ошибку в библиографии, ссылке, атрибуции, переводе названия или статусе источника, сообщите редактору проекта — источник важен не меньше итогового тезиса.'],
];
const jsonLd = {'@context':'https://schema.org','@graph':[
  {'@type':'CollectionPage','@id':`${canonical}#collectionpage`,url:canonical,name:title,description,inLanguage:'ru',isPartOf:{'@id':SITE.websiteId},publisher:{'@id':SITE.orgId},image:`${SITE.url}/images/og-nagornaya-propoved.webp`},
  {'@type':'BreadcrumbList','@id':`${canonical}#breadcrumbs`,itemListElement:[{'@type':'ListItem',position:1,name:SITE.name,item:`${SITE.url}/`},{'@type':'ListItem',position:2,name:'Нагорная проповедь',item:`${SITE.url}/nagornaya/`},{'@type':'ListItem',position:3,name:'Источники',item:canonical}]}
]};
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={`${SITE.url}/images/og-nagornaya-propoved.webp`} ogTitle="Источники Нагорной проповеди" ogDescription={description} jsonLd={jsonLd}>
  <section class="astro-page astro-nagornaya-sources" data-pagefind-body>
    <header class="astro-page__header">
      <p class="astro-eyebrow">Библиография серии</p>
      <h1>Источники серии</h1>
      <p>{description}</p>
      <p>Страница служит проверяемой картой источников для всей серии о Нагорной проповеди. Она нужна, чтобы читатель видел, на чём основаны выводы о Матфее 5–7, Луке 6, богодухновенности, адресате, историчности и применении текста.</p>
      <p>Источники разделены по типам, потому что не всякий материал выполняет одну и ту же задачу. Одни тексты используются для экзегезы, другие — для богословской рамки, третьи — для исторической справки, а некоторые только фиксируют историю вопроса.</p>
      <p>В работе над серией особенно важны несколько направлений: синоптическая проблема, жанр евангельской речи, история устной передачи, авторитет апостольского свидетельства, место Нагорной проповеди в богословии Матфея, связь с Лукой 6, отношение Закона и Евангелия, а также вопрос о том, как применять слова Христа без морализма и без отмены ученичества.</p>
      <p>Библиография также помогает удерживать баланс между академической добросовестностью и церковным применением. Список источников не должен производить впечатление нейтрального украшения: каждый источник либо проверяет факт, либо уточняет термин, либо помогает увидеть границу аргумента, либо показывает, где популярная формулировка требует осторожности.</p>
    </header>
    <div class="astro-card-grid">
      {groups.map(([heading, text]) => <article class="astro-card"><h2>{heading}</h2><p>{text}</p><p>При чтении этого блока важно спрашивать: какую именно функцию выполняет источник? Он может подтверждать исторический фон, помогать с греческим текстом, объяснять композицию Евангелия, уточнять богословскую категорию или служить только указателем на историю дискуссии. Такой подход защищает серию от смешения фактов, предположений и пастырских выводов.</p><p>В практической работе над серией источник проверяется по нескольким вопросам: кто автор, каков жанр материала, к какому тексту Писания он относится, является ли он первичным свидетельством или вторичным анализом, и не выходит ли вывод за пределы того, что источник действительно доказывает.</p></article>)}
    </div>
  </section>
</BaseLayout>
