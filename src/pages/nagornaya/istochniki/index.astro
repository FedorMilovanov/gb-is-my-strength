---
/**
 * /nagornaya/istochniki/ — РЕФАКТОРИНГ 6.0 Phase 1: native pilot istochniki.
 *
 * 100% Astro-owned page structure. Zero raw ?raw imports.
 */
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';
import NagornayaIstochnikiPageChrome from '@/components/nagornaya/istochniki/NagornayaIstochnikiPageChrome.astro';
import NagornayaIstochnikiMainShell from '@/components/nagornaya/istochniki/NagornayaIstochnikiMainShell.astro';
import NagornayaIstochnikiPageFooter from '@/components/nagornaya/istochniki/NagornayaIstochnikiPageFooter.astro';

const { headHtml, bodyAttributes } = loadLegacyFullDocument('nagornaya/istochniki/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Страница проекта Господь Бог — Сила Моя. Раздел: nagornaya/istochniki.
    </div>
    <NagornayaIstochnikiPageChrome />
    <NagornayaIstochnikiMainShell />
    <NagornayaIstochnikiPageFooter />
  </body>
</html>
