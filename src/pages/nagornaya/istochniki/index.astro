---
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';

// Visual-first migration: /nagornaya/istochniki/ must preserve the legacy premium page
// before any component refactor. The previous native Astro card-grid was a
// production-quality regression (same as AGENTS-r244 emergency rollback);
// keep this full-document shadow until screenshot parity and owner review
// approve a hand-built Astro version.
const { headHtml, bodyHtml, bodyAttributes } = loadLegacyFullDocument('nagornaya/istochniki/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <!-- Pagefind search data: legacy istochniki page content -->
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Источники Нагорной проповеди. Полная библиография: 66+ позиций. TMSJ, MacArthur GTY, Chicago Statement, реформатские исповедания, отцы Церкви. Страница служит проверяемой картой источников для всей серии о Нагорной проповеди.
    </div>
    <Fragment set:html={bodyHtml} />
  </body>
</html>