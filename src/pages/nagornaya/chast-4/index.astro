---
/**
 * /nagornaya/chast-4/ — РЕФАКТОРИНГ 6.0 Phase 1: native pilot chast-4.
 *
 * 100% Astro-owned page structure for chast-4. Zero raw ?raw imports.
 * All content sections promoted to named Astro components.
 */
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';
import NagornayaChast4PageChrome from '@/components/nagornaya/chast-4/NagornayaChast4PageChrome.astro';
import NagornayaChast4HeaderHero from '@/components/nagornaya/chast-4/NagornayaChast4HeaderHero.astro';
import NagornayaChast4ArticleBody from '@/components/nagornaya/chast-4/NagornayaChast4ArticleBody.astro';
import NagornayaChast4PostContent from '@/components/nagornaya/chast-4/NagornayaChast4PostContent.astro';
import NagornayaChast4PageFooter from '@/components/nagornaya/chast-4/NagornayaChast4PageFooter.astro';

const { headHtml, bodyAttributes } = loadLegacyFullDocument('nagornaya/chast-4/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Страница проекта Господь Бог — Сила Моя. Раздел: nagornaya/chast-4.
    </div>
    <NagornayaChast4PageChrome />
    <NagornayaChast4HeaderHero />
    <NagornayaChast4ArticleBody />
    <NagornayaChast4PostContent />
    <NagornayaChast4PageFooter />
  </body>
</html>
