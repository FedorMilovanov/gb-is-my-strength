---
/**
 * /nagornaya/chast-4// — 100% native Nagornaya route (2026-06-23).
 *
 * Native <head>, chrome, balanced <main>, and footer. No legacy document loader,
 * no raw HTML fragment imports, no legacy fragment transport. Scope: Nagornaya visual native
 * hardening lane.
 */
import NagornayaChast4PageHead from '@/components/nagornaya/chast-4/NagornayaChast4PageHead.astro';
import NagornayaChast4PageChrome from '@/components/nagornaya/chast-4/NagornayaChast4PageChrome.astro';
import NagornayaChast4MainShell from '@/components/nagornaya/chast-4/NagornayaChast4MainShell.astro';
import NagornayaChast4PageFooter from '@/components/nagornaya/chast-4/NagornayaChast4PageFooter.astro';
import NagornayaClaimComparison from '@/components/nagornaya/_shared/NagornayaClaimComparison.astro';
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <NagornayaChast4PageHead />
  </head>
  <body class="nagornaya-page bg-stone-100 text-stone-900 antialiased">
    <NagornayaChast4PageChrome />
    <NagornayaChast4MainShell />
    <aside class="lg:pl-64" aria-label="Сравнение моделей и границ вывода">
      <div class="max-w-4xl mx-auto px-4">
        <NagornayaClaimComparison
          claimIds={['green-ipsissima-vox-model', 'thomas-jesus-seminar-critique']}
          title="Что мы знаем, что реконструируем и какой вывод принимает серия"
          description="Два спорных вопроса части IV показаны не как красно-зелёный тест, а как последовательность: источник, модель, альтернатива, позиция серии и границы доказательства."
        />
      </div>
    </aside>
    <NagornayaChast4PageFooter />
  </body>
</html>
