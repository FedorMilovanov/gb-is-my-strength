---
/**
 * /nagornaya/chast-2/ — РЕФАКТОРИНГ 6.0 Phase 2: section componentization complete.
 *
 * 100% Astro-owned page structure for chast-2. Zero raw ?raw imports.
 * All 12 content sections promoted to named Astro components.
 */
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';
import NagornayaChast2PageChrome from '@/components/nagornaya/chast-2/NagornayaChast2PageChrome.astro';
import NagornayaChast2HeaderHero from '@/components/nagornaya/chast-2/NagornayaChast2HeaderHero.astro';
import NagornayaChast2ArticleBody from '@/components/nagornaya/chast-2/NagornayaChast2ArticleBody.astro';
import NagornayaChast2PostContent from '@/components/nagornaya/chast-2/NagornayaChast2PostContent.astro';
import NagornayaChast2PageFooter from '@/components/nagornaya/chast-2/NagornayaChast2PageFooter.astro';

const { headHtml, bodyAttributes } = loadLegacyFullDocument('nagornaya/chast-2/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Страница проекта Господь Бог — Сила Моя. Раздел: nagornaya/chast-2.
    </div>
    <NagornayaChast2PageChrome />
    <NagornayaChast2HeaderHero />
    <NagornayaChast2ArticleBody />
    <NagornayaChast2PostContent />
    <NagornayaChast2PageFooter />
  </body>
</html>
