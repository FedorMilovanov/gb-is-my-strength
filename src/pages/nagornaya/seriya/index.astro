---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';
const canonical = `${SITE.url}/nagornaya/seriya/`;
const title = 'Нагорная проповедь: серия в 5 частях | Господь Бог — Сила Моя';
const description = 'Серия из 5 частей: содержание Нагорной проповеди, методология записи Евангелий, адресат, богодухновенность, применение. Матфей 5–7 и Лука 6.';
const parts = [
 ['Два текста, один Иисус','/nagornaya/chast-1/','Сопоставление Матфея 5–7 и Луки 6, общий голос Христа и различия евангельской композиции.'],
 ['Как это записывалось','/nagornaya/chast-2/','Богодухновенность, память учеников, устная культура и доверие к передаче слов Господа.'],
 ['Кому это сказано?','/nagornaya/chast-3/','Ученики, толпы, Израиль, Церковь и современное применение Нагорной проповеди.'],
 ['Можно ли доверять Евангелиям?','/nagornaya/chast-4/','Историчность, свидетельства, синоптическая проблема и уверенность в евангельском тексте.'],
 ['Закон, Евангелие и Нагорная проповедь','/nagornaya/chast-5/','Праведность, благодать, исполнение закона и жизнь ученика в Царстве.'],
];
const jsonLd = {'@context':'https://schema.org','@graph':[
 {'@type':'CollectionPage','@id':`${canonical}#collectionpage`,url:canonical,name:title,description,inLanguage:'ru',isPartOf:{'@id':SITE.websiteId},publisher:{'@id':SITE.orgId},image:`${SITE.url}/images/og-nagornaya-propoved.webp`},
 {'@type':'BreadcrumbList','@id':`${canonical}#breadcrumbs`,itemListElement:[{'@type':'ListItem',position:1,name:SITE.name,item:`${SITE.url}/`},{'@type':'ListItem',position:2,name:'Нагорная проповедь',item:`${SITE.url}/nagornaya/`},{'@type':'ListItem',position:3,name:'Серия',item:canonical}]}
]};
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={`${SITE.url}/images/og-nagornaya-propoved.webp`} ogTitle="Нагорная проповедь: серия в 5 частях" ogDescription={description} jsonLd={jsonLd}>
  <section class="astro-page astro-series-page" data-pagefind-body>
    <header class="astro-page__header">
      <p class="astro-eyebrow">Серия в 5 частях</p>
      <h1>Нагорная проповедь</h1>
      <p>{description}</p>
      <p>Эта страница — навигационная карта всей серии о Нагорной проповеди. Она помогает пройти путь от сравнения Матфея и Луки к вопросам богодухновенности, адресата, исторической достоверности и богословского применения слов Христа.</p>
      <p>Серия задумана как последовательный маршрут: сначала читатель видит синоптическую проблему, затем получает инструменты для доверия к евангельской записи, после этого разбирает адресатов и только затем переходит к вопросу закона, благодати и жизни ученика.</p>
      <p>Такой порядок защищает от поверхностного чтения. Нагорная проповедь не сводится к морализму, политическому манифесту или недостижимому идеалу: она раскрывает Царя, Его Царство, праведность учеников и необходимость слушать слова Христа в контексте всего Писания.</p>
    </header>
    <section class="astro-card">
      <h2>Коротко</h2>
      <p>Серия показывает, что Нагорная проповедь не является набором оторванных нравственных афоризмов. Это цельная речь Царя, обращённая к ученикам и раскрывающая праведность Царства в свете всего Евангелия.</p>
    </section>
    <div class="astro-card-grid">
      {parts.map(([partTitle, href, text], index) => <article class="astro-card"><p class="astro-eyebrow">Часть {index + 1}</p><h2><a href={href}>{partTitle}</a></h2><p>{text}</p></article>)}
    </div>
    <section class="astro-card"><h2>Нашли неточность?</h2><p>Если вы заметили неточность в навигации серии, формулировках или ссылках на части, сообщите редактору проекта.</p></section>
  </section>
</BaseLayout>
