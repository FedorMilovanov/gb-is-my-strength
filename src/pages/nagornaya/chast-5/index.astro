---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadLegacyShadowPage } from '@/utils/legacyShadow';

const legacy = loadLegacyShadowPage('nagornaya/chast-5/index.html');
---

<BaseLayout
  title={legacy.title}
  description={legacy.description}
  canonical={legacy.canonical}
  robots="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
  ogImage={legacy.ogImage}
  ogImageAlt={legacy.ogImageAlt}
  ogTitle={legacy.ogTitle}
  ogDescription={legacy.ogDescription}
  bodyClass={legacy.bodyClass}
  mainClass="astro-main astro-main--bare"
  hideHeader={true}
  hideFooter={true}
  headHtml={legacy.headHtml}
>
  <div class="astro-nagornaya-shadow" data-astro-shadow-route="nagornaya-chast-5">
    <div class="sr-only" data-pagefind-body>
      Закон, Евангелие и Нагорная проповедь. Часть V серии «Нагорная проповедь». Три функции Закона, праведность книжников и фарисеев, исполнение закона Христом, антитезы, ученичество и благодать.
    </div>
    <Fragment set:html={legacy.bodyHtml} />
  </div>
</BaseLayout>
