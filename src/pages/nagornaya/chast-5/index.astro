---
/**
 * /nagornaya/chast-5/ — РЕФАКТОРИНГ 6.0 Phase 1: native pilot chast-5.
 *
 * 100% Astro-owned page structure for chast-5. Zero raw ?raw imports.
 * All content sections promoted to named Astro components.
 */
import { loadLegacyFullDocument } from '@/utils/legacyFullDocument';
import NagornayaChast5PageChrome from '@/components/nagornaya/chast-5/NagornayaChast5PageChrome.astro';
import NagornayaChast5HeaderHero from '@/components/nagornaya/chast-5/NagornayaChast5HeaderHero.astro';
import NagornayaChast5ArticleBody from '@/components/nagornaya/chast-5/NagornayaChast5ArticleBody.astro';
import NagornayaChast5PostContent from '@/components/nagornaya/chast-5/NagornayaChast5PostContent.astro';
import NagornayaChast5PageFooter from '@/components/nagornaya/chast-5/NagornayaChast5PageFooter.astro';

const { headHtml, bodyAttributes } = loadLegacyFullDocument('nagornaya/chast-5/index.html');
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Fragment set:html={headHtml} />
  </head>
  <body {...bodyAttributes}>
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Страница проекта Господь Бог — Сила Моя. Раздел: nagornaya/chast-5.
    </div>
    <NagornayaChast5PageChrome />
    <NagornayaChast5HeaderHero />
    <NagornayaChast5ArticleBody />
    <NagornayaChast5PostContent />
    <NagornayaChast5PageFooter />
  </body>
</html>
