---
import KonfessiiPageHead from '@/components/konfessii/KonfessiiPageHead.astro';
import KonfessiiPageChrome from '@/components/konfessii/KonfessiiPageChrome.astro';
import KonfessiiMain from '@/components/konfessii/KonfessiiMain.astro';
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <KonfessiiPageHead />
  </head>
  <body>
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Конфессии и Деноминации. История церковных движений, русский баптизм, первоисточники, карты, документы, биографии, статистика и богословские различия.
    </div>
    <KonfessiiPageChrome>
      <KonfessiiMain />
    </KonfessiiPageChrome>
  </body>
</html>
