---
/**
 * /konfessii/russkij-baptizm/ — strict-native route (Protected App Routes Native Astro Phase).
 *
 * Interactive 3D visualization. Very fragile runtime.
 * Native Baptizm3DPageHead (SEO/JSON-LD/meta) + Native Baptizm3DBody.
 * Uses iframe to embed the complex Three.js application safely.
 * The shell is full-viewport: indexable prose belongs only to the in-stage noscript fallback
 * and must never become a visible flex sibling of the iframe stage.
 * Does NOT use global site.css/site.js.
 */
import Baptizm3DPageHead from '@/components/konfessii/russkij-baptizm/Baptizm3DPageHead.astro';
import Baptizm3DStyles from '@/components/konfessii/russkij-baptizm/Baptizm3DStyles.astro';
import Baptizm3DBody from '@/components/konfessii/russkij-baptizm/Baptizm3DBody.astro';
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <Baptizm3DPageHead />
    <Baptizm3DStyles />
  </head>
  <body>
    <!-- sr-only marker for local search index inclusion -->
    <div class="sr-only" data-pagefind-body style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap">
      Страница проекта Господь Бог — Сила Моя. Раздел: konfessii. История русского баптизма: три истока (Тифлис, Украина, Петербург), узлы-планеты, маршруты, хронология, фигуры.
    </div>
    <Baptizm3DBody />
  </body>
</html>
