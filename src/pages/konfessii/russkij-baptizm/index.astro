---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';

const canonical = `${SITE.url}/konfessii/russkij-baptizm/`;
const title = 'Карта Русского Баптизма — интерактивная 3D-история | Господь Бог — Сила Моя';
const description = 'Интерактивная 3D-карта истории русского баптизма: три истока (Тифлис, Украина, Петербург), узлы-планеты с орбитами, карта стран, маршруты, хронология, фигуры.';
const ogDescription = 'Интерактивная 3D-карта: три истока, узлы-планеты с орбитами, карта стран, маршруты, хронология, фигуры, глоссарий.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': SITE.orgId,
      name: SITE.name,
      url: `${SITE.url}/`,
      logo: { '@type': 'ImageObject', url: `${SITE.url}/icons/icon-512.png`, width: 512, height: 512 },
      sameAs: ['https://t.me/fedormilovanov', 'https://vk.com/curtmf'],
    },
    {
      '@type': 'WebSite',
      '@id': SITE.websiteId,
      name: SITE.name,
      url: `${SITE.url}/`,
      inLanguage: 'ru',
      publisher: { '@id': SITE.orgId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description: 'Интерактивная 3D-карта истории русского евангельско-баптистского движения от истоков к современности.',
      inLanguage: 'ru',
      isPartOf: { '@id': SITE.websiteId },
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Конфессии и Деноминации', item: `${SITE.url}/konfessii/` },
        { '@type': 'ListItem', position: 3, name: 'Карта Русского Баптизма', item: canonical },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  robots="index, follow"
  ogImage={`${SITE.url}/images/og-konfessii-russkij-baptizm-1200x630.webp`}
  ogImageAlt="Тёмная 3D-карта истории русского баптизма: золотые и бирюзовые узлы-планеты с орбитальными кольцами над тёмной картой Российской империи, три ярких узла-истока — Тифлис, Петербург, Южная Украина"
  ogTitle={title}
  ogDescription={ogDescription}
  jsonLd={jsonLd}
  bodyClass="astro-baptist-map-page"
  mainClass="astro-main astro-main--bare"
  hideHeader={true}
  hideFooter={true}
>
  <style is:inline>
    :root{--gold:#e8c879;--gold-soft:rgba(232,200,121,.55);--bg:#08080e;--txt:#e9e4d6;--muted:#8a857f}
    .astro-baptist-map-page,.astro-baptist-map-page body{background:var(--bg)}
    .astro-map-wrapper *{box-sizing:border-box}
    .astro-map-wrapper{min-height:100vh;min-height:100dvh;background:var(--bg);color:var(--txt);font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;overflow:hidden;display:flex;flex-direction:column}
    .astro-map-wrapper .sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    .astro-map-wrapper .skip{position:absolute;left:-9999px;top:0;background:var(--gold);color:#1a1208;padding:10px 16px;border-radius:0 0 10px 0;z-index:50;font-weight:700}
    .astro-map-wrapper .skip:focus{left:0}
    .astro-map-wrapper .bar{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;background:rgba(8,8,14,.9);border-bottom:1px solid rgba(255,255,255,.06);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);z-index:10}
    .astro-map-wrapper .back{color:var(--muted);text-decoration:none;font-size:13px;letter-spacing:.04em;display:flex;align-items:center;gap:7px;transition:color .2s;white-space:nowrap}
    .astro-map-wrapper .back:hover{color:var(--gold)}
    .astro-map-wrapper .back:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:6px}
    .astro-map-wrapper .back svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
    .astro-map-wrapper .crumb{font-size:10.5px;color:#5e5a54;letter-spacing:.13em;text-transform:uppercase;text-align:right}
    .astro-map-wrapper .crumb a{color:#7a756e;text-decoration:none}.astro-map-wrapper .crumb a:hover{color:var(--gold)}
    .astro-map-wrapper .stage{flex:1 1 auto;position:relative;min-height:0}
    .astro-map-wrapper #appframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block;background:#08080e}
    .astro-map-wrapper #loader{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;background:#08080e;z-index:5;transition:opacity .5s;pointer-events:none}
    .astro-map-wrapper #loader.hidden{opacity:0}
    .astro-map-wrapper .lring{width:64px;height:64px;border-radius:50%;border:2px solid rgba(232,200,121,.18);border-top-color:var(--gold);animation:spin 1s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .astro-map-wrapper #loader .lt{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-soft)}
    .astro-map-wrapper .noscript-fallback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:32px;text-align:center;color:var(--muted);font-size:14px;line-height:1.7}
    .astro-map-wrapper .astro-map-search{position:absolute;left:-9999px;opacity:0;pointer-events:none}
    @media (prefers-reduced-motion:reduce){.astro-map-wrapper .lring{animation:none}}
    @media(max-width:600px){.astro-map-wrapper .crumb{display:none}.astro-map-wrapper .bar .back:nth-of-type(2){display:none}.astro-map-wrapper .bar{justify-content:flex-start}.astro-map-wrapper .back{max-width:calc(100vw - 32px);overflow:hidden;text-overflow:ellipsis}}
  </style>

  <div class="astro-map-wrapper">
    <a class="skip" href="#appframe">Перейти к интерактивной карте</a>
    <h1 class="sr-only">Карта Русского Баптизма — интерактивная 3D-история движения от истоков к современности</h1>

    <div class="astro-map-search" data-pagefind-body>
      <p>Карта Русского Баптизма — интерактивная 3D-история движения от истоков к современности. Три истока, маршруты, узлы, люди, хронология, связи со статьями серии «Баптисты России» и разделом «Конфессии и Деноминации».</p>
    </div>

    <header class="bar">
      <a class="back" href="/konfessii/"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Конфессии и Деноминации</a>
      <a class="back" href="/baptisty-rossii/">Серия «Баптисты России»</a>
      <div class="crumb"><a href="/">Главная</a> · <a href="/konfessii/">Конфессии</a> · <a href="/baptisty-rossii/">Серия</a> · Карта Русского Баптизма</div>
    </header>

    <div class="stage">
      <div id="loader"><div class="lring" aria-hidden="true"></div><div class="lt">Загрузка интерактивной 3D-карты…</div></div>
      <iframe id="appframe" src="./_app/index.html" title="Интерактивная 3D-карта истории русского баптизма: узлы-планеты с орбитами над картой Российской империи, режимы «граф» и «карта», маршруты, инспектор узлов" allow="fullscreen" loading="eager" referrerpolicy="no-referrer"></iframe>
      <noscript><div class="noscript-fallback">Интерактивная 3D-карта истории русского баптизма требует включённого JavaScript. Пожалуйста, включите его в браузере, чтобы исследовать три истока, маршруты, хронологию и ключевые фигуры движения.</div></noscript>
    </div>
  </div>

  <script is:inline>
    (function(){
      var f=document.getElementById('appframe'),l=document.getElementById('loader');
      function hide(){if(l){l.classList.add('hidden');setTimeout(function(){l.style.display='none';},600);}}
      if(f){f.addEventListener('load',hide);} setTimeout(hide,6000);
    })();

    (function(){
      var stage = document.querySelector('.stage');
      if(!stage) return;
      var isOver = false;
      stage.addEventListener('mouseenter', function(){ isOver = true; }, {passive:true});
      stage.addEventListener('mouseleave', function(){ isOver = false; }, {passive:true});
      stage.addEventListener('touchstart', function(){ isOver = true; }, {passive:true});
      stage.addEventListener('touchend', function(){ isOver = false; }, {passive:true});
      document.addEventListener('wheel', function(e){
        if(isOver && e.target && e.target.closest && e.target.closest('.stage')) e.preventDefault();
      }, {passive: false});
      stage.addEventListener('touchmove', function(e){
        if(e.touches.length >= 2) e.preventDefault();
      }, {passive: false});
    })();
  </script>
</BaseLayout>
