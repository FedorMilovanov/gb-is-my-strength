---
import ReaderPreferencesHead from '@/components/reader-platform/ReaderPreferencesHead.astro';

const launchUrl = 'https://t.me/milovanovaibot?startapp=v1_site_app__home';
const profileUrl = 'https://t.me/milovanovaibot';
const chapter3LaunchUrl = 'https://t.me/milovanovaibot?startapp=v1_site_ch3__chapter3';
const chapter4LaunchUrl = 'https://t.me/milovanovaibot?startapp=v1_site_ch4__chapter4';
const canonicalUrl = 'https://gospod-bog.ru/app/';
const title = 'Библейский тренажёр — Господь Бог — Сила Моя';
const description = 'Библейский тренажёр по 1 Петра: читайте, проверяйте себя и закрепляйте знания в Telegram-приложении проекта «Господь Бог — Сила Моя».';
const publishedTime = '2026-08-17T00:00:00+03:00';
const modifiedTime = '2026-08-17T00:00:00+03:00';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalUrl,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Господь Бог — Сила Моя',
    url: 'https://gospod-bog.ru/',
  },
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <ReaderPreferencesHead />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="article:published_time" content={publishedTime} />
    <meta property="article:modified_time" content={modifiedTime} />
    <meta property="og:site_name" content="Господь Бог — Сила Моя" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://gospod-bog.ru/images/og-preview-1200x630.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:alt" content="Господь Бог — Сила Моя — для изучения Писания" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@FedorMilovanov" />
    <meta name="twitter:creator" content="@FedorMilovanov" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://gospod-bog.ru/images/og-preview-1200x630.webp" />
    <meta name="theme-color" content="#071012" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <script is:inline>
      window.SITE_CONFIG = {
        version: 1786935600,
        site: {
          id: 'gb-strength',
          name: 'Господь Бог — Сила Моя',
          baseUrl: 'https://gospod-bog.ru',
          locale: 'ru-RU',
          themeStorageKey: 'theme',
          debug: false
        },
        page: {
          type: 'app',
          id: 'app',
          title: 'Библейский тренажёр',
          section: 'Библейские инструменты',
          readingTime: 2
        },
        features: {
          themeToggle: { enabled: false },
          share: { enabled: false },
          readingProgress: { enabled: false },
          toc: { enabled: false },
          quiz: { enabled: false },
          bookmarks: { enabled: false }
        }
      };
    </script>
    <style is:global>
      :root {
        color-scheme: dark;
        --app-bg: #061012;
        --app-bg-deep: #030809;
        --app-surface: rgba(14, 24, 26, .82);
        --app-surface-solid: #0d1719;
        --app-surface-warm: #171510;
        --app-ink: #f0e5d0;
        --app-ink-strong: #fff5df;
        --app-muted: #aeb5ad;
        --app-faint: #7a847f;
        --app-gold: #c79a58;
        --app-gold-bright: #e1b66f;
        --app-accent: #49c6d5;
        --app-accent-soft: rgba(73, 198, 213, .12);
        --app-line: rgba(199, 154, 88, .22);
        --app-line-cool: rgba(73, 198, 213, .18);
        --app-line-soft: rgba(240, 229, 208, .09);
        --app-shadow: 0 38px 110px -54px rgba(0, 0, 0, .95);
        --app-ui: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-family: Georgia, 'Times New Roman', serif;
        background: var(--app-bg);
        color: var(--app-ink);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; background: var(--app-bg-deep); }
      body {
        margin: 0;
        min-width: 320px;
        min-height: 100vh;
        overflow-x: hidden;
        background:
          radial-gradient(circle at 50% -8%, rgba(73, 198, 213, .15), transparent 33rem),
          radial-gradient(circle at 9% 24%, rgba(199, 154, 88, .09), transparent 29rem),
          radial-gradient(circle at 92% 63%, rgba(73, 198, 213, .07), transparent 34rem),
          linear-gradient(180deg, #081316 0%, var(--app-bg) 42%, var(--app-bg-deep) 100%);
        color: var(--app-ink);
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: .28;
        background-image:
          linear-gradient(rgba(199, 154, 88, .045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(199, 154, 88, .045) 1px, transparent 1px);
        background-size: 72px 72px;
        mask-image: linear-gradient(to bottom, #000, rgba(0, 0, 0, .38) 45%, transparent 90%);
      }

      a { color: inherit; }
      a:focus-visible {
        outline: 2px solid var(--app-accent);
        outline-offset: 4px;
      }

      .app-shell {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
      }

      .app-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        min-height: 78px;
        border-bottom: 1px solid var(--app-line-soft);
      }

      .app-brand {
        display: inline-flex;
        align-items: baseline;
        gap: 7px;
        min-height: 44px;
        text-decoration: none;
        font-family: var(--app-ui);
        font-size: 12px;
        font-weight: 760;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .app-brand span:first-child { color: var(--app-ink); }
      .app-brand span:last-child { color: var(--app-gold); }

      .app-top-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--app-faint);
        font-family: var(--app-ui);
        font-size: 10px;
        font-weight: 760;
        letter-spacing: .18em;
        text-transform: uppercase;
      }

      .app-top-label::before {
        content: '';
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--app-accent);
        box-shadow: 0 0 18px rgba(73, 198, 213, .6);
      }

      .app-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.03fr) minmax(390px, .97fr);
        gap: clamp(44px, 7vw, 96px);
        align-items: center;
        padding: clamp(72px, 9vw, 116px) 0 clamp(78px, 9vw, 118px);
      }

      .app-eyebrow,
      .app-section-kicker {
        margin: 0 0 18px;
        color: var(--app-accent);
        font-family: var(--app-ui);
        font-size: 10px;
        font-weight: 820;
        letter-spacing: .23em;
        text-transform: uppercase;
      }

      .app-title {
        max-width: 760px;
        margin: 0;
        color: var(--app-ink-strong);
        font-size: clamp(50px, 7.4vw, 94px);
        font-weight: 400;
        line-height: .94;
        letter-spacing: -.047em;
        text-wrap: balance;
      }

      .app-title em {
        display: block;
        margin-top: .14em;
        color: var(--app-gold-bright);
        font-weight: 400;
      }

      .app-lede {
        max-width: 670px;
        margin: 30px 0 0;
        color: var(--app-muted);
        font-family: var(--app-ui);
        font-size: clamp(17px, 1.8vw, 20px);
        line-height: 1.68;
      }

      .app-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        margin-top: 34px;
      }

      .app-primary,
      .app-secondary,
      .app-link-button {
        display: inline-flex;
        min-height: 50px;
        align-items: center;
        justify-content: center;
        gap: 11px;
        padding: 0 21px;
        border-radius: 999px;
        text-decoration: none;
        font-family: var(--app-ui);
        font-size: 13px;
        font-weight: 800;
        line-height: 1;
        transition: transform .2s ease, border-color .2s ease, background-color .2s ease, box-shadow .2s ease, color .2s ease;
      }

      .app-primary {
        border: 1px solid var(--app-gold-bright);
        background: linear-gradient(135deg, var(--app-gold-bright), #bf8e4c);
        color: #15110b;
        box-shadow: 0 18px 44px -26px rgba(225, 182, 111, .72);
      }

      .app-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 22px 48px -24px rgba(225, 182, 111, .9);
      }

      .app-secondary,
      .app-link-button {
        border: 1px solid var(--app-line-cool);
        background: rgba(73, 198, 213, .045);
        color: var(--app-ink);
      }

      .app-secondary:hover,
      .app-link-button:hover {
        transform: translateY(-1px);
        border-color: rgba(73, 198, 213, .42);
        background: var(--app-accent-soft);
      }

      .app-launch-note {
        width: 100%;
        margin-top: 1px;
        color: var(--app-faint);
        font-family: var(--app-ui);
        font-size: 11px;
        line-height: 1.5;
      }

      .app-proof {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 28px 0 0;
        padding: 0;
        list-style: none;
      }

      .app-proof li {
        padding: 8px 11px;
        border: 1px solid var(--app-line-soft);
        border-radius: 999px;
        background: rgba(255, 255, 255, .018);
        color: var(--app-muted);
        font-family: var(--app-ui);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .04em;
      }

      .app-stage {
        position: relative;
        isolation: isolate;
        min-height: 590px;
      }

      .app-stage::before {
        content: '';
        position: absolute;
        inset: 10% 6% 8% 6%;
        z-index: -1;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(73, 198, 213, .21), transparent 68%);
        filter: blur(36px);
      }

      .app-device {
        position: relative;
        overflow: hidden;
        width: min(100%, 470px);
        min-height: 570px;
        margin: 0 auto;
        padding: 18px;
        border: 1px solid rgba(199, 154, 88, .32);
        border-radius: 34px;
        background:
          linear-gradient(155deg, rgba(199, 154, 88, .09), transparent 28%),
          linear-gradient(180deg, rgba(16, 28, 30, .96), rgba(7, 14, 16, .98));
        box-shadow: var(--app-shadow), inset 0 1px rgba(255, 255, 255, .04);
      }

      .app-device::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(135deg, rgba(255, 255, 255, .045), transparent 23%, transparent 78%, rgba(73, 198, 213, .035));
      }

      .app-device-top {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 46px;
        padding: 0 4px 12px;
        border-bottom: 1px solid var(--app-line-soft);
        font-family: var(--app-ui);
      }

      .app-device-brand {
        display: grid;
        gap: 3px;
      }

      .app-device-brand strong {
        color: var(--app-ink-strong);
        font-size: 12px;
        letter-spacing: .02em;
      }

      .app-device-brand span,
      .app-device-status {
        color: var(--app-faint);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
      }

      .app-device-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
      }

      .app-device-status::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--app-accent);
        box-shadow: 0 0 12px rgba(73, 198, 213, .55);
      }

      .app-device-screen {
        position: relative;
        z-index: 1;
        padding: 24px 2px 4px;
      }

      .app-screen-kicker {
        margin: 0 0 8px;
        color: var(--app-accent);
        font-family: var(--app-ui);
        font-size: 9px;
        font-weight: 820;
        letter-spacing: .17em;
        text-transform: uppercase;
      }

      .app-screen-title {
        margin: 0;
        color: var(--app-ink-strong);
        font-size: 34px;
        font-weight: 400;
        line-height: 1.02;
      }

      .app-mode-row {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 20px;
      }

      .app-mode {
        padding: 7px 9px;
        border: 1px solid var(--app-line-soft);
        border-radius: 999px;
        color: var(--app-muted);
        font-family: var(--app-ui);
        font-size: 9px;
        font-weight: 760;
      }

      .app-mode.is-active {
        border-color: rgba(73, 198, 213, .35);
        background: var(--app-accent-soft);
        color: var(--app-accent);
      }

      .app-question-card {
        margin-top: 24px;
        padding: 21px;
        border: 1px solid var(--app-line-soft);
        border-radius: 20px;
        background: rgba(255, 255, 255, .025);
        box-shadow: inset 0 1px rgba(255, 255, 255, .025);
      }

      .app-question-label {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        color: var(--app-faint);
        font-family: var(--app-ui);
        font-size: 9px;
        font-weight: 760;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      .app-question-title {
        max-width: 330px;
        margin: 18px 0 20px;
        color: var(--app-ink);
        font-size: 22px;
        font-weight: 400;
        line-height: 1.24;
      }

      .app-answer-lines {
        display: grid;
        gap: 9px;
      }

      .app-answer-line {
        display: grid;
        grid-template-columns: 26px 1fr;
        gap: 10px;
        align-items: center;
        min-height: 42px;
        padding: 8px 11px;
        border: 1px solid var(--app-line-soft);
        border-radius: 12px;
        color: var(--app-muted);
        font-family: var(--app-ui);
        font-size: 11px;
      }

      .app-answer-line b {
        display: grid;
        width: 24px;
        height: 24px;
        place-items: center;
        border: 1px solid var(--app-line-cool);
        border-radius: 50%;
        color: var(--app-accent);
        font-size: 9px;
      }

      .app-device-flow {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-top: 14px;
      }

      .app-device-flow span {
        padding: 10px 8px;
        border-top: 1px solid var(--app-line-soft);
        color: var(--app-faint);
        font-family: var(--app-ui);
        font-size: 8px;
        font-weight: 760;
        letter-spacing: .07em;
        text-align: center;
        text-transform: uppercase;
      }

      .app-rule {
        height: 1px;
        margin: 0;
        border: 0;
        background: linear-gradient(90deg, transparent, var(--app-line), var(--app-line-cool), transparent);
      }

      .app-section { padding: clamp(72px, 8.5vw, 108px) 0; }

      .app-section-grid {
        display: grid;
        grid-template-columns: minmax(220px, .62fr) minmax(0, 1.38fr);
        gap: clamp(42px, 7vw, 92px);
        align-items: start;
      }

      .app-section h2 {
        max-width: 650px;
        margin: 0;
        color: var(--app-ink-strong);
        font-size: clamp(34px, 4.8vw, 60px);
        font-weight: 400;
        line-height: 1.04;
        letter-spacing: -.032em;
        text-wrap: balance;
      }

      .app-flow {
        position: relative;
        display: grid;
        gap: 0;
        border-top: 1px solid var(--app-line-soft);
      }

      .app-flow-item {
        position: relative;
        display: grid;
        grid-template-columns: 68px minmax(0, 1fr);
        gap: 20px;
        padding: 24px 0;
        border-bottom: 1px solid var(--app-line-soft);
      }

      .app-flow-number {
        color: var(--app-gold);
        font-family: var(--app-ui);
        font-size: 10px;
        font-weight: 820;
        letter-spacing: .16em;
      }

      .app-flow-item h3 {
        margin: 0 0 7px;
        color: var(--app-ink);
        font-size: 23px;
        font-weight: 400;
      }

      .app-flow-item p,
      .app-copy,
      .app-faq dd {
        margin: 0;
        color: var(--app-muted);
        font-family: var(--app-ui);
        font-size: 14px;
        line-height: 1.7;
      }

      .app-capabilities {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 40px;
      }

      .app-capability {
        min-height: 218px;
        padding: 23px;
        border: 1px solid var(--app-line-soft);
        border-radius: 20px;
        background:
          linear-gradient(145deg, rgba(73, 198, 213, .035), transparent 48%),
          rgba(255, 255, 255, .018);
      }

      .app-capability-index {
        display: block;
        margin-bottom: 44px;
        color: var(--app-faint);
        font-family: var(--app-ui);
        font-size: 9px;
        font-weight: 820;
        letter-spacing: .14em;
      }

      .app-capability h3 {
        margin: 0 0 9px;
        color: var(--app-ink);
        font-size: 22px;
        font-weight: 400;
      }

      .app-capability p {
        margin: 0;
        color: var(--app-muted);
        font-family: var(--app-ui);
        font-size: 13px;
        line-height: 1.65;
      }

      .app-bridge {
        position: relative;
        overflow: hidden;
        padding: clamp(30px, 5vw, 54px);
        border: 1px solid var(--app-line);
        border-radius: 28px;
        background:
          linear-gradient(135deg, rgba(199, 154, 88, .08), transparent 34%),
          linear-gradient(315deg, rgba(73, 198, 213, .06), transparent 42%),
          var(--app-surface);
        box-shadow: var(--app-shadow);
      }

      .app-bridge::after {
        content: '↔';
        position: absolute;
        right: clamp(18px, 4vw, 50px);
        top: 18px;
        color: rgba(199, 154, 88, .12);
        font-family: var(--app-ui);
        font-size: clamp(72px, 11vw, 150px);
        font-weight: 300;
        line-height: 1;
        pointer-events: none;
      }

      .app-bridge-head {
        position: relative;
        z-index: 1;
        max-width: 760px;
      }

      .app-bridge-head p:last-child { max-width: 680px; margin-top: 18px; }

      .app-bridge-rail {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-top: 34px;
      }

      .app-bridge-node {
        min-height: 136px;
        padding: 18px;
        border: 1px solid var(--app-line-soft);
        border-radius: 16px;
        background: rgba(3, 8, 9, .26);
      }

      .app-bridge-node span {
        display: block;
        margin-bottom: 23px;
        color: var(--app-accent);
        font-family: var(--app-ui);
        font-size: 8px;
        font-weight: 820;
        letter-spacing: .16em;
        text-transform: uppercase;
      }

      .app-bridge-node strong {
        display: block;
        color: var(--app-ink);
        font-size: 18px;
        font-weight: 400;
        line-height: 1.25;
      }

      .app-study-cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 18px;
      }

      .app-study-card {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 18px;
        align-items: start;
        min-height: 190px;
        padding: 22px;
        border: 1px solid var(--app-line-soft);
        border-radius: 18px;
        background: var(--app-surface-solid);
      }

      .app-study-roman {
        display: grid;
        width: 48px;
        aspect-ratio: 1;
        place-items: center;
        border: 1px solid var(--app-line);
        border-radius: 50%;
        color: var(--app-gold);
        font-size: 14px;
      }

      .app-study-copy h3 {
        margin: 0 0 8px;
        color: var(--app-ink);
        font-size: 20px;
        font-weight: 400;
      }

      .app-study-copy p {
        margin: 0 0 18px;
        color: var(--app-muted);
        font-family: var(--app-ui);
        font-size: 12px;
        line-height: 1.6;
      }

      .app-study-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .app-text-link {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        color: var(--app-accent);
        font-family: var(--app-ui);
        font-size: 11px;
        font-weight: 760;
        text-decoration: none;
      }

      .app-text-link + .app-text-link { color: var(--app-gold-bright); }

      .app-faq { display: grid; gap: 0; margin: 40px 0 0; }

      .app-faq-item {
        display: grid;
        grid-template-columns: minmax(190px, .72fr) minmax(0, 1.28fr);
        gap: 36px;
        padding: 24px 0;
        border-top: 1px solid var(--app-line-soft);
      }

      .app-faq dt {
        color: var(--app-ink);
        font-size: 18px;
      }

      .app-final {
        position: relative;
        padding: clamp(82px, 10vw, 126px) 0;
        text-align: center;
      }

      .app-final h2 {
        max-width: 860px;
        margin: 0 auto;
        color: var(--app-ink-strong);
        font-size: clamp(42px, 6.3vw, 78px);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -.038em;
        text-wrap: balance;
      }

      .app-final .app-copy { max-width: 620px; margin: 23px auto 0; }
      .app-final .app-actions { justify-content: center; }

      .app-footer {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 28px 0 44px;
        border-top: 1px solid var(--app-line-soft);
        color: var(--app-faint);
        font-family: var(--app-ui);
        font-size: 10px;
        line-height: 1.5;
      }

      @media (max-width: 980px) {
        .app-hero { grid-template-columns: 1fr; }
        .app-stage { min-height: 0; }
        .app-device { margin-top: 6px; }
        .app-section-grid { grid-template-columns: 1fr; gap: 34px; }
      }

      @media (max-width: 720px) {
        .app-shell { width: min(100% - 24px, 680px); }
        .app-topbar { min-height: 66px; }
        .app-top-label { display: none; }
        .app-hero { padding-top: 58px; gap: 44px; }
        .app-title { font-size: clamp(48px, 15vw, 72px); }
        .app-device { min-height: 0; padding: 15px; border-radius: 26px; }
        .app-capabilities,
        .app-study-cards,
        .app-bridge-rail { grid-template-columns: 1fr; }
        .app-capability { min-height: 0; }
        .app-capability-index { margin-bottom: 28px; }
        .app-study-card { min-height: 0; }
        .app-faq-item { grid-template-columns: 1fr; gap: 9px; }
        .app-footer { flex-direction: column; }
      }

      @media (max-width: 460px) {
        .app-actions { align-items: stretch; }
        .app-primary,
        .app-secondary { width: 100%; }
        .app-proof { gap: 6px; }
        .app-question-card { padding: 17px; }
        .app-screen-title { font-size: 30px; }
        .app-device-flow { grid-template-columns: 1fr; }
        .app-device-flow span { text-align: left; }
        .app-study-card { grid-template-columns: 1fr; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .app-primary,
        .app-secondary,
        .app-link-button { transition: none; }
        .app-primary:hover,
        .app-secondary:hover,
        .app-link-button:hover { transform: none; }
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <header class="app-topbar" aria-label="Навигация страницы">
        <a class="app-brand" href="/" aria-label="Господь Бог — Сила Моя — на главную">
          <span>Господь Бог</span><span>— Сила Моя</span>
        </a>
        <span class="app-top-label">Библейский тренажёр · 1 Петра</span>
      </header>

      <main data-pagefind-body>
        <section class="app-hero" aria-labelledby="app-title">
          <div>
            <p class="app-eyebrow">Интерактивное изучение Писания</p>
            <h1 class="app-title" id="app-title">Читайте глубже. Проверяйте себя. <em>Возвращайтесь к тексту.</em></h1>
            <p class="app-lede">
              Библейский тренажёр соединяет исследовательскую библиотеку сайта с практикой: глава,
              вопрос, ваш ответ, объяснение, разбор ответов — и осмысленное возвращение к Писанию.
            </p>
            <div class="app-actions">
              <a class="app-primary" href={launchUrl} target="_blank" rel="noopener noreferrer">
                <span>Открыть тренажёр</span><span aria-hidden="true">↗</span>
              </a>
              <a class="app-secondary" href={profileUrl} target="_blank" rel="noopener noreferrer">@milovanovaibot</a>
              <span class="app-launch-note">Telegram Mini App · прогресс и история доступны внутри приложения</span>
            </div>
            <ul class="app-proof" aria-label="Возможности тренажёра">
              <li>Изучение по главам</li>
              <li>3 режима</li>
              <li>Challenge 20</li>
              <li>Разбор ответов</li>
            </ul>
          </div>

          <aside class="app-stage" aria-label="Предпросмотр Библейского тренажёра">
            <div class="app-device">
              <div class="app-device-top">
                <div class="app-device-brand">
                  <strong>Библейский тренажёр</strong>
                  <span>Господь Бог — Сила Моя</span>
                </div>
                <span class="app-device-status">Mini App</span>
              </div>
              <div class="app-device-screen">
                <p class="app-screen-kicker">1 Петра · глава 3</p>
                <h2 class="app-screen-title">Проверка понимания</h2>
                <div class="app-mode-row" aria-label="Режимы тренажёра">
                  <span class="app-mode is-active">Спокойный</span>
                  <span class="app-mode">На время</span>
                  <span class="app-mode">Скоростной</span>
                </div>
                <div class="app-question-card">
                  <div class="app-question-label"><span>Вопрос</span><span>по тексту главы</span></div>
                  <p class="app-question-title">Сначала вспомните смысл текста — затем сверяйте ответ.</p>
                  <div class="app-answer-lines" aria-hidden="true">
                    <div class="app-answer-line"><b>A</b><span>Вариант ответа</span></div>
                    <div class="app-answer-line"><b>B</b><span>Вариант ответа</span></div>
                    <div class="app-answer-line"><b>C</b><span>Вариант ответа</span></div>
                  </div>
                </div>
                <div class="app-device-flow" aria-label="Учебный цикл">
                  <span>Ответ</span><span>Объяснение</span><span>Следующий шаг</span>
                </div>
              </div>
            </div>
          </aside>
        </section>

        <hr class="app-rule" />

        <section class="app-section app-section-grid" aria-labelledby="how-title">
          <div>
            <p class="app-section-kicker">Учебный цикл</p>
            <h2 id="how-title">Не механический тест, а четыре последовательных действия.</h2>
          </div>
          <div class="app-flow">
            <article class="app-flow-item">
              <span class="app-flow-number">01</span>
              <div><h3>Читайте</h3><p>Начните с главы или исследования, которое действительно изучаете.</p></div>
            </article>
            <article class="app-flow-item">
              <span class="app-flow-number">02</span>
              <div><h3>Вспоминайте</h3><p>Отвечайте без подсказки и проверяйте, что осталось после чтения.</p></div>
            </article>
            <article class="app-flow-item">
              <span class="app-flow-number">03</span>
              <div><h3>Разбирайте</h3><p>Ошибочный ответ превращается в точку повторения, а не в тупик.</p></div>
            </article>
            <article class="app-flow-item">
              <span class="app-flow-number">04</span>
              <div><h3>Возвращайтесь</h3><p>Продолжайте курс или возвращайтесь к статье уже с более точным вопросом.</p></div>
            </article>
          </div>
        </section>

        <hr class="app-rule" />

        <section class="app-section" aria-labelledby="inside-title">
          <p class="app-section-kicker">Что внутри</p>
          <h2 id="inside-title">Инструменты для регулярной работы с 1 Петра.</h2>
          <div class="app-capabilities">
            <article class="app-capability">
              <span class="app-capability-index">01 · ПО ГЛАВАМ</span>
              <h3>Последовательные курсы</h3>
              <p>Переходите от одной главы к другой и продолжайте изучение без потери контекста.</p>
            </article>
            <article class="app-capability">
              <span class="app-capability-index">02 · ТЕМП</span>
              <h3>Три режима</h3>
              <p>Спокойный, на время и скоростной — для разных задач повторения и самопроверки.</p>
            </article>
            <article class="app-capability">
              <span class="app-capability-index">03 · РАЗБОР</span>
              <h3>Challenge 20 и разбор</h3>
              <p>Отдельный вызов и разбор ответов после результата помогают увидеть слабые места и повторить материал.</p>
            </article>
            <article class="app-capability">
              <span class="app-capability-index">04 · ПРОГРЕСС</span>
              <h3>История и достижения</h3>
              <p>Возвращайтесь к своим результатам и отслеживайте пройденные этапы внутри Mini App.</p>
            </article>
          </div>
        </section>

        <section class="app-section" aria-labelledby="bridge-title">
          <div class="app-bridge">
            <div class="app-bridge-head">
              <p class="app-section-kicker">Сайт + тренажёр</p>
              <h2 id="bridge-title">Один исследовательский маршрут вместо двух разрозненных продуктов.</h2>
              <p class="app-copy">
                Сайт остаётся местом глубокого чтения и источников. Mini App — местом активного воспроизведения.
                Контекстные переходы связывают конкретную главу с её исследованием и возвращают вас к чтению.
              </p>
            </div>
            <div class="app-bridge-rail" role="list" aria-label="Связка сайта и приложения">
              <div class="app-bridge-node" role="listitem"><span>01 · Сайт</span><strong>Читайте текст, разбор и источники.</strong></div>
              <div class="app-bridge-node" role="listitem"><span>02 · Mini App</span><strong>Проверьте, что поняли и запомнили.</strong></div>
              <div class="app-bridge-node" role="listitem"><span>03 · Возврат</span><strong>Вернитесь к статье с точным вопросом.</strong></div>
            </div>
          </div>

          <div class="app-study-cards" aria-label="Связанные главы и исследования">
            <article class="app-study-card">
              <span class="app-study-roman" aria-hidden="true">III</span>
              <div class="app-study-copy">
                <h3>1 Петра · глава 3</h3>
                <p>Связка тренажёра с исследованием о духах в темнице, крещении и победе Христа.</p>
                <div class="app-study-actions">
                  <a class="app-text-link" href="/hard-texts/duhi-v-temnice-noi-kreshchenie-pobeda/">Читать исследование →</a>
                  <a class="app-text-link" href={chapter3LaunchUrl} target="_blank" rel="noopener noreferrer">Проверить главу ↗</a>
                </div>
              </div>
            </article>
            <article class="app-study-card">
              <span class="app-study-roman" aria-hidden="true">IV</span>
              <div class="app-study-copy">
                <h3>1 Петра · глава 4</h3>
                <p>Связка тренажёра с исследованием трудного текста о благовестии мёртвым.</p>
                <div class="app-study-actions">
                  <a class="app-text-link" href="/hard-texts/blagovestie-mertvym-1-petra-4-5-6/">Читать исследование →</a>
                  <a class="app-text-link" href={chapter4LaunchUrl} target="_blank" rel="noopener noreferrer">Проверить главу ↗</a>
                </div>
              </div>
            </article>
          </div>
        </section>

        <hr class="app-rule" />

        <section class="app-section app-section-grid" aria-labelledby="faq-title">
          <div>
            <p class="app-section-kicker">Перед началом</p>
            <h2 id="faq-title">Доступ без лишних барьеров.</h2>
          </div>
          <dl class="app-faq">
            <div class="app-faq-item">
              <dt>Где открывается?</dt>
              <dd>Тренажёр работает как приложение внутри Telegram. Основная кнопка откроет Mini App напрямую.</dd>
            </div>
            <div class="app-faq-item">
              <dt>Нужно ли устанавливать отдельное приложение?</dt>
              <dd>Нет. Если Telegram уже установлен, отдельная установка тренажёра не требуется.</dd>
            </div>
            <div class="app-faq-item">
              <dt>Можно ли читать материалы без Telegram?</dt>
              <dd>Да. Исследовательская библиотека остаётся обычным веб-сайтом и работает отдельно от тренажёра.</dd>
            </div>
          </dl>
        </section>

        <section class="app-final" aria-labelledby="final-title">
          <p class="app-section-kicker">Продолжить изучение</p>
          <h2 id="final-title">Пусть чтение превращается в устойчивое знание.</h2>
          <p class="app-copy">Откройте тренажёр, выберите главу и продолжите с того уровня, который нужен именно сейчас.</p>
          <div class="app-actions">
            <a class="app-primary" href={launchUrl} target="_blank" rel="noopener noreferrer">
              <span>Открыть Библейский тренажёр</span><span aria-hidden="true">↗</span>
            </a>
            <a class="app-link-button" href="/articles/">Вернуться в библиотеку</a>
          </div>
        </section>
      </main>

      <footer class="app-footer">
        <span>© Господь Бог — Сила Моя</span>
        <span>Библейский тренажёр · Telegram Mini App · @milovanovaibot</span>
      </footer>
    </div>
  </body>
</html>
