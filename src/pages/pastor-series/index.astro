---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';

const canonical = `${SITE.url}/pastor-series/`;
const title = 'Тёмная сторона кафедры — Серия материалов | Господь Бог — Сила Моя';
const description = 'Авторская серия о системных искажениях церковного руководства, механике манипуляций и путях восстановления библейского пасторства.';
const cards = [
  { title: 'Коротко', href: '/pastor-series/', text: 'Серия исследует власть без подотчётности, манипуляцию Писанием, страх, шантаж благочестием и здоровые библейские альтернативы.' },
  { title: 'Блок 1. Диагностика', href: '/articles/20-antisovetov-pastoru/', text: '20 антисоветов: как пастору разрушить своё служение. Материал уже доступен как подробный пастырский разбор.' },
  { title: 'Блок 2. Распознавание', href: '/pastor-series/', text: 'Будущие материалы серии будут помогать различать системные паттерны контроля, сокрытия и давления.' },
  { title: 'Блок 3. Здоровый образец', href: '/pastor-series/', text: 'Финальная цель серии — не подозрительность, а восстановление церковной культуры, где Христос глава, а пастыри подотчётны Слову.' },
  { title: 'Нашли неточность?', href: '/about/', text: 'Материалы этой темы требуют особой аккуратности. Если видите неточность или перекос, сообщите редактору проекта.' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': `${canonical}#collectionpage`, name: 'Тёмная сторона кафедры — серия материалов', url: canonical, description, inLanguage: 'ru', isPartOf: { '@id': SITE.websiteId }, publisher: { '@id': SITE.orgId }, image: `${SITE.url}/images/pastor-series/og-hero.webp` },
    { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumbs`, itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Тёмная сторона кафедры', item: canonical },
    ] },
  ],
};
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={`${SITE.url}/images/pastor-series/og-hero.webp`} ogTitle="Тёмная сторона кафедры — серия материалов" ogDescription="Системный анализ искажений власти, механики манипуляций и путей к здоровой церковной культуре." jsonLd={jsonLd}>
  <section class="astro-page astro-series-page" data-pagefind-body>
    <header class="astro-page__header">
      <p class="astro-eyebrow">Серия материалов</p>
      <h1>Тёмная сторона кафедры</h1>
      <p>{description}</p>
      <p>Эта страница собирает материалы о церковной власти, ответственности, манипуляции и восстановлении здоровой пастырской культуры. Её нужно читать трезво: не как повод к подозрительности, а как помощь в различении и исцелении.</p>
      <p>Первый опубликованный материал — «20 антисоветов» — описывает не случайные ошибки служителя, а повторяющиеся паттерны: любовь к первому месту, автономия без подотчётности, управление страхом, сокрытие правды и фальшивое покаяние без изменения.</p>
      <p>Серия одновременно защищает и паству, и верное пастырство: сильное библейское руководство не равно авторитарности, а честные вопросы не равны мятежу. Цель — церковная культура, где Христос остаётся Главой, Слово Божье выше репутации, а пастыри и община ходят во свете.</p>
      <p>Эти тексты нельзя использовать как дубинку против всякого служителя или как разрешение на сплетни. Они нужны для проверки фактов, различения системных искажений, защиты пострадавших, покаяния лидеров и восстановления доверия там, где оно возможно без сокрытия правды, страха, церковной показухи, защитных легенд и духовного тумана, давления.</p>
    </header>
    <div class="astro-card-grid" aria-label="Материалы серии">
      {cards.map((card) => <article class="astro-card"><h2><a href={card.href}>{card.title}</a></h2><p>{card.text}</p></article>)}
    </div>
  </section>
</BaseLayout>
