---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SECTION_META, SITE, SERIES_ORDER } from '@/data/site';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';

interface Props {
  entry: CollectionEntry<'articles'>;
  canonical: string;
  robots?: string;
  pilot?: boolean;
  intendedCanonical?: string;
}

const { entry, canonical, robots, pilot = false, intendedCanonical } = Astro.props;
const data = entry.data;
const isTranslation = data.author === 'abner-chou';
const articleAuthorName = isTranslation ? 'Абнер Чау' : SITE.authorName;
const editorialRole = isTranslation ? 'Редактор' : 'Автор-редактор';
const editorialName = SITE.authorName;
const h1 = data.h1 || data.title;

function legacyArticleMetaTime(prop: 'article:published_time' | 'article:modified_time') {
  const file = path.join(process.cwd(), data.section, data.slug, 'index.html');
  if (!existsSync(file)) return '';
  const html = readFileSync(file, 'utf8');
  const escaped = prop.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return html.match(new RegExp(`<meta\\b[^>]*property=["']${escaped}["'][^>]*content=["']([^"']+)["'][^>]*>`, 'i'))?.[1]
    || html.match(new RegExp(`<meta\\b[^>]*content=["']([^"']+)["'][^>]*property=["']${escaped}["'][^>]*>`, 'i'))?.[1]
    || '';
}
function safeDate(value: unknown) {
  const d = value instanceof Date ? value : value ? new Date(String(value)) : undefined;
  return d && Number.isFinite(d.valueOf()) ? d : undefined;
}

// Public shadow articles must mirror legacy root SEO exactly. update-meta.js may
// refresh root HTML timestamps before Astro builds; read them from legacy HTML so
// MDX shadow output cannot drift and falsely claim parity.
const legacyPublished = safeDate(legacyArticleMetaTime('article:published_time'));
const legacyUpdated = safeDate(legacyArticleMetaTime('article:modified_time'));
const published = legacyPublished || safeDate(data.publishedAt) || new Date(data.publishedAt);
const updated = legacyUpdated || safeDate(data.updatedAt);
const ogImage = data.ogImage?.startsWith('http') ? data.ogImage : data.ogImage ? `${SITE.url}${data.ogImage}` : undefined;
const articleCanonical = intendedCanonical || data.canonicalOverride || `${SITE.url}/${data.section}/${data.slug}/`;

const sectionMeta = SECTION_META[data.section];
const articleSectionName = sectionMeta?.label || data.section;
const articleSectionUrl = sectionMeta?.url || `${SITE.url}/${data.section}/`;
const articleEyebrow = sectionMeta?.eyebrow || articleSectionName;
const effectiveRobots = robots || (data.noindex ? 'noindex, follow' : 'index, follow');

// --- Series navigation ---
let seriesPrev: CollectionEntry<'articles'> | null = null;
let seriesNext: CollectionEntry<'articles'> | null = null;
let seriesPos = 0;
let seriesTotal = 0;
let seriesLabel = '';

if (data.series && SERIES_ORDER[data.series]) {
  const order = SERIES_ORDER[data.series];
  const allArticles = await getCollection('articles', ({ data: d }) => d.series === data.series);
  const sorted = order
    .map(slug => allArticles.find(a => a.data.slug === slug))
    .filter(Boolean) as CollectionEntry<'articles'>[];
  
  const idx = sorted.findIndex(a => a.data.slug === data.slug);
  if (idx >= 0) {
    seriesPos = idx + 1;
    seriesTotal = sorted.length;
    seriesPrev = idx > 0 ? sorted[idx - 1] : null;
    seriesNext = idx < sorted.length - 1 ? sorted[idx + 1] : null;
  }

  const seriesNames: Record<string, string> = {
    'dzhon-gill': 'Джон Гилл',
    'russian-baptism': 'Баптисты России',
    'hard-texts': 'Тайны человеческого сердца',
    'pastor-series': 'Тёмная сторона кафедры',
  };
  seriesLabel = seriesNames[data.series] || data.series;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': isTranslation ? 'ScholarlyArticle' : 'Article',
      '@id': `${articleCanonical}#article`,
      headline: data.title,
      description: data.description,
      url: articleCanonical,
      inLanguage: 'ru-RU',
      datePublished: published.toISOString(),
      dateModified: (updated || published).toISOString(),
      author: {
        '@id': isTranslation ? `${SITE.url}/authors/abner-chou/#person` : `${SITE.url}/about/#person`,
        '@type': 'Person',
        name: articleAuthorName,
        url: isTranslation ? `${SITE.url}/authors/abner-chou/` : `${SITE.url}/about/`,
      },
      translator: isTranslation
        ? { '@id': `${SITE.url}/about/#person`, '@type': 'Person', name: SITE.authorName, url: `${SITE.url}/about/` }
        : undefined,
      publisher: { '@id': SITE.orgId },
      mainEntityOfPage: { '@type': 'WebPage', '@id': articleCanonical },
      image: ogImage ? { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 } : undefined,
      articleSection: articleSectionName,
    },
    {
      '@type': 'WebPage',
      '@id': articleCanonical,
      url: articleCanonical,
      name: data.title,
      description: data.description,
      isPartOf: { '@id': SITE.websiteId },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${articleCanonical}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: articleSectionName, item: articleSectionUrl },
        { '@type': 'ListItem', position: 3, name: data.title, item: articleCanonical },
      ],
    },
  ],
};
---
<BaseLayout
  title={pilot ? `MDX pilot · ${data.title}` : data.title}
  description={data.description}
  canonical={canonical}
  robots={effectiveRobots}
  ogImage={ogImage}
  ogImageAlt={data.ogImageAlt || data.title}
  ogTitle={data.title}
  ogDescription={data.description}
  ogType="article"
  articlePublishedTime={published.toISOString()}
  articleModifiedTime={(updated || published).toISOString()}
  articleAuthor={articleAuthorName}
  jsonLd={jsonLd}
  technicalBadge={pilot ? 'MDX content pilot · noindex' : undefined}
  footerNote={pilot ? 'Build-only article pipeline preview' : undefined}
>
  <article class="astro-article" data-article-slug={data.slug} data-pagefind-body>
    <span data-pagefind-meta="author" hidden>{articleAuthorName}</span>
    {data.readingTime && <span data-pagefind-meta="readTime" hidden>{data.readingTime}</span>}
    <span data-pagefind-meta="category" hidden>{articleSectionName}</span>
    {ogImage && <span data-pagefind-meta="image" hidden>{ogImage.replace(SITE.url, '')}</span>}

    {pilot && (
      <aside class="astro-pilot-note" aria-label="Статус MDX-пилота">
        <strong>Build-only MDX pilot.</strong>
        <span> Production legacy URL не заменён. Intended canonical: <code>{articleCanonical}</code></span>
      </aside>
    )}

    <header class="astro-article__header">
      <p class="astro-article__eyebrow">{articleEyebrow}</p>
      <h1>{h1}</h1>
      <p class="astro-article__lead">{data.description}</p>
      <p class="astro-article__byline">
        <span class="astro-article__byline-strong">{editorialRole}: {editorialName}</span>
        {isTranslation && <><span aria-hidden="true">·</span><span>Оригинал: {articleAuthorName}</span></>}
      </p>
      <dl class="astro-article__meta">
        <div>
          <dt>Опубликовано</dt>
          <dd><time datetime={published.toISOString()}>{published.toLocaleDateString('ru-RU')}</time></dd>
        </div>
        {updated && (
          <div>
            <dt>Обновлено</dt>
            <dd><time datetime={updated.toISOString()}>{updated.toLocaleDateString('ru-RU')}</time></dd>
          </div>
        )}
        {data.readingTime && (
          <div>
            <dt>Чтение</dt>
            <dd>{data.readingTime} мин.</dd>
          </div>
        )}
      </dl>
      {data.tags.length > 0 && (
        <ul class="astro-article__tags" aria-label="Теги">
          {data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>

    <div class="astro-article__body">
      <slot />
    </div>

    <!-- Series navigation -->
    {seriesTotal > 1 && (
      <nav class="astro-series-nav" aria-label={`Серия «${seriesLabel}»`}>
        <div class="astro-series-nav__head">
          <span class="astro-series-nav__label">{seriesLabel}</span>
          <span class="astro-series-nav__pos">{seriesPos} из {seriesTotal}</span>
        </div>
        <div class="astro-series-nav__track">
          {Array.from({ length: seriesTotal }, (_, i) => (
            <span class={`astro-series-nav__dot${i + 1 === seriesPos ? ' astro-series-nav__dot--current' : ''}${i + 1 < seriesPos ? ' astro-series-nav__dot--past' : ''}`}></span>
          ))}
        </div>
        <div class="astro-series-nav__links">
          {seriesPrev ? (
            <a href={`/${data.section}/${seriesPrev.data.slug}/`} class="astro-series-nav__link astro-series-nav__link--prev">
              <span class="astro-series-nav__arrow">←</span>
              <span class="astro-series-nav__text">
                <span class="astro-series-nav__hint">Предыдущая</span>
                <span class="astro-series-nav__title">{seriesPrev.data.h1 || seriesPrev.data.title}</span>
              </span>
            </a>
          ) : <div></div>}
          {seriesNext ? (
            <a href={`/${data.section}/${seriesNext.data.slug}/`} class="astro-series-nav__link astro-series-nav__link--next">
              <span class="astro-series-nav__text">
                <span class="astro-series-nav__hint">Следующая</span>
                <span class="astro-series-nav__title">{seriesNext.data.h1 || seriesNext.data.title}</span>
              </span>
              <span class="astro-series-nav__arrow">→</span>
            </a>
          ) : <div></div>}
        </div>
      </nav>
    )}

    <!-- Baptisty-rossii context -->
    {data.series === 'russian-baptism' && (
      <section class="astro-series-context" aria-label="Контекст серии Баптисты России">
        <h2>Как эта часть связана со всей серией</h2>
        <p>
          Эта публикация входит в цикл <strong>«Баптисты России»</strong>, где одна линия не существует сама по себе:
          Тифлис, южная штунда, Петербург, союзная организация, гонения, советская перестройка церковной жизни,
          Инициативная группа и подпольная печать читаются как одна связанная история, а не как разрозненные эпизоды.
        </p>
        <p>
          Поэтому каждую часть лучше держать рядом с общим хабом серии и с 3D-картой русского баптизма: текст даёт даты,
          нюансы и спорные места, а карта помогает видеть маршруты, узлы, людей и линии влияния. Если вы читаете эту тему
          впервые, начните с общего обзора серии, а затем возвращайтесь к соседним частям и справочнику.
        </p>
        <p class="astro-series-context__links">
          <a href="/baptisty-rossii/">Открыть весь цикл</a>
          <span aria-hidden="true">·</span>
          <a href="/konfessii/russkij-baptizm/">Перейти к 3D-карте</a>
        </p>
      </section>
    )}

    <!-- Author card -->
    <aside class="astro-author-card" aria-label="Об авторе-редакторе">
      <div class="astro-author-card__icon" aria-hidden="true">ФМ</div>
      <div class="astro-author-card__body">
        <div class="astro-author-card__label">{editorialRole}</div>
        <div class="astro-author-card__name">{editorialName}</div>
        <p class="astro-author-card__desc">
          {isTranslation
            ? 'Перевод выполнен в рамках проекта «Господь Бог — Сила Моя». Оригинальный автор указан в байлайне.'
            : 'Материал подготовлен в рамках проекта «Господь Бог — Сила Моя» — христианского богословского сайта со статьями, биографиями, серией «Нагорная проповедь» и интерактивными картами. Проект существует на личные средства автора-редактора и не собирает пожертвований.'}
          <a href="/about/">Об авторе →</a>
        </p>
      </div>
    </aside>
  </article>
</BaseLayout>
