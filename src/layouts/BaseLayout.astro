---
import Seo from '@/components/seo/Seo.astro';
import Header from '@/components/ui/Header.astro';
import Footer from '@/components/ui/Footer.astro';
import { SITE } from '@/data/site';
import { assetUrl } from '@/lib/asset-version';
import '@/styles/tokens.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogImage?: string;
  ogImageType?: string;
  ogImageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article' | 'profile';
  profileFirstName?: string;
  profileLastName?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  jsonLd?: unknown;
  technicalBadge?: string;
  footerNote?: string;
  bodyClass?: string;
  mainClass?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  legacyStylesheets?: string[];
  includeLegacyRuntime?: boolean;
}
const {
  title,
  description,
  canonical,
  robots,
  ogImage,
  ogImageType,
  ogImageAlt,
  ogTitle,
  ogDescription,
  ogType,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  profileFirstName,
  profileLastName,
  jsonLd,
  technicalBadge,
  footerNote,
  bodyClass = '',
  mainClass = 'astro-main',
  hideHeader = false,
  hideFooter = false,
  legacyStylesheets = [],
  includeLegacyRuntime = true,
} = Astro.props;

function routeToLegacyFile(canonicalUrl: string) {
  try {
    const url = new URL(canonicalUrl);
    let route = decodeURIComponent(url.pathname || '/');
    if (route === '/') return 'index.html';
    route = route.replace(/^\/+/, '').replace(/\/+$/, '');
    if (!route) return 'index.html';
    return `${route}/index.html`;
  } catch {
    return '';
  }
}

// Legacy runtime I/O and dead helper functions removed (REF-01 / REF-02).
// The generic runtime is now emitted as native Astro <script> elements in the
// body (see below) instead of a raw-HTML string blob — strict-native clean
// per the route-source contract (no legacy runtime transport markers).

const runtimePageId =
  routeToLegacyFile(canonical).replace(/\/index\.html$/, '').replace(/\//g, '-') || 'home';
const runtimeConfig = {
  site: {
    name: SITE.name,
    baseUrl: SITE.url,
    locale: SITE.locale,
  },
  version: Date.now(),
  page: {
    id: runtimePageId,
    type: ogType === 'article' ? 'article' : 'page',
    title,
    description,
    url: canonical,
  },
  features: {
    themeToggle: { enabled: true },
    search: { enabled: true },
    bookmarks: { enabled: false },
    quiz: { enabled: false },
  },
};
const runtimeScripts = [
  assetUrl('js/site-utils.js'),
  assetUrl('js/scroll-perf.js'),
  assetUrl('js/site.js'),
  assetUrl('js/sw-register.js'),
];
const searchSrc = assetUrl('js/search.js');
import ReaderPreferencesHead from '@/components/reader-platform/ReaderPreferencesHead.astro';
---
<!doctype html>
<html lang="ru">
  <head>
    
    <meta charset="utf-8" />
  <ReaderPreferencesHead />
  
  
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      robots={robots}
      ogImage={ogImage}
      ogImageType={ogImageType}
      ogImageAlt={ogImageAlt}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogType={ogType}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
      articleAuthor={articleAuthor}
      profileFirstName={profileFirstName}
      profileLastName={profileLastName}
      jsonLd={jsonLd}
    />
    <!-- Core project CSS — loaded on every page so Astro-owned routes match
         the legacy visual contract. Additional per-route stylesheets are passed
         via the `legacyStylesheets` prop as native <link> elements below. -->
    <!-- Navigation prefetch hints — browser loads these speculatively during
         idle time. The current page is excluded: prefetching yourself is pure
         wasted bandwidth (NEW-PREFETCH-UNCONDITIONAL). -->
    {['/articles/', '/biografii/', '/hard-texts/', '/karty/', '/about/']
      .filter((href) => href !== Astro.url.pathname)
      .map((href) => <link rel="prefetch" href={href} />)}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Lora/lora-cyrillic-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Inter/inter-cyrillic-600.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/PlayfairDisplay/playfairdisplay-cyrillic-700.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/command-palette.css" />
    <link rel="stylesheet" href="/css/mobile-hotfix.css" />
    {legacyStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
  </head>
  <body class={bodyClass}>
    <div class="astro-shell">
      {!hideHeader && <Header badge={technicalBadge} />}
      <main class={mainClass}>
        <slot />
      </main>
      {!hideFooter && <Footer note={footerNote} />}
    </div>
    {includeLegacyRuntime && (
      <>
        <link rel="preconnect" href="https://mc.yandex.ru" crossorigin />
        <script is:inline>
          {`(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');ym(108353327,'init',{ssr:false,webvisor:true,clickmap:true,accurateTrackBounce:true,trackLinks:true});`}
        </script>
        <noscript><div><img alt="" decoding="async" src="https://mc.yandex.ru/watch/108353327" style="position:absolute;left:-9999px;" /></div></noscript>
        <script is:inline define:vars={{ __gbSiteConfig: runtimeConfig }}>
          window.SITE_CONFIG = __gbSiteConfig;
        </script>
        {runtimeScripts.map((src) => <script is:inline defer src={src}></script>)}
        {/* Lazy search: ~31KB saved on initial pageload. search.js loads on first Ctrl+K / click. */}
        <script is:inline define:vars={{ __gbSearchSrc: searchSrc }}>
          {`!function(){var e=function(o){window.__gbSearchBootRequested=true,window.__gbSearchOpenAfterLoad=!!o;var t=document.createElement("script");t.defer=true,t.src=__gbSearchSrc,document.head.appendChild(t);e=function(){}};function u(o){e(o),document.removeEventListener("keydown",k),document.removeEventListener("click",c),document.removeEventListener("touchstart",c)}function k(n){(n.metaKey||n.ctrlKey)&&"k"===String(n.key).toLowerCase()&&(n.preventDefault(),u(true))}function c(){u(false)}document.addEventListener("keydown",k),document.addEventListener("click",c),document.addEventListener("touchstart",c)}();`}
        </script>
      </>
    )}
  </body>
</html>
