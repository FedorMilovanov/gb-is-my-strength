---
import Seo from '@/components/seo/Seo.astro';
import Header from '@/components/ui/Header.astro';
import Footer from '@/components/ui/Footer.astro';
import { SITE } from '@/data/site';
import { assetUrl } from '@/lib/asset-version';
import '@/styles/tokens.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogImage?: string;
  ogImageType?: string;
  ogImageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article' | 'profile';
  profileFirstName?: string;
  profileLastName?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  jsonLd?: unknown;
  technicalBadge?: string;
  footerNote?: string;
  bodyClass?: string;
  mainClass?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  legacyStylesheets?: string[];
  headHtml?: string;
  bodyEndHtml?: string;
  includeLegacyRuntime?: boolean;
}
const {
  title,
  description,
  canonical,
  robots,
  ogImage,
  ogImageType,
  ogImageAlt,
  ogTitle,
  ogDescription,
  ogType,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  profileFirstName,
  profileLastName,
  jsonLd,
  technicalBadge,
  footerNote,
  bodyClass = '',
  mainClass = 'astro-main',
  hideHeader = false,
  hideFooter = false,
  legacyStylesheets = [],
  headHtml = '',
  bodyEndHtml = '',
  includeLegacyRuntime = true,
} = Astro.props;

function routeToLegacyFile(canonicalUrl: string) {
  try {
    const url = new URL(canonicalUrl);
    let route = decodeURIComponent(url.pathname || '/');
    if (route === '/') return 'index.html';
    route = route.replace(/^\/+/, '').replace(/\/+$/, '');
    if (!route) return 'index.html';
    return `${route}/index.html`;
  } catch {
    return '';
  }
}

// Legacy runtime I/O and dead helper functions removed (REF-01 / REF-02)

function makeGenericRuntime(includeMetrika = true) {
  const pageId = routeToLegacyFile(canonical).replace(/\/index\.html$/, '').replace(/\//g, '-') || 'home';
  const config = {
    site: {
      name: SITE.name,
      baseUrl: SITE.url,
      locale: SITE.locale,
    },
    page: {
      id: pageId,
      type: ogType === 'article' ? 'article' : 'page',
      title,
      description,
      url: canonical,
    },
    features: {
      themeToggle: { enabled: true },
      search: { enabled: true },
      bookmarks: { enabled: false },
      quiz: { enabled: false },
    },
  };
  const metrika_preconnect = `<link rel="preconnect" href="https://mc.yandex.ru" crossorigin>`;
  const metrika = `<script>\n(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');\nym(108353327,'init',{ssr:false,webvisor:true,clickmap:true,accurateTrackBounce:true,trackLinks:true});\n</script>\n<noscript><div><img alt="" decoding="async" src="https://mc.yandex.ru/watch/108353327" style="position:absolute;left:-9999px;"></div></noscript>`;
  const cfg = `<script>window.SITE_CONFIG=${JSON.stringify(config)};</script>`;
  return [
    includeMetrika ? metrika_preconnect + metrika : '',
    cfg,
    `<script defer src="${assetUrl('js/site-utils.js')}"></script>`,
    `<script defer src="${assetUrl('js/scroll-perf.js')}"></script>`,
    `<script defer src="${assetUrl('js/site.js')}"></script>`,
    `<script defer src="${assetUrl('js/sw-register.js')}"></script>`,
    // Lazy search: ~31KB saved on initial pageload. search.js loads on first Ctrl+K / click.
    `<script>!function(){var e=function(){var t=document.createElement("script");t.defer=true,t.src="${assetUrl('js/search.js')}",document.head.appendChild(t);e=function(){}};function u(){e(),document.removeEventListener("keydown",k),document.removeEventListener("click",c),document.removeEventListener("touchstart",c)}function k(n){(n.metaKey||n.ctrlKey)&&"k"===String(n.key).toLowerCase()&&(n.preventDefault(),u())}function c(){u()}document.addEventListener("keydown",k),document.addEventListener("click",c),document.addEventListener("touchstart",c)}();</script>`,
  ].join('\n');
}

// Generate clean generic runtime without filesystem I/O
const genericRuntime = includeLegacyRuntime && !headHtml ? makeGenericRuntime(true) : '';
const effectiveBodyEndHtml = [genericRuntime, bodyEndHtml].filter(Boolean).join('\n');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      robots={robots}
      ogImage={ogImage}
      ogImageType={ogImageType}
      ogImageAlt={ogImageAlt}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogType={ogType}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
      articleAuthor={articleAuthor}
      profileFirstName={profileFirstName}
      profileLastName={profileLastName}
      jsonLd={jsonLd}
    />
    <!-- Core project CSS — loaded on every page so Astro-owned routes match
         the legacy visual contract. Shadow-wrapped pages also receive their
         legacy-extracted CSS (links + inline <style>) via headHtml below; any
         overlap is the same file and is harmlessly deduped by the browser. -->
    <!-- Navigation prefetch hints — browser loads these speculatively during idle time -->
    <link rel="prefetch" href="/articles/" />
    <link rel="prefetch" href="/biografii/" />
    <link rel="prefetch" href="/hard-texts/" />
    <link rel="prefetch" href="/karty/" />
    <link rel="prefetch" href="/about/" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Lora/lora-cyrillic-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Inter/inter-cyrillic-600.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/PlayfairDisplay/playfairdisplay-cyrillic-700.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/command-palette.css" />
    <link rel="stylesheet" href="/css/mobile-hotfix.css" />
    {legacyStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    {headHtml && <Fragment set:html={headHtml} />}
  </head>
  <body class={bodyClass}>
    <div class="astro-shell">
      {!hideHeader && <Header badge={technicalBadge} />}
      <main class={mainClass}>
        <slot />
      </main>
      {!hideFooter && <Footer note={footerNote} />}
    </div>
    {effectiveBodyEndHtml && <Fragment set:html={effectiveBodyEndHtml} />}
  </body>
</html>
