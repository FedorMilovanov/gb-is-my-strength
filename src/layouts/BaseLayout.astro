---
import Seo from '@/components/seo/Seo.astro';
import Header from '@/components/ui/Header.astro';
import Footer from '@/components/ui/Footer.astro';
import '@/styles/tokens.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogImage?: string;
  jsonLd?: unknown;
}
const { title, description, canonical, robots, ogImage, jsonLd } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo title={title} description={description} canonical={canonical} robots={robots} ogImage={ogImage} jsonLd={jsonLd} />
  </head>
  <body>
    <div class="astro-shell">
      <Header />
      <main class="astro-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
