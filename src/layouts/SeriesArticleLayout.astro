---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SECTION_META, SITE, SERIES_ORDER } from '@/data/site';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'articles'>;
  canonical: string;
  seriesSlug: string;
  seriesTitle: string;
  seriesSubtitle?: string;
  seriesKicker: string;
  seriesEraRange: string;
  seriesEras: Array<{ era: string; label: string }>;
  series3dLink?: string;
}

const {
  entry, canonical, seriesSlug, seriesTitle, seriesSubtitle,
  seriesKicker, seriesEraRange, seriesEras, series3dLink
} = Astro.props;

const data = entry.data;
const order = SERIES_ORDER[seriesSlug] || [];
const allArticles = await getCollection('articles', ({ data: d }) => d.series === seriesSlug);
const sortedParts = order
  .map(slug => allArticles.find(a => a.data.slug === slug))
  .filter(Boolean) as CollectionEntry<'articles'>[];

const currentIdx = sortedParts.findIndex(a => a.data.slug === data.slug);
const currentPos = currentIdx >= 0 ? currentIdx + 1 : 1;
const totalParts = sortedParts.length;

// Derived from entry.data.ogImage


function coverImg(entry: any) { return entry.data.ogImage || ''; }

const seriesNext = currentIdx < sortedParts.length - 1 ? sortedParts[currentIdx + 1] : null;
const seriesPrev = currentIdx > 0 ? sortedParts[currentIdx - 1] : null;
const h1 = data.h1 || data.title;
const published = data.publishedAt instanceof Date ? data.publishedAt : new Date(data.publishedAt);
const updated = data.updatedAt instanceof Date ? data.updatedAt : data.updatedAt ? new Date(data.updatedAt) : published;

const ogImage = data.ogImage?.startsWith('http') ? data.ogImage : data.ogImage ? `${SITE.url}${data.ogImage}` : undefined;
const articleCanonical = canonical;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${articleCanonical}#article`,
      headline: data.title,
      description: data.description,
      url: canonical,
      inLanguage: 'ru-RU',
      datePublished: published.toISOString(),
      dateModified: updated.toISOString(),
      author: { '@id': `${SITE.url}/about/#person`, '@type': 'Person', name: SITE.authorName, url: `${SITE.url}/about/` },
      publisher: { '@id': SITE.orgId },
      mainEntityOfPage: { '@type': 'WebPage', '@id': articleCanonical },
      image: ogImage ? { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 } : undefined,
      articleSection: 'Баптисты России',
    },
    {
      '@type': 'WebPage', '@id': articleCanonical, url: articleCanonical,
      name: data.title, description: data.description, isPartOf: { '@id': SITE.websiteId },
    },
    {
      '@type': 'BreadcrumbList', '@id': `${articleCanonical}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Баптисты России', item: `${SITE.url}/{seriesSlug}/` },
        { '@type': 'ListItem', position: 3, name: data.title, item: canonical },
      ],
    },
  ],
};

const sectionMeta = SECTION_META['baptisty-rossii'];
const articleSectionName = sectionMeta?.label || 'Баптисты России';
const articleEyebrow = sectionMeta?.eyebrow || 'История ЕХБ';
const editorialRole = 'Автор-редактор';
const editorialName = SITE.authorName;
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={canonical}
  robots="index, follow, max-snippet:-1, max-image-preview:large"
  ogImage={ogImage}
  ogImageAlt={data.ogImageAlt || data.title}
  ogTitle={data.title}
  ogDescription={data.description}
  ogType="article"
  articlePublishedTime={published.toISOString()}
  articleModifiedTime={updated.toISOString()}
  articleAuthor={SITE.authorName}
  jsonLd={jsonLd}
  bodyClass="gbs-world"
>
  <!-- Mobile header (simplified) -->
  <div class="gbs2-mobile-head">
    <img src={coverImg(data.slug)} alt="" width="600" height="315" />
    <div class="gbs2-mobile-title"><span>{seriesTitle}</span><b>{currentPos} · {h1}</b></div>
    <div class="gbs2-mobile-actions">
      <button class="gbs2-mctl" type="button" data-gbs2-theme aria-label="Переключить тему">◐</button>
      <button class="gbs2-mctl" type="button" data-gbs2-search aria-label="Поиск">⌕</button>
    </div>
  </div>

  <div class="gbs2-world">
    <!-- Sidebar rail -->
    <aside class="gbs2-rail" aria-label={`Серия «${seriesTitle}»`}>
      <div class="gbs2-rhead">
        <div class="gbs2-kicker">{seriesKicker}</div>
        <h2 class="gbs2-rtitle">{seriesTitle}</h2>
        <div class="gbs2-rsub">{totalParts} частей · {seriesSubtitle || 'живая исследовательская серия'}</div>
        <div class="gbs2-rprogress">
          <div class="gbs2-ring" aria-hidden="true">
            <svg width="44" height="44" viewBox="0 0 44 44">
              <circle class="t" cx="22" cy="22" r="18"></circle>
              <circle class="f" cx="22" cy="22" r="18"
                stroke-dasharray={`${Math.round(113 * currentPos / totalParts)} 113`}></circle>
            </svg>
            <b>{Math.round(100 * currentPos / totalParts)}%</b>
          </div>
          <div><small>Опубликовано</small><span>{currentPos} из {totalParts}</span></div>
        </div>
      </div>

      <div class="gbs2-rmid">
        <nav class="gbs2-parts" aria-label="Части серии">
          {sortedParts.map((part) => (
            <a class={`gbs2-part${part.data.slug === data.slug ? ' gbs2-part--current' : ''}`}
               href={`/{seriesSlug}/${part.data.slug}/`}
               aria-current={part.data.slug === data.slug ? 'page' : undefined}>
              <span class="gbs2-thumb"><img src={coverImg(part)} alt="" width="600" height="315" loading="lazy" decoding="async" /></span>
              <span>
                <span class="gbs2-pn">{sortedParts.indexOf(part) + 1} · {part.data.readingTime ?? "?"} мин</span>
                <span class="gbs2-pt">{part.data.h1 || part.data.title}</span>
                <span class="gbs2-ps">{part.data.description?.slice(0, 36)}{(part.data.description?.length || 0) > 36 ? '…' : ''}</span>
              </span>
              <span class="gbs2-check" aria-hidden="true">✓</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="gbs2-rfoot">
        <button class="gbs2-ctl" type="button" data-gbs2-theme aria-label="Переключить тему">◐</button>
        <button class="gbs2-ctl" type="button" data-gbs2-font="down" aria-label="Уменьшить шрифт">A−</button>
        <button class="gbs2-ctl" type="button" data-gbs2-font="up" aria-label="Увеличить шрифт">A+</button>
        <button class="gbs2-ctl" type="button" data-gbs2-share aria-label="Поделиться">↗</button>
        {series3dLink && <a class="gbs2-home" href={series3dLink}>3D-карта</a>}
      </div>
    </aside>

    <!-- Main content -->
    <div class="page-wrap" id="content">
      <nav aria-label="Хлебные крошки" class="breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item"><a class="breadcrumb__link" href="/">Главная</a></li>
          <li class="breadcrumb__item"><a class="breadcrumb__link" href="/{seriesSlug}/">Баптисты России</a></li>
          <li class="breadcrumb__item" aria-current="page"><span class="breadcrumb__current">{h1}</span></li>
        </ol>
      </nav>

      <main id="main-content">
        <!-- Hero cover -->
        <figure class="gbs2-hero">
          <img src={coverImg(data.slug)} alt={`Обложка: ${h1}`} width="1200" height="630" decoding="async" />
          <figcaption class="gbs2-hero-cap"><i aria-hidden="true"></i>Серия «{seriesTitle}» · Часть {currentPos} из {totalParts}</figcaption>
        </figure>

        <header class="article-header gbs2-head">
          <span class="gbs2-kinetic" aria-hidden="true">{currentPos}</span>
          <p class="section-label reveal">{articleEyebrow} · {articleSectionName}</p>
          <h1>{h1}</h1>
          <p class="article-desc reveal">{data.description}</p>
          <p class="article-byline reveal">
            <span class="article-byline__strong">{editorialRole}: {editorialName}</span>
            <span aria-hidden="true" class="article-byline__sep">·</span>
            <time datetime={published.toISOString()}>{published.toLocaleDateString('ru-RU')}</time>
          </p>
        </header>

        <article class="article-body" data-pagefind-body>
          <span data-pagefind-meta="author" hidden>{SITE.authorName}</span>
          <span data-pagefind-meta="category" hidden>Баптисты России</span>
          <slot />
        </article>

        <!-- gbs2-next -->
        <div class="gbs2-vignette" aria-hidden="true"></div>
        <nav class="gbs2-next" aria-label="Соседние части серии">
          {seriesPrev ? (
            <a class="gbs2-next-card gbs2-next-card--prev" href={`/{seriesSlug}/${seriesPrev.data.slug}/`}>
              <span class="gbs2-next-cover" style={`background-image:url(${coverImg(seriesPrev)})`}></span>
              <span>
                <span class="gbs2-next-eyebrow">Назад · {currentPos - 1} из {totalParts}</span>
                <span class="gbs2-next-title">{seriesPrev.data.h1 || seriesPrev.data.title}</span>
                <span class="gbs2-next-desc">{seriesPrev.data.description?.slice(0, 55)}{(seriesPrev.data.description?.length || 0) > 55 ? '…' : ''}</span>
              </span>
            </a>
          ) : <div></div>}
          {seriesNext ? (
            <a class="gbs2-next-card" href={`/{seriesSlug}/${seriesNext.data.slug}/`}>
              <span class="gbs2-next-cover" style={`background-image:url(${coverImg(seriesNext)})`}></span>
              <span>
                <span class="gbs2-next-eyebrow">Дальше · {currentPos + 1} из {totalParts}</span>
                <span class="gbs2-next-title">{seriesNext.data.h1 || seriesNext.data.title}</span>
                <span class="gbs2-next-desc">{seriesNext.data.description?.slice(0, 55)}{(seriesNext.data.description?.length || 0) > 55 ? '…' : ''}</span>
              </span>
            </a>
          ) : <div></div>}
        </nav>

        <!-- Timeline -->
        <section class="gbs2-timeline" aria-label="Карта серии">
          <div class="gbs2-tl-head"><span>Карта серии</span><span>{seriesEraRange}</span></div>
          <div class="gbs2-tl-track">
            <span class="gbs2-tl-line" aria-hidden="true"></span>
            {seriesEras.map((era) => (
              <div class="gbs2-tl-item">
                <span class="gbs2-tl-dot"></span>
                <span class="gbs2-tl-era">{era.era}</span>{era.label}
              </div>
            ))}
          </div>
        </section>

        <!-- Author card -->
        <aside class="author-card">
          <div class="author-card-icon" aria-hidden="true">ФМ</div>
          <div class="author-card-body">
            <div class="author-card-label">Редакционный принцип</div>
            <div class="author-card-name">Живая исследовательская серия</div>
            <p class="author-card-desc">Каждая статья сверяется с исследовательским досье. Если факт спорный, он помечается уровнем источника и не превращается в уверенное утверждение без проверки. <a href="/about/">Об авторе →</a></p>
          </div>
        </aside>

        <div class="article-end-block article-end-sdg-wrap">
          <div class="article-end-sdg"><span class="sdg">Soli Deo Gloria</span></div>
        </div>
      </main>
    </div>
  </div>

  <!-- Mobile bottom bar -->
  <button class="gbs2-bbar" id="gbs2Bbar" type="button" aria-haspopup="dialog" aria-controls="gbs2Sheet">
    <b id="gbs2MobPct">{Math.round(100 * currentPos / totalParts)}%</b><span id="gbs2MobSec">Серия</span>
  </button>

  <!-- Mobile sheet (simplified) -->
  <div class="gbs2-sheet" id="gbs2Sheet" aria-hidden="true">
    <div class="gbs2-sheet-backdrop" data-gbs2-close></div>
    <section class="gbs2-sheet-panel" role="dialog" aria-modal="true" aria-label={`Серия ${seriesTitle}`}>
      <div class="gbs2-sheet-grab" aria-hidden="true"></div>
      <header class="gbs2-sheet-head">
        <div><span>Серия</span><b>{seriesTitle}</b></div>
        <button type="button" class="gbs2-sheet-close" data-gbs2-close aria-label="Закрыть">×</button>
      </header>
      <div class="gbs2-sheet-tabs" role="tablist">
        <button type="button" class="gbs2-sheet-tab gbs2-on" data-gbs2-tab="parts">Части</button>
        <button type="button" class="gbs2-sheet-tab" data-gbs2-tab="toc">Оглавление</button>
      </div>
      <div class="gbs2-sheet-body">
        <div class="gbs2-sheet-pane gbs2-on" data-gbs2-pane="parts">
          <div class="gbs2-sheet-parts">
          {sortedParts.map((part) => (
            <a class={`gbs2-sheet-part${part.data.slug === data.slug ? ' gbs2-sheet-part--current' : ''}`}
               href={`/{seriesSlug}/${part.data.slug}/`}
               aria-current={part.data.slug === data.slug ? 'page' : undefined}>
              <img src={coverImg(part)} alt="" width="600" height="315" />
              <span><b>{sortedParts.indexOf(part) + 1}. {part.data.h1 || part.data.title}</b><small>{part.data.readingTime ?? "?"} мин</small></span>
            </a>
          ))}
          </div>
        </div>
        <nav class="gbs2-sheet-pane" data-gbs2-pane="toc" aria-label="Оглавление части"></nav>
      </div>
    </section>
  </div>
</BaseLayout>
