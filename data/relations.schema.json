{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gospod-bog.ru/schemas/relations.schema.json",
  "title": "Editorial relation catalog",
  "description": "Verified semantic relations consumed by the canonical relation compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "relations"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "rationale",
        "editorialStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:_-]*$",
          "minLength": 3,
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 160
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "enum": [
            "series-next",
            "part-of",
            "historical-context",
            "methodological-context",
            "explains",
            "expands",
            "contrasts",
            "cites",
            "biography-of",
            "map-of",
            "same-topic",
            "recommended-next",
            "related"
          ]
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "inverseLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 420
        },
        "editorialStatus": {
          "type": "string",
          "enum": ["verified", "draft", "deprecated"]
        }
      }
    }
  }
}
