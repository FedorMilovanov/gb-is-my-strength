{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gospod-bog.ru/schemas/atlas/event.schema.json",
  "title": "Atlas Event — событие Библейского Атласа",
  "description": "ATLAS-CONTRACT §7. События — пятый слой шкалы и точки сюжетов карт: битвы, депортации, заветы, разрушения, освящения. Годы по консервативной библейской хронологии (§2-бис). Одно событие может жить на нескольких картах.",
  "type": "object",
  "required": [
    "id",
    "title",
    "kind",
    "year"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "object",
      "required": [
        "ru"
      ],
      "additionalProperties": false,
      "properties": {
        "ru": {
          "type": "string"
        },
        "short": {
          "type": "string"
        }
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "covenant",
        "exodus-event",
        "battle",
        "siege",
        "deportation",
        "return",
        "founding",
        "destruction",
        "dedication",
        "reform",
        "revolt",
        "coronation",
        "death",
        "vision",
        "journey",
        "miracle",
        "council",
        "other"
      ]
    },
    "year": {
      "type": "integer",
      "description": "Год (отрицательный = до н.э.); для диапазона — год начала"
    },
    "yearEnd": {
      "type": "integer"
    },
    "approx": {
      "type": "boolean"
    },
    "placeIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "personIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "periodId": {
      "type": "string"
    },
    "bibleRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Слаги карт, где событие — сюжетная точка"
    },
    "extraBiblical": {
      "type": "string",
      "description": "Внебиблейское свидетельство (стела, хроника, надпись) — апологетический слой"
    },
    "note": {
      "type": "string"
    }
  }
}