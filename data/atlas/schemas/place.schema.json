{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gospod-bog.ru/schemas/atlas/place.schema.json",
  "title": "Atlas Place — каноническое место Библейского Атласа",
  "description": "ATLAS-CONTRACT §7. Одно историческое место = одна запись, независимо от числа карт, где оно показано. Карта хранит только отображение (placements). Спорность локализации — данные (identifications), а не сноска.",
  "type": "object",
  "required": [
    "id",
    "names",
    "type"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Канонический kebab-case id (jerusalem, beer-sheva). Стабилен навсегда."
    },
    "names": {
      "type": "object",
      "required": [
        "ru"
      ],
      "additionalProperties": false,
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "he": {
          "type": "string",
          "description": "Иврит (масоретская форма)"
        },
        "gr": {
          "type": "string",
          "description": "Греческий (для НЗ-мест)"
        },
        "translit": {
          "type": "string"
        },
        "byPeriod": {
          "type": "array",
          "description": "Периодные имена: Иевус до Давида, Луз → Вефиль и т.п.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "periodId"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "periodId": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Прочие написания/синонимы для поиска"
        }
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "city",
        "town",
        "region",
        "mountain",
        "river",
        "sea",
        "lake",
        "desert",
        "island",
        "road",
        "sanctuary",
        "camp",
        "battlefield",
        "structure",
        "spring",
        "valley",
        "garden",
        "other"
      ],
      "description": "Тип объекта (словарь закрыт; расширение — только через правку схемы)"
    },
    "parentId": {
      "type": "string",
      "description": "Для суб-локаций: горница в Иерусалиме → parentId: jerusalem"
    },
    "geo": {
      "type": "object",
      "description": "Реальные координаты ЛУЧШЕЙ идентификации (дублируют identifications[primary] для быстрого доступа). Отсутствие geo допустимо для неидентифицированных мест.",
      "required": [
        "lat",
        "lng"
      ],
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "accuracyMeters": {
          "type": "number",
          "description": "Модель Pleiades accuracy_radius"
        }
      }
    },
    "identifications": {
      "type": "array",
      "description": "Кандидаты локализации. ATLAS-CONTRACT §3: словарь статусов движка v0.46.",
      "items": {
        "type": "object",
        "required": [
          "status",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "consensus",
              "primary",
              "candidate",
              "alternative",
              "caveat",
              "minor",
              "rejected"
            ]
          },
          "label": {
            "type": "string",
            "description": "Современное название кандидата (Tell el-Muqayyar и т.п.)"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "accuracyMeters": {
            "type": "number"
          },
          "score": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000,
            "description": "Декадная модель OpenBible time_total (≥500 = высокая уверенность; отрицательные значения = источники активно отвергают кандидата → status: rejected)"
          },
          "argument": {
            "type": "string",
            "description": "Краткий аргумент за/против"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ref"
              ],
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "description": "Ссылка/цитата или id из sources/*"
                },
                "level": {
                  "type": "string",
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "HOLD"
                  ],
                  "description": "Уровень доверия по Research/AGENT_RULES"
                }
              }
            }
          }
        }
      }
    },
    "sameAs": {
      "type": "object",
      "description": "Кросс-идентификаторы для проверяемости и интероперабельности",
      "additionalProperties": false,
      "properties": {
        "openbible": {
          "type": "string",
          "description": "Slug OpenBible.info (ancient place)"
        },
        "pleiades": {
          "type": "string",
          "pattern": "^https://pleiades\\.stoa\\.org/places/\\d+$"
        },
        "wikidata": {
          "type": "string",
          "pattern": "^Q\\d+$"
        },
        "tipnr": {
          "type": "string",
          "description": "STEPBible TIPNR id"
        }
      }
    },
    "bibleRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ключевые ссылки Писания (Быт 12:4 — русская нотация сайта)"
    },
    "placements": {
      "type": "object",
      "description": "SVG-размещения по координатным семействам (data/atlas/coordinate-spaces.json)",
      "additionalProperties": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "labelAnchor": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "top",
              "bottom",
              "auto"
            ]
          },
          "labelPriority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "manualOffset": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dx": {
                "type": "number"
              },
              "dy": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "maps": {
      "type": "array",
      "description": "Обратный индекс: в каких картах место используется и под каким локальным id (заполняется генератором, не руками)",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "localId"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string"
          },
          "localId": {
            "type": "string"
          }
        }
      }
    },
    "geometryLicense": {
      "type": "string",
      "description": "Происхождение/лицензия геометрии, если геометрия импортирована (CC-BY-4.0-OpenBible, ODbL-AWMC, PD-NaturalEarth, own)"
    },
    "notes": {
      "type": "string"
    },
    "needsReview": {
      "type": "boolean",
      "description": "true = запись создана автоматически и ждёт ручной проверки"
    },
    "rank": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ],
      "description": "Ранг подписи/маркера (KA-3 LOD): 1=опорный (far), 2=значимый (mid), 3=малый (close). Проставляется данными, не хардкодом."
    }
  }
}
