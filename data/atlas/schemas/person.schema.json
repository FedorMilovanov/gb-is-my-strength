{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gospod-bog.ru/schemas/atlas/person.schema.json",
  "title": "Atlas Person — личность Библейского Атласа",
  "description": "ATLAS-CONTRACT §7. Цари, пророки, судьи, апостолы — сущности синхронной шкалы «Израиль | Иудея | Пророки | Империи» (цикл KA-7) и слоёв карт. Годы — целые, отрицательные = до н.э. Хронология — консервативная библейская (§2-бис контракта): для разделённого царства — стандартные согласованные даты Тиле (Thiele), принятые консервативной наукой.",
  "type": "object",
  "required": [
    "id",
    "names",
    "role"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "names": {
      "type": "object",
      "required": [
        "ru"
      ],
      "additionalProperties": false,
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "he": {
          "type": "string"
        },
        "gr": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Синодальные/альтернативные написания (Озия/Азария)"
        },
        "short": {
          "type": "string",
          "minLength": 1,
          "description": "Компактная форма для подписей на шкалах (Навуходоносор II → Навуходоносор)"
        }
      }
    },
    "role": {
      "type": "string",
      "enum": [
        "patriarch",
        "judge",
        "king",
        "queen",
        "prophet",
        "prophetess",
        "priest",
        "apostle",
        "governor",
        "emperor",
        "other"
      ]
    },
    "realm": {
      "type": "string",
      "enum": [
        "united",
        "israel",
        "judah",
        "assyria",
        "babylon",
        "persia",
        "greece",
        "rome",
        "none"
      ],
      "description": "Полоса шкалы: чьё правление/к кому служение относится"
    },
    "reign": {
      "type": "object",
      "description": "Для царей/правителей",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        },
        "coregency": {
          "type": "boolean",
          "description": "true = включает сорегентство (даты Тиле)"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ministry": {
      "type": "object",
      "description": "Для пророков/судей/апостолов — период служения",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        },
        "approx": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "periodIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Эпохи реестра periods/, в которые попадает деятельность"
    },
    "bibleRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bookIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Для письменных пророков — их книги (slug)"
    },
    "placeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ключевые места (ссылки на places/)"
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "father": {
          "type": "string"
        },
        "successor": {
          "type": "string"
        },
        "dynasty": {
          "type": "string",
          "description": "davidic | omride | jehu | ... "
        }
      }
    },
    "assessment": {
      "type": "string",
      "enum": [
        "good",
        "evil",
        "mixed"
      ],
      "description": "Библейская оценка царя (делал угодное/неугодное) — для окраски шкалы"
    },
    "sameAs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tipnr": {
          "type": "string",
          "description": "STEPBible TIPNR id (дизамбигуация тёзок)"
        },
        "wikidata": {
          "type": "string",
          "pattern": "^Q\\d+$"
        }
      }
    },
    "note": {
      "type": "string"
    },
    "needsReview": {
      "type": "boolean"
    }
  }
}
